{
    "$schema": "https://recomplauncher.com/schema/recomplauncher.json",
    "format": 1,
    "name": "Resistance 3 Port",
    "repo": "miroslavdanutalexandru-alt/Resistance3Port",
    "start": {
        "program": [
            "Launcher.exe",
            "Setup.exe"
        ]
    },
    "saves": [
        "{install}/gamedata/dev_hdd0/home/00000001/savedata/BCUS98176_SAVE_0",
        "{home}/Saved Games/Resistance 3/config"
    ],
    "folders": {
        "saves": [
            {
                "path": "{install}/gamedata/dev_hdd0/home/00000001/savedata/BCUS98176_SAVE_0"
            }
        ],
        "logs": [
            {
                "path": "{install}/logs"
            }
        ],
        "screenshots": [
            {
                "path": "{install}/screenshots"
            }
        ]
    },
    "actions": [
        {
            "id": "saves",
            "label": "Saves",
            "help": "Your Resistance 3 save and the game's settings, as on the PS3.",
            "open": "saves"
        },
        {
            "id": "logs",
            "label": "Logs",
            "help": "run.log and crash reports, useful when reporting a problem.",
            "open": "logs"
        },
        {
            "id": "screenshots",
            "label": "Screenshots",
            "help": "Pictures taken in game with F12 or PrtScn.",
            "open": "screenshots"
        }
    ]
}
