+void VKGSRender::r2aa_on_depth_clear(u32 zeta)
+{
+	om_lane_join("r2aa_on_depth_clear"); // RSX_RECORD_DEFER
+	g_r2.fast_gen++; // RSX_AA_FAST_EXIT
+	auto& st = g_r2;
+	if (!r2cfg().mode || !r2cfg().ds_latch || !zeta) return;
+	const auto it = st.ds_lat.find(zeta);
+	if (it == st.ds_lat.end() || !it->second.live) return;
+	it->second.live = false;
+	if (st.lat_forced_ds == zeta && st.window)
+	{
+		// The depth that held this bind at the latched scale was just cleared: rebind at the window's own scale
+		st.lat_forced_ds = 0;
+		if (m_draw_fbo)
+		{
+			if (vk::is_renderpass_open(*m_current_command_buffer)) vk::end_renderpass(*m_current_command_buffer);
+			m_draw_fbo->release();
+			m_draw_fbo = nullptr;
+		}
+		m_ctx->graphics_state.set(rsx::rtt_config_dirty);
+	}
+}
