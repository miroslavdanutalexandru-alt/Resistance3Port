+namespace vk
+{
+	int r2aa_mode()
+	{
+		return r2cfg().mode;
+	}
+
+	namespace
+	{
+		std::atomic<u32> g_uvj_programs{0}, g_uvj_outputs{0};
+	}
+
+	unsigned r2aa_uvj_outputs(const RSXVertexProgram& prog)
+	{
+		if (!r2cfg().uv_jitter) return 0;
+		// Straight-line programs only (no branches, calls or jump table): every write is seen in execution order
+		if (prog.entry != prog.base_address || !prog.jump_table.empty()) return 0;
+
+		// Per component of every temp and output: what wrote it last. dp4 = dot of one operand vector with a single
+		// non-indexed constant row; mov copies a component of a temp; anything else is opaque.
+		struct val { u32 row = ~0u; u64 opnd = 0; };
+		val temp[64][4], out[16][4];
+		u32 tver[64] = {};
+		const usz count = prog.data.size() / 4;
+		const auto& d = prog.data;
+
+		for (usz i = 0; i < count && i < rsx::max_vertex_program_instructions; ++i)
+		{
+			if (!prog.instruction_mask[i]) continue;
+			D0 d0; D1 d1; D2 d2; D3 d3;
+			d0.HEX = d[i * 4 + 0]; d1.HEX = d[i * 4 + 1]; d2.HEX = d[i * 4 + 2]; d3.HEX = d[i * 4 + 3];
+			switch (d1.sca_opcode)
+			{
+			case RSX_SCA_OPCODE_BRA: case RSX_SCA_OPCODE_BRI: case RSX_SCA_OPCODE_CAL: case RSX_SCA_OPCODE_CLI:
+			case RSX_SCA_OPCODE_RET: case RSX_SCA_OPCODE_BRB: case RSX_SCA_OPCODE_CLB: case RSX_SCA_OPCODE_PSH:
+			case RSX_SCA_OPCODE_POP:
+				return 0;
+			default: break;
+			}
+			SRC src[3];
+			for (auto& s : src) s.HEX = 0;
+			src[0].src0l = d2.src0l; src[0].src0h = d1.src0h;
+			src[1].src1 = d2.src1;
+			src[2].src2l = d3.src2l; src[2].src2h = d2.src2h;
+
+			const bool writes = d0.cond != 0;
+			const bool exact = !(d0.cond_test_enable && d0.cond != 7) && !d0.staturate; // unconditional, unclamped
+			const u32 abs_bits = d0.src0_abs | (d0.src1_abs << 1) | (d0.src2_abs << 2);
+
+			// Value the vector op produces for each component (before any write: the sources are the old versions)
+			val vres[4];
+			const u32 vop = d1.vec_opcode;
+			if (vop == RSX_VEC_OPCODE_DP4)
+			{
+				const bool c0 = src[0].reg_type == RSX_VP_REGISTER_TYPE_CONSTANT, c1 = src[1].reg_type == RSX_VP_REGISTER_TYPE_CONSTANT;
+				const SRC& o = c0 ? src[1] : src[0];
+				if (c0 != c1 && !d3.index_const && d1.const_src < 468 && !d0.index_input &&
+					(o.reg_type == RSX_VP_REGISTER_TYPE_TEMP || o.reg_type == RSX_VP_REGISTER_TYPE_INPUT))
+				{
+					const u32 n = c0 ? 1 : 0;
+					const u32 ver = o.reg_type == RSX_VP_REGISTER_TYPE_TEMP ? tver[o.tmp_src] : 0;
+					const u32 idx = o.reg_type == RSX_VP_REGISTER_TYPE_TEMP ? o.tmp_src : d1.input_src;
+					const u64 key = (u64{ver} << 32) | (static_cast<u64>(o.reg_type) << 24) | (u64{idx} << 16) |
+						(static_cast<u64>((o.swz_x << 6) | (o.swz_y << 4) | (o.swz_z << 2) | o.swz_w) << 8) | (static_cast<u64>(o.neg) << 1) | ((abs_bits >> n) & 1);
+					// The constant operand must be read plainly too (a negated/abs row is another matrix)
+					const SRC& c = c0 ? src[0] : src[1];
+					const bool plain = !c.neg && !((abs_bits >> (c0 ? 0 : 1)) & 1) && c.swz_x == 0 && c.swz_y == 1 && c.swz_z == 2 && c.swz_w == 3;
+					if (plain)
+						for (auto& v : vres) v = { d1.const_src, key };
+				}
+			}
+			else if (vop == RSX_VEC_OPCODE_MOV && src[0].reg_type == RSX_VP_REGISTER_TYPE_TEMP && !src[0].neg && !d0.src0_abs)
+			{
+				const u32 sw[4] = { src[0].swz_x, src[0].swz_y, src[0].swz_z, src[0].swz_w };
+				for (int c = 0; c < 4; ++c) vres[c] = temp[src[0].tmp_src][sw[c]];
+			}
+
+			const bool vmask[4] = { !!d3.vec_writemask_x, !!d3.vec_writemask_y, !!d3.vec_writemask_z, !!d3.vec_writemask_w };
+			const bool smask[4] = { !!d3.sca_writemask_x, !!d3.sca_writemask_y, !!d3.sca_writemask_z, !!d3.sca_writemask_w };
+			auto put = [&](val* dst, const bool m[4], const val* v)
+			{
+				for (int c = 0; c < 4; ++c)
+					if (m[c]) dst[c] = (exact && v) ? v[c] : val{};
+			};
+			if (writes && vop != RSX_VEC_OPCODE_NOP && vop != RSX_VEC_OPCODE_ARL)
+			{
+				if (d0.vec_result && d3.dst != 0x1f && d3.dst < 16) put(out[d3.dst], vmask, vres);
+				if (d0.dst_tmp != 0x3f) { put(temp[d0.dst_tmp], vmask, vres); tver[d0.dst_tmp]++; }
+			}
+			if (writes && d1.sca_opcode != RSX_SCA_OPCODE_NOP)
+			{
+				if (!d0.vec_result && d3.dst != 0x1f && d3.dst < 16) put(out[d3.dst], smask, nullptr);
+				if (d3.sca_dst_tmp != 0x3f) { put(temp[d3.sca_dst_tmp], smask, nullptr); tver[d3.sca_dst_tmp]++; }
+			}
+			if (d3.end) break;
+		}
+
+		// Clip position rows: o[0].x/y/w each a plain dot with one constant row
+		const val* p = out[0];
+		if (p[0].row == ~0u || p[1].row == ~0u || p[3].row == ~0u || p[0].row == p[1].row || p[0].row == p[3].row || p[1].row == p[3].row)
+			return 0;
+		u16 mask = 0;
+		// Texture coordinate outputs only (o[7]..o[15] = tc0..tc8; o[6] is shared with the point size / clip distances)
+		for (u32 r = 7; r < 16; ++r)
+		{
+			const val* v = out[r];
+			if (!(prog.output_mask & (1u << (r == 15 ? 12 : r + 7)))) continue; // CELL_GCM_ATTRIB_OUTPUT_MASK_TEX0..7 = bits 14..21, TEX8 = bit 12
+			if (v[0].row == p[0].row && v[1].row == p[1].row && v[3].row == p[3].row &&
+				v[0].opnd == v[1].opnd && v[0].opnd == v[3].opnd)
+			{
+				mask |= static_cast<u16>(1u << r);
+			}
+		}
+		if (mask)
+		{
+			g_uvj_programs.fetch_add(1, std::memory_order_relaxed);
+			g_uvj_outputs.fetch_add(static_cast<u32>(std::popcount(mask)), std::memory_order_relaxed);
+			if (r2cfg().debug) r2log("screen-uv jitter: vertex program %u instr, outputs 0x%04x get the scene jitter", static_cast<u32>(count), mask);
+		}
+		return mask;
+	}
+
+	void r2aa_extend_instance(std::vector<const char*>& extensions)
+	{
+		if (r2cfg().mode == 4) vk::r2xess::extend_instance(extensions, VK_API_VERSION_1_2); // instance.cpp: Vulkan 1.2
+		if (r2cfg().mode != 2 || !dlss_load() || !g_dlss.inst_count) return;
+
+		u32 count = 0;
+		vkEnumerateInstanceExtensionProperties(nullptr, &count, nullptr);
+		std::vector<VkExtensionProperties> props(count);
+		vkEnumerateInstanceExtensionProperties(nullptr, &count, props.data());
+		for (unsigned i = 0; i < g_dlss.inst_count; ++i)
+		{
+			const char* name = g_dlss.inst_exts[i];
+			bool ok = false;
+			for (const auto& p : props) ok = ok || std::strcmp(p.extensionName, name) == 0;
+			if (ok) push_unique(extensions, name);
+			else r2log("instance extension %s (NGX) is not supported", name);
+		}
+	}
+
+	// RSX_DLSS_OBJMV_MODE=onepass: 64-bit storage buffer atomics in fragment shaders were enabled on the device
+	bool r2om_onepass_dev = false;
+
+	void r2aa_extend_device(VkPhysicalDevice pdev, std::vector<const char*>& extensions,
+		VkPhysicalDeviceFeatures& features, VkPhysicalDeviceVulkan12Features& vulkan12, VkDeviceCreateInfo& info)
+	{
+		if (!r2cfg().mode) return;
+
+		u32 count = 0;
+		vkEnumerateDeviceExtensionProperties(pdev, nullptr, &count, nullptr);
+		std::vector<VkExtensionProperties> props(count);
+		vkEnumerateDeviceExtensionProperties(pdev, nullptr, &count, props.data());
+		auto supported = [&](const char* name)
+		{
+			for (const auto& p : props)
+				if (std::strcmp(p.extensionName, name) == 0) return true;
+			return false;
+		};
+
+		static VkPhysicalDevice16BitStorageFeatures s16{ .sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_16BIT_STORAGE_FEATURES };
+		static VkPhysicalDeviceSubgroupSizeControlFeatures ssc{ .sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_SUBGROUP_SIZE_CONTROL_FEATURES };
+		static VkPhysicalDeviceVulkan12Features v12{ .sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_VULKAN_1_2_FEATURES };
+		const bool has_ssc = supported(VK_EXT_SUBGROUP_SIZE_CONTROL_EXTENSION_NAME);
+
+		VkPhysicalDeviceFeatures2 f2{ .sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_FEATURES_2 };
+		s16.pNext = nullptr; ssc.pNext = nullptr; v12.pNext = nullptr;
+		f2.pNext = &s16;
+		s16.pNext = &v12;
+		if (has_ssc) v12.pNext = &ssc;
+		vkGetPhysicalDeviceFeatures2(pdev, &f2);
+
+		// FSR 3.1 picks its shader permutations from what the GPU supports, so enable what it may use
+		features.shaderInt16 |= f2.features.shaderInt16;
+		features.shaderImageGatherExtended |= f2.features.shaderImageGatherExtended;
+		features.shaderStorageImageExtendedFormats |= f2.features.shaderStorageImageExtendedFormats;
+		features.shaderStorageImageReadWithoutFormat |= f2.features.shaderStorageImageReadWithoutFormat;
+		features.shaderStorageImageWriteWithoutFormat |= f2.features.shaderStorageImageWriteWithoutFormat;
+		vulkan12.shaderFloat16 |= v12.shaderFloat16;
+		vulkan12.shaderInt8 |= v12.shaderInt8;
+		vulkan12.shaderSubgroupExtendedTypes |= v12.shaderSubgroupExtendedTypes;
+		vulkan12.storageBuffer8BitAccess |= v12.storageBuffer8BitAccess;
+		if (r2cfg().objmv == 1 && r2cfg().om_mode == 1)
+		{
+			r2om_onepass_dev = f2.features.fragmentStoresAndAtomics && f2.features.shaderInt64 && v12.shaderBufferInt64Atomics;
+			if (r2om_onepass_dev)
+			{
+				features.fragmentStoresAndAtomics = VK_TRUE;
+				features.shaderInt64 = VK_TRUE;
+				vulkan12.shaderBufferInt64Atomics = VK_TRUE;
+			}
+			else r2log("objmv: no 64-bit fragment shader buffer atomics on this GPU, RSX_DLSS_OBJMV_MODE=replay");
+		}
+
+		s16.pNext = const_cast<void*>(info.pNext);
+		info.pNext = &s16;
+
+		// FSR 3.1 loads the KHR-suffixed entry points, which vkGetDeviceProcAddr only returns when the extension is enabled
+		for (const char* name : { VK_KHR_GET_MEMORY_REQUIREMENTS_2_EXTENSION_NAME, VK_KHR_DEDICATED_ALLOCATION_EXTENSION_NAME })
+			if (supported(name)) push_unique(extensions, name);
+
+		if (has_ssc && ssc.subgroupSizeControl)
+		{
+			push_unique(extensions, VK_EXT_SUBGROUP_SIZE_CONTROL_EXTENSION_NAME);
+			ssc.pNext = const_cast<void*>(info.pNext);
+			info.pNext = &ssc;
+		}
+
+		if (r2cfg().mode == 2 && g_dlss.dll && !g_dlss.failed)
+		{
+			// NGX only runs on NVIDIA RTX: skip its extensions (and the NGX init) on other vendors
+			VkPhysicalDeviceProperties pp{};
+			vkGetPhysicalDeviceProperties(pdev, &pp);
+			if (pp.vendorID != 0x10DE)
+			{
+				g_dlss.failed = true;
+				r2aa_fallback(2, "not an NVIDIA GPU");
+			}
+		}
+		if (r2cfg().mode == 2 && g_dlss.dll && !g_dlss.failed)
+		{
+			for (unsigned i = 0; i < g_dlss.dev_count; ++i)
+			{
+				const char* name = g_dlss.dev_exts[i];
+				if (std::strcmp(name, "VK_EXT_buffer_device_address") == 0) continue; // core bufferDeviceAddress instead
+				if (supported(name)) push_unique(extensions, name);
+				else r2log("device extension %s (NGX) is not supported", name);
+			}
+			vulkan12.bufferDeviceAddress |= v12.bufferDeviceAddress;
+		}
+
+		if (r2cfg().mode == 4) vk::r2xess::extend_device(pdev, extensions, features, vulkan12, info);
+
