+		if (!dep_ok(*dep)) { fallback(); return _vkCmdSetEvent2KHR(c, e, dep); }
+		packet<P> pk(dep_bytes(*dep), [](const void* d) { auto p = static_cast<const P*>(d); _vkCmdSetEvent2KHR(p->c, p->e, &p->dep); });
+		if (!pk) { fallback(); return _vkCmdSetEvent2KHR(c, e, dep); }
+		pk.args->c = c;
+		pk.args->e = e;
+		dep_copy(pk, pk.args->dep, *dep);
+	}
+
+	void d__vkCmdWaitEvents2KHR(VkCommandBuffer c, uint32_t n, const VkEvent* e, const VkDependencyInfo* dep)
+	{
+		struct P { VkCommandBuffer c; uint32_t n; const VkEvent* e; VkDependencyInfo* dep; };
+		size_t extra = bytes(e, n) + bytes(dep, n);
+		for (u32 k = 0; k < n; k++)
+		{
+			if (!dep_ok(dep[k])) { fallback(); return _vkCmdWaitEvents2KHR(c, n, e, dep); }
+			extra += dep_bytes(dep[k]);
+		}
+		packet<P> pk(extra, [](const void* d) { auto p = static_cast<const P*>(d); _vkCmdWaitEvents2KHR(p->c, p->n, p->e, p->dep); });
+		if (!pk) { fallback(); return _vkCmdWaitEvents2KHR(c, n, e, dep); }
+		pk.args->c = c;
+		pk.args->n = n;
+		pk.args->e = pk.copy(e, n);
+		pk.args->dep = pk.copy(dep, n);
+		for (u32 k = 0; k < n; k++)
+		{
+			dep_copy(pk, pk.args->dep[k], dep[k]);
+		}
+	}
+
+	void d__vkCmdPipelineBarrier2KHR(VkCommandBuffer c, const VkDependencyInfo* dep)
+	{
+		struct P { VkCommandBuffer c; VkDependencyInfo dep; };
+		if (!dep_ok(*dep)) { fallback(); return _vkCmdPipelineBarrier2KHR(c, dep); }
+		packet<P> pk(dep_bytes(*dep), [](const void* d) { auto p = static_cast<const P*>(d); _vkCmdPipelineBarrier2KHR(p->c, &p->dep); });
+		if (!pk) { fallback(); return _vkCmdPipelineBarrier2KHR(c, dep); }
+		pk.args->c = c;
+		dep_copy(pk, pk.args->dep, *dep);
+	}
+
+	void d__vkCmdDrawMultiEXT(VkCommandBuffer c, uint32_t n, const VkMultiDrawInfoEXT* info, uint32_t ic, uint32_t fi, uint32_t st)
+	{
+		struct P { VkCommandBuffer c; uint32_t n; const VkMultiDrawInfoEXT* info; uint32_t ic, fi, st; };
+		const size_t sz = (info && n) ? static_cast<size_t>(n - 1) * st + sizeof(VkMultiDrawInfoEXT) : 0;
+		packet<P> pk(align16(sz), [](const void* d) { auto p = static_cast<const P*>(d); _vkCmdDrawMultiEXT(p->c, p->n, p->info, p->ic, p->fi, p->st); });
+		if (!pk) { fallback(); return _vkCmdDrawMultiEXT(c, n, info, ic, fi, st); }
+		*pk.args = { c, n, static_cast<const VkMultiDrawInfoEXT*>(pk.copy_bytes(info, sz)), ic, fi, st };
+	}
+
+	void d__vkCmdDrawMultiIndexedEXT(VkCommandBuffer c, uint32_t n, const VkMultiDrawIndexedInfoEXT* info, uint32_t ic, uint32_t fi, uint32_t st, const int32_t* vo)
+	{
+		struct P { VkCommandBuffer c; uint32_t n; const VkMultiDrawIndexedInfoEXT* info; uint32_t ic, fi, st; const int32_t* vo; };
+		const size_t sz = (info && n) ? static_cast<size_t>(n - 1) * st + sizeof(VkMultiDrawIndexedInfoEXT) : 0;
+		packet<P> pk(align16(sz) + bytes(vo, 1), [](const void* d)
+		{
+			auto p = static_cast<const P*>(d);
+			_vkCmdDrawMultiIndexedEXT(p->c, p->n, p->info, p->ic, p->fi, p->st, p->vo);
+		});
+		if (!pk) { fallback(); return _vkCmdDrawMultiIndexedEXT(c, n, info, ic, fi, st, vo); }
+		*pk.args = { c, n, static_cast<const VkMultiDrawIndexedInfoEXT*>(pk.copy_bytes(info, sz)), ic, fi, st, pk.copy(vo, 1) };
+	}
+
+	void d__vkCmdPushDescriptorSetKHR(VkCommandBuffer c, VkPipelineBindPoint bp, VkPipelineLayout l, uint32_t s, uint32_t n, const VkWriteDescriptorSet* w)
+	{
+		struct P { VkCommandBuffer c; VkPipelineBindPoint bp; VkPipelineLayout l; uint32_t s, n; const VkWriteDescriptorSet* w; };
+		const size_t wb = writes_bytes(w, n);
+		if (wb == SIZE_MAX) { fallback(); return _vkCmdPushDescriptorSetKHR(c, bp, l, s, n, w); }
+		packet<P> pk(wb, [](const void* d) { auto p = static_cast<const P*>(d); _vkCmdPushDescriptorSetKHR(p->c, p->bp, p->l, p->s, p->n, p->w); });
+		if (!pk) { fallback(); return _vkCmdPushDescriptorSetKHR(c, bp, l, s, n, w); }
+		pk.args->c = c;
+		pk.args->bp = bp;
+		pk.args->l = l;
+		pk.args->s = s;
+		pk.args->n = n;
+		pk.args->w = copy_writes(pk, w, n);
+	}
+}
