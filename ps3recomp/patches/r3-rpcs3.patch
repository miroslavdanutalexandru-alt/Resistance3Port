+#ifdef _WIN32
+	VkResult r2fg_create_win32_surface(VkInstance instance, const VkWin32SurfaceCreateInfoKHR* info, VkSurfaceKHR* surface)
+	{
+		return vkCreateWin32SurfaceKHR(instance, info, nullptr, surface);
+	}
+#endif
+	VkResult r2fg_create_device(VkPhysicalDevice pdev, const VkDeviceCreateInfo* info, VkDevice* device)
+	{
+		return vkCreateDevice(pdev, info, nullptr, device);
+	}
+	void r2fg_device_destroyed(VkDevice) {}
+	void r2fg_swapchain_procs(VkDevice, PFN_vkCreateSwapchainKHR&, PFN_vkDestroySwapchainKHR&, PFN_vkGetSwapchainImagesKHR&,
+		PFN_vkAcquireNextImageKHR&, PFN_vkQueuePresentKHR&) {}
+	bool r2fg_owns_reflex() { return false; }
+	void r2fg_tag_scene(vk::command_buffer&, vk::viewable_image*, vk::viewable_image*, u32, u32, float, float, float, float, bool, bool,
+		const double*, float, float) {}
+	void r2fg_present(int, vk::command_buffer&, VkImage, VkImageLayout, vk::viewable_image*, u32, u32, s32, s32, s32, s32) {}
+	bool r2fg_set_hdr_metadata(VkDevice, VkSwapchainKHR, const VkHdrMetadataEXT*) { return false; }
+}
+
+void VKGSRender::r2fg_on_draw() {}
+
+extern "C" int r2fg_game_frame(void) { return 0; }
+
+#endif
diff --git a/rpcs3/Emu/RSX/VK/VKR2FrameGen.h b/rpcs3/Emu/RSX/VK/VKR2FrameGen.h
new file mode 100644
index 0000000..3890feb
--- /dev/null
+++ b/rpcs3/Emu/RSX/VK/VKR2FrameGen.h
@@ -0,0 +1,60 @@
+// R2PORT: Resistance 2/3 port addition (not upstream RPCS3).
+// Frame generation: NVIDIA DLSS Frame Generation (2x, 3x/4x Multi Frame Generation) through Streamline
+// (sl.interposer.dll and its plugins), or AMD FSR 3 frame interpolation (2x, amd_fidelityfx_vk.dll) for GPUs
+// without DLSS-G; both loaded at run time from the exe folder. Off unless R2_DLSS_FG (or R3_/R1_) is 2, 3, 4 or
+// fsr3; R2_FG_BACKEND=auto|dlss|fsr3 picks the backend (auto: DLSS-G, else FSR 3).
+// Everything here is inert, and every hook is a plain pass-through, when it is off or unavailable.
+// Design notes, switches and the in-game checklist: scratch/framegen_vk.md.
+#pragma once
+
+#include "VulkanAPI.h"
+
+namespace vk
+{
+	class command_buffer;
+	class viewable_image;
+
+	// instance.cpp: replaces vkCreateInstance. For the main (non-'fast') instance, when frame generation is
+	// requested and the GPU and DLLs qualify, Streamline is initialised first and its proxy creates the instance.
+	VkResult r2fg_create_instance(const VkInstanceCreateInfo& info, VkInstance* instance, bool fast);
+	// instance.cpp: replaces vkDestroySurfaceKHR
+	void r2fg_destroy_surface(VkInstance instance, VkSurfaceKHR surface);
+#ifdef _WIN32
+	// swapchain_win32.hpp: replaces vkCreateWin32SurfaceKHR
+	VkResult r2fg_create_win32_surface(VkInstance instance, const VkWin32SurfaceCreateInfoKHR* info, VkSurfaceKHR* surface);
+#endif
+	// device.cpp: replaces vkCreateDevice (FSR 3: adds a present and an image-acquire queue, timeline semaphores)
+	VkResult r2fg_create_device(VkPhysicalDevice pdev, const VkDeviceCreateInfo* info, VkDevice* device);
+	// device.cpp, right before vkDestroyDevice: waits for Streamline / FSR 3 and shuts it down
+	void r2fg_device_destroyed(VkDevice device);
+	// swapchain.cpp, after the swapchain entry points are fetched: routes them through Streamline or the FSR 3
+	// frame-generation swapchain
+	void r2fg_swapchain_procs(VkDevice device, PFN_vkCreateSwapchainKHR& create, PFN_vkDestroySwapchainKHR& destroy,
+		PFN_vkGetSwapchainImagesKHR& images, PFN_vkAcquireNextImageKHR& acquire, PFN_vkQueuePresentKHR& present);
+	// VKR2PcExtras.cpp: true when frame generation owns Reflex (the VK_NV_low_latency2 path then stays off)
+	bool r2fg_owns_reflex();
+	// VKR2PcExtras.cpp: HDR metadata for an FSR 3 swapchain goes through its replacement entry point (true = done)
+	bool r2fg_set_hdr_metadata(VkDevice device, VkSwapchainKHR swapchain, const VkHdrMetadataEXT* metadata);
+
+	// VKR2Upscaler.cpp, after a DLSS/DLAA evaluation: the frame's render-resolution depth (R32F) and motion
+	// vectors (RG16F, (prev - cur) uv * 0.5 in the upscaler's convention, scaled by mv_w/mv_h to pixels), both in
+	// SHADER_READ_ONLY layout, used region rw x rh; jitter in pixels; T = current -> previous clip transform
+	// (column vectors, the upscaler's y-down NDC, depth d * zA + zB).
+	void r2fg_tag_scene(vk::command_buffer& cmd, vk::viewable_image* depth, vk::viewable_image* mv, u32 rw, u32 rh,
+		float jx, float jy, float mv_w, float mv_h, bool inverted, bool reset, const double* T, float zA, float zB);
+
+	// VKPresent.cpp present_frame. phase 0: after the game image is on the swapchain image, before RPCS3/port
+	// overlays; phase 1: after the overlays, before the transition to the present layout. 'src' is the flipped
+	// display buffer (buffer_w x buffer_h used), drawn into the rectangle (x1, y1) - (x2, y2).
+	void r2fg_present(int phase, vk::command_buffer& cmd, VkImage target, VkImageLayout layout, vk::viewable_image* src,
+		u32 buffer_w, u32 buffer_h, s32 x1, s32 y1, s32 x2, s32 y2);
+}
+
+extern "C"
+{
+	// VKR2PcExtras.cpp r2pc_reflex_sleep (the game's frame start): Reflex sleep and latency markers through
+	// Streamline. Returns 1 when Streamline handled it.
+	int r2fg_game_frame(void);
+	// Live state for the PC menu / OSD: 0 off, else the frame multiplier in use (2/3/4)
+	extern volatile int g_r2fg_active;
+}
diff --git a/rpcs3/Emu/RSX/VK/VKR2Gfx.cpp b/rpcs3/Emu/RSX/VK/VKR2Gfx.cpp
new file mode 100644
index 0000000..eb690aa
--- /dev/null
+++ b/rpcs3/Emu/RSX/VK/VKR2Gfx.cpp
@@ -0,0 +1,1023 @@
+// R2PORT: optional graphics-quality upgrades for the Resistance ports (see VKR2Gfx.h for the switches).
+//
+// Per-surface resolution: RPCS3 already supports surfaces of different resolution scales side by side (the
+// active rsx::thread::resolution_scaling_config is stamped on every surface created or bound; sampling, blits
+// and copies use the surface's own scale). VKR2Upscaler.cpp uses this to render the scene section at a reduced
+// scale. r2gx_bind(0) runs before r2aa_before_bind and puts back the configuration it replaced, r2gx_bind(1)
+// runs after it and raises the scale for the new bind when it is a shadow map or an effect target, so the
+// upscaler always sees (and saves) the configuration it would see without this file.
+#include "stdafx.h"
+#include "VKGSRender.h"
+#include "VKR2Gfx.h"
+#include "VKR2Upscaler.h" // R2PORT: SSAO off under DLSS
+#include "VKCompute.h"
+#include "VKHelpers.h"
+#include "VKRenderPass.h"
+#include "VKResourceManager.h"
+#include "vkutils/sampler.h"
+#include "Emu/RSX/rsx_methods.h"
+#include "Emu/system_config.h"
+#include "Emu/RSX/Common/TextureUtils.h"
+#include "Emu/RSX/NV47/HW/context_accessors.define.h"
+
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <cmath>
+#include <algorithm>
+#include <filesystem>
+#include <fstream>
+#include <memory>
+#include <string>
+#include <unordered_map>
+#include <unordered_set>
+
+#ifdef _MSC_VER
+#pragma warning(push, 0)
+#endif
+#if defined(__clang__)
+#pragma clang diagnostic push
+#pragma clang diagnostic ignored "-Weverything"
+#endif
+#define STB_IMAGE_WRITE_IMPLEMENTATION
+#define STB_IMAGE_WRITE_STATIC
+#include <stb_image_write.h>
+#include <stb_image.h>
+#if defined(__clang__)
+#pragma clang diagnostic pop
+#endif
+#ifdef _MSC_VER
+#pragma warning(pop)
+#endif
+
+namespace
+{
+	void gxlog(const char* fmt, ...)
+	{
+		char buf[512];
+		va_list ap;
+		va_start(ap, fmt);
+		std::vsnprintf(buf, sizeof buf, fmt, ap);
+		va_end(ap);
+		std::fprintf(stderr, "[r2gx] %s\n", buf);
+	}
+
+	float env_f(const char* name, float def, float lo, float hi)
+	{
+		const char* e = std::getenv(name);
+		if (!e || !*e) return def;
+		const float v = static_cast<float>(std::atof(e));
+		return (v >= lo && v <= hi) ? v : def;
+	}
+
+	struct gx_config
+	{
+		int shadow = 1;        // RSX_SHADOW_SCALE 1/2/4
+		int fx = 0;            // RSX_FX_FULLRES 0/1/2
+		bool hud = false;      // RSX_HUD_FIX
+		bool ssao = false;     // RSX_SSAO
+		float ssao_strength = 0.6f;
+		float ssao_radius = 1.0f;
+		int ssao_debug = 0;
+		bool ssao_ups = true;  // RSX_SSAO_UPSCALER: under DLSS/FSR/XeSS, SSAO runs on the upscaler's input
+		int ssao_log = 0;      // RSX_SSAO_LOG: log the targets of the first SSAO runs (and every N-th)
+		bool any = false;
+	};
+
+	const gx_config& gxcfg()
+	{
+		static const gx_config c = []
+		{
+			gx_config r;
+			if (const char* e = std::getenv("RSX_SHADOW_SCALE"))
+			{
+				const int v = std::atoi(e);
+				r.shadow = v >= 4 ? 4 : v >= 2 ? 2 : 1;
+			}
+			if (const char* e = std::getenv("RSX_FX_FULLRES"))
+			{
+				const int v = std::atoi(e);
+				r.fx = v >= 2 ? 2 : v == 1 ? 1 : 0;
+			}
+			if (const char* e = std::getenv("RSX_HUD_FIX")) r.hud = std::atoi(e) > 0 || !_stricmp(e, "on");
+			if (const char* e = std::getenv("RSX_SSAO")) r.ssao = std::atoi(e) > 0 || !_stricmp(e, "on");
+			// SSAO follows RSX_SSAO under every upscaler. RSX_SSAO_DLSS=0 turns it off when DLSS is the upscaler (RSX_FSR=2).
+			// (Beta 0.2 forced it off under DLSS: the pass ran at the end of whichever scene-size pass came last and was
+			// not tied to the upscaler; it now runs inside the upscaler on the exact scene it consumes.)
+			bool ssao_dlss_off = false;
+			if (r.ssao && vk::r2aa_mode() == 2)
+			{
+				const char* e = std::getenv("RSX_SSAO_DLSS");
+				ssao_dlss_off = e && *e && std::atoi(e) <= 0;
+				if (ssao_dlss_off) r.ssao = false;
+			}
+			r.ssao_strength = env_f("RSX_SSAO_STRENGTH", 0.6f, 0.f, 1.f);
+			r.ssao_radius = env_f("RSX_SSAO_RADIUS", 1.0f, 0.1f, 8.f);
+			if (const char* e = std::getenv("RSX_SSAO_DEBUG")) r.ssao_debug = std::atoi(e);
+			if (const char* e = std::getenv("RSX_SSAO_UPSCALER")) r.ssao_ups = std::atoi(e) != 0;
+			if (const char* e = std::getenv("RSX_SSAO_LOG")) r.ssao_log = std::max(0, std::atoi(e));
+			r.any = r.shadow > 1 || r.fx > 0 || r.hud || r.ssao;
+			if (ssao_dlss_off) gxlog("SSAO disabled under DLSS (RSX_SSAO_DLSS=0)");
+			gxlog("shadow map scale %dx, effects full-res %d, HUD fix %s, SSAO %s (strength %.2f, radius %.2f)",
+				r.shadow, r.fx, r.hud ? "on" : "off", r.ssao ? "on" : "off", r.ssao_strength, r.ssao_radius);
+			return r;
+		}();
+		return c;
+	}
+
+	struct gx_state
+	{
+		bool applied = false;
+		rsx::surface_scaling_config_t saved{};
+		float slope = 1.f;
+
+		// largest colour+depth pass of the current frame (the scene); reset when a display buffer is bound
+		u16 scene_w = 0, scene_h = 0;
+
+		// HUD squeeze wanted for the current bind / last written into the vertex env
+		float hud_x = 0.f, hud_y = 0.f;
+		float env_x = -1.f, env_y = -1.f;
+
+		// the bind that is current (for SSAO at its end)
+		bool cur_scene = false;
+		u16 cur_w = 0, cur_h = 0;
+		u32 cur_draws = 0;
+		bool ao_done = false;
+		bool ao_warned = false;
+		u32 ao_runs = 0;
+		u32 ao_geom[4] = {};
+		u32 ao_geom_log = 0;
+		std::unique_ptr<vk::viewable_image> ao, ao_out;
+		VkFormat ao_out_fmt = VK_FORMAT_UNDEFINED;
+
+		u32 logged_shadow = 0, logged_fx = 0;
+	};
+	gx_state g_gx;
+
+	bool layout_has_color(const rsx::framebuffer_layout& l)
+	{
+		for (u32 a : l.color_addresses)
+			if (a) return true;
+		return false;
+	}
+
+	std::unique_ptr<vk::viewable_image> gx_make_image(VkFormat fmt, u32 w, u32 h, VkImageUsageFlags usage)
+	{
+		const auto pdev = vk::get_current_renderer();
+		return std::make_unique<vk::viewable_image>(*pdev, pdev->get_memory_mapping().device_local, VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT,
+			VK_IMAGE_TYPE_2D, fmt, w, h, 1, 1, 1, VK_SAMPLE_COUNT_1_BIT, VK_IMAGE_LAYOUT_UNDEFINED, VK_IMAGE_TILING_OPTIMAL,
+			usage, vk::VK_IMAGE_CREATE_ALLOW_NULL_RPCS3, VMM_ALLOCATION_POOL_SWAPCHAIN, RSX_FORMAT_CLASS_COLOR);
+	}
+
+	vk::image_view* gx_view(vk::image* img, VkImageAspectFlags aspect = VK_IMAGE_ASPECT_COLOR_BIT)
+	{
+		return static_cast<vk::viewable_image*>(img)->get_view(rsx::default_remap_vector.with_encoding(vk::VK_REMAP_IDENTITY), aspect);
+	}
+}
+
+namespace vk
+{
+	// Depth -> ambient occlusion (R8). Pairs of opposite samples: on a plane the two depth differences cancel,
+	// in a crease both samples are in front of the centre. Depth is the standard (non-reversed) perspective
+	// depth; 1/(1-d) is proportional to the view distance, so all comparisons are relative.
+	struct r2gx_ao_pass : compute_task
+	{
+		const vk::image_view* in_depth = nullptr;
+		const vk::image_view* out_ao = nullptr;
+		std::unique_ptr<vk::sampler> m_sampler;
+
+		r2gx_ao_pass()
+		{
+			m_src =
+				"#version 450\n"
+				"layout(local_size_x = 8, local_size_y = 8) in;\n"
+				"layout(set=0, binding=0) uniform sampler2D DepthIn;\n"
+				"layout(set=0, binding=1, r8) uniform writeonly image2D AoOut;\n"
+				// a: w, h, strength, radius; b: max radius px, region / size of the depth image (yz: the depth surface can be
+				// larger than the drawn region, e.g. a reduced DLSS/FSR input scale inside a full-size allocation)
+				"layout(push_constant) uniform PC { vec4 a; vec4 b; };\n"
+				"float vz(vec2 uv) { return 1.0 / max(1.0 - textureLod(DepthIn, clamp(uv, 0.5 / a.xy, 1.0 - 0.5 / a.xy) * b.yz, 0.0).r, 1e-7); }\n"
+				"void main()\n"
+				"{\n"
+				"	ivec2 p = ivec2(gl_GlobalInvocationID.xy);\n"
+				"	if (p.x >= int(a.x) || p.y >= int(a.y)) return;\n"
+				"	vec2 px = 1.0 / a.xy;\n"
+				"	vec2 uv = (vec2(p) + 0.5) * px;\n"
+				"	float d = textureLod(DepthIn, uv * b.yz, 0.0).r;\n"
+				"	if (d >= 0.99999 || d <= 0.0) { imageStore(AoOut, p, vec4(1.0)); return; }\n"
+				"	float zc = 1.0 / max(1.0 - d, 1e-7);\n"
+				// a world radius at a distance proportional to zc: its size on screen is proportional to 1/zc
+				"	float rpx = clamp(a.w * a.y * 40.0 / zc, 2.0, b.x);\n"
+				"	float rel = rpx / (0.87 * a.y);\n" // world radius / distance
+				// 16 rotations on a 4x4 grid (Bayer order): the 4x4 blur of the apply pass averages every rotation exactly, so
+				// the result has no noise and does not change as content moves by sub-pixel amounts (upscaler jitter)
+				"	const float bayer[16] = float[16](0., 8., 2., 10., 12., 4., 14., 6., 3., 11., 1., 9., 15., 7., 13., 5.);\n"
+				"	float ang = 6.2831853 * (bayer[(p.y & 3) * 4 + (p.x & 3)] + 0.5) / 16.0;\n"
+				"	float occ = 0.0;\n"
+				"	for (int i = 0; i < 8; ++i)\n"
+				"	{\n"
+				"		float t = (float(i) + 0.5) / 8.0;\n"
+				"		float r = rpx * (0.25 + 0.75 * t);\n"
+				"		float an = ang + float(i) * 2.39996323;\n"
+				"		vec2 o = vec2(cos(an), sin(an)) * r * px;\n"
+				"		float d1 = (zc - vz(uv + o)) / zc;\n"
+				"		float d2 = (zc - vz(uv - o)) / zc;\n"
+				"		float crease = 0.5 * (d1 + d2) / rel;\n"
+				"		float range = (1.0 - smoothstep(2.0, 4.0, d1 / rel)) * (1.0 - smoothstep(2.0, 4.0, d2 / rel));\n"
+				"		occ += clamp(crease * 2.0, 0.0, 1.0) * range;\n"
+				"	}\n"
+				"	float ao = 1.0 - a.z * occ / 8.0;\n"
+				"	imageStore(AoOut, p, vec4(clamp(ao, 0.0, 1.0)));\n"
+				"}\n";
+			ssbo_count = 0;
+			use_push_constants = true;
+			push_constants_size = 32;
+			create();
+		}
+
+		std::vector<glsl::program_input> get_inputs() override
+		{
+			auto result = compute_task::get_inputs();
+			result.push_back(glsl::program_input::make(::glsl::program_domain::glsl_compute_program, "DepthIn", vk::glsl::input_type_texture, 0, 0));
+			result.push_back(glsl::program_input::make(::glsl::program_domain::glsl_compute_program, "AoOut", vk::glsl::input_type_storage_texture, 0, 1));
+			return result;
+		}
+
+		void bind_resources(const vk::command_buffer&) override
+		{
+			if (!m_sampler)
+			{
+				m_sampler = std::make_unique<vk::sampler>(*vk::get_current_renderer(),
+					VK_SAMPLER_ADDRESS_MODE_CLAMP_TO_EDGE, VK_SAMPLER_ADDRESS_MODE_CLAMP_TO_EDGE, VK_SAMPLER_ADDRESS_MODE_CLAMP_TO_EDGE,
+					VK_FALSE, 0.f, 1.f, 0.f, 0.f, VK_FILTER_NEAREST, VK_FILTER_NEAREST, VK_SAMPLER_MIPMAP_MODE_NEAREST, VK_BORDER_COLOR_FLOAT_OPAQUE_WHITE);
+			}
+			m_program->bind_uniform({ *in_depth, *m_sampler }, 0, 0);
+			m_program->bind_uniform({ *out_ao }, 0, 1);
+		}
+
+		void run(const vk::command_buffer& cmd, const float* constants, u32 w, u32 h)
+		{
+			if (!m_program) load_program(cmd);
+			vkCmdPushConstants(cmd, m_program->layout(), VK_SHADER_STAGE_COMPUTE_BIT, 0, push_constants_size, constants);
+			compute_task::run(cmd, (w + 7) / 8, (h + 7) / 8, 1);
+		}
+	};
+
+	// Depth-aware 4x4 blur of the AO term, multiplied into the scene colour (alpha kept)
+	template <bool HalfFloat>
+	struct r2gx_ao_apply_pass : compute_task
+	{
+		const vk::image_view* in_color = nullptr;
+		const vk::image_view* in_ao = nullptr;
+		const vk::image_view* in_depth = nullptr;
+		const vk::image_view* out_color = nullptr;
+		std::unique_ptr<vk::sampler> m_sampler;
+
+		r2gx_ao_apply_pass()
+		{
+			m_src = std::string(
+				"#version 450\n"
+				"layout(local_size_x = 8, local_size_y = 8) in;\n"
+				"layout(set=0, binding=0) uniform sampler2D ColorIn;\n"
+				"layout(set=0, binding=1) uniform sampler2D AoIn;\n"
+				"layout(set=0, binding=2) uniform sampler2D DepthIn;\n") +
+				(HalfFloat ? "layout(set=0, binding=3, rgba16f) uniform writeonly image2D ColorOut;\n"
+				           : "layout(set=0, binding=3, rgba8) uniform writeonly image2D ColorOut;\n") +
+				// a: w, h, swap R/B, debug; b: region / size of the depth image (xy) and of the AO image (zw): both images can be
+				// larger than the region (the AO image keeps the largest size seen)
+				"layout(push_constant) uniform PC { vec4 a; vec4 b; };\n"
+				"float vz(vec2 uv) { return 1.0 / max(1.0 - textureLod(DepthIn, clamp(uv, 0.5 / a.xy, 1.0 - 0.5 / a.xy) * b.xy, 0.0).r, 1e-7); }\n"
+				"void main()\n"
+				"{\n"
+				"	ivec2 p = ivec2(gl_GlobalInvocationID.xy);\n"
+				"	if (p.x >= int(a.x) || p.y >= int(a.y)) return;\n"
+				"	vec2 px = 1.0 / a.xy;\n"
+				"	vec2 uv = (vec2(p) + 0.5) * px;\n"
+				"	float zc = vz(uv);\n"
+				"	float s = 0.0, wsum = 0.0;\n"
+				"	for (int y = -2; y < 2; ++y)\n"
+				"		for (int x = -2; x < 2; ++x)\n"
+				"		{\n"
+				"			vec2 q = uv + vec2(x, y) * px;\n" // texel centres (half-texel offsets were exact texel edges: NEAREST picked either side)
+				"			float w = 1.0 / (1e-3 + abs(vz(q) - zc) / zc * 50.0);\n"
+				"			s += textureLod(AoIn, clamp(q, 0.5 / a.xy, 1.0 - 0.5 / a.xy) * b.zw, 0.0).r * w;\n"
+				"			wsum += w;\n"
+				"		}\n"
+				"	float ao = wsum > 0.0 ? s / wsum : 1.0;\n"
+				"	vec4 c = texelFetch(ColorIn, p, 0);\n"
+				"	vec4 r = a.w > 0.5 ? vec4(vec3(ao), c.a) : vec4(c.rgb * ao, c.a);\n"
+				"	if (a.z > 0.5) r = r.bgra;\n"
+				"	imageStore(ColorOut, p, r);\n"
+				"}\n";
+			ssbo_count = 0;
+			use_push_constants = true;
+			push_constants_size = 32;
+			create();
+		}
+
+		std::vector<glsl::program_input> get_inputs() override
+		{
+			auto result = compute_task::get_inputs();
+			const char* names[] = { "ColorIn", "AoIn", "DepthIn", "ColorOut" };
+			for (u32 i = 0; i < 4; ++i)
+			{
+				result.push_back(glsl::program_input::make(::glsl::program_domain::glsl_compute_program, names[i],
+					i < 3 ? vk::glsl::input_type_texture : vk::glsl::input_type_storage_texture, 0, i));
+			}
+			return result;
+		}
+
+		void bind_resources(const vk::command_buffer&) override
+		{
+			if (!m_sampler)
+			{
+				m_sampler = std::make_unique<vk::sampler>(*vk::get_current_renderer(),
+					VK_SAMPLER_ADDRESS_MODE_CLAMP_TO_EDGE, VK_SAMPLER_ADDRESS_MODE_CLAMP_TO_EDGE, VK_SAMPLER_ADDRESS_MODE_CLAMP_TO_EDGE,
+					VK_FALSE, 0.f, 1.f, 0.f, 0.f, VK_FILTER_NEAREST, VK_FILTER_NEAREST, VK_SAMPLER_MIPMAP_MODE_NEAREST, VK_BORDER_COLOR_FLOAT_OPAQUE_WHITE);
+			}
+			m_program->bind_uniform({ *in_color, *m_sampler }, 0, 0);
+			m_program->bind_uniform({ *in_ao, *m_sampler }, 0, 1);
+			m_program->bind_uniform({ *in_depth, *m_sampler }, 0, 2);
+			m_program->bind_uniform({ *out_color }, 0, 3);
+		}
+
+		void run(const vk::command_buffer& cmd, const float* constants, u32 w, u32 h)
+		{
+			if (!m_program) load_program(cmd);
+			vkCmdPushConstants(cmd, m_program->layout(), VK_SHADER_STAGE_COMPUTE_BIT, 0, push_constants_size, constants);
+			compute_task::run(cmd, (w + 7) / 8, (h + 7) / 8, 1);
+		}
+	};
+}
+
+float r2gx::slope_bias_scale()
+{
+	return g_gx.slope;
+}
+
+bool r2gx::hud_fix_enabled()
+{
+	return gxcfg().hud;
+}
+
+bool VKGSRender::r2gx_is_display(u32 addr) const
+{
+	if (!addr) return false;
+	for (u32 i = 0; i < m_ctx->display_buffers_count; ++i)
+	{
+		const auto& buffer = m_ctx->display_buffers[i];
+		if (buffer.valid() && rsx::get_address(m_ctx, buffer.offset, CELL_GCM_LOCATION_LOCAL) == addr)
+			return true;
+	}
+	return false;
+}
+
+void VKGSRender::r2gx_set_scale(u16 pct, float slope)
+{
+	auto& cfg = RSX(m_ctx)->resolution_scaling_config;
+	if (!g_gx.applied)
+	{
+		g_gx.saved = cfg;
+		g_gx.applied = true;
+	}
+	cfg.scale_percent = pct;
+	g_gx.slope = slope;
+	m_ctx->draw_state.dirty.set(rsx::draw_state_t::group::viewport);
+	m_ctx->draw_state.dirty.set(rsx::draw_state_t::group::scissor);
+	m_ctx->draw_state.dirty.set(rsx::draw_state_t::group::vertex_env);
+	m_ctx->draw_state.dirty.set(rsx::draw_state_t::group::fragment_env);
+}
+
+void VKGSRender::r2gx_bind(int phase)
+{
+	static const bool tp_once = (r2gx::texpack_init(), true); // textures are uploaded by draws, after the first bind
+	(void)tp_once;
+	const auto& c = gxcfg();
+	if (!c.any) return;
+	// R2PORT: build the SSAO compute pipelines at the first bind (boot), not at the first
+	// gameplay frame that wants SSAO (a render-thread compile there is a visible hitch)
+	static const bool ao_prewarm = c.ssao ? (vk::get_compute_task<vk::r2gx_ao_pass>(), vk::get_compute_task<vk::r2gx_ao_apply_pass<true>>(),
+		vk::get_compute_task<vk::r2gx_ao_apply_pass<false>>(), true) : false;
+	(void)ao_prewarm;
+	auto& st = g_gx;
+	const auto& L = m_ctx->fb.layout; // the layout about to be bound
+
+	if (phase == 0)
+	{
+		// SSAO at the end of the last scene-sized colour+depth pass, when the first smaller colour pass
+		// (the post-processing chain) is bound. Depth-only binds (shadow maps) in between don't end it.
+		// Under an active upscaler it runs inside r2aa_run instead (r2gx_ssao_upscaler).
+		if (c.ssao && st.cur_scene && !st.ao_done && st.cur_draws >= 8 && layout_has_color(L) &&
+			!(L.width == st.scene_w && L.height == st.scene_h) && !(c.ssao_ups && vk::r2aa_active()))
+		{
+			st.ao_done = true;
+			r2gx_ssao();
+		}
+		if (st.applied)
+		{
+			RSX(m_ctx)->resolution_scaling_config = st.saved;
+			st.applied = false;
+			st.slope = 1.f;
+			m_ctx->draw_state.dirty.set(rsx::draw_state_t::group::viewport);
+			m_ctx->draw_state.dirty.set(rsx::draw_state_t::group::scissor);
+			m_ctx->draw_state.dirty.set(rsx::draw_state_t::group::vertex_env);
+			m_ctx->draw_state.dirty.set(rsx::draw_state_t::group::fragment_env);
+		}
+		return;
+	}
+
+	const bool color = layout_has_color(L);
+	const bool disp = color && r2gx_is_display(L.color_addresses[0]);
+	st.cur_scene = false;
+	st.cur_draws = 0;
+	st.hud_x = st.hud_y = 0.f;
+
+	if (disp)
+	{
+		// a new frame's scene is measured from scratch (dynamic resolution changes it between frames)
+		st.scene_w = st.scene_h = 0;
+		st.ao_done = false;
+		if (c.hud && g_cfg.video.stretch_to_display_area && m_swapchain_dims.width > 64 && m_swapchain_dims.height > 64 && L.height)
+		{
+			const float base = static_cast<float>(L.width) / static_cast<float>(L.height);
+			const float win = static_cast<float>(m_swapchain_dims.width) / static_cast<float>(m_swapchain_dims.height);
+			if (win > base * 1.01f) st.hud_x = base / win;
+			else if (win < base / 1.01f) st.hud_y = win / base;
+		}
+		return;
+	}
+
+	if (color && L.zeta_address && L.width >= 640 && L.height >= 360 && L.width != L.height &&
+		static_cast<u32>(L.width) * L.height >= static_cast<u32>(st.scene_w) * st.scene_h)
+	{
+		st.scene_w = L.width;
+		st.scene_h = L.height;
+	}
+	st.cur_scene = color && L.zeta_address && L.width == st.scene_w && L.height == st.scene_h;
+	st.cur_w = L.width;
+	st.cur_h = L.height;
+
+	const auto& cfg = RSX(m_ctx)->resolution_scaling_config;
+	int k = 1;
+	bool shadow = false;
+	if (c.shadow > 1 && !color && L.zeta_address && L.width == L.height && L.width >= 256 && L.width <= 2048 &&
+		(L.width & (L.width - 1)) == 0)
+	{
+		k = c.shadow;
+		shadow = true;
+	}
+	else if (c.fx && color)
+	{
+		const int sw = st.scene_w, sh = st.scene_h, w = L.width, h = L.height;
+		if (sw && w < sw)
+		{
+			if (std::abs(2 * w - sw) <= 4 && std::abs(2 * h - sh) <= 4) k = 2;
+			else if (c.fx >= 2 && std::abs(4 * w - sw) <= 8 && std::abs(4 * h - sh) <= 8) k = 4;
+		}
+	}
+	if (k <= 1) return;
+
+	u32 pct = static_cast<u32>(cfg.scale_percent) * k;
+	const u32 max_dim = 8192;
+	const u32 dim = std::max<u32>(L.width, L.height);
+	if (dim * pct / 100 > max_dim) pct = max_dim * 100 / dim;
+	if (pct <= cfg.scale_percent) return;
+	const float ratio = static_cast<float>(pct) / static_cast<float>(cfg.scale_percent);
+	r2gx_set_scale(static_cast<u16>(pct), shadow ? ratio : 1.f);
+
+	u32& logged = shadow ? st.logged_shadow : st.logged_fx;
+	if (logged < 8)
+	{
+		logged++;
+		gxlog("%s target %ux%u (color 0x%08x, depth 0x%08x): scale %u%% -> %u%%", shadow ? "shadow map" : "effect",
+			L.width, L.height, L.color_addresses[0], L.zeta_address, st.saved.scale_percent, pct);
+	}
+}
+
+int VKGSRender::r2gx_on_draw()
+{
+	auto& st = g_gx;
+	const auto& c = gxcfg();
+	if (!c.any) return 0;
+	if (st.cur_scene && REGS(m_ctx)->depth_test_enabled()) st.cur_draws++;
+	return (c.hud && (st.hud_x != st.env_x || st.hud_y != st.env_y)) ? 1 : 0;
+}
+
+void VKGSRender::r2gx_patch_vertex_env(void* env)
+{
+	// vertex_context_t.reserved[0..1] (bytes 84..91): HUD squeeze factors read by the RSX_HUD_FIX epilogue
+	if (!gxcfg().hud) return;
+	float* f = static_cast<float*>(env);
+	f[21] = g_gx.hud_x;
+	f[22] = g_gx.hud_y;
+	g_gx.env_x = g_gx.hud_x;
+	g_gx.env_y = g_gx.hud_y;
+}
+
+namespace
+{
+	// RSX_SSAO_UV (default 1): sample depth and AO in the drawn region only. Under DLSS/FSR the scene is drawn at a
+	// reduced scale inside surfaces allocated for the full scale, and the AO image keeps the largest size seen;
+	// normalised 0..1 coordinates over the whole image stretched the depth / AO term (a dark offset copy of every
+	// character, growing toward the bottom right). 0 = old behaviour.
+	bool gx_uv_fix()
+	{
+		static const bool on = [] { const char* e = std::getenv("RSX_SSAO_UV"); return !e || std::atoi(e) != 0; }();
+		return on;
+	}
+}
+
+void VKGSRender::r2gx_ssao()
+{
+	auto& st = g_gx;
+	auto& sc = res()->surface_cache;
+	auto* rt = sc.m_bound_render_targets[0].second;
+	auto* ds = sc.m_bound_depth_stencil.second;
+	if (!rt || !ds)
+	{
+		if (!st.ao_warned)
+		{
+			st.ao_warned = true;
+			gxlog("SSAO skipped: no scene targets bound");
+		}
+		return;
+	}
+	const auto [sw, sh] = rsx::apply_resolution_scale<true>(rt->resolution_scaling_config, st.cur_w, st.cur_h);
+	const auto [dsw, dsh] = rsx::apply_resolution_scale<true>(ds->resolution_scaling_config, st.cur_w, st.cur_h);
+	const bool uv_fix = gx_uv_fix();
+	r2gx_ssao_apply(rt, ds, std::min<u32>(sw, rt->info.extent.width), std::min<u32>(sh, rt->info.extent.height),
+		uv_fix ? std::min<u32>(dsw, ds->info.extent.width) : ds->info.extent.width,
+		uv_fix ? std::min<u32>(dsh, ds->info.extent.height) : ds->info.extent.height, "scene pass end");
+}
+
+void VKGSRender::r2gx_ssao_upscaler(vk::render_target* rt, vk::render_target* ds, u32 w, u32 h, u32 dw, u32 dh)
+{
+	const auto& c = gxcfg();
+	if (!c.ssao || !c.ssao_ups || !rt || !ds) return;
+	r2gx_ssao_apply(rt, ds, w, h, dw, dh, "upscaler input");
+}
+
+// AO of the w x h region of 'ds' (its top-left dw x dh texels cover the same area) multiplied into the w x h region of 'rt'
+void VKGSRender::r2gx_ssao_apply(vk::render_target* rt, vk::render_target* ds, u32 w, u32 h, u32 dw, u32 dh, const char* path)
+{
+	auto& st = g_gx;
+	const auto skip = [&](const char* why)
+	{
+		if (!st.ao_warned)
+		{
+			st.ao_warned = true;
+			gxlog("SSAO skipped: %s", why);
+		}
+	};
+	if (rt->samples() > 1 || ds->samples() > 1) return skip("the scene is multisampled (set R2_MSAA=0 or use DLSS/FSR)");
+	const VkFormat cfmt = rt->info.format;
+	const bool half = cfmt == VK_FORMAT_R16G16B16A16_SFLOAT;
+	const bool swap = cfmt == VK_FORMAT_B8G8R8A8_UNORM;
+	if (!half && !swap && cfmt != VK_FORMAT_R8G8B8A8_UNORM) return skip("unsupported scene colour format");
+	w = std::min<u32>(w, rt->info.extent.width);
+	h = std::min<u32>(h, rt->info.extent.height);
+	dw = std::max<u32>(1, std::min<u32>(dw, ds->info.extent.width));
+	dh = std::max<u32>(1, std::min<u32>(dh, ds->info.extent.height));
+	if (w < 64 || h < 64) return;
+
+	const VkImageUsageFlags usage = VK_IMAGE_USAGE_STORAGE_BIT | VK_IMAGE_USAGE_SAMPLED_BIT | VK_IMAGE_USAGE_TRANSFER_SRC_BIT;
+	const VkFormat ofmt = half ? VK_FORMAT_R16G16B16A16_SFLOAT : VK_FORMAT_R8G8B8A8_UNORM;
+	if (!st.ao || st.ao->width() < w || st.ao->height() < h || st.ao_out_fmt != ofmt)
+	{
+		const u32 aw = std::max<u32>(w, st.ao ? st.ao->width() : 0), ah = std::max<u32>(h, st.ao ? st.ao->height() : 0);
+		// the old images may still be in use by submitted work
+		if (st.ao) vk::get_resource_manager()->dispose(st.ao);
+		if (st.ao_out) vk::get_resource_manager()->dispose(st.ao_out);
+		st.ao = gx_make_image(VK_FORMAT_R8_UNORM, aw, ah, usage);
+		st.ao_out = gx_make_image(ofmt, aw, ah, usage);
+		st.ao_out_fmt = ofmt;
+		gxlog("SSAO buffers %ux%u", aw, ah);
+	}
+
+	auto& cmd = *m_current_command_buffer;
+	if (vk::is_renderpass_open(cmd)) vk::end_renderpass(cmd);
+
+	const auto& c = gxcfg();
+	rt->read_barrier(cmd);
+	ds->read_barrier(cmd);
+	rt->push_layout(cmd, VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL);
+	ds->push_layout(cmd, VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL);
+	st.ao->change_layout(cmd, VK_IMAGE_LAYOUT_GENERAL);
+
+	auto* depth_view = gx_view(ds, VK_IMAGE_ASPECT_DEPTH_BIT);
+	const bool uv_fix = gx_uv_fix();
+	const float dx = static_cast<float>(dw) / ds->info.extent.width;
+	const float dy = static_cast<float>(dh) / ds->info.extent.height;
+	const float ax = uv_fix ? static_cast<float>(w) / st.ao->width() : 1.f;
+	const float ay = uv_fix ? static_cast<float>(h) / st.ao->height() : 1.f;
+	if (st.ao_geom_log < 4 && (st.ao_geom[0] != w || st.ao_geom[1] != h || st.ao_geom[2] != ds->info.extent.width || st.ao_geom[3] != dw))
+	{
+		st.ao_geom_log++;
+		st.ao_geom[0] = w; st.ao_geom[1] = h; st.ao_geom[2] = ds->info.extent.width; st.ao_geom[3] = dw;
+		gxlog("SSAO geometry (%s): colour region %ux%u (image %ux%u), depth region %ux%u (image %ux%u), AO image %ux%u, region-only sampling %s",
+			path, w, h, rt->info.extent.width, rt->info.extent.height, dw, dh, ds->info.extent.width, ds->info.extent.height,
+			st.ao->width(), st.ao->height(), uv_fix ? "on" : "off (RSX_SSAO_UV=0)");
+	}
+	if (c.ssao_log && (st.ao_runs < 8 || (st.ao_runs % static_cast<u32>(c.ssao_log)) == 0))
+	{
+		gxlog("SSAO run %u (%s): colour %08x %ux%u (%u%%, fmt %d) depth %08x %ux%u (%u%%), region %ux%u / depth %ux%u, guest bind %ux%u, %u scene draws",
+			st.ao_runs, path, rt->get_memory_range().start, rt->info.extent.width, rt->info.extent.height, rt->resolution_scaling_config.scale_percent,
+			static_cast<int>(cfmt), ds->get_memory_range().start, ds->info.extent.width, ds->info.extent.height, ds->resolution_scaling_config.scale_percent,
+			w, h, dw, dh, st.cur_w, st.cur_h, st.cur_draws);
+	}
+	{
+		auto pass = vk::get_compute_task<vk::r2gx_ao_pass>();
+		pass->in_depth = depth_view;
+		pass->out_ao = gx_view(st.ao.get());
+		const float k[8] = { static_cast<float>(w), static_cast<float>(h), c.ssao_strength, c.ssao_radius,
+			static_cast<float>(h) * 0.06f, dx, dy, 0.f };
+		pass->run(cmd, k, w, h);
+	}
+	st.ao->change_layout(cmd, VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL);
+	st.ao_out->change_layout(cmd, VK_IMAGE_LAYOUT_GENERAL);
+	{
+		const float k[8] = { static_cast<float>(w), static_cast<float>(h), swap ? 1.f : 0.f, c.ssao_debug ? 1.f : 0.f, dx, dy, ax, ay };
+		const auto setup = [&](auto* pass)
+		{
+			pass->in_color = gx_view(rt);
+			pass->in_ao = gx_view(st.ao.get());
+			pass->in_depth = depth_view;
+			pass->out_color = gx_view(st.ao_out.get());
+			pass->run(cmd, k, w, h);
+		};
+		if (half) setup(vk::get_compute_task<vk::r2gx_ao_apply_pass<true>>());
+		else setup(vk::get_compute_task<vk::r2gx_ao_apply_pass<false>>());
+	}
+	ds->pop_layout(cmd);
+	rt->pop_layout(cmd);
+
+	st.ao_out->change_layout(cmd, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL);
+	rt->push_layout(cmd, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL);
+	VkImageCopy region{};
+	region.srcSubresource = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1 };
+	region.dstSubresource = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1 };
+	region.extent = { w, h, 1 };
+	vkCmdCopyImage(cmd, st.ao_out->value, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, rt->value, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, 1, &region);
+	rt->pop_layout(cmd);
+
+	cmd.r2_invalidate_state_cache();
+	m_current_command_buffer->flags |= vk::command_buffer::cb_reload_dynamic_state;
+	if (!st.ao_runs++) gxlog("SSAO: first frame processed (%ux%u, %u scene draws)", w, h, st.cur_draws);
+}
+
+// ---------------------------------------------------------------------------------------------------------
+// Texture packs
+// ---------------------------------------------------------------------------------------------------------
+bool r2gx::texpack_active = false;
+
+namespace
+{
+	enum : u32
+	{
+		GCM_A8R8G8B8 = 0x85,
+		GCM_DXT1 = 0x86,
+		GCM_DXT23 = 0x87,
+		GCM_DXT45 = 0x88,
+	};
+
+	struct tp_entry
+	{
+		std::filesystem::path path;
+		bool loaded = false;
+		bool bad = false;
+		std::vector<std::vector<u8>> levels; // guest-format data per mip level, tightly packed
+	};
+
+	struct tp_state
+	{
+		bool dump = false;
+		bool load = false;
+		std::filesystem::path dump_dir, pack_dir;
+		std::unordered_set<u64> dumped;
+		std::unordered_map<u64, tp_entry> pack;
+		std::FILE* manifest = nullptr;
+		u32 replaced = 0, dumped_count = 0;
+	};
+	tp_state g_tp;
+
+	u32 block_bytes(u32 fmt) { return fmt == GCM_DXT1 ? 8 : (fmt == GCM_DXT23 || fmt == GCM_DXT45) ? 16 : 4; }
+
+	// Texture key (stable across runs, never the RSX address): 64-bit hash of the texel bytes of every
+	// level (row by row, pitch padding excluded) seeded with width, height, format and mip count.
+	u64 tp_hash(const std::vector<rsx::subresource_layout>& layout, u16 w, u16 h, u32 fmt, u32 mips)
+	{
+		u64 hsh = 0x9E3779B97F4A7C15ull ^ (static_cast<u64>(w) << 48) ^ (static_cast<u64>(h) << 32) ^ (static_cast<u64>(mips & 0xFF) << 8) ^ fmt;
+		const auto mix = [&](u64 v)
+		{
+			hsh ^= v;
+			hsh *= 0xFF51AFD7ED558CCDull;
+			hsh ^= hsh >> 32;
+		};
+		const auto bytes = [&](const u8* p, usz n)
+		{
+			usz i = 0;
+			for (; i + 8 <= n; i += 8)
+			{
+				u64 v;
+				std::memcpy(&v, p + i, 8);
+				mix(v);
+			}
+			u64 tail = 0;
+			std::memcpy(&tail, p + i, n - i);
+			mix(tail ^ (static_cast<u64>(n) << 56));
+		};
+		const u32 bb = block_bytes(fmt);
+		for (const auto& s : layout)
+		{
+			const u8* p = s.data.data<u8>();
+			const usz n = s.data.size();
+			if (!p) continue;
+			const usz row = static_cast<usz>(s.width_in_block) * bb;
+			const usz pitch = static_cast<usz>(std::max<u32>(s.pitch_in_block, s.width_in_block)) * bb;
+			const usz rows = static_cast<usz>(s.height_in_block) * std::max<u32>(1, s.depth);
+			usz o = 0;
+			for (usz y = 0; y < rows && o < n; ++y, o += pitch)
+				bytes(p + o, std::min(row, n - o));
+		}
+		return hsh;
+	}
+	bool is_dxt(u32 fmt) { return fmt == GCM_DXT1 || fmt == GCM_DXT23 || fmt == GCM_DXT45; }
+
+	// RSX swizzle: Morton order, x in the even bits; the extra bits of the larger side on top
+	u32 swz_offset(u32 x, u32 y, u32 lw, u32 lh)
+	{
+		u32 off = 0, bit = 0;
+		const u32 mn = std::min(lw, lh);
+		for (u32 i = 0; i < mn; ++i)
+		{
+			off |= ((x >> i) & 1u) << bit++;
+			off |= ((y >> i) & 1u) << bit++;
+		}
+		if (lw > lh) off |= (x >> mn) << bit;
+		else if (lh > lw) off |= (y >> mn) << bit;
+		return off;
+	}
+
+	u32 ilog2(u32 v) { u32 r = 0; while ((1u << r) < v) ++r; return r; }
+
+	// Guest A8R8G8B8 level 0 -> RGBA8 (linear)
+	bool argb_to_rgba(const rsx::subresource_layout& s, bool swizzled, std::vector<u8>& out)
+	{
+		const u32 w = s.width_in_texel, h = s.height_in_texel;
+		const u8* src = s.data.data<u8>();
+		if (!src || !w || !h) return false;
+		out.resize(static_cast<usz>(w) * h * 4);
+		const u32 lw = ilog2(w), lh = ilog2(h);
+		const usz size = s.data.size();
+		for (u32 y = 0; y < h; ++y)
+			for (u32 x = 0; x < w; ++x)
+			{
+				const usz o = (swizzled ? static_cast<usz>(swz_offset(x, y, lw, lh)) : static_cast<usz>(y) * s.pitch_in_block + x) * 4;
+				if (o + 4 > size) return false;
+				u8* d = &out[(static_cast<usz>(y) * w + x) * 4];
+				d[0] = src[o + 1];
+				d[1] = src[o + 2];
+				d[2] = src[o + 3];
+				d[3] = src[o + 0];
+			}
+		return true;
+	}
+
+	void write_dds(const std::filesystem::path& p, u32 fmt, const std::vector<rsx::subresource_layout>& layout, u16 w, u16 h)
+	{
+		const u32 bb = block_bytes(fmt);
+		std::vector<u8> body;
+		u32 levels = 0;
+		for (const auto& s : layout)
+		{
+			if (s.layer != 0 || s.depth > 1) continue;
+			const u8* src = s.data.data<u8>();
+			const usz row = static_cast<usz>(s.width_in_block) * bb;
+			const usz pitch = static_cast<usz>(std::max<u32>(s.pitch_in_block, s.width_in_block)) * bb;
+			if (!src || static_cast<usz>(s.height_in_block - 1) * pitch + row > s.data.size()) break;
+			for (u32 y = 0; y < s.height_in_block; ++y)
+				body.insert(body.end(), src + y * pitch, src + y * pitch + row);
+			levels++;
+		}
+		if (!levels) return;
+		u32 hdr[32] = {};
+		hdr[0] = 0x20534444; // "DDS "
+		hdr[1] = 124;
+		hdr[2] = 0x1 | 0x2 | 0x4 | 0x1000 | 0x80000 | (levels > 1 ? 0x20000 : 0);
+		hdr[3] = h;
+		hdr[4] = w;
+		hdr[5] = static_cast<u32>(std::max<u32>(1, (w + 3) / 4) * std::max<u32>(1, (h + 3) / 4) * bb);
+		hdr[7] = levels;
+		hdr[19] = 32;      // pixel format size
+		hdr[20] = 0x4;     // DDPF_FOURCC
+		hdr[21] = fmt == GCM_DXT1 ? 0x31545844 : fmt == GCM_DXT23 ? 0x33545844 : 0x35545844;
+		hdr[27] = 0x1000 | (levels > 1 ? 0x400008 : 0);
+		std::ofstream f(p, std::ios::binary);
+		f.write(reinterpret_cast<const char*>(hdr), sizeof hdr);
+		f.write(reinterpret_cast<const char*>(body.data()), static_cast<std::streamsize>(body.size()));
+	}
+
+	void tp_dump(u64 hash, u16 w, u16 h, u32 fmt, u32 mips, bool swizzled, const std::vector<rsx::subresource_layout>& layout)
+	{
+		if (!g_tp.dumped.insert(hash).second) return;
+		char name[96];
+		std::snprintf(name, sizeof name, "%016llx_%ux%u_%02x_m%u", static_cast<unsigned long long>(hash), w, h, fmt, mips);
+		std::error_code ec;
+		std::string file;
+		if (is_dxt(fmt))
+		{
+			file = std::string(name) + ".dds";
+			const auto p = g_tp.dump_dir / file;
+			if (!std::filesystem::exists(p, ec)) write_dds(p, fmt, layout, w, h);
+		}
+		else
+		{
+			file = std::string(name) + ".png";
+			const auto p = g_tp.dump_dir / file;
+			if (!std::filesystem::exists(p, ec))
+			{
+				std::vector<u8> rgba;
+				if (!argb_to_rgba(layout.front(), swizzled, rgba)) return;
+				stbi_write_png(p.string().c_str(), w, h, 4, rgba.data(), w * 4);
+			}
+		}
+		if (g_tp.manifest)
+		{
+			std::fprintf(g_tp.manifest, "%016llx\t%u\t%u\t%s\t%u\t%u\t%s\n", static_cast<unsigned long long>(hash), w, h,
+				fmt == GCM_DXT1 ? "DXT1" : fmt == GCM_DXT23 ? "DXT3" : fmt == GCM_DXT45 ? "DXT5" : "A8R8G8B8", mips, swizzled ? 1u : 0u, file.c_str());
+			std::fflush(g_tp.manifest);
+		}
+		if (g_tp.dumped_count++ < 4 || (g_tp.dumped_count % 500) == 0)
+			gxlog("texture dump: %u textures written to %s", g_tp.dumped_count, g_tp.dump_dir.string().c_str());
+	}
+
+	// Load a replacement into guest-format levels. Same size and (for DDS) same DXT format only.
+	bool tp_load(tp_entry& e, u16 w, u16 h, u32 fmt, u32 mips)
+	{
+		std::ifstream f(e.path, std::ios::binary);
+		std::vector<u8> file((std::istreambuf_iterator<char>(f)), std::istreambuf_iterator<char>());
+		const auto ext = e.path.extension().string();
+		if (!_stricmp(ext.c_str(), ".dds"))
+		{
+			if (!is_dxt(fmt) || file.size() < 128) return false;
+			u32 hdr[32];
+			std::memcpy(hdr, file.data(), 128);
+			const u32 want = fmt == GCM_DXT1 ? 0x31545844 : fmt == GCM_DXT23 ? 0x33545844 : 0x35545844;
+			const bool fmt_ok = hdr[21] == want || (fmt == GCM_DXT23 && hdr[21] == 0x32545844) || (fmt == GCM_DXT45 && hdr[21] == 0x34545844);
+			if (hdr[0] != 0x20534444 || hdr[3] != h || hdr[4] != w || !fmt_ok) return false;
+			const u32 bb = block_bytes(fmt);
+			const u32 have = std::max<u32>(1, hdr[7]);
+			usz off = 128;
+			for (u32 l = 0; l < std::min(have, mips); ++l)
+			{
+				const u32 lw = std::max<u32>(1, w >> l), lh = std::max<u32>(1, h >> l);
+				const usz n = static_cast<usz>((lw + 3) / 4) * ((lh + 3) / 4) * bb;
+				if (off + n > file.size()) break;
+				e.levels.emplace_back(file.begin() + off, file.begin() + off + n);
+				off += n;
+			}
+			return !e.levels.empty();
+		}
+		if (fmt != GCM_A8R8G8B8) return false;
+		int iw = 0, ih = 0, ic = 0;
+		stbi_uc* px = stbi_load_from_memory(file.data(), static_cast<int>(file.size()), &iw, &ih, &ic, 4);
+		if (!px) return false;
+		const bool ok = iw == w && ih == h;
+		if (ok)
+		{
+			std::vector<u8> rgba(px, px + static_cast<usz>(iw) * ih * 4);
+			u32 lw = w, lh = h;
+			for (u32 l = 0; l < mips; ++l)
+			{
+				std::vector<u8> g(static_cast<usz>(lw) * lh * 4);
+				for (usz i = 0; i < static_cast<usz>(lw) * lh; ++i)
+				{
+					g[i * 4 + 0] = rgba[i * 4 + 3];
+					g[i * 4 + 1] = rgba[i * 4 + 0];
+					g[i * 4 + 2] = rgba[i * 4 + 1];
+					g[i * 4 + 3] = rgba[i * 4 + 2];
+				}
+				e.levels.push_back(std::move(g));
+				if (lw == 1 && lh == 1) break;
+				const u32 nw = std::max<u32>(1, lw / 2), nh = std::max<u32>(1, lh / 2);
+				std::vector<u8> next(static_cast<usz>(nw) * nh * 4);
+				for (u32 y = 0; y < nh; ++y)
+					for (u32 x = 0; x < nw; ++x)
+						for (u32 ch = 0; ch < 4; ++ch)
+						{
+							u32 s = 0;
+							for (u32 dy = 0; dy < 2; ++dy)
+								for (u32 dx = 0; dx < 2; ++dx)
+									s += rgba[((std::min(y * 2 + dy, lh - 1)) * lw + std::min(x * 2 + dx, lw - 1)) * 4 + ch];
+							next[(static_cast<usz>(y) * nw + x) * 4 + ch] = static_cast<u8>((s + 2) / 4);
+						}
+				rgba.swap(next);
+				lw = nw;
+				lh = nh;
+			}
+		}
+		stbi_image_free(px);
+		return ok && !e.levels.empty();
+	}
+}
+
+void r2gx::texpack_init()
+{
+	static bool done = false;
+	if (done) return;
+	done = true;
+	if (const char* e = std::getenv("RSX_TEXDUMP"); e && *e && std::strcmp(e, "0"))
+	{
+		g_tp.dump = true;
+		g_tp.dump_dir = (std::strcmp(e, "1") && _stricmp(e, "on")) ? std::filesystem::path(e) : std::filesystem::path("texdump");
+		std::error_code ec;
+		std::filesystem::create_directories(g_tp.dump_dir, ec);
+		// manifest.tsv: one line per dumped texture; textures listed by an earlier run are not dumped again
+		const auto mp = g_tp.dump_dir / "manifest.tsv";
+		const bool had = std::filesystem::exists(mp, ec);
+		if (had)
+		{
+			std::ifstream in(mp);
+			std::string line;
+			while (std::getline(in, line))
+			{
+				char* end = nullptr;
+				if (line.size() > 16 && line[16] == '\t')
+				{
+					const u64 hsh = std::strtoull(line.substr(0, 16).c_str(), &end, 16);
+					if (end && !*end) g_tp.dumped.insert(hsh);
+				}
+			}
+		}
+		g_tp.manifest = std::fopen(mp.string().c_str(), "a");
+		if (g_tp.manifest && !had)
+			std::fprintf(g_tp.manifest, "# key\twidth\theight\tformat\tmips\tswizzled\tfile\n"
+				"# key = 64-bit content hash of all mip levels (texel rows) + width/height/format/mips; stable across runs\n");
+		gxlog("texture dump: on, into %s (%zu already listed in manifest.tsv)", g_tp.dump_dir.string().c_str(), g_tp.dumped.size());
+	}
+	if (const char* e = std::getenv("RSX_TEXPACK"); e && *e && std::strcmp(e, "0"))
+	{
+		g_tp.pack_dir = (std::strcmp(e, "1") && _stricmp(e, "on")) ? std::filesystem::path(e) : std::filesystem::path("mods") / "textures";
+		std::error_code ec;
+		for (auto it = std::filesystem::recursive_directory_iterator(g_tp.pack_dir, ec); !ec && it != std::filesystem::recursive_directory_iterator(); it.increment(ec))
+		{
+			if (!it->is_regular_file(ec)) continue;
+			const auto ext = it->path().extension().string();
+			if (_stricmp(ext.c_str(), ".dds") && _stricmp(ext.c_str(), ".png")) continue;
+			const auto stem = it->path().stem().string();
+			if (stem.size() < 16) continue;
+			char* end = nullptr;
+			const u64 hsh = std::strtoull(stem.substr(0, 16).c_str(), &end, 16);
+			if (!end || *end) continue;
+			g_tp.pack[hsh].path = it->path();
+		}
+		g_tp.load = !g_tp.pack.empty();
+		gxlog("texture pack: %zu replacement(s) in %s%s", g_tp.pack.size(), g_tp.pack_dir.string().c_str(), g_tp.load ? "" : " (none: off)");
+	}
+	texpack_active = g_tp.dump || g_tp.load;
+}
+
+const std::vector<rsx::subresource_layout>* r2gx::texpack_upload(u32 /*address*/, u16 width, u16 height, u16 depth, u16 mipmaps,
+	u32 gcm_format, rsx::texture_dimension_extended type, bool& swizzled,
+	const std::vector<rsx::subresource_layout>& layout, std::vector<rsx::subresource_layout>& tmp)
+{
+	const u32 fmt = gcm_format & ~(0x20u | 0x40u);
+	if (type != rsx::texture_dimension_extended::texture_dimension_2d || depth > 1 || layout.empty()) return &layout;
+	if (fmt != GCM_A8R8G8B8 && !is_dxt(fmt)) return &layout;
+	if (width < 8 || height < 8) return &layout;
+
+	const u32 mips = std::max<u32>(1, mipmaps);
+	const u64 hsh = tp_hash(layout, width, height, fmt, mips);
+	if (g_tp.dump) tp_dump(hsh, width, height, fmt, mips, swizzled, layout);
+	if (!g_tp.load) return &layout;
+
+	const auto it = g_tp.pack.find(hsh);
+	if (it == g_tp.pack.end()) return &layout;
+	auto& e = it->second;
+	if (!e.loaded)
+	{
+		e.loaded = true;
+		e.bad = !tp_load(e, width, height, fmt, std::max<u32>(1, mipmaps));
+		if (e.bad) gxlog("texture pack: %s does not match the texture (%ux%u, format 0x%02x; same size and format required)",
+			e.path.string().c_str(), width, height, fmt);
+	}
+	if (e.bad) return &layout;
+
+	tmp = layout;
+	for (auto& s : tmp)
+	{
+		if (s.level >= e.levels.size()) continue; // keep the game's data for levels the replacement lacks
+		auto& d = e.levels[s.level];
+		s.data = rsx::io_buffer(d.data(), d.size());
+		s.pitch_in_block = s.width_in_block;
+	}
+	// Replacement data is linear: drop the swizzle flag only if every level was replaced
+	bool all = true;
+	for (const auto& s : tmp) all = all && s.level < e.levels.size();
+	if (!all && swizzled) return &layout; // mixed swizzled/linear levels cannot be uploaded in one go
+	swizzled = false;
+	if (g_tp.replaced++ < 8) gxlog("texture pack: replaced %016llx (%ux%u) from %s", static_cast<unsigned long long>(hsh), width, height, e.path.filename().string().c_str());
+	return &tmp;
+}
+
+#include "Emu/RSX/NV47/HW/context_accessors.undef.h"
