 namespace utils
 {
+	// R3PORT: under clang-cl these are inlined into this file's atomic_op loops, and a plain
+	// _mm_load_si128 is an ordinary load to clang: it re-read the low half separately, built the
+	// new value from that read and used the other one as the CAS comparand, so concurrent
+	// updates of the wait hashtable were lost (double-allocated slots, lost wake-ups, hangs).
+	// The asm forces exactly one 16-byte access, as on the non-MSVC x64 path.
 	u128 __vectorcall atomic_load16(const void* ptr)
 	{
+#ifdef __clang__
+		__m128i r;
+		__asm__ volatile("movdqa %1, %0" : "=x" (r) : "m" (*static_cast<const __m128i*>(ptr)) : "memory");
+		return std::bit_cast<u128>(r);
+#else
 		return std::bit_cast<u128>(_mm_load_si128(static_cast<const __m128i*>(ptr)));
+#endif
 	}
 
 	void __vectorcall atomic_store16(void* ptr, u128 value)
 	{
+#ifdef __clang__
+		__asm__ volatile("movdqa %1, %0" : "=m" (*static_cast<__m128i*>(ptr)) : "x" (std::bit_cast<__m128i>(value)) : "memory");
+#else
 		_mm_store_si128(static_cast<__m128i*>(ptr), std::bit_cast<__m128i>(value));
+#endif
 	}
 }
 #endif
