diff --git a/rpcs3/Emu/RSX/VK/port_gpuspan.h b/rpcs3/Emu/RSX/VK/port_gpuspan.h
new file mode 100644
index 0000000..c02f222
--- /dev/null
+++ b/rpcs3/Emu/RSX/VK/port_gpuspan.h
@@ -0,0 +1,127 @@
+#pragma once
+
+// PORT (perf r12): GPU time of one named span per frame -- r2aa_run, i.e. the DLSS / FSR / XeSS evaluate with the AA
+// passes around it -- driven by the GPU timer (port_gputime.h; R3: RSX_GPU_TS=1, R2: RSX_GPU_TIME, default on). The
+// timer arms a slot (vkCmdResetQueryPool, outside any render pass) at a primary command buffer's begin(); open() and
+// close() write BOTTOM_OF_PIPE stamps (all earlier work done), so the span is the GPU time of the work recorded in it.
+// Results are read without waiting once the command buffer holding close() has retired. Every 5 s:
+//   [gpu-ts] upscale 5 s: N runs | r2aa_run X ms avg, max Y ms
+// Same file in R2 and R3.
+
+#include "vkutils/device.h"
+#include "VKResourceManager.h"
+#include "../../../../../../include/ps3emu/port_hitch.h"
+#include <chrono>
+#include <deque>
+
+namespace vk
+{
+	class port_gpu_span
+	{
+		static constexpr u32 slots = 16;
+		VkDevice m_dev = VK_NULL_HANDLE;
+		VkQueryPool m_pool = VK_NULL_HANDLE;
+		double m_ns_per_tick = 1.0;
+		u64 m_mask = ~0ull;
+		u32 m_next = 0;
+		int m_armed = -1, m_open = -1;
+		bool m_busy[slots] = {};
+		struct entry { u32 slot; u64 eid; };
+		std::deque<entry> m_pending; // eid 0 = its command buffer is not submitted yet
+
+		std::chrono::steady_clock::time_point m_win_t0{};
+		double m_sum_ns = 0.0, m_max_ns = 0.0;
+		u64 m_runs = 0;
+
+	public:
+		void init(VkDevice dev, double ns_per_tick, u64 mask)
+		{
+			if (m_pool) return;
+			VkQueryPoolCreateInfo ci{ VK_STRUCTURE_TYPE_QUERY_POOL_CREATE_INFO };
+			ci.queryType = VK_QUERY_TYPE_TIMESTAMP;
+			ci.queryCount = slots * 2;
+			if (vkCreateQueryPool(dev, &ci, nullptr, &m_pool) != VK_SUCCESS) { m_pool = VK_NULL_HANDLE; return; }
+			m_dev = dev;
+			m_ns_per_tick = ns_per_tick;
+			m_mask = mask;
+		}
+
+		void destroy()
+		{
+			if (m_pool) vkDestroyQueryPool(m_dev, m_pool, nullptr);
+			m_pool = VK_NULL_HANDLE;
+			m_pending.clear();
+			m_armed = m_open = -1;
+			for (bool& b : m_busy) b = false;
+		}
+
+		// The timer's begin(): no render pass open
+		void arm(VkCommandBuffer cb)
+		{
+			if (!m_pool || m_armed >= 0 || m_open >= 0 || m_busy[m_next]) return;
+			m_armed = static_cast<int>(m_next);
+			m_next = (m_next + 1) % slots;
+			vkCmdResetQueryPool(cb, m_pool, m_armed * 2, 2);
+		}
+
+		void open(VkCommandBuffer cb)
+		{
+			if (m_armed < 0 || m_open >= 0) return;
+			m_open = m_armed;
+			m_armed = -1;
+			vkCmdWriteTimestamp(cb, VK_PIPELINE_STAGE_BOTTOM_OF_PIPE_BIT, m_pool, m_open * 2);
+		}
+
+		void close(VkCommandBuffer cb)
+		{
+			if (m_open < 0) return;
+			vkCmdWriteTimestamp(cb, VK_PIPELINE_STAGE_BOTTOM_OF_PIPE_BIT, m_pool, m_open * 2 + 1);
+			m_busy[m_open] = true;
+			m_pending.push_back({ static_cast<u32>(m_open), 0 });
+			m_open = -1;
+		}
+
+		// The timer's submitted(): closed spans now belong to this submit
+		void submitted(u64 eid)
+		{
+			for (auto it = m_pending.rbegin(); it != m_pending.rend() && !it->eid; ++it) it->eid = eid;
+		}
+
+		void poll(u64 done)
+		{
+			while (!m_pending.empty() && m_pending.front().eid && m_pending.front().eid <= done)
+			{
+				const entry e = m_pending.front();
+				u64 ts[2] = {};
+				const VkResult r = vkGetQueryPoolResults(m_dev, m_pool, e.slot * 2, 2, sizeof(ts), ts, sizeof(u64), VK_QUERY_RESULT_64_BIT);
+				if (r == VK_NOT_READY) break;
+				m_pending.pop_front();
+				m_busy[e.slot] = false;
+				if (r != VK_SUCCESS) continue;
+				const double ns = static_cast<double>(((ts[1] & m_mask) - (ts[0] & m_mask)) & m_mask) * m_ns_per_tick;
+				if (!(ns >= 0.0 && ns < 1e9)) continue;
+				m_runs++;
+				m_sum_ns += ns;
+				if (ns > m_max_ns) m_max_ns = ns;
+			}
+			const auto now = std::chrono::steady_clock::now();
+			if (m_win_t0 == std::chrono::steady_clock::time_point{}) { m_win_t0 = now; return; }
+			if (now - m_win_t0 < std::chrono::seconds(5) || !m_runs) return;
+			port_log_async(1, "[gpu-ts] upscale 5 s: %llu runs | r2aa_run (DLSS/FSR evaluate + AA passes) %.2f ms avg, max %.2f ms\n",
+				static_cast<unsigned long long>(m_runs), m_sum_ns / static_cast<double>(m_runs) * 1e-6, m_max_ns * 1e-6);
+			m_win_t0 = now;
+			m_sum_ns = m_max_ns = 0.0;
+			m_runs = 0;
+		}
+
+		// RAII around a span; CB is a pointer to the renderer's current command buffer pointer (it may change inside)
+		template <typename CB>
+		struct scope
+		{
+			port_gpu_span& s;
+			CB* const* cb;
+			scope(port_gpu_span& span, CB* const* current) : s(span), cb(current) { if (*cb) s.open(**cb); }
+			~scope() { if (*cb) s.close(**cb); }
+		};
+	};
+}
diff --git a/rpcs3/Emu/RSX/VK/port_gputime.h b/rpcs3/Emu/RSX/VK/port_gputime.h
new file mode 100644
index 0000000..a7eee71
--- /dev/null
+++ b/rpcs3/Emu/RSX/VK/port_gputime.h
@@ -0,0 +1,175 @@
+#pragma once
+
+// R3PORT (perf r7): RSX_GPU_TS=1 (default off; RSX_GPU_TIME=1 is accepted too). Opt-in GPU timestamp profiler, the R3
+// counterpart of R2's port_gputime.h (R2 feeds its [hitch] PH_GPU category; R3's port_hitch.h has none, so this prints
+// its own line). Every primary command buffer gets a TOP_OF_PIPE stamp after begin() and a BOTTOM_OF_PIPE stamp before
+// end(); the results are read without waiting once the buffer's fence has retired (vk::last_completed_event_id), so the
+// profiler never stalls the renderer. Every 5 s:
+//   [gpu-ts] 5 s: N frames, frame span F ms | gpu busy X ms/f (union of command-buffer spans, % of F), gpu idle G ms/f
+//            (gaps between buffers, max), cb-sum Y ms/f, timed cbs Z/f, longest cb W ms, untimed U
+// gpu busy close to the frame time = GPU bound; far below it = the GPU idles waiting for the CPU side.
+// Also "[gpu-ts] upscale 5 s:" -- the GPU time of r2aa_run (DLSS / FSR evaluate + AA passes), port_gpuspan.h.
+
+#include "vkutils/device.h"
+#include "VKResourceManager.h"
+#include "../../../../../../include/ps3emu/port_hitch.h"
+#include "port_gpuspan.h"
+#include <chrono>
+#include <cstdlib>
+#include <deque>
+
+namespace vk
+{
+	class r3_gpu_timer
+	{
+		static constexpr u32 pairs = 256;
+		VkDevice m_dev = VK_NULL_HANDLE;
+		VkQueryPool m_pool = VK_NULL_HANDLE;
+		double m_ns_per_tick = 1.0;
+		u64 m_mask = ~0ull;
+		u32 m_next = 0;
+		int m_cur = -1; // pair of the command buffer being recorded, -1 = not timed
+		bool m_busy[pairs] = {};
+		struct entry { u32 pair; u64 eid; };
+		std::deque<entry> m_pending;
+		u64 m_last_end = 0;
+		bool m_have_last = false;
+
+		// 5 s window
+		std::chrono::steady_clock::time_point m_win_t0{};
+		double m_union_ns = 0.0, m_sum_ns = 0.0, m_max_ns = 0.0, m_gap_ns = 0.0, m_gap_max_ns = 0.0;
+		u64 m_cbs = 0, m_untimed = 0, m_frames = 0;
+
+		bool after(u64 a, u64 b) const { return ((a - b) & m_mask) <= (m_mask >> 1); }
+
+		void report()
+		{
+			const auto now = std::chrono::steady_clock::now();
+			if (m_win_t0 == std::chrono::steady_clock::time_point{}) { m_win_t0 = now; return; }
+			if (now - m_win_t0 < std::chrono::seconds(5)) return;
+			const double f = m_frames ? static_cast<double>(m_frames) : 1.0;
+			const double wall = std::chrono::duration<double, std::milli>(now - m_win_t0).count() / f;
+			port_log_async(1, "[gpu-ts] 5 s: %llu frames, frame span %.2f ms | gpu busy %.2f ms/f (union, %.0f%%), gpu idle %.2f ms/f (gaps between cbs, max %.2f ms), cb-sum %.2f ms/f, timed cbs %.1f/f, longest cb %.2f ms, untimed %llu\n",
+				static_cast<unsigned long long>(m_frames), wall, m_union_ns / f * 1e-6, wall > 0 ? 100.0 * m_union_ns / f * 1e-6 / wall : 0.0,
+				m_gap_ns / f * 1e-6, m_gap_max_ns * 1e-6, m_sum_ns / f * 1e-6, static_cast<double>(m_cbs) / f,
+				m_max_ns * 1e-6, static_cast<unsigned long long>(m_untimed));
+			m_win_t0 = now;
+			m_union_ns = m_sum_ns = m_max_ns = m_gap_ns = m_gap_max_ns = 0.0;
+			m_cbs = m_untimed = m_frames = 0;
+		}
+
+	public:
+		port_gpu_span span; // r2aa_run (DLSS / FSR evaluate) GPU time, port_gpuspan.h
+
+		static bool enabled()
+		{
+			static const bool on = []
+			{
+				const char* e = std::getenv("RSX_GPU_TS");
+				if (!e || !*e) e = std::getenv("RSX_GPU_TIME");
+				return e && *e && *e != '0';
+			}();
+			return on;
+		}
+
+		void init(const vk::render_device& dev)
+		{
+			if (!enabled() || m_pool) return;
+			auto& gpu = const_cast<vk::physical_device&>(dev.gpu());
+			const u32 bits = gpu.get_queue_properties(dev.get_graphics_queue_family()).timestampValidBits;
+			const float period = gpu.get_limits().timestampPeriod;
+			if (!bits || period <= 0.f) return;
+			m_mask = bits >= 64 ? ~0ull : ((1ull << bits) - 1);
+			m_ns_per_tick = period;
+			VkQueryPoolCreateInfo ci{ VK_STRUCTURE_TYPE_QUERY_POOL_CREATE_INFO };
+			ci.queryType = VK_QUERY_TYPE_TIMESTAMP;
+			ci.queryCount = pairs * 2;
+			if (vkCreateQueryPool(dev, &ci, nullptr, &m_pool) != VK_SUCCESS) { m_pool = VK_NULL_HANDLE; return; }
+			m_dev = dev;
+			span.init(dev, period, m_mask);
+			port_log_async(1, "[gpu-ts] RSX_GPU_TS on: %u-bit timestamps, %.2f ns/tick\n", bits, period);
+		}
+
+		void destroy()
+		{
+			span.destroy();
+			if (m_pool) vkDestroyQueryPool(m_dev, m_pool, nullptr);
+			m_pool = VK_NULL_HANDLE;
+			m_pending.clear();
+			m_have_last = false;
+		}
+
+		// Right after the primary command buffer's begin() (no render pass open)
+		void begin(VkCommandBuffer cb)
+		{
+			m_cur = -1;
+			if (!m_pool) return;
+			span.arm(cb);
+			if (m_busy[m_next]) { m_untimed++; return; } // ring full: this buffer goes untimed
+			m_cur = static_cast<int>(m_next);
+			m_next = (m_next + 1) % pairs;
+			vkCmdResetQueryPool(cb, m_pool, m_cur * 2, 2);
+			vkCmdWriteTimestamp(cb, VK_PIPELINE_STAGE_TOP_OF_PIPE_BIT, m_pool, m_cur * 2);
+		}
+
+		// Before the primary command buffer's end(), outside any render pass
+		void end(VkCommandBuffer cb)
+		{
+			if (m_cur < 0) return;
+			vkCmdWriteTimestamp(cb, VK_PIPELINE_STAGE_BOTTOM_OF_PIPE_BIT, m_pool, m_cur * 2 + 1);
+		}
+
+		// After tag(): the buffer's completion event
+		void submitted(u64 eid)
+		{
+			span.submitted(eid);
+			if (m_cur < 0) return;
+			m_busy[m_cur] = true;
+			m_pending.push_back({ static_cast<u32>(m_cur), eid });
+			m_cur = -1;
+		}
+
+		// Once per presented frame (queue_swap_request)
+		void frame()
+		{
+			if (m_pool) m_frames++;
+		}
+
+		void poll()
+		{
+			if (!m_pool) return;
+			const u64 done = vk::last_completed_event_id();
+			span.poll(done);
+			while (!m_pending.empty() && m_pending.front().eid <= done)
+			{
+				const entry e = m_pending.front();
+				u64 ts[2] = {};
+				const VkResult r = vkGetQueryPoolResults(m_dev, m_pool, e.pair * 2, 2, sizeof(ts), ts, sizeof(u64), VK_QUERY_RESULT_64_BIT);
+				if (r == VK_NOT_READY) break;
+				m_pending.pop_front();
+				m_busy[e.pair] = false;
+				if (r != VK_SUCCESS) continue;
+				const u64 t0 = ts[0] & m_mask, t1 = ts[1] & m_mask;
+				const double ns = static_cast<double>((t1 - t0) & m_mask) * m_ns_per_tick;
+				if (!(ns > 0.0 && ns < 1e9)) continue;
+				m_cbs++;
+				m_sum_ns += ns;
+				if (ns > m_max_ns) m_max_ns = ns;
+				// Busy time = union of the spans: a buffer's TOP_OF_PIPE stamp can land while the previous one is still
+				// draining; buffers complete in submission order on the one queue.
+				u64 start = t0;
+				if (m_have_last && after(m_last_end, t0)) start = m_last_end;
+				else if (m_have_last)
+				{
+					// idle gap: the queue had nothing to run (waiting on the CPU side: submit, record, present)
+					const double gap = static_cast<double>((t0 - m_last_end) & m_mask) * m_ns_per_tick;
+					if (gap < 1e8) { m_gap_ns += gap; if (gap > m_gap_max_ns) m_gap_max_ns = gap; }
+				}
+				if (after(t1, start)) m_union_ns += static_cast<double>((t1 - start) & m_mask) * m_ns_per_tick;
+				if (!m_have_last || after(t1, m_last_end)) m_last_end = t1;
+				m_have_last = true;
+			}
+			report();
+		}
+	};
+}
