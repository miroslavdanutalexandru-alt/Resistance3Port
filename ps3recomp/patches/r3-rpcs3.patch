+	// R2PORT: persistent driver pipeline cache (R2_VK_PIPE_CACHE, default on). Upstream creates an empty
+	// VkPipelineCache every run; seeding it from disk only lets the driver skip back-end compilation of pipelines it
+	// already built (same SPIR-V, same create info), so the resulting pipelines are identical.
+	bool r2_pcache_on()
+	{
+		static const bool on = r2memo::env_switch("R2_VK_PIPE_CACHE", true);
+		return on;
+	}
+
+	std::string r2_pcache_path()
+	{
+		std::string dir = rpcs3::cache::get_ppu_cache();
+		if (dir.empty()) return {};
+		return dir + "shaders_cache/vk_pipeline_cache.bin";
+	}
+
+	bool r2_pcache_device_ok(const std::vector<uint8_t>& blob)
+	{
+		VkPhysicalDeviceProperties props{};
+		vkGetPhysicalDeviceProperties(vk::get_current_renderer()->gpu(), &props);
+		return r2memo::pipe_cache_header_ok(blob.data(), blob.size(), props.vendorID, props.deviceID, props.pipelineCacheUUID);
+	}
+
+	// R2PORT (shader precompile): which GPU and driver built vk_pipeline_cache.bin, saved next to it as
+	// r2_gpu_stamp.txt. A different GPU or driver version (the blob header alone does not always change on a driver
+	// update) drops the driver cache, so the boot preload rebuilds every pipeline for the new driver.
+	std::string r2_gpu_stamp_path()
+	{
+		const std::string p = r2_pcache_path();
+		return p.empty() ? p : p.substr(0, p.size() - std::strlen("vk_pipeline_cache.bin")) + "r2_gpu_stamp.txt";
+	}
+
+	std::string r2_gpu_stamp()
+	{
+		VkPhysicalDeviceProperties props{};
+		vkGetPhysicalDeviceProperties(vk::get_current_renderer()->gpu(), &props);
+		char uuid[VK_UUID_SIZE * 2 + 1]{};
+		for (u32 i = 0; i < VK_UUID_SIZE; ++i) std::snprintf(uuid + i * 2, 3, "%02x", props.pipelineCacheUUID[i]);
+		char text[512];
+		std::snprintf(text, sizeof(text), "vendor=%04x device=%04x driver=%08x cacheuuid=%s gpu=%s",
+			props.vendorID, props.deviceID, props.driverVersion, uuid, props.deviceName);
+		return text;
+	}
+
+	std::string r2_gpu_stamp_read()
+	{
+		std::string s;
+		if (FILE* f = std::fopen(r2_gpu_stamp_path().c_str(), "rb"))
+		{
+			char buf[512]{};
+			const size_t n = std::fread(buf, 1, sizeof(buf) - 1, f);
+			std::fclose(f);
+			s.assign(buf, n);
+			while (!s.empty() && (s.back() == '\n' || s.back() == '\r')) s.pop_back();
+		}
+		return s;
+	}
+
+	void r2_gpu_stamp_write()
+	{
+		const std::string cur = r2_gpu_stamp();
+		if (r2_gpu_stamp_read() == cur) return;
+		if (FILE* f = std::fopen(r2_gpu_stamp_path().c_str(), "wb"))
+		{
+			std::fprintf(f, "%s\n", cur.c_str());
+			std::fclose(f);
+		}
+	}
+
+	std::vector<uint8_t> r2_pcache_load()
+	{
+		std::vector<uint8_t> blob;
+		const std::string path = r2_pcache_path();
+		if (path.empty()) return blob;
+		if (const std::string old = r2_gpu_stamp_read(), cur = r2_gpu_stamp(); !old.empty() && old != cur)
+		{
+			std::printf("[r2rsx] vk pipeline cache: GPU or driver changed since the cache was built (was: %s, now: %s): deleting %s, every pipeline is rebuilt for the new driver\n",
+				old.c_str(), cur.c_str(), path.c_str());
+			std::fflush(stdout);
+			fs::remove_file(path);
+			fs::remove_file(r2_gpu_stamp_path());
+			return blob;
+		}
+		if (FILE* f = std::fopen(path.c_str(), "rb"))
+		{
+			std::fseek(f, 0, SEEK_END);
+			const long n = std::ftell(f);
+			std::fseek(f, 0, SEEK_SET);
+			if (n > 0 && n < (512l << 20))
+			{
+				blob.resize(static_cast<size_t>(n));
+				if (std::fread(blob.data(), 1, blob.size(), f) != blob.size()) blob.clear();
+			}
+			std::fclose(f);
+		}
+		if (!blob.empty() && !r2_pcache_device_ok(blob))
+		{
+			std::printf("[r2rsx] vk pipeline cache: %s is for another GPU/driver, starting empty\n", path.c_str());
+			blob.clear();
+		}
+		return blob;
+	}
