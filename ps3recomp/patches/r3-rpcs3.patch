+		pc[29] = static_cast<float>(nid);
+	}
+	st.om_tot_replays += st.om_replays;
+	vk::viewable_image* id_view_img = st.id_img.get();
+	if (!id_view_img)
+	{
+		if (!st.id_dummy) st.id_dummy = make_image(om_id_format, 1, 1, VK_IMAGE_USAGE_SAMPLED_BIT | VK_IMAGE_USAGE_TRANSFER_DST_BIT);
