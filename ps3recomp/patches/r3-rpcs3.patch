+# R2PORT perf: CMake's RelWithDebInfo passes /Ob1, which clang-cl turns into
+# -finline-hint-functions: only functions spelt `inline` are inlined. STL
+# one-liners such as std::_Atomic_address_as (every std::atomic op), vm::cast,
+# FIFO_control::sync_get and vector allocation helpers stayed out-of-line calls
+# on rsx::thread. /Ob2 (the Release default, which upstream RPCS3 ships) restores
+# normal inlining for this project and its subprojects (asmjit, glslang,
+# yaml-cpp, fossilize). It changes no float semantics: no /arch and no
+# -ffp-contract change. -DRPCS3_RSX_FULL_INLINE=OFF builds the old way.
+option(RPCS3_RSX_FULL_INLINE "Normal inlining (/Ob2) in RelWithDebInfo" ON)
+if(RPCS3_RSX_FULL_INLINE)
+    foreach(_v CMAKE_C_FLAGS_RELWITHDEBINFO CMAKE_CXX_FLAGS_RELWITHDEBINFO)
+        string(REPLACE "/Ob1" "/Ob2" ${_v} "${${_v}}")
+    endforeach()
 endif()
 
