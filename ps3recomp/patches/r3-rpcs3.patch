+	bool sl_device() { return g_sl.inited && g_sl.device != VK_NULL_HANDLE; }
+
+	// Streamline's vkCreateDevice initialises its plugins (sl.common, DLSS-G, Reflex; possibly driver-downloaded
+	// override builds) inside the call. A fault there must not take the game down: the caller turns frame
+	// generation off and creates the device natively.
+	VkResult sl_create_device_guarded(PFN_vkCreateDevice create, VkPhysicalDevice pdev, const VkDeviceCreateInfo* info, VkDevice* device, DWORD* code)
+	{
+		__try
+		{
+			return create(pdev, info, nullptr, device);
+		}
+		__except (*code = GetExceptionCode(), EXCEPTION_EXECUTE_HANDLER)
+		{
+			return VK_ERROR_INITIALIZATION_FAILED;
+		}
+	}
