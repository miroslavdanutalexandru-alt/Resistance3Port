+	// The current run of scene-pair draws looks like the material pass (no depth writes; RSX_AA_MAT_RATIO: and not a
+	// short decal / effect run after many depth-writing pre-pass draws). log: one-shot diagnostic on a rejection.
+	bool mat_run(bool log)
+	{
+		auto& st = g_r2;
+		if (!(st.run_scene && st.run_draws >= 8 && !st.run_dw)) return false;
+		const u32 r = r2cfg().mat_ratio;
+		if (!r || static_cast<u64>(st.win_ndw) * r >= st.win_dw) return true;
+		if (log && st.diag_mat < 8)
+		{
+			st.diag_mat++;
+			r2log("material-pass candidate rejected f%u: %u scene draws (%08x/%08x, last run %u) without depth writes ending before draw %u, "
+				"fewer than 1/%u of the %u depth-writing scene draws before them (decals / effects in the pre-pass; RSX_AA_MAT_RATIO=0: old rule)",
+				st.frame, st.win_ndw, st.scene_rt, st.scene_ds, st.run_draws, st.draw_index, r, st.win_dw);
+		}
+		return false;
+	}
+
+	// All scene passes of the logical frame are done: the upscaler may run at the next non-scene target
+	bool scene_passes_done()
+	{
+		const auto& st = g_r2;
+		if (!r2cfg().split) return st.seg_count >= st.seg_target;
+		return st.mat_done || mat_run(false);
+	}
