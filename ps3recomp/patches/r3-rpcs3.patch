+	const vec4 s10 = texelFetch2DMS(tex, clamp_bounds, sample_count, lo, ivec2(ib.x >= 0 ? 1 : 0, 0));
+	const vec4 s01 = texelFetch2DMS(tex, clamp_bounds, sample_count, lo, ivec2(0, ib.y >= 0 ? 1 : 0));
+	const vec4 s11 = texelFetch2DMS(tex, clamp_bounds, sample_count, lo, ivec2(ib.x >= 0 ? 1 : 0, ib.y >= 0 ? 1 : 0));
+	return mix(mix(s00, s10, f.x), mix(s01, s11, f.x), f.y);
+}
