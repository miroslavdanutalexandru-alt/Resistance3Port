+				"	float m = 0.0;\n"
+				"	if (abs(q.w) > 1e-7)\n"
+				"	{\n"
+				"		mv = (q.xy / q.w - ndc) * 0.5;\n"
+				"		if (any(isnan(mv)) || any(isinf(mv)) || any(greaterThan(abs(mv), vec2(2.0)))) mv = vec2(0.0);\n"
+				// Moving objects: where this pixel was last frame (camera motion only), the previous depth
