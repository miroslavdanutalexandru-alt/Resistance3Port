diff --git a/rpcs3/Emu/RSX/port_adsrb.h b/rpcs3/Emu/RSX/port_adsrb.h
new file mode 100644
index 0000000..14eda1e
--- /dev/null
+++ b/rpcs3/Emu/RSX/port_adsrb.h
@@ -0,0 +1,671 @@
+#pragma once
+
+// R3PORT: asynchronous readback of render targets the CPU/SPU reads back every frame (pure logic, unit tested in
+// scratch\enginetest\test_adsrb). R3's ADS depth of field (SPU job 419) reads the FP16 light buffer at 0x30030000
+// that the RSX just rendered; upstream copies it to host memory only when the SPU faults on it (GPU copy + wait).
+//
+// RSX_ADS_ASYNC_RB (default 1): a surface flushed in consecutive frames becomes "hot". When the RSX unbinds it, or waits on a
+//   label, its GPU->host copy (resolution downscale + tiling on the GPU, as on the fault path) is recorded and submitted
+//   right away; the fault then only waits for that copy if it has not finished yet. Any write to the surface after the copy
+//   drops it (section create()/reprotect(), ROP timestamp check in flush_set), so the SPU still sees this frame's data.
+//   0 = upstream behaviour (no tracking, no early copies).
+// RSX_ADS_STALE_OK (default 0 = wait; 1 = opt-in): if the copy is still in flight at the fault, give the SPU the data from
+//   the previous readback of that surface instead of waiting (never twice in a row). Default off since 2026-11-14: the
+//   serve rewrites the whole tiled flush span (~5.2 MB from 0x30030000), which also holds job 419's in-place output and
+//   intermediates (0x302B0000..0x304B0000) the SPU wrote after the snapshot, and the snapshot itself is taken while the
+//   SPU writes there. The composite then samples old/undecoded bytes as the DOF layer: whole-frame black + purple
+//   low-res mosaic on ~6% of aimed frames (r3_ads2_1114.md). Waiting costs ~2-3 ms of SPU time per would-be serve.
+// RSX_ADS_KICK_AT_LABEL (default 1, needs RSX_ADS_ASYNC_RB): record the early copy when the RSX releases a GCM label
+//   (semaphore release / back-end write) instead of when the surface is unbound or blitted. The unbind/blit kicks can be
+//   overwritten by later draws and burn the per-frame kick budget; a label release is where the SPU learns the surface is
+//   final. Each hot range learns the label after which its copy was consumed by the fault, and is then only kicked at that
+//   label (forgotten after 3 misses). The acquire-poll kick stays as the fallback.
+// RSX_ADS_FLUSH_DEDUP (default 1, needs RSX_ADS_ASYNC_RB): one SPU fault on the light buffer flushes ~3 sections (0x30030000,
+//   0x30030f00, ...) that sit in the same tiled region, and each tiled flush copies the whole tile-aligned row span (~5.2 MB
+//   at 960x640 FP16, pitch 8192) from the DMA block to guest memory. Once every copy of the flush set has landed, the DMA
+//   block is final and the later copies of the same bytes are repeats: only bytes not already copied are copied. Exact.
+// RSX_ADS_STALE_ASYNC (default 1, only with RSX_ADS_STALE_OK=1): the RSX_ADS_STALE_OK snapshot (another ~5.2 MB copy per hot
+//   flush, on the faulting SPU thread) is taken by a helper thread; the next write to guest memory by a flush or stale
+//   serve, and every serve, wait for it first.
+
+// RSX_ADS_KICK_ADAPT (default 1, needs RSX_ADS_ASYNC_RB): stop the early copies of a hot range that keep being wasted. In R3's
+//   ADS ~100% of kicks are replaced by the recopy at fault time (the surface is drawn again after the kick), and each costs a
+//   ~5.2 MB load_dma plus a GPU detile on the RSX thread. After 3 consecutive flushes whose early copy was not consumed the
+//   range is only kicked on every 32nd flush (a probe that relearns as soon as a copy is consumed again). Exact: early
+//   copies are speculative and the fault path copies the surface itself when there is none.
+
+#include <atomic>
+#include <chrono>
+#include <condition_variable>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <deque>
+#include <mutex>
+#include <thread>
+#include <vector>
+
+extern "C" void spu_coh_notify_range(uint32_t ea, uint32_t size); // R3PORT PORT_NOTIFY_ALL_WRITES (ps3recomp runtime)
+
+namespace adsrb
+{
+	inline bool env_switch(const char* name, bool def)
+	{
+		const char* v = std::getenv(name);
+		if (!v || !v[0]) return def;
+		// 0/off/false/no (any case) = off; anything else non-empty = on
+		char w[8] = {};
+		for (size_t i = 0; i + 1 < sizeof w && v[i]; i++) w[i] = static_cast<char>((v[i] >= 'A' && v[i] <= 'Z') ? v[i] + 32 : v[i]);
+		if (v[0] == '0' || !std::strcmp(w, "off") || !std::strcmp(w, "false") || !std::strcmp(w, "no")) return false;
+		return true;
+	}
+
+	struct config
+	{
+		bool async = true;
+		bool stale_ok = false;
+		bool kick_at_label = true;
+		bool flush_dedup = true;
+		bool stale_async = false;
+		bool kick_adapt = true;
+	};
+
+	inline config read_config()
+	{
+		config c;
+		c.async = env_switch("RSX_ADS_ASYNC_RB", true);
+		c.stale_ok = c.async && env_switch("RSX_ADS_STALE_OK", false);
+		c.kick_at_label = c.async && env_switch("RSX_ADS_KICK_AT_LABEL", true);
+		c.flush_dedup = c.async && env_switch("RSX_ADS_FLUSH_DEDUP", true);
+		c.stale_async = c.stale_ok && env_switch("RSX_ADS_STALE_ASYNC", true);
+		c.kick_adapt = c.async && env_switch("RSX_ADS_KICK_ADAPT", true);
+		return c;
+	}
+
+	inline const config& cfg()
+	{
+		static const config c = []
+		{
+			const config r = read_config();
+			std::printf("[ads-rb] RSX_ADS_ASYNC_RB=%d RSX_ADS_STALE_OK=%d RSX_ADS_KICK_AT_LABEL=%d RSX_ADS_FLUSH_DEDUP=%d RSX_ADS_STALE_ASYNC=%d RSX_ADS_KICK_ADAPT=%d\n",
+				r.async ? 1 : 0, r.stale_ok ? 1 : 0, r.kick_at_label ? 1 : 0, r.flush_dedup ? 1 : 0, r.stale_async ? 1 : 0, r.kick_adapt ? 1 : 0);
+			std::fflush(stdout);
+			return r;
+		}();
+		return c;
+	}
+
+	inline uint64_t now_ns()
+	{
+		return static_cast<uint64_t>(std::chrono::duration_cast<std::chrono::nanoseconds>(
+			std::chrono::steady_clock::now().time_since_epoch()).count());
+	}
+
+	struct range
+	{
+		uint32_t start = 0;
+		uint32_t end = 0; // inclusive
+	};
+
+	// Surfaces flushed to the CPU recently. A range is hot once it was flushed twice with at most hot_window_ns between
+	// flushes; it gets at most max_kicks early copies between two flushes (bounds wasted GPU copies when the guess is wrong).
+	// A range with an early copy in flight (pending) is never evicted, so the copy can always be found and dropped.
+	class hot_tracker
+	{
+	public:
+		static constexpr int max_entries = 4;
+		static constexpr uint64_t hot_window_ns = 250'000'000;
+		static constexpr uint32_t min_streak = 2;
+		static constexpr uint32_t max_kicks = 4;
+		static constexpr uint32_t max_label_misses = 3;
+		static constexpr uint32_t unlearned_only = 0xFFFFFFFFu; // collect(): only ranges that have not learned a label
+		static constexpr uint32_t adapt_idle = 3;               // RSX_ADS_KICK_ADAPT: unconsumed kick cycles before suppressing
+		static constexpr uint32_t adapt_probe = 32;             // RSX_ADS_KICK_ADAPT: suppressed ranges kick on every Nth flush
+
+		enum class select { kick, pending };
+
+	private:
+		struct entry
+		{
+			range r{};
+			uint64_t last_ns = 0;
+			uint32_t streak = 0;
+			uint32_t kicks = 0;
+			bool used = false;
+			bool pending = false;
+			uint32_t learned_label = 0; // RSX_ADS_KICK_AT_LABEL: label after which the early copy was consumed
+			uint32_t kick_label = 0;    // label of the copy in flight (0 = not kicked at a label)
+			uint32_t label_misses = 0;
+			uint32_t idle = 0;          // RSX_ADS_KICK_ADAPT: consecutive flushes that kicked but consumed no early copy
+			uint32_t probe = 0;         // RSX_ADS_KICK_ADAPT: flushes since the range was suppressed
+		};
+
+		entry m_e[max_entries]{};
+		std::atomic<uint64_t> m_last_flush_ns{ 0 };
+		std::atomic<uint32_t> m_pending{ 0 };
+		mutable std::mutex m_mutex;
+		bool m_adapt = false;
+
+		bool live(const entry& e, uint64_t now) const
+		{
+			return e.used && e.streak >= min_streak && now - e.last_ns <= hot_window_ns;
+		}
+
+		bool suppressed(const entry& e) const
+		{
+			return m_adapt && e.idle >= adapt_idle && (e.probe % adapt_probe) != 0;
+		}
+
+		entry* find(range r)
+		{
+			for (auto& e : m_e)
+			{
+				if (e.used && e.r.start == r.start && e.r.end == r.end) return &e;
+			}
+			return nullptr;
+		}
+
+		void recount_pending()
+		{
+			uint32_t n = 0;
+			for (const auto& e : m_e) n += (e.used && e.pending) ? 1 : 0;
+			m_pending.store(n, std::memory_order_relaxed);
+		}
+
+	public:
+		void set_adapt(bool on) { std::lock_guard lock(m_mutex); m_adapt = on; }
+
+		// consumed: the fault found an early copy of this range (it did not have to record its own)
+		void on_flush(range r, uint64_t now, bool consumed = false)
+		{
+			std::lock_guard lock(m_mutex);
+			entry* slot = find(r);
+			if (!slot)
+			{
+				// Reuse a free or the oldest entry without a copy in flight
+				for (auto& e : m_e)
+				{
+					if (e.used && e.pending) continue;
+					if (!e.used) { slot = &e; break; }
+					if (!slot || e.last_ns < slot->last_ns) slot = &e;
+				}
+				if (!slot) return; // every entry has a copy in flight: do not track this range
+				*slot = {};
+				slot->used = true;
+				slot->r = r;
+			}
+			if (slot->kick_label && consumed)
+			{
+				slot->learned_label = slot->kick_label;
+				slot->label_misses = 0;
+			}
+			else if (slot->learned_label && ++slot->label_misses >= max_label_misses)
+			{
+				slot->learned_label = 0; // the learned label no longer precedes the readback: relearn
+				slot->label_misses = 0;
+			}
+			slot->kick_label = 0;
+			if (consumed) { slot->idle = 0; slot->probe = 0; }
+			else if (slot->kicks && slot->idle < adapt_idle) { if (++slot->idle == adapt_idle) slot->probe = 0; }
+			if (slot->idle >= adapt_idle) slot->probe++;
+			slot->streak = (slot->streak && now - slot->last_ns <= hot_window_ns) ? slot->streak + 1 : 1;
+			slot->last_ns = now;
+			slot->kicks = 0;
+			slot->pending = false;
+			recount_pending();
+			m_last_flush_ns.store(now, std::memory_order_relaxed);
+		}
+
+		// Cheap checks before taking any lock
+		bool maybe_hot(uint64_t now) const
+		{
+			const uint64_t last = m_last_flush_ns.load(std::memory_order_relaxed);
+			return last && now - last <= hot_window_ns;
+		}
+
+		bool any_pending() const
+		{
+			return m_pending.load(std::memory_order_relaxed) != 0;
+		}
+
+		// select::kick: hot ranges overlapping [lo, hi] with kick budget left. select::pending: ranges with an early copy in flight.
+		// label != 0 (RSX_ADS_KICK_AT_LABEL): skip ranges that learned a different label.
+		// n_suppressed (RSX_ADS_KICK_ADAPT): counts kickable ranges skipped because their early copies keep being wasted.
+		int collect(uint64_t now, uint32_t lo, uint32_t hi, range* out, select what = select::kick, uint32_t label = 0, uint32_t* n_suppressed = nullptr) const
+		{
+			std::lock_guard lock(m_mutex);
+			int n = 0;
+			for (const auto& e : m_e)
+			{
+				bool ok = (what == select::kick)
+					? (live(e, now) && e.kicks < max_kicks && !(label && e.learned_label && e.learned_label != label))
+					  && !(label == unlearned_only && e.learned_label)
+					: (e.used && e.pending);
+				if (ok && what == select::kick && suppressed(e) && e.r.start <= hi && lo <= e.r.end)
+				{
+					ok = false;
+					if (n_suppressed) ++*n_suppressed;
+				}
+				if (ok && e.r.start <= hi && lo <= e.r.end)
+				{
+					out[n++] = e.r;
+				}
+			}
+			return n;
+		}
+
+		void on_kick(range r, uint32_t label = 0)
+		{
+			std::lock_guard lock(m_mutex);
+			if (entry* e = find(r))
+			{
+				e->kicks++;
+				e->pending = true;
+				e->kick_label = (label == unlearned_only) ? 0 : label;
+				recount_pending();
+			}
+		}
+
+		// A label was released while the early copy of r was still current: if the fault consumes that copy, this label is
+		// where to kick it (the copy made at unbind/blit time is what lets an unlearned range learn its label)
+		void on_label_seen(range r, uint32_t label)
+		{
+			std::lock_guard lock(m_mutex);
+			if (entry* e = find(r))
+			{
+				if (e->pending && label && label != unlearned_only) e->kick_label = label;
+			}
+		}
+
+		uint32_t learned_label(range r) const
+		{
+			std::lock_guard lock(m_mutex);
+			for (const auto& e : m_e)
+			{
+				if (e.used && e.r.start == r.start && e.r.end == r.end) return e.learned_label;
+			}
+			return 0;
+		}
+
+		bool is_hot(range r, uint64_t now) const
+		{
+			std::lock_guard lock(m_mutex);
+			for (const auto& e : m_e)
+			{
+				if (live(e, now) && e.r.start == r.start && e.r.end == r.end) return true;
+			}
+			return false;
+		}
+	};
+	// RSX_ADS_STALE_OK: last real bytes written for a range. Served at most once in a row, only for the same length.
+	class stale_store
+	{
+		struct snap
+		{
+			uint32_t start = 0;
+			uint32_t len = 0;
+			std::vector<uint8_t> data;
+			bool last_was_stale = false;
+			uint64_t used_ns = 0;
+		};
+
+		snap m_s[hot_tracker::max_entries]{};
+		std::mutex m_mutex;
+
+		// RSX_ADS_STALE_ASYNC: snapshot copies queued for the helper thread (m_mutex)
+		struct job
+		{
+			uint8_t* dst;
+			const uint8_t* src;
+			uint32_t len;
+		};
+		std::deque<job> m_jobs;
+		bool m_busy = false;
+		bool m_worker = false;
+		std::condition_variable m_cv_work, m_cv_idle;
+
+		snap* slot_for(uint32_t start)
+		{
+			for (auto& s : m_s)
+			{
+				if (s.len && s.start == start) return &s;
+			}
+			snap* slot = &m_s[0];
+			for (auto& s : m_s)
+			{
+				if (!s.len) return &s;
+				if (s.used_ns < slot->used_ns) slot = &s;
+			}
+			return slot;
+		}
+
+		void wait_idle_locked(std::unique_lock<std::mutex>& lock)
+		{
+			m_cv_idle.wait(lock, [this] { return m_jobs.empty() && !m_busy; });
+		}
+
+		void worker_loop()
+		{
+			std::unique_lock lock(m_mutex);
+			for (;;)
+			{
+				m_cv_work.wait(lock, [this] { return !m_jobs.empty(); });
+				const job j = m_jobs.front();
+				m_jobs.pop_front();
+				m_busy = true;
+				lock.unlock();
+				std::memcpy(j.dst, j.src, j.len);
+				lock.lock();
+				m_busy = false;
+				if (m_jobs.empty()) m_cv_idle.notify_all();
+			}
+		}
+
+	public:
+		// A snapshot older than this is from an earlier aim (maybe another level at the same address): never served.
+		// Real readbacks of a hot surface refresh it every frame or two, so this only drops leftovers.
+		static constexpr uint64_t max_age_ns = 100'000'000;
+
+		// RSX_ADS_STALE_ASYNC: returns once every queued snapshot copy is done. Call before writing guest memory that a
+		// queued copy may still be reading.
+		void wait_idle()
+		{
+			std::unique_lock lock(m_mutex);
+			wait_idle_locked(lock);
+		}
+
+		bool idle()
+		{
+			std::lock_guard lock(m_mutex);
+			return m_jobs.empty() && !m_busy;
+		}
+
+		// RSX_ADS_STALE_ASYNC: refresh() with the copy done by a helper thread. src must stay valid and unchanged until
+		// wait_idle() (the caller waits before its next write there).
+		void refresh_async(uint32_t start, uint32_t len, const uint8_t* src, uint64_t now)
+		{
+			std::unique_lock lock(m_mutex);
+			snap* slot = slot_for(start);
+			bool queued = m_busy; // the running copy may be this slot's
+			for (const auto& j : m_jobs)
+			{
+				queued = queued || j.dst == slot->data.data();
+			}
+			if (queued)
+			{
+				wait_idle_locked(lock); // never resize or rewrite a buffer a queued copy writes to
+			}
+			slot->start = start;
+			slot->len = len;
+			slot->data.resize(len);
+			slot->last_was_stale = false;
+			slot->used_ns = now;
+			m_jobs.push_back({ slot->data.data(), src, len });
+			if (!m_worker)
+			{
+				m_worker = true;
+				std::thread([this] { worker_loop(); }).detach();
+			}
+			m_cv_work.notify_one();
+		}
+
+		bool try_serve(uint32_t start, uint32_t len, uint8_t* dst, uint64_t now)
+		{
+			std::unique_lock lock(m_mutex);
+			wait_idle_locked(lock); // RSX_ADS_STALE_ASYNC: the snapshot is complete (no-op otherwise)
+			for (auto& s : m_s)
+			{
+				if (s.len && s.start == start && s.len == len)
+				{
+					if (now < s.used_ns || now - s.used_ns > max_age_ns)
+					{
+						s = {}; // expired: drop it, the next real readback stores a fresh one
+						return false;
+					}
+					if (s.last_was_stale) return false;
+					std::memcpy(dst, s.data.data(), len);
+					spu_coh_notify_range(start, len); // R3PORT PORT_NOTIFY_ALL_WRITES
+					s.last_was_stale = true;
+					return true;
+				}
+			}
+			return false;
+		}
+
+		void refresh(uint32_t start, uint32_t len, const uint8_t* src, uint64_t now)
+		{
+			std::unique_lock lock(m_mutex);
+			wait_idle_locked(lock);
+			snap* slot = slot_for(start);
+			slot->start = start;
+			slot->len = len;
+			slot->data.assign(src, src + len);
+			slot->last_was_stale = false;
+			slot->used_ns = now;
+		}
+	};
+
+	// RSX_ADS_FLUSH_DEDUP: guest bytes [lo, hi) already hold the final DMA block contents of the current fault flush set
+	// (fault thread only, one instance per flush_all). trim() returns the part of [start, end) still to copy.
+	class flush_dedup
+	{
+		uint32_t m_lo = 0, m_hi = 0;
+
+	public:
+		bool empty() const { return m_hi <= m_lo; }
+
+		void trim(uint32_t start, uint32_t end, uint32_t& copy_start, uint32_t& copy_end) const
+		{
+			copy_start = start;
+			copy_end = end;
+			if (empty() || end <= start) return;
+			if (start >= m_lo && end <= m_hi)
+			{
+				copy_start = copy_end = start; // all of it is already there
+			}
+			else if (start >= m_lo && start < m_hi)
+			{
+				copy_start = m_hi;             // head already there
+			}
+			else if (end > m_lo && end <= m_hi)
+			{
+				copy_end = m_lo;               // tail already there
+			}
+		}
+
+		// [start, end) now equals the DMA block. final: no copy of the flush set was still in flight when it was read, so the
+		// block will not change any more and later sections may skip these bytes.
+		void record(uint32_t start, uint32_t end, bool final)
+		{
+			if (!final || end <= start) return;
+			if (empty() || end < m_lo || start > m_hi)
+			{
+				if (empty() || end - start > m_hi - m_lo) { m_lo = start; m_hi = end; } // keep the larger of two disjoint spans
+				return;
+			}
+			if (start < m_lo) m_lo = start;
+			if (end > m_hi) m_hi = end;
+		}
+
+		// Guest memory in the set's range was written with something else (stale serve, swizzled flush)
+		void invalidate() { m_lo = m_hi = 0; }
+	};
+
+	inline void atomic_max(std::atomic<uint64_t>& a, uint64_t v)
+	{
+		uint64_t cur = a.load(std::memory_order_relaxed);
+		while (cur < v && !a.compare_exchange_weak(cur, v, std::memory_order_relaxed)) {}
+	}
+
+	// Label (semaphore acquire) wait episodes on the RSX thread, split around the readback fault that happened inside it
+	struct label_split
+	{
+		uint64_t n = 0, total_ns = 0;
+		uint64_t with_fault = 0, pre_ns = 0, flush_ns = 0, post_ns = 0;
+		uint64_t fault_before = 0;
+	};
+
+	struct stats
+	{
+		std::atomic<uint64_t> flushes{ 0 }, hot_flushes{ 0 };
+		std::atomic<uint64_t> wait_ns{ 0 }, wait_max_ns{ 0 };
+		std::atomic<uint64_t> hits{ 0 }, late{ 0 }, misses{ 0 }, stale{ 0 };
+		std::atomic<uint64_t> kicks{ 0 }, wasted{ 0 };
+		std::atomic<uint64_t> label_kicks{ 0 }, consumed{ 0 }; // RSX_ADS_KICK_AT_LABEL
+		std::atomic<uint64_t> flush_bytes{ 0 }, dedup_bytes{ 0 }; // RSX_ADS_FLUSH_DEDUP: guest bytes copied / skipped
+		std::atomic<uint64_t> async_snaps{ 0 };                   // RSX_ADS_STALE_ASYNC: snapshots taken by the helper
+		std::atomic<uint64_t> kick_suppressed{ 0 };               // RSX_ADS_KICK_ADAPT: kicks skipped (each a load_dma + detile)
+		std::atomic<uint64_t> av_n{ 0 }, av_ns{ 0 }, av_max_ns{ 0 };
+
+		// Last access-violation readback (fault thread writes, RSX thread reads)
+		std::atomic<uint64_t> av_begin_ns{ 0 }, av_end_ns{ 0 };
+
+		// RSX thread only
+		uint64_t ep_start = 0, ep_last = 0;
+		label_split ls{};
+		uint64_t last_report_ns = 0;
+
+		static constexpr uint64_t episode_gap_ns = 2'000'000;
+		static constexpr uint64_t min_episode_ns = 1'000'000;
+		static constexpr uint64_t report_ns = 5'000'000'000ull;
+
+		void on_flush_wait(bool hot, bool speculative, bool was_ready, uint64_t waited_ns)
+		{
+			flushes.fetch_add(1, std::memory_order_relaxed);
+			if (hot) hot_flushes.fetch_add(1, std::memory_order_relaxed);
+			(speculative ? (was_ready ? hits : late) : misses).fetch_add(1, std::memory_order_relaxed);
+			wait_ns.fetch_add(waited_ns, std::memory_order_relaxed);
+			atomic_max(wait_max_ns, waited_ns);
+		}
+
+		void on_av(uint64_t begin, uint64_t end)
+		{
+			av_n.fetch_add(1, std::memory_order_relaxed);
+			av_ns.fetch_add(end - begin, std::memory_order_relaxed);
+			atomic_max(av_max_ns, end - begin);
+			av_begin_ns.store(begin, std::memory_order_relaxed);
+			av_end_ns.store(end, std::memory_order_relaxed);
+		}
+
+		// Split one finished wait [start, end] around the last readback fault
+		static void split_episode(label_split& ls, uint64_t start, uint64_t end, uint64_t fb, uint64_t fe)
+		{
+			if (end - start < min_episode_ns) return;
+			ls.n++;
+			ls.total_ns += end - start;
+			if (fe && fe >= start && fe <= end)
+			{
+				const uint64_t b = fb > start ? fb : start;
+				ls.with_fault++;
+				ls.pre_ns += b - start;
+				ls.flush_ns += fe - b;
+				ls.post_ns += end - fe;
+			}
+			else if (fe && fe < start && start - fe < 50'000'000)
+			{
+				ls.fault_before++;
+			}
+		}
+
+		// Called on every acquire poll (~100 us apart). Episodes are closed lazily once the next one starts.
+		void on_label_poll(uint64_t now)
+		{
+			if (ep_start && now - ep_last > episode_gap_ns)
+			{
+				split_episode(ls, ep_start, ep_last, av_begin_ns.load(std::memory_order_relaxed), av_end_ns.load(std::memory_order_relaxed));
+				ep_start = 0;
+			}
+			if (!ep_start) ep_start = now;
+			ep_last = now;
+		}
+
+		// Returns true (and fills buf) once per report period when there was activity; counters restart
+		bool report(uint64_t now, char* buf, size_t size)
+		{
+			if (!last_report_ns) { last_report_ns = now; return false; }
+			if (now - last_report_ns < report_ns) return false;
+			const double secs = double(now - last_report_ns) / 1e9;
+			last_report_ns = now;
+
+			if (ep_start && now - ep_last > episode_gap_ns)
+			{
+				split_episode(ls, ep_start, ep_last, av_begin_ns.load(std::memory_order_relaxed), av_end_ns.load(std::memory_order_relaxed));
+				ep_start = 0;
+			}
+
+			const uint64_t f = flushes.exchange(0), hf = hot_flushes.exchange(0), w = wait_ns.exchange(0), wm = wait_max_ns.exchange(0);
+			const uint64_t h = hits.exchange(0), l = late.exchange(0), m = misses.exchange(0), s = stale.exchange(0);
+			const uint64_t k = kicks.exchange(0), wa = wasted.exchange(0);
+			const uint64_t lk = label_kicks.exchange(0), co = consumed.exchange(0);
+			const uint64_t fb = flush_bytes.exchange(0), db = dedup_bytes.exchange(0), sn = async_snaps.exchange(0);
+			const uint64_t ks = kick_suppressed.exchange(0);
+			const uint64_t an = av_n.exchange(0), at = av_ns.exchange(0), am = av_max_ns.exchange(0);
+			const label_split L = ls;
+			ls = {};
+
+			if (!f && !k && !an) return false;
+
+			const auto ms = [](uint64_t ns, uint64_t n) { return n ? double(ns) / double(n) / 1e6 : 0.0; };
+			std::snprintf(buf, size,
+				"[ads-rb] %.1fs: %llu flushes (hot %llu), wait avg %llu max %llu us, av-fault avg %llu max %llu us (%llu), "
+				"async hits %llu late %llu misses %llu, stale %llu, kicks %llu wasted %llu | "
+				"label waits>1ms %llu avg %.2f ms; with readback %llu: before-fault %.2f + readback %.2f + after %.2f ms; fault-before-wait %llu",
+				secs,
+				(unsigned long long)f, (unsigned long long)hf,
+				(unsigned long long)(f ? w / f / 1000 : 0), (unsigned long long)(wm / 1000),
+				(unsigned long long)(an ? at / an / 1000 : 0), (unsigned long long)(am / 1000), (unsigned long long)an,
+				(unsigned long long)h, (unsigned long long)l, (unsigned long long)m, (unsigned long long)s,
+				(unsigned long long)k, (unsigned long long)wa,
+				(unsigned long long)L.n, ms(L.total_ns, L.n),
+				(unsigned long long)L.with_fault, ms(L.pre_ns, L.with_fault), ms(L.flush_ns, L.with_fault), ms(L.post_ns, L.with_fault),
+				(unsigned long long)L.fault_before);
+			if (cfg().kick_at_label)
+			{
+				const size_t len = std::strlen(buf);
+				if (len < size)
+				{
+					std::snprintf(buf + len, size - len, " | label-kicks %llu consumed %llu", (unsigned long long)lk, (unsigned long long)co);
+				}
+			}
+			if (cfg().flush_dedup || cfg().stale_async)
+			{
+				const size_t len = std::strlen(buf);
+				if (len < size)
+				{
+					std::snprintf(buf + len, size - len, " | copied %.1f MB dedup-skipped %.1f MB async-snaps %llu",
+						double(fb) / 1048576.0, double(db) / 1048576.0, (unsigned long long)sn);
+				}
+			}
+			if (cfg().kick_adapt)
+			{
+				const size_t len = std::strlen(buf);
+				if (len < size)
+				{
+					std::snprintf(buf + len, size - len, " | kick-adapt suppressed %llu", (unsigned long long)ks);
+				}
+			}
+			return true;
+		}
+	};
+
+	inline hot_tracker& hot()
+	{
+		static hot_tracker t;
+		static const bool adapt_set = (t.set_adapt(cfg().kick_adapt), true);
+		(void)adapt_set;
+		return t;
+	}
+	inline stale_store& stale() { static stale_store* s = new stale_store(); return *s; } // never destroyed: RSX_ADS_STALE_ASYNC helper thread
+	inline stats& st() { static stats s; return s; }
+
+	inline void maybe_report(uint64_t now)
+	{
+		char buf[896];
+		if (st().report(now, buf, sizeof(buf)))
+		{
+			std::printf("%s\n", buf);
+			std::fflush(stdout);
+		}
+	}
+}
diff --git a/rpcs3/Emu/RSX/port_backoff.h b/rpcs3/Emu/RSX/port_backoff.h
new file mode 100644
index 0000000..830d098
--- /dev/null
+++ b/rpcs3/Emu/RSX/port_backoff.h
@@ -0,0 +1,43 @@
+#pragma once
+
+// Port: bounded spin for RSX wait loops. Pure pause-spinning is fine with spare cores, but on a
+// 4-core CPU the spinner steals the core the producer (offloader, SPU, driver) needs, which made
+// frame rate collapse. Spin ~4 us for the low-latency case, then give the core away.
+#include "util/asm.hpp"
+#include <thread>
+
+#ifdef _WIN32
+extern "C" __declspec(dllimport) void __stdcall Sleep(unsigned long);
+#endif
+extern "C" int ps3_host_prio_boost(); // 1 = >= 8 logical CPUs: keep the original pure spin
+
+namespace rsx
+{
+	struct port_backoff
+	{
+		unsigned n = 0;
+
+		void operator()()
+		{
+			static const bool big = ps3_host_prio_boost() != 0;
+			if (big || n < 64)
+			{
+				utils::pause();
+			}
+			else if (n < 256)
+			{
+				std::this_thread::yield();
+			}
+			else
+			{
+#ifdef _WIN32
+				::Sleep(0);
+#else
+				std::this_thread::yield();
+#endif
+			}
+
+			if (n < 0xFFFF) n++;
+		}
+	};
+}
diff --git a/rpcs3/Emu/RSX/port_fifo_return_capture.h b/rpcs3/Emu/RSX/port_fifo_return_capture.h
new file mode 100644
index 0000000..820718c
--- /dev/null
+++ b/rpcs3/Emu/RSX/port_fifo_return_capture.h
@@ -0,0 +1,162 @@
+#pragma once
+
+#include <stdint.h>
+
+/* PORT (FIFO desync 2026-11-17): RSX_FIFO_RETURN_CAPTURE / R3_FIFO_RETURN_CAPTURE / R2_FIFO_RETURN_CAPTURE.
+ *
+ * The game's command-segment detour (R3 func at 0x0077F7E8..0x0077F898): with GET at G0 it writes JUMP(segment) at G0,
+ * the segment's commands, then JUMP(G0) at the segment end E, syncs and sets PUT = E. It waits until GET == PUT (the
+ * [hitch] "top 0x0077F884" drain), sets PUT = G0, restores the original word at G0 and later reuses the segment memory
+ * (E included) for new detours and data. On the RSX the puller takes the JUMP at E within ~1 us of the PUT move
+ * (RPCS3 PR #20055 hwtest). The port's RSX thread can poll PUT milliseconds late when it is CPU-bound (diner, 30-38
+ * fps): by then E holds data, which the puller runs as commands or jumps through (every R3 desync: "J G0->segment,
+ * word now REWRITTEN", then a 0x3XXXXXXX/data word at E; GET was exactly E == PUT, never ahead, when the game moved on).
+ *
+ * The puller cannot know the new PUT earlier, so it remembers what the hardware would have fetched: right before any
+ * GET publication that makes GET == PUT == E (cache end, execution position, semaphore acquire, label, JUMP) and on
+ * every idle poll at PUT == E (the word at E is written before PUT = E) it captures the word if it is a JUMP back to
+ * the address of the last JUMP taken (the detour's entry G0: data practically never matches). Capturing after the
+ * release would race the guest, which may already have moved PUT and reused E. If, when PUT has moved away, the word
+ * at E has changed, the puller executes the captured JUMP instead. A PUT moved forward inside the segment (the game
+ * appending commands at E) reads the new word as usual. GET publication is unchanged.
+ *
+ * Only a word reused as data or a method header is overridden: if E now holds a JUMP/CALL/RET the game re-linked the
+ * segment itself (R3 T1 freeze 11/17: E rewritten as JUMP 0x80a100 with PUT 0x80a138; running the stale capture to the
+ * ring looped over old commands forever) and the live word wins. PUT must also be in the ring around the captured
+ * target and not just below E (the game restarted the segment). A loop detector (port_rc_loop below) disables the capture
+ * for the session if, after a substitution, the puller comes back around to the same JUMP destinations before it reaches
+ * PUT while PUT stands still. It resumes at E if the game has re-linked E with a JUMP/CALL by then (port_rc_resume),
+ * else at PUT. */
+
+#define PORT_RC_NONE 0xFFFFFFFFu
+/* PUT within this many bytes after E = the game appended at E: the rewritten word is new commands, read it */
+#define PORT_RC_APPEND_WINDOW 0x10000u
+/* PUT within this many bytes before E = the game restarted the segment below E: the new word is its, read it */
+#define PORT_RC_RESTART_WINDOW 0x100000u
+/* PUT farther than this from the captured target (either way) = not the ring the detour returns to */
+#define PORT_RC_TARGET_SPAN 0x2000000u
+
+/* Target of an old- or new-style FIFO JUMP word, PORT_RC_NONE otherwise (gcm_enums.h RSX_METHOD_*_JUMP_*) */
+static inline uint32_t port_rc_jump_target(uint32_t w)
+{
+	if ((w & 0xe0000003u) == 0x20000000u) return w & 0x1ffffffcu;
+	if ((w & 0xe0000003u) == 0x00000001u) return w & 0xfffffffcu;
+	return PORT_RC_NONE;
+}
+
+/* Control-flow decode of a live word: 1 = JUMP/CALL with *target set, 2 = RET, 0 = neither (gcm_enums.h RSX_METHOD_*).
+ * Data often decodes as an old-style JUMP (any 0x2/0x3XXXXXXX float with low bits 0: T2 desyncs 0x37efb400,
+ * 0x3a949c00), so the caller also checks that the target is mapped IO before trusting it as a re-link. */
+static inline int port_rc_flow(uint32_t w, uint32_t* target)
+{
+	if ((*target = port_rc_jump_target(w)) != PORT_RC_NONE) return 1;
+	if ((w & 0x00000003u) == 0x00000002u) { *target = w & 0x1ffffffcu; return 1; } /* RSX_METHOD_CALL_OFFSET_MASK */
+	if ((w & 0xffff0003u) == 0x00020000u) return 2;
+	return 0;
+}
+
+/* The puller is parked at PUT == addr after entering through the JUMP at entry: is word a return to that JUMP? */
+static inline int port_rc_is_return(uint32_t entry, uint32_t addr, uint32_t word)
+{
+	return entry != PORT_RC_NONE && entry != addr && port_rc_jump_target(word) == entry;
+}
+
+/* PUT == addr and word is in memory there: update the capture. Called before every GET publication that makes
+ * GET == PUT (the guest may move PUT and reuse addr as soon as that GET is visible) and on every idle poll. */
+static inline void port_rc_note(uint32_t entry, uint32_t addr, uint32_t word, uint32_t* cap_addr, uint32_t* cap_word)
+{
+	if (port_rc_is_return(entry, addr, word))
+	{
+		*cap_addr = addr;
+		*cap_word = word;
+	}
+	else if (*cap_addr == addr)
+	{
+		*cap_addr = PORT_RC_NONE; /* rewritten while PUT still points at it: the hardware would fetch the new word too */
+	}
+}
+
+/* Fetching the command header at addr (= next_cmd_entry) with PUT != addr and the word now in memory: execute the
+ * captured return JUMP instead of now_word? now_flow_live: now_word is a RET, or a JUMP/CALL (port_rc_flow) whose
+ * target is mapped IO, i.e. the game re-linked E itself and the live word wins. */
+static inline int port_rc_substitute(uint32_t cap_addr, uint32_t cap_word, uint32_t addr, uint32_t next_cmd_entry,
+	uint32_t put, uint32_t now_word, int now_flow_live)
+{
+	if (cap_addr == PORT_RC_NONE || addr != cap_addr || addr != next_cmd_entry || now_word == cap_word)
+		return 0;
+	if (now_flow_live)
+		return 0; /* re-linked by the game: the live word wins */
+	if (put - addr <= PORT_RC_APPEND_WINDOW || addr - put < PORT_RC_RESTART_WINDOW)
+		return 0;
+	const uint32_t target = port_rc_jump_target(cap_word);
+	return target != PORT_RC_NONE && (put - target < PORT_RC_TARGET_SPAN || target - put < PORT_RC_TARGET_SPAN);
+}
+
+/* Loop detector after a substitution. Progress based, not timed: a semaphore acquire or a memwatch spin can block the
+ * puller for any length of time without being a loop. The substituted JUMP lands on its target (expected), the next JUMP
+ * the puller takes is remembered; landing on either again before the puller reaches PUT (port_rc_loop_parked), with the
+ * game's PUT unchanged, means it went around the ring over old commands (R3 T1 freeze 11/17: target 0x39ffd20 held the
+ * ring's wrap JUMP, so every lap jumped to the ring start again). Within one drain the game never sends the puller
+ * through the same JUMP destination twice: every detour waits for GET == PUT, which disarms the detector. */
+typedef struct port_rc_loop
+{
+	int armed;
+	int target_landed;
+	uint32_t e, put, target, next;
+	uint32_t e_word; /* the word at E at substitution time (the one the capture overrode) */
+} port_rc_loop;
+
+static inline void port_rc_loop_arm(port_rc_loop* l, uint32_t e, uint32_t cap_word, uint32_t put, uint32_t e_word)
+{
+	l->e_word = e_word;
+	l->armed = 1;
+	l->target_landed = 0;
+	l->e = e;
+	l->put = put;
+	l->target = port_rc_jump_target(cap_word);
+	l->next = PORT_RC_NONE;
+}
+
+/* The puller reached PUT (GET == PUT publication or idle poll): it went the right way */
+static inline void port_rc_loop_parked(port_rc_loop* l)
+{
+	l->armed = 0;
+}
+
+/* The puller takes a JUMP to dest with the game's PUT at put: 1 = loop (disarmed; resume at l->e) */
+static inline int port_rc_loop_jump(port_rc_loop* l, uint32_t dest, uint32_t put)
+{
+	if (!l->armed)
+		return 0;
+	if (put != l->put)
+	{
+		l->armed = 0; /* the game is moving on, so it is not waiting on a looping puller */
+		return 0;
+	}
+	if (dest == l->target && !l->target_landed)
+	{
+		l->target_landed = 1; /* the substituted JUMP itself */
+		return 0;
+	}
+	if (dest == l->target || dest == l->next)
+	{
+		l->armed = 0;
+		return 1;
+	}
+	if (l->next == PORT_RC_NONE)
+		l->next = dest;
+	return 0;
+}
+
+/* Where to resume after the loop detector tripped. now_word = the word at E now, now_flow_live as port_rc_substitute.
+ * E only if the game has re-linked it (a JUMP/CALL to mapped IO): then E runs as the hardware would. Not for a RET:
+ * the recovery empties the call stack (port_fifo_reset_flow), so it would be "RET without CALL" -> recover_fifo to E,
+ * repeatedly. PUT is unchanged since the
+ * substitution, so any other word at E (stale, garbage, or data that decodes as a method) is not a link the game made:
+ * E would fault (recover_fifo goes back to a restore point in the old lap) or run the stale segment again, so resume at
+ * PUT, skipping [E, PUT). */
+static inline uint32_t port_rc_resume(const port_rc_loop* l, uint32_t now_word, int now_flow_live, uint32_t put)
+{
+	uint32_t target;
+	return now_flow_live && port_rc_flow(now_word, &target) == 1 ? l->e : put;
+}
diff --git a/rpcs3/Emu/RSX/port_get_at_label.h b/rpcs3/Emu/RSX/port_get_at_label.h
new file mode 100644
index 0000000..161770e
--- /dev/null
+++ b/rpcs3/Emu/RSX/port_get_at_label.h
@@ -0,0 +1,20 @@
+#pragma once
+
+#include <stdint.h>
+
+/* R3PORT (hang 2026-11-16): GET must be past a label/semaphore release when its value lands.
+ *
+ * On the RSX the puller fetches ahead of execution, so by the time a release's write is visible GET is already
+ * past the command. RPCS3 publishes GET as the execution position whenever the cache-end publication is off
+ * (R3_FIFO_GET_EXEC, PR #20055, or a fetch without a cache), and only after the packet ran. R3's frame fence
+ * (func_0073439C, label 0x41) waits for the label, then reads GET once and spins until PUT equals that snapshot
+ * (0x00734C08). A snapshot taken between the label write and the end of the packet is the release's own header,
+ * PUT is 8 bytes further and nothing moves PUT again: the main thread spins forever on an idle RSX.
+ *
+ * Returns the GET to publish before the word at exec_pos writes its label, or 0 when the published GET is
+ * already past that word (upstream cache-end publication, or a jump elsewhere). GET is never moved backwards
+ * and never further than the end of the word being executed. */
+static inline uint32_t port_get_at_label(uint32_t published_get, uint32_t exec_pos)
+{
+	return exec_pos - published_get < 0x100000u ? exec_pos + 4u : 0u;
+}
diff --git a/rpcs3/Emu/RSX/port_prof.h b/rpcs3/Emu/RSX/port_prof.h
new file mode 100644
index 0000000..0819694
--- /dev/null
+++ b/rpcs3/Emu/RSX/port_prof.h
@@ -0,0 +1,299 @@
+#pragma once
+
+// R2PORT: R2_RSX_PROF=1 counters for the Resistance 2 port. The bridge (r2rsx_bridge.cpp) sets
+// r2prof::enabled before the RSX thread starts and prints the totals every 5 s. Everything is a
+// no-op branch when disabled. Per-frame stats (frame_statistics_t) are folded in at frame end.
+
+#include <atomic>
+#include <chrono>
+#include <cstdint>
+#if defined(_WIN32) && (defined(_M_X64) || defined(__x86_64__))
+#include <intrin.h> // R2PORT round 7: __rdtsc for now_ns
+#endif
+
+namespace r2prof
+{
+	inline bool enabled = false;
+	// rsx::thread is between core_renderer::begin() and the end of the draw
+	inline bool in_draw = false;
+	// rsx::thread is inside the fb-bind lock phase (VirtualProtect attribution)
+	inline thread_local bool in_fbb = false;
+
+	struct counters_t
+	{
+		std::atomic<uint64_t> frames{0}, draws{0}, submits{0};
+		// rsx::profiling_timer phases (µs), summed from frame_statistics_t
+		std::atomic<uint64_t> setup_us{0}, program_us{0}, vertex_us{0}, texture_us{0}, exec_us{0}, flip_us{0};
+		// core_renderer::begin(): framebuffer bind + backend begin_draw (µs)
+		std::atomic<uint64_t> fb_ns{0};
+		// begin() .. post_draw_hook() wall time of all draws (ns)
+		std::atomic<uint64_t> draw_ns{0};
+		std::atomic<uint64_t> vtx_cache_req{0}, vtx_cache_miss{0}, prog_lookups{0}, prog_elided{0};
+		// VKGSRender::flush_command_queue
+		std::atomic<uint64_t> flushes{0}, hard_syncs{0}, flush_ns{0};
+		// ZCULL report reads that had to wait on the host GPU
+		std::atomic<uint64_t> zcull_reads{0}, zcull_read_ns{0};
+		// Host page faults routed to rsx::g_access_violation_handler (bridge hook)
+		std::atomic<uint64_t> av_calls{0}, av_handled{0}, av_ns{0};
+		// Texture cache: flush_all on a fault (RSX-thread readback)
+		std::atomic<uint64_t> av_flushes{0};
+		// Round-2 breakdown counters, indexed by r2prof::xc (printed by name in the bridge)
+		std::atomic<uint64_t> x[192]{};
+	};
+
+	// Sub-phase counters. *_ns are nanoseconds, the rest are event counts.
+	enum xc : int
+	{
+		// on_framebuffer_bound (full rebinds only)
+		fbb_full, fbb_ignore, fbb_aa_ns, fbb_prep_ns, fbb_wcb_ns, fbb_wcb_copies, fbb_wcb_skipped, fbb_dma_flush,
+		fbb_lock_ns, fbb_rp_ns, fbb_total_ns,
+		// flush_command_queue callers
+		fl_zcull_hint, fl_zcull_hard, fl_av_request, fl_bind_dma,
+		// ZCULL
+		zc_sync_calls, zc_batch_calls, zc_batch_slots, zc_poll_loops, zc_flush_serviced,
+		// access violations that needed a GPU readback: wait for the RSX thread, then copy/wait
+		av_wait_ns, av_flush_ns, av_max_ns,
+		// vertex upload: layouts the weak cache cannot hold (multi-block / inline)
+		vtx_uncacheable,
+		// Round 3: rsx::thread time outside begin()..end() of draws (ns)
+		od_clear_ns, od_clears, od_fbb_ns, od_flush_ns, od_label_ns, od_blit_ns, od_flip_ns, od_house_ns, od_zcull_ns,
+		// DLSS/FSR hooks (VKR2Upscaler / pass dump call sites), total and the part inside draws (ns)
+		dlss_ns, dlss_draw_ns,
+		// Program resolve: backend lookup time (ns), why the cache hint was dropped
+		prog_lookup_ns, prog_vp_ucode, prog_fp_ucode, prog_vp_state, prog_fp_state,
+		// R3 only: program lookups answered by the ucode MRU (ProgramStateCache.h) instead of hash + map lookup
+		prog_mru_hits,
+		// Re-sent fragment / vertex programs kept without re-analysis (RSXGraphEngine, R2_FP_REBIND / R2_VP_REBIND),
+		// pipeline lookups answered by the last-pipeline memo (VKGSRender, R2_PIPE_MEMO)
+		prog_fp_rebind, prog_vp_rebind, prog_memo_hits,
+		// Deferred ZCULL labels (R2_ZCULL_DEFER)
+		zc_deferred, zc_released, zc_drain_block, zc_drain_ns, zc_fence_waits,
+		// Round 4: fb-bind lock phase split (ns), worst rebind lock time, rebinds whose lock phase took > 20 us
+		fbb_lk_discard_ns, fbb_lk_orphan_ns, fbb_lk_color_ns, fbb_lk_depth_ns, fbb_lk_max_ns, fbb_lk_slow,
+		// texture cache: m_cache_mutex wait on rsx::thread, invalidate_range_impl_base calls/ns/sections unprotected,
+		// lock_memory_region: already-locked relocks vs fresh locks (reset + protect)
+		tc_mutex_wait_ns, tc_inval_calls, tc_inval_ns, tc_unprotected, tc_relock, tc_fresh_lock,
+		// host VirtualProtect (utils::memory_protect): calls/ns on any thread, the part inside the fb-bind lock phase,
+		// calls skipped because VirtualQuery showed the pages already had that protection (R2_MM_SKIPSAME), pages
+		mm_vp_calls, mm_vp_ns, mm_vp_fbb_calls, mm_vp_fbb_ns, mm_vp_skipped, mm_vp_pages,
+		// g_mprotect_queue_lock wait on rsx::thread (ns); Offloader queue flushes
+		mm_qlock_wait_ns, mm_offload_flushes,
+		// flip_command split: frame limiter sleep, present (flip()), ZCULL labels carried over a flip (R2_ZCULL_FLIP_LAG)
+		od_limit_ns, od_present_ns, zc_flip_carried,
+		// program phase split (ns): ucode analysis (prefetch_*), load_program, transform constants (+bytes),
+		// fragment constants, remaining env/bind work in load_program_env
+		prog_analyse_ns, prog_load_ns, prog_xform_ns, prog_xform_bytes, prog_fconst_ns, prog_env_ns,
+		// R2_FBB_KEEP: rebinds avoided by keeping an unused depth / colour target bound
+		fbb_keep_depth, fbb_keep_color,
+		// Round 5: texture cache flush_set (blocking GPU readback) calls/ns/sections, the committed_as_fbo part,
+		// flushes skipped by R2_FBO_COMMIT_FLUSH=0 (sections fully overwritten by the new render target)
+		tc_flush_calls, tc_flush_ns, tc_flush_sections, tc_flush_commit_calls, tc_flush_commit_ns, tc_commit_skip,
+		// Round 5: load_program_env "rest" split (ns): vertex env, fragment texture env, bind_uniform calls, instancing,
+		// fragment env, DLSS/FSR draw hook (r2aa_on_draw, includes the AA run when it fires there)
+		pe_vtx_env_ns, pe_tex_env_ns, pe_bind_ns, pe_inst_ns, pe_frag_env_ns, pe_aa_ns,
+		// Round 6: flip_command split (od self ns): deferred-label drain/poll, reset() (ZCULL state), on_frame_end,
+		// the rest of the flip (handle_emu_flip outside limiter/present). ZCULL reads answered without waiting vs
+		// reads that had to wait for the GPU (fence), and the ns of those waits; reads by caller (update / sync / forced)
+		od_fl_drain_ns, od_fl_reset_ns, od_fl_end_ns, od_fl_emu_ns,
+		zc_read_ready, zc_read_wait, zc_read_wait_ns, zc_read_update, zc_read_forced,
+		// Round 7: draw "other" split (ns): core_renderer::begin() (incl. fb-bind), end() (incl. the phases), post_draw_hook;
+		// the rest of begin()..end of draw is method processing between begin and end.
+		dr_begin_ns, dr_end_ns, dr_post_ns,
+		// lock_memory_region_impl: superseded invalidation, create + reprotect (ns); why a lock was fresh (no section,
+		// section unlocked, section used for something else); superseded surfaces discarded in the fb-bind lock phase
+		lk_inval_ns, lk_create_ns, lk_fresh_noexist, lk_fresh_unlocked, lk_fresh_ctx, lk_superseded,
+		// invalidate_range_impl_base split (ns): get_intersecting_set, unprotect_set; sections discarded in the fast path
+		inval_isect_ns, inval_unprot_ns, inval_discards,
+		// Round 8: end() split (ns): decode_draw_state, resolve programs + pipeline state, write barriers, surface on_write;
+		// texture env load (resolve_sampler_state) and bind loop; Vulkan recording (pipeline/descriptor bind, dynamic state,
+		// draw emit); vertex split: index upload ns/bytes, attribute bytes, layout update ns
+		dr_decode_ns, dr_resolve_ns, dr_barrier_ns, dr_onwrite_ns, tex_load_ns, tex_bind_ns, vk_bind_ns, vk_dyn_ns, vk_draw_ns,
+		vtx_idx_ns, vtx_idx_bytes, vtx_data_bytes, vtx_layout_ns,
+		// pipeline lookups past the memo, in-memory pipeline cache misses (compile), draws skipped while a program compiles
+		pipe_slow, pipe_miss, pipe_not_ready,
+		// FIFO methods, methods re-writing the same register value, draws merged by the flattener (R2_FIFO_MERGE)
+		fifo_methods, fifo_same, fifo_merged,
+		// R2_XFORM_MEMO transform-constant uploads skipped (+bytes); R2_IDX_DEDUP index uploads reused (+bytes), verify misses
+		xc_memo_hits, xc_memo_bytes, idx_dedup_hits, idx_dedup_bytes, idx_dedup_stale,
+		// CPU->GPU texture uploads (upload_image_from_cpu): count, ns, of which recorded on the async queue (R2_ASYNC_TEX)
+		tex_up_count, tex_up_ns, tex_up_async,
+		// RSX_SAMPLER_CACHE: fragment sampler parameter derivations answered by the memo / computed
+		smp_memo_hits, smp_memo_miss,
+		// RSX_VTX_REUSE: multi-block persistent uploads reused from this frame (+bytes)
+		vtx_reuse_hits, vtx_reuse_bytes,
+		// RSX_IBIND_SKIP: index-buffer binds left out (the ring was already bound in this command buffer / render pass)
+		ibind_skipped,
+		// RSX_ATEST_RESAMPLE: fragment samplers re-derived for an alpha-test LOD bias change without a texture re-upload
+		smp_bias_only,
+		// resolve-programs split: r2aa_check_texture_reads ns, its jittered-content checks and RSX_AA_TEXREAD_MEMO hits;
+		// r3fx_check_texture_reads ns (R3); get_current_fragment/vertex_program ns
+		aa_texr_ns, aa_texr_jd, aa_texr_memo, fx_texr_ns, prog_getcur_ns,
+		tex_expire_ns, tex_upl_ns, tex_upl_n, tex_search_ns, tex_smp_ns, tex_vs_ns, // R3PORT texture env split
+		// RSX_FIFO_HOOKS_FAST census: run_FIFO calls (packets), housekeeping runs (every 64 packets / interrupt-forced) and
+		// their split in ns (each includes nested od scopes such as flushes)
+		fifo_packets, hk_runs, hk_irq, hk_ctx_ns, hk_local_ns, hk_zcull_ns, hk_labels_ns, hk_dma_ns, hk_light, aa_link_memo, pipe_memo2_hits,
+		set0_alloc, set0_adopt, set0_inval,
+		x_count
+	};
+	static_assert(x_count <= 192);
+
+	inline counters_t g;
+
+	// R2PORT round 9: usage census (R2_RSX_CENSUS=1 with R2_RSX_PROF=1). What the game actually sends, so the
+	// renderer can be specialised: FIFO methods by register (+ same-value writes), render-target formats, texture
+	// formats, MRT counts, conditional-render draws. Written by rsx::thread only; the monitor diffs snapshots.
+	struct census_t
+	{
+		std::atomic<uint32_t> meth[0x4000];
+		std::atomic<uint32_t> meth_same[0x4000];
+		std::atomic<uint32_t> color_fmt[32];
+		std::atomic<uint32_t> depth_fmt[8];
+		std::atomic<uint32_t> tex_fmt[256];
+		std::atomic<uint32_t> mrt[5];
+		std::atomic<uint32_t> cond_render;
+		std::atomic<uint32_t> draws;
+		// Draw-call reduction census (r2_rsx_native.md): draws where, since the previous executed draw, only "delta"
+		// registers changed value (transform constants, vertex base offset/index, index address, vertex/L2 invalidates,
+		// reports, semaphores, RENDER_ENABLE, the draw methods); the same but also allowing vertex array offsets; draws
+		// whose Vulkan state equals the previous draw's (same command buffer + state epoch, render pass instance, pipeline,
+		// descriptor sets, no query begun, no conditional rendering, no programmable-blending barrier). Upper bounds for
+		// constant-delta merging and multi-draw-indirect batching; they change nothing.
+		std::atomic<uint32_t> delta_only, delta_only_va, vk_same;
+		// RSX_FIFO_HOOKS_FAST census: method handler ns by register; methods that met each FIFO hook (draw log,
+		// frame capture, flattener, featcov enabled)
+		std::atomic<uint64_t> meth_ns[0x4000];
+		std::atomic<uint32_t> hook_drawlog, hook_capture, hook_flat, hook_featcov;
+	};
+	inline census_t census{};
+	inline bool census_on = false;
+	// rsx::thread only: a non-delta register changed value since the last executed draw (bit 0), or only vertex array offsets (bit 1)
+	inline uint32_t census_nondelta = 3;
+
+	inline uint32_t census_delta_class(uint32_t reg) // 0: delta register, 2: vertex array offset, 1: other state
+	{
+		if (reg >= (0x1f00 >> 2) && reg < (0x1f80 >> 2)) return 0;  // SET_TRANSFORM_CONSTANT[32]
+		if (reg >= (0x1680 >> 2) && reg < (0x16c0 >> 2)) return 2;  // SET_VERTEX_DATA_ARRAY_OFFSET[16]
+		switch (reg << 2)
+		{
+		case 0x0050: case 0x0064: case 0x0068: case 0x006c:          // NV406E reference / semaphore offset / acquire / release
+		case 0x1710: case 0x1714: case 0x1738: case 0x173c:          // INVALIDATE_VERTEX_CACHE_FILE/_FILE, VERTEX_DATA_BASE_OFFSET/_INDEX
+		case 0x17c8: case 0x1800: case 0x1808: case 0x180c: case 0x1810: // CLEAR_REPORT_VALUE, GET_REPORT, BEGIN_END, ARRAY_ELEMENT16/32
+		case 0x1814: case 0x1818: case 0x181c: case 0x1824:          // DRAW_ARRAYS, INLINE_ARRAY, INDEX_ARRAY_ADDRESS, DRAW_INDEX_ARRAY
+		case 0x1d6c: case 0x1d70: case 0x1d74:                       // SEMAPHORE_OFFSET, BACK_END_WRITE / TEXTURE_READ_SEMAPHORE_RELEASE
+		case 0x1e98: case 0x1efc: case 0x1fd8:                       // RENDER_ENABLE, TRANSFORM_CONSTANT_LOAD, INVALIDATE_L2
+			return 0;
+		default:
+			return 1;
+		}
+	}
+
+	inline void census_inc(std::atomic<uint32_t>& c) { c.store(c.load(std::memory_order_relaxed) + 1, std::memory_order_relaxed); }
+	inline void census_add(std::atomic<uint64_t>& c, uint64_t v) { c.store(c.load(std::memory_order_relaxed) + v, std::memory_order_relaxed); }
+
+	// R2PORT round 7: the profiler reads the clock ~40 times per draw; rdtsc (invariant TSC, scaled once against QPC)
+	// costs a fraction of steady_clock::now() (QPC + 128-bit scaling), so R2_RSX_PROF disturbs the numbers less.
+	inline double tsc_ns_factor()
+	{
+#if defined(_WIN32) && (defined(_M_X64) || defined(__x86_64__))
+		const auto qpc = [] { return std::chrono::steady_clock::now(); };
+		const auto q0 = qpc();
+		const uint64_t r0 = __rdtsc();
+		while (qpc() - q0 < std::chrono::milliseconds(2)) {}
+		const auto q1 = qpc();
+		const uint64_t r1 = __rdtsc();
+		const double ns = static_cast<double>(std::chrono::duration_cast<std::chrono::nanoseconds>(q1 - q0).count());
+		return r1 > r0 ? ns / static_cast<double>(r1 - r0) : 0.0;
+#else
+		return 0.0;
+#endif
+	}
+
+	inline uint64_t now_ns()
+	{
+#if defined(_WIN32) && (defined(_M_X64) || defined(__x86_64__))
+		static const double k = tsc_ns_factor();
+		if (k > 0.0) [[likely]] return static_cast<uint64_t>(static_cast<double>(__rdtsc()) * k);
+#endif
+		return static_cast<uint64_t>(std::chrono::duration_cast<std::chrono::nanoseconds>(
+			std::chrono::steady_clock::now().time_since_epoch()).count());
+	}
+
+	inline void add(std::atomic<uint64_t>& c, uint64_t v)
+	{
+		c.fetch_add(v, std::memory_order_relaxed);
+	}
+
+	inline void addx(xc i, uint64_t v = 1)
+	{
+		if (enabled) g.x[i].fetch_add(v, std::memory_order_relaxed);
+	}
+
+	// Single-writer counter (rsx::thread only, the monitor only reads): no locked add on per-method paths
+	inline void addx_st(xc i, uint64_t v = 1)
+	{
+		g.x[i].store(g.x[i].load(std::memory_order_relaxed) + v, std::memory_order_relaxed);
+	}
+
+	inline void maxx(xc i, uint64_t v)
+	{
+		if (!enabled) return;
+		uint64_t cur = g.x[i].load(std::memory_order_relaxed);
+		while (v > cur && !g.x[i].compare_exchange_weak(cur, v, std::memory_order_relaxed)) {}
+	}
+
+	// ns timer into g.x[i]
+	struct scope_x
+	{
+		xc i;
+		uint64_t t0;
+		explicit scope_x(xc idx) : i(idx), t0(enabled ? now_ns() : 0) {}
+		~scope_x() { if (t0) g.x[i].fetch_add(now_ns() - t0, std::memory_order_relaxed); }
+	};
+
+	// ns timer into g.x[i] that only counts outside draws. Self time: nested od scopes are subtracted from the outer one.
+	inline thread_local uint64_t od_child = 0;
+	struct scope_od
+	{
+		xc i;
+		uint64_t t0 = 0;
+		uint64_t saved = 0;
+		explicit scope_od(xc idx) : i(idx)
+		{
+			if (!enabled || in_draw) return;
+			saved = od_child;
+			od_child = 0;
+			t0 = now_ns();
+		}
+		~scope_od()
+		{
+			if (!t0) return;
+			const uint64_t total = now_ns() - t0;
+			const uint64_t self = total > od_child ? total - od_child : 0;
+			g.x[i].fetch_add(self, std::memory_order_relaxed);
+			od_child = saved + total;
+		}
+	};
+
+	// ns timer for the DLSS/FSR hooks: total, plus the in-draw part
+	struct scope_dlss
+	{
+		uint64_t t0;
+		bool draw;
+		scope_dlss() : t0(enabled ? now_ns() : 0), draw(in_draw) {}
+		~scope_dlss()
+		{
+			if (!t0) return;
+			const uint64_t d = now_ns() - t0;
+			g.x[dlss_ns].fetch_add(d, std::memory_order_relaxed);
+			if (draw) g.x[dlss_draw_ns].fetch_add(d, std::memory_order_relaxed);
+		}
+	};
+
+	struct scope_ns
+	{
+		std::atomic<uint64_t>* sink;
+		uint64_t t0;
+		explicit scope_ns(std::atomic<uint64_t>& c) : sink(enabled ? &c : nullptr), t0(sink ? now_ns() : 0) {}
+		~scope_ns() { if (sink) add(*sink, now_ns() - t0); }
+	};
+}
diff --git a/rpcs3/Emu/RSX/port_r2aa_memo.h b/rpcs3/Emu/RSX/port_r2aa_memo.h
new file mode 100644
index 0000000..e2e8596
--- /dev/null
+++ b/rpcs3/Emu/RSX/port_r2aa_memo.h
@@ -0,0 +1,122 @@
+#pragma once
+
+// R2PORT round 8b: exact per-draw memos for the upscaler bookkeeping on rsx::thread (VKR2Upscaler.cpp, RSX_AA_DRAW_MEMO).
+// Pure logic, unit tested in scratch\r2aa_memo. A memo hit is only ever taken on a full comparison of every input the
+// memoised result depends on (tags only select candidates), so the decisions are the ones the full path makes.
+
+#include <cstddef>
+#include <cstdint>
+#include <cstdlib>
+#include <cstring>
+
+namespace r2aamemo
+{
+	// RSX_AA_DRAW_MEMO: 0 = off (the full path only), 1 = on (default), 2 = verify (both paths run, the full path's result
+	// is used, differences are counted and logged)
+	inline int parse_mode(const char* v)
+	{
+		if (!v || !*v) return 1;
+		const int m = std::atoi(v);
+		return m <= 0 ? 0 : m >= 2 ? 2 : 1;
+	}
+
+	inline int mode()
+	{
+		static const int m = parse_mode(std::getenv("RSX_AA_DRAW_MEMO"));
+		return m;
+	}
+
+	struct counter
+	{
+		uint32_t hit = 0, miss = 0, bad = 0;
+	};
+
+	// Ways entries, round-robin replacement, the most recent hit checked first. A hit needs all KeyWords equal.
+	template <uint32_t KeyWords, typename Value, uint32_t Ways>
+	struct exact_memo
+	{
+		static_assert(Ways > 0, "Ways");
+		struct entry
+		{
+			uint32_t key[KeyWords];
+			Value value;
+			bool valid;
+		};
+		entry e[Ways]{};
+		uint32_t next = 0, last = 0;
+
+		Value* find(const uint32_t (&key)[KeyWords])
+		{
+			uint32_t w = last;
+			for (uint32_t n = 0; n < Ways; ++n, w = (w + 1) % Ways)
+			{
+				if (e[w].valid && std::memcmp(e[w].key, key, sizeof(key)) == 0)
+				{
+					last = w;
+					return &e[w].value;
+				}
+			}
+			return nullptr;
+		}
+
+		Value* store(const uint32_t (&key)[KeyWords], const Value& value)
+		{
+			entry& x = e[next];
+			std::memcpy(x.key, key, sizeof(key));
+			x.value = value;
+			x.valid = true;
+			last = next;
+			next = (next + 1) % Ways;
+			return &x.value;
+		}
+
+		void clear()
+		{
+			for (entry& x : e) x.valid = false;
+			next = last = 0;
+		}
+	};
+
+	// Candidate pointers by a cheap tag; find() returns a candidate only when the caller's full compare accepts it
+	template <typename P, uint32_t Sets, uint32_t Ways>
+	struct tag_cache
+	{
+		static_assert(Sets && (Sets & (Sets - 1)) == 0, "Sets must be a power of two");
+		struct slot
+		{
+			uint64_t tag;
+			P* p;
+		};
+		slot s[Sets][Ways]{};
+		uint32_t next[Sets]{};
+
+		template <typename Eq>
+		P* find(uint64_t tag, Eq&& eq) const
+		{
+			const slot* row = s[tag & (Sets - 1)];
+			for (uint32_t w = 0; w < Ways; ++w)
+				if (row[w].p && row[w].tag == tag && eq(*row[w].p)) return row[w].p;
+			return nullptr;
+		}
+
+		void put(uint64_t tag, P* p)
+		{
+			const uint32_t i = static_cast<uint32_t>(tag & (Sets - 1));
+			for (uint32_t w = 0; w < Ways; ++w)
+				if (s[i][w].p == p && s[i][w].tag == tag) return;
+			s[i][next[i]] = { tag, p };
+			next[i] = (next[i] + 1) % Ways;
+		}
+	};
+
+	// Cheap tag of a vertex program: entry pc, size and 8 sampled ucode words. It only selects candidates.
+	inline uint64_t vp_tag(uint32_t pc0, const uint32_t* d, size_t n)
+	{
+		uint64_t h = (static_cast<uint64_t>(pc0) << 32) ^ static_cast<uint64_t>(n) ^ 0x9e3779b97f4a7c15ull;
+		h *= 0xff51afd7ed558ccdull;
+		if (n)
+			for (size_t k = 0; k < 8; ++k)
+				h = (h ^ d[((n - 1) * k) / 7]) * 0xc4ceb9fe1a85ec53ull;
+		return h ^ (h >> 29);
+	}
+}
diff --git a/rpcs3/Emu/RSX/port_r2memo.h b/rpcs3/Emu/RSX/port_r2memo.h
new file mode 100644
index 0000000..6083c33
--- /dev/null
+++ b/rpcs3/Emu/RSX/port_r2memo.h
@@ -0,0 +1,390 @@
+#pragma once
+
+// R2PORT round 8: upload memos for the Vulkan renderer (pure logic, unit tested in scratch\enginetest).
+// Reuse is only ever based on a full content comparison or on exact change tracking, so the GPU sees the same bytes
+// as the upstream path. Every memo is tied to the ring-heap epoch, which is bumped by any heap GET move (frame
+// cleanup, hard sync), heap re-init or growth AND at every frame boundary: reused data was therefore always written
+// by the frame currently being recorded, whose heap range stays reserved until that frame's commands have executed.
+
+#include <atomic>
+#include <cstddef>
+#include <cstdint>
+#include <cstdlib>
+#include <cstring>
+#include <vector>
+
+namespace r2memo
+{
+	// Bumped whenever ring-heap space may be recycled (rsx::data_heap::set_get_pos/reset_allocation_stats/init)
+	// and when the renderer moves to the next frame context (VKGSRender::advance_queued_frames)
+	inline uint64_t g_heap_epoch = 1;
+	inline void bump_heap_epoch() { ++g_heap_epoch; }
+
+	// Bumped whenever REGS->transform_constants may have changed (nv4097 set_transform_constant writers)
+	inline uint64_t g_xform_gen = 1;
+	inline void bump_xform_gen() { ++g_xform_gen; }
+
+	// RSX_PIPE_SPLIT (VKR2Upscaler.cpp): set while the r2aa lane job may still read REGS->transform_constants (its
+	// capture). Every writer of the constants calls before_xform_write() first, which joins the lane (render thread only)
+	inline bool g_xform_reader_busy = false;
+	inline void (*g_xform_reader_join)() = nullptr;
+	// RSX_SPLIT2 (VK\VKSplit2.h): same contract for the stage-2 worker that fills the transform-constant UBO. Separate flag
+	// because each joiner clears its own flag
+	inline bool g_xform_reader2_busy = false;
+	inline void (*g_xform_reader2_join)() = nullptr;
+	inline void before_xform_write()
+	{
+		if (g_xform_reader_busy) [[unlikely]] g_xform_reader_join();
+		if (g_xform_reader2_busy) [[unlikely]] g_xform_reader2_join();
+	}
+
+	// RSX_SPLIT2: set while the stage-2 worker may still write into a mapped ring heap. data_heap::grow/destroy call
+	// before_heap_unmap() before unmapping, vk::queue_submit calls before_gpu_submit() before a command buffer is submitted
+	// or queued to the MTRSX offloader. Only a render-thread join waits; joins from other threads are no-ops
+	inline std::atomic<bool> g_heap_writer_busy{ false }; // read by any submitting thread
+	inline void (*g_heap_writer_join)(int reason) = nullptr;
+	inline void before_heap_unmap()
+	{
+		if (g_heap_writer_busy.load(std::memory_order_relaxed)) [[unlikely]] g_heap_writer_join(0);
+	}
+	inline void before_gpu_submit()
+	{
+		if (g_heap_writer_busy.load(std::memory_order_relaxed)) [[unlikely]] g_heap_writer_join(1);
+	}
+
+	// RSX_ZCULL_IDLE_FLUSH (rsx::thread main loop). Relaxed ZCULL sync has no time-based flush: a claimed report whose
+	// host query is still recorded in the unsubmitted command buffer is only submitted by later work (draws, a flip).
+	// Once the guest has touched report memory it polls the report without any trigger to RSX, so with the FIFO run dry
+	// nothing ever submits it (R2 hang 2026-11-13: the main thread waited the occlusion wait's full 1 s timeout at
+	// 0x001723C8 while the FIFO sat idle for 969 ms). Due = submit the newest claimed query now. Never moves GET.
+	inline bool zcull_idle_flush_due(bool enabled, bool relaxed, bool fifo_idle, uint64_t idle_us, uint32_t claimed,
+		bool critical, uint64_t min_idle_us = 200)
+	{
+		return enabled && relaxed && fifo_idle && idle_us >= min_idle_us && claimed != 0 && critical;
+	}
+
+	// RSX_ZCULL_CRIT_FLUSH_US (rsx::thread main loop; ported from R2 perf 2026-11-15). The idle flush above only fires once
+	// the FIFO has run dry; while RSX keeps decoding the rest of the frame a claimed report the guest is already polling
+	// (critical: the report area was touched; R3's occlusion wait at 0x00274E64) stays in the unsubmitted command buffer.
+	// Due = the oldest unsubmitted claimed query was claimed >= delay_us ago, and the last forced submit is >= delay_us ago
+	// (bounds the extra submits to 1/delay). Results stay exact (the same queries, just submitted sooner).
+	inline bool zcull_crit_flush_due(uint64_t delay_us, bool relaxed, bool critical, uint64_t now_us, uint64_t oldest_ts,
+		uint64_t last_flush_us)
+	{
+		return delay_us != 0 && relaxed && critical && oldest_ts != 0 && now_us >= oldest_ts + delay_us &&
+			now_us - last_flush_us >= delay_us;
+	}
+
+	// RSX_HK_DRAW_LIGHT: housekeeping level for one FIFO packet. 2 = full (64-packet tick or any other interrupt),
+	// 1 = backend local task only (the per-draw backend interrupt), 0 = none
+	inline int housekeeping_level(bool tick, uint32_t irq_mask, bool light, uint32_t backend_bit = 1)
+	{
+		if (tick) return 2;
+		if (!irq_mask) return 0;
+		return (light && irq_mask == backend_bit) ? 1 : 2;
+	}
+
+	// Read once: unset -> def, "0" -> off, anything else -> on
+	inline bool env_switch(const char* name, bool def)
+	{
+		const char* v = std::getenv(name);
+		if (!v || !v[0]) return def;
+		return v[0] != '0';
+	}
+
+	// Persistent VkPipelineCache blob: only handed back to the driver when its VkPipelineCacheHeaderVersionOne
+	// (header size >= 32, version 1, vendor, device, pipelineCacheUUID) names this exact GPU and driver build.
+	// The driver validates it again; a mismatching blob is simply ignored (empty cache, upstream behaviour).
+	inline bool pipe_cache_header_ok(const uint8_t* data, size_t size, uint32_t vendor, uint32_t device, const uint8_t uuid[16])
+	{
+		if (!data || size < 32) return false;
+		uint32_t h[4];
+		std::memcpy(h, data, sizeof(h));
+		return h[0] >= 32 && h[0] <= size && h[1] == 1 && h[2] == vendor && h[3] == device && std::memcmp(data + 16, uuid, 16) == 0;
+	}
+
+	// Transform-constant upload memo: the upload is a pure function of (vertex program, constants), so when the
+	// program is the same and no constant write happened since the last upload, the last upload is still valid.
+	struct xform_memo
+	{
+		const void* prog = nullptr;
+		uint64_t gen = 0;
+		uint64_t epoch = 0;
+
+		bool hit(const void* p, uint64_t cur_gen, uint64_t cur_epoch) const
+		{
+			return prog && p == prog && gen == cur_gen && epoch == cur_epoch;
+		}
+		void store(const void* p, uint64_t cur_gen, uint64_t cur_epoch) { prog = p; gen = cur_gen; epoch = cur_epoch; }
+		void clear() { prog = nullptr; }
+	};
+
+	// Index upload dedup: direct-mapped table keyed by (source pointer, size, decode parameters). A hit requires the
+	// same heap epoch and byte-identical source data (memcmp against a private copy), so the ring data written by the
+	// earlier upload is exactly what the upstream path would write again.
+	struct index_result
+	{
+		uint64_t offset;
+		uint32_t min_index, max_index, index_count;
+	};
+
+	class index_dedup
+	{
+	public:
+		static constexpr uint32_t ways = 128;
+		static constexpr uint32_t max_bytes = 128 * 1024;
+
+		enum class result { miss, hit, stale };
+
+		static uint32_t slot_of(const void* src, uint32_t size, uint64_t params)
+		{
+			uint64_t h = reinterpret_cast<uintptr_t>(src) ^ (static_cast<uint64_t>(size) << 32) ^ (params * 0x9E3779B97F4A7C15ull);
+			h ^= h >> 29; h *= 0xBF58476D1CE4E5B9ull; h ^= h >> 32;
+			return static_cast<uint32_t>(h) & (ways - 1);
+		}
+
+		// out_size: bytes the upload writes to the ring (expansion / restart emulation). On hit fills out.
+		// stale = key matched but the source bytes changed (counted separately).
+		result lookup(const void* src, uint32_t size, uint64_t params, uint32_t out_size, uint64_t epoch, index_result& out) const
+		{
+			if (size == 0 || size > max_bytes) return result::miss;
+			const entry& e = m_entries[slot_of(src, size, params)];
+			if (e.epoch != epoch || e.src != src || e.size != size || e.params != params || e.out_size != out_size) return result::miss;
+			if (std::memcmp(e.data.data(), src, size) != 0) return result::stale;
+			out = e.res;
+			return result::hit;
+		}
+
+		void store(const void* src, uint32_t size, uint64_t params, uint32_t out_size, uint64_t epoch, const index_result& res)
+		{
+			if (size == 0 || size > max_bytes) return;
+			entry& e = m_entries[slot_of(src, size, params)];
+			e.src = src;
+			e.size = size;
+			e.params = params;
+			e.out_size = out_size;
+			e.epoch = epoch;
+			e.res = res;
+			e.data.resize(size);
+			std::memcpy(e.data.data(), src, size);
+		}
+
+	private:
+		struct entry
+		{
+			const void* src = nullptr;
+			uint32_t size = 0;
+			uint64_t params = 0;
+			uint32_t out_size = 0;
+			uint64_t epoch = 0;
+			index_result res{};
+			std::vector<unsigned char> data;
+		};
+		entry m_entries[ways];
+	};
+
+	// Packs the decode parameters that change the uploaded index bytes / min / max / count (exact, no hashing)
+	inline uint64_t index_params(uint32_t index_type, uint32_t primitive, bool restart_enabled, bool emulate_restart, uint32_t restart_index)
+	{
+		const uint64_t flags = (index_type & 0xFu) | ((primitive & 0xFFu) << 4) | (restart_enabled ? 1u << 12 : 0u) | (emulate_restart ? 1u << 13 : 0u);
+		return flags | (static_cast<uint64_t>(restart_enabled ? restart_index : 0u) << 32);
+	}
+
+	// RSX_SAMPLER_CACHE: memo for a value that is a pure function of a fixed-size key (exact word compare), with a few
+	// ways per set replaced round-robin. Used for the per-TIU sampler parameter derivation: the key holds every input of
+	// that derivation, so a hit returns exactly what the derivation would compute again.
+	// RSX_SAMPLER_CACHE_WIDE (default on): Sets hashed sets of Ways each (outdoor scenes cycle far more than 4 sampler
+	// states per TIU per frame); the hash only picks the set, a hit still needs the full key compare. Off -> one set
+	// (the previous 4-way memo).
+	inline bool sampler_cache_wide()
+	{
+		static const bool on = env_switch("RSX_SAMPLER_CACHE_WIDE", true);
+		return on;
+	}
+
+	template <uint32_t KeyWords, typename Value, uint32_t Ways = 4, uint32_t Sets = 16>
+	class keyed_memo
+	{
+		static_assert(Sets && (Sets & (Sets - 1)) == 0, "Sets must be a power of two");
+
+	public:
+		keyed_memo() : m_wide(sampler_cache_wide()) {}
+
+		void set_wide(bool wide) { m_wide = wide; clear(); }
+
+		const Value* find(const uint32_t (&key)[KeyWords]) const
+		{
+			const set_t& s = m_sets[set_of(key)];
+			for (uint32_t w = 0; w < Ways; ++w)
+			{
+				const entry& e = s.e[w];
+				if (e.valid && std::memcmp(e.key, key, sizeof(e.key)) == 0) return &e.value;
+			}
+			return nullptr;
+		}
+
+		void store(const uint32_t (&key)[KeyWords], const Value& value)
+		{
+			set_t& s = m_sets[set_of(key)];
+			entry& e = s.e[s.next];
+			s.next = (s.next + 1) % Ways;
+			std::memcpy(e.key, key, sizeof(e.key));
+			e.value = value;
+			e.valid = true;
+		}
+
+		void clear()
+		{
+			for (set_t& s : m_sets)
+			{
+				for (entry& e : s.e) e.valid = false;
+				s.next = 0;
+			}
+		}
+
+	private:
+		uint32_t set_of(const uint32_t (&key)[KeyWords]) const
+		{
+			if (!m_wide) return 0;
+			uint32_t h = 0x811C9DC5u;
+			for (uint32_t k = 0; k < KeyWords; ++k) h = (h ^ key[k]) * 0x01000193u;
+			return (h ^ (h >> 15)) & (Sets - 1);
+		}
+
+		struct entry
+		{
+			uint32_t key[KeyWords]{};
+			Value value{};
+			bool valid = false;
+		};
+		struct set_t
+		{
+			entry e[Ways]{};
+			uint32_t next = 0;
+		};
+		set_t m_sets[Sets]{};
+		bool m_wide = true;
+	};
+
+	// RSX_VTX_REUSE: within-frame reuse of the persistent vertex block for layouts the upstream weak vertex cache does
+	// not hold (several interleaved blocks). The persistent block is the plain concatenation of each block's guest bytes
+	// (draw_command_processor::write_vertex_data_to_memory), so the same ordered (source, size) list with byte-identical
+	// sources (memcmp against a private copy) means the upload would write exactly the bytes already in the ring at
+	// the stored offset. Tied to g_heap_epoch like index_dedup, so the reused range was written in this frame.
+	// A private copy is only taken the second time a key is seen, so one-off layouts cost a key compare only.
+	struct vtx_block
+	{
+		const void* src;
+		uint32_t size;
+	};
+
+	class vertex_reuse
+	{
+	public:
+		static constexpr uint32_t ways = 64;
+		static constexpr uint32_t max_blocks = 8;
+		static constexpr uint32_t max_bytes = 64 * 1024;
+
+		enum class result { miss, seen, stale, hit };
+
+		static uint32_t slot_of(const vtx_block* b, uint32_t n)
+		{
+			uint64_t h = n;
+			for (uint32_t i = 0; i < n; ++i)
+			{
+				h = (h ^ reinterpret_cast<uintptr_t>(b[i].src) ^ (static_cast<uint64_t>(b[i].size) << 40)) * 0x9E3779B97F4A7C15ull;
+				h ^= h >> 31;
+			}
+			return static_cast<uint32_t>(h >> 7) & (ways - 1);
+		}
+
+		static bool eligible(uint32_t n, uint32_t total) { return n > 0 && n <= max_blocks && total > 0 && total <= max_bytes; }
+
+		// A hit is only usable if no ring allocation between the lookup and the draw replaced/recycled the heap
+		// (data_heap::grow -> init bumps the epoch and raises heap_changed). Otherwise the caller re-uploads (stale path).
+		static bool hit_still_valid(uint64_t hit_epoch, uint64_t now_epoch, bool heap_changed) { return hit_epoch == now_epoch && !heap_changed; }
+
+		// A freshly allocated persistent range may only be recorded (note/store) if no later ring allocation (the
+		// volatile one) grew/recycled the heap: the offset belongs to the allocator of alloc_epoch, which the new heap
+		// overwrites from offset 0. Otherwise the caller uploads without recording.
+		static bool can_record(uint64_t alloc_epoch, uint64_t now_epoch, bool heap_changed) { return alloc_epoch == now_epoch && !heap_changed; }
+
+		// hit: out_offset is the ring offset of identical data. seen: same key earlier in this epoch without a copy
+		// (call store). stale: same key, bytes changed (call store). miss: new key (call note).
+		result lookup(const vtx_block* b, uint32_t n, uint32_t total, uint64_t epoch, uint64_t& out_offset) const
+		{
+			if (!eligible(n, total)) return result::miss;
+			const entry& e = m_entries[slot_of(b, n)];
+			if (!same_key(e, b, n, total, epoch)) return result::miss;
+			if (!e.has_data) return result::seen;
+			const unsigned char* d = e.data.data();
+			for (uint32_t i = 0; i < n; ++i)
+			{
+				if (std::memcmp(d, b[i].src, b[i].size) != 0) return result::stale;
+				d += b[i].size;
+			}
+			out_offset = e.offset;
+			return result::hit;
+		}
+
+		// First sighting: remember the key only
+		void note(const vtx_block* b, uint32_t n, uint32_t total, uint64_t epoch)
+		{
+			if (!eligible(n, total)) return;
+			entry& e = m_entries[slot_of(b, n)];
+			set_key(e, b, n, total, epoch);
+			e.has_data = false;
+		}
+
+		// Second sighting / stale: takes the private copy and returns it. The caller writes the ring range at offset from
+		// this copy (not from guest memory again), so the ring provably holds the compared bytes.
+		const unsigned char* store(const vtx_block* b, uint32_t n, uint32_t total, uint64_t epoch, uint64_t offset)
+		{
+			if (!eligible(n, total)) return nullptr;
+			entry& e = m_entries[slot_of(b, n)];
+			set_key(e, b, n, total, epoch);
+			e.offset = offset;
+			e.data.resize(total);
+			unsigned char* d = e.data.data();
+			for (uint32_t i = 0; i < n; ++i)
+			{
+				std::memcpy(d, b[i].src, b[i].size);
+				d += b[i].size;
+			}
+			e.has_data = true;
+			return e.data.data();
+		}
+
+	private:
+		struct entry
+		{
+			vtx_block blocks[max_blocks]{};
+			uint32_t n = 0;
+			uint32_t total = 0;
+			uint64_t epoch = 0;
+			uint64_t offset = 0;
+			bool has_data = false;
+			std::vector<unsigned char> data;
+		};
+
+		static bool same_key(const entry& e, const vtx_block* b, uint32_t n, uint32_t total, uint64_t epoch)
+		{
+			if (e.epoch != epoch || e.n != n || e.total != total) return false;
+			for (uint32_t i = 0; i < n; ++i)
+			{
+				if (e.blocks[i].src != b[i].src || e.blocks[i].size != b[i].size) return false;
+			}
+			return true;
+		}
+
+		static void set_key(entry& e, const vtx_block* b, uint32_t n, uint32_t total, uint64_t epoch)
+		{
+			for (uint32_t i = 0; i < n; ++i) e.blocks[i] = b[i];
+			e.n = n;
+			e.total = total;
+			e.epoch = epoch;
+		}
+
+		entry m_entries[ways];
+	};
+}
diff --git a/rpcs3/Emu/RSX/port_r2pipe.h b/rpcs3/Emu/RSX/port_r2pipe.h
new file mode 100644
index 0000000..c18f7b8
--- /dev/null
+++ b/rpcs3/Emu/RSX/port_r2pipe.h
@@ -0,0 +1,487 @@
+#pragma once
+
+// R2PORT pipeline-stutter work (pure logic, unit tested offline in scratch\enginetest via
+// ps3recomp\libs\video\tests\test_r2pipe.cpp):
+//  - [pipe] stall statistics: per-frame time spent waiting on pipeline creation on the render thread, a histogram
+//    of the stalls longer than 2 ms, and a 5 s reporting window (R2_PIPE_LOG);
+//  - byte keys + FNV-1a hashing for the VK_EXT_graphics_pipeline_library part caches (R2_VK_GPL);
+//  - first-use ordering and boot/background split of the start-up shader preload (R2_PRELOAD_ASYNC, R2_PRELOAD_BOOT);
+//  - preload safety: MSAA entry filter, background thread count, crash breadcrumb format (issue #10);
+//  - a two-level job queue (urgent jobs before background optimise jobs) used by the pipeline compiler threads.
+
+#include <algorithm>
+#include <cstddef>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <deque>
+#include <string>
+#include <type_traits>
+#include <vector>
+
+namespace r2pipe
+{
+	// ---- switches -------------------------------------------------------------------------------------------------
+
+	inline long env_int(const char* name, long def)
+	{
+		const char* v = std::getenv(name);
+		if (!v || !v[0]) return def;
+		char* end = nullptr;
+		const long r = std::strtol(v, &end, 10);
+		return end == v ? def : r;
+	}
+
+	// R2_FOSSILIZE: unset/"auto" = replay a shipped database when it exists, "record" = record + replay,
+	// "replay" = always replay (even over a seeded driver cache), "0"/"off" = disabled
+	enum class foz_mode { off, auto_replay, replay, record };
+
+	inline foz_mode parse_foz_mode(const char* v)
+	{
+		if (!v || !v[0]) return foz_mode::auto_replay;
+		std::string s(v);
+		for (auto& c : s) c = static_cast<char>((c >= 'A' && c <= 'Z') ? c - 'A' + 'a' : c);
+		if (s == "0" || s == "off" || s == "false" || s == "no") return foz_mode::off;
+		if (s == "record" || s == "rec" || s == "2") return foz_mode::record;
+		if (s == "replay" || s == "1" || s == "on") return foz_mode::replay;
+		return foz_mode::auto_replay;
+	}
+
+	// ---- [pipe] statistics ----------------------------------------------------------------------------------------
+
+	// Stall histogram buckets (milliseconds): 2-4, 4-8, 8-16, 16-33, >=33. Stalls below 2 ms only count towards
+	// the total time.
+	constexpr int stall_buckets = 5;
+
+	inline int stall_bucket(double ms)
+	{
+		if (ms < 2.0) return -1;
+		if (ms < 4.0) return 0;
+		if (ms < 8.0) return 1;
+		if (ms < 16.0) return 2;
+		if (ms < 33.0) return 3;
+		return 4;
+	}
+
+	struct stall_window
+	{
+		uint64_t frames = 0;
+		uint64_t stalls = 0;             // pipeline waits (any length)
+		double total_ms = 0.0;           // total render-thread time waiting on pipeline creation
+		double worst_frame_ms = 0.0;     // largest per-frame sum
+		double worst_stall_ms = 0.0;     // longest single wait
+		uint64_t frames_with_stall = 0;  // frames with >= 2 ms of pipeline waits
+		uint64_t hist[stall_buckets] = {};
+
+		double cur_frame_ms = 0.0;
+
+		void add_stall(double ms)
+		{
+			if (ms < 0.0) ms = 0.0;
+			stalls++;
+			total_ms += ms;
+			cur_frame_ms += ms;
+			worst_stall_ms = std::max(worst_stall_ms, ms);
+			const int b = stall_bucket(ms);
+			if (b >= 0) hist[b]++;
+		}
+
+		void end_frame()
+		{
+			frames++;
+			worst_frame_ms = std::max(worst_frame_ms, cur_frame_ms);
+			if (cur_frame_ms >= 2.0) frames_with_stall++;
+			cur_frame_ms = 0.0;
+		}
+
+		double per_frame_ms() const { return frames ? total_ms / static_cast<double>(frames) : 0.0; }
+
+		// Starts a new window; the stall time of an unfinished frame carries over.
+		void reset()
+		{
+			const double carry = cur_frame_ms;
+			*this = {};
+			cur_frame_ms = carry;
+		}
+	};
+
+	// Fires every `period_ns` (first call only arms the timer).
+	struct report_timer
+	{
+		uint64_t period_ns = 5'000'000'000ull;
+		uint64_t last_ns = 0;
+
+		bool due(uint64_t now_ns)
+		{
+			if (!last_ns) { last_ns = now_ns; return false; }
+			if (now_ns - last_ns < period_ns) return false;
+			last_ns = now_ns;
+			return true;
+		}
+	};
+
+	// ---- part-cache keys ------------------------------------------------------------------------------------------
+
+	inline uint64_t fnv1a64(const void* data, size_t size, uint64_t h = 0xcbf29ce484222325ull)
+	{
+		const auto* p = static_cast<const uint8_t*>(data);
+		for (size_t i = 0; i < size; ++i) { h ^= p[i]; h *= 0x100000001b3ull; }
+		return h;
+	}
+
+	// Exact byte key: equality compares all bytes, the hash only picks the bucket. Two library parts are shared only
+	// when every byte of the state that goes into them is identical, so a cached part is always the part the
+	// monolithic path would have been built from.
+	struct byte_key
+	{
+		std::vector<uint8_t> bytes;
+
+		template <typename T>
+		byte_key& add(const T& v)
+		{
+			static_assert(std::is_trivially_copyable_v<T>);
+			const auto* p = reinterpret_cast<const uint8_t*>(&v);
+			bytes.insert(bytes.end(), p, p + sizeof(T));
+			return *this;
+		}
+
+		byte_key& add_bytes(const void* data, size_t size)
+		{
+			add(static_cast<uint64_t>(size)); // length-prefixed: no ambiguity between adjacent variable parts
+			const auto* p = static_cast<const uint8_t*>(data);
+			if (size) bytes.insert(bytes.end(), p, p + size);
+			return *this;
+		}
+
+		uint64_t hash() const { return fnv1a64(bytes.data(), bytes.size()); }
+		bool operator==(const byte_key& o) const { return bytes == o.bytes; }
+	};
+
+	struct byte_key_hash
+	{
+		size_t operator()(const byte_key& k) const { return static_cast<size_t>(k.hash()); }
+	};
+
+	// ---- preload ordering -----------------------------------------------------------------------------------------
+
+	// The renderer writes a pipeline's cache entry when the game first links it, so the file time is (close to)
+	// the first-use order of the pipeline. Oldest entries are what the game draws first: they form the blocking
+	// boot set, the rest is compiled in the background in the same order. Ties keep their directory order.
+	inline std::vector<size_t> first_use_order(const std::vector<int64_t>& mtimes)
+	{
+		std::vector<size_t> order(mtimes.size());
+		for (size_t i = 0; i < order.size(); ++i) order[i] = i;
+		std::stable_sort(order.begin(), order.end(), [&](size_t a, size_t b) { return mtimes[a] < mtimes[b]; });
+		return order;
+	}
+
+	// Number of entries compiled before the first frame. boot < 0 = all (blocking preload), else min(boot, total).
+	inline size_t boot_count(size_t total, long boot)
+	{
+		if (boot < 0) return total;
+		return std::min(total, static_cast<size_t>(boot));
+	}
+
+	// PORT_SHADER_PRELOAD (default on, launcher "Compile shaders before playing"): R2_PRELOAD_BOOT when set wins,
+	// else on = every cached pipeline before the first frame (-1), off = none (0): pipelines are built on demand
+	// when the game first draws with them (issue #10: off used to link the first 384 and the rest in the background).
+	inline long preload_boot_default(bool shader_preload) { return shader_preload ? -1 : 0; }
+
+	// Whether start-up reads and links the cached pipelines at all. Off = PORT_SHADER_PRELOAD=0 without an explicit
+	// R2_PRELOAD_BOOT: no boot link, no background preload and no Fossilize replay (issue #10).
+	inline bool preload_enabled(bool shader_preload, bool boot_env_set) { return shader_preload || boot_env_set; }
+
+	// One pipeline creation at a time (render thread, compiler threads, background preload, Fossilize replay):
+	// PORT_PIPE_SERIAL=1/0, default on AMD (PCI vendor 0x1002; issue #10, driver faults with concurrent creates
+	// on the shared VkPipelineCache).
+	inline bool pipe_serialize(uint32_t vendor_id) { return env_int("PORT_PIPE_SERIAL", vendor_id == 0x1002 ? 1 : 0) != 0; }
+
+	// How the serialised creations share the driver (only while pipe_serialize). Background creations (the optimised
+	// pipelines swapped in after a GPL fast link, preload and Fossilize replay threads) wait while any other creation
+	// waits for its turn, and do not start until the render thread made no play-time pipeline for bg_quiet_ms
+	// (a burst of cache misses then fast-links without queuing behind 100-250 ms optimised compiles on AMD); after
+	// bg_max_defer_ms a background creation starts anyway once nothing else waits.
+	//  PORT_PIPE_SERIAL_PRIO=0: one plain lock for every creation (old rule, the render thread queues behind them)
+	//  PORT_PIPE_BG_QUIET_MS (default 1000, 0 = no quiet period), PORT_PIPE_BG_MAX_DEFER_MS (default 10000)
+	//  PORT_PIPE_SERIAL_MAX=N (default 1, [1, 16]): creations allowed at once (test only: >1 brings back the
+	//  concurrent creations AMD drivers crashed on)
+	struct serial_policy
+	{
+		bool prio = true;
+		int max_active = 1;
+		uint64_t quiet_ns = 1000ull * 1000000;
+		uint64_t max_defer_ns = 10000ull * 1000000;
+	};
+
+	inline serial_policy serial_policy_from_env()
+	{
+		serial_policy p;
+		p.prio = env_int("PORT_PIPE_SERIAL_PRIO", 1) != 0;
+		p.max_active = static_cast<int>(std::clamp<long>(env_int("PORT_PIPE_SERIAL_MAX", 1), 1, 16));
+		p.quiet_ns = static_cast<uint64_t>(std::clamp<long>(env_int("PORT_PIPE_BG_QUIET_MS", 1000), 0, 60000)) * 1000000ull;
+		p.max_defer_ns = static_cast<uint64_t>(std::clamp<long>(env_int("PORT_PIPE_BG_MAX_DEFER_MS", 10000), 0, 600000)) * 1000000ull;
+		return p;
+	}
+
+	// A foreground creation (render thread, draw-blocking compiler job, SDK context) may start
+	inline bool serial_fg_may_start(const serial_policy& p, int active)
+	{
+		return active < p.max_active;
+	}
+
+	// A background creation may start. last_fg_ns: when the render thread last finished a play-time creation (0 =
+	// never); since_ns: when this creation began waiting. 0 = start now, else the time (ns) to look again.
+	inline uint64_t serial_bg_wait_until(const serial_policy& p, int active, int fg_waiting, uint64_t now_ns, uint64_t last_fg_ns, uint64_t since_ns)
+	{
+		constexpr uint64_t blocked = ~0ull; // woken by a release
+		if (active >= p.max_active) return blocked;
+		if (!p.prio) return 0;
+		if (fg_waiting > 0) return blocked;
+		if (!p.quiet_ns || !last_fg_ns) return 0;
+		const uint64_t quiet_end = last_fg_ns + p.quiet_ns;
+		const uint64_t defer_end = since_ns + p.max_defer_ns;
+		if (now_ns >= quiet_end || now_ns >= defer_end) return 0;
+		return std::min(quiet_end, defer_end);
+	}
+
+	// Issue #16: a pipeline whose link faulted on a preload thread is dropped from the program cache (not kept as a
+	// failed entry whose draws are skipped all session), so the draw that needs it links it during play.
+	// PORT_PRELOAD_FAULT_RELINK=0: kept failed (old rule). Links outside the preload always stay failed.
+	inline bool preload_fault_relink(bool preload_link) { return preload_link && env_int("PORT_PRELOAD_FAULT_RELINK", 1) != 0; }
+
+	// Breadcrumb / quarantine name of a Fossilize replay pipeline ("foz_" + 16 hex digits of its hash)
+	inline std::string foz_entry_name(uint64_t hash)
+	{
+		char s[24];
+		std::snprintf(s, sizeof(s), "foz_%016llx", static_cast<unsigned long long>(hash));
+		return s;
+	}
+
+	// ---- driver pipeline cache file (R2_VK_PIPE_CACHE: shaders_cache\vk_pipeline_cache.bin) ------------------------
+
+	// File = the driver's vkGetPipelineCacheData blob + a 24-byte trailer: "R2PCACH1", u64 blob size, u64 FNV-1a of
+	// the blob. A bit flip or a short write is caught here instead of being handed to a driver that may not check.
+	// A file without the trailer (written before it existed) is used when its Vulkan header matches.
+	constexpr char pcache_magic[8] = { 'R', '2', 'P', 'C', 'A', 'C', 'H', '1' };
+	constexpr size_t pcache_trailer_bytes = 24;
+	constexpr size_t pcache_max_bytes = size_t(512) << 20;
+
+	inline std::vector<uint8_t> pcache_wrap(const uint8_t* blob, size_t size)
+	{
+		std::vector<uint8_t> out(blob, blob + size);
+		const uint64_t n = size, h = fnv1a64(blob, size);
+		out.insert(out.end(), pcache_magic, pcache_magic + 8);
+		out.insert(out.end(), reinterpret_cast<const uint8_t*>(&n), reinterpret_cast<const uint8_t*>(&n) + 8);
+		out.insert(out.end(), reinterpret_cast<const uint8_t*>(&h), reinterpret_cast<const uint8_t*>(&h) + 8);
+		return out;
+	}
+
+	// VkPipelineCacheHeaderVersionOne: header size >= 32, version 1, vendor, device, pipelineCacheUUID.
+	inline bool pcache_header_ok(const uint8_t* data, size_t size, uint32_t vendor, uint32_t device, const uint8_t uuid[16])
+	{
+		if (!data || size < 32) return false;
+		uint32_t h[4];
+		std::memcpy(h, data, sizeof(h));
+		return h[0] >= 32 && h[0] <= size && h[1] == 1 && h[2] == vendor && h[3] == device && std::memcmp(data + 16, uuid, 16) == 0;
+	}
+
+	enum class pcache_verdict { use, use_legacy, empty, too_large, corrupt, other_gpu, gpu_changed };
+
+	inline const char* pcache_verdict_text(pcache_verdict v)
+	{
+		switch (v)
+		{
+		case pcache_verdict::use: return "ok";
+		case pcache_verdict::use_legacy: return "ok (no checksum)";
+		case pcache_verdict::empty: return "empty";
+		case pcache_verdict::too_large: return "too large";
+		case pcache_verdict::corrupt: return "corrupt (checksum)";
+		case pcache_verdict::other_gpu: return "for another GPU/driver";
+		case pcache_verdict::gpu_changed: return "GPU or driver changed";
+		}
+		return "?";
+	}
+
+	// What start-up does with the file: use/use_legacy = seed the VkPipelineCache with the first *blob_size bytes;
+	// gpu_changed = delete it (r2_gpu_stamp.txt differs: the blob header alone does not always change on an update);
+	// anything else = start with an empty cache. stamp_old empty = no stamp yet (not a change).
+	inline pcache_verdict pcache_check(const uint8_t* data, size_t size, size_t& blob_size, uint32_t vendor, uint32_t device,
+		const uint8_t uuid[16], const std::string& stamp_old, const std::string& stamp_cur)
+	{
+		blob_size = 0;
+		if (!stamp_old.empty() && stamp_old != stamp_cur) return pcache_verdict::gpu_changed;
+		if (!data || !size) return pcache_verdict::empty;
+		if (size >= pcache_max_bytes) return pcache_verdict::too_large;
+		size_t n = size;
+		bool legacy = true;
+		if (size >= pcache_trailer_bytes && std::memcmp(data + size - pcache_trailer_bytes, pcache_magic, 8) == 0)
+		{
+			uint64_t want_n, want_h;
+			std::memcpy(&want_n, data + size - 16, 8);
+			std::memcpy(&want_h, data + size - 8, 8);
+			n = size - pcache_trailer_bytes;
+			if (want_n != n || fnv1a64(data, n) != want_h) return pcache_verdict::corrupt;
+			legacy = false;
+		}
+		if (!pcache_header_ok(data, n, vendor, device, uuid)) return pcache_verdict::other_gpu;
+		blob_size = n;
+		return legacy ? pcache_verdict::use_legacy : pcache_verdict::use;
+	}
+
+	// ---- preload safety (GitHub issue #10: AMD driver crash while a background thread linked an MSAA pipeline) -----
+
+	// A cache entry rendering at more than one sample can only be bound while MSAA is on (FSR 3.1 / DLAA and
+	// R2_MSAA=0 force it off). keep_all: PORT_PRELOAD_ALL_MSAA=1 preloads every entry as before.
+	inline bool preload_keep_samples(uint32_t samples, bool msaa_on, bool keep_all)
+	{
+		return keep_all || msaa_on || samples <= 1;
+	}
+
+	// A cache entry keeps the depth format of the GPU that recorded it in its render-pass key (VKRenderPass.cpp:
+	// bits 8-15, persisted, never moved). RSX z24s8 is D24_UNORM_S8 where the GPU can render to it, else
+	// D32_SFLOAT_S8 (AMD, force_high_precision_z_buffer; get_compatible_depth_surface_format). Fixes the key for
+	// this GPU: 0 = keep, 1 = remapped D24S8 -> D32S8, -1 = skip (a format this GPU cannot render to, or unknown).
+	inline int preload_fix_depth(uint64_t& renderpass_key, bool d24s8_ok, bool d32s8_ok)
+	{
+		constexpr uint64_t no_attachments = 1ull << 63;
+		constexpr uint32_t d16 = 124, d32f = 126, d24s8 = 129, d32s8 = 130; // VkFormat
+		if (renderpass_key & no_attachments) return 0;
+		const uint32_t depth = static_cast<uint32_t>((renderpass_key >> 8) & 0xff);
+		switch (depth)
+		{
+		case 0:
+		case d16:
+		case d32f:
+			return 0;
+		case d24s8:
+			if (d24s8_ok) return 0;
+			if (!d32s8_ok) return -1;
+			renderpass_key = (renderpass_key & ~(0xffull << 8)) | (static_cast<uint64_t>(d32s8) << 8);
+			return 1;
+		case d32s8:
+			return d32s8_ok ? 0 : -1;
+		default:
+			return -1;
+		}
+	}
+
+	// Background preload threads: PORT_PRELOAD_THREADS, else R2_PRELOAD_THREADS, else 1 on AMD (PCI vendor 0x1002,
+	// a single compile thread rules out driver races on the shared VkPipelineCache), else hw/4 in [1, 4]. [1, 16].
+	inline uint32_t preload_bg_threads(uint32_t hw, uint32_t vendor_id)
+	{
+		const long def = vendor_id == 0x1002 ? 1 : std::clamp<long>(static_cast<long>(hw / 4), 1, 4);
+		const long n = env_int("PORT_PRELOAD_THREADS", env_int("R2_PRELOAD_THREADS", def));
+		return static_cast<uint32_t>(std::clamp<long>(n, 1, 16));
+	}
+
+	// PORT_CPU_PROFILE=low (launcher: low-end CPU)
+	inline bool cpu_profile_low()
+	{
+		const char* v = std::getenv("PORT_CPU_PROFILE");
+		return v && std::strcmp(v, "low") == 0;
+	}
+
+	// Blocking boot preload workers (cache read, SPIR-V, link): PORT_PRELOAD_BOOT_THREADS, else R2_PRELOAD_BOOT_THREADS,
+	// else 2 on AMD (issue #10/#23: the RX 6000 driver crashed late in an all-cores boot compile; its links are
+	// serialised anyway, PORT_PRELOAD_BOOT_AMD=0 keeps all cores), 2 on <= 8 logical cores or PORT_CPU_PROFILE=low
+	// (the game's own boot threads were starved on a 4c/8t CPU), else all logical cores but one. [1, 64].
+	inline uint32_t preload_boot_workers(uint32_t hw, uint32_t vendor_id, bool low_cpu)
+	{
+		hw = std::max<uint32_t>(hw, 1);
+		const bool amd = vendor_id == 0x1002 && env_int("PORT_PRELOAD_BOOT_AMD", 1) != 0;
+		const long def = (amd || low_cpu || hw <= 8) ? static_cast<long>(std::min<uint32_t>(2, hw)) : static_cast<long>(hw - 1);
+		const long n = env_int("PORT_PRELOAD_BOOT_THREADS", env_int("R2_PRELOAD_BOOT_THREADS", def));
+		return static_cast<uint32_t>(std::clamp<long>(n, 1, 64));
+	}
+
+	// Breadcrumb file (logs\preload_inflight.txt, memory-mapped so it survives a crash): one fixed-size line per
+	// preload thread, "tid <thread id> <pipeline file name>" while that thread links the pipeline, blank otherwise.
+	// The crash reporter (port_crash.h) names the faulting thread's entry as "preload faulting: <name>".
+	constexpr size_t inflight_slot_bytes = 128;
+	constexpr size_t inflight_slots = 64;
+
+	inline void inflight_format(char* slot, unsigned long tid, const char* key)
+	{
+		std::memset(slot, ' ', inflight_slot_bytes - 1);
+		slot[inflight_slot_bytes - 1] = '\n';
+		if (!key || !key[0]) return;
+		char tmp[inflight_slot_bytes];
+		const int n = std::snprintf(tmp, sizeof(tmp), "tid %lu %s", tid, key);
+		if (n > 0) std::memcpy(slot, tmp, std::min<size_t>(static_cast<size_t>(n), inflight_slot_bytes - 1));
+	}
+
+	struct inflight_entry
+	{
+		unsigned long tid;
+		std::string key;
+	};
+
+	inline std::vector<inflight_entry> inflight_parse(const std::string& text)
+	{
+		std::vector<inflight_entry> out;
+		size_t pos = 0;
+		while (pos < text.size())
+		{
+			size_t eol = text.find('\n', pos);
+			if (eol == std::string::npos) eol = text.size();
+			const std::string line = text.substr(pos, eol - pos);
+			pos = eol + 1;
+			if (line.compare(0, 4, "tid ") != 0) continue;
+			char* end = nullptr;
+			const unsigned long tid = std::strtoul(line.c_str() + 4, &end, 10);
+			if (!end || *end != ' ') continue;
+			std::string key(end + 1);
+			while (!key.empty() && (key.back() == ' ' || key.back() == '\r' || key.back() == '\0')) key.pop_back();
+			if (!key.empty()) out.push_back({ tid, std::move(key) });
+		}
+		return out;
+	}
+
+	// A breadcrumb stage label ("rt:<what>": a pipeline built outside the preload), not a cache entry: never quarantined
+	inline bool inflight_is_stage(const std::string& key)
+	{
+		return key.compare(0, 3, "rt:") == 0;
+	}
+
+	// The pipeline a crash report names as linked by the faulting thread ("preload faulting: <name>"), else empty.
+	inline std::string crash_preload_key(const std::string& report)
+	{
+		static const char tag[] = "preload faulting: ";
+		const size_t at = report.find(tag);
+		if (at == std::string::npos || (at && report[at - 1] != '\n')) return {};
+		const size_t b = at + sizeof(tag) - 1;
+		size_t e = b;
+		while (e < report.size() && report[e] != '\n' && report[e] != '\r' && report[e] != ' ') ++e;
+		return report.substr(b, e - b);
+	}
+
+	// ---- two-level job queue --------------------------------------------------------------------------------------
+
+	// Urgent jobs (pipelines a draw is waiting for) always run before background jobs (optimised monolithic
+	// pipelines, background preload). Not thread-safe; the owner locks.
+	template <typename T>
+	struct two_level_queue
+	{
+		std::deque<T> urgent;
+		std::deque<T> background;
+
+		void push(T v, bool is_background)
+		{
+			(is_background ? background : urgent).push_back(std::move(v));
+		}
+
+		bool pop(T& out)
+		{
+			auto& q = !urgent.empty() ? urgent : background;
+			if (q.empty()) return false;
+			out = std::move(q.front());
+			q.pop_front();
+			return true;
+		}
+
+		size_t size() const { return urgent.size() + background.size(); }
+		bool empty() const { return urgent.empty() && background.empty(); }
+		void clear() { urgent.clear(); background.clear(); }
+	};
+}
diff --git a/rpcs3/Emu/RSX/port_r2preload.h b/rpcs3/Emu/RSX/port_r2preload.h
new file mode 100644
index 0000000..44adbd4
--- /dev/null
+++ b/rpcs3/Emu/RSX/port_r2preload.h
@@ -0,0 +1,105 @@
+#pragma once
+
+// R2PORT (GitHub issue #10): crash safety of the start-up / background shader preload (VK/VKR2Preload.cpp).
+//  - breadcrumb: before a preload thread links a cached pipeline, its file name goes to that thread's line of
+//    logs\preload_inflight.txt (memory-mapped, so it survives a crash); port_crash.h puts it in the crash report;
+//  - quarantine (PORT_PRELOAD_QUARANTINE, default on): <shaders_cache>\preload_quarantine.txt lists entries the
+//    preload skips: a pipeline whose link faulted (SEH guard below), or the one a crash report names as linked by
+//    the faulting thread when the last run died while linking it; PORT_PRELOAD_BREADCRUMB=0 turns off the breadcrumb;
+//  - SEH guard (PORT_PRELOAD_SEH, default on, Windows): a fault inside vkCreate*Pipelines of the boot and
+//    background preload, the Fossilize replay and the game's own pipelines built during play (render thread and
+//    compiler threads) is caught, logged and the pipeline skipped (the draw that needs it is skipped); the preload
+//    and the replay then stop for the session. Issue #16: a pipeline that faulted on a preload thread is not kept
+//    as failed (PORT_PRELOAD_FAULT_RELINK, default on): its draw links it during play, guarded the same way;
+//  - AMD serialisation (PORT_PIPE_SERIAL, default on AMD): those pipeline creations run one at a time, and so do
+//    the upscaler / frame generation SDK context creations (stage_scope); background ones (background_scope,
+//    preload / replay threads) let the render thread's play-time creations go first (PORT_PIPE_SERIAL_PRIO);
+//  - stage breadcrumb (issue #23): pipelines built outside the preload (render / compiler threads, upscaler, SDK
+//    contexts) write an "rt:<what>" label to the same file; the crash report names it ("pipeline faulting: ...").
+//    The breadcrumb file is mapped at renderer start-up (configure), also when there is no shader cache yet.
+
+#include <cstdint>
+#include <string>
+
+namespace r2preload
+{
+	// shaders_cache::load(), before the entries are read: quarantine list, last run's breadcrumb, fresh breadcrumb
+	void init(const std::string& cache_root);
+
+	// Renderer start-up (before any preload/compile): GPU PCI vendor id, decides PORT_PIPE_SERIAL
+	void configure(uint32_t vendor_id);
+	bool serialized();
+	bool is_quarantined(const std::string& name);
+	unsigned quarantine_count();
+
+	// RAII: the calling preload thread links <name> (breadcrumb while alive; guard: SEH guard, background threads).
+	// Issue #23: also around the boot load step of each entry (guard false), so a crash there is named and quarantined.
+	struct link_scope
+	{
+		link_scope(const std::string& name, bool guard);
+		~link_scope();
+		link_scope(const link_scope&) = delete;
+		link_scope& operator=(const link_scope&) = delete;
+	};
+
+	// RAII: the calling thread builds one of the game's pipelines (render thread or compiler thread); program::link
+	// guards it like a preload link, without breadcrumb or quarantine (no cache entry name)
+	struct guard_scope
+	{
+		guard_scope();
+		~guard_scope();
+		guard_scope(const guard_scope&) = delete;
+		guard_scope& operator=(const guard_scope&) = delete;
+		bool prev;
+	};
+
+	// True inside a guarded link_scope / guard_scope with PORT_PRELOAD_SEH on (VKProgramPipeline.cpp)
+	bool guard_active();
+
+	// A guarded pipeline creation faulted this session: the preload and the Fossilize replay stop
+	bool faulted();
+
+	// Issue #16: true on a preload thread (inside a link_scope) with PORT_PRELOAD_FAULT_RELINK on (default). A
+	// pipeline whose preload link failed is then dropped from the program cache instead of kept as a failed entry,
+	// so the draw that needs it links it during play (guarded there too) rather than being skipped all session.
+	bool relink_after_preload_fault();
+
+	// *result = fn(ctx) under the SEH guard. False when it faulted: logged, current entry quarantined, faulted() set
+	bool guarded_call(long (*fn)(void*), void* ctx, long* result);
+
+	// A vkCreate*Pipelines call: serialised when serialized(), SEH-guarded when guard (and PORT_PRELOAD_SEH on).
+	// stage: "rt:<what>" label (no spaces) the breadcrumb shows while the call runs outside a preload link_scope
+	// (render / compiler / upscaler threads), so a crash report names the pipeline kind being built.
+	// False when it faulted (see guarded_call).
+	bool driver_call(long (*fn)(void*), void* ctx, long* result, bool guard, const char* stage = nullptr);
+
+	// RAII (issue #10/#23): a driver call that builds pipelines internally (upscaler / frame generation SDK context
+	// creation). Serialised with the pipeline creations when serialized() (PORT_PIPE_SERIAL_SDK=0: not serialised);
+	// the breadcrumb names <stage> ("rt:<what>", no spaces) while it runs. driver_call inside it does not re-lock.
+	struct stage_scope
+	{
+		explicit stage_scope(const char* stage);
+		~stage_scope();
+		stage_scope(const stage_scope&) = delete;
+		stage_scope& operator=(const stage_scope&) = delete;
+		const char* prev_stage;
+		bool locked;
+	};
+
+	// RAII: pipeline creations of this thread are background work (the optimised pipeline built after a GPL fast
+	// link). While serialized() they yield to play-time creations (port_r2pipe.h serial_policy; preload and
+	// Fossilize link_scope threads count as background too). PORT_PIPE_SERIAL_PRIO=0: no difference.
+	struct background_scope
+	{
+		background_scope();
+		~background_scope();
+		background_scope(const background_scope&) = delete;
+		background_scope& operator=(const background_scope&) = delete;
+	};
+
+	// Microseconds a compiler thread should hold back its next background (optimised) pipeline: the rest of the
+	// quiet period after the render thread's last play-time creation; 0 = go (also when not serialized(), with
+	// PORT_PIPE_SERIAL_PRIO=0, or once it waited PORT_PIPE_BG_MAX_DEFER_MS since waiting_since_us).
+	uint64_t background_hold_us(uint64_t waiting_since_us);
+	uint64_t now_us(); // steady clock, for waiting_since_us
+}
diff --git a/rpcs3/Emu/RSX/port_rbattr.h b/rpcs3/Emu/RSX/port_rbattr.h
new file mode 100644
index 0000000..deb2c09
--- /dev/null
+++ b/rpcs3/Emu/RSX/port_rbattr.h
@@ -0,0 +1,303 @@
+#pragma once
+
+// R3PORT: RSX readback attribution and the texture-miss readback avoidance (shared by the R2 and R3 ports).
+//
+// RSX_RB_ATTRIB (default 1): every surface readback (imp_flush) is recorded with the operation that caused it (texture miss,
+//   blit, present, CPU/SPU access fault, other) and the time that operation spent while it flushed (GPU submit + wait +
+//   copy). Every 5 s: "[rb-attr]" with the cost per cause and the top surfaces (base, size, format, count, MB, wait).
+// RSX_RT_GPU_REINTERPRET (default 1): a texture that misses the cache and overlaps render targets (e.g. an FP16 surface
+//   sampled as ARGB8) is normally built by reading those surfaces back to guest memory (GPU copy, submit, wait) and
+//   uploading guest memory. Instead the texture is built on the GPU: guest bytes of the span, overlaid with the bytes
+//   each surface's readback would write (the same DMA copy the flush would have used), uploaded through the same path.
+//   Bit-identical; the surfaces stay locked (a later CPU read still flushes them). Only for linear 2D A8R8G8B8, D8R8G8B8
+//   and B8 textures outside tiled memory; anything else uses the readback (the first 24 such textures are logged as
+//   "[rt-reint] readback texture ..." with the reason).
+// RSX_RT_NARROW_READ (default 1): when no surface overlapping the texture's own bytes has data to write back, the CPU
+//   upload skips the page-granular read invalidation, which would otherwise flush surfaces that merely share a page with
+//   the texture (R3: two 960x704 B8 surfaces 0xA5000 apart, the second starting mid-page). Those stay locked. The new
+//   texture section is then locked read-only over whole pages, which would downgrade a shared page of a no-access
+//   section to read-only while its protection field still says "no" (a later CPU read would see stale guest memory and
+//   its next protect(no) would early-return). So every locked no-access section on the texture's pages is re-protected
+//   with protect(no, force) after the upload: ro/no mprotects go through rsx::mm_protect's deferred FIFO queue, so the
+//   no-access entries are applied after the texture's read-only one ("narrow reprotect" in the report).
+//   Those pages stay no-access while the texture is decoded, so the decode reads through the unprotected sudo view
+//   (to_sudo): a fault on the RSX thread there would deadlock (the fault handler's invalidate_address takes the texture
+//   cache lock the upload already holds; seen as a hang at level load in adsperf8).
+// RSX_AV_NEIGHBOUR_SKIP (default 1): a CPU/SPU access fault whose faulting byte lies outside every surface on that page (it
+//   only shares the page with a surface's first or last bytes; R3: SPU job 422 data and RSX vertex reads at 0xC25A8800,
+//   right after the 480x352 surface 0xC2503800..0xC25A87FF) does not read the surface back (GPU submit + wait, 3-15 ms).
+//   The surface is released like one about to be overwritten (dirty, unprotected) and re-locked at its next use as a
+//   render target. Cost: a CPU read of that surface's own bytes before then sees its older guest copy instead of
+//   flushing (none was seen in the R3 ADS logs). Never for 0x30030000..0x304B0000. "av neighbour skips" in the report.
+// RSX_AV_NEIGHBOUR_SMALL_FLUSH (default 1; 0 = skip those too): surfaces of at most 64x64 pixels are still written back
+//   by such a fault. R3 packs its 16x16 bullet-rubble render targets at 0x80 granularity into a ring (0xC38A....) that it
+//   also fills with CPU data (rsx::thread memcpy); a skip there lost the targets' GPU data, and the chunk textures later
+//   sampled across them read stale index/vertex bytes (round 14: purple / rainbow / checker chunks). The other surfaces
+//   of the fault are still skipped. "small ones written back" in the report (each costs a GPU sync while shooting).
+// RSX_RT_GPU_REINTERPRET_CHECK (default 8): the first N such textures also run the readback and compare the bytes the
+//   texture reads (logs "[rt-reint] check"); the readback result is used for those. So are the first 4 builds that
+//   recopy a surface already copied for an earlier build (a bound surface drawn to since).
+// RSX_RT_GPU_REINTERPRET_CHECK_EVERY (default 600, 0 = off): after those, also 1 in N builds.
+// RSX_ADS_RSX_LATE (default 1): for small (<= 256 KB) colour textures the reinterpret does not cover, whose readback would
+//   wait for the GPU, every other frame the texture built from the previous frame's readback is used instead (never two
+//   frames in a row, never for 0x30030000..0x304B0000, the light buffer / ADS blur region).
+
+#include <algorithm>
+#include <atomic>
+#include <chrono>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <mutex>
+
+// cellGcmSys.c: the ioAddress the game gave cellGcmInit (0x30000000, or 0x40000000 without PS3_MAPPER_BASE)
+extern "C" uint32_t g_gcm_io_base;
+
+namespace rbattr
+{
+	// R3's FP16 aim-DOF light buffer: IO offset 0x30000 (tile 4), 0x480000 bytes (0x30030000..0x304AFFFF at the usual base)
+	inline uint32_t r3_dof_ea() { return g_gcm_io_base + 0x30000u; }
+	inline uint32_t r3_dof_end() { return r3_dof_ea() + 0x480000u; } // exclusive
+
+	// Guest pointer through the protected view (base) -> the same byte through the unprotected view (sudo).
+	// Anything outside the 4 GB guest view is returned unchanged.
+	inline const void* to_sudo(const void* p, const uint8_t* base, const uint8_t* sudo)
+	{
+		const uint8_t* b = static_cast<const uint8_t*>(p);
+		if (!b || !base || !sudo || b < base || static_cast<uint64_t>(b - base) >= 0x100000000ull)
+		{
+			return p;
+		}
+		return sudo + (b - base);
+	}
+
+	enum cause : uint8_t { c_other = 0, c_texmiss, c_blit, c_present, c_av, c_count };
+
+	inline const char* cause_name(uint8_t c)
+	{
+		static const char* const n[c_count] = { "other", "tex-miss", "blit", "present", "av-fault" };
+		return c < c_count ? n[c] : "?";
+	}
+
+	inline bool env_on(const char* name, bool def)
+	{
+		const char* v = std::getenv(name);
+		if (!v || !v[0]) return def;
+		char w[8] = {};
+		for (size_t i = 0; i + 1 < sizeof w && v[i]; i++) w[i] = static_cast<char>((v[i] >= 'A' && v[i] <= 'Z') ? v[i] + 32 : v[i]);
+		return !(v[0] == '0' || !std::strcmp(w, "off") || !std::strcmp(w, "false") || !std::strcmp(w, "no"));
+	}
+
+	inline long env_int(const char* name, long def)
+	{
+		const char* v = std::getenv(name);
+		return (v && v[0]) ? std::strtol(v, nullptr, 10) : def;
+	}
+
+	struct config
+	{
+		bool attrib = true;
+		bool reint = true;
+		long check = 8;
+		long check_every = 600;
+		bool late = true;
+		bool narrow = true;
+		bool neighbour = true;
+		bool neighbour_small_flush = true;
+	};
+
+	inline const config& cfg()
+	{
+		static const config c = []
+		{
+			config r;
+			r.attrib = env_on("RSX_RB_ATTRIB", true);
+			r.reint = env_on("RSX_RT_GPU_REINTERPRET", true);
+			r.check = r.reint ? std::max(0L, env_int("RSX_RT_GPU_REINTERPRET_CHECK", 8)) : 0;
+			r.check_every = r.reint ? std::max(0L, env_int("RSX_RT_GPU_REINTERPRET_CHECK_EVERY", 600)) : 0;
+			r.late = env_on("RSX_ADS_RSX_LATE", true);
+			r.narrow = env_on("RSX_RT_NARROW_READ", true);
+			r.neighbour = env_on("RSX_AV_NEIGHBOUR_SKIP", true);
+			r.neighbour_small_flush = env_on("RSX_AV_NEIGHBOUR_SMALL_FLUSH", true);
+			std::printf("[rb-attr] RSX_RB_ATTRIB=%d RSX_RT_GPU_REINTERPRET=%d RSX_RT_GPU_REINTERPRET_CHECK=%ld (every %ld) RSX_ADS_RSX_LATE=%d RSX_RT_NARROW_READ=%d RSX_AV_NEIGHBOUR_SKIP=%d RSX_AV_NEIGHBOUR_SMALL_FLUSH=%d\n",
+				r.attrib ? 1 : 0, r.reint ? 1 : 0, r.check, r.check_every, r.late ? 1 : 0, r.narrow ? 1 : 0, r.neighbour ? 1 : 0, r.neighbour_small_flush ? 1 : 0);
+			std::fflush(stdout);
+			return r;
+		}();
+		return c;
+	}
+
+	inline uint64_t now_ns()
+	{
+		return static_cast<uint64_t>(std::chrono::duration_cast<std::chrono::nanoseconds>(
+			std::chrono::steady_clock::now().time_since_epoch()).count());
+	}
+
+	// RSX_ADS_RSX_LATE never serves an older texture here
+	inline bool late_excluded(uint32_t start, uint32_t end_inclusive)
+	{
+		return start < r3_dof_end() && end_inclusive >= r3_dof_ea();
+	}
+
+	inline thread_local uint8_t t_cause = c_other;
+	inline thread_local uint32_t t_flushes = 0;
+
+	class stats
+	{
+		struct entry
+		{
+			uint32_t addr, w, h, fmt;
+			uint8_t cause, ctx;
+			uint64_t n, bytes, wait_ns;
+		};
+		static constexpr int max_entries = 24;
+
+		std::mutex m_mutex;
+		entry m_e[max_entries]{};
+		int m_n = 0;
+		uint64_t m_cause_n[c_count]{}, m_cause_ns[c_count]{}, m_cause_flushes[c_count]{};
+		uint64_t m_last_ns = 0;
+		uint32_t m_logged[24][4]{};
+		int m_logged_n = 0;
+
+	public:
+		// RSX_RT_GPU_REINTERPRET / RSX_ADS_RSX_LATE counters
+		std::atomic<uint64_t> reint{ 0 }, reint_reuse{ 0 }, reint_sections{ 0 }, reint_copies{ 0 }, reint_bytes{ 0 }, reint_ns{ 0 };
+		std::atomic<uint64_t> reint_skip_fmt{ 0 }, reint_skip_section{ 0 }, reint_skip_backend{ 0 };
+		std::atomic<uint64_t> check_ok{ 0 }, check_bad{ 0 };
+		std::atomic<uint64_t> late_served{ 0 }, late_fresh{ 0 }, late_skip{ 0 };
+		std::atomic<uint64_t> narrow_skip{ 0 }, narrow_reprotect{ 0 }, noovl{ 0 };
+		std::atomic<uint64_t> av_neighbour{ 0 }, av_neighbour_sections{ 0 }, av_neighbour_small{ 0 };
+
+		// The first textures (distinct address/size/format) whose CPU upload still read surfaces back, and why
+		void log_readback_tex(const char* why, uint32_t addr, uint32_t w, uint32_t h, uint32_t pitch, uint32_t fmt, bool swz,
+			uint32_t span, uint32_t flushes)
+		{
+			static constexpr int max_logged = 24;
+			std::lock_guard lock(m_mutex);
+			for (int i = 0; i < m_logged_n; i++)
+			{
+				const auto& k = m_logged[i];
+				if (k[0] == addr && k[1] == w && k[2] == h && k[3] == fmt) return;
+			}
+			if (m_logged_n >= max_logged) return;
+			uint32_t* k = m_logged[m_logged_n++];
+			k[0] = addr; k[1] = w; k[2] = h; k[3] = fmt;
+			std::printf("[rt-reint] readback texture 0x%08X %ux%u pitch %u fmt 0x%X%s span 0x%X: %u surface flush(es), %s\n",
+				addr, w, h, pitch, fmt, swz ? " swizzled" : "", span, flushes, why);
+			std::fflush(stdout);
+		}
+
+		void on_flush(uint32_t addr, uint32_t w, uint32_t h, uint32_t fmt, uint8_t ctx, uint64_t bytes, uint64_t wait_ns)
+		{
+			t_flushes++;
+			std::lock_guard lock(m_mutex);
+			const uint8_t c = t_cause;
+			entry* e = nullptr;
+			for (int i = 0; i < m_n; i++)
+			{
+				if (m_e[i].addr == addr && m_e[i].w == w && m_e[i].h == h && m_e[i].fmt == fmt && m_e[i].cause == c) { e = &m_e[i]; break; }
+			}
+			if (!e)
+			{
+				if (m_n < max_entries) e = &m_e[m_n++];
+				else
+				{
+					e = &m_e[0];
+					for (int i = 1; i < m_n; i++) if (m_e[i].wait_ns < e->wait_ns) e = &m_e[i];
+				}
+				*e = { addr, w, h, fmt, c, ctx, 0, 0, 0 };
+			}
+			e->n++;
+			e->bytes += bytes;
+			e->wait_ns += wait_ns;
+			m_cause_flushes[c]++;
+		}
+
+		void on_scope(uint8_t c, uint64_t ns)
+		{
+			std::lock_guard lock(m_mutex);
+			m_cause_n[c]++;
+			m_cause_ns[c] += ns;
+		}
+
+		void maybe_report(uint64_t now)
+		{
+			char buf[2048];
+			{
+				std::lock_guard lock(m_mutex);
+				if (!m_last_ns) { m_last_ns = now; return; }
+				if (now - m_last_ns < 5'000'000'000ull) return;
+				const double secs = double(now - m_last_ns) / 1e9;
+				m_last_ns = now;
+
+				size_t len = static_cast<size_t>(std::snprintf(buf, sizeof buf, "[rb-attr] %.1fs: stall by cause", secs));
+				for (int c = 0; c < c_count; c++)
+				{
+					if (!m_cause_n[c] && !m_cause_flushes[c]) continue;
+					len += std::snprintf(buf + len, sizeof buf - len, " %s %llux %.1f ms (%llu flushes)", cause_name(static_cast<uint8_t>(c)),
+						(unsigned long long)m_cause_n[c], double(m_cause_ns[c]) / 1e6, (unsigned long long)m_cause_flushes[c]);
+					if (len >= sizeof buf) break;
+				}
+				std::sort(m_e, m_e + m_n, [](const entry& a, const entry& b) { return a.wait_ns > b.wait_ns; });
+				for (int i = 0; i < std::min(m_n, 5) && len < sizeof buf; i++)
+				{
+					const entry& e = m_e[i];
+					len += std::snprintf(buf + len, sizeof buf - len, " | %s 0x%08X %ux%u fmt 0x%X ctx %u: %llux %.2f MB wait %.2f ms",
+						cause_name(e.cause), e.addr, e.w, e.h, e.fmt, e.ctx, (unsigned long long)e.n, double(e.bytes) / 1048576.0, double(e.wait_ns) / 1e6);
+				}
+				m_n = 0;
+				std::memset(m_cause_n, 0, sizeof m_cause_n);
+				std::memset(m_cause_ns, 0, sizeof m_cause_ns);
+				std::memset(m_cause_flushes, 0, sizeof m_cause_flushes);
+				if (len < sizeof buf)
+				{
+					std::snprintf(buf + len, sizeof buf - len,
+						" || reint %llu built %llu reused (%llu surfaces, %llu copies, %.2f MB, record %.2f ms) skipped fmt %llu surface %llu backend %llu, check ok %llu bad %llu"
+						" | late served %llu fresh %llu skipped %llu | narrow read %llu (reprotect %llu), page-neighbour flushes %llu | av neighbour skips %llu (%llu surfaces, %llu small ones written back)",
+						(unsigned long long)reint.exchange(0), (unsigned long long)reint_reuse.exchange(0), (unsigned long long)reint_sections.exchange(0), (unsigned long long)reint_copies.exchange(0),
+						double(reint_bytes.exchange(0)) / 1048576.0, double(reint_ns.exchange(0)) / 1e6,
+						(unsigned long long)reint_skip_fmt.exchange(0), (unsigned long long)reint_skip_section.exchange(0), (unsigned long long)reint_skip_backend.exchange(0),
+						(unsigned long long)check_ok.exchange(0), (unsigned long long)check_bad.exchange(0),
+						(unsigned long long)late_served.exchange(0), (unsigned long long)late_fresh.exchange(0), (unsigned long long)late_skip.exchange(0),
+						(unsigned long long)narrow_skip.exchange(0), (unsigned long long)narrow_reprotect.exchange(0), (unsigned long long)noovl.exchange(0),
+						(unsigned long long)av_neighbour.exchange(0), (unsigned long long)av_neighbour_sections.exchange(0),
+						(unsigned long long)av_neighbour_small.exchange(0));
+				}
+			}
+			std::printf("%s\n", buf);
+			std::fflush(stdout);
+		}
+	};
+
+	inline stats& st() { static stats s; return s; }
+
+	// Tags the readbacks done inside it with a cause and accounts the scope's time to that cause when it flushed anything
+	struct scope
+	{
+		uint8_t prev;
+		uint32_t f0;
+		uint64_t t0;
+
+		explicit scope(uint8_t c) : prev(t_cause), f0(t_flushes), t0(cfg().attrib ? now_ns() : 0)
+		{
+			t_cause = c;
+		}
+
+		~scope()
+		{
+			const uint8_t c = t_cause;
+			t_cause = prev;
+			if (t0 && t_flushes != f0)
+			{
+				const uint64_t t1 = now_ns();
+				st().on_scope(c, t1 - t0);
+				st().maybe_report(t1);
+			}
+		}
+
+		scope(const scope&) = delete;
+		scope& operator=(const scope&) = delete;
+	};
+}
diff --git a/rpcs3/Emu/RSX/port_texdiag.h b/rpcs3/Emu/RSX/port_texdiag.h
new file mode 100644
index 0000000..1adf867
--- /dev/null
+++ b/rpcs3/Emu/RSX/port_texdiag.h
@@ -0,0 +1,152 @@
+#pragma once
+// R2PORT: [texcache] diagnostic (RSX_TEXDIAG, default on; RSX_TEXDIAG=0 off). Cheap always-on counters for
+// texture uploads, re-uploads of the same address, sampler derivations and guest write faults on cached
+// texture memory, printed as one [texcache] line every 10 s (only when something happened). Hot paths do a
+// few relaxed atomic adds; the re-upload table is a 4096-slot direct-mapped atomic<u64> array. Answers
+// "is the texture cache serving low-mip / reduced copies" from a user log without a capture.
+#include <atomic>
+#include <chrono>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <thread>
+
+namespace r2texdiag
+{
+	enum : int
+	{
+		up_total = 0, up_shader_read, up_other,
+		dim_64, dim_256, dim_512, dim_1024, dim_big,       // max(w, h) buckets
+		mip_1, mip_4, mip_8, mip_many,                      // mip count buckets: 1, 2-4, 5-8, 9+
+		re_same, re_bigger, re_smaller,                     // re-upload at the same address: same / more / less detail
+		smp_derived, smp_mipped, smp_minlod, smp_posbias, smp_mips_dropped,
+		av_faults, av_handled, av_raced,                    // av_raced: unclaimed, but the page was already open again (a racing fault lifted it; retried)
+		search_calls, search_memo_hits,                     // RSX_TEX_SEARCH_MEMO: upload_texture lookups / memo answers
+		n_counters
+	};
+
+	inline std::atomic<uint64_t> g_c[n_counters]{};
+	inline std::atomic<uint64_t> g_slots[4096]{};
+
+	inline bool enabled()
+	{
+		static const bool on = [] { const char* e = std::getenv("RSX_TEXDIAG"); return !(e && *e == '0'); }();
+		return on;
+	}
+
+	inline void add(int c, uint64_t n = 1) { g_c[c].fetch_add(n, std::memory_order_relaxed); }
+
+	// slot word: addr (32) | max dimension (16) | mips (8) | valid (8)
+	inline uint64_t pack(uint32_t addr, uint32_t maxdim, uint32_t mips)
+	{
+		return (static_cast<uint64_t>(addr) << 32) | (static_cast<uint64_t>(maxdim & 0xffff) << 16) | ((mips & 0xff) << 8) | 1u;
+	}
+
+	inline int dim_bucket(uint32_t d) { return d <= 64 ? dim_64 : d <= 256 ? dim_256 : d <= 512 ? dim_512 : d <= 1024 ? dim_1024 : dim_big; }
+	inline int mip_bucket(uint32_t m) { return m <= 1 ? mip_1 : m <= 4 ? mip_4 : m <= 8 ? mip_8 : mip_many; }
+
+	// Re-upload classification against the previous word in the slot: -1 none (new / other address),
+	// else re_same / re_bigger / re_smaller ("bigger" = larger base level, or more mips at the same size)
+	inline int classify(uint64_t prev, uint64_t cur)
+	{
+		if (!(prev & 1) || (prev >> 32) != (cur >> 32)) return -1;
+		const uint32_t pd = static_cast<uint32_t>(prev >> 16) & 0xffff, cd = static_cast<uint32_t>(cur >> 16) & 0xffff;
+		const uint32_t pm = static_cast<uint32_t>(prev >> 8) & 0xff, cm = static_cast<uint32_t>(cur >> 8) & 0xff;
+		if (cd == pd && cm == pm) return re_same;
+		if (cd > pd || (cd == pd && cm > pm)) return re_bigger;
+		return re_smaller;
+	}
+
+	inline void on_upload(uint32_t addr, uint32_t w, uint32_t h, uint32_t mips, bool shader_read)
+	{
+		if (!enabled()) return;
+		add(up_total);
+		add(shader_read ? up_shader_read : up_other);
+		const uint32_t d = w > h ? w : h;
+		add(dim_bucket(d));
+		add(mip_bucket(mips));
+		const uint64_t cur = pack(addr, d, mips);
+		const uint32_t s = ((addr >> 8) ^ (addr >> 20)) & 4095u;
+		const int r = classify(g_slots[s].exchange(cur, std::memory_order_relaxed), cur);
+		if (r >= 0) add(r);
+	}
+
+	inline void on_sampler(float requested_mips, float actual_mips, float min_lod, float lod_bias)
+	{
+		if (!enabled()) return;
+		add(smp_derived);
+		if (actual_mips > 1.f) add(smp_mipped);
+		if (requested_mips > 1.f && actual_mips <= 1.f) add(smp_mips_dropped);
+		if (actual_mips > 1.f && min_lod > 0.f) add(smp_minlod);
+		if (actual_mips > 1.f && lod_bias > 0.25f) add(smp_posbias);
+	}
+
+	inline void on_search(bool memo_hit)
+	{
+		if (!enabled()) return;
+		add(search_calls);
+		if (memo_hit) add(search_memo_hits);
+	}
+
+	// Faults taken by the calling thread and the ticks its access-violation hook spent on them (PORT_HITCH_RSX_METH nv0039 split)
+	inline thread_local uint32_t tl_faults = 0;
+	inline thread_local uint64_t tl_fault_ticks = 0;
+
+	inline void on_fault(bool handled, bool raced = false)
+	{
+		if (!enabled()) return;
+		add(av_faults);
+		if (handled) add(av_handled);
+		else if (raced) add(av_raced);
+	}
+
+	// One line per call with the deltas since the previous call; false (nothing printed) when idle
+	inline bool report(uint64_t (&last)[n_counters], char* out, size_t cap)
+	{
+		uint64_t d[n_counters];
+		bool any = false;
+		for (int i = 0; i < n_counters; ++i)
+		{
+			const uint64_t v = g_c[i].load(std::memory_order_relaxed);
+			d[i] = v - last[i];
+			last[i] = v;
+			any |= d[i] != 0;
+		}
+		if (!any) return false;
+		std::snprintf(out, cap,
+			"[texcache] 10s: uploads %llu (shader-read %llu, other %llu; size <=64 %llu <=256 %llu <=512 %llu <=1024 %llu >1024 %llu; "
+			"mips 1:%llu 2-4:%llu 5-8:%llu 9+:%llu); re-uploads same %llu more-detail %llu LESS-detail %llu; "
+			"samplers %llu (mipped %llu, min_lod>0 %llu, bias>0.25 %llu, mips requested but 1 level %llu); faults %llu (handled %llu, raced %llu); "
+			"lookups %llu (search memo %llu)",
+			(unsigned long long)d[up_total], (unsigned long long)d[up_shader_read], (unsigned long long)d[up_other],
+			(unsigned long long)d[dim_64], (unsigned long long)d[dim_256], (unsigned long long)d[dim_512], (unsigned long long)d[dim_1024],
+			(unsigned long long)d[dim_big], (unsigned long long)d[mip_1], (unsigned long long)d[mip_4], (unsigned long long)d[mip_8],
+			(unsigned long long)d[mip_many], (unsigned long long)d[re_same], (unsigned long long)d[re_bigger], (unsigned long long)d[re_smaller],
+			(unsigned long long)d[smp_derived], (unsigned long long)d[smp_mipped], (unsigned long long)d[smp_minlod], (unsigned long long)d[smp_posbias],
+			(unsigned long long)d[smp_mips_dropped], (unsigned long long)d[av_faults], (unsigned long long)d[av_handled], (unsigned long long)d[av_raced],
+			(unsigned long long)d[search_calls], (unsigned long long)d[search_memo_hits]);
+		return true;
+	}
+
+	// Detached printer, started once by the bridge
+	inline void start_reporter()
+	{
+		if (!enabled()) return;
+		static std::atomic<bool> started{ false };
+		if (started.exchange(true)) return;
+		std::thread([]
+		{
+			uint64_t last[n_counters]{};
+			char line[1024];
+			for (;;)
+			{
+				std::this_thread::sleep_for(std::chrono::seconds(10));
+				if (report(last, line, sizeof(line)))
+				{
+					std::printf("%s\n", line);
+					std::fflush(stdout);
+				}
+			}
+		}).detach();
+	}
+}
diff --git a/rpcs3/Emu/RSX/port_wait_get.h b/rpcs3/Emu/RSX/port_wait_get.h
new file mode 100644
index 0000000..e4c59a4
--- /dev/null
+++ b/rpcs3/Emu/RSX/port_wait_get.h
@@ -0,0 +1,26 @@
+#pragma once
+
+#include <stdint.h>
+
+/* R3PORT (FIFO desync 2026-11-17): GET while the puller blocks on an NV406E semaphore acquire.
+ *
+ * With R3_FIFO_GET_EXEC (RPCS3 PR #20055) GET is the execution position while the last fetch stopped at PUT. The PR
+ * kept one exception: a blocking acquire publishes the end of the cache (= PUT) at once, in case the application
+ * waits for GET to reach PUT while the puller is blocked. R3 links a command segment, sets PUT to its exit slot E and
+ * recycles the segment memory, E included, once GET says the segment is done. GET = E published while the acquire
+ * still waits (label 77 for the ADS job, occlusion labels) let the game overwrite E with data before the puller fetched
+ * the exit JUMP there: every first desync of the 2026-11-17 logs is an EA pointer executed at that slot (io 0x80a138).
+ *
+ * R3_FIFO_WAIT_GET_MS (alias R2_FIFO_WAIT_GET_MS; default 20, 0 = upstream PR behaviour): the acquire publishes its
+ * own position first (never past a word it has not executed) and the cache end only once it has waited that long,
+ * which still unblocks an application that waits for GET == PUT. Returns the GET to publish, or 0 for "leave GET". */
+static inline uint32_t port_wait_get(uint32_t published_get, uint32_t exec_pos, uint32_t cache_end,
+	uint64_t delay_us, uint64_t waited_us)
+{
+	if (!delay_us || waited_us >= delay_us)
+	{
+		return cache_end != published_get ? cache_end : 0u; /* as upstream: unconditional, the deadlock escape */
+	}
+	/* the early position never moves GET backwards (a farther GET means an earlier publication, e.g. a label) */
+	return exec_pos - published_get - 1u < 0x100000u ? exec_pos : 0u;
+}
