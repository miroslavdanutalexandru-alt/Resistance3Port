+		VkDescriptorSet set0 = VK_NULL_HANDLE; // the game's vertex set bound for the draw (same command buffer: still valid)
+		VkBuffer ibuf = VK_NULL_HANDLE;
+		VkDeviceSize ioff = 0;
+		VkIndexType itype = VK_INDEX_TYPE_UINT16;
