+				// DLSS take the aliased current frame there (distant boil). Full mask up to D/2, none beyond D.
+				"				if (m > 0.0 && opts2.w > 0.0) m *= smoothstep(opts2.w, 2.0 * opts2.w, lin(d));\n"
