+	void sl_log_cb(sl::LogType type, const char* msg)
+	{
+		if (!msg) return;
+		if (type == sl::LogType::eInfo && !fgcfg().debug) return;
+		std::string m(msg);
+		while (!m.empty() && (m.back() == '\n' || m.back() == '\r')) m.pop_back();
+		std::fprintf(stderr, "[fg-vk] sl%s: %s\n", type == sl::LogType::eError ? " error" : type == sl::LogType::eWarn ? " warn" : "", m.c_str());
+	}
+
+	// RTX 40 (Ada) / RTX 50 (Blackwell) by name; slIsFeatureSupported is the real check once the device exists
+	bool gpu_name_qualifies(const char* name)
+	{
+		if (std::strstr(name, "Ada") || std::strstr(name, "Blackwell")) return true;
+		for (const char* p = std::strstr(name, "RTX "); p; p = std::strstr(p + 4, "RTX "))
+		{
+			const char* d = p + 4;
+			if ((d[0] == '4' || d[0] == '5') && std::isdigit(static_cast<unsigned char>(d[1])) &&
+				std::isdigit(static_cast<unsigned char>(d[2])) && std::isdigit(static_cast<unsigned char>(d[3])))
+				return true;
+		}
+		return false;
+	}
+
+	bool gpu_gate(std::string& why)
+	{
+		VkApplicationInfo app{ VK_STRUCTURE_TYPE_APPLICATION_INFO };
+		app.apiVersion = VK_API_VERSION_1_1;
+		VkInstanceCreateInfo ci{ VK_STRUCTURE_TYPE_INSTANCE_CREATE_INFO };
+		ci.pApplicationInfo = &app;
+		VkInstance inst = VK_NULL_HANDLE;
+		if (vkCreateInstance(&ci, nullptr, &inst) != VK_SUCCESS)
+		{
+			why = "could not query the GPUs";
+			return false;
+		}
+		u32 n = 0;
+		vkEnumeratePhysicalDevices(inst, &n, nullptr);
+		std::vector<VkPhysicalDevice> devs(n);
+		if (n) vkEnumeratePhysicalDevices(inst, &n, devs.data());
+		bool ok = false;
+		std::string names;
+		for (u32 i = 0; i < n; ++i)
+		{
+			VkPhysicalDeviceProperties p{};
+			vkGetPhysicalDeviceProperties(devs[i], &p);
+			if (!names.empty()) names += ", ";
+			names += p.deviceName;
+			if (p.vendorID == 0x10DE && gpu_name_qualifies(p.deviceName)) ok = true;
+		}
+		vkDestroyInstance(inst, nullptr);
+		if (!ok) why = "needs an NVIDIA GeForce RTX 40 or 50 series GPU (found: " + (names.empty() ? std::string("none") : names) + ")";
+		return ok;
+	}
+
+	template <typename T>
+	bool sym(T*& out, const char* name)
+	{
+		out = reinterpret_cast<T*>(GetProcAddress(g_sl.dll, name));
+		return out != nullptr;
+	}
+
+	// Loads and initialises Streamline before the main Vulkan instance is created
+	bool sl_setup()
+	{
+		const auto off = [](const std::string& why)
+		{
+#ifdef R2PORT_HAVE_FFX
+			if (fgcfg().backend == 0) fglog("DLSS Frame Generation unavailable: %s (trying FSR 3)", why.c_str());
+			else
+#endif
+			fglog("frame generation off: %s", why.c_str());
+			return false;
+		};
+		if (vk::r2aa_mode() != 2) return off("it needs DLSS/DLAA anti-aliasing (RSX_FSR=2 / launcher \"DLSS\")");
+		std::string why;
+		if (!gpu_gate(why)) return off(why);
+
+		const std::wstring dir = exe_dir();
+		std::string missing;
+		for (const wchar_t* f : { L"sl.interposer.dll", L"sl.common.dll", L"sl.dlss_g.dll", L"sl.reflex.dll", L"sl.pcl.dll", L"nvngx_dlssg.dll" })
+		{
+			if (GetFileAttributesW((dir + L"\\" + f).c_str()) == INVALID_FILE_ATTRIBUTES)
+			{
+				if (!missing.empty()) missing += ", ";
+				for (const wchar_t* c = f; *c; ++c) missing += static_cast<char>(*c);
+			}
+		}
+		if (!missing.empty()) return off("missing " + missing + " next to the exe (run setup.ps1 again)");
+
+		g_sl.dll = LoadLibraryW((dir + L"\\sl.interposer.dll").c_str());
+		if (!g_sl.dll) return off("sl.interposer.dll failed to load");
+		if (!sym(g_sl.fn_init, "slInit") || !sym(g_sl.fn_shutdown, "slShutdown") || !sym(g_sl.fn_supported, "slIsFeatureSupported") ||
+			!sym(g_sl.fn_feature, "slGetFeatureFunction") || !sym(g_sl.fn_token, "slGetNewFrameToken") ||
+			!sym(g_sl.fn_tag, "slSetTagForFrame") || !sym(g_sl.fn_consts, "slSetConstants"))
+			return off("sl.interposer.dll lacks the Streamline 2 API");
+		g_sl.gipa = reinterpret_cast<PFN_vkGetInstanceProcAddr>(GetProcAddress(g_sl.dll, "vkGetInstanceProcAddr"));
+		g_sl.gdpa = reinterpret_cast<PFN_vkGetDeviceProcAddr>(GetProcAddress(g_sl.dll, "vkGetDeviceProcAddr"));
+		if (!g_sl.gipa || !g_sl.gdpa) return off("sl.interposer.dll lacks the Vulkan proxies");
+
+		static const sl::Feature features[] = { sl::kFeatureDLSS_G, sl::kFeatureReflex, sl::kFeaturePCL };
+		static std::wstring plugin_dir;
+		plugin_dir = dir;
+		static const wchar_t* paths[1];
+		paths[0] = plugin_dir.c_str();
+
+		sl::Preferences pref{};
+		pref.showConsole = false;
+		pref.logLevel = fgcfg().debug ? sl::LogLevel::eVerbose : sl::LogLevel::eDefault;
+		pref.logMessageCallback = &sl_log_cb;
+		pref.pathsToPlugins = paths;
+		pref.numPathsToPlugins = 1;
+		pref.flags = sl::PreferenceFlags::eDisableCLStateTracking | sl::PreferenceFlags::eDisableDebugText |
+			sl::PreferenceFlags::eUseManualHooking | sl::PreferenceFlags::eUseFrameBasedResourceTagging;
+		pref.featuresToLoad = features;
+		pref.numFeaturesToLoad = static_cast<u32>(std::size(features));
+		pref.engine = sl::EngineType::eCustom;
+		pref.engineVersion = "1.0";
+		pref.projectId = "c4a7e2d1-3b58-4f6a-8e92-71d5b0c3f6e8";
+		pref.renderAPI = sl::RenderAPI::eVulkan;
+		const sl::Result r = g_sl.fn_init(pref, sl::kSDKVersion);
+		if (r != sl::Result::eOk) return off("Streamline init failed (code " + std::to_string(static_cast<int>(r)) + ")");
+		g_sl.inited = true;
+		return true;
+	}
