+				"		{\n" +
+				(r2cfg().om_guard
+					? "			if (r2_om_guard(q, mv, -0.5 * v.xy, ndc, lin(d))) r2dbg = 1.0;\n"
+					  "			else\n"
+					  "			{\n"
+					  "			r2dbg = 0.5;\n"
+					: "			{\n"
+					  "			r2dbg = 0.5;\n") +
+				"			mv = -0.5 * v.xy;\n"
+				"			m = 0.0;\n" +
+				r2_om_deadzone_glsl() +
+				"			}\n"
+				"		}\n"
+				"	}\n"
+				// RSX_DLSS_OBJMV_MODE=onepass: per-pixel (depth key, half2 velocity) written by the moving draws themselves
+				// (nearest fragment wins); same visibility check against the final scene depth
+				"	else if (opts3.x > 2.5)\n"
+				"	{\n"
+				"		uvec2 e = (p.x < int(vw.x) && p.y < int(vw.y)) ? vel[uint(p.y) * vw.x + uint(p.x)] : uvec2(0xffffffffu);\n"
+				"		if (e.y != 0xffffffffu)\n"
+				"		{\n"
+				"			float z = uintBitsToFloat(vw.z != 0u ? ~e.y : e.y);\n"
+				"			vec2 v = unpackHalf2x16(e.x);\n"
+				"			float lv = lin(z);\n" +
+				std::string(r2cfg().om_nowrite ? "			bool r2nw = (e.y & 1u) != 0u;\n" : "			const bool r2nw = false;\n") +
+				// RSX_DLSS_OBJMV_NOWRITE: a flagged (non-depth-writing) fragment counts in front of the scene depth too
+				"			if ((abs(lv - lin(d)) <= opts3.z * max(lin(d), 1e-6) || (r2nw && lv <= lin(d) * (1.0 + opts3.z))) && all(lessThan(abs(v), vec2(4.0))) && !any(isnan(v)))\n"
+				"			{\n" +
+				(r2cfg().om_guard
+					? "				if (!r2nw && r2_om_guard(q, mv, -0.5 * v, ndc, lin(d))) r2dbg = 1.0;\n"
+					  "				else\n"
+					  "				{\n"
+					  "				r2dbg = 0.5;\n"
+					: "				{\n"
+					  "				r2dbg = 0.5;\n") +
+				"				mv = -0.5 * v;\n"
+				"				m = 0.0;\n" +
+				r2_om_deadzone_glsl() +
+				"				}\n"
+				"			}\n"
+				"		}\n"
+				"	}\n"
+				"	imageStore(MvOut, o, vec4(mv, 0.0, 0.0));\n"
+				"	imageStore(MaskOut, o, vec4(max(m, mb)));\n" +
+				// RSX_DLSS_DEBUG_VIEW=6: the mask carries the object velocity state instead (shown by the merge pass)
+				std::string(r2cfg().view == 8 ? "	imageStore(MaskOut, o, vec4(r2dbg));\n" : "") +
+				"}\n";
+			ssbo_count = 0;
+			use_push_constants = true;
+			push_constants_size = 128;
+			create();
+		}
+
+		std::vector<glsl::program_input> get_inputs() override
+		{
+			auto result = compute_task::get_inputs();
+			const char* names[] = { "ColorIn", "DepthIn", "ColorOut", "DepthOut", "MvOut", "PrevDepthIn", "MaskOut", "IdIn" };
+			for (u32 i = 0; i < 8; ++i)
+			{
+				result.push_back(glsl::program_input::make(::glsl::program_domain::glsl_compute_program, names[i],
+					(i < 2 || i == 5 || i == 7) ? vk::glsl::input_type_texture : vk::glsl::input_type_storage_texture, 0, i));
+			}
+			result.push_back(glsl::program_input::make(::glsl::program_domain::glsl_compute_program, "ObjTable",
+				vk::glsl::input_type_storage_buffer, 0, 8));
+			result.push_back(glsl::program_input::make(::glsl::program_domain::glsl_compute_program, "VelBuf",
+				vk::glsl::input_type_storage_buffer, 0, 9));
+			return result;
+		}
+
+		void bind_resources(const vk::command_buffer&) override
+		{
+			if (!m_sampler)
+			{
+				m_sampler = std::make_unique<vk::sampler>(*vk::get_current_renderer(),
+					VK_SAMPLER_ADDRESS_MODE_CLAMP_TO_EDGE, VK_SAMPLER_ADDRESS_MODE_CLAMP_TO_EDGE, VK_SAMPLER_ADDRESS_MODE_CLAMP_TO_EDGE,
+					VK_FALSE, 0.f, 1.f, 0.f, 0.f, VK_FILTER_NEAREST, VK_FILTER_NEAREST, VK_SAMPLER_MIPMAP_MODE_NEAREST, VK_BORDER_COLOR_FLOAT_OPAQUE_BLACK);
+			}
+			m_program->bind_uniform({ *in_color, *m_sampler }, 0, 0);
+			m_program->bind_uniform({ *in_depth, *m_sampler }, 0, 1);
+			m_program->bind_uniform({ *out_color }, 0, 2);
+			m_program->bind_uniform({ *out_depth }, 0, 3);
+			m_program->bind_uniform({ *out_mv }, 0, 4);
+			m_program->bind_uniform({ *in_prev_depth, *m_sampler }, 0, 5);
+			m_program->bind_uniform({ *out_mask }, 0, 6);
+			m_program->bind_uniform({ *in_id, *m_sampler }, 0, 7);
+			m_program->bind_uniform({ *obj_table, 0, obj_table_len }, 0, 8);
+			m_program->bind_uniform({ *vel_buf, 0, vel_len }, 0, 9);
+		}
+
+		void run(const vk::command_buffer& cmd, const float* constants, u32 w, u32 h)
+		{
+			if (!m_program) load_program(cmd);
+			vkCmdPushConstants(cmd, m_program->layout(), VK_SHADER_STAGE_COMPUTE_BIT, 0, push_constants_size, constants);
+			compute_task::run(cmd, (w + 7) / 8, (h + 7) / 8, 1);
+		}
+	};
+
+	// Upscaler output + original alpha -> image copied back into the scene target (optionally BGRA-swizzled)
+	template <bool HalfFloat>
+	struct r2aa_merge_pass : compute_task
+	{
+		const vk::image_view* in_result = nullptr;
+		const vk::image_view* in_orig = nullptr;
+		const vk::image_view* out_final = nullptr;
+		const vk::image_view* in_mv = nullptr;    // RSX_DLSS_DEBUG views (render resolution)
+		const vk::image_view* in_mask = nullptr;
+		const vk::image_view* in_depth = nullptr;
+		const vk::image_view* in_prev_depth = nullptr; // RSX_DLSS_DEBUG_VIEW=4 (disocclusion)
+		const vk::image_view* in_ahist = nullptr;  // RSX_AA_ALPHA_TEMPORAL
+		const vk::image_view* out_ahist = nullptr;
+		std::unique_ptr<vk::sampler> m_sampler;
+
+		r2aa_merge_pass()
+		{
+			m_src = std::string(
+				"#version 450\n"
+				"layout(local_size_x = 8, local_size_y = 8) in;\n"
+				"layout(set=0, binding=0) uniform sampler2D ResultIn;\n"
+				"layout(set=0, binding=1) uniform sampler2D OrigIn;\n") +
+				(HalfFloat ? "layout(set=0, binding=2, rgba16f) uniform writeonly image2D FinalOut;\n"
+				           : "layout(set=0, binding=2, rgba8) uniform writeonly image2D FinalOut;\n") +
+				"layout(set=0, binding=3) uniform sampler2D MvIn;\n"
+				"layout(set=0, binding=4) uniform sampler2D MaskIn;\n"
+				"layout(set=0, binding=5) uniform sampler2D DepthIn;\n"
+				"layout(set=0, binding=6) uniform sampler2D PrevDepthIn;\n"
+				// RSX_AA_ALPHA_TEMPORAL: the previous frame's output-res glow mask and this frame's
+				"layout(set=0, binding=7) uniform sampler2D AHistIn;\n"
+				"layout(set=0, binding=8, r32f) uniform writeonly image2D AHistOut;\n"
+				// x: swap R/B, y/z: output size, w: debug view; opts2.xy: render/output, z: motion scale, w: depth inverted;
+				// opts3.xy: motion vector scale (UV -> render pixels); opts4.x: alpha history valid, y: alpha history weight
+				"layout(push_constant) uniform PC { vec4 opts; vec4 opts2; vec4 opts3; vec4 opts4; };\n"
+				"void main()\n"
+				"{\n"
+				"	ivec2 p = ivec2(gl_GlobalInvocationID.xy);\n"
+				"	if (p.x >= int(opts.y) || p.y >= int(opts.z)) return;\n"
+				"	ivec2 q = ivec2((vec2(p) + 0.5) * opts2.xy);\n"
+				"	vec3 c = texelFetch(ResultIn, p, 0).rgb;\n" +
+				std::string(r2cfg().dlss_sanitize
+					? "	if (any(isnan(c)) || any(isinf(c))) c = texelFetch(OrigIn, q, 0).rgb;\n	c = max(c, vec3(0.0));\n"
+					: "	if (any(isnan(c))) c = texelFetch(OrigIn, q, 0).rgb;\n") +
+				"	vec3 l = vec3(dot(clamp(c, 0.0, 1.0), vec3(0.299, 0.587, 0.114)) * 0.35);\n"
+				// RSX_DLSS_DEBUG=mv: |motion| (red x, green y), blue = exactly zero; mask: red = bias-current-colour mask
+				// RSX_DLSS_DEBUG_VIEW=1 (7): |motion| in render pixels (red x, green y, full at 2 px), blue = exactly zero
+				"	if (opts.w > 7.5) { float k = texelFetch(MaskIn, q, 0).r; c = l + vec3(k > 0.75 ? 0.6 : 0.0, (k > 0.25 && k < 0.75) ? 0.4 : 0.0, 0.0); }\n"
+				"	else if (opts.w > 6.5) { vec2 m = texelFetch(MvIn, q, 0).rg * opts3.xy; c = l + vec3(clamp(abs(m) * 0.5, 0.0, 1.0), (m.x == 0.0 && m.y == 0.0) ? 0.5 : 0.0); }\n"
+				// RSX_DLSS_DEBUG_VIEW=4 (6): disocclusion, red = the previous depth where the motion vector points differs by
+				// 3..15% (distance ratio), green = it points off screen
+				"	else if (opts.w > 5.5)\n"
+				"	{\n"
+				"		vec2 m = texelFetch(MvIn, q, 0).rg * opts3.xy;\n"
+				"		ivec2 rp = ivec2(floor(vec2(q) + 0.5 + m));\n"
+				"		bool off = any(lessThan(rp, ivec2(0))) || any(greaterThanEqual(rp, textureSize(PrevDepthIn, 0)));\n"
+				"		float dc = texelFetch(DepthIn, q, 0).r; dc = opts2.w > 0.5 ? dc : 1.0 - dc;\n"
+				"		float dp = off ? dc : texelFetch(PrevDepthIn, rp, 0).r; if (!off) dp = opts2.w > 0.5 ? dp : 1.0 - dp;\n"
+				"		c = l + vec3(smoothstep(0.03, 0.15, abs(dc - dp) / max(max(dc, dp), 1e-6)), off ? 0.5 : 0.0, 0.0);\n"
+				"	}\n"
+				"	else if (opts.w > 4.5) { float d = texelFetch(DepthIn, q, 0).r; d = opts2.w > 0.5 ? d : 1.0 - d; c = vec3(clamp(d * 32.0, 0.0, 1.0)); }\n"
+				"	else if (opts.w > 3.5) c = l + vec3(texelFetch(MaskIn, q, 0).r, 0.0, 0.0);\n"
+				"	else if (opts.w > 2.5) { vec2 m = texelFetch(MvIn, q, 0).rg; c = l + vec3(clamp(abs(m) * opts2.z, 0.0, 1.0), (m.x == 0.0 && m.y == 0.0) ? 0.5 : 0.0); }\n"
+				"	else if (opts.w > 1.5) { if (p.x < int(opts.y) / 2) c = texelFetch(OrigIn, q, 0).rgb; }\n"
+				"	else if (opts.w > 0.5) c = min(abs(c - texelFetch(OrigIn, q, 0).rgb) * 8.0, vec3(1.0));\n" +
+				std::string(r2cfg().alpha_stable
+					// opts3.zw: the jitter baked into the render-res input (render px): bilinear alpha at the un-jittered position
+					? "	vec2 sp = (vec2(p) + 0.5) * opts2.xy + opts3.zw - 0.5;\n"
+					  "	ivec2 i0 = ivec2(floor(sp)); vec2 f = sp - vec2(i0);\n"
+					  "	ivec2 mx = ivec2(opts2.xy * opts.yz + 0.5) - 1;\n"
+					  "	float a00 = texelFetch(OrigIn, clamp(i0, ivec2(0), mx), 0).a, a10 = texelFetch(OrigIn, clamp(i0 + ivec2(1, 0), ivec2(0), mx), 0).a;\n"
+					  "	float a01 = texelFetch(OrigIn, clamp(i0 + ivec2(0, 1), ivec2(0), mx), 0).a, a11 = texelFetch(OrigIn, clamp(i0 + ivec2(1), ivec2(0), mx), 0).a;\n"
+					  "	float a = mix(mix(a00, a10, f.x), mix(a01, a11, f.x), f.y);\n"
+					: "	float a = texelFetch(OrigIn, q, 0).a;\n") +
+				std::string(r2cfg().alpha_temporal
+					? "	{\n"
+					  "		ivec2 rmx = ivec2(opts2.xy * opts.yz + 0.5) - 1;\n"
+					  "		float mn = 1.0, mxa = 0.0;\n"
+					  "		for (int y = -1; y <= 1; y++) for (int x = -1; x <= 1; x++) { float t = texelFetch(OrigIn, clamp(q + ivec2(x, y), ivec2(0), rmx), 0).a; mn = min(mn, t); mxa = max(mxa, t); }\n"
+					  "		float o = a;\n"
+					  "		if (opts4.x > 0.5)\n"
+					  "		{\n"
+					  // the previous position is the current one plus the motion vector (render px -> output px)
+					  "			vec2 hp = vec2(p) + texelFetch(MvIn, q, 0).rg * opts3.xy / opts2.xy;\n"
+					  "			ivec2 hmx = ivec2(opts.yz) - 1;\n"
+					  "			if (all(greaterThanEqual(hp, vec2(-0.5))) && all(lessThanEqual(hp, vec2(hmx) + 0.5)))\n"
+					  "			{\n"
+					  "				ivec2 h0 = ivec2(floor(hp)); vec2 hf = hp - vec2(h0);\n"
+					  "				float h00 = texelFetch(AHistIn, clamp(h0, ivec2(0), hmx), 0).r, h10 = texelFetch(AHistIn, clamp(h0 + ivec2(1, 0), ivec2(0), hmx), 0).r;\n"
+					  "				float h01 = texelFetch(AHistIn, clamp(h0 + ivec2(0, 1), ivec2(0), hmx), 0).r, h11 = texelFetch(AHistIn, clamp(h0 + ivec2(1), ivec2(0), hmx), 0).r;\n"
+					  "				o = mix(clamp(mix(mix(h00, h10, hf.x), mix(h01, h11, hf.x), hf.y), mn, mxa), a, opts4.y);\n"
+					  "			}\n"
+					  "		}\n"
+					  "		imageStore(AHistOut, p, vec4(o));\n"
+					  "		a = o;\n"
+					  "	}\n"
+					: "") +
+				"	vec4 r = vec4(c, a);\n"
+				"	if (opts.x > 0.5) r = r.bgra;\n"
+				"	imageStore(FinalOut, p, r);\n"
+				"}\n";
+			ssbo_count = 0;
+			use_push_constants = true;
+			push_constants_size = 64;
+			create();
+		}
+
+		std::vector<glsl::program_input> get_inputs() override
+		{
+			auto result = compute_task::get_inputs();
+			const char* names[] = { "ResultIn", "OrigIn", "FinalOut", "MvIn", "MaskIn", "DepthIn", "PrevDepthIn", "AHistIn", "AHistOut" };
+			for (u32 i = 0; i < 9; ++i)
+			{
+				result.push_back(glsl::program_input::make(::glsl::program_domain::glsl_compute_program, names[i],
+					(i != 2 && i != 8) ? vk::glsl::input_type_texture : vk::glsl::input_type_storage_texture, 0, i));
+			}
+			return result;
+		}
+
+		void bind_resources(const vk::command_buffer&) override
+		{
+			if (!m_sampler)
+			{
+				m_sampler = std::make_unique<vk::sampler>(*vk::get_current_renderer(),
+					VK_SAMPLER_ADDRESS_MODE_CLAMP_TO_EDGE, VK_SAMPLER_ADDRESS_MODE_CLAMP_TO_EDGE, VK_SAMPLER_ADDRESS_MODE_CLAMP_TO_EDGE,
+					VK_FALSE, 0.f, 1.f, 0.f, 0.f, VK_FILTER_NEAREST, VK_FILTER_NEAREST, VK_SAMPLER_MIPMAP_MODE_NEAREST, VK_BORDER_COLOR_FLOAT_OPAQUE_BLACK);
+			}
+			m_program->bind_uniform({ *in_result, *m_sampler }, 0, 0);
+			m_program->bind_uniform({ *in_orig, *m_sampler }, 0, 1);
+			m_program->bind_uniform({ *out_final }, 0, 2);
+			m_program->bind_uniform({ in_mv ? *in_mv : *in_orig, *m_sampler }, 0, 3);
+			m_program->bind_uniform({ in_mask ? *in_mask : *in_orig, *m_sampler }, 0, 4);
+			m_program->bind_uniform({ in_depth ? *in_depth : *in_orig, *m_sampler }, 0, 5);
+			m_program->bind_uniform({ in_prev_depth ? *in_prev_depth : *in_orig, *m_sampler }, 0, 6);
+			m_program->bind_uniform({ *in_ahist, *m_sampler }, 0, 7);
+			m_program->bind_uniform({ *out_ahist }, 0, 8);
+		}
+
+		void run(const vk::command_buffer& cmd, const float* constants, u32 w, u32 h)
+		{
+			if (!m_program) load_program(cmd);
+			vkCmdPushConstants(cmd, m_program->layout(), VK_SHADER_STAGE_COMPUTE_BIT, 0, push_constants_size, constants);
+			compute_task::run(cmd, (w + 7) / 8, (h + 7) / 8, 1);
+		}
+	};
+}
