+			case RSX_SCA_OPCODE_EXP: R2_LANES sr[l][i] = std::exp(s2[l][i]); break;
+			case RSX_SCA_OPCODE_LOG: R2_LANES sr[l][i] = std::log(s2[l][i]); break;
+			case RSX_SCA_OPCODE_LG2: R2_LANES sr[l][i] = std::log2(std::fmax(std::fabs(s2[l][i]), 1e-38f)); break;
+			case RSX_SCA_OPCODE_EX2: R2_LANES sr[l][i] = std::exp2(s2[l][i]); break;
+			case RSX_SCA_OPCODE_SIN: R2_LANES sr[l][i] = std::sin(s2[l][i]); break;
+			case RSX_SCA_OPCODE_COS: R2_LANES sr[l][i] = std::cos(s2[l][i]); break;
+			case RSX_SCA_OPCODE_LIT:
