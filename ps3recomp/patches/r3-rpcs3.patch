+#pragma once
+// R2PORT: HD UI pack / texture pack core, shared by the RSX texture cache hook (VK/VKR2Gfx.cpp), the offline pack
+// builder (project/hd_ui_pack.cpp, run by the launcher's "Create HD UI pack" button) and their tests. Self-contained:
+// no RPCS3 types, so the offline tool computes the exact key the game computes at texture upload.
+//
+// Key: 64-bit hash of the texel rows of every mip level (pitch padding excluded) as they sit in guest memory, seeded
+// with width, height, format (LN/UN bits removed) and mip count. layout_2d() reproduces RPCS3's
+// get_subresources_layout_impl (Common/TextureUtils.cpp) for the formats the pack handles (2D A8R8G8B8 / DXT1/3/5).
+
+#include <algorithm>
+#include <cctype>
+#include <cstdarg>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <filesystem>
+#include <string>
+#include <system_error>
+#include <utility>
+#include <vector>
+
+namespace hdui
+{
+	enum : uint32_t
+	{
+		GCM_A8R8G8B8 = 0x85,
+		GCM_DXT1 = 0x86,
+		GCM_DXT23 = 0x87,
+		GCM_DXT45 = 0x88,
+		GCM_LN = 0x20,
+		GCM_UN = 0x40,
+	};
+
+	constexpr uint32_t max_scale = 8;
+	constexpr uint32_t max_side = 8192;
+	constexpr size_t max_level0 = 64ull << 20;
+
+	inline bool is_dxt(uint32_t fmt) { return fmt == GCM_DXT1 || fmt == GCM_DXT23 || fmt == GCM_DXT45; }
+	inline uint32_t block_bytes(uint32_t fmt) { return fmt == GCM_DXT1 ? 8 : (fmt == GCM_DXT23 || fmt == GCM_DXT45) ? 16 : 4; }
+	inline uint32_t block_edge(uint32_t fmt) { return is_dxt(fmt) ? 4 : 1; }
+	inline const char* fmt_name(uint32_t fmt) { return fmt == GCM_DXT1 ? "DXT1" : fmt == GCM_DXT23 ? "DXT3" : fmt == GCM_DXT45 ? "DXT5" : "A8R8G8B8"; }
+	inline uint32_t base_format(uint32_t gcm_format) { return gcm_format & ~(GCM_LN | GCM_UN); }
+	inline bool handled_format(uint32_t fmt) { return fmt == GCM_A8R8G8B8 || is_dxt(fmt); }
+
+	inline std::string sfmt(const char* f, ...)
+	{
+		char buf[256];
+		va_list ap;
+		va_start(ap, f);
+		std::vsnprintf(buf, sizeof buf, f, ap);
+		va_end(ap);
+		return buf;
+	}
+
+	// One mip level as RPCS3's rsx::subresource_layout describes it
+	struct span
+	{
+		const uint8_t* data = nullptr;
+		size_t size = 0;            // bytes of the level (pitch * rows)
+		uint32_t width_in_texel = 0, height_in_texel = 0;
+		uint32_t width_in_block = 0, height_in_block = 0, pitch_in_block = 0, depth = 1;
+		size_t offset = 0;          // from the texture base (layout_2d only)
+	};
+
+	// The texture key. Identical to what the runtime hashes (it converts RPCS3's layout into spans).
+	inline uint64_t hash(const span* levels, size_t count, uint16_t w, uint16_t h, uint32_t fmt, uint32_t mips)
+	{
+		uint64_t hsh = 0x9E3779B97F4A7C15ull ^ (static_cast<uint64_t>(w) << 48) ^ (static_cast<uint64_t>(h) << 32) ^ (static_cast<uint64_t>(mips & 0xFF) << 8) ^ fmt;
+		const auto mix = [&](uint64_t v)
+		{
+			hsh ^= v;
+			hsh *= 0xFF51AFD7ED558CCDull;
+			hsh ^= hsh >> 32;
+		};
+		const auto bytes = [&](const uint8_t* p, size_t n)
+		{
+			size_t i = 0;
+			for (; i + 8 <= n; i += 8)
+			{
+				uint64_t v;
+				std::memcpy(&v, p + i, 8);
+				mix(v);
+			}
+			uint64_t tail = 0;
+			if (n > i) std::memcpy(&tail, p + i, n - i);
+			mix(tail ^ (static_cast<uint64_t>(n) << 56));
+		};
+		const uint32_t bb = block_bytes(fmt);
+		for (size_t l = 0; l < count; ++l)
+		{
+			const span& s = levels[l];
+			const uint8_t* p = s.data;
+			const size_t n = s.size;
+			if (!p) continue;
+			const size_t row = static_cast<size_t>(s.width_in_block) * bb;
+			const size_t pitch = static_cast<size_t>(std::max<uint32_t>(s.pitch_in_block, s.width_in_block)) * bb;
+			const size_t rows = static_cast<size_t>(s.height_in_block) * std::max<uint32_t>(1, s.depth);
+			size_t o = 0;
+			for (size_t y = 0; y < rows && o < n; ++y, o += pitch)
+				bytes(p + o, std::min(row, n - o));
+		}
+		return hsh;
+	}
+	inline uint64_t hash(const std::vector<span>& levels, uint16_t w, uint16_t h, uint32_t fmt, uint32_t mips)
+	{
+		return hash(levels.data(), levels.size(), w, h, fmt, mips);
+	}
+
+	inline uint32_t floor_log2(uint32_t v) { uint32_t r = 0; while (v >>= 1) ++r; return r; }
+
+	// rsx::fragment_texture::get_exact_mipmap_count
+	inline uint32_t exact_mip_count(uint32_t fmt, uint32_t w, uint32_t h, uint32_t mip_register)
+	{
+		const uint32_t mx = is_dxt(fmt) ? floor_log2(std::max<uint32_t>(1, std::min(w / 4, h / 4))) + 1 : floor_log2(std::max(w, h)) + 1;
+		return std::min(std::max<uint32_t>(1, mip_register), mx);
+	}
+
+	// RPCS3's layout of a 2D texture (no border texels) at `base`: gcm_format with its LN bit, register pitch in bytes.
+	// Spans whose bytes lie past `avail` get data = nullptr (the caller then has too little data to key it).
+	inline std::vector<span> layout_2d(const uint8_t* base, size_t avail, uint16_t w, uint16_t h, uint32_t gcm_format, uint32_t mips, uint32_t pitch)
+	{
+		const uint32_t fmt = base_format(gcm_format);
+		const bool swizzled = !(gcm_format & GCM_LN);
+		const uint32_t bb = block_bytes(fmt), be = block_edge(fmt);
+		uint32_t tw = w, th = h;
+		if (!swizzled)
+		{
+			const uint32_t packed = ((tw + be - 1) / be) * bb;
+			if (pitch < packed)
+			{
+				if (pitch) tw = std::max<uint32_t>((pitch / bb) * be, 1);
+				else { th = 1; pitch = packed; }
+			}
+		}
+		std::vector<span> out;
+		size_t off = 0;
+		for (uint32_t l = 0; l < std::max<uint32_t>(1, mips); ++l)
+		{
+			span s;
+			s.width_in_texel = tw;
+			s.height_in_texel = th;
+			s.width_in_block = (tw + be - 1) / be;
+			s.height_in_block = (th + be - 1) / be;
+			s.pitch_in_block = swizzled ? s.width_in_block : pitch / bb;
+			s.size = static_cast<size_t>(s.pitch_in_block) * bb * s.height_in_block;
+			s.offset = off;
+			s.data = (base && off + s.size <= avail) ? base + off : nullptr;
+			out.push_back(s);
+			off += s.size;
+			tw = std::max<uint32_t>(tw / 2, 1);
+			th = std::max<uint32_t>(th / 2, 1);
+		}
+		return out;
+	}
+	inline size_t layout_bytes(const std::vector<span>& l) { return l.empty() ? 0 : l.back().offset + l.back().size; }
+
+	// Scale of a w2 x h2 replacement for a w x h texture: 1..8, the same on both axes; 0 = no match
+	inline uint32_t scale_of(uint32_t w2, uint32_t h2, uint32_t w, uint32_t h)
+	{
+		if (!w || !h || !w2 || !h2 || (w2 % w) || (h2 % h)) return 0;
+		const uint32_t s = w2 / w;
+		if (s > max_scale || h2 / h != s) return 0;
+		if (s > 1 && (w2 > max_side || h2 > max_side)) return 0;
+		return s;
+	}
+
+	// Level l of an S x HD replacement: what the runtime uploads in place of the game's level l
+	inline uint32_t level_dim(uint32_t base, uint32_t scale, uint32_t l) { return std::max<uint32_t>(1, (base * scale) >> l); }
+	inline size_t level_size(uint32_t fmt, uint32_t lw, uint32_t lh)
+	{
+		return is_dxt(fmt) ? static_cast<size_t>((lw + 3) / 4) * ((lh + 3) / 4) * block_bytes(fmt) : static_cast<size_t>(lw) * lh * 4;
+	}
+
+	// The upload path's check of level `level` of a `scale` x replacement (VK/VKR2Gfx.cpp texpack_upload)
+	inline bool hd_level_ok(uint32_t fmt, uint32_t w, uint32_t h, uint32_t scale, uint32_t level, size_t bytes)
+	{
+		return bytes == level_size(fmt, level_dim(w, scale, level), level_dim(h, scale, level));
+	}
+
+	// DDS header (128 bytes) for a DXT texture, or a 32-bit B8G8R8A8 one for A8R8G8B8
+	inline std::vector<uint8_t> dds_header(uint32_t w, uint32_t h, uint32_t fmt, uint32_t levels)
+	{
+		uint32_t hdr[32] = {};
+		hdr[0] = 0x20534444;
+		hdr[1] = 124;
+		hdr[2] = 0x1 | 0x2 | 0x4 | 0x1000 | (is_dxt(fmt) ? 0x80000 : 0x8) | (levels > 1 ? 0x20000 : 0);
+		hdr[3] = h;
+		hdr[4] = w;
+		hdr[5] = is_dxt(fmt) ? static_cast<uint32_t>(level_size(fmt, w, h)) : w * 4;
+		hdr[7] = levels;
+		hdr[19] = 32;
+		if (is_dxt(fmt))
+		{
+			hdr[20] = 0x4;
+			hdr[21] = fmt == GCM_DXT1 ? 0x31545844 : fmt == GCM_DXT23 ? 0x33545844 : 0x35545844;
+		}
+		else
+		{
+			hdr[20] = 0x40 | 0x1;
+			hdr[22] = 32;
+			hdr[23] = 0x00FF0000u;
+			hdr[24] = 0x0000FF00u;
+			hdr[25] = 0x000000FFu;
+			hdr[26] = 0xFF000000u;
+		}
+		hdr[27] = 0x1000 | (levels > 1 ? 0x400008 : 0);
+		std::vector<uint8_t> out(128);
+		std::memcpy(out.data(), hdr, 128);
+		return out;
+	}
+
+	// Validates a DDS replacement for a w x h `fmt` texture with `mips` levels and returns its levels in guest format
+	// (DXT blocks as they are; A8R8G8B8 as A,R,G,B bytes). Size: the game texture's (levels the file lacks keep the
+	// game's data) or 2x..8x it (HD: the file must have every level the game texture has).
+	inline bool load_dds(const std::vector<uint8_t>& file, uint16_t w, uint16_t h, uint32_t fmt, uint32_t mips,
+		std::vector<std::vector<uint8_t>>& levels, uint32_t& scale, std::string& why)
+	{
+		levels.clear();
+		scale = 1;
+		uint32_t hdr[32];
+		if (file.size() < 128 || (std::memcpy(hdr, file.data(), 128), hdr[0] != 0x20534444))
+		{
+			why = "not a DDS file";
+			return false;
+		}
+		const uint32_t fw = hdr[4], fh = hdr[3];
+		const uint32_t s = scale_of(fw, fh, w, h);
+		if (!s)
+		{
+			why = sfmt("its size %ux%u is not 1x..8x the game texture's (8192 at most)", fw, fh);
+			return false;
+		}
+		const bool fourcc = (hdr[20] & 0x4) != 0;
+		const bool rgb32 = (hdr[20] & 0x40) && hdr[22] == 32;
+		bool bgra = false;
+		if (is_dxt(fmt))
+		{
+			const uint32_t want = fmt == GCM_DXT1 ? 0x31545844 : fmt == GCM_DXT23 ? 0x33545844 : 0x35545844;
+			const bool fmt_ok = fourcc && (hdr[21] == want || (fmt == GCM_DXT23 && hdr[21] == 0x32545844) || (fmt == GCM_DXT45 && hdr[21] == 0x34545844));
+			if (!fmt_ok)
+			{
+				why = sfmt("the game texture is %s and the DDS is not", fmt_name(fmt));
+				return false;
+			}
+		}
+		else
+		{
+			if (!rgb32 || hdr[26] != 0xFF000000u || hdr[24] != 0x0000FF00u ||
+				!((hdr[23] == 0x00FF0000u && hdr[25] == 0x000000FFu) || (hdr[23] == 0x000000FFu && hdr[25] == 0x00FF0000u)))
+			{
+				why = "the game texture is A8R8G8B8: use PNG or an uncompressed 32-bit DDS with alpha";
+				return false;
+			}
+			bgra = hdr[23] == 0x00FF0000u;
+		}
+		const uint32_t have = std::max<uint32_t>(1, (hdr[2] & 0x20000) ? hdr[7] : 1);
+		if (s > 1 && have < mips)
+		{
+			why = sfmt("an HD replacement needs all %u mip levels, the DDS has %u", mips, have);
+			return false;
+		}
+		const uint32_t nlev = std::min(have, mips);
+		size_t off = 128;
+		for (uint32_t l = 0; l < nlev; ++l)
+		{
+			const uint32_t lw = std::max<uint32_t>(1, fw >> l), lh = std::max<uint32_t>(1, fh >> l);
+			const size_t n = level_size(fmt, lw, lh);
+			if (off + n > file.size()) break;
+			if (l == 0 && s > 1 && n > max_level0)
+			{
+				why = "too large (64 MB per image at most)";
+				levels.clear();
+				return false;
+			}
+			if (is_dxt(fmt))
+			{
+				levels.emplace_back(file.begin() + off, file.begin() + off + n);
+			}
+			else
+			{
+				std::vector<uint8_t> g(n);
+				const uint8_t* src = file.data() + off;
+				for (size_t i = 0; i < n; i += 4)
+				{
+					g[i + 0] = src[i + 3];
+					g[i + 1] = bgra ? src[i + 2] : src[i + 0];
+					g[i + 2] = src[i + 1];
+					g[i + 3] = bgra ? src[i + 0] : src[i + 2];
+				}
+				levels.push_back(std::move(g));
+			}
+			off += n;
+		}
+		if (levels.empty() || (s > 1 && levels.size() < mips))
+		{
+			why = "the file is truncated";
+			levels.clear();
+			return false;
+		}
+		scale = s;
+		return true;
+	}
+
+	// File name -> key: the first 16 characters must be hex digits
+	inline bool key_of_name(const std::string& stem, uint64_t& key)
+	{
+		if (stem.size() < 16) return false;
+		for (int i = 0; i < 16; ++i)
+			if (!std::isxdigit(static_cast<unsigned char>(stem[i]))) return false;
+		key = std::strtoull(stem.substr(0, 16).c_str(), nullptr, 16);
+		return true;
+	}
+
+	// The replacement files in a pack folder (sub-folders included). Folders and files whose name starts with '.'
+	// are skipped: tool scratch (.work, .tmp) must never be loaded as a replacement.
+	inline std::vector<std::pair<uint64_t, std::filesystem::path>> list_pack(const std::filesystem::path& dir)
+	{
+		std::vector<std::pair<uint64_t, std::filesystem::path>> out;
+		std::error_code ec;
+		for (auto it = std::filesystem::recursive_directory_iterator(dir, ec); !ec && it != std::filesystem::recursive_directory_iterator(); it.increment(ec))
+		{
+			const auto name = it->path().filename().string();
+			if (!name.empty() && name[0] == '.')
+			{
+				if (it->is_directory(ec)) it.disable_recursion_pending();
+				continue;
+			}
+			if (!it->is_regular_file(ec)) continue;
+			auto ext = it->path().extension().string();
+			for (auto& c : ext) c = static_cast<char>(std::tolower(static_cast<unsigned char>(c)));
+			if (ext != ".dds" && ext != ".png") continue;
+			uint64_t key;
+			if (key_of_name(it->path().stem().string(), key)) out.emplace_back(key, it->path());
+		}
+		return out;
+	}
+
+	// A section holding an HD replacement has an image `image_scale` times the section's size: the blit engine
+	// addresses source texels in guest units, so such a section is never a blit source (the guest data is read
+	// instead). Otherwise the source area must lie inside the section.
+	inline bool blit_source_ok(uint32_t image_scale, int area_x2, int area_y2, uint32_t section_w, uint32_t section_h)
+	{
+		return image_scale <= 1 && area_x2 <= static_cast<int>(section_w) && area_y2 <= static_cast<int>(section_h);
+	}
+
+	// An image file of the builder (<key>_<W>x<H>_<fmt>_m<mips>_image_x<scale>.dds, pack_name) -> the game texture's
+	// size, the scale and whether it is A8R8G8B8 (only those are matched as loose images). false: not an image file.
+	inline bool image_file_info(const std::string& name, uint32_t& w, uint32_t& h, uint32_t& scale, bool& argb)
+	{
+		const auto tag = name.find("_image_x");
+		unsigned fw = 0, fh = 0, s = 0;
+		if (tag == std::string::npos || name.size() <= 17 || name[16] != '_' ||
+			std::sscanf(name.c_str() + 17, "%ux%u", &fw, &fh) != 2 || std::sscanf(name.c_str() + tag + 8, "%u", &s) != 1 ||
+			s < 1 || s > 8 || !fw || !fh || fw % s || fh % s)
+			return false;
+		w = fw / s;
+		h = fh / s;
+		scale = s;
+		argb = name.find("_A8R8G8B8_") != std::string::npos;
+		return true;
+	}
+
+	// R2_HD_UI_IMAGES: which image files are used. 0: none; 1 (default): game textures narrower than 1024 texels
+	// (icons, menu pictures); 2 (all): the full-screen ones (1280-wide splash, legal, title backgrounds) too -- with them
+	// the first splash screen showed only the loading icon.
+	enum { images_none = 0, images_small = 1, images_all = 2 };
+	inline int images_mode(const char* env)
+	{
+		if (!env || !*env) return images_small;
+		std::string v(env);
+		for (auto& c : v) c = static_cast<char>(std::tolower(static_cast<unsigned char>(c)));
+		if (v == "0" || v == "off" || v == "none") return images_none;
+		if (v == "2" || v == "all") return images_all;
+		return images_small;
+	}
+	inline bool image_allowed(int mode, uint32_t w, uint32_t /*h*/)
+	{
+		return mode == images_all || (mode == images_small && w < 1024);
+	}
+
+	// ---- loose images: picture files a game's own image loader decodes and uploads (R2: the TGA / DDS files Scaleform
+	// movies name in GFx DefineExternalImage tags, e.g. the loading icon). Their bytes in guest memory are not the file's,
+	// so an A8R8G8B8 one is keyed by its top level only, in a canonical form: linear A,R,G,B bytes, top row first, one
+	// level. The runtime (VK/VKR2Gfx.cpp, on an A8R8G8B8 miss) brings what it sees back to that form in each layout the
+	// loader may have used (swizzled or linear, byte order, row order) and looks the key up.
+	inline uint64_t image_key(const uint8_t* argb, uint32_t w, uint32_t h)
+	{
+		const auto lay = layout_2d(argb, static_cast<size_t>(w) * h * 4, static_cast<uint16_t>(w), static_cast<uint16_t>(h), GCM_A8R8G8B8 | GCM_LN, 1, w * 4);
+		return hash(lay, static_cast<uint16_t>(w), static_cast<uint16_t>(h), GCM_A8R8G8B8, 1);
+	}
+
+	// Byte orders of a texel in guest memory: canonical byte k (A, R, G, B) = guest byte image_orders[o][k]
+	constexpr uint8_t image_orders[4][4] = { { 0, 1, 2, 3 }, { 3, 2, 1, 0 }, { 3, 0, 1, 2 }, { 0, 3, 2, 1 } };
+	inline const char* image_order_name(uint32_t o) { return o == 0 ? "ARGB" : o == 1 ? "BGRA" : o == 2 ? "RGBA" : "ABGR"; }
+
+	// RSX swizzle (Morton order, x in the even bits; the extra bits of the longer side on top), log2 sides rounded up
+	inline uint32_t swizzle_offset(uint32_t x, uint32_t y, uint32_t lw, uint32_t lh)
+	{
+		uint32_t off = 0, bit = 0;
+		const uint32_t mn = std::min(lw, lh);
+		for (uint32_t i = 0; i < mn; ++i)
+		{
+			off |= ((x >> i) & 1u) << bit++;
+			off |= ((y >> i) & 1u) << bit++;
+		}
+		if (lw > lh) off |= (x >> mn) << bit;
+		else if (lh > lw) off |= (y >> mn) << bit;
+		return off;
+	}
+	inline uint32_t ceil_log2(uint32_t v) { uint32_t r = 0; while ((1u << r) < v) ++r; return r; }
+
+	// One way a loader may have laid a w x h A8R8G8B8 picture out
+	struct image_layout
+	{
+		bool swizzled = false;
+		bool flip = false;       // bottom row first
+		uint32_t order = 0;      // image_orders
+	};
+
+	// Guest level 0 at p (n bytes; linear rows `pitch` bytes apart) -> canonical A,R,G,B; false if the bytes do not cover it
+	inline bool image_canonical(const uint8_t* p, size_t n, uint32_t w, uint32_t h, uint32_t pitch, const image_layout& l, std::vector<uint8_t>& out)
+	{
+		if (!p || !w || !h) return false;
+		const uint32_t lw = ceil_log2(w), lh = ceil_log2(h);
+		if (!l.swizzled && pitch < w * 4) return false;
+		const size_t need = l.swizzled ? static_cast<size_t>(swizzle_offset(w - 1, h - 1, lw, lh)) * 4 + 4 : static_cast<size_t>(h - 1) * pitch + static_cast<size_t>(w) * 4;
+		if (need > n) return false;
+		out.resize(static_cast<size_t>(w) * h * 4);
+		const uint8_t* ord = image_orders[l.order & 3];
+		for (uint32_t y = 0; y < h; ++y)
+		{
+			const uint32_t gy = l.flip ? h - 1 - y : y;
+			uint8_t* d = &out[static_cast<size_t>(y) * w * 4];
+			for (uint32_t x = 0; x < w; ++x, d += 4)
+			{
+				const uint8_t* s = p + (l.swizzled ? static_cast<size_t>(swizzle_offset(x, gy, lw, lh)) * 4 : static_cast<size_t>(gy) * pitch + static_cast<size_t>(x) * 4);
+				d[0] = s[ord[0]];
+				d[1] = s[ord[1]];
+				d[2] = s[ord[2]];
+				d[3] = s[ord[3]];
+			}
+		}
+		return true;
+	}
+
+	// Canonical A,R,G,B (w x h) -> linear guest bytes in layout l's byte and row order (a replacement level; the upload
+	// of a replacement is always linear)
+	inline std::vector<uint8_t> image_to_guest(const std::vector<uint8_t>& argb, uint32_t w, uint32_t h, const image_layout& l)
+	{
+		std::vector<uint8_t> g(argb.size());
+		const uint8_t* ord = image_orders[l.order & 3];
+		for (uint32_t y = 0; y < h; ++y)
+		{
+			const uint8_t* s = &argb[static_cast<size_t>(l.flip ? h - 1 - y : y) * w * 4];
+			uint8_t* d = &g[static_cast<size_t>(y) * w * 4];
+			for (uint32_t x = 0; x < w; ++x, s += 4, d += 4)
+				for (int k = 0; k < 4; ++k) d[ord[k]] = s[k];
+		}
+		return g;
+	}
+
+	// The next mip level of a 4-byte-per-texel image (2x2 box, edges clamped): max(1, w/2) x max(1, h/2)
+	inline std::vector<uint8_t> half_4ch(const std::vector<uint8_t>& src, uint32_t w, uint32_t h)
+	{
+		const uint32_t nw = std::max<uint32_t>(1, w / 2), nh = std::max<uint32_t>(1, h / 2);
+		std::vector<uint8_t> out(static_cast<size_t>(nw) * nh * 4);
+		for (uint32_t y = 0; y < nh; ++y)
+			for (uint32_t x = 0; x < nw; ++x)
+				for (uint32_t c = 0; c < 4; ++c)
+				{
+					uint32_t sum = 0;
+					for (uint32_t dy = 0; dy < 2; ++dy)
+						for (uint32_t dx = 0; dx < 2; ++dx)
+							sum += src[(static_cast<size_t>(std::min(y * 2 + dy, h - 1)) * w + std::min(x * 2 + dx, w - 1)) * 4 + c];
+					out[(static_cast<size_t>(y) * nw + x) * 4 + c] = static_cast<uint8_t>((sum + 2) / 4);
+				}
+		return out;
+	}
+
+	// Tries every layout (the texture's own swizzle first) and returns the first whose canonical key `known` accepts
+	template <class Known>
+	inline bool find_image(const uint8_t* p, size_t n, uint32_t w, uint32_t h, uint32_t pitch, bool swizzled, Known&& known, image_layout& hit, uint64_t& key)
+	{
+		std::vector<uint8_t> c;
+		for (int sw = 0; sw < 2; ++sw)
+			for (int fl = 0; fl < 2; ++fl)
+				for (uint32_t o = 0; o < 4; ++o)
+				{
+					image_layout l;
+					l.swizzled = sw ? !swizzled : swizzled;
+					l.flip = fl != 0;
+					l.order = o;
+					if (!image_canonical(p, n, w, h, sw ? (l.swizzled ? pitch : w * 4) : pitch, l, c)) break;
+					const uint64_t k = image_key(c.data(), w, h);
+					if (known(k))
+					{
+						hit = l;
+						key = k;
+						return true;
+					}
+				}
+		return false;
+	}
+
+	// TGA, types 2 / 10 (true colour, raw / RLE), 24 or 32 bits -> canonical A,R,G,B (24 bits: alpha 255)
+	inline bool decode_tga(const uint8_t* d, size_t n, uint32_t& w, uint32_t& h, std::vector<uint8_t>& argb, std::string* why = nullptr)
+	{
+		const auto fail = [&](const char* m) { if (why) *why = m; return false; };
+		if (!d || n < 18) return fail("not a TGA file");
+		const uint32_t type = d[2], bpp = d[16], desc = d[17];
+		if (type != 2 && type != 10) return fail("not a true-colour TGA");
+		if (bpp != 24 && bpp != 32) return fail("not a 24 / 32-bit TGA");
+		w = static_cast<uint32_t>(d[12] | (d[13] << 8));
+		h = static_cast<uint32_t>(d[14] | (d[15] << 8));
+		if (!w || !h || w > max_side || h > max_side) return fail("bad TGA size");
+		const size_t cmap = d[1] ? static_cast<size_t>(d[5] | (d[6] << 8)) * ((d[7] + 7) / 8) : 0;
+		size_t o = 18 + d[0] + cmap;
+		const uint32_t bp = bpp / 8;
+		const size_t count = static_cast<size_t>(w) * h;
+		std::vector<uint8_t> px(count * 4);
+		size_t i = 0;
+		const auto put = [&](const uint8_t* s)
+		{
+			uint8_t* q = &px[i++ * 4];
+			q[0] = bp == 4 ? s[3] : 255;
+			q[1] = s[2];
+			q[2] = s[1];
+			q[3] = s[0];
+		};
+		if (type == 2)
+		{
+			if (o + count * bp > n) return fail("truncated TGA");
+			for (; i < count; o += bp) put(d + o);
+		}
+		else
+		{
+			while (i < count)
+			{
+				if (o >= n) return fail("truncated TGA");
+				const uint32_t c = d[o++], run = (c & 0x7F) + 1;
+				if (i + run > count) return fail("bad TGA RLE packet");
+				if (c & 0x80)
+				{
+					if (o + bp > n) return fail("truncated TGA");
+					for (uint32_t r = 0; r < run; ++r) put(d + o);
+					o += bp;
+				}
+				else
+				{
+					if (o + static_cast<size_t>(run) * bp > n) return fail("truncated TGA");
+					for (uint32_t r = 0; r < run; ++r, o += bp) put(d + o);
+				}
+			}
+		}
+		// stored bottom row first unless bit 5; right to left if bit 4
+		const bool top = (desc & 0x20) != 0, rtl = (desc & 0x10) != 0;
+		argb.resize(px.size());
+		for (uint32_t y = 0; y < h; ++y)
+			for (uint32_t x = 0; x < w; ++x)
+			{
+				const size_t s = (static_cast<size_t>(top ? y : h - 1 - y) * w + (rtl ? w - 1 - x : x)) * 4;
+				std::memcpy(&argb[(static_cast<size_t>(y) * w + x) * 4], &px[s], 4);
+			}
+		return true;
+	}
+}
diff --git a/rpcs3/Emu/RSX/Common/r3_flush_keep_newer.h b/rpcs3/Emu/RSX/Common/r3_flush_keep_newer.h
new file mode 100644
index 0000000..78bca09
--- /dev/null
+++ b/rpcs3/Emu/RSX/Common/r3_flush_keep_newer.h
@@ -0,0 +1,108 @@
+#pragma once
+// R3PORT RSX_FLUSH_KEEP_NEWER (default on; 0/off/false/no = upstream): flushing a colour/depth surface's framebuffer
+// section to guest memory skips the bytes owned by a newer overlapping surface of the surface store.
+// With Write Color Buffers every render target's memory is locked as a flushable section. R3 renders its bullet
+// rubble textures into 16x16 ARGB targets packed at 0x80-granular addresses (0xc38a....), so a new chunk's target
+// overlaps dead older ones. When the older surface's section is flushed (a CPU fault on the page, a texture upload's
+// read invalidation), upstream writes all of it, also over the newer surface's rows. The newer surface's memory tag
+// then misses, get_merged_texture_memory_region drops it as "CPU-overwritten", and the chunk texture is uploaded from
+// the trampled guest memory: purple / rainbow / checker chunks (r13 [texsrc] OVER lines). Upstream's own exclusions
+// only cover the newer *flushed* sections of the same fault set.
+//
+// The Vulkan imp_flush override (VKTextureCache.h) ignored flush exclusions upstream; with this switch on it honours them
+// (linear sections; swizzled and tiled ones still copy everything and get no keep-newer exclusions).
+// Only the newer surfaces' rows are excluded (not the pitch gaps between them; a newer surface with more than 64 rows
+// over the flushed range is not excluded). The flush is skipped only when the exclusions cover all of it: upstream's
+// address_range::inside(vector) test skipped it as soon as one exclusion lay inside the range (kept when the switch is off).
+//
+// RSX_DEBUG_SMALL_RT=1: [smallrt] lines on stderr for surfaces of at most 64x64 pixels:
+//   FB    the framebuffer setup (Vulkan backend): addresses, layout size, clip/scissor/viewport/window registers
+//   BIND  each surface bound as a render target: address range, size, format, scale, new/reused, and the overlapped
+//         surfaces of the store (newer/older than it, dirty, tag-miss = its memory no longer matches)
+//   DROP  a surface discarded by a texture lookup because its memory tag missed (the bytes were overwritten)
+//   KEEP  a write-back that skipped the ranges of newer surfaces (RSX_FLUSH_KEEP_NEWER)
+//   NFLUSH a CPU/SPU fault next to a small surface's section (RSX_AV_NEIGHBOUR_SKIP) that writes the surface back instead
+//         of releasing it dirty (RSX_AV_NEIGHBOUR_SMALL_FLUSH, port_rbattr.h)
+//   NSKIP the same fault with RSX_AV_NEIGHBOUR_SMALL_FLUSH=0: the small surface is released dirty, its GPU data never
+//         reaches guest memory (the r14 garbage chunk textures)
+// RSX_DEBUG_SMALL_RT_LINES caps the FB/BIND lines (default 4000; at most 60 per second). DROP/KEEP/NFLUSH/NSKIP have their
+// own cap, RSX_DEBUG_SMALL_RT_EVENT_LINES (default 4000; at most 120 per second), so the per-draw lines cannot starve them.
+
+#include "r3_rt_cpu_auth.h"
+
+#include <atomic>
+#include <chrono>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+
+namespace rsx
+{
+	inline bool r3_flush_keep_newer_enabled()
+	{
+		static const bool on = rt_cpu_auth_parse(std::getenv("RSX_FLUSH_KEEP_NEWER"));
+		return on;
+	}
+
+	// True when the exclusions cover all of 'range' (address_range::inside(vector) only tests one element against it)
+	template <typename Range, typename Vector>
+	inline bool r3_fully_excluded(const Range& range, const Vector& exclusions)
+	{
+		Vector rest;
+		rest.merge(range);
+		rest.exclude(exclusions);
+		return rest.valid_count() == 0;
+	}
+
+	inline bool r3_small_rt_debug()
+	{
+		static const bool on = []
+		{
+			const char* e = std::getenv("RSX_DEBUG_SMALL_RT");
+			return e && *e && std::atoi(e) > 0;
+		}();
+		return on;
+	}
+
+	inline bool r3_is_small_surface(std::uint32_t w, std::uint32_t h)
+	{
+		return w <= 64 && h <= 64;
+	}
+
+	// Rate limit for one class of [smallrt] lines (any thread)
+	struct r3_small_rt_limiter
+	{
+		std::uint32_t cap, per_sec;
+		std::atomic<std::uint32_t> total{0}, in_sec{0};
+		std::atomic<std::int64_t> sec{0};
+
+		r3_small_rt_limiter(const char* env, std::uint32_t per_second) : per_sec(per_second)
+		{
+			const char* e = std::getenv(env);
+			cap = (e && *e) ? static_cast<std::uint32_t>(std::strtoul(e, nullptr, 0)) : 4000u;
+		}
+
+		bool may_log()
+		{
+			const std::int64_t now = std::chrono::duration_cast<std::chrono::seconds>(std::chrono::steady_clock::now().time_since_epoch()).count();
+			if (sec.exchange(now) != now) in_sec = 0;
+			if (total.load() >= cap || in_sec.fetch_add(1) >= per_sec) return false;
+			total++;
+			return true;
+		}
+	};
+
+	// FB / BIND lines (per framebuffer setup / surface bind)
+	inline bool r3_small_rt_may_log()
+	{
+		static r3_small_rt_limiter lim("RSX_DEBUG_SMALL_RT_LINES", 60);
+		return lim.may_log();
+	}
+
+	// DROP / KEEP / NFLUSH / NSKIP lines (rare events, separate cap)
+	inline bool r3_small_rt_may_log_event()
+	{
+		static r3_small_rt_limiter lim("RSX_DEBUG_SMALL_RT_EVENT_LINES", 120);
+		return lim.may_log();
+	}
+}
diff --git a/rpcs3/Emu/RSX/Common/r3_rt_cpu_auth.h b/rpcs3/Emu/RSX/Common/r3_rt_cpu_auth.h
new file mode 100644
index 0000000..2ca3084
--- /dev/null
+++ b/rpcs3/Emu/RSX/Common/r3_rt_cpu_auth.h
@@ -0,0 +1,332 @@
+#pragma once
+// R3PORT RSX_RT_CPU_AUTH (default on; 0/off/false/no restores upstream behaviour). Once a colour surface has been
+// flushed to guest memory and not drawn to since, guest memory holds its latest contents plus anything the CPU/SPU
+// wrote after the flush. A format-reinterpreting sample of such a surface is then decoded from guest memory instead of
+// from the surface: the surface's 3-sample memory tag misses SPU writes that leave those 3 qwords unchanged (R3 aim
+// blur, job 419 writes its BGRA8 image over the FP16 light buffer at 0x30030000 and only tag sample 0 lies inside it
+// -> checkerboard). No RPCS3 dependencies, so the tag rules are unit-tested (libs\video\tests\test_rt_cpu_auth.cpp).
+
+#include <algorithm>
+#include <atomic>
+#include <cctype>
+#include <cstdint>
+#include <cstdlib>
+#include <cstring>
+#include <ctime>
+#include <chrono>
+#include <cstdio>
+#include <mutex>
+
+extern "C" volatile long g_port_frame_no; // cellPad.c: game frames
+
+namespace rsx
+{
+	// "frame N hh:mm:ss.mmm" for [rt-cpu] lines (local time: matches the Game Bar recording's file name)
+	inline void rt_log_stamp(char (&buf)[48])
+	{
+		const auto now = std::chrono::system_clock::now();
+		const std::time_t tt = std::chrono::system_clock::to_time_t(now);
+		const long ms = static_cast<long>(std::chrono::duration_cast<std::chrono::milliseconds>(now.time_since_epoch()).count() % 1000);
+		std::tm lt{};
+		localtime_s(&lt, &tt);
+		std::snprintf(buf, sizeof buf, "frame %ld %02d:%02d:%02d.%03ld", static_cast<long>(g_port_frame_no), lt.tm_hour, lt.tm_min, lt.tm_sec, ms);
+	}
+
+	// port_native_parse_bool rules: 1/on/true/yes and 0/off/false/no (any case, surrounding blanks ignored);
+	// unset, empty or anything else = on (the default)
+	inline bool rt_cpu_auth_parse(const char* e)
+	{
+		if (!e) return true;
+		const auto blank = [](char c) { return c == ' ' || c == '\t' || c == '\r' || c == '\n'; };
+		while (blank(*e)) e++;
+		std::size_t n = std::strlen(e);
+		while (n && blank(e[n - 1])) n--;
+		const auto is = [&](const char* w)
+		{
+			if (std::strlen(w) != n) return false;
+			for (std::size_t i = 0; i < n; i++)
+				if (std::tolower(static_cast<unsigned char>(e[i])) != w[i]) return false;
+			return true;
+		};
+		return !(is("0") || is("off") || is("false") || is("no"));
+	}
+
+	inline bool rt_cpu_auth_enabled()
+	{
+		static const bool on = rt_cpu_auth_parse(std::getenv("RSX_RT_CPU_AUTH"));
+		return on;
+	}
+
+	// R3PORT RSX_DETILE_GUEST_SRC (default on; 0/off/false/no = upstream): tiled detiles and zero-copy texture uploads
+	// stage guest memory in an upload heap instead of the shared DMA block (VKTexture.cpp), and the auxiliary upload heap
+	// is frame-snapshot managed instead of being reset on every present (VKGSRender.cpp / VKHelpers.cpp).
+	inline bool detile_guest_src_enabled()
+	{
+		static const bool on = rt_cpu_auth_parse(std::getenv("RSX_DETILE_GUEST_SRC"));
+		return on;
+	}
+
+	// R2PORT RSX_GUEST_SRC_MMFLUSH (default on; 0/off/false/no = off): before a RSX_DETILE_GUEST_SRC snapshot, apply
+	// the deferred page protections (Host/MM.cpp) queued for the source range. The texture section protects itself
+	// (create_new_texture) before the upload, but mm_protect only queues it until the submit's mm_flush, so guest
+	// writes between the CPU memcpy and that submit neither faulted nor invalidated the section: the cached texture kept
+	// a partial snapshot (R2 boot splash text missing / black letters). Upstream's DMA path reads at GPU time instead.
+	inline bool guest_src_mmflush_enabled()
+	{
+		static const bool on = rt_cpu_auth_parse(std::getenv("RSX_GUEST_SRC_MMFLUSH"));
+		return on;
+	}
+
+	// R2PORT RSX_TEXDECODE_LINEAR_CPU (default on; 0/off/false/no = GPU decode for linear textures too): linear
+	// (non-swizzled) CPU-memory texture uploads byteswap on the CPU instead of the zero-copy scratch + compute path.
+	// Swizzled uploads keep the GPU deswizzle. The R2 boot splash text (1280x720 linear D8R8G8B8, format 0x9e) went
+	// missing with the GPU path only (RSX_GPU_TEXDECODE=0 alone fixed it); see VKTexture.cpp upload_image.
+	inline bool texdecode_linear_cpu_enabled()
+	{
+		static const bool on = rt_cpu_auth_parse(std::getenv("RSX_TEXDECODE_LINEAR_CPU"));
+		return on;
+	}
+
+	// R3PORT RSX_RT_CPU_WRITTEN (default on with RSX_RT_CPU_AUTH; 0/off/false/no = tags only): a flushed colour surface
+	// whose guest bytes changed after its last flush is CPU-owned for a format-reinterpreting sample even when the GPU
+	// drew to it after that flush. R3 ADS: job 419 can run before the RSX has finished the light buffer (label 77
+	// "restored over a late RSX release"); its BGRA8 output then sits in guest memory while the surface is GPU-newer, and
+	// the composite reinterpreted the FP16 surface as BGRA8 (magenta noise / black bands).
+	inline bool rt_cpu_written_enabled()
+	{
+		static const bool on = rt_cpu_auth_parse(std::getenv("RSX_RT_CPU_WRITTEN"));
+		return on;
+	}
+
+	// RSX_RT_CPU_WRITTEN_UNFLUSH (default on; 0/off/false/no = off): the framebuffer sections of surfaces dropped as
+	// CPU-written are marked dirty before the texture upload's read invalidation (texture_cache.h r3_unflush_cpu_owned),
+	// so that invalidation does not flush the stale surface (any draw re-locks it) over the CPU/SPU bytes being decoded
+	// RSX_RT_FP16_GUEST (default on; 0 = off): an FP16 colour surface sampled as an 8-bit RGBA texture of the
+	// same pitch is decoded from guest memory whenever that is authoritative (flushed and not drawn since, or
+	// CPU/SPU bytes written over the sampled range since the flush) and its stale surface is not
+	// flushed over them (R3: the light buffer 0x30030000 holds job 419's BGRA8 output; reinterpreting the GPU
+	// surface's FP16 lighting as BGRA8 = the ADS purple frames)
+	inline bool rt_fp16_guest_enabled()
+	{
+		static const bool on = rt_cpu_auth_parse(std::getenv("RSX_RT_FP16_GUEST"));
+		return on;
+	}
+
+	inline bool rt_is_rgba8_sample(std::uint32_t gcm_format)
+	{
+		const std::uint32_t f = gcm_format & ~0x60u;   // CELL_GCM_TEXTURE_LN | CELL_GCM_TEXTURE_UN
+		return f == 0x85u || f == 0x9Eu;               // A8R8G8B8, D8R8G8B8
+	}
+
+	inline bool rt_cpu_written_unflush_enabled()
+	{
+		static const bool on = rt_cpu_auth_parse(std::getenv("RSX_RT_CPU_WRITTEN_UNFLUSH"));
+		return on;
+	}
+
+	// FNV-1a over 64 evenly spaced 8-byte samples plus the first and last 8 bytes; never 0 for a valid range
+	inline std::uint64_t rt_guest_hash(const std::uint8_t* base, std::uint32_t length)
+	{
+		if (!base || length < 8) return 0;
+		std::uint64_t h = 0xcbf29ce484222325ull;
+		const auto mix = [&](std::uint32_t off)
+		{
+			std::uint64_t v;
+			std::memcpy(&v, base + off, 8);
+			h = (h ^ v) * 0x100000001b3ull;
+		};
+		const std::uint32_t last = length - 8;
+		const std::uint32_t step = std::max<std::uint32_t>(8, (last / 64) & ~7u);
+		mix(0);
+		for (std::uint32_t off = step; off < last; off += step) mix(off);
+		mix(last);
+		return h ? h : 1;
+	}
+
+	// RSX_RT_CPU_WRITTEN baselines: per flushed surface range (keyed by start/length + the flush's tag, so a destroyed
+	// surface's entry is never consulted for another one), 16 block hashes taken right after the flush. A flush of any
+	// framebuffer section re-baselines the overlapping blocks of the other entries, so only CPU/SPU writes (not another
+	// surface's flush in a different format) make a block differ; a block that already differed right before such a
+	// flush (rt_written_pre_flush) keeps a sticky changed bit, so interleaved surfaces (pitch 8192: 960x704 FP16 at
+	// 0x30030000 and 480x704 at 0x30030f00 share every block) do not hide each other's CPU/SPU writes. Only the blocks
+	// under the sampled range are compared.
+	constexpr std::uint32_t rt_written_nblocks = 16;
+	constexpr std::uint32_t rt_written_nslots = 32;
+
+	struct rt_written_entry
+	{
+		std::uint32_t start = 0, len = 0;
+		std::uint64_t flush_tag = 0, lru = 0;
+		std::uint64_t blocks[rt_written_nblocks] = {};
+		std::uint32_t changed = 0;   // sticky per-block bits (rt_written_pre_flush)
+	};
+
+	struct rt_written_table
+	{
+		std::mutex m;
+		std::uint64_t clock = 0;
+		rt_written_entry e[rt_written_nslots];
+	};
+
+	inline rt_written_table& rt_written_tab()
+	{
+		static rt_written_table t;
+		return t;
+	}
+
+	inline std::uint32_t rt_written_block_size(std::uint32_t len)
+	{
+		return std::max<std::uint32_t>(8, ((len + rt_written_nblocks - 1) / rt_written_nblocks + 7) & ~7u);
+	}
+
+	// hash of block i of the guest range [start, start + len) (mem = guest address 0)
+	inline std::uint64_t rt_written_block_hash(const std::uint8_t* mem, std::uint32_t start, std::uint32_t len, std::uint32_t i)
+	{
+		const std::uint32_t bs = rt_written_block_size(len), s = i * bs;
+		if (s >= len) return 1;
+		const std::uint32_t n = std::min(len - s, bs);
+		return n < 8 ? 1 : rt_guest_hash(mem + start + s, n);
+	}
+
+	// blocks of e overlapping [lo, hi): first / one-past-last index (first == last: none)
+	inline void rt_written_block_span(const rt_written_entry& e, std::uint32_t lo, std::uint32_t hi, std::uint32_t& first, std::uint32_t& last)
+	{
+		first = last = 0;
+		const std::uint64_t end = std::uint64_t(e.start) + e.len;
+		const std::uint64_t l = std::max<std::uint64_t>(lo, e.start), h = std::min<std::uint64_t>(hi, end);
+		if (l >= h) return;
+		const std::uint32_t bs = rt_written_block_size(e.len);
+		first = std::uint32_t((l - e.start) / bs);
+		last = std::min<std::uint32_t>(rt_written_nblocks, std::uint32_t((h - e.start + bs - 1) / bs));
+	}
+
+	// right before a framebuffer section [start, start + len) is flushed: blocks of the other entries it overlaps that
+	// already differ from their baseline were changed by the CPU/SPU; remember that across the re-baseline
+	inline void rt_written_pre_flush(const std::uint8_t* mem, std::uint32_t start, std::uint32_t len)
+	{
+		if (!mem || !len) return;
+		auto& t = rt_written_tab();
+		std::lock_guard lock(t.m);
+		for (auto& e : t.e)
+		{
+			if (!e.len || (e.start == start && e.len == len)) continue;
+			std::uint32_t first, last;
+			rt_written_block_span(e, start, start + len, first, last);
+			for (std::uint32_t i = first; i < last; i++)
+				if (!(e.changed >> i & 1u) && e.blocks[i] != rt_written_block_hash(mem, e.start, e.len, i)) e.changed |= 1u << i;
+		}
+	}
+
+	// on_flush of a framebuffer section: re-baseline the other entries' blocks under [start, start + len), then store
+	// this surface's baseline
+	inline void rt_written_note_flush(const std::uint8_t* mem, std::uint32_t start, std::uint32_t len, std::uint64_t flush_tag)
+	{
+		if (!mem || !len) return;
+		auto& t = rt_written_tab();
+		std::lock_guard lock(t.m);
+		rt_written_entry* slot = nullptr;
+		for (auto& e : t.e)
+		{
+			if (e.len && e.start == start && e.len == len)
+			{
+				slot = &e;
+				continue;
+			}
+			if (!e.len) continue;
+			std::uint32_t first, last;
+			rt_written_block_span(e, start, start + len, first, last);
+			for (std::uint32_t i = first; i < last; i++) e.blocks[i] = rt_written_block_hash(mem, e.start, e.len, i);
+		}
+		if (!slot)
+		{
+			slot = &t.e[0];
+			for (auto& e : t.e)
+			{
+				if (!e.len) { slot = &e; break; }
+				if (e.lru < slot->lru) slot = &e;
+			}
+		}
+		slot->start = start;
+		slot->len = len;
+		slot->flush_tag = flush_tag;
+		slot->lru = ++t.clock;
+		slot->changed = 0;
+		for (std::uint32_t i = 0; i < rt_written_nblocks; i++) slot->blocks[i] = rt_written_block_hash(mem, start, len, i);
+	}
+
+	// The CPU/SPU changed guest bytes under [lo, hi) since the flush (flush_tag) of the surface range [start, start + len)
+	inline bool rt_written_check(const std::uint8_t* mem, std::uint32_t start, std::uint32_t len, std::uint64_t flush_tag, std::uint32_t lo, std::uint32_t hi)
+	{
+		if (!mem || !len || !flush_tag) return false;
+		auto& t = rt_written_tab();
+		std::lock_guard lock(t.m);
+		for (auto& e : t.e)
+		{
+			if (!e.len || e.start != start || e.len != len) continue;
+			if (e.flush_tag != flush_tag) return false;
+			e.lru = ++t.clock;
+			std::uint32_t first, last;
+			rt_written_block_span(e, lo, hi, first, last);
+			for (std::uint32_t i = first; i < last; i++)
+				if ((e.changed >> i & 1u) || e.blocks[i] != rt_written_block_hash(mem, start, len, i)) return true;
+			return false;
+		}
+		return false;
+	}
+
+	// Per-surface detection state (render_target_descriptor::r3_cpu_written_tag): 0 = none since the flush, else the
+	// surface's write tag when the CPU write was first seen; a GPU draw after that consumes it (rt_written_consumed),
+	// so a CPU write after the last flush does not keep the surface CPU-owned on later frames. Reset by the next flush.
+	constexpr std::uint64_t rt_written_consumed = ~0ull;
+
+	// true = decode from guest memory. written_tag is updated in place.
+	inline bool r3_rt_cpu_written_state(std::uint64_t& written_tag, std::uint64_t last_use_tag, bool guest_changed)
+	{
+		if (written_tag == rt_written_consumed) return false;
+		if (written_tag && last_use_tag > written_tag)
+		{
+			written_tag = rt_written_consumed;
+			return false;
+		}
+		if (!guest_changed) return false;
+		if (!written_tag) written_tag = std::max<std::uint64_t>(last_use_tag, 1);
+		return true;
+	}
+
+	// Bumped on every framebuffer section flush (texture_cache_utils.h on_flush)
+	inline std::atomic<std::uint64_t>& rt_flush_epoch()
+	{
+		static std::atomic<std::uint64_t> epoch{ 0 };
+		return epoch;
+	}
+
+	// The surface was flushed to guest memory and not written by the GPU since (its write tag is still the flush's)
+	inline bool r3_rt_flushed_unwritten(std::uint64_t last_use_tag, std::uint64_t cpu_flush_tag)
+	{
+		return cpu_flush_tag != 0 && last_use_tag <= cpu_flush_tag;
+	}
+
+	template <typename T>
+	inline bool r3_rt_needs_retag(const T* surface)
+	{
+		return surface && r3_rt_flushed_unwritten(surface->last_use_tag, surface->r3_cpu_flush_tag);
+	}
+
+	// Colour surface whose latest contents are in guest memory (the format check is the caller's)
+	inline bool r3_rt_cpu_owned_tags(bool is_depth, std::uint64_t last_use_tag, std::uint64_t cpu_flush_tag)
+	{
+		return !is_depth && r3_rt_flushed_unwritten(last_use_tag, cpu_flush_tag);
+	}
+
+	// surface_store::on_write early-out. Besides upstream's tag test, the store re-tags after any flush (epoch) and
+	// while a write-enabled bound surface is still tagged at its flush: the epoch alone can be consumed by a draw that
+	// writes no surface (a depth-only pass after the flush), and the colour draws after it would keep the stale tag.
+	// any_write_enabled_needs_retag() is only called when the other tests allow the skip.
+	template <typename F>
+	inline bool r3_rt_on_write_skip(bool tags_current, std::uint64_t epoch, std::uint64_t seen_epoch, F&& any_write_enabled_needs_retag)
+	{
+		if (!tags_current) return false;
+		if (!rt_cpu_auth_enabled()) return true;
+		return epoch == seen_epoch && !any_write_enabled_needs_retag();
+	}
+}
diff --git a/rpcs3/Emu/RSX/Common/r3_tex_diag.h b/rpcs3/Emu/RSX/Common/r3_tex_diag.h
new file mode 100644
index 0000000..dba4e38
--- /dev/null
+++ b/rpcs3/Emu/RSX/Common/r3_tex_diag.h
@@ -0,0 +1,129 @@
+#pragma once
+
+// R3PORT R3_TEX_DIAG: texture-cache diagnostics for short colour corruption (scratch\r3_tunnel_tex.md).
+// Unset/0 = off: every hook is a single cached-bool test and nothing else changes.
+//   R3_TEX_DIAG=1    log only: stale hits (a locked, clean shader-read section whose guest bytes changed since its upload
+//                    without the cache seeing the write), writes into textures sampled in the last 2 frames, swizzle and
+//                    size mismatches, render-target reinterpretation, R2_FBO_COMMIT_FLUSH skips, plus a 1 s summary.
+//   R3_TEX_DIAG=heal same logging, and a stale hit is treated as dirty (unprotect + re-upload) instead of being sampled.
+// Output goes to stdout ([texdiag] lines in run.log). Per-event lines are capped; the summary is not.
+
+#include <util/types.hpp>
+#include <algorithm>
+#include <atomic>
+#include <chrono>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+
+namespace rsx::r3texdiag
+{
+	enum mode_t : int { off = 0, log = 1, heal = 2 };
+
+	inline int mode()
+	{
+		static const int m = []
+		{
+			const char* e = std::getenv("R3_TEX_DIAG");
+			if (!e || !*e || e[0] == '0')
+				return int{off};
+			if (!std::strcmp(e, "heal") || e[0] == '2')
+				return int{heal};
+			return int{log};
+		}();
+		return m;
+	}
+
+	inline bool on() { return mode() != off; }
+
+	enum counter : int
+	{
+		c_upload, c_verify, c_stale, c_healed, c_inval_write, c_inval_read, c_inval_fbo, c_write_bound,
+		c_commit_skip, c_swizzle, c_dims, c_rt_convert, c_rt_cpu, c_count
+	};
+
+	inline std::atomic<u64>* counters()
+	{
+		static std::atomic<u64> c[c_count]{};
+		return c;
+	}
+
+	inline std::atomic<u32>& frame()
+	{
+		static std::atomic<u32> f{ 1 };
+		return f;
+	}
+
+	inline double seconds()
+	{
+		static const auto t0 = std::chrono::steady_clock::now();
+		return std::chrono::duration<double>(std::chrono::steady_clock::now() - t0).count();
+	}
+
+	// True while this event kind may still print a line (first 64 per kind)
+	inline bool may_log(counter k)
+	{
+		static std::atomic<u32> n[c_count]{};
+		return n[k].fetch_add(1, std::memory_order_relaxed) < 64;
+	}
+
+	inline void bump(counter k, u64 v = 1) { counters()[k].fetch_add(v, std::memory_order_relaxed); }
+
+	// 64-bit FNV-1a over 64 evenly spaced 8-byte samples plus the first and last 8 bytes. Reads the always-writable
+	// guest view so a protected page never faults. A partial overwrite smaller than the sample spacing can be missed,
+	// but streamed texture data replaces whole mips.
+	inline u64 sample_hash(const u8* base, u32 length)
+	{
+		if (!base || length < 8)
+			return 0;
+
+		u64 h = 0xcbf29ce484222325ull;
+		const auto mix = [&](u32 off)
+		{
+			u64 v;
+			std::memcpy(&v, base + off, 8);
+			h = (h ^ v) * 0x100000001b3ull;
+		};
+
+		const u32 last = length - 8;
+		mix(0);
+		const u32 step = std::max<u32>(8, (last / 64) & ~7u);
+		for (u32 off = step; off < last; off += step)
+			mix(off);
+		mix(last);
+		return h;
+	}
+
+	// Called once per frame end (RSX thread); prints the 1 s summary when anything changed.
+	inline void on_frame_end()
+	{
+		frame().fetch_add(1, std::memory_order_relaxed);
+
+		static double last_t = 0;
+		static u64 last[c_count]{};
+		const double t = seconds();
+		if (t - last_t < 1.0)
+			return;
+		last_t = t;
+
+		u64 now[c_count];
+		bool changed = false;
+		for (int i = 0; i < c_count; ++i)
+		{
+			now[i] = counters()[i].load(std::memory_order_relaxed);
+			changed |= (now[i] != last[i]) && i != c_verify && i != c_upload;
+		}
+
+		if (changed)
+		{
+			const auto d = [&](int i) { return static_cast<unsigned long long>(now[i] - last[i]); };
+			std::printf("[texdiag] t=%.1f f=%u 1s: uploads %llu verified %llu STALE %llu healed %llu | inval write %llu read %llu fbo %llu"
+				" write-while-bound %llu | commit-skip %llu swizzle %llu dims %llu rt-convert %llu rt-cpu-auth %llu\n",
+				t, frame().load(), d(c_upload), d(c_verify), d(c_stale), d(c_healed), d(c_inval_write), d(c_inval_read), d(c_inval_fbo),
+				d(c_write_bound), d(c_commit_skip), d(c_swizzle), d(c_dims), d(c_rt_convert), d(c_rt_cpu));
+			std::fflush(stdout);
+		}
+
+		std::memcpy(last, now, sizeof(last));
+	}
+}
