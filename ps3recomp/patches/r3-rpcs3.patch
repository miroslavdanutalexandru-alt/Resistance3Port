--- /dev/null
+++ b/rpcs3/Emu/RSX/VK/VKR2Upscaler.cpp
@@ -0,0 +1,12032 @@
+// R2PORT: Resistance 2 port addition (not upstream RPCS3). See VKR2Upscaler.h.
+//
+// How it works (all inert unless RSX_FSR=1/2/4; 4 = Intel XeSS, VKR2XeSS.cpp, FSR 3.1 fallback):
+//  * Scene detection: every draw is tallied by (colour target, depth target). At each flip the pair with
+//    the most depth-tested draws becomes next frame's "scene".
+//  * Jitter: draws into the scene colour target or writing the scene depth get a Halton(2,3) sub-pixel offset added to the viewport
+//    offset of RPCS3's scale_offset matrix (vertex env), so no shader changes are needed.
+//  * Motion: the RSX vertex program of scene draws is run on the CPU for 4 basis points to get its
+//    affine object->clip matrix M. For each draw also seen last frame, R = M_prev * M_cur^-1; the most
+//    common R (static geometry) is the camera motion. A compute pass turns depth + R into motion vectors.
+//  * The upscaler (FSR 3.1 or DLAA, native resolution) runs when the scene colour is first read
+//    (post-processing / blit) or at flip, and its result is copied back into the scene colour target.
+
+#include "stdafx.h"
+#include "VKR2Upscaler.h"
+#include "VKR2XeSS.h"
+#include "VKR2FrameGen.h" // R2PORT frame generation
+#include "Emu/RSX/port_r2preload.h" // R2PORT: r2preload::driver_call (issue #10/#23)
+#include "VKR2DeformLogic.h" // R2PORT: RSX_DLSS_OBJMV_DEFORM capture policy (unit-tested in project\tests\fg_logic_test.cpp)
+#include "VKR2DlssQuality.h" // PORT_DLSS_BIAS_MASK / PORT_DLSS_RESET_* helpers (unit-tested in scratch\dlss_quality)
+#include "../../../../../../../project/port_native_summary.h" // R2PORT: on/off switch words of the promoted defaults
+#include "Emu/RSX/port_r2aa_memo.h" // R2PORT: RSX_AA_DRAW_MEMO (unit-tested in scratch\r2aa_memo)
+#include "VKGSRender.h"
+#include "VKCompute.h"
+#include "VKHelpers.h"
+#include "VKRenderPass.h"
+#include "VKFramebuffer.h"
+#include "VKResourceManager.h"
+#include "VKFormats.h"
+#include "vkutils/barriers.h"
+#include "vkutils/sampler.h"
+
+#include "Emu/RSX/rsx_methods.h"
+#include "Emu/system_config.h"
+#include "Emu/RSX/NV47/HW/context_accessors.define.h"
+
+#ifdef R2PORT_HAVE_FFX
+#include "ffx_api/ffx_api.h"
+#include "ffx_api/ffx_upscale.h"
+#include "ffx_api/vk/ffx_api_vk.h"
+#endif
+
+#include <cstdarg>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <cmath>
+#include <algorithm>
+#include <atomic>
+#include <bit>
+#include <chrono>
+#include <ctime>
+#include <condition_variable>
+#include <mutex>
+#include <optional>
+#include <thread>
+#include <string>
+#include <unordered_map>
+#include <unordered_set>
+#include <xmmintrin.h>
+
+#ifdef _WIN32
+#include <windows.h>
+#endif
+
+// R2PORT (PORT_DLSS_RESET_HITCH_MS): bumped by the port (project/stubs.cpp r2_frame_period) on every pause and resume
+extern "C" volatile long g_port_pause_gen;
+volatile long g_port_pause_gen = 0;
+
+extern bool g_r2_trace_now;
+
+namespace vk { bool r2_vprun_fast_active(); } // VKDraw.cpp (RSX_VPRUN_FAST)
+
+// R2PORT (issue #10/#23): the object motion pipelines built on their worker threads go through r2preload::driver_call:
+// serialised with the game's pipelines on AMD (PORT_PIPE_SERIAL), SEH-guarded, named in the crash breadcrumb
+static VkPipeline r2_ups_create_pipe(VkDevice dev, const VkGraphicsPipelineCreateInfo& info, const char* stage)
+{
+	VkPipeline pipe = VK_NULL_HANDLE;
+	struct args_t { VkDevice dev; const VkGraphicsPipelineCreateInfo* info; VkPipeline* out; } args{ dev, &info, &pipe };
+	long res = VK_SUCCESS;
+	if (!r2preload::driver_call([](void* p) -> long
+	{
+		auto* a = static_cast<args_t*>(p);
+		return static_cast<long>(vkCreateGraphicsPipelines(a->dev, VK_NULL_HANDLE, 1, a->info, nullptr, a->out));
+	}, &args, &res, true, stage) || res != VK_SUCCESS)
+	{
+		return VK_NULL_HANDLE;
+	}
+	return pipe;
+}
+
+namespace
+{
+	// Lines are queued and written by a background thread: a pass-log dump (R2_UPS_LOG) is a few hundred lines in
+	// one frame, and a printf + fflush each on the render thread stalled that frame by ~20-100 ms.
+	struct r2log_queue
+	{
+		std::mutex mtx;
+		std::condition_variable cv;
+		std::string buf;
+		bool started = false;
+	};
+	r2log_queue& r2log_q()
+	{
+		static r2log_queue* q = new r2log_queue(); // never destroyed: the writer thread outlives static teardown
+		return *q;
+	}
+	void r2log(const char* fmt, ...)
+	{
+		char buf[1024];
+		va_list ap;
+		va_start(ap, fmt);
