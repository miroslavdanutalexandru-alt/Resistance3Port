+			else g_dlss.set_mask(VK_NULL_HANDLE, VK_NULL_HANDLE, 0);
+		}
+		ok = g_dlss.eval(cmd,
+			st.color->value, plain_view(st.color.get())->value, st.color->info.format,
+			st.depth->value, plain_view(st.depth.get())->value, st.depth->info.format,
+			st.mv->value, plain_view(st.mv.get())->value, st.mv->info.format,
+			st.out->value, plain_view(st.out.get())->value, st.out->info.format,
+			st.res_ow, st.res_oh, jx, jy, st.vw, st.vh, reset ? 1 : 0, ms) == 1; // the whole (capacity) output: RSX_AA_DYNRES
+		if (!ok)
+		{
+			g_dlss.failed = true;
+			if (g_dlss.release) g_dlss.release();
