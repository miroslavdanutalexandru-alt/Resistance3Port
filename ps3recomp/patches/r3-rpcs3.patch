+		// RSX_AA_SPLIT=0: frame boundary at the flip (R2). Default: R3 renders the next frame's geometry pre-pass
+		// before the flip, so the logical frame ends after the material pass (scene-pair run without depth writes).
+		bool split = true;
+		// RSX_AA_STRICT=0: old window rule (every target with the scene's size renders at the reduced scale). Default:
+		// only binds of the scene colour or depth address do; other same-size targets (light/shadow buffers,
+		// render-to-texture, SPU-read buffers) keep the full scale, and the upscaled result is written back only into
+		// the surface it was computed from.
+		bool strict = true;
+		// RSX_AA_JITTER_SCOPE=0: jitter every depth-tested draw on the scene depth (old). Default 1: only draws into the
+		// scene colour target or that write the scene depth; depth-read-only passes into other targets (light volumes,
+		// shadow masks, utility passes) are drawn unjittered: they shade per pixel from the already jittered G-buffer.
+		int jscope = 1;
+		float jsign_y = 1.f;   // RSX_AA_JITTER_SIGN_Y=-1 flips only the vertical jitter handed to FSR/DLSS
+		// RSX_AA_MIPBIAS: texture LOD bias added to scene colour-target draws inside the reduced-scale window.
+		// Default (unset or "output"): NVIDIA's DLSS rule log2(render height / upscaled output height), e.g. -1 at 50%:
+		// the jittered samples read the texture detail of the output, which DLSS accumulates (alpha-tested wire fences keep
+		// their strands instead of losing them to coarse alpha mips). "display": log2(render / min(output, window)), never
+		// positive (the 17:38 build: 0 for res=3 into 900p). "auto" = log2(RSX_UPSCALE), or a number (0 = the original).
+		float mipbias = 0.f;
+		int mipbias_mode = 1; // 0 fixed (mipbias), 1 output (NVIDIA), 2 display
+		bool atest = false;       // RSX_AA_MIPBIAS_ATEST=on|<bias>: alpha-tested/KIL draws keep at least atest_floor bias (opt-in)
+		float atest_floor = 0.f;
+		// RSX_AA_CLASSIFY=0: old scene vote (most depth-tested draws). Default: the scene pair must also have a colour
+		// target larger than 512 and at least half the largest candidate's area, a depth buffer that is written, and
+		// colour targets sampled by a later pass are preferred.
+		bool classify = true;
+		int passlog = 0;       // R2_UPS_LOG=N: log every pass (bind) of every N-th frame: targets, size, draws, depth test/write
+		// RSX_AA_LINK=0: off. Default: with RSX_AA_STRICT, the scene-size colour targets the scene material draws sample
+		// (light pre-pass accumulation, SSAO) and the depth bound with them also render at the reduced scale (learned
+		// from the previous frame). At full scale they shade per pixel from the reduced, jittered G-buffer and the
+		// material pass then samples them at another pixel grid: patches at depth/normal edges that move with the jitter.
+		bool link = true;
+		// RSX_AA_LINK_JITTER: draws in the linked passes (light volumes, light quads) get the scene jitter, so they
+		// rasterise and reconstruct positions on the same sub-pixel grid as the jittered depth/G-buffer they read.
+		// 1 (default): all except depth writes (per-pixel depth copies); 2: all; 0: none.
+		int link_jit = 1;
+		// RSX_AA_POST_JITTER: after the scene window, full-scale draws that depth-test (without writing) against a depth
+		// buffer rendered reduced and jittered (scene or linked depth, upscaled on rebind) get that depth's jitter, so
+		// their depth test (occlusion tests, glow sprites) hits the same geometry every frame. Experimental, 0 (default): off;
+		// 1: only draws with colour writes off; 2: all such draws (also shifts full-screen post passes: the image wobbles).
+		// (R3 keeps ZPASS pixel counting on for every draw, so an active query is no signal.)
+		int post_jit = 0;
+		// RSX_DLSS_MASK_LO / _HI: moving-object mask sensitivity (relative depth deviation from the reprojected
+		// previous frame): no effect below LO, full at HI. Lower = more animated surfaces favour the current frame.
+		float mask_lo = 0.03f, mask_hi = 0.15f;
+		// RSX_DLSS_MASK_THIN=<n> (default 4; 0 = old): the moving-object mask skips pixels with fewer than n of their 8
+		// neighbours at their own depth (thin wires / strands: jitter makes them flicker in the depth test, not motion)
+		u32 mask_thin = 4;
