index 0000000..9f877a4
--- /dev/null
+++ b/rpcs3/Emu/RSX/VK/VKR2Fossilize.cpp
@@ -0,0 +1,456 @@
+// R2PORT (R2_FOSSILIZE): recording and replay of the renderer's Vulkan pipeline state with Valve's Fossilize
+// (ps3recomp/third_party/fossilize, MIT). Built in the r2_fossilize object library against Fossilize's headers.
+
+#include "VKR2Fossilize.h"
+#include "../port_r2pipe.h"     // foz_entry_name
+#include "../port_r2preload.h"  // issue #10: breadcrumb, quarantine, SEH guard, AMD serialisation
+
+#include "fossilize.hpp"
+#include "fossilize_db.hpp"
+
+#include <chrono>
+#include <condition_variable>
+#include <cstdio>
+#include <deque>
+#include <memory>
+#include <mutex>
+#include <string>
+#include <thread>
+#include <vector>
+
+#ifdef _WIN32
+#ifndef WIN32_LEAN_AND_MEAN
+#define WIN32_LEAN_AND_MEAN
+#endif
+#ifndef NOMINMAX
+#define NOMINMAX
+#endif
+#include <windows.h>
+#endif
+
+namespace r2foz
+{
+	std::atomic<bool> g_recording{ false };
+	std::atomic<unsigned> g_push_descriptor_max{ 0 };
+
+	namespace
+	{
+		void low_priority()
+		{
+#ifdef _WIN32
+			SetThreadPriority(GetCurrentThread(), THREAD_PRIORITY_BELOW_NORMAL);
+#endif
+		}
+
+		const void* find_pnext(const void* chain, VkStructureType type)
+		{
+			for (auto* s = static_cast<const VkBaseInStructure*>(chain); s; s = s->pNext)
+			{
+				if (s->sType == type) return s;
+			}
+			return nullptr;
+		}
+
+		// ------------------------------------------------------------------ recording
+		std::mutex g_rec_lock;
+		std::unique_ptr<Fossilize::DatabaseInterface> g_rec_db;
+		std::unique_ptr<Fossilize::StateRecorder> g_rec;
+		std::atomic<uint32_t> g_rec_pipelines{ 0 };
+		std::atomic<uint32_t> g_rec_failed{ 0 };
+
+		template <typename F>
+		void with_recorder(F&& f)
+		{
+			if (!recording()) return;
+			std::lock_guard lock(g_rec_lock);
+			if (g_rec && !f(*g_rec)) ++g_rec_failed;
+		}
+	}
+
+	bool record_init(const char* db_path)
+	{
+		std::lock_guard lock(g_rec_lock);
+		if (g_rec) return true;
+
+		std::unique_ptr<Fossilize::DatabaseInterface> db(Fossilize::create_stream_archive_database(db_path, Fossilize::DatabaseMode::Append));
+		if (!db) return false;
+
+		auto rec = std::make_unique<Fossilize::StateRecorder>();
+		rec->set_database_enable_compression(true);
+		rec->set_database_enable_checksum(true);
+		rec->init_recording_thread(db.get());
+
+		g_rec_db = std::move(db);
+		g_rec = std::move(rec);
+		g_rec_pipelines = 0;
+		g_rec_failed = 0;
+		g_recording = true;
+		return true;
+	}
+
+	void record_shutdown()
+	{
+		std::unique_ptr<Fossilize::StateRecorder> rec;
+		std::unique_ptr<Fossilize::DatabaseInterface> db;
+		{
+			std::lock_guard lock(g_rec_lock);
+			if (!g_rec) return;
+			g_recording = false;
+			rec = std::move(g_rec);
+			db = std::move(g_rec_db);
+		}
+
+		rec.reset(); // joins the recording thread, which flushes the database
+		db.reset();
+		std::printf("[r2foz] record: %u pipelines recorded this session (%u objects could not be recorded)\n",
+			g_rec_pipelines.load(), g_rec_failed.load());
+		std::fflush(stdout);
+	}
+
+	void record_shader_module(VkShaderModule module, const VkShaderModuleCreateInfo& info)
+	{
+		with_recorder([&](Fossilize::StateRecorder& r) { return r.record_shader_module(module, info); });
+	}
+
+	void record_descriptor_set_layout(VkDescriptorSetLayout layout, const VkDescriptorSetLayoutCreateInfo& info)
+	{
+		with_recorder([&](Fossilize::StateRecorder& r) { return r.record_descriptor_set_layout(layout, info); });
+	}
+
+	void record_pipeline_layout(VkPipelineLayout layout, const VkPipelineLayoutCreateInfo& info)
+	{
+		with_recorder([&](Fossilize::StateRecorder& r) { return r.record_pipeline_layout(layout, info); });
+	}
+
+	void record_render_pass(VkRenderPass pass, const VkRenderPassCreateInfo& info)
+	{
+		with_recorder([&](Fossilize::StateRecorder& r) { return r.record_render_pass(pass, info); });
+	}
+
+	void record_graphics_pipeline(VkPipeline pipeline, const VkGraphicsPipelineCreateInfo& info)
+	{
+		// Pipelines linked from libraries are not recorded: the monolithic pipeline and the parts are
+		if (find_pnext(info.pNext, VK_STRUCTURE_TYPE_PIPELINE_LIBRARY_CREATE_INFO_KHR)) return;
+		with_recorder([&](Fossilize::StateRecorder& r)
+		{
+			const bool ok = r.record_graphics_pipeline(pipeline, info, nullptr, 0);
+			if (ok) ++g_rec_pipelines;
+			return ok;
+		});
+	}
+
+	void record_compute_pipeline(VkPipeline pipeline, const VkComputePipelineCreateInfo& info)
+	{
+		with_recorder([&](Fossilize::StateRecorder& r)
+		{
+			const bool ok = r.record_compute_pipeline(pipeline, info, nullptr, 0);
+			if (ok) ++g_rec_pipelines;
+			return ok;
+		});
+	}
+
+	// ---------------------------------------------------------------------- replay
+	namespace
+	{
+		struct replay_job
+		{
+			const VkGraphicsPipelineCreateInfo* graphics = nullptr;
+			const VkComputePipelineCreateInfo* compute = nullptr;
+			Fossilize::Hash hash = 0;
+		};
+
+		struct replayer final : Fossilize::StateCreatorInterface
+		{
+			VkDevice dev = VK_NULL_HANDLE;
+			VkPhysicalDevice gpu = VK_NULL_HANDLE;
+			VkPipelineCache cache = VK_NULL_HANDLE;
+			bool allow_libraries = false;
+			bool allow_provoking_vertex = false;
+
+			std::vector<VkSampler> samplers;
+			std::vector<VkDescriptorSetLayout> set_layouts;
+			std::vector<VkPipelineLayout> layouts;
+			std::vector<VkShaderModule> modules;
+			std::vector<VkRenderPass> passes;
+
+			std::mutex lock;
+			std::condition_variable cv_work;
+			std::condition_variable cv_space;
+			std::deque<replay_job> queue;
+			bool parse_done = false;
+			std::atomic<bool>* stop = nullptr;
+			std::atomic<uint32_t> created{ 0 };
+			std::atomic<uint32_t> failed{ 0 };
+			uint32_t skipped = 0;
+
+			bool format_ok(VkFormat fmt, VkFormatFeatureFlags need)
+			{
+				if (!gpu || fmt == VK_FORMAT_UNDEFINED) return true;
+				VkFormatProperties props{};
+				vkGetPhysicalDeviceFormatProperties(gpu, fmt, &props);
+				return (props.optimalTilingFeatures & need) == need;
+			}
+
+			void push(const replay_job& job)
+			{
+				std::unique_lock lk(lock);
+				while (queue.size() >= 64 && !stop->load()) cv_space.wait_for(lk, std::chrono::milliseconds(50));
+				queue.push_back(job);
+				cv_work.notify_one();
+			}
+
+			bool enqueue_create_sampler(Fossilize::Hash, const VkSamplerCreateInfo* info, VkSampler* out) override
+			{
+				if (vkCreateSampler(dev, info, nullptr, out) != VK_SUCCESS) return false;
+				samplers.push_back(*out);
+				return true;
+			}
+
+			bool enqueue_create_descriptor_set_layout(Fossilize::Hash, const VkDescriptorSetLayoutCreateInfo* info, VkDescriptorSetLayout* out) override
+			{
+				if ((info->flags & VK_DESCRIPTOR_SET_LAYOUT_CREATE_PUSH_DESCRIPTOR_BIT_KHR) && !(g_push_descriptor_max.load(std::memory_order_relaxed))) return false;
+				if (vkCreateDescriptorSetLayout(dev, info, nullptr, out) != VK_SUCCESS) return false;
+				set_layouts.push_back(*out);
+				return true;
+			}
+
+			bool enqueue_create_pipeline_layout(Fossilize::Hash, const VkPipelineLayoutCreateInfo* info, VkPipelineLayout* out) override
+			{
+				if ((info->flags & VK_PIPELINE_LAYOUT_CREATE_INDEPENDENT_SETS_BIT_EXT) && !allow_libraries) return false;
+				if (vkCreatePipelineLayout(dev, info, nullptr, out) != VK_SUCCESS) return false;
+				layouts.push_back(*out);
+				return true;
+			}
+
+			bool enqueue_create_shader_module(Fossilize::Hash, const VkShaderModuleCreateInfo* info, VkShaderModule* out) override
+			{
+				if (vkCreateShaderModule(dev, info, nullptr, out) != VK_SUCCESS) return false;
+				modules.push_back(*out);
+				return true;
+			}
+
+			bool enqueue_create_render_pass(Fossilize::Hash, const VkRenderPassCreateInfo* info, VkRenderPass* out) override
+			{
+				// A database recorded on another GPU may use attachment formats this one lacks (e.g. D24S8)
+				for (uint32_t i = 0; i < info->attachmentCount; ++i)
+				{
+					const VkFormat f = info->pAttachments[i].format;
+					const bool depth = f == VK_FORMAT_D16_UNORM || f == VK_FORMAT_D32_SFLOAT || f == VK_FORMAT_D24_UNORM_S8_UINT ||
+						f == VK_FORMAT_D32_SFLOAT_S8_UINT || f == VK_FORMAT_D16_UNORM_S8_UINT || f == VK_FORMAT_X8_D24_UNORM_PACK32 || f == VK_FORMAT_S8_UINT;
+					if (!format_ok(f, depth ? VK_FORMAT_FEATURE_DEPTH_STENCIL_ATTACHMENT_BIT : VK_FORMAT_FEATURE_COLOR_ATTACHMENT_BIT)) return false;
+				}
+				if (vkCreateRenderPass(dev, info, nullptr, out) != VK_SUCCESS) return false;
+				passes.push_back(*out);
+				return true;
+			}
+
+			bool enqueue_create_render_pass2(Fossilize::Hash, const VkRenderPassCreateInfo2*, VkRenderPass*) override
+			{
+				return false; // the renderer only uses VkRenderPassCreateInfo
+			}
+
+			bool enqueue_create_compute_pipeline(Fossilize::Hash hash, const VkComputePipelineCreateInfo* info, VkPipeline* out) override
+			{
+				*out = reinterpret_cast<VkPipeline>(static_cast<uintptr_t>(hash)); // placeholder; nothing derives from it
+				replay_job job;
+				job.compute = info;
+				job.hash = hash;
+				push(job);
+				return true;
+			}
+
+			bool enqueue_create_graphics_pipeline(Fossilize::Hash hash, const VkGraphicsPipelineCreateInfo* info, VkPipeline* out) override
+			{
+				*out = reinterpret_cast<VkPipeline>(static_cast<uintptr_t>(hash));
+				const bool linked = find_pnext(info->pNext, VK_STRUCTURE_TYPE_PIPELINE_LIBRARY_CREATE_INFO_KHR) != nullptr;
+				const bool library = (info->flags & VK_PIPELINE_CREATE_LIBRARY_BIT_KHR) != 0;
+				const bool provoking = info->pRasterizationState &&
+					find_pnext(info->pRasterizationState->pNext, VK_STRUCTURE_TYPE_PIPELINE_RASTERIZATION_PROVOKING_VERTEX_STATE_CREATE_INFO_EXT);
+				if (linked || (library && !allow_libraries) || (provoking && !allow_provoking_vertex))
+				{
+					++skipped;
+					return true;
+				}
+
+				replay_job job;
+				job.graphics = info;
+				job.hash = hash;
+				push(job);
+				return true;
+			}
+
+			bool enqueue_create_raytracing_pipeline(Fossilize::Hash, const VkRayTracingPipelineCreateInfoKHR*, VkPipeline*) override
+			{
+				return false;
+			}
+
+			void worker()
+			{
+				low_priority();
+				for (;;)
+				{
+					replay_job job;
+					{
+						std::unique_lock lk(lock);
+						while (queue.empty() && !parse_done && !stop->load()) cv_work.wait_for(lk, std::chrono::milliseconds(50));
+						if (stop->load() || queue.empty()) return;
+						job = queue.front();
+						queue.pop_front();
+						cv_space.notify_one();
+					}
+
+					// R2PORT (issue #10): as the shader preload: a pipeline that crashed the driver before is skipped, the
+					// breadcrumb names the one being built, the call is SEH-guarded and serialised on AMD, and a fault
+					// stops the replay (and the preload) for the session
+					const std::string name = ::r2pipe::foz_entry_name(job.hash);
+					if (r2preload::faulted()) return;
+					if (r2preload::is_quarantined(name))
+					{
+						++failed;
+						continue;
+					}
+
+					VkPipeline pipe = VK_NULL_HANDLE;
+					long res_l = VK_ERROR_UNKNOWN;
+					bool ok;
+					{
+						const r2preload::link_scope scope(name, true);
+						struct args_t { VkDevice dev; VkPipelineCache cache; const replay_job* job; VkPipeline* out; } args{ dev, cache, &job, &pipe };
+						ok = r2preload::driver_call([](void* p) -> long
+						{
+							auto* a = static_cast<args_t*>(p);
+							return static_cast<long>(a->job->graphics
+								? vkCreateGraphicsPipelines(a->dev, a->cache, 1, a->job->graphics, nullptr, a->out)
+								: vkCreateComputePipelines(a->dev, a->cache, 1, a->job->compute, nullptr, a->out));
+						}, &args, &res_l, r2preload::guard_active());
+					}
+					if (!ok)
+					{
+						++failed;
+						stop->store(true);
+						cv_space.notify_all();
+						return;
+					}
+					const VkResult res = static_cast<VkResult>(res_l);
+					if (res == VK_SUCCESS && pipe)
+					{
+						++created;
+						vkDestroyPipeline(dev, pipe, nullptr);
+					}
+					else
+					{
+						++failed;
+					}
+				}
+			}
+
+			void destroy_objects()
+			{
+				for (auto p : passes) vkDestroyRenderPass(dev, p, nullptr);
+				for (auto m : modules) vkDestroyShaderModule(dev, m, nullptr);
+				for (auto l : layouts) vkDestroyPipelineLayout(dev, l, nullptr);
+				for (auto l : set_layouts) vkDestroyDescriptorSetLayout(dev, l, nullptr);
+				for (auto s : samplers) vkDestroySampler(dev, s, nullptr);
+				passes.clear(); modules.clear(); layouts.clear(); set_layouts.clear(); samplers.clear();
+			}
+		};
+
+		std::mutex g_replay_lock;
+		std::thread g_replay_thread;
+		std::atomic<bool> g_replay_stop{ false };
+
+		void replay_main(VkDevice dev, VkPipelineCache cache, std::string path, unsigned threads, replay_progress progress,
+			bool allow_libraries, bool allow_provoking_vertex, VkPhysicalDevice gpu)
+		{
+			low_priority();
+			const auto t0 = std::chrono::steady_clock::now();
+			replay_stats stats;
+
+			std::unique_ptr<Fossilize::DatabaseInterface> db(Fossilize::create_stream_archive_database(path.c_str(), Fossilize::DatabaseMode::ReadOnly));
+			if (!db || !db->prepare())
+			{
+				std::printf("[r2foz] replay: cannot open %s\n", path.c_str());
+				std::fflush(stdout);
+				return;
+			}
+
+			auto rep = std::make_unique<Fossilize::StateReplayer>();
+			rep->set_resolve_derivative_pipeline_handles(false);
+
+			replayer c;
+			c.dev = dev;
+			c.gpu = gpu;
+			c.cache = cache;
+			c.allow_libraries = allow_libraries;
+			c.allow_provoking_vertex = allow_provoking_vertex;
+			c.stop = &g_replay_stop;
+
+			std::vector<std::thread> workers;
+			for (unsigned i = 0; i < threads; ++i) workers.emplace_back([&c] { c.worker(); });
+
+			std::vector<uint8_t> blob;
+			uint32_t parse_failed = 0;
+			for (const Fossilize::ResourceTag tag : { Fossilize::RESOURCE_GRAPHICS_PIPELINE, Fossilize::RESOURCE_COMPUTE_PIPELINE })
+			{
+				size_t count = 0;
+				if (!db->get_hash_list_for_resource_tag(tag, &count, nullptr)) continue;
+				std::vector<Fossilize::Hash> hashes(count);
+				if (!db->get_hash_list_for_resource_tag(tag, &count, hashes.data())) continue;
+				stats.total += static_cast<uint32_t>(count);
+
+				for (const Fossilize::Hash h : hashes)
+				{
+					if (g_replay_stop.load()) break;
+					size_t size = 0;
+					if (!db->read_entry(tag, h, &size, nullptr, Fossilize::PAYLOAD_READ_NO_FLAGS)) { ++parse_failed; continue; }
+					blob.resize(size);
+					if (!db->read_entry(tag, h, &size, blob.data(), Fossilize::PAYLOAD_READ_NO_FLAGS) ||
+						!rep->parse(c, db.get(), blob.data(), size))
+					{
+						++parse_failed;
+					}
+				}
+			}
+
+			{
+				std::lock_guard lk(c.lock);
+				c.parse_done = true;
+			}
+			c.cv_work.notify_all();
+			c.cv_space.notify_all();
+			for (auto& w : workers) w.join();
+
+			// The replayer's create infos and these objects are only needed by the pipelines above
+			c.destroy_objects();
+			rep.reset();
+
+			stats.created = c.created.load();
+			stats.failed = c.failed.load() + parse_failed;
+			stats.skipped = c.skipped;
+			stats.ms = std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - t0).count();
+			if (progress) progress(stats, !g_replay_stop.load());
+		}
+	}
+
+	bool replay_start(VkDevice dev, VkPhysicalDevice gpu, VkPipelineCache cache, const char* db_path, unsigned threads,
+		replay_progress progress, bool allow_libraries, bool allow_provoking_vertex)
+	{
+		std::lock_guard lock(g_replay_lock);
+		if (g_replay_thread.joinable()) return true;
+
+		if (FILE* f = std::fopen(db_path, "rb")) std::fclose(f);
+		else return false;
+
+		g_replay_stop = false;
+		g_replay_thread = std::thread(replay_main, dev, cache, std::string(db_path), threads ? threads : 1u, progress,
+			allow_libraries, allow_provoking_vertex, gpu);
+		return true;
+	}
+
+	void replay_stop()
+	{
+		std::lock_guard lock(g_replay_lock);
+		g_replay_stop = true;
+		if (g_replay_thread.joinable()) g_replay_thread.join();
+	}
+}
diff --git a/rpcs3/Emu/RSX/VK/VKR2Fossilize.h b/rpcs3/Emu/RSX/VK/VKR2Fossilize.h
new file mode 100644
index 0000000..d9b6d17
--- /dev/null
+++ b/rpcs3/Emu/RSX/VK/VKR2Fossilize.h
@@ -0,0 +1,50 @@
+#pragma once
+
+// R2PORT (R2_FOSSILIZE): Valve Fossilize (MIT, ps3recomp/third_party/fossilize) recording and replay of the
+// renderer's Vulkan pipeline state. VKR2Fossilize.cpp is compiled against Fossilize's own headers; this interface
+// only uses core Vulkan types.
+
+#include <atomic>
+#include <cstdint>
+#include <vulkan/vulkan_core.h>
+
+namespace r2foz
+{
+	extern std::atomic<bool> g_recording;
+	// RSX_VK_PUSH_DESC: maxPushDescriptors in use (0 = off); set at device creation, replay skips push layouts when 0
+	extern std::atomic<unsigned> g_push_descriptor_max;
+
+	inline bool recording() { return g_recording.load(std::memory_order_relaxed); }
+
+	// Record mode: appends every recorded object to the stream archive at db_path (.foz)
+	bool record_init(const char* db_path);
+	void record_shutdown();
+
+	void record_shader_module(VkShaderModule module, const VkShaderModuleCreateInfo& info);
+	void record_descriptor_set_layout(VkDescriptorSetLayout layout, const VkDescriptorSetLayoutCreateInfo& info);
+	void record_pipeline_layout(VkPipelineLayout layout, const VkPipelineLayoutCreateInfo& info);
+	void record_render_pass(VkRenderPass pass, const VkRenderPassCreateInfo& info);
+	void record_graphics_pipeline(VkPipeline pipeline, const VkGraphicsPipelineCreateInfo& info);
+	void record_compute_pipeline(VkPipeline pipeline, const VkComputePipelineCreateInfo& info);
+
+	struct replay_stats
+	{
+		uint32_t total = 0;    // graphics + compute pipelines in the database
+		uint32_t created = 0;  // compiled (or found in the VkPipelineCache)
+		uint32_t failed = 0;   // parse or creation failed (e.g. a feature this device lacks)
+		uint32_t skipped = 0;  // linked from pipeline libraries (not replayed)
+		double ms = 0;
+	};
+
+	using replay_progress = void (*)(const replay_stats& stats, bool finished);
+
+	// Replays every pipeline in db_path on low-priority threads into the given VkPipelineCache (the pipelines are
+	// destroyed again; the point is the warm driver and pipeline caches). Returns false if the database is missing.
+	// Pipeline libraries / independent-set layouts need allow_libraries (GPL enabled on the device), provoking-vertex
+	// state needs VK_EXT_provoking_vertex; render passes with attachment formats the GPU lacks are skipped.
+	bool replay_start(VkDevice dev, VkPhysicalDevice gpu, VkPipelineCache cache, const char* db_path, unsigned threads,
+		replay_progress progress, bool allow_libraries, bool allow_provoking_vertex);
+
+	// Stops and joins the replay, destroys its objects. Must run before the device or the pipeline cache goes away.
+	void replay_stop();
+}
diff --git a/rpcs3/Emu/RSX/VK/VKR2FrameGen.cpp b/rpcs3/Emu/RSX/VK/VKR2FrameGen.cpp
new file mode 100644
index 0000000..9d4aa00
--- /dev/null
+++ b/rpcs3/Emu/RSX/VK/VKR2FrameGen.cpp
@@ -0,0 +1,2650 @@
+// R2PORT: Resistance 2/3 port addition (not upstream RPCS3).
+// Frame generation, two backends:
+//  * NVIDIA DLSS Frame Generation through Streamline (manual hooking): sl.interposer.dll is loaded at run time
+//    from the exe folder and only its Vulkan proxies (instance, device, surface, swapchain, present) are used.
+//  * AMD FidelityFX FSR 3 frame interpolation (amd_fidelityfx_vk.dll, official FidelityFX API 1.1.4 headers):
+//    its frame-generation swapchain replaces RPCS3's swapchain; 2x only. Used for GPUs without DLSS-G.
+// The game's HUD is split from the scene in the RSX command stream (r2fg_on_draw) so that frame generation gets a
+// HUD-less colour buffer and a UI colour+alpha buffer and re-composites the UI on every generated frame.
+// Off unless R2_DLSS_FG (or R3_/R1_) is 2, 3, 4 or fsr3; R2_FG_BACKEND=auto|dlss|fsr3. PORT_FG=dlssg|fsr3|off overrides them,
+// PORT_FG_HUDLESS=0|1 the HUD split, PORT_FG_PACE=vrr|auto|off the FSR 3 pacer (pure logic: VKR2FrameGenLogic.h).
+// Design, switches and limitations: scratch/framegen_vk.md, scratch/framegen_fsr3.md.
+#include "stdafx.h"
+#include "VKR2FrameGen.h"
+#include "VKR2FrameGenLogic.h"
+#include "VKGSRender.h"
+#include "VKCompute.h"
+#include "VKHelpers.h"
+#include "VKRenderPass.h"
+#include "VKResourceManager.h"
+#include "VKR2Upscaler.h"
+#include "VKR2PcExtras.h"
+#include "Emu/RSX/port_r2preload.h" // R2PORT: r2preload::stage_scope (issue #10/#23)
+#include "vkutils/sampler.h"
+#include "Emu/RSX/rsx_methods.h"
+#include "Emu/RSX/NV47/HW/context_accessors.define.h"
+
+#include <cstdio>
+#include <cstdarg>
+#include <cctype>
+#include <cstdlib>
+#include <cstring>
+#include <cwchar>
+#include <cwctype>
+#include <cmath>
+#include <algorithm>
+#include <atomic>
+#include <memory>
+#include <mutex>
+#include <string>
+#include <vector>
+
+#ifdef _WIN32
+#include <windows.h>
+#include "VKR2FgDiag.h" // R2_FG_DIAG / R3_FG_DIAG
+#endif
+
+extern "C"
+{
+	volatile int g_r2fg_active = 0;
+	int port_pds_fixed(void); // VKPresent.cpp: display sync's fixed-refresh pacing is on
+
+	// game side (project/stubs.cpp, r?_pcport.cpp); builds without them link the defaults below
+	extern volatile unsigned long long g_r2_look_ms;
+	extern volatile int g_r2pc_paused;
+	int port_local_players(void);
+	// libs/input/cellPad.c: player input and the in-play / pause-menu ticks (menu detection that also works in vehicles)
+	extern volatile int g_ml_fed_rx, g_ml_fed_ry;
+	extern volatile unsigned long long g_kbm_mouse_abs;
+	extern volatile unsigned long long g_port_play_ms;
+	extern volatile int g_port_pause_ui; // always defined by cellPad.c; no default here (R2's rsx_eng_mt.inc has its own)
+	volatile unsigned long long r2fg_look_ms_default = 0;
+	volatile int r2fg_paused_default = 0;
+	int r2fg_local_players_default(void) { return 1; }
+	volatile int r2fg_int_default = 0;
+	volatile unsigned long long r2fg_u64_default = 0;
+	// project/r?_pcextra.cpp: photo-mode HUD hide, 0 off / 1 enabled / 2 enabled and photo mode on
+	extern volatile int g_port_photo_hud;
+}
+#ifdef _WIN32
+#pragma comment(linker, "/alternatename:g_port_photo_hud=r2fg_int_default")
+#pragma comment(linker, "/alternatename:g_r2_look_ms=r2fg_look_ms_default")
+#pragma comment(linker, "/alternatename:g_r2pc_paused=r2fg_paused_default")
+#pragma comment(linker, "/alternatename:port_local_players=r2fg_local_players_default")
+#pragma comment(linker, "/alternatename:g_ml_fed_rx=r2fg_int_default")
+#pragma comment(linker, "/alternatename:g_ml_fed_ry=r2fg_int_default")
+#pragma comment(linker, "/alternatename:g_kbm_mouse_abs=r2fg_u64_default")
+#pragma comment(linker, "/alternatename:g_port_play_ms=r2fg_u64_default")
+#endif
+
+namespace
+{
+	const char* penv(const char* name)
+	{
+		for (const char* pre : { "R2_", "R3_", "R1_" })
+		{
+			char full[96];
+			std::snprintf(full, sizeof(full), "%s%s", pre, name);
+			const char* e = std::getenv(full);
+			if (e && *e) return e;
+		}
+		return nullptr;
+	}
+	int penv_int(const char* name, int def) { const char* e = penv(name); return e ? std::atoi(e) : def; }
+
+	bool same_word(const char* a, const char* b)
+	{
+		if (!a || !b) return false;
+		for (; *a && *b; ++a, ++b)
+			if (std::tolower(static_cast<unsigned char>(*a)) != std::tolower(static_cast<unsigned char>(*b))) return false;
+		return *a == *b;
+	}
+
+	struct fg_config
+	{
+		int want = 0;          // requested multiplier: 0 off, 2, 3, 4
+		int backend = 0;       // R2_FG_BACKEND: 0 auto (DLSS-G, else FSR 3), 1 DLSS-G only, 2 FSR 3 only
+		bool hud = true;       // split the HUD from the scene (R2_DLSS_FG_HUD)
+		bool hud_debug = false; // tint the detected HUD / overlays on screen (R2_DLSS_FG_HUD_DEBUG)
+		bool debug = false;    // verbose Streamline log (R2_DLSS_FG_DEBUG)
+		int debug_level = 0;   // R2_DLSS_FG_DEBUG=2: FSR 3 tear lines and reset indicators
+		bool menu_off = true;  // off while the game's look code is idle (menus, movies, loading)
+		bool cap = true;       // Reflex frame cap so rendered x N stays under the refresh rate
+		bool yflip = true;     // clip-space y up for the Streamline matrices
+		int cut_reset = 1;     // R2_DLSS_FG_CUT_RESET: reset on cuts the upscaler holds (pfg_cut_reset)
+		bool cam_ident = false; // R2_DLSS_FG_CAM_IDENT=1: identity clipToPrevClip (R1's constants; the vectors carry all motion)
+		float depth_sep = 40.f; // R2_DLSS_FG_DEPTH_SEP: minRelativeLinearDepthObjectSeparation (Streamline default 40)
+		int limit_fps = 0; // R2_DLSS_FG_LIMIT_FPS: cap on presented fps with DLSS-G on (0 = refresh-based cap); evens out an uneven base rate
+		unsigned gap = 2; // R?_DLSS_FG_GAP: scene-less frames mid-play that resume without the warm-up (pfg_streak_gap; 0 = old)
+		int pace = PFG_PACE_VRR; // FSR 3 present pacer (PORT_FG_PACE)
+	};
+
+	const fg_config& fgcfg()
+	{
+		static const fg_config c = []
+		{
+			fg_config r;
+			// R2_DLSS_FG=fsr3 (the launcher's "FSR 3 2x") is 2x on the FSR 3 backend
+			int bad_mult = 0, bad_backend = 0;
+			pfg_parse_vk_legacy(penv("DLSS_FG"), penv("FG_BACKEND"), &r.want, &r.backend, &bad_mult, &bad_backend);
+			if (bad_mult) std::fprintf(stderr, "[fg-vk] R2_DLSS_FG=%d ignored (use 0, 2, 3, 4 or fsr3)\n", bad_mult);
+			if (bad_backend) std::fprintf(stderr, "[fg-vk] R2_FG_BACKEND=%s ignored (use auto, dlss or fsr3)\n", penv("FG_BACKEND"));
+			// PORT_FG=dlssg|fsr3|off overrides both; unset / auto keeps them
+			const char* sel = std::getenv("PORT_FG");
+			const int s = pfg_parse_sel(sel);
+			if (s == PFG_SEL_BAD) std::fprintf(stderr, "[fg-vk] PORT_FG=%s ignored (use dlssg, fsr3, off or auto)\n", sel);
+			else if (s != PFG_SEL_LEGACY)
+			{
+				pfg_apply_sel(s, &r.want, &r.backend);
+				std::fprintf(stderr, "[fg-vk] PORT_FG=%s: %s\n", sel, !r.want ? "frame generation off" : r.backend == PFG_BE_FSR3 ? "FSR 3 2x" : "DLSS Frame Generation");
+			}
+			r.pace = pfg_parse_pace(std::getenv("PORT_FG_PACE"));
+			r.hud = pfg_hudless(std::getenv("PORT_FG_HUDLESS"), penv_int("DLSS_FG_HUD", 1) != 0);
+			r.hud_debug = penv_int("DLSS_FG_HUD_DEBUG", 0) != 0;
+			r.debug_level = penv_int("DLSS_FG_DEBUG", 0);
+			r.debug = r.debug_level != 0;
+			r.menu_off = penv_int("DLSS_FG_MENU_OFF", 1) != 0;
+			r.cap = penv_int("DLSS_FG_CAP", 1) != 0;
+			r.yflip = penv_int("DLSS_FG_YFLIP", 1) != 0;
+			r.cut_reset = penv_int("DLSS_FG_CUT_RESET", 1);
+			r.gap = static_cast<unsigned>(std::clamp(penv_int("DLSS_FG_GAP", 2), 0, 8));
+			r.cam_ident = penv_int("DLSS_FG_CAM_IDENT", 0) != 0;
+		r.limit_fps = std::clamp(penv_int("DLSS_FG_LIMIT_FPS", 0), 0, 1000);
+		if (r.limit_fps) std::fprintf(stderr, "[fg-vk] DLSS_FG_LIMIT_FPS=%d (presented frames)\n", r.limit_fps);
+			if (const char* e = penv("DLSS_FG_DEPTH_SEP")) { const float v = static_cast<float>(std::atof(e)); if (v > 0.f && v < 10000.f) r.depth_sep = v; }
+			if (r.cam_ident || r.depth_sep != 40.f) std::fprintf(stderr, "[fg-vk] DLSS_FG_CAM_IDENT=%d DLSS_FG_DEPTH_SEP=%.1f\n", r.cam_ident ? 1 : 0, r.depth_sep);
+			return r;
+		}();
+		return c;
+	}
+}
+
+namespace vk
+{
+	bool r2fg_cut_reset(int kind)
+	{
+		if (!pfg_cut_reset(fgcfg().cut_reset, kind) || !fgcfg().want) return false;
+		static int logged = 0;
+		if (logged < 8)
+		{
+			++logged;
+			std::fprintf(stderr, "[fg-vk] camera cut held by the upscaler (%s motion): frame generation reset (R2_DLSS_FG_CUT_RESET=%d)\n",
+				kind == PFG_CUT_UNTRUSTED ? "untrusted" : "voted", fgcfg().cut_reset);
+		}
+		return true;
+	}
+
+	void r2fg_diag_cut(double motion, double parallax, u32 members, u32 matched)
+	{
+#ifdef _WIN32
+		r2fgdiag::note_cut(motion, parallax, members, matched);
+#endif
+	}
+
+	void r2fg_diag_upscaler(bool upscaler_reset, u32 why, int cut_kind, bool cut_reset)
+	{
+#ifdef _WIN32
+		if (fgcfg().want) r2fgdiag::note_upscaler(upscaler_reset, why, cut_kind, cut_reset);
+#endif
+	}
+}
+
+#if defined(_WIN32) && defined(R2PORT_HAVE_SL)
+
+// sl_pcl.h 2.14.16 has 'using to_underlying = std::to_underlying;' under C++23, which is not valid C++; let the
+// headers take their C++20 branch (their own to_underlying template) and restore the value afterwards.
+#pragma clang diagnostic push
+#pragma clang diagnostic ignored "-Wbuiltin-macro-redefined"
+#if __cplusplus > 202002L
+#undef __cplusplus
+#define __cplusplus 202002L
+#define R2FG_RESTORE_CPLUSPLUS 1
+#endif
+#include "sl.h"
+#include "sl_dlss_g.h"
+#include "sl_reflex.h"
+#include "sl_pcl.h"
+#ifdef R2FG_RESTORE_CPLUSPLUS
+#undef __cplusplus
+#define __cplusplus 202302L
+#endif
+#pragma clang diagnostic pop
+
+#ifdef R2PORT_HAVE_FFX
+#include "ffx_api/ffx_api.h"
+#include "ffx_api/ffx_framegeneration.h"
+#include "ffx_api/vk/ffx_api_vk.h"
+#include <chrono>
+#include <cstddef>
+#include <thread>
+
+// The FSR 3 frame-generation descriptors are passed by pointer into amd_fidelityfx_vk.dll (FidelityFX API 1.1.4).
+// Their layouts, checked against the DLL's own headers, must not drift.
+#if defined(_M_X64) || defined(__x86_64__)
+static_assert(sizeof(ffxApiHeader) == 16);
+static_assert(sizeof(FfxApiResource) == 48);
+static_assert(sizeof(FfxApiResourceDescription) == 32);
+static_assert(sizeof(VkQueueInfoFFXAPI) == 24);
+static_assert(sizeof(VkSwapchainCreateInfoKHR) == 104);
+static_assert(sizeof(ffxCreateBackendVKDesc) == 40 && offsetof(ffxCreateBackendVKDesc, vkDeviceProcAddr) == 32);
+static_assert(sizeof(ffxCreateContextDescFrameGenerationSwapChainVK) == 248);
+static_assert(offsetof(ffxCreateContextDescFrameGenerationSwapChainVK, createInfo) == 48);
+static_assert(offsetof(ffxCreateContextDescFrameGenerationSwapChainVK, gameQueue) == 152);
+static_assert(offsetof(ffxCreateContextDescFrameGenerationSwapChainVK, imageAcquireQueue) == 224);
+static_assert(sizeof(ffxConfigureDescFrameGenerationSwapChainRegisterUiResourceVK) == 72);
+static_assert(offsetof(ffxConfigureDescFrameGenerationSwapChainRegisterUiResourceVK, flags) == 64);
+static_assert(sizeof(ffxDispatchDescFrameGenerationSwapChainWaitForPresentsVK) == 16);
+static_assert(sizeof(ffxQueryDescSwapchainReplacementFunctionsVK) == 72);
+static_assert(offsetof(ffxQueryDescSwapchainReplacementFunctionsVK, pOutGetLastPresentCountFFXAPI) == 64);
+static_assert(sizeof(ffxCreateContextDescFrameGeneration) == 40 && offsetof(ffxCreateContextDescFrameGeneration, backBufferFormat) == 36);
+static_assert(sizeof(ffxConfigureDescFrameGeneration) == 144);
+static_assert(offsetof(ffxConfigureDescFrameGeneration, frameGenerationEnabled) == 56);
+static_assert(offsetof(ffxConfigureDescFrameGeneration, allowAsyncWorkloads) == 57);
+static_assert(offsetof(ffxConfigureDescFrameGeneration, HUDLessColor) == 64);
+static_assert(offsetof(ffxConfigureDescFrameGeneration, flags) == 112);
+static_assert(offsetof(ffxConfigureDescFrameGeneration, onlyPresentGenerated) == 116);
+static_assert(offsetof(ffxConfigureDescFrameGeneration, generationRect) == 120);
+static_assert(offsetof(ffxConfigureDescFrameGeneration, frameID) == 136);
+static_assert(sizeof(ffxDispatchDescFrameGeneration) == 312);
+static_assert(offsetof(ffxDispatchDescFrameGeneration, reset) == 268 && offsetof(ffxDispatchDescFrameGeneration, frameID) == 304);
+static_assert(sizeof(ffxDispatchDescFrameGenerationPrepare) == 184);
+static_assert(offsetof(ffxDispatchDescFrameGenerationPrepare, frameTimeDelta) == 64);
+static_assert(offsetof(ffxDispatchDescFrameGenerationPrepare, unused_reset) == 68);
+static_assert(offsetof(ffxDispatchDescFrameGenerationPrepare, cameraNear) == 72);
+static_assert(offsetof(ffxDispatchDescFrameGenerationPrepare, depth) == 88);
+static_assert(offsetof(ffxDispatchDescFrameGenerationPrepare, motionVectors) == 136);
+static_assert(sizeof(ffxDispatchDescFrameGenerationPrepareCameraInfo) == 64);
+static_assert(offsetof(ffxDispatchDescFrameGenerationPrepareCameraInfo, cameraForward) == 52);
+#endif
+#endif
+
+namespace
+{
+	void fglog(const char* fmt, ...)
+	{
+		char buf[512];
+		va_list ap;
+		va_start(ap, fmt);
+		std::vsnprintf(buf, sizeof(buf), fmt, ap);
+		va_end(ap);
+		std::fprintf(stderr, "[fg-vk] %s\n", buf);
+	}
+
+	struct sl_state
+	{
+		// Streamline entry points (sl.interposer.dll)
+		HMODULE dll = nullptr;
+		PFun_slInit* fn_init = nullptr;
+		PFun_slShutdown* fn_shutdown = nullptr;
+		PFun_slIsFeatureSupported* fn_supported = nullptr;
+		PFun_slGetFeatureFunction* fn_feature = nullptr;
+		PFun_slGetNewFrameToken* fn_token = nullptr;
+		PFun_slSetTagForFrame* fn_tag = nullptr;
+		PFun_slSetConstants* fn_consts = nullptr;
+		PFN_vkGetInstanceProcAddr gipa = nullptr;
+		PFN_vkGetDeviceProcAddr gdpa = nullptr;
+		PFun_slDLSSGGetState* fn_g_state = nullptr;
+		PFun_slDLSSGSetOptions* fn_g_options = nullptr;
+		PFun_slReflexSleep* fn_r_sleep = nullptr;
+		PFun_slReflexSetOptions* fn_r_options = nullptr;
+		PFun_slPCLSetMarker* fn_marker = nullptr;
+
+		// proxies
+		PFN_vkDestroySurfaceKHR p_destroy_surface = nullptr;
+		PFN_vkCreateWin32SurfaceKHR p_create_surface = nullptr;
+		PFN_vkCreateSwapchainKHR p_create_sc = nullptr;
+		PFN_vkDestroySwapchainKHR p_destroy_sc = nullptr;
+		PFN_vkGetSwapchainImagesKHR p_sc_images = nullptr;
+		PFN_vkAcquireNextImageKHR p_acquire = nullptr;
+		PFN_vkQueuePresentKHR p_present = nullptr;
+		PFN_vkDeviceWaitIdle p_wait_idle = nullptr;
+
+		bool tried = false;
+		bool inited = false;      // slInit succeeded
+		VkInstance instance = VK_NULL_HANDLE; // created through the proxy
+		VkDevice device = VK_NULL_HANDLE;     // created through the proxy
+		VkPhysicalDevice pdev = VK_NULL_HANDLE;
+		bool fg_supported = false; // DLSS-G usable on this device
+		bool reflex = false;       // Reflex driven by Streamline
+		u32 max_mult = 2;          // highest multiplier the GPU/driver allows
+		bool vsync_ok = false;     // DLSS-G supports FIFO on this system
+		HWND hwnd = nullptr;
+	};
+	sl_state g_sl;
+
+	std::wstring exe_dir()
+	{
+		wchar_t path[MAX_PATH * 2] = {};
+		const DWORD n = GetModuleFileNameW(nullptr, path, static_cast<DWORD>(std::size(path)));
+		std::wstring s(path, n);
+		const auto p = s.find_last_of(L"\\/");
+		return p == std::wstring::npos ? std::wstring(L".") : s.substr(0, p);
+	}
+
+	void sl_log_cb(sl::LogType type, const char* msg)
+	{
+		if (!msg) return;
+		if (type == sl::LogType::eInfo && !fgcfg().debug) return;
+		std::string m(msg);
+		while (!m.empty() && (m.back() == '\n' || m.back() == '\r')) m.pop_back();
+		std::fprintf(stderr, "[fg-vk] sl%s: %s\n", type == sl::LogType::eError ? " error" : type == sl::LogType::eWarn ? " warn" : "", m.c_str());
+	}
+
+	// RTX 40 (Ada) / RTX 50 (Blackwell) by name; slIsFeatureSupported is the real check once the device exists
+	bool gpu_name_qualifies(const char* name)
+	{
+		if (std::strstr(name, "Ada") || std::strstr(name, "Blackwell")) return true;
+		for (const char* p = std::strstr(name, "RTX "); p; p = std::strstr(p + 4, "RTX "))
+		{
+			const char* d = p + 4;
+			if ((d[0] == '4' || d[0] == '5') && std::isdigit(static_cast<unsigned char>(d[1])) &&
+				std::isdigit(static_cast<unsigned char>(d[2])) && std::isdigit(static_cast<unsigned char>(d[3])))
+				return true;
+		}
+		return false;
+	}
+
+	bool gpu_gate(std::string& why)
+	{
+		VkApplicationInfo app{ VK_STRUCTURE_TYPE_APPLICATION_INFO };
+		app.apiVersion = VK_API_VERSION_1_1;
+		VkInstanceCreateInfo ci{ VK_STRUCTURE_TYPE_INSTANCE_CREATE_INFO };
+		ci.pApplicationInfo = &app;
+		VkInstance inst = VK_NULL_HANDLE;
+		if (vkCreateInstance(&ci, nullptr, &inst) != VK_SUCCESS)
+		{
+			why = "could not query the GPUs";
+			return false;
+		}
+		u32 n = 0;
+		vkEnumeratePhysicalDevices(inst, &n, nullptr);
+		std::vector<VkPhysicalDevice> devs(n);
+		if (n) vkEnumeratePhysicalDevices(inst, &n, devs.data());
+		bool ok = false;
+		std::string names;
+		for (u32 i = 0; i < n; ++i)
+		{
+			VkPhysicalDeviceProperties p{};
+			vkGetPhysicalDeviceProperties(devs[i], &p);
+			if (!names.empty()) names += ", ";
+			names += p.deviceName;
+			if (p.vendorID == 0x10DE && gpu_name_qualifies(p.deviceName)) ok = true;
+		}
+		vkDestroyInstance(inst, nullptr);
+		if (!ok) why = "needs an NVIDIA GeForce RTX 40 or 50 series GPU (found: " + (names.empty() ? std::string("none") : names) + ")";
+		return ok;
+	}
+
+	template <typename T>
+	bool sym(T*& out, const char* name)
+	{
+		out = reinterpret_cast<T*>(GetProcAddress(g_sl.dll, name));
+		return out != nullptr;
+	}
+
+	bool sl_off(const std::string& why)
+	{
+#ifdef R2PORT_HAVE_FFX
+		if (fgcfg().backend == 0) fglog("DLSS Frame Generation unavailable: %s (trying FSR 3)", why.c_str());
+		else
+#endif
+		fglog("frame generation off: %s", why.c_str());
+		return false;
+	}
+
+	// Plugins Streamline took from the NVIDIA driver's override folder (NVIDIA App "DLSS override" / driver profile:
+	// ...\NVIDIA\NGX\models\sl_*_override_*) instead of the copies next to the exe. Empty: the bundled set.
+	std::string sl_override_plugins()
+	{
+		std::string out;
+		for (const wchar_t* m : { L"sl.common.dll", L"sl.dlss_g.dll", L"sl.reflex.dll", L"sl.pcl.dll" })
+		{
+			const HMODULE h = GetModuleHandleW(m);
+			wchar_t path[MAX_PATH * 2] = {};
+			if (!h || !GetModuleFileNameW(h, path, static_cast<DWORD>(std::size(path)))) continue;
+			for (wchar_t* c = path; *c; ++c) *c = static_cast<wchar_t>(std::towlower(*c));
+			if (!std::wcsstr(path, L"\\models\\sl_") || !std::wcsstr(path, L"_override")) continue;
+			if (!out.empty()) out += ", ";
+			for (const wchar_t* c = m; *c; ++c) out += static_cast<char>(*c);
+		}
+		return out;
+	}
+
+	// Loads and initialises Streamline before the main Vulkan instance is created
+	bool sl_setup()
+	{
+		const auto off = sl_off;
+		if (vk::r2aa_mode() != 2) return off("it needs DLSS/DLAA anti-aliasing (RSX_FSR=2 / launcher \"DLSS\")");
+		std::string why;
+		if (!gpu_gate(why)) return off(why);
+
+		const std::wstring dir = exe_dir();
+		std::string missing;
+		for (const wchar_t* f : { L"sl.interposer.dll", L"sl.common.dll", L"sl.dlss_g.dll", L"sl.reflex.dll", L"sl.pcl.dll", L"nvngx_dlssg.dll" })
+		{
+			if (GetFileAttributesW((dir + L"\\" + f).c_str()) == INVALID_FILE_ATTRIBUTES)
+			{
+				if (!missing.empty()) missing += ", ";
+				for (const wchar_t* c = f; *c; ++c) missing += static_cast<char>(*c);
+			}
+		}
+		if (!missing.empty()) return off("missing " + missing + " next to the exe (run setup.ps1 again)");
+
+		g_sl.dll = LoadLibraryW((dir + L"\\sl.interposer.dll").c_str());
+		if (!g_sl.dll) return off("sl.interposer.dll failed to load");
+		if (!sym(g_sl.fn_init, "slInit") || !sym(g_sl.fn_shutdown, "slShutdown") || !sym(g_sl.fn_supported, "slIsFeatureSupported") ||
+			!sym(g_sl.fn_feature, "slGetFeatureFunction") || !sym(g_sl.fn_token, "slGetNewFrameToken") ||
+			!sym(g_sl.fn_tag, "slSetTagForFrame") || !sym(g_sl.fn_consts, "slSetConstants"))
+			return off("sl.interposer.dll lacks the Streamline 2 API");
+		g_sl.gipa = reinterpret_cast<PFN_vkGetInstanceProcAddr>(GetProcAddress(g_sl.dll, "vkGetInstanceProcAddr"));
+		g_sl.gdpa = reinterpret_cast<PFN_vkGetDeviceProcAddr>(GetProcAddress(g_sl.dll, "vkGetDeviceProcAddr"));
+		if (!g_sl.gipa || !g_sl.gdpa) return off("sl.interposer.dll lacks the Vulkan proxies");
+
+		static const sl::Feature features[] = { sl::kFeatureDLSS_G, sl::kFeatureReflex, sl::kFeaturePCL };
+		static std::wstring plugin_dir;
+		plugin_dir = dir;
+		static const wchar_t* paths[1];
+		paths[0] = plugin_dir.c_str();
+
+		sl::Preferences pref{};
+		pref.showConsole = false;
+		pref.logLevel = fgcfg().debug ? sl::LogLevel::eVerbose : sl::LogLevel::eDefault;
+		pref.logMessageCallback = &sl_log_cb;
+		pref.pathsToPlugins = paths;
+		pref.numPathsToPlugins = 1;
+		pref.flags = sl::PreferenceFlags::eDisableCLStateTracking | sl::PreferenceFlags::eDisableDebugText |
+			sl::PreferenceFlags::eUseManualHooking | sl::PreferenceFlags::eUseFrameBasedResourceTagging;
+		// R?_DLSS_FG_OTA=1: let Streamline fetch and load NVIDIA's over-the-air plugin updates (default 0: the
+		// matched set next to the exe). A driver-side "DLSS override" still swaps plugins in either way.
+		if (penv_int("DLSS_FG_OTA", 0))
+			pref.flags = pref.flags | sl::PreferenceFlags::eAllowOTA | sl::PreferenceFlags::eLoadDownloadedPlugins;
+		pref.featuresToLoad = features;
+		pref.numFeaturesToLoad = static_cast<u32>(std::size(features));
+		pref.engine = sl::EngineType::eCustom;
+		pref.engineVersion = "1.0";
+		pref.projectId = "c4a7e2d1-3b58-4f6a-8e92-71d5b0c3f6e8";
+		pref.renderAPI = sl::RenderAPI::eVulkan;
+		const sl::Result r = g_sl.fn_init(pref, sl::kSDKVersion);
+		if (r != sl::Result::eOk) return off("Streamline init failed (code " + std::to_string(static_cast<int>(r)) + ")");
+		const std::string ovr = sl_override_plugins();
+		if (!ovr.empty())
+		{
+			// R?_DLSS_FG_OVERRIDE_PLUGINS=0: refuse DLSS-G when the driver forces its own plugin builds
+			if (!penv_int("DLSS_FG_OVERRIDE_PLUGINS", 1))
+			{
+				g_sl.fn_shutdown();
+				return off("the NVIDIA driver replaced the bundled Streamline plugins (" + ovr + ", NVIDIA App DLSS override) and DLSS_FG_OVERRIDE_PLUGINS=0");
+			}
+			fglog("frame generation: the NVIDIA driver replaced the bundled Streamline plugins with its override builds (%s; NVIDIA App DLSS override)", ovr.c_str());
+		}
+		g_sl.inited = true;
+		return true;
+	}
+
+	template <typename T>
+	bool feature_fn(T*& out, sl::Feature f, const char* name)
+	{
+		void* p = nullptr;
+		out = (g_sl.fn_feature(f, name, p) == sl::Result::eOk) ? reinterpret_cast<T*>(p) : nullptr;
+		return out != nullptr;
+	}
+
+	bool sl_device() { return g_sl.inited && g_sl.device != VK_NULL_HANDLE; }
+
+	// Streamline's vkCreateDevice initialises its plugins (sl.common, DLSS-G, Reflex; possibly driver-downloaded
+	// override builds) inside the call. A fault there must not take the game down: the caller turns frame
+	// generation off and creates the device natively.
+	VkResult sl_create_device_guarded(PFN_vkCreateDevice create, VkPhysicalDevice pdev, const VkDeviceCreateInfo* info, VkDevice* device, DWORD* code)
+	{
+		__try
+		{
+			return create(pdev, info, nullptr, device);
+		}
+		__except (*code = GetExceptionCode(), EXCEPTION_EXECUTE_HANDLER)
+		{
+			return VK_ERROR_INITIALIZATION_FAILED;
+		}
+	}
+
+	// What Streamline reports once its device exists (feature support, function pointers, DLSS-G state)
+	struct sl_probe
+	{
+		sl::Result fg = sl::Result::eErrorNotInitialized;
+		bool fg_ok = false, reflex_ok = false, have_state = false;
+		sl::DLSSGState st{};
+	};
+
+	// The plugins run here for the first time with the game's device; a fault is caught like in vkCreateDevice
+	bool sl_probe_guarded(VkPhysicalDevice pdev, sl::ReflexMode mode, sl_probe& p, DWORD* code)
+	{
+		__try
+		{
+			sl::AdapterInfo adapter{};
+			adapter.vkPhysicalDevice = pdev;
+			p.fg = g_sl.fn_supported(sl::kFeatureDLSS_G, adapter);
+			p.fg_ok = p.fg == sl::Result::eOk && feature_fn(g_sl.fn_g_state, sl::kFeatureDLSS_G, "slDLSSGGetState") &&
+				feature_fn(g_sl.fn_g_options, sl::kFeatureDLSS_G, "slDLSSGSetOptions");
+			p.reflex_ok = g_sl.fn_supported(sl::kFeatureReflex, adapter) == sl::Result::eOk &&
+				feature_fn(g_sl.fn_r_sleep, sl::kFeatureReflex, "slReflexSleep") &&
+				feature_fn(g_sl.fn_r_options, sl::kFeatureReflex, "slReflexSetOptions") &&
+				feature_fn(g_sl.fn_marker, sl::kFeaturePCL, "slPCLSetMarker");
+			if (p.fg_ok && p.reflex_ok)
+			{
+				p.have_state = g_sl.fn_g_state(sl::ViewportHandle(0u), p.st, nullptr) == sl::Result::eOk;
+				sl::ReflexOptions ro{};
+				ro.mode = mode;
+				g_sl.fn_r_options(ro);
+			}
+			return true;
+		}
+		__except (*code = GetExceptionCode(), EXCEPTION_EXECUTE_HANDLER)
+		{
+			return false;
+		}
+	}
+
+	bool sl_shutdown_guarded()
+	{
+		__try
+		{
+			g_sl.fn_shutdown();
+			return true;
+		}
+		__except (EXCEPTION_EXECUTE_HANDLER)
+		{
+			return false;
+		}
+	}
+
+#ifdef R2PORT_HAVE_FFX
+	// FSR 3 frame interpolation (AMD FidelityFX API, amd_fidelityfx_vk.dll)
+	struct fx_state
+	{
+		HMODULE dll = nullptr;
+		PfnFfxCreateContext create = nullptr;
+		PfnFfxDestroyContext destroy = nullptr;
+		PfnFfxConfigure configure = nullptr;
+		PfnFfxQuery query = nullptr;
+		PfnFfxDispatch dispatch = nullptr;
+
+		bool selected = false;   // chosen at instance creation: the device gets the extra queues
+		bool failed = false;     // gave up for this session (logged)
+		VkDevice device = VK_NULL_HANDLE;
+		VkPhysicalDevice pdev = VK_NULL_HANDLE;
+		VkQueue game_q = VK_NULL_HANDLE, present_q = VK_NULL_HANDLE, acquire_q = VK_NULL_HANDLE;
+		u32 gfam = 0, pfam = 0, afam = 0;
+
+		// RPCS3's own swapchain entry points (used for swapchains FSR 3 does not manage)
+		PFN_vkCreateSwapchainKHR real_create = nullptr;
+		PFN_vkDestroySwapchainKHR real_destroy = nullptr;
+		PFN_vkGetSwapchainImagesKHR real_images = nullptr;
+		PFN_vkAcquireNextImageKHR real_acquire = nullptr;
+		PFN_vkQueuePresentKHR real_present = nullptr;
+
+		ffxContext sc_ctx = nullptr;          // frame-generation swapchain
+		VkSwapchainKHR sc = VK_NULL_HANDLE;   // its replacement swapchain handle (what RPCS3 sees)
+		ffxQueryDescSwapchainReplacementFunctionsVK fns{};
+		std::vector<VkSwapchainKHR> real_scs; // plain swapchains made when FSR 3 could not take one
+		bool sc_ok = false;
+		std::string sc_why;
+
+		ffxContext fg_ctx = nullptr;          // frame generation
+		u32 key[6] = {};
+		u32 max_rw = 0, max_rh = 0;
+
+		u64 frame_id = 0;
+		bool gen = false, on = false;         // this frame: generation enabled / with the HUD split
+		bool prev_gen = false;
+		bool frame_reset = false;
+		u32 hold = 0;                         // frames generation stays enabled (reset) after it stops being wanted
+		std::atomic<bool> pending_reset{ false };
+		std::chrono::steady_clock::time_point last_prep{}, next_present{};
+		bool logged_ready = false;
+	};
+	fx_state g_fx;
+
+	bool fx_usable() { return g_fx.selected && !g_fx.failed && g_fx.device != VK_NULL_HANDLE; }
+
+	// Picks FSR 3 before the main Vulkan instance exists (the device needs extra queues for it)
+	bool fsr3_setup()
+	{
+		const auto off = [](const std::string& why)
+		{
+			fglog("frame generation off: %s", why.c_str());
+			return false;
+		};
+		if (vk::r2aa_mode() == 0)
+			return off("FSR 3 frame generation needs an anti-aliasing / upscaling mode (launcher Anti-aliasing: FSR, DLSS or XeSS) for depth and motion vectors");
+		const std::wstring path = exe_dir() + L"\\amd_fidelityfx_vk.dll";
+		if (GetFileAttributesW(path.c_str()) == INVALID_FILE_ATTRIBUTES) return off("missing amd_fidelityfx_vk.dll next to the exe (run setup.ps1 again)");
+		g_fx.dll = LoadLibraryW(path.c_str());
+		if (!g_fx.dll) return off("amd_fidelityfx_vk.dll failed to load");
+		g_fx.create = reinterpret_cast<PfnFfxCreateContext>(GetProcAddress(g_fx.dll, "ffxCreateContext"));
+		g_fx.destroy = reinterpret_cast<PfnFfxDestroyContext>(GetProcAddress(g_fx.dll, "ffxDestroyContext"));
+		g_fx.configure = reinterpret_cast<PfnFfxConfigure>(GetProcAddress(g_fx.dll, "ffxConfigure"));
+		g_fx.query = reinterpret_cast<PfnFfxQuery>(GetProcAddress(g_fx.dll, "ffxQuery"));
+		g_fx.dispatch = reinterpret_cast<PfnFfxDispatch>(GetProcAddress(g_fx.dll, "ffxDispatch"));
+		if (!g_fx.create || !g_fx.destroy || !g_fx.configure || !g_fx.query || !g_fx.dispatch)
+			return off("amd_fidelityfx_vk.dll has no FidelityFX API exports");
+		if (fgcfg().want > 2) fglog("FSR 3 frame generation is 2x only: using 2x");
+		if (penv_int("REFLEX", 0)) fglog("NVIDIA Reflex is off while FSR 3 frame generation is selected");
+		g_fx.selected = true;
+		return true;
+	}
+
+	// RPCS3 serialises vkQueueSubmit with g_submit_mutex; FSR 3 submits to (and waits on) the same graphics queue
+	thread_local bool t_fx_held = false;
+	struct fx_lock
+	{
+		fx_lock() { vk::acquire_global_submit_lock(); t_fx_held = true; }
+		~fx_lock() { t_fx_held = false; vk::release_global_submit_lock(); }
+		fx_lock(const fx_lock&) = delete;
+		fx_lock& operator=(const fx_lock&) = delete;
+	};
+
+	VkResult fx_game_submit(uint32_t count, const VkSubmitInfo* submits, VkFence fence)
+	{
+		if (t_fx_held) return vkQueueSubmit(g_fx.game_q, count, submits, fence);
+		vk::acquire_global_submit_lock();
+		const VkResult r = vkQueueSubmit(g_fx.game_q, count, submits, fence);
+		vk::release_global_submit_lock();
+		return r;
+	}
+
+	// The device RPCS3 asks for, plus a present queue and an image-acquire queue for the FSR 3 swapchain and the
+	// timeline semaphores it uses. Without them FSR 3 stays off (logged) and the device is created unchanged.
+	VkResult fx_create_device(VkPhysicalDevice pdev, const VkDeviceCreateInfo* info, VkDevice* device)
+	{
+		auto& x = g_fx;
+		const auto fail = [&](const std::string& why)
+		{
+			fglog("frame generation off: %s", why.c_str());
+			x.failed = true;
+			return vkCreateDevice(pdev, info, nullptr, device);
+		};
+		if (!info->queueCreateInfoCount || !info->pQueueCreateInfos) return fail("no device queues");
+
+		u32 nfam = 0;
+		vkGetPhysicalDeviceQueueFamilyProperties(pdev, &nfam, nullptr);
+		std::vector<VkQueueFamilyProperties> fams(nfam);
+		if (nfam) vkGetPhysicalDeviceQueueFamilyProperties(pdev, &nfam, fams.data());
+		std::vector<u32> used(nfam, 0);
+		for (u32 i = 0; i < info->queueCreateInfoCount; ++i)
+		{
+			const auto& q = info->pQueueCreateInfos[i];
+			if (q.queueFamilyIndex < nfam) used[q.queueFamilyIndex] = std::max(used[q.queueFamilyIndex], q.queueCount);
+		}
+		const u32 gfam = info->pQueueCreateInfos[0].queueFamilyIndex;
+		if (gfam >= nfam || nfam > 16) return fail("unexpected Vulkan queue families");
+		const auto spare = [&](u32 fam) { return fam < nfam && used[fam] < fams[fam].queueCount; };
+		const auto both = [&](u32 fam) { return (fams[fam].queueFlags & (VK_QUEUE_GRAPHICS_BIT | VK_QUEUE_COMPUTE_BIT)) != 0; };
+
+		// present queue: a second graphics queue, else another graphics/compute family that can present
+		int pfam = -1;
+		if (spare(gfam)) pfam = static_cast<int>(gfam);
+		for (u32 f = 0; pfam < 0 && f < nfam; ++f)
+			if (spare(f) && both(f) && vkGetPhysicalDeviceWin32PresentationSupportKHR(pdev, f)) pfam = static_cast<int>(f);
+		if (pfam < 0) return fail("FSR 3 needs a spare graphics or compute queue that can present on this GPU");
+		const u32 pidx = used[pfam]++;
+		// image-acquire queue: any spare queue, preferably a transfer-only one
+		int afam = -1;
+		for (u32 f = 0; afam < 0 && f < nfam; ++f)
+			if (spare(f) && !both(f)) afam = static_cast<int>(f);
+		for (u32 f = 0; afam < 0 && f < nfam; ++f)
+			if (spare(f)) afam = static_cast<int>(f);
+		if (afam < 0) return fail("FSR 3 needs one more spare Vulkan queue on this GPU");
+		const u32 aidx = used[afam]++;
+
+		// timeline semaphores (Vulkan 1.2 feature, in RPCS3's chained VkPhysicalDeviceVulkan12Features)
+		VkPhysicalDeviceVulkan12Features have12{ VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_VULKAN_1_2_FEATURES };
+		VkPhysicalDeviceFeatures2 f2{ VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_FEATURES_2 };
+		f2.pNext = &have12;
+		vkGetPhysicalDeviceFeatures2(pdev, &f2);
+		VkPhysicalDeviceVulkan12Features* chain12 = nullptr;
+		for (auto* p = static_cast<const VkBaseInStructure*>(info->pNext); p; p = p->pNext)
+			if (p->sType == VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_VULKAN_1_2_FEATURES)
+				chain12 = reinterpret_cast<VkPhysicalDeviceVulkan12Features*>(const_cast<VkBaseInStructure*>(p));
+		if (!have12.timelineSemaphore || !chain12) return fail("FSR 3 needs Vulkan timeline semaphores");
+		const VkBool32 old_timeline = chain12->timelineSemaphore;
+		chain12->timelineSemaphore = VK_TRUE;
+
+		std::vector<VkDeviceQueueCreateInfo> qs(info->pQueueCreateInfos, info->pQueueCreateInfos + info->queueCreateInfoCount);
+		std::vector<std::vector<float>> prios;
+		prios.reserve(nfam);
+		for (u32 f = 0; f < nfam; ++f)
+		{
+			if (!used[f]) continue;
+			auto it = std::find_if(qs.begin(), qs.end(), [&](const VkDeviceQueueCreateInfo& q) { return q.queueFamilyIndex == f; });
+			if (it == qs.end())
+			{
+				VkDeviceQueueCreateInfo q{ VK_STRUCTURE_TYPE_DEVICE_QUEUE_CREATE_INFO };
+				q.queueFamilyIndex = f;
+				it = qs.insert(qs.end(), q);
+			}
+			if (it->queueCount == used[f]) continue;
+			it->queueCount = used[f];
+			prios.emplace_back(used[f], 0.f);
+			it->pQueuePriorities = prios.back().data();
+		}
+		VkDeviceCreateInfo ci = *info;
+		ci.queueCreateInfoCount = static_cast<u32>(qs.size());
+		ci.pQueueCreateInfos = qs.data();
+		const VkResult r = vkCreateDevice(pdev, &ci, nullptr, device);
+		if (r != VK_SUCCESS)
+		{
+			chain12->timelineSemaphore = old_timeline;
+			return fail("the Vulkan device with FSR 3's extra queues failed (" + std::to_string(static_cast<int>(r)) + ")");
+		}
+		x.device = *device;
+		x.pdev = pdev;
+		x.gfam = gfam;
+		x.pfam = static_cast<u32>(pfam);
+		x.afam = static_cast<u32>(afam);
+		vkGetDeviceQueue(*device, gfam, 0, &x.game_q);
+		vkGetDeviceQueue(*device, x.pfam, pidx, &x.present_q);
+		vkGetDeviceQueue(*device, x.afam, aidx, &x.acquire_q);
+		VkPhysicalDeviceProperties props{};
+		vkGetPhysicalDeviceProperties(pdev, &props);
+		fglog("FSR 3 frame generation 2x ready on %s (HUD split %s)", props.deviceName, fgcfg().hud ? "on" : "off");
+		return r;
+	}
+#else
+	bool fx_usable() { return false; }
+#endif
+
+	// DLSS-G could not start on the game's device: Streamline lets go of it (shutdown unless its plugins faulted,
+	// then they are left alone), the port's own latency path takes Reflex back, and in auto mode FSR 3 frame
+	// generation gets the device instead of nothing.
+	VkResult sl_abandon_device(VkPhysicalDevice pdev, const VkDeviceCreateInfo* info, VkDevice* device, bool shutdown, const std::string& why)
+	{
+		if (shutdown && !sl_shutdown_guarded()) fglog("frame generation: slShutdown faulted (ignored)");
+		g_sl.inited = false;
+		g_sl.device = VK_NULL_HANDLE;
+		g_sl.fg_supported = false;
+		g_sl.reflex = false;
+		*device = VK_NULL_HANDLE;
+		sl_off(why);
+#ifdef R2PORT_HAVE_FFX
+		if (fgcfg().backend == 0 && !g_fx.selected && !g_fx.failed) fsr3_setup();
+		if (g_fx.selected && !g_fx.failed && g_fx.device == VK_NULL_HANDLE) return fx_create_device(pdev, info, device);
+#endif
+		return vkCreateDevice(pdev, info, nullptr, device);
+	}
+}
+
+namespace vk
+{
+	VkResult r2fg_create_instance(const VkInstanceCreateInfo& info, VkInstance* instance, bool fast)
+	{
+		if (!fast && fgcfg().want && !g_sl.tried)
+		{
+			g_sl.tried = true;
+			if (fgcfg().backend != 2) sl_setup();
+#ifdef R2PORT_HAVE_FFX
+			if (!g_sl.inited && fgcfg().backend != 1) fsr3_setup();
+#endif
+		}
+		if (fast || !g_sl.inited || g_sl.instance != VK_NULL_HANDLE)
+			return vkCreateInstance(&info, nullptr, instance);
+
+		const auto create = reinterpret_cast<PFN_vkCreateInstance>(g_sl.gipa(VK_NULL_HANDLE, "vkCreateInstance"));
+		VkResult res = create ? create(&info, nullptr, instance) : VK_ERROR_INITIALIZATION_FAILED;
+		if (res == VK_SUCCESS)
+		{
+			g_sl.instance = *instance;
+			g_sl.p_destroy_surface = reinterpret_cast<PFN_vkDestroySurfaceKHR>(g_sl.gipa(*instance, "vkDestroySurfaceKHR"));
+			g_sl.p_create_surface = reinterpret_cast<PFN_vkCreateWin32SurfaceKHR>(g_sl.gipa(*instance, "vkCreateWin32SurfaceKHR"));
+			if (fgcfg().debug) fglog("Vulkan instance created through Streamline");
+			return res;
+		}
+		fglog("frame generation off: the Streamline Vulkan instance failed (%d)", static_cast<int>(res));
+		g_sl.fn_shutdown();
+		g_sl.inited = false;
+#ifdef R2PORT_HAVE_FFX
+		if (fgcfg().backend == 0) fsr3_setup();
+#endif
+		return vkCreateInstance(&info, nullptr, instance);
+	}
+
+	void r2fg_destroy_surface(VkInstance instance, VkSurfaceKHR surface)
+	{
+		if (g_sl.inited && instance == g_sl.instance && g_sl.p_destroy_surface) g_sl.p_destroy_surface(instance, surface, nullptr);
+		else vkDestroySurfaceKHR(instance, surface, nullptr);
+	}
+
+	VkResult r2fg_create_win32_surface(VkInstance instance, const VkWin32SurfaceCreateInfoKHR* info, VkSurfaceKHR* surface)
+	{
+		g_sl.hwnd = info->hwnd;
+		if (g_sl.inited && instance == g_sl.instance && g_sl.p_create_surface) return g_sl.p_create_surface(instance, info, nullptr, surface);
+		return vkCreateWin32SurfaceKHR(instance, info, nullptr, surface);
+	}
+
+	VkResult r2fg_create_device(VkPhysicalDevice pdev, const VkDeviceCreateInfo* info, VkDevice* device)
+	{
+		if (!g_sl.inited || g_sl.instance == VK_NULL_HANDLE || g_sl.device != VK_NULL_HANDLE)
+		{
+#ifdef R2PORT_HAVE_FFX
+			if (g_fx.selected && !g_fx.failed && g_fx.device == VK_NULL_HANDLE) return fx_create_device(pdev, info, device);
+#endif
+			return vkCreateDevice(pdev, info, nullptr, device);
+		}
+
+		// The interposer's vkCreateDevice looks the instance up in a map that only its own vkEnumeratePhysicalDevices
+		// fills. RPCS3 enumerated through the loader, so without this Streamline initialises its plugins with a null
+		// instance (null instance functions: sl.common crashes calling vkGetPhysicalDeviceMemoryProperties).
+		const auto enumerate = reinterpret_cast<PFN_vkEnumeratePhysicalDevices>(g_sl.gipa(g_sl.instance, "vkEnumeratePhysicalDevices"));
+		std::vector<VkPhysicalDevice> listed;
+		u32 count = 0;
+		if (enumerate && enumerate(g_sl.instance, &count, nullptr) == VK_SUCCESS && count)
+		{
+			listed.resize(count);
+			if (enumerate(g_sl.instance, &count, listed.data()) < 0) count = 0;
+			listed.resize(count);
+		}
+		if (std::find(listed.begin(), listed.end(), pdev) == listed.end())
+			return sl_abandon_device(pdev, info, device, true, "Streamline does not list the renderer's GPU (" + std::to_string(count) + " GPUs listed)");
+
+		const auto create = reinterpret_cast<PFN_vkCreateDevice>(g_sl.gipa(g_sl.instance, "vkCreateDevice"));
+		if (!create) return sl_abandon_device(pdev, info, device, true, "Streamline has no vkCreateDevice proxy");
+		DWORD fault = 0;
+		const VkResult res = sl_create_device_guarded(create, pdev, info, device, &fault);
+		if (fault)
+		{
+			char why[160];
+			std::snprintf(why, sizeof(why), "Streamline crashed creating the Vulkan device (exception 0x%08X; NVIDIA driver/plugin problem)", static_cast<unsigned>(fault));
+			return sl_abandon_device(pdev, info, device, false, why);
+		}
+		if (res != VK_SUCCESS)
+			return sl_abandon_device(pdev, info, device, true, "the Streamline Vulkan device failed (" + std::to_string(static_cast<int>(res)) + ")");
+
+		VkPhysicalDeviceProperties props{};
+		vkGetPhysicalDeviceProperties(pdev, &props);
+		const auto drop = [&](bool shutdown, const std::string& why)
+		{
+			// Streamline lets go of the device first, then it is destroyed and made again without Streamline
+			const VkDevice dev = *device;
+			if (shutdown && !sl_shutdown_guarded()) fglog("frame generation: slShutdown faulted (ignored)");
+			if (shutdown) vkDestroyDevice(dev, nullptr);
+			return sl_abandon_device(pdev, info, device, false, why);
+		};
+
+		sl_probe p;
+		fault = 0;
+		const sl::ReflexMode mode = penv_int("REFLEX", 1) >= 2 ? sl::ReflexMode::eLowLatencyWithBoost : sl::ReflexMode::eLowLatency;
+		if (!sl_probe_guarded(pdev, mode, p, &fault))
+		{
+			char why[160];
+			std::snprintf(why, sizeof(why), "Streamline crashed starting DLSS Frame Generation (exception 0x%08X; NVIDIA driver/plugin problem)", static_cast<unsigned>(fault));
+			return drop(false, why);
+		}
+		if (!p.fg_ok)
+			return drop(true, "DLSS Frame Generation is not supported on " + std::string(props.deviceName) + " (code " +
+				std::to_string(static_cast<int>(p.fg)) + "; needs an RTX 40/50 and a current driver, HAGS on)");
+		if (!p.reflex_ok) return drop(true, "NVIDIA Reflex is unavailable through Streamline");
+
+		g_sl.device = *device;
+		g_sl.pdev = pdev;
+		g_sl.p_wait_idle = reinterpret_cast<PFN_vkDeviceWaitIdle>(g_sl.gdpa(*device, "vkDeviceWaitIdle"));
+		g_sl.fg_supported = true;
+		g_sl.reflex = true;
+		if (p.have_state)
+		{
+			g_sl.max_mult = std::max<u32>(2, p.st.numFramesToGenerateMax + 1);
+			g_sl.vsync_ok = p.st.bIsVsyncSupportAvailable == sl::Boolean::eTrue;
+		}
+		const u32 use = std::min<u32>(fgcfg().want, g_sl.max_mult);
+		if (use < static_cast<u32>(fgcfg().want))
+			fglog("%ux requested but %s supports up to %ux: using %ux", fgcfg().want, props.deviceName, g_sl.max_mult, use);
+		fglog("DLSS Frame Generation %ux ready on %s (HUD split %s)", use, props.deviceName, fgcfg().hud ? "on" : "off");
+		return res;
+	}
+}
+
+namespace vk
+{
+	// The upscaler's depth (R32F) and motion vectors (RG16F) -> frame generation's own copies (valid until present)
+	struct r2fg_copy_pass : compute_task
+	{
+		const vk::image_view* in_depth = nullptr;
+		const vk::image_view* in_mv = nullptr;
+		const vk::image_view* out_depth = nullptr;
+		const vk::image_view* out_mv = nullptr;
+		std::unique_ptr<vk::sampler> m_sampler;
+
+		r2fg_copy_pass()
+		{
+			m_src =
+				"#version 450\n"
+				"layout(local_size_x = 8, local_size_y = 8) in;\n"
+				"layout(set=0, binding=0) uniform sampler2D DepthIn;\n"
+				"layout(set=0, binding=1) uniform sampler2D MvIn;\n"
+				"layout(set=0, binding=2, r32f) uniform writeonly image2D DepthOut;\n"
+				"layout(set=0, binding=3, rg16f) uniform writeonly image2D MvOut;\n"
+				"layout(push_constant) uniform PC { vec4 a; vec4 b; };\n" // a.xy: size
+				"void main()\n"
+				"{\n"
+				"	ivec2 p = ivec2(gl_GlobalInvocationID.xy);\n"
+				"	if (p.x >= int(a.x) || p.y >= int(a.y)) return;\n"
+				"	imageStore(DepthOut, p, vec4(texelFetch(DepthIn, p, 0).r, 0.0, 0.0, 0.0));\n"
+				"	imageStore(MvOut, p, vec4(texelFetch(MvIn, p, 0).rg, 0.0, 0.0));\n"
+				"}\n";
+			ssbo_count = 0;
+			use_push_constants = true;
+			push_constants_size = 32;
+			create();
+		}
+
+		std::vector<glsl::program_input> get_inputs() override
+		{
+			auto r = compute_task::get_inputs();
+			r.push_back(glsl::program_input::make(::glsl::program_domain::glsl_compute_program, "DepthIn", vk::glsl::input_type_texture, 0, 0));
+			r.push_back(glsl::program_input::make(::glsl::program_domain::glsl_compute_program, "MvIn", vk::glsl::input_type_texture, 0, 1));
+			r.push_back(glsl::program_input::make(::glsl::program_domain::glsl_compute_program, "DepthOut", vk::glsl::input_type_storage_texture, 0, 2));
+			r.push_back(glsl::program_input::make(::glsl::program_domain::glsl_compute_program, "MvOut", vk::glsl::input_type_storage_texture, 0, 3));
+			return r;
+		}
+
+		void bind_resources(const vk::command_buffer&) override
+		{
+			if (!m_sampler)
+			{
+				m_sampler = std::make_unique<vk::sampler>(*vk::get_current_renderer(),
+					VK_SAMPLER_ADDRESS_MODE_CLAMP_TO_EDGE, VK_SAMPLER_ADDRESS_MODE_CLAMP_TO_EDGE, VK_SAMPLER_ADDRESS_MODE_CLAMP_TO_EDGE,
+					VK_FALSE, 0.f, 1.f, 0.f, 0.f, VK_FILTER_NEAREST, VK_FILTER_NEAREST, VK_SAMPLER_MIPMAP_MODE_NEAREST, VK_BORDER_COLOR_FLOAT_OPAQUE_WHITE);
+			}
+			m_program->bind_uniform({ *in_depth, *m_sampler }, 0, 0);
+			m_program->bind_uniform({ *in_mv, *m_sampler }, 0, 1);
+			m_program->bind_uniform({ *out_depth }, 0, 2);
+			m_program->bind_uniform({ *out_mv }, 0, 3);
+		}
+
+		void run(const vk::command_buffer& cmd, u32 w, u32 h)
+		{
+			if (!m_program) load_program(cmd);
+			const float k[8] = { static_cast<float>(w), static_cast<float>(h), 0.f, 0.f, 0.f, 0.f, 0.f, 0.f };
+			vkCmdPushConstants(cmd, m_program->layout(), VK_SHADER_STAGE_COMPUTE_BIT, 0, push_constants_size, k);
+			compute_task::run(cmd, (w + 7) / 8, (h + 7) / 8, 1);
+		}
+	};
+
+	// Shared GLSL of the HUD passes. Inputs: HudIn = the display buffer snapshotted right before the first HUD
+	// draw, FlipIn = the same buffer at flip (scene + HUD), B0 = the swapchain image before the port overlays,
+	// B1 = after them. a: game rectangle on the swapchain (x, y, w, h); b: uv scale of the used buffer region
+	// (x, y), swapchain size (z, w); c: HUD threshold, overlay threshold, HUD pixel limit, flags
+	// (1 = split the HUD this frame, 2 = HDR10 output, 4 = debug view).
+	const char* r2fg_hud_common =
+		"layout(set=0, binding=0) uniform sampler2D HudIn;\n"
+		"layout(set=0, binding=1) uniform sampler2D FlipIn;\n"
+		"layout(set=0, binding=2) uniform sampler2D B0;\n"
+		"layout(set=0, binding=3) uniform sampler2D B1;\n"
+		"layout(set=0, binding=4, r32ui) uniform uimage2D Count;\n"
+		"layout(push_constant) uniform PC { vec4 a; vec4 b; vec4 c; };\n"
+		"float maxdiff(vec3 x, vec3 y) { vec3 d = abs(x - y); return max(d.x, max(d.y, d.z)); }\n"
+		"bool game_uv(ivec2 p, out vec2 uv)\n"
+		"{\n"
+		"	vec2 q = (vec2(p) + 0.5 - a.xy) / a.zw;\n"
+		"	uv = q * b.xy;\n"
+		"	return all(greaterThanEqual(q, vec2(0.0))) && all(lessThan(q, vec2(1.0)));\n"
+		"}\n"
+		"bool hud_at(ivec2 p)\n"
+		"{\n"
+		"	vec2 uv;\n"
+		"	if (!game_uv(p, uv)) return false;\n"
+		"	return maxdiff(textureLod(HudIn, uv, 0.0).rgb, textureLod(FlipIn, uv, 0.0).rgb) > c.x;\n"
+		"}\n"
+		"bool overlay_at(ivec2 p) { return maxdiff(texelFetch(B0, p, 0).rgb, texelFetch(B1, p, 0).rgb) > c.y; }\n";
+
+	struct r2fg_hud_pass_base : compute_task
+	{
+		const vk::image_view* in[4] = {};
+		const vk::image_view* count = nullptr;
+		std::unique_ptr<vk::sampler> m_sampler;
+
+		void init(const std::string& body)
+		{
+			m_src = std::string("#version 450\nlayout(local_size_x = 8, local_size_y = 8) in;\n") + r2fg_hud_common + body;
+			ssbo_count = 0;
+			use_push_constants = true;
+			push_constants_size = 48;
+			create();
+		}
+
+		std::vector<glsl::program_input> get_inputs() override
+		{
+			auto r = compute_task::get_inputs();
+			const char* names[4] = { "HudIn", "FlipIn", "B0", "B1" };
+			for (u32 i = 0; i < 4; ++i)
+				r.push_back(glsl::program_input::make(::glsl::program_domain::glsl_compute_program, names[i], vk::glsl::input_type_texture, 0, i));
+			r.push_back(glsl::program_input::make(::glsl::program_domain::glsl_compute_program, "Count", vk::glsl::input_type_storage_texture, 0, 4));
+			return r;
+		}
+
+		void bind_resources(const vk::command_buffer&) override
+		{
+			if (!m_sampler)
+			{
+				m_sampler = std::make_unique<vk::sampler>(*vk::get_current_renderer(),
+					VK_SAMPLER_ADDRESS_MODE_CLAMP_TO_EDGE, VK_SAMPLER_ADDRESS_MODE_CLAMP_TO_EDGE, VK_SAMPLER_ADDRESS_MODE_CLAMP_TO_EDGE,
+					VK_FALSE, 0.f, 1.f, 0.f, 0.f, VK_FILTER_LINEAR, VK_FILTER_LINEAR, VK_SAMPLER_MIPMAP_MODE_NEAREST, VK_BORDER_COLOR_FLOAT_OPAQUE_BLACK);
+			}
+			for (u32 i = 0; i < 4; ++i) m_program->bind_uniform({ *in[i], *m_sampler }, 0, i);
+			m_program->bind_uniform({ *count }, 0, 4);
+		}
+
+		void run(const vk::command_buffer& cmd, const float* k, u32 w, u32 h)
+		{
+			if (!m_program) load_program(cmd);
+			vkCmdPushConstants(cmd, m_program->layout(), VK_SHADER_STAGE_COMPUTE_BIT, 0, push_constants_size, k);
+			compute_task::run(cmd, (w + 7) / 8, (h + 7) / 8, 1);
+		}
+	};
+
+	// Counts the HUD pixels (one atomic per work group): a frame whose "HUD" covers too much of the screen is a
+	// misclassification (a full-screen fade, a blended post effect) and is not split.
+	struct r2fg_mask_pass : r2fg_hud_pass_base
+	{
+		r2fg_mask_pass()
+		{
+			init(
+				"shared uint s_n;\n"
+				"void main()\n"
+				"{\n"
+				"	if (gl_LocalInvocationIndex == 0u) s_n = 0u;\n"
+				"	barrier();\n"
+				"	ivec2 p = ivec2(gl_GlobalInvocationID.xy);\n"
+				"	if (p.x < int(b.z) && p.y < int(b.w) && hud_at(p)) atomicAdd(s_n, 1u);\n"
+				"	barrier();\n"
+				"	if (gl_LocalInvocationIndex == 0u && s_n != 0u) imageAtomicAdd(Count, ivec2(0, 0), s_n);\n"
+				"}\n");
+		}
+	};
+
+	// Writes the HUD-less colour and the UI colour + alpha (both swapchain-sized)
+	template <bool HDR10>
+	struct r2fg_compose_pass : r2fg_hud_pass_base
+	{
+		const vk::image_view* out_hudless = nullptr;
+		const vk::image_view* out_ui = nullptr;
+
+		r2fg_compose_pass()
+		{
+			const std::string fmt = HDR10 ? "rgb10_a2" : "rgba8";
+			init(
+				"layout(set=0, binding=5, " + fmt + ") uniform writeonly image2D HudlessOut;\n"
+				"layout(set=0, binding=6, " + fmt + ") uniform writeonly image2D UiOut;\n"
+				"void main()\n"
+				"{\n"
+				"	ivec2 p = ivec2(gl_GlobalInvocationID.xy);\n"
+				"	ivec2 sz = ivec2(b.zw);\n"
+				"	if (p.x >= sz.x || p.y >= sz.y) return;\n"
+				"	uint flags = uint(c.w + 0.5);\n"
+				"	bool split = (flags & 1u) != 0u && float(imageLoad(Count, ivec2(0, 0)).r) < c.z;\n"
+				"	bool hud = false, ovl = false, hud_c = false;\n"
+				"	for (int dy = -1; dy <= 1; ++dy)\n"
+				"	for (int dx = -1; dx <= 1; ++dx)\n"
+				"	{\n"
+				"		ivec2 s = clamp(p + ivec2(dx, dy), ivec2(0), sz - 1);\n"
+				"		if (split && hud_at(s)) { hud = true; if (dx == 0 && dy == 0) hud_c = true; }\n"
+				"		if (overlay_at(s)) ovl = true;\n"
+				"	}\n"
+				"	vec4 b0 = texelFetch(B0, p, 0);\n"
+				"	vec4 b1 = texelFetch(B1, p, 0);\n"
+				"	vec3 hl = b0.rgb;\n"
+				"	vec2 uv;\n"
+				// SDR: take the HUD's own contribution back out of the presented scene. HDR10 (PQ) is not additive:
+				// the scene under the HUD keeps the HUD there, the opaque UI layer covers it on every frame.
+				"	if (hud_c && (flags & 2u) == 0u && game_uv(p, uv))\n"
+				"		hl = clamp(b0.rgb + textureLod(HudIn, uv, 0.0).rgb - textureLod(FlipIn, uv, 0.0).rgb, 0.0, 1.0);\n"
+				"	vec4 ui = (hud || ovl) ? vec4(b1.rgb, 1.0) : vec4(0.0);\n"
+				"	if ((flags & 4u) != 0u)\n"
+				"	{\n"
+				"		vec3 d = b1.rgb;\n"
+				"		if (hud) d = mix(d, vec3(1.0, 0.0, 1.0), 0.5);\n"
+				"		else if (ovl) d = mix(d, vec3(0.0, 1.0, 1.0), 0.5);\n"
+				"		hl = d;\n"
+				"	}\n"
+				"	imageStore(HudlessOut, p, vec4(hl, 1.0));\n"
+				"	imageStore(UiOut, p, ui);\n"
+				"}\n");
+		}
+
+		std::vector<glsl::program_input> get_inputs() override
+		{
+			auto r = r2fg_hud_pass_base::get_inputs();
+			r.push_back(glsl::program_input::make(::glsl::program_domain::glsl_compute_program, "HudlessOut", vk::glsl::input_type_storage_texture, 0, 5));
+			r.push_back(glsl::program_input::make(::glsl::program_domain::glsl_compute_program, "UiOut", vk::glsl::input_type_storage_texture, 0, 6));
+			return r;
+		}
+
+		void bind_resources(const vk::command_buffer& cmd) override
+		{
+			r2fg_hud_pass_base::bind_resources(cmd);
+			m_program->bind_uniform({ *out_hudless }, 0, 5);
+			m_program->bind_uniform({ *out_ui }, 0, 6);
+		}
+	};
+}
+
+namespace
+{
+	using image_ptr = std::unique_ptr<vk::viewable_image>;
+
+	struct fg_frame
+	{
+		// swapchain (create wrapper)
+		VkFormat sc_format = VK_FORMAT_UNDEFINED;
+		VkExtent2D sc_extent{};
+		u32 sc_images = 0;
+		double refresh_hz = 60.0;
+		bool sc_transfer = false;  // swapchain images can be copied from
+		bool sc_immediate = false; // FIFO was swapped for IMMEDIATE (DLSS-G without vsync support)
+		bool sc_fifo = false;      // the FSR 3 swapchain presents with vsync (FIFO / FIFO_RELAXED): PORT_FG_PACE=auto
+		bool sc_new = true;
+
+		// scene inputs (VKR2Upscaler hook)
+		bool scene = false;
+		u32 rw = 0, rh = 0;
+		float jx = 0.f, jy = 0.f, mvsx = 1.f, mvsy = 1.f, zA = 1.f, zB = 0.f;
+		bool inverted = false, reset = false;
+		double T[16] = {};
+		image_ptr depth, mv;
+		u32 streak = 0;            // consecutive frames with a tagged scene
+		unsigned gap = 0;          // scene-less frames after a long streak (pfg_streak_gap)
+
+		// HUD classifier (r2fg_on_draw)
+		bool hud_started = false;
+		bool unsure = false;
+		u32 hud_addr = 0, hud_draws = 0;
+		const void* hud_rt = nullptr;
+		image_ptr hud;
+		// photo-mode HUD hide (R3_PHOTO_HIDE_HUD): a snapshot was taken since the last game flip / it fits that flip
+		bool photo_snap = false, photo_ok = false;
+		const void* photo_src = nullptr;
+		int photo_was = 0;
+
+		// present phases
+		image_ptr b0, b1, hudless, ui, count;
+		VkFormat out_fmt = VK_FORMAT_UNDEFINED;
+		bool have_b0 = false, have_ui = false, split = false;
+		s32 rx = 0, ry = 0, rwid = 0, rhei = 0; // game rectangle on the swapchain
+		bool ready = false;                    // phase 1 decided this frame
+		bool want_on = false;
+		u32 mult = 2;
+		bool debug_view = false;
+
+		// state across frames
+		bool prev_on = false;
+		u32 bad_status_frames = 0;
+		std::string reason;
+		unsigned long long reason_ms = 0;
+		int opt_key[16] = {};
+		bool opt_valid = false;
+		u32 reflex_limit = ~0u;
+		u32 hud_frames = 0, frames_on = 0;
+
+		// Reflex / PCL frame ids
+		std::mutex mu;
+		u32 sim_id = 0, present_id = 0, cur_rid = 0;
+		bool sim_open = false, render_open = false;
+
+		// menu detection: last camera change (tag_scene) / last mouse or right-stick input
+		unsigned long long cam_ms = 0, input_ms = 0;
+		unsigned long long last_mouse = 0;
+	};
+	fg_frame g_fg;
+
+	bool fg_usable() { return (sl_device() && g_sl.fg_supported) || fx_usable(); }
+	// the HUD/present passes run for frame generation, or for the debug view on its own
+	bool hud_path() { return fg_usable() || fgcfg().hud_debug; }
+	// the HUD classifier also runs for the photo-mode HUD hide, with frame generation off too
+	bool hud_snap() { return hud_path() || g_port_photo_hud != 0; }
+
+	image_ptr fg_make_image(VkFormat fmt, u32 w, u32 h, VkImageUsageFlags usage)
+	{
+		const auto pdev = vk::get_current_renderer();
+		return std::make_unique<vk::viewable_image>(*pdev, pdev->get_memory_mapping().device_local, VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT,
+			VK_IMAGE_TYPE_2D, fmt, w, h, 1, 1, 1, VK_SAMPLE_COUNT_1_BIT, VK_IMAGE_LAYOUT_UNDEFINED, VK_IMAGE_TILING_OPTIMAL,
+			usage, vk::VK_IMAGE_CREATE_ALLOW_NULL_RPCS3, VMM_ALLOCATION_POOL_SWAPCHAIN, RSX_FORMAT_CLASS_COLOR);
+	}
+
+	// (re)creates 'img' unless it already has this format and size; the old one is freed once the GPU is done
+	void fg_ensure(image_ptr& img, VkFormat fmt, u32 w, u32 h, VkImageUsageFlags usage)
+	{
+		if (img && img->info.format == fmt && img->width() == w && img->height() == h) return;
+		if (img) vk::get_resource_manager()->dispose(img);
+		img = fg_make_image(fmt, w, h, usage);
+	}
+
+	vk::image_view* fg_view(vk::image* img)
+	{
+		return static_cast<vk::viewable_image*>(img)->get_view(rsx::default_remap_vector.with_encoding(vk::VK_REMAP_IDENTITY), VK_IMAGE_ASPECT_COLOR_BIT);
+	}
+
+	void fg_release_images()
+	{
+		auto& f = g_fg;
+		f.depth.reset(); f.mv.reset(); f.hud.reset();
+		f.b0.reset(); f.b1.reset(); f.hudless.reset(); f.ui.reset(); f.count.reset();
+		f.scene = f.hud_started = f.have_b0 = f.ready = false;
+	}
+
+	bool storage_ok(VkFormat fmt)
+	{
+		VkFormatProperties p{};
+		vkGetPhysicalDeviceFormatProperties(vk::get_current_renderer()->gpu(), fmt, &p);
+		return (p.optimalTilingFeatures & VK_FORMAT_FEATURE_STORAGE_IMAGE_BIT) != 0;
+	}
+
+	const VkImageSubresourceRange k_color_range{ VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0, 1 };
+
+	// swapchain image (in 'layout') -> dst (same format and size), both left as they were
+	void copy_from_target(vk::command_buffer& cmd, VkImage target, VkImageLayout layout, vk::viewable_image* dst)
+	{
+		vk::change_image_layout(cmd, target, layout, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, k_color_range);
+		dst->change_layout(cmd, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL);
+		VkImageCopy region{};
+		region.srcSubresource = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1 };
+		region.dstSubresource = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1 };
+		region.extent = { dst->width(), dst->height(), 1 };
+		vkCmdCopyImage(cmd, target, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, dst->value, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, 1, &region);
+		vk::change_image_layout(cmd, target, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, layout, k_color_range);
+		dst->change_layout(cmd, VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL);
+	}
+
+	unsigned long long now_ms() { return GetTickCount64(); }
+
+	// One line per change of the reason frame generation is not running (empty = running)
+	void set_reason(const std::string& why)
+	{
+		auto& f = g_fg;
+		if (why == f.reason) return;
+		const unsigned long long t = now_ms();
+		f.reason = why;
+		if (t - f.reason_ms < 500 && !fgcfg().debug) return;
+		f.reason_ms = t;
+		if (why.empty()) fglog("frame generation %ux on", f.mult);
+		else fglog("frame generation paused: %s", why.c_str());
+	}
+}
+
+namespace vk
+{
+	void r2fg_tag_scene(vk::command_buffer& cmd, vk::viewable_image* depth, vk::viewable_image* mv, u32 rw, u32 rh,
+		float jx, float jy, float mv_w, float mv_h, bool inverted, bool reset, const double* T, float zA, float zB)
+	{
+		if (!hud_snap() || !depth || !mv || rw < 64 || rh < 64) return;
+		auto& f = g_fg;
+		if (!hud_path())
+		{
+			// photo-mode HUD hide only: no frame-generation inputs, just restart the HUD classifier
+			f.scene = true;
+			f.hud_started = false;
+			f.unsure = false;
+			f.hud_draws = 0;
+			f.hud_rt = nullptr;
+			return;
+		}
+		if (vk::is_renderpass_open(cmd)) vk::end_renderpass(cmd);
+		const VkImageUsageFlags usage = VK_IMAGE_USAGE_STORAGE_BIT | VK_IMAGE_USAGE_SAMPLED_BIT;
+		fg_ensure(f.depth, VK_FORMAT_R32_SFLOAT, rw, rh, usage);
+		fg_ensure(f.mv, VK_FORMAT_R16G16_SFLOAT, rw, rh, usage);
+		f.depth->change_layout(cmd, VK_IMAGE_LAYOUT_GENERAL);
+		f.mv->change_layout(cmd, VK_IMAGE_LAYOUT_GENERAL);
+		auto pass = vk::get_compute_task<vk::r2fg_copy_pass>();
+		pass->in_depth = fg_view(depth);
+		pass->in_mv = fg_view(mv);
+		pass->out_depth = fg_view(f.depth.get());
+		pass->out_mv = fg_view(f.mv.get());
+		pass->run(cmd, rw, rh);
+		f.depth->change_layout(cmd, VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL);
+		f.mv->change_layout(cmd, VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL);
+
+		f.rw = rw; f.rh = rh;
+		f.jx = jx; f.jy = jy;
+		f.mvsx = mv_w / static_cast<float>(rw);
+		f.mvsy = mv_h / static_cast<float>(rh);
+		f.inverted = inverted;
+		f.reset = f.reset || reset;
+		double moved = 0.0;
+		for (int i = 0; i < 16; ++i) moved += std::fabs(T[i] - f.T[i]);
+		r2fgdiag::note_moved(moved);
+		if (moved > 1e-4) f.cam_ms = now_ms();
+		std::memcpy(f.T, T, sizeof(f.T));
+		f.zA = zA; f.zB = zB;
+		f.scene = true;
+		// the HUD of this frame starts after the scene: classification restarts here
+		f.hud_started = false;
+		f.unsure = false;
+		f.hud_draws = 0;
+		f.hud_rt = nullptr;
+	}
+}
+
+// HUD classifier, called for every draw from load_program_env (before the draw's render pass begins).
+// Conservative: the HUD starts at the first blended, depth-test-off draw into a display buffer after the
+// scene was handed to DLSS; the buffer is snapshotted right before it. Any depth-tested draw into it after
+// that, or a late opaque draw, marks the frame unsure and it is not split.
+void VKGSRender::r2fg_on_draw()
+{
+	auto& f = g_fg;
+	if (sl_device() && g_sl.reflex && !f.render_open)
+	{
+		std::lock_guard lk(f.mu);
+		f.cur_rid = std::max(f.present_id + 1, f.sim_id);
+		sl::FrameToken* tok = nullptr;
+		if (g_sl.fn_token(tok, &f.cur_rid) == sl::Result::eOk && tok) g_sl.fn_marker(sl::PCLMarker::eRenderSubmitStart, *tok);
+		f.render_open = true;
+	}
+	if (!f.scene || f.unsure || !((fgcfg().hud && hud_path()) || g_port_photo_hud)) return;
+
+	auto& sc = res()->surface_cache;
+	const u32 addr = sc.m_bound_render_targets[0].first;
+	auto* rt = sc.m_bound_render_targets[0].second;
+	const bool depth = REGS(m_ctx)->depth_test_enabled() && sc.m_bound_depth_stencil.second;
+	const bool blend = REGS(m_ctx)->blend_enabled();
+
+	const auto snapshot = [&]
+	{
+		if (rt->samples() > 1 || !(rt->info.usage & VK_IMAGE_USAGE_TRANSFER_SRC_BIT))
+		{
+			f.unsure = true;
+			return;
+		}
+		auto& cmd = *m_current_command_buffer;
+		if (vk::is_renderpass_open(cmd)) vk::end_renderpass(cmd);
+		fg_ensure(f.hud, rt->info.format, rt->width(), rt->height(), VK_IMAGE_USAGE_TRANSFER_SRC_BIT | VK_IMAGE_USAGE_TRANSFER_DST_BIT | VK_IMAGE_USAGE_SAMPLED_BIT);
+		rt->push_layout(cmd, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL);
+		f.hud->change_layout(cmd, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL);
+		VkImageCopy region{};
+		region.srcSubresource = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1 };
+		region.dstSubresource = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1 };
+		region.extent = { rt->width(), rt->height(), 1 };
+		vkCmdCopyImage(cmd, rt->value, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, f.hud->value, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, 1, &region);
+		rt->pop_layout(cmd);
+		f.hud->change_layout(cmd, VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL);
+		f.hud_rt = rt;
+		f.photo_snap = true;
+	};
+
+	if (!f.hud_started)
+	{
+		if (!rt || !addr || depth || !blend || !r2gx_is_display(addr)) return;
+		f.hud_started = true;
+		f.hud_addr = addr;
+		f.hud_draws = 1;
+		snapshot();
+		return;
+	}
+	if (addr != f.hud_addr) return; // off-screen work (UI render-to-texture, next frame's shadows) is not the HUD
+	if (depth)
+	{
+		f.unsure = true;
+		return;
+	}
+	if (!blend && f.hud_draws < 2)
+	{
+		// an opaque pass right after a lone blended one: that was post-processing, start over. Later opaque
+		// depth-off draws (alpha-tested icons) count as HUD; a full-screen one trips the coverage limit.
+		f.hud_started = false;
+		return;
+	}
+	f.hud_draws++;
+}
+
+namespace
+{
+	bool is_srgb(VkFormat f)
+	{
+		return f == VK_FORMAT_B8G8R8A8_SRGB || f == VK_FORMAT_R8G8B8A8_SRGB || f == VK_FORMAT_A8B8G8R8_SRGB_PACK32;
+	}
+	bool is_10bit(VkFormat f)
+	{
+		return f == VK_FORMAT_A2B10G10R10_UNORM_PACK32 || f == VK_FORMAT_A2R10G10B10_UNORM_PACK32;
+	}
+
+	// Phase 1: should frame generation run for this frame, and why not
+	void fg_decide()
+	{
+		auto& f = g_fg;
+		f.want_on = false;
+		const unsigned gap_was = f.gap;
+		f.streak = pfg_streak_gap(f.streak, f.scene, &f.gap, fgcfg().gap);
+		if (f.scene && gap_was && f.streak == PFG_WARMUP_FRAMES && fg_usable())
+		{
+			static u32 bridged = 0;
+			if (++bridged <= 4 || (bridged % 100) == 0)
+				fglog("frame generation: %u-frame scene gap bridged without the warm-up (%u so far; R3_DLSS_FG_GAP=0 restores it)", gap_was, bridged);
+		}
+		if (f.bad_status_frames) f.bad_status_frames--;
+		if (!fg_usable()) return;
+		f.mult = fx_usable() ? 2u : std::min<u32>(fgcfg().want, g_sl.max_mult);
+
+		// menu detection: no look input, play tick, camera movement or mouse / right-stick input for 1.5 s. The look tick alone
+		// goes stale in vehicles (the turret aims without it), so any of these keeps frame generation on.
+		const unsigned long long t = now_ms();
+		if (!g_port_pause_ui)
+		{
+			const unsigned long long mouse = g_kbm_mouse_abs;
+			const int rx = g_ml_fed_rx, ry = g_ml_fed_ry;
+			if (mouse != f.last_mouse || std::abs(rx) > 16 || std::abs(ry) > 16) f.input_ms = t;
+			f.last_mouse = mouse;
+		}
+		const unsigned long long look_ms = g_r2_look_ms, play_ms = g_port_play_ms;
+		const unsigned long long look = std::max(std::max(look_ms, play_ms), std::max(f.cam_ms, f.input_ms));
+		pfg_gate_in g{};
+		g.scene = f.scene;
+		g.paused = g_r2pc_paused != 0;
+		g.local_players = (g.scene && !g.paused) ? port_local_players() : 1; // only queried when it decides, as before
+		g.scrgb = g_pc_hdr_active == 2;
+		g.srgb = is_srgb(f.sc_format);
+#ifdef R2PORT_HAVE_FFX
+		g.fx_sc_bad = fx_usable() && !g_fx.sc_ok;
+#endif
+		g.menu_off = fgcfg().menu_off;
+		g.pause_ui = g_port_pause_ui != 0;
+		g.activity_ms = look;
+		g.now_ms = t;
+		g.bad_status = f.bad_status_frames;
+		g.streak = f.streak;
+		std::string why;
+		switch (pfg_gate(&g))
+		{
+		case PFG_GATE_NO_SCENE: why = "no 3D scene this frame (menu, movie or loading screen)"; break;
+		case PFG_GATE_PAUSED: why = "game paused"; break;
+		case PFG_GATE_SPLITSCREEN: why = "split-screen co-op"; break;
+		case PFG_GATE_SCRGB: why = "scRGB HDR output is not supported (use HDR10)"; break;
+		case PFG_GATE_SRGB: why = "sRGB swapchain format"; break;
+#ifdef R2PORT_HAVE_FFX
+		case PFG_GATE_FX_SWAPCHAIN: why = g_fx.sc_why.empty() ? std::string("FSR 3 swapchain unavailable") : g_fx.sc_why; break;
+#endif
+		case PFG_GATE_MENU: why = "in a menu (R2_DLSS_FG_MENU_OFF=0 keeps it on)"; break;
+		case PFG_GATE_BAD_STATUS: why = f.reason.empty() ? std::string("DLSS-G reported a problem") : f.reason; break;
+		case PFG_GATE_WARMUP: return; // warm-up after a menu: silent
+		default: break;
+		}
+		set_reason(why);
+		f.want_on = why.empty();
+	}
+}
+
+namespace vk
+{
+	static void r2fg_present_body(int phase, vk::command_buffer& cmd, VkImage target, VkImageLayout layout, vk::viewable_image* src,
+		u32 buffer_w, u32 buffer_h, s32 x1, s32 y1, s32 x2, s32 y2)
+	{
+		auto& f = g_fg;
+		if (!hud_path()) return;
+		if (phase == 0)
+		{
+			f.have_b0 = false;
+			const u32 W = f.sc_extent.width, H = f.sc_extent.height;
+			if (!f.scene || !src || !target || !f.sc_transfer || !W || !H || f.sc_format == VK_FORMAT_UNDEFINED) return;
+			if (vk::is_renderpass_open(cmd)) vk::end_renderpass(cmd);
+			fg_ensure(f.b0, f.sc_format, W, H, VK_IMAGE_USAGE_TRANSFER_DST_BIT | VK_IMAGE_USAGE_SAMPLED_BIT);
+			copy_from_target(cmd, target, layout, f.b0.get());
+			f.have_b0 = true;
+			return;
+		}
+
+		f.ready = true;
+		f.have_ui = false;
+		f.split = false;
+		fg_decide();
+		f.debug_view = fgcfg().hud_debug;
+		if (!(f.want_on || f.debug_view) || !f.have_b0 || !src || !target || x2 <= x1 || y2 <= y1 || !buffer_w || !buffer_h) return;
+
+		const u32 W = f.sc_extent.width, H = f.sc_extent.height;
+		const bool hdr10 = is_10bit(f.sc_format);
+		const VkFormat out_fmt = hdr10 ? VK_FORMAT_A2B10G10R10_UNORM_PACK32 : VK_FORMAT_R8G8B8A8_UNORM;
+		static int fmt_ok[2] = { -1, -1 };
+		int& ok = fmt_ok[hdr10 ? 1 : 0];
+		if (ok < 0)
+		{
+			ok = storage_ok(out_fmt) && storage_ok(VK_FORMAT_R32_UINT) ? 1 : 0;
+			if (!ok) fglog("HUD split unavailable: the GPU cannot write format %d from compute", static_cast<int>(out_fmt));
+		}
+		if (!ok) return;
+
+		if (vk::is_renderpass_open(cmd)) vk::end_renderpass(cmd);
+		fg_ensure(f.b1, f.sc_format, W, H, VK_IMAGE_USAGE_TRANSFER_DST_BIT | VK_IMAGE_USAGE_SAMPLED_BIT);
+		copy_from_target(cmd, target, layout, f.b1.get());
+
+		const VkImageUsageFlags out_usage = VK_IMAGE_USAGE_STORAGE_BIT | VK_IMAGE_USAGE_SAMPLED_BIT | VK_IMAGE_USAGE_TRANSFER_SRC_BIT;
+		fg_ensure(f.hudless, out_fmt, W, H, out_usage);
+		fg_ensure(f.ui, out_fmt, W, H, out_usage);
+		fg_ensure(f.count, VK_FORMAT_R32_UINT, 1, 1, VK_IMAGE_USAGE_STORAGE_BIT | VK_IMAGE_USAGE_TRANSFER_DST_BIT);
+		f.out_fmt = out_fmt;
+		if (hdr10 && f.sc_format != out_fmt)
+		{
+			static bool logged = false; // R3 #13: the typed UI / HUD-less formats are told to DLSS-G / FSR3, so differing orders are fine
+			if (!logged) fglog("HDR: swapchain format %d, UI / HUD-less format %d", static_cast<int>(f.sc_format), static_cast<int>(out_fmt));
+			logged = true;
+		}
+
+		const bool split = fgcfg().hud && f.hud && f.hud_rt == src && !f.unsure && f.hud_draws &&
+			f.hud->info.format == src->info.format && f.hud->width() == src->width() && f.hud->height() == src->height();
+
+		f.count->change_layout(cmd, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL);
+		const VkClearColorValue zero{};
+		vkCmdClearColorImage(cmd, f.count->value, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, &zero, 1, &k_color_range);
+		f.count->change_layout(cmd, VK_IMAGE_LAYOUT_GENERAL);
+		src->push_layout(cmd, VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL);
+
+		const float rect_w = static_cast<float>(x2 - x1), rect_h = static_cast<float>(y2 - y1);
+		const float k[12] = {
+			static_cast<float>(x1), static_cast<float>(y1), rect_w, rect_h,
+			static_cast<float>(std::min(buffer_w, src->width())) / static_cast<float>(src->width()),
+			static_cast<float>(std::min(buffer_h, src->height())) / static_cast<float>(src->height()),
+			static_cast<float>(W), static_cast<float>(H),
+			0.5f / 255.f, 0.25f / 1023.f, 0.3f * rect_w * rect_h,
+			static_cast<float>((split ? 1 : 0) | (hdr10 ? 2 : 0) | (f.debug_view ? 4 : 0)) };
+		const auto bind = [&](vk::r2fg_hud_pass_base* pass)
+		{
+			pass->in[0] = split ? fg_view(f.hud.get()) : fg_view(f.b0.get());
+			pass->in[1] = split ? fg_view(src) : fg_view(f.b0.get());
+			pass->in[2] = fg_view(f.b0.get());
+			pass->in[3] = fg_view(f.b1.get());
+			pass->count = fg_view(f.count.get());
+		};
+		if (split)
+		{
+			auto pass = vk::get_compute_task<vk::r2fg_mask_pass>();
+			bind(pass);
+			pass->run(cmd, k, W, H);
+			vk::insert_global_memory_barrier(cmd);
+		}
+		f.hudless->change_layout(cmd, VK_IMAGE_LAYOUT_GENERAL);
+		f.ui->change_layout(cmd, VK_IMAGE_LAYOUT_GENERAL);
+		const auto compose = [&](auto* pass)
+		{
+			bind(pass);
+			pass->out_hudless = fg_view(f.hudless.get());
+			pass->out_ui = fg_view(f.ui.get());
+			pass->run(cmd, k, W, H);
+		};
+		if (hdr10) compose(vk::get_compute_task<vk::r2fg_compose_pass<true>>());
+		else compose(vk::get_compute_task<vk::r2fg_compose_pass<false>>());
+		src->pop_layout(cmd);
+		f.ui->change_layout(cmd, VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL);
+
+		if (f.debug_view)
+		{
+			// the tinted frame replaces the swapchain image; nothing is tagged as UI
+			f.hudless->change_layout(cmd, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL);
+			vk::change_image_layout(cmd, target, layout, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, k_color_range);
+			VkImageBlit blit{};
+			blit.srcSubresource = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1 };
+			blit.dstSubresource = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1 };
+			blit.srcOffsets[1] = { static_cast<s32>(W), static_cast<s32>(H), 1 };
+			blit.dstOffsets[1] = { static_cast<s32>(W), static_cast<s32>(H), 1 };
