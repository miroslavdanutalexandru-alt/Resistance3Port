+			st.res_w = 0;
+			r2aa_fallback(2, "DLSS evaluation failed");
+		}
+	}
+	else if (st.backend == 3)
+	{
+		auto xi = [](vk::viewable_image* img)
+		{
+			return vk::r2xess::image{ img->value, plain_view(img)->value, img->info.format, img->info.extent.width, img->info.extent.height };
+		};
+		ok = vk::r2xess::eval(cmd, xi(st.color.get()), xi(st.depth.get()), xi(st.mv.get()), xi(st.out.get()),
+			rw, rh, jx, jy, st.vw, st.vh, reset);
