+	}
+	prep->obj_table = st.obj_buf.get();
+	prep->obj_table_len = st.obj_buf->size();
+	if (!g_om2.vb_dummy)
+	{
+		g_om2.vb_dummy = std::make_unique<vk::buffer>(*m_device, 32, m_device->get_memory_mapping().device_local, VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT,
+			VK_BUFFER_USAGE_STORAGE_BUFFER_BIT | VK_BUFFER_USAGE_TRANSFER_DST_BIT, 0, VMM_ALLOCATION_POOL_UNDEFINED);
+	}
+	prep->vel_buf = g_om2.vb ? g_om2.vb.get() : g_om2.vb_dummy.get();
