+			float sr[VPL][4] = {};
+			bool swrite = true;
+			switch (sop)
+			{
+			case RSX_SCA_OPCODE_MOV: R2_LANES sr[l][i] = s2[l][i]; break;
+			case RSX_SCA_OPCODE_RCP: R2_LANES sr[l][i] = 1.f / s2[l][i]; break;
+			case RSX_SCA_OPCODE_RCC: R2_LANES sr[l][i] = std::fmin(std::fmax(1.f / s2[l][i], 5.42101e-20f), 1.884467e19f); break;
