+#pragma once
+// R3PORT: RSX_RECORD_THREAD. Vulkan command recording moved off rsx::thread.
+//
+// Every vkCmd* call (and vkUpdateDescriptorSets) made by the rsx thread is captured into a packet (all
+// arguments deep-copied) and pushed into an SPSC ring; the "rsx record" thread replays the packets, i.e.
+// makes the real driver calls, in order. Host calls that need the command buffers to be complete or that
+// destroy/recycle something a pending packet may reference (begin/end/reset/free command buffers, submit,
+// present, wait idle, descriptor pool reset, every vkDestroy*/vkFreeMemory) drain the ring first.
+// Code that hands our command buffer to a foreign library (DLSS/NGX, FSR/FFX, XeSS, Streamline) runs in a
+// r2rec::direct_scope: drain, then record directly on the calling thread.
+//
+//   RSX_RECORD_THREAD=0  off (default): the wrappers call the driver directly
+//   RSX_RECORD_THREAD=1  record thread
+//   RSX_RECORD_THREAD=2  validation: same packet path, replayed on the calling thread at every drain
+//
+// This header is included at the end of VulkanAPI.h. VKRecordThread.cpp defines R2REC_NO_REDIRECT to see
+// the real functions.
+
+#include <cstdint>
+
+namespace r2rec
+{
+	enum class reason : int
+	{
+		cb_begin, cb_end, cb_reset, cb_alloc, cb_free, pool_destroy,
+		submit, present, wait_idle, desc_pool, destroy, free_mem,
+		foreign, flip, fallback, ring_full, shutdown, other_thread,
+		count
+	};
+
+	extern int g_mode;
+	extern thread_local bool t_defer;
+
+	// R3PORT: RSX_MICRO_A. Bumped by every graphics vkCmdBindPipeline and every vkCmdSet{Viewport,Scissor,LineWidth,
+	// DepthBias,BlendConstants,DepthBounds,Stencil*} recorded by this thread outside t_dyn_own (the main RSX draw's
+	// own pipeline bind / dynamic state), and by direct_scope (foreign recorders). VKGSRender::update_draw_state
+	// keeps its last-set dynamic state while this is unchanged.
+	extern thread_local uint32_t t_dyn_foreign;
+	extern thread_local bool t_dyn_own;
+	struct dyn_own_scope
+	{
+		dyn_own_scope() { t_dyn_own = true; }
+		~dyn_own_scope() { t_dyn_own = false; }
+	};
+
+	// R3PORT: micro-win switches (RSX_MICRO_A / RSX_MICRO_B, default 1) and the [micro] counters line (on_flip)
+	bool micro_a();
+	bool micro_b();
+	enum micro_counter : int { mc_dyn_calls, mc_dyn_skipped, mc_dyn_resets, mc_count };
+	extern uint64_t g_micro[mc_count]; // rsx thread only
+
+	void sync_slow(reason r);
+	inline void sync(reason r)
+	{
+		if (g_mode) sync_slow(r);
+	}
+
+	inline bool deferring()
+	{
+		return t_defer && g_mode;
+	}
+
+	// The rsx thread's renderer init / shutdown (idempotent)
+	void start();
+	void stop();
+	// Called once per flip by the producer: stats window
+	void on_flip();
+
+	// Drain, then record directly on this thread until the scope ends (foreign recorders)
+	struct direct_scope
+	{
+		bool prev;
+		explicit direct_scope(reason r = reason::foreign)
+			: prev(t_defer)
+		{
+			++t_dyn_foreign;
+			if (prev)
+			{
+				if (g_mode) sync_slow(r);
+				t_defer = false;
+			}
+		}
+		~direct_scope() { t_defer = prev; ++t_dyn_foreign; }
+		direct_scope(const direct_scope&) = delete;
+		direct_scope& operator=(const direct_scope&) = delete;
+	};
+}
+
+#ifndef R2REC_NO_REDIRECT
+
+// Deferred commands: r2rec::d_<name> captures, the wrapper falls through to the driver when not deferring.
+// The wrappers are defined before the redirect macros, so their bodies call the real functions.
+#define R2REC_DEFER(name, params, args) \
+	namespace r2rec { void d_##name params; } \
+	inline void r2rec_##name params { if (r2rec::deferring()) r2rec::d_##name args; else name args; }
+
+#define R2REC_SYNC(ret, name, why, params, args) \
+	inline ret r2rec_##name params { r2rec::sync(r2rec::reason::why); return name args; }
+
+// Dynamic state setters: as R2REC_DEFER, plus the RSX_MICRO_A foreign-write count
+#define R2REC_DEFER_DYN(name, params, args) \
+	namespace r2rec { void d_##name params; } \
+	inline void r2rec_##name params { r2rec::t_dyn_foreign += !r2rec::t_dyn_own; if (r2rec::deferring()) r2rec::d_##name args; else name args; }
+
+namespace r2rec { void d_vkCmdBindPipeline(VkCommandBuffer c, VkPipelineBindPoint bp, VkPipeline p); }
+inline void r2rec_vkCmdBindPipeline(VkCommandBuffer c, VkPipelineBindPoint bp, VkPipeline p)
+{
+	r2rec::t_dyn_foreign += (bp == VK_PIPELINE_BIND_POINT_GRAPHICS && !r2rec::t_dyn_own);
+	if (r2rec::deferring()) r2rec::d_vkCmdBindPipeline(c, bp, p); else vkCmdBindPipeline(c, bp, p);
+}
