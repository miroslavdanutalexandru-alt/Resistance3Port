diff --git a/rpcs3/Emu/RSX/port_adsrb.h b/rpcs3/Emu/RSX/port_adsrb.h
new file mode 100644
index 0000000..5cfba03
--- /dev/null
+++ b/rpcs3/Emu/RSX/port_adsrb.h
@@ -0,0 +1,392 @@
+#pragma once
+
+// R3PORT: asynchronous readback of render targets the CPU/SPU reads back every frame (pure logic, unit tested in
+// scratch\enginetest\test_adsrb). R3's ADS depth of field (SPU job 419) reads the FP16 light buffer at 0x30030000
+// that the RSX just rendered; upstream copies it to host memory only when the SPU faults on it (GPU copy + wait).
+//
+// RSX_ADS_ASYNC_RB (default 1): a surface flushed in consecutive frames becomes "hot". When the RSX unbinds it, or waits on a
+//   label, its GPU->host copy (resolution downscale + tiling on the GPU, as on the fault path) is recorded and submitted
+//   right away; the fault then only waits for that copy if it has not finished yet. Any write to the surface after the copy
+//   drops it (section create()/reprotect(), ROP timestamp check in flush_set), so the SPU still sees this frame's data.
+//   0 = upstream behaviour (no tracking, no early copies).
+// RSX_ADS_STALE_OK (default 0): if the copy is still in flight at the fault, give the SPU the data from the previous
+//   readback of that surface instead of waiting (never twice in a row). Approximate; off by default.
+
+#include <atomic>
+#include <chrono>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <mutex>
+#include <vector>
+
+namespace adsrb
+{
+	inline bool env_switch(const char* name, bool def)
+	{
+		const char* v = std::getenv(name);
+		if (!v || !v[0]) return def;
+		return v[0] != '0';
+	}
+
+	struct config
+	{
+		bool async = true;
+		bool stale_ok = false;
+	};
+
+	inline config read_config()
+	{
+		config c;
+		c.async = env_switch("RSX_ADS_ASYNC_RB", true);
+		c.stale_ok = c.async && env_switch("RSX_ADS_STALE_OK", false);
+		return c;
+	}
+
+	inline const config& cfg()
+	{
+		static const config c = []
+		{
+			const config r = read_config();
+			std::printf("[ads-rb] RSX_ADS_ASYNC_RB=%d RSX_ADS_STALE_OK=%d\n", r.async ? 1 : 0, r.stale_ok ? 1 : 0);
+			std::fflush(stdout);
+			return r;
+		}();
+		return c;
+	}
+
+	inline uint64_t now_ns()
+	{
+		return static_cast<uint64_t>(std::chrono::duration_cast<std::chrono::nanoseconds>(
+			std::chrono::steady_clock::now().time_since_epoch()).count());
+	}
+
+	struct range
+	{
+		uint32_t start = 0;
+		uint32_t end = 0; // inclusive
+	};
+
+	// Surfaces flushed to the CPU recently. A range is hot once it was flushed twice with at most hot_window_ns between
+	// flushes; it gets at most max_kicks early copies between two flushes (bounds wasted GPU copies when the guess is wrong).
+	// A range with an early copy in flight (pending) is never evicted, so the copy can always be found and dropped.
+	class hot_tracker
+	{
+	public:
+		static constexpr int max_entries = 4;
+		static constexpr uint64_t hot_window_ns = 250'000'000;
+		static constexpr uint32_t min_streak = 2;
+		static constexpr uint32_t max_kicks = 4;
+
+		enum class select { kick, pending };
+
+	private:
+		struct entry
+		{
+			range r{};
+			uint64_t last_ns = 0;
+			uint32_t streak = 0;
+			uint32_t kicks = 0;
+			bool used = false;
+			bool pending = false;
+		};
+
+		entry m_e[max_entries]{};
+		std::atomic<uint64_t> m_last_flush_ns{ 0 };
+		std::atomic<uint32_t> m_pending{ 0 };
+		mutable std::mutex m_mutex;
+
+		bool live(const entry& e, uint64_t now) const
+		{
+			return e.used && e.streak >= min_streak && now - e.last_ns <= hot_window_ns;
+		}
+
+		entry* find(range r)
+		{
+			for (auto& e : m_e)
+			{
+				if (e.used && e.r.start == r.start && e.r.end == r.end) return &e;
+			}
+			return nullptr;
+		}
+
+		void recount_pending()
+		{
+			uint32_t n = 0;
+			for (const auto& e : m_e) n += (e.used && e.pending) ? 1 : 0;
+			m_pending.store(n, std::memory_order_relaxed);
+		}
+
+	public:
+		void on_flush(range r, uint64_t now)
+		{
+			std::lock_guard lock(m_mutex);
+			entry* slot = find(r);
+			if (!slot)
+			{
+				// Reuse a free or the oldest entry without a copy in flight
+				for (auto& e : m_e)
+				{
+					if (e.used && e.pending) continue;
+					if (!e.used) { slot = &e; break; }
+					if (!slot || e.last_ns < slot->last_ns) slot = &e;
+				}
+				if (!slot) return; // every entry has a copy in flight: do not track this range
+				*slot = {};
+				slot->used = true;
+				slot->r = r;
+			}
+			slot->streak = (slot->streak && now - slot->last_ns <= hot_window_ns) ? slot->streak + 1 : 1;
+			slot->last_ns = now;
+			slot->kicks = 0;
+			slot->pending = false;
+			recount_pending();
+			m_last_flush_ns.store(now, std::memory_order_relaxed);
+		}
+
+		// Cheap checks before taking any lock
+		bool maybe_hot(uint64_t now) const
+		{
+			const uint64_t last = m_last_flush_ns.load(std::memory_order_relaxed);
+			return last && now - last <= hot_window_ns;
+		}
+
+		bool any_pending() const
+		{
+			return m_pending.load(std::memory_order_relaxed) != 0;
+		}
+
+		// select::kick: hot ranges overlapping [lo, hi] with kick budget left. select::pending: ranges with an early copy in flight.
+		int collect(uint64_t now, uint32_t lo, uint32_t hi, range* out, select what = select::kick) const
+		{
+			std::lock_guard lock(m_mutex);
+			int n = 0;
+			for (const auto& e : m_e)
+			{
+				const bool ok = (what == select::kick) ? (live(e, now) && e.kicks < max_kicks) : (e.used && e.pending);
+				if (ok && e.r.start <= hi && lo <= e.r.end)
+				{
+					out[n++] = e.r;
+				}
+			}
+			return n;
+		}
+
+		void on_kick(range r)
+		{
+			std::lock_guard lock(m_mutex);
+			if (entry* e = find(r))
+			{
+				e->kicks++;
+				e->pending = true;
+				recount_pending();
+			}
+		}
+
+		bool is_hot(range r, uint64_t now) const
+		{
+			std::lock_guard lock(m_mutex);
+			for (const auto& e : m_e)
+			{
+				if (live(e, now) && e.r.start == r.start && e.r.end == r.end) return true;
+			}
+			return false;
+		}
+	};
+	// RSX_ADS_STALE_OK: last real bytes written for a range. Served at most once in a row, only for the same length.
+	class stale_store
+	{
+		struct snap
+		{
+			uint32_t start = 0;
+			uint32_t len = 0;
+			std::vector<uint8_t> data;
+			bool last_was_stale = false;
+			uint64_t used_ns = 0;
+		};
+
+		snap m_s[hot_tracker::max_entries]{};
+		std::mutex m_mutex;
+
+	public:
+		bool try_serve(uint32_t start, uint32_t len, uint8_t* dst)
+		{
+			std::lock_guard lock(m_mutex);
+			for (auto& s : m_s)
+			{
+				if (s.len && s.start == start && s.len == len)
+				{
+					if (s.last_was_stale) return false;
+					std::memcpy(dst, s.data.data(), len);
+					s.last_was_stale = true;
+					return true;
+				}
+			}
+			return false;
+		}
+
+		void refresh(uint32_t start, uint32_t len, const uint8_t* src, uint64_t now)
+		{
+			std::lock_guard lock(m_mutex);
+			snap* slot = nullptr;
+			for (auto& s : m_s)
+			{
+				if (s.len && s.start == start) { slot = &s; break; }
+			}
+			if (!slot)
+			{
+				slot = &m_s[0];
+				for (auto& s : m_s)
+				{
+					if (!s.len) { slot = &s; break; }
+					if (s.used_ns < slot->used_ns) slot = &s;
+				}
+			}
+			slot->start = start;
+			slot->len = len;
+			slot->data.assign(src, src + len);
+			slot->last_was_stale = false;
+			slot->used_ns = now;
+		}
+	};
+
+	inline void atomic_max(std::atomic<uint64_t>& a, uint64_t v)
+	{
+		uint64_t cur = a.load(std::memory_order_relaxed);
+		while (cur < v && !a.compare_exchange_weak(cur, v, std::memory_order_relaxed)) {}
+	}
+
+	// Label (semaphore acquire) wait episodes on the RSX thread, split around the readback fault that happened inside it
+	struct label_split
+	{
+		uint64_t n = 0, total_ns = 0;
+		uint64_t with_fault = 0, pre_ns = 0, flush_ns = 0, post_ns = 0;
+		uint64_t fault_before = 0;
+	};
+
+	struct stats
+	{
+		std::atomic<uint64_t> flushes{ 0 }, hot_flushes{ 0 };
+		std::atomic<uint64_t> wait_ns{ 0 }, wait_max_ns{ 0 };
+		std::atomic<uint64_t> hits{ 0 }, late{ 0 }, misses{ 0 }, stale{ 0 };
+		std::atomic<uint64_t> kicks{ 0 }, wasted{ 0 };
+		std::atomic<uint64_t> av_n{ 0 }, av_ns{ 0 }, av_max_ns{ 0 };
+
+		// Last access-violation readback (fault thread writes, RSX thread reads)
+		std::atomic<uint64_t> av_begin_ns{ 0 }, av_end_ns{ 0 };
+
+		// RSX thread only
+		uint64_t ep_start = 0, ep_last = 0;
+		label_split ls{};
+		uint64_t last_report_ns = 0;
+
+		static constexpr uint64_t episode_gap_ns = 2'000'000;
+		static constexpr uint64_t min_episode_ns = 1'000'000;
+		static constexpr uint64_t report_ns = 5'000'000'000ull;
+
+		void on_flush_wait(bool hot, bool speculative, bool was_ready, uint64_t waited_ns)
+		{
+			flushes.fetch_add(1, std::memory_order_relaxed);
+			if (hot) hot_flushes.fetch_add(1, std::memory_order_relaxed);
+			(speculative ? (was_ready ? hits : late) : misses).fetch_add(1, std::memory_order_relaxed);
+			wait_ns.fetch_add(waited_ns, std::memory_order_relaxed);
+			atomic_max(wait_max_ns, waited_ns);
+		}
+
+		void on_av(uint64_t begin, uint64_t end)
+		{
+			av_n.fetch_add(1, std::memory_order_relaxed);
+			av_ns.fetch_add(end - begin, std::memory_order_relaxed);
+			atomic_max(av_max_ns, end - begin);
+			av_begin_ns.store(begin, std::memory_order_relaxed);
+			av_end_ns.store(end, std::memory_order_relaxed);
+		}
+
+		// Split one finished wait [start, end] around the last readback fault
+		static void split_episode(label_split& ls, uint64_t start, uint64_t end, uint64_t fb, uint64_t fe)
+		{
+			if (end - start < min_episode_ns) return;
+			ls.n++;
+			ls.total_ns += end - start;
+			if (fe && fe >= start && fe <= end)
+			{
+				const uint64_t b = fb > start ? fb : start;
+				ls.with_fault++;
+				ls.pre_ns += b - start;
+				ls.flush_ns += fe - b;
+				ls.post_ns += end - fe;
+			}
+			else if (fe && fe < start && start - fe < 50'000'000)
+			{
+				ls.fault_before++;
+			}
+		}
+
+		// Called on every acquire poll (~100 us apart). Episodes are closed lazily once the next one starts.
+		void on_label_poll(uint64_t now)
+		{
+			if (ep_start && now - ep_last > episode_gap_ns)
+			{
+				split_episode(ls, ep_start, ep_last, av_begin_ns.load(std::memory_order_relaxed), av_end_ns.load(std::memory_order_relaxed));
+				ep_start = 0;
+			}
+			if (!ep_start) ep_start = now;
+			ep_last = now;
+		}
+
+		// Returns true (and fills buf) once per report period when there was activity; counters restart
+		bool report(uint64_t now, char* buf, size_t size)
+		{
+			if (!last_report_ns) { last_report_ns = now; return false; }
+			if (now - last_report_ns < report_ns) return false;
+			const double secs = double(now - last_report_ns) / 1e9;
+			last_report_ns = now;
+
+			if (ep_start && now - ep_last > episode_gap_ns)
+			{
+				split_episode(ls, ep_start, ep_last, av_begin_ns.load(std::memory_order_relaxed), av_end_ns.load(std::memory_order_relaxed));
+				ep_start = 0;
+			}
+
+			const uint64_t f = flushes.exchange(0), hf = hot_flushes.exchange(0), w = wait_ns.exchange(0), wm = wait_max_ns.exchange(0);
+			const uint64_t h = hits.exchange(0), l = late.exchange(0), m = misses.exchange(0), s = stale.exchange(0);
+			const uint64_t k = kicks.exchange(0), wa = wasted.exchange(0);
+			const uint64_t an = av_n.exchange(0), at = av_ns.exchange(0), am = av_max_ns.exchange(0);
+			const label_split L = ls;
+			ls = {};
+
+			if (!f && !k && !an) return false;
+
+			const auto ms = [](uint64_t ns, uint64_t n) { return n ? double(ns) / double(n) / 1e6 : 0.0; };
+			std::snprintf(buf, size,
+				"[ads-rb] %.1fs: %llu flushes (hot %llu), wait avg %llu max %llu us, av-fault avg %llu max %llu us (%llu), "
+				"async hits %llu late %llu misses %llu, stale %llu, kicks %llu wasted %llu | "
+				"label waits>1ms %llu avg %.2f ms; with readback %llu: before-fault %.2f + readback %.2f + after %.2f ms; fault-before-wait %llu",
+				secs,
+				(unsigned long long)f, (unsigned long long)hf,
+				(unsigned long long)(f ? w / f / 1000 : 0), (unsigned long long)(wm / 1000),
+				(unsigned long long)(an ? at / an / 1000 : 0), (unsigned long long)(am / 1000), (unsigned long long)an,
+				(unsigned long long)h, (unsigned long long)l, (unsigned long long)m, (unsigned long long)s,
+				(unsigned long long)k, (unsigned long long)wa,
+				(unsigned long long)L.n, ms(L.total_ns, L.n),
+				(unsigned long long)L.with_fault, ms(L.pre_ns, L.with_fault), ms(L.flush_ns, L.with_fault), ms(L.post_ns, L.with_fault),
+				(unsigned long long)L.fault_before);
+			return true;
+		}
+	};
+
+	inline hot_tracker& hot() { static hot_tracker t; return t; }
+	inline stale_store& stale() { static stale_store s; return s; }
+	inline stats& st() { static stats s; return s; }
+
+	inline void maybe_report(uint64_t now)
+	{
+		char buf[640];
+		if (st().report(now, buf, sizeof(buf)))
+		{
+			std::printf("%s\n", buf);
+			std::fflush(stdout);
+		}
+	}
+}
diff --git a/rpcs3/Emu/RSX/port_backoff.h b/rpcs3/Emu/RSX/port_backoff.h
new file mode 100644
index 0000000..830d098
--- /dev/null
+++ b/rpcs3/Emu/RSX/port_backoff.h
@@ -0,0 +1,43 @@
+#pragma once
+
+// Port: bounded spin for RSX wait loops. Pure pause-spinning is fine with spare cores, but on a
+// 4-core CPU the spinner steals the core the producer (offloader, SPU, driver) needs, which made
+// frame rate collapse. Spin ~4 us for the low-latency case, then give the core away.
+#include "util/asm.hpp"
+#include <thread>
+
+#ifdef _WIN32
+extern "C" __declspec(dllimport) void __stdcall Sleep(unsigned long);
+#endif
+extern "C" int ps3_host_prio_boost(); // 1 = >= 8 logical CPUs: keep the original pure spin
+
+namespace rsx
+{
+	struct port_backoff
+	{
+		unsigned n = 0;
+
+		void operator()()
+		{
+			static const bool big = ps3_host_prio_boost() != 0;
+			if (big || n < 64)
+			{
+				utils::pause();
+			}
+			else if (n < 256)
+			{
+				std::this_thread::yield();
+			}
+			else
+			{
+#ifdef _WIN32
+				::Sleep(0);
+#else
+				std::this_thread::yield();
+#endif
+			}
+
+			if (n < 0xFFFF) n++;
+		}
+	};
+}
diff --git a/rpcs3/Emu/RSX/port_prof.h b/rpcs3/Emu/RSX/port_prof.h
new file mode 100644
index 0000000..7f9b151
--- /dev/null
+++ b/rpcs3/Emu/RSX/port_prof.h
@@ -0,0 +1,245 @@
+#pragma once
+
+// R2PORT: R2_RSX_PROF=1 counters for the Resistance 2 port. The bridge (r2rsx_bridge.cpp) sets
+// r2prof::enabled before the RSX thread starts and prints the totals every 5 s. Everything is a
+// no-op branch when disabled. Per-frame stats (frame_statistics_t) are folded in at frame end.
+
+#include <atomic>
+#include <chrono>
+#include <cstdint>
+#if defined(_WIN32) && (defined(_M_X64) || defined(__x86_64__))
+#include <intrin.h> // R2PORT round 7: __rdtsc for now_ns
+#endif
+
+namespace r2prof
+{
+	inline bool enabled = false;
+	// rsx::thread is between core_renderer::begin() and the end of the draw
+	inline bool in_draw = false;
+	// rsx::thread is inside the fb-bind lock phase (VirtualProtect attribution)
+	inline thread_local bool in_fbb = false;
+
+	struct counters_t
+	{
+		std::atomic<uint64_t> frames{0}, draws{0}, submits{0};
+		// rsx::profiling_timer phases (µs), summed from frame_statistics_t
+		std::atomic<uint64_t> setup_us{0}, program_us{0}, vertex_us{0}, texture_us{0}, exec_us{0}, flip_us{0};
+		// core_renderer::begin(): framebuffer bind + backend begin_draw (µs)
+		std::atomic<uint64_t> fb_ns{0};
+		// begin() .. post_draw_hook() wall time of all draws (ns)
+		std::atomic<uint64_t> draw_ns{0};
+		std::atomic<uint64_t> vtx_cache_req{0}, vtx_cache_miss{0}, prog_lookups{0}, prog_elided{0};
+		// VKGSRender::flush_command_queue
+		std::atomic<uint64_t> flushes{0}, hard_syncs{0}, flush_ns{0};
+		// ZCULL report reads that had to wait on the host GPU
+		std::atomic<uint64_t> zcull_reads{0}, zcull_read_ns{0};
+		// Host page faults routed to rsx::g_access_violation_handler (bridge hook)
+		std::atomic<uint64_t> av_calls{0}, av_handled{0}, av_ns{0};
+		// Texture cache: flush_all on a fault (RSX-thread readback)
+		std::atomic<uint64_t> av_flushes{0};
+		// Round-2 breakdown counters, indexed by r2prof::xc (printed by name in the bridge)
+		std::atomic<uint64_t> x[192]{};
+	};
+
+	// Sub-phase counters. *_ns are nanoseconds, the rest are event counts.
+	enum xc : int
+	{
+		// on_framebuffer_bound (full rebinds only)
+		fbb_full, fbb_ignore, fbb_aa_ns, fbb_prep_ns, fbb_wcb_ns, fbb_wcb_copies, fbb_wcb_skipped, fbb_dma_flush,
+		fbb_lock_ns, fbb_rp_ns, fbb_total_ns,
+		// flush_command_queue callers
+		fl_zcull_hint, fl_zcull_hard, fl_av_request, fl_bind_dma,
+		// ZCULL
+		zc_sync_calls, zc_batch_calls, zc_batch_slots, zc_poll_loops, zc_flush_serviced,
+		// access violations that needed a GPU readback: wait for the RSX thread, then copy/wait
+		av_wait_ns, av_flush_ns, av_max_ns,
+		// vertex upload: layouts the weak cache cannot hold (multi-block / inline)
+		vtx_uncacheable,
+		// Round 3: rsx::thread time outside begin()..end() of draws (ns)
+		od_clear_ns, od_clears, od_fbb_ns, od_flush_ns, od_label_ns, od_blit_ns, od_flip_ns, od_house_ns, od_zcull_ns,
+		// DLSS/FSR hooks (VKR2Upscaler / pass dump call sites), total and the part inside draws (ns)
+		dlss_ns, dlss_draw_ns,
+		// Program resolve: backend lookup time (ns), why the cache hint was dropped
+		prog_lookup_ns, prog_vp_ucode, prog_fp_ucode, prog_vp_state, prog_fp_state,
+		// R3 only: program lookups answered by the ucode MRU (ProgramStateCache.h) instead of hash + map lookup
+		prog_mru_hits,
+		// Re-sent fragment / vertex programs kept without re-analysis (RSXGraphEngine, R2_FP_REBIND / R2_VP_REBIND),
+		// pipeline lookups answered by the last-pipeline memo (VKGSRender, R2_PIPE_MEMO)
+		prog_fp_rebind, prog_vp_rebind, prog_memo_hits,
+		// Deferred ZCULL labels (R2_ZCULL_DEFER)
+		zc_deferred, zc_released, zc_drain_block, zc_drain_ns, zc_fence_waits,
+		// Round 4: fb-bind lock phase split (ns), worst rebind lock time, rebinds whose lock phase took > 20 us
+		fbb_lk_discard_ns, fbb_lk_orphan_ns, fbb_lk_color_ns, fbb_lk_depth_ns, fbb_lk_max_ns, fbb_lk_slow,
+		// texture cache: m_cache_mutex wait on rsx::thread, invalidate_range_impl_base calls/ns/sections unprotected,
+		// lock_memory_region: already-locked relocks vs fresh locks (reset + protect)
+		tc_mutex_wait_ns, tc_inval_calls, tc_inval_ns, tc_unprotected, tc_relock, tc_fresh_lock,
+		// host VirtualProtect (utils::memory_protect): calls/ns on any thread, the part inside the fb-bind lock phase,
+		// calls skipped because VirtualQuery showed the pages already had that protection (R2_MM_SKIPSAME), pages
+		mm_vp_calls, mm_vp_ns, mm_vp_fbb_calls, mm_vp_fbb_ns, mm_vp_skipped, mm_vp_pages,
+		// g_mprotect_queue_lock wait on rsx::thread (ns); Offloader queue flushes
+		mm_qlock_wait_ns, mm_offload_flushes,
+		// flip_command split: frame limiter sleep, present (flip()), ZCULL labels carried over a flip (R2_ZCULL_FLIP_LAG)
+		od_limit_ns, od_present_ns, zc_flip_carried,
+		// program phase split (ns): ucode analysis (prefetch_*), load_program, transform constants (+bytes),
+		// fragment constants, remaining env/bind work in load_program_env
+		prog_analyse_ns, prog_load_ns, prog_xform_ns, prog_xform_bytes, prog_fconst_ns, prog_env_ns,
+		// R2_FBB_KEEP: rebinds avoided by keeping an unused depth / colour target bound
+		fbb_keep_depth, fbb_keep_color,
+		// Round 5: texture cache flush_set (blocking GPU readback) calls/ns/sections, the committed_as_fbo part,
+		// flushes skipped by R2_FBO_COMMIT_FLUSH=0 (sections fully overwritten by the new render target)
+		tc_flush_calls, tc_flush_ns, tc_flush_sections, tc_flush_commit_calls, tc_flush_commit_ns, tc_commit_skip,
+		// Round 5: load_program_env "rest" split (ns): vertex env, fragment texture env, bind_uniform calls, instancing,
+		// fragment env, DLSS/FSR draw hook (r2aa_on_draw, includes the AA run when it fires there)
+		pe_vtx_env_ns, pe_tex_env_ns, pe_bind_ns, pe_inst_ns, pe_frag_env_ns, pe_aa_ns,
+		// Round 6: flip_command split (od self ns): deferred-label drain/poll, reset() (ZCULL state), on_frame_end,
+		// the rest of the flip (handle_emu_flip outside limiter/present). ZCULL reads answered without waiting vs
+		// reads that had to wait for the GPU (fence), and the ns of those waits; reads by caller (update / sync / forced)
+		od_fl_drain_ns, od_fl_reset_ns, od_fl_end_ns, od_fl_emu_ns,
+		zc_read_ready, zc_read_wait, zc_read_wait_ns, zc_read_update, zc_read_forced,
+		// Round 7: draw "other" split (ns): core_renderer::begin() (incl. fb-bind), end() (incl. the phases), post_draw_hook;
+		// the rest of begin()..end of draw is method processing between begin and end.
+		dr_begin_ns, dr_end_ns, dr_post_ns,
+		// lock_memory_region_impl: superseded invalidation, create + reprotect (ns); why a lock was fresh (no section,
+		// section unlocked, section used for something else); superseded surfaces discarded in the fb-bind lock phase
+		lk_inval_ns, lk_create_ns, lk_fresh_noexist, lk_fresh_unlocked, lk_fresh_ctx, lk_superseded,
+		// invalidate_range_impl_base split (ns): get_intersecting_set, unprotect_set; sections discarded in the fast path
+		inval_isect_ns, inval_unprot_ns, inval_discards,
+		// Round 8: end() split (ns): decode_draw_state, resolve programs + pipeline state, write barriers, surface on_write;
+		// texture env load (resolve_sampler_state) and bind loop; Vulkan recording (pipeline/descriptor bind, dynamic state,
+		// draw emit); vertex split: index upload ns/bytes, attribute bytes, layout update ns
+		dr_decode_ns, dr_resolve_ns, dr_barrier_ns, dr_onwrite_ns, tex_load_ns, tex_bind_ns, vk_bind_ns, vk_dyn_ns, vk_draw_ns,
+		vtx_idx_ns, vtx_idx_bytes, vtx_data_bytes, vtx_layout_ns,
+		// pipeline lookups past the memo, in-memory pipeline cache misses (compile), draws skipped while a program compiles
+		pipe_slow, pipe_miss, pipe_not_ready,
+		// FIFO methods, methods re-writing the same register value, draws merged by the flattener (R2_FIFO_MERGE)
+		fifo_methods, fifo_same, fifo_merged,
+		// R2_XFORM_MEMO transform-constant uploads skipped (+bytes); R2_IDX_DEDUP index uploads reused (+bytes), verify misses
+		xc_memo_hits, xc_memo_bytes, idx_dedup_hits, idx_dedup_bytes, idx_dedup_stale,
+		// CPU->GPU texture uploads (upload_image_from_cpu): count, ns, of which recorded on the async queue (R2_ASYNC_TEX)
+		tex_up_count, tex_up_ns, tex_up_async,
+		x_count
+	};
+	static_assert(x_count <= 192);
+
+	inline counters_t g;
+
+	// R2PORT round 9: usage census (R2_RSX_CENSUS=1 with R2_RSX_PROF=1). What the game actually sends, so the
+	// renderer can be specialised: FIFO methods by register (+ same-value writes), render-target formats, texture
+	// formats, MRT counts, conditional-render draws. Written by rsx::thread only; the monitor diffs snapshots.
+	struct census_t
+	{
+		std::atomic<uint32_t> meth[0x4000];
+		std::atomic<uint32_t> meth_same[0x4000];
+		std::atomic<uint32_t> color_fmt[32];
+		std::atomic<uint32_t> depth_fmt[8];
+		std::atomic<uint32_t> tex_fmt[256];
+		std::atomic<uint32_t> mrt[5];
+		std::atomic<uint32_t> cond_render;
+		std::atomic<uint32_t> draws;
+	};
+	inline census_t census{};
+	inline bool census_on = false;
+
+	inline void census_inc(std::atomic<uint32_t>& c) { c.store(c.load(std::memory_order_relaxed) + 1, std::memory_order_relaxed); }
+
+	// R2PORT round 7: the profiler reads the clock ~40 times per draw; rdtsc (invariant TSC, scaled once against QPC)
+	// costs a fraction of steady_clock::now() (QPC + 128-bit scaling), so R2_RSX_PROF disturbs the numbers less.
+	inline double tsc_ns_factor()
+	{
+#if defined(_WIN32) && (defined(_M_X64) || defined(__x86_64__))
+		const auto qpc = [] { return std::chrono::steady_clock::now(); };
+		const auto q0 = qpc();
+		const uint64_t r0 = __rdtsc();
+		while (qpc() - q0 < std::chrono::milliseconds(2)) {}
+		const auto q1 = qpc();
+		const uint64_t r1 = __rdtsc();
+		const double ns = static_cast<double>(std::chrono::duration_cast<std::chrono::nanoseconds>(q1 - q0).count());
+		return r1 > r0 ? ns / static_cast<double>(r1 - r0) : 0.0;
+#else
+		return 0.0;
+#endif
+	}
+
+	inline uint64_t now_ns()
+	{
+#if defined(_WIN32) && (defined(_M_X64) || defined(__x86_64__))
+		static const double k = tsc_ns_factor();
+		if (k > 0.0) [[likely]] return static_cast<uint64_t>(static_cast<double>(__rdtsc()) * k);
+#endif
+		return static_cast<uint64_t>(std::chrono::duration_cast<std::chrono::nanoseconds>(
+			std::chrono::steady_clock::now().time_since_epoch()).count());
+	}
+
+	inline void add(std::atomic<uint64_t>& c, uint64_t v)
+	{
+		c.fetch_add(v, std::memory_order_relaxed);
+	}
+
+	inline void addx(xc i, uint64_t v = 1)
+	{
+		if (enabled) g.x[i].fetch_add(v, std::memory_order_relaxed);
+	}
+
+	inline void maxx(xc i, uint64_t v)
+	{
+		if (!enabled) return;
+		uint64_t cur = g.x[i].load(std::memory_order_relaxed);
+		while (v > cur && !g.x[i].compare_exchange_weak(cur, v, std::memory_order_relaxed)) {}
+	}
+
+	// ns timer into g.x[i]
+	struct scope_x
+	{
+		xc i;
+		uint64_t t0;
+		explicit scope_x(xc idx) : i(idx), t0(enabled ? now_ns() : 0) {}
+		~scope_x() { if (t0) g.x[i].fetch_add(now_ns() - t0, std::memory_order_relaxed); }
+	};
+
+	// ns timer into g.x[i] that only counts outside draws. Self time: nested od scopes are subtracted from the outer one.
+	inline thread_local uint64_t od_child = 0;
+	struct scope_od
+	{
+		xc i;
+		uint64_t t0 = 0;
+		uint64_t saved = 0;
+		explicit scope_od(xc idx) : i(idx)
+		{
+			if (!enabled || in_draw) return;
+			saved = od_child;
+			od_child = 0;
+			t0 = now_ns();
+		}
+		~scope_od()
+		{
+			if (!t0) return;
+			const uint64_t total = now_ns() - t0;
+			const uint64_t self = total > od_child ? total - od_child : 0;
+			g.x[i].fetch_add(self, std::memory_order_relaxed);
+			od_child = saved + total;
+		}
+	};
+
+	// ns timer for the DLSS/FSR hooks: total, plus the in-draw part
+	struct scope_dlss
+	{
+		uint64_t t0;
+		bool draw;
+		scope_dlss() : t0(enabled ? now_ns() : 0), draw(in_draw) {}
+		~scope_dlss()
+		{
+			if (!t0) return;
+			const uint64_t d = now_ns() - t0;
+			g.x[dlss_ns].fetch_add(d, std::memory_order_relaxed);
+			if (draw) g.x[dlss_draw_ns].fetch_add(d, std::memory_order_relaxed);
+		}
+	};
+
+	struct scope_ns
+	{
+		std::atomic<uint64_t>* sink;
+		uint64_t t0;
+		explicit scope_ns(std::atomic<uint64_t>& c) : sink(enabled ? &c : nullptr), t0(sink ? now_ns() : 0) {}
+		~scope_ns() { if (sink) add(*sink, now_ns() - t0); }
+	};
+}
diff --git a/rpcs3/Emu/RSX/port_r2memo.h b/rpcs3/Emu/RSX/port_r2memo.h
new file mode 100644
index 0000000..1cbb167
--- /dev/null
+++ b/rpcs3/Emu/RSX/port_r2memo.h
@@ -0,0 +1,131 @@
+#pragma once
+
+// R2PORT round 8: upload memos for the Vulkan renderer (pure logic, unit tested in scratch\enginetest).
+// Reuse is only ever based on a full content comparison or on exact change tracking, so the GPU sees the same bytes
+// as the upstream path. Every memo is tied to the ring-heap epoch, which is bumped by any heap GET move (frame
+// cleanup, hard sync), heap re-init or growth AND at every frame boundary: reused data was therefore always written
+// by the frame currently being recorded, whose heap range stays reserved until that frame's commands have executed.
+
+#include <cstddef>
+#include <cstdint>
+#include <cstdlib>
+#include <cstring>
+#include <vector>
+
+namespace r2memo
+{
+	// Bumped whenever ring-heap space may be recycled (rsx::data_heap::set_get_pos/reset_allocation_stats/init)
+	// and when the renderer moves to the next frame context (VKGSRender::advance_queued_frames)
+	inline uint64_t g_heap_epoch = 1;
+	inline void bump_heap_epoch() { ++g_heap_epoch; }
+
+	// Bumped whenever REGS->transform_constants may have changed (nv4097 set_transform_constant writers)
+	inline uint64_t g_xform_gen = 1;
+	inline void bump_xform_gen() { ++g_xform_gen; }
+
+	// Read once: unset -> def, "0" -> off, anything else -> on
+	inline bool env_switch(const char* name, bool def)
+	{
+		const char* v = std::getenv(name);
+		if (!v || !v[0]) return def;
+		return v[0] != '0';
+	}
+
+	// Persistent VkPipelineCache blob: only handed back to the driver when its VkPipelineCacheHeaderVersionOne
+	// (header size >= 32, version 1, vendor, device, pipelineCacheUUID) names this exact GPU and driver build.
+	// The driver validates it again; a mismatching blob is simply ignored (empty cache, upstream behaviour).
+	inline bool pipe_cache_header_ok(const uint8_t* data, size_t size, uint32_t vendor, uint32_t device, const uint8_t uuid[16])
+	{
+		if (!data || size < 32) return false;
+		uint32_t h[4];
+		std::memcpy(h, data, sizeof(h));
+		return h[0] >= 32 && h[0] <= size && h[1] == 1 && h[2] == vendor && h[3] == device && std::memcmp(data + 16, uuid, 16) == 0;
+	}
+
+	// Transform-constant upload memo: the upload is a pure function of (vertex program, constants), so when the
+	// program is the same and no constant write happened since the last upload, the last upload is still valid.
+	struct xform_memo
+	{
+		const void* prog = nullptr;
+		uint64_t gen = 0;
+		uint64_t epoch = 0;
+
+		bool hit(const void* p, uint64_t cur_gen, uint64_t cur_epoch) const
+		{
+			return prog && p == prog && gen == cur_gen && epoch == cur_epoch;
+		}
+		void store(const void* p, uint64_t cur_gen, uint64_t cur_epoch) { prog = p; gen = cur_gen; epoch = cur_epoch; }
+		void clear() { prog = nullptr; }
+	};
+
+	// Index upload dedup: direct-mapped table keyed by (source pointer, size, decode parameters). A hit requires the
+	// same heap epoch and byte-identical source data (memcmp against a private copy), so the ring data written by the
+	// earlier upload is exactly what the upstream path would write again.
+	struct index_result
+	{
+		uint64_t offset;
+		uint32_t min_index, max_index, index_count;
+	};
+
+	class index_dedup
+	{
+	public:
+		static constexpr uint32_t ways = 128;
+		static constexpr uint32_t max_bytes = 128 * 1024;
+
+		enum class result { miss, hit, stale };
+
+		static uint32_t slot_of(const void* src, uint32_t size, uint64_t params)
+		{
+			uint64_t h = reinterpret_cast<uintptr_t>(src) ^ (static_cast<uint64_t>(size) << 32) ^ (params * 0x9E3779B97F4A7C15ull);
+			h ^= h >> 29; h *= 0xBF58476D1CE4E5B9ull; h ^= h >> 32;
+			return static_cast<uint32_t>(h) & (ways - 1);
+		}
+
+		// out_size: bytes the upload writes to the ring (expansion / restart emulation). On hit fills out.
+		// stale = key matched but the source bytes changed (counted separately).
+		result lookup(const void* src, uint32_t size, uint64_t params, uint32_t out_size, uint64_t epoch, index_result& out) const
+		{
+			if (size == 0 || size > max_bytes) return result::miss;
+			const entry& e = m_entries[slot_of(src, size, params)];
+			if (e.epoch != epoch || e.src != src || e.size != size || e.params != params || e.out_size != out_size) return result::miss;
+			if (std::memcmp(e.data.data(), src, size) != 0) return result::stale;
+			out = e.res;
+			return result::hit;
+		}
+
+		void store(const void* src, uint32_t size, uint64_t params, uint32_t out_size, uint64_t epoch, const index_result& res)
+		{
+			if (size == 0 || size > max_bytes) return;
+			entry& e = m_entries[slot_of(src, size, params)];
+			e.src = src;
+			e.size = size;
+			e.params = params;
+			e.out_size = out_size;
+			e.epoch = epoch;
+			e.res = res;
+			e.data.resize(size);
+			std::memcpy(e.data.data(), src, size);
+		}
+
+	private:
+		struct entry
+		{
+			const void* src = nullptr;
+			uint32_t size = 0;
+			uint64_t params = 0;
+			uint32_t out_size = 0;
+			uint64_t epoch = 0;
+			index_result res{};
+			std::vector<unsigned char> data;
+		};
+		entry m_entries[ways];
+	};
+
+	// Packs the decode parameters that change the uploaded index bytes / min / max / count (exact, no hashing)
+	inline uint64_t index_params(uint32_t index_type, uint32_t primitive, bool restart_enabled, bool emulate_restart, uint32_t restart_index)
+	{
+		const uint64_t flags = (index_type & 0xFu) | ((primitive & 0xFFu) << 4) | (restart_enabled ? 1u << 12 : 0u) | (emulate_restart ? 1u << 13 : 0u);
+		return flags | (static_cast<uint64_t>(restart_enabled ? restart_index : 0u) << 32);
+	}
+}
diff --git a/rpcs3/Emu/RSX/port_r2pipe.h b/rpcs3/Emu/RSX/port_r2pipe.h
new file mode 100644
index 0000000..b64b7e6
--- /dev/null
+++ b/rpcs3/Emu/RSX/port_r2pipe.h
@@ -0,0 +1,212 @@
+#pragma once
+
+// R2PORT pipeline-stutter work (pure logic, unit tested offline in scratch\enginetest via
+// ps3recomp\libs\video\tests\test_r2pipe.cpp):
+//  - [pipe] stall statistics: per-frame time spent waiting on pipeline creation on the render thread, a histogram
+//    of the stalls longer than 2 ms, and a 5 s reporting window (R2_PIPE_LOG);
+//  - byte keys + FNV-1a hashing for the VK_EXT_graphics_pipeline_library part caches (R2_VK_GPL);
+//  - first-use ordering and boot/background split of the start-up shader preload (R2_PRELOAD_ASYNC, R2_PRELOAD_BOOT);
+//  - a two-level job queue (urgent jobs before background optimise jobs) used by the pipeline compiler threads.
+
+#include <algorithm>
+#include <cstddef>
+#include <cstdint>
+#include <cstdlib>
+#include <cstring>
+#include <deque>
+#include <string>
+#include <type_traits>
+#include <vector>
+
+namespace r2pipe
+{
+	// ---- switches -------------------------------------------------------------------------------------------------
+
+	inline long env_int(const char* name, long def)
+	{
+		const char* v = std::getenv(name);
+		if (!v || !v[0]) return def;
+		char* end = nullptr;
+		const long r = std::strtol(v, &end, 10);
+		return end == v ? def : r;
+	}
+
+	// R2_FOSSILIZE: unset/"auto" = replay a shipped database when it exists, "record" = record + replay,
+	// "replay" = always replay (even over a seeded driver cache), "0"/"off" = disabled
+	enum class foz_mode { off, auto_replay, replay, record };
+
+	inline foz_mode parse_foz_mode(const char* v)
+	{
+		if (!v || !v[0]) return foz_mode::auto_replay;
+		std::string s(v);
+		for (auto& c : s) c = static_cast<char>((c >= 'A' && c <= 'Z') ? c - 'A' + 'a' : c);
+		if (s == "0" || s == "off" || s == "false" || s == "no") return foz_mode::off;
+		if (s == "record" || s == "rec" || s == "2") return foz_mode::record;
+		if (s == "replay" || s == "1" || s == "on") return foz_mode::replay;
+		return foz_mode::auto_replay;
+	}
+
+	// ---- [pipe] statistics ----------------------------------------------------------------------------------------
+
+	// Stall histogram buckets (milliseconds): 2-4, 4-8, 8-16, 16-33, >=33. Stalls below 2 ms only count towards
+	// the total time.
+	constexpr int stall_buckets = 5;
+
+	inline int stall_bucket(double ms)
+	{
+		if (ms < 2.0) return -1;
+		if (ms < 4.0) return 0;
+		if (ms < 8.0) return 1;
+		if (ms < 16.0) return 2;
+		if (ms < 33.0) return 3;
+		return 4;
+	}
+
+	struct stall_window
+	{
+		uint64_t frames = 0;
+		uint64_t stalls = 0;             // pipeline waits (any length)
+		double total_ms = 0.0;           // total render-thread time waiting on pipeline creation
+		double worst_frame_ms = 0.0;     // largest per-frame sum
+		double worst_stall_ms = 0.0;     // longest single wait
+		uint64_t frames_with_stall = 0;  // frames with >= 2 ms of pipeline waits
+		uint64_t hist[stall_buckets] = {};
+
+		double cur_frame_ms = 0.0;
+
+		void add_stall(double ms)
+		{
+			if (ms < 0.0) ms = 0.0;
+			stalls++;
+			total_ms += ms;
+			cur_frame_ms += ms;
+			worst_stall_ms = std::max(worst_stall_ms, ms);
+			const int b = stall_bucket(ms);
+			if (b >= 0) hist[b]++;
+		}
+
+		void end_frame()
+		{
+			frames++;
+			worst_frame_ms = std::max(worst_frame_ms, cur_frame_ms);
+			if (cur_frame_ms >= 2.0) frames_with_stall++;
+			cur_frame_ms = 0.0;
+		}
+
+		double per_frame_ms() const { return frames ? total_ms / static_cast<double>(frames) : 0.0; }
+
+		// Starts a new window; the stall time of an unfinished frame carries over.
+		void reset()
+		{
+			const double carry = cur_frame_ms;
+			*this = {};
+			cur_frame_ms = carry;
+		}
+	};
+
+	// Fires every `period_ns` (first call only arms the timer).
+	struct report_timer
+	{
+		uint64_t period_ns = 5'000'000'000ull;
+		uint64_t last_ns = 0;
+
+		bool due(uint64_t now_ns)
+		{
+			if (!last_ns) { last_ns = now_ns; return false; }
+			if (now_ns - last_ns < period_ns) return false;
+			last_ns = now_ns;
+			return true;
+		}
+	};
+
+	// ---- part-cache keys ------------------------------------------------------------------------------------------
+
+	inline uint64_t fnv1a64(const void* data, size_t size, uint64_t h = 0xcbf29ce484222325ull)
+	{
+		const auto* p = static_cast<const uint8_t*>(data);
+		for (size_t i = 0; i < size; ++i) { h ^= p[i]; h *= 0x100000001b3ull; }
+		return h;
+	}
+
+	// Exact byte key: equality compares all bytes, the hash only picks the bucket. Two library parts are shared only
+	// when every byte of the state that goes into them is identical, so a cached part is always the part the
+	// monolithic path would have been built from.
+	struct byte_key
+	{
+		std::vector<uint8_t> bytes;
+
+		template <typename T>
+		byte_key& add(const T& v)
+		{
+			static_assert(std::is_trivially_copyable_v<T>);
+			const auto* p = reinterpret_cast<const uint8_t*>(&v);
+			bytes.insert(bytes.end(), p, p + sizeof(T));
+			return *this;
+		}
+
+		byte_key& add_bytes(const void* data, size_t size)
+		{
+			add(static_cast<uint64_t>(size)); // length-prefixed: no ambiguity between adjacent variable parts
+			const auto* p = static_cast<const uint8_t*>(data);
+			if (size) bytes.insert(bytes.end(), p, p + size);
+			return *this;
+		}
+
+		uint64_t hash() const { return fnv1a64(bytes.data(), bytes.size()); }
+		bool operator==(const byte_key& o) const { return bytes == o.bytes; }
+	};
+
+	struct byte_key_hash
+	{
+		size_t operator()(const byte_key& k) const { return static_cast<size_t>(k.hash()); }
+	};
+
+	// ---- preload ordering -----------------------------------------------------------------------------------------
+
+	// The renderer writes a pipeline's cache entry when the game first links it, so the file time is (close to)
+	// the first-use order of the pipeline. Oldest entries are what the game draws first: they form the blocking
+	// boot set, the rest is compiled in the background in the same order. Ties keep their directory order.
+	inline std::vector<size_t> first_use_order(const std::vector<int64_t>& mtimes)
+	{
+		std::vector<size_t> order(mtimes.size());
+		for (size_t i = 0; i < order.size(); ++i) order[i] = i;
+		std::stable_sort(order.begin(), order.end(), [&](size_t a, size_t b) { return mtimes[a] < mtimes[b]; });
+		return order;
+	}
+
+	// Number of entries compiled before the first frame. boot < 0 = all (blocking preload), else min(boot, total).
+	inline size_t boot_count(size_t total, long boot)
+	{
+		if (boot < 0) return total;
+		return std::min(total, static_cast<size_t>(boot));
+	}
+
+	// ---- two-level job queue --------------------------------------------------------------------------------------
+
+	// Urgent jobs (pipelines a draw is waiting for) always run before background jobs (optimised monolithic
+	// pipelines, background preload). Not thread-safe; the owner locks.
+	template <typename T>
+	struct two_level_queue
+	{
+		std::deque<T> urgent;
+		std::deque<T> background;
+
+		void push(T v, bool is_background)
+		{
+			(is_background ? background : urgent).push_back(std::move(v));
+		}
+
+		bool pop(T& out)
+		{
+			auto& q = !urgent.empty() ? urgent : background;
+			if (q.empty()) return false;
+			out = std::move(q.front());
+			q.pop_front();
+			return true;
+		}
+
+		size_t size() const { return urgent.size() + background.size(); }
+		bool empty() const { return urgent.empty() && background.empty(); }
+		void clear() { urgent.clear(); background.clear(); }
+	};
+}
