+namespace vk
+{
+	VkResult r2fg_create_instance(const VkInstanceCreateInfo& info, VkInstance* instance, bool fast)
+	{
+		if (!fast && fgcfg().want && !g_sl.tried)
+		{
+			g_sl.tried = true;
+			if (fgcfg().backend != 2) sl_setup();
+#ifdef R2PORT_HAVE_FFX
+			if (!g_sl.inited && fgcfg().backend != 1) fsr3_setup();
+#endif
+		}
+		if (fast || !g_sl.inited || g_sl.instance != VK_NULL_HANDLE)
+			return vkCreateInstance(&info, nullptr, instance);
+
+		const auto create = reinterpret_cast<PFN_vkCreateInstance>(g_sl.gipa(VK_NULL_HANDLE, "vkCreateInstance"));
+		VkResult res = create ? create(&info, nullptr, instance) : VK_ERROR_INITIALIZATION_FAILED;
+		if (res == VK_SUCCESS)
+		{
+			g_sl.instance = *instance;
+			g_sl.p_destroy_surface = reinterpret_cast<PFN_vkDestroySurfaceKHR>(g_sl.gipa(*instance, "vkDestroySurfaceKHR"));
+			g_sl.p_create_surface = reinterpret_cast<PFN_vkCreateWin32SurfaceKHR>(g_sl.gipa(*instance, "vkCreateWin32SurfaceKHR"));
+			if (fgcfg().debug) fglog("Vulkan instance created through Streamline");
+			return res;
+		}
+		fglog("frame generation off: the Streamline Vulkan instance failed (%d)", static_cast<int>(res));
+		g_sl.fn_shutdown();
+		g_sl.inited = false;
+#ifdef R2PORT_HAVE_FFX
+		if (fgcfg().backend == 0) fsr3_setup();
+#endif
+		return vkCreateInstance(&info, nullptr, instance);
+	}
+
+	void r2fg_destroy_surface(VkInstance instance, VkSurfaceKHR surface)
+	{
+		if (g_sl.inited && instance == g_sl.instance && g_sl.p_destroy_surface) g_sl.p_destroy_surface(instance, surface, nullptr);
+		else vkDestroySurfaceKHR(instance, surface, nullptr);
+	}
+
+	VkResult r2fg_create_win32_surface(VkInstance instance, const VkWin32SurfaceCreateInfoKHR* info, VkSurfaceKHR* surface)
+	{
+		g_sl.hwnd = info->hwnd;
+		if (g_sl.inited && instance == g_sl.instance && g_sl.p_create_surface) return g_sl.p_create_surface(instance, info, nullptr, surface);
+		return vkCreateWin32SurfaceKHR(instance, info, nullptr, surface);
+	}
+
+	VkResult r2fg_create_device(VkPhysicalDevice pdev, const VkDeviceCreateInfo* info, VkDevice* device)
+	{
+		if (!g_sl.inited || g_sl.instance == VK_NULL_HANDLE || g_sl.device != VK_NULL_HANDLE)
+		{
+#ifdef R2PORT_HAVE_FFX
+			if (g_fx.selected && !g_fx.failed && g_fx.device == VK_NULL_HANDLE) return fx_create_device(pdev, info, device);
+#endif
+			return vkCreateDevice(pdev, info, nullptr, device);
+		}
+
+		// The interposer's vkCreateDevice looks the instance up in a map that only its own vkEnumeratePhysicalDevices
+		// fills. RPCS3 enumerated through the loader, so without this Streamline initialises its plugins with a null
+		// instance (null instance functions: sl.common crashes calling vkGetPhysicalDeviceMemoryProperties).
+		const auto enumerate = reinterpret_cast<PFN_vkEnumeratePhysicalDevices>(g_sl.gipa(g_sl.instance, "vkEnumeratePhysicalDevices"));
+		std::vector<VkPhysicalDevice> listed;
+		u32 count = 0;
+		if (enumerate && enumerate(g_sl.instance, &count, nullptr) == VK_SUCCESS && count)
+		{
+			listed.resize(count);
+			if (enumerate(g_sl.instance, &count, listed.data()) < 0) count = 0;
+			listed.resize(count);
+		}
+		if (std::find(listed.begin(), listed.end(), pdev) == listed.end())
+		{
+			fglog("frame generation off: Streamline does not list the renderer's GPU (%u GPUs listed)", count);
+			return vkCreateDevice(pdev, info, nullptr, device);
+		}
+
+		const auto create = reinterpret_cast<PFN_vkCreateDevice>(g_sl.gipa(g_sl.instance, "vkCreateDevice"));
+		DWORD fault = 0;
+		const VkResult res = create ? sl_create_device_guarded(create, pdev, info, device, &fault) : VK_ERROR_INITIALIZATION_FAILED;
+		if (fault)
+		{
+			fglog("frame generation off: Streamline crashed creating the Vulkan device (exception 0x%08X; NVIDIA driver/plugin problem)", static_cast<unsigned>(fault));
+			*device = VK_NULL_HANDLE;
+			return vkCreateDevice(pdev, info, nullptr, device);
+		}
+		if (res != VK_SUCCESS)
+		{
+			fglog("frame generation off: the Streamline Vulkan device failed (%d)", static_cast<int>(res));
+			return vkCreateDevice(pdev, info, nullptr, device);
+		}
+		g_sl.device = *device;
+		g_sl.pdev = pdev;
+		g_sl.p_wait_idle = reinterpret_cast<PFN_vkDeviceWaitIdle>(g_sl.gdpa(*device, "vkDeviceWaitIdle"));
+
+		VkPhysicalDeviceProperties props{};
+		vkGetPhysicalDeviceProperties(pdev, &props);
+		sl::AdapterInfo adapter{};
+		adapter.vkPhysicalDevice = pdev;
+		const sl::Result sup = g_sl.fn_supported(sl::kFeatureDLSS_G, adapter);
+		g_sl.fg_supported = sup == sl::Result::eOk && feature_fn(g_sl.fn_g_state, sl::kFeatureDLSS_G, "slDLSSGGetState") &&
+			feature_fn(g_sl.fn_g_options, sl::kFeatureDLSS_G, "slDLSSGSetOptions");
+		g_sl.reflex = g_sl.fn_supported(sl::kFeatureReflex, adapter) == sl::Result::eOk &&
+			feature_fn(g_sl.fn_r_sleep, sl::kFeatureReflex, "slReflexSleep") &&
+			feature_fn(g_sl.fn_r_options, sl::kFeatureReflex, "slReflexSetOptions");
+		if (!feature_fn(g_sl.fn_marker, sl::kFeaturePCL, "slPCLSetMarker")) g_sl.reflex = false;
+
+		if (!g_sl.fg_supported)
+			fglog("frame generation off: DLSS Frame Generation is not supported on %s (code %d; needs an RTX 40/50 and a current driver, HAGS on)",
+				props.deviceName, static_cast<int>(sup));
+		else if (!g_sl.reflex)
+		{
+			fglog("frame generation off: NVIDIA Reflex is unavailable through Streamline");
+			g_sl.fg_supported = false;
+		}
+		if (g_sl.fg_supported)
+		{
+			sl::DLSSGState st{};
+			if (g_sl.fn_g_state(sl::ViewportHandle(0u), st, nullptr) == sl::Result::eOk)
+			{
+				g_sl.max_mult = std::max<u32>(2, st.numFramesToGenerateMax + 1);
+				g_sl.vsync_ok = st.bIsVsyncSupportAvailable == sl::Boolean::eTrue;
+			}
+			const u32 use = std::min<u32>(fgcfg().want, g_sl.max_mult);
+			if (use < static_cast<u32>(fgcfg().want))
+				fglog("%ux requested but %s supports up to %ux: using %ux", fgcfg().want, props.deviceName, g_sl.max_mult, use);
+			fglog("DLSS Frame Generation %ux ready on %s (HUD split %s)", use, props.deviceName, fgcfg().hud ? "on" : "off");
+		}
+		if (g_sl.reflex)
+		{
+			sl::ReflexOptions ro{};
+			ro.mode = penv_int("REFLEX", 1) >= 2 ? sl::ReflexMode::eLowLatencyWithBoost : sl::ReflexMode::eLowLatency;
+			g_sl.fn_r_options(ro);
+		}
+		return res;
+	}
+}
