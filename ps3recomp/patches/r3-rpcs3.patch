+	// ---- RSX vertex program interpreter (enough to evaluate the position output) ----
+	// Runs the program for VPL input positions at once ("lanes"): each instruction is decoded once and every lane
+	// does exactly the arithmetic a separate single-point run would do. Control flow depends only on the branch
+	// bits (condition-code tests are not interpreted), so all lanes follow the same path.
+	constexpr int VPL = 5;
+
+	struct vp_code
+	{
+		const u32* data = nullptr;
+		u32 count = 0; // instructions
+		u32 pc0 = 0;   // entry - base_address
+	};
+
+	bool vp_run(const vp_code& vp, const float* consts, u32 branch_bits, const float in0[VPL][4], float out_pos[VPL][4])
+	{
+		static const float zero[4] = {};
+		float r[64][VPL][4];
+		u64 rinit = 0;            // temps written so far (unwritten temps read as zero)
+		float o[VPL][4] = {};     // position output only: no other output is read back
+		for (auto& v : o) v[3] = 1.f;
+		int a[VPL][2][4] = {};
+		u32 stack[8];
+		int sp = 0;
+
+		const u32* data = vp.data;
+		const u32 count = vp.count;
+		u32 pc = vp.pc0;
+
+		auto temp_w = [&](u32 idx) -> float(*)[4]
+		{
+			if (!((rinit >> idx) & 1))
+			{
+				std::memset(r[idx], 0, sizeof(r[idx]));
+				rinit |= 1ull << idx;
+			}
+			return r[idx];
+		};
+
+		for (int steps = 0; steps < 2048; ++steps)
+		{
+			if (pc >= count) return false;
+
+			D0 d0; D1 d1; D2 d2; D3 d3;
+			d0.HEX = data[pc * 4 + 0];
+			d1.HEX = data[pc * 4 + 1];
+			d2.HEX = data[pc * 4 + 2];
+			d3.HEX = data[pc * 4 + 3];
+
+			SRC src[3];
+			for (auto& s : src) s.HEX = 0;
+			src[0].src0l = d2.src0l;
+			src[0].src0h = d1.src0h;
+			src[1].src1 = d2.src1;
+			src[2].src2l = d3.src2l;
+			src[2].src2h = d2.src2h;
+
+			if (!src[0].reg_type || !src[1].reg_type || !src[2].reg_type)
+			{
+				break; // RPCS3 treats this as the end of the program
+			}
+
+			auto fetch = [&](int n, float v[VPL][4])
+			{
+				const SRC& s = src[n];
+				const u32 sw[4] = { s.swz_x, s.swz_y, s.swz_z, s.swz_w };
+				const bool abs_ = n == 0 ? d0.src0_abs : n == 1 ? d0.src1_abs : d0.src2_abs;
+				const bool neg = s.neg;
+				for (int l = 0; l < VPL; ++l)
+				{
+					const float* p = zero;
+					switch (s.reg_type)
+					{
+					case RSX_VP_REGISTER_TYPE_TEMP: p = ((rinit >> s.tmp_src) & 1) ? r[s.tmp_src][l] : zero; break;
+					case RSX_VP_REGISTER_TYPE_INPUT: p = d1.input_src == 0 ? in0[l] : zero; break;
+					case RSX_VP_REGISTER_TYPE_CONSTANT:
+						if (!d3.index_const)
+						{
+							p = d1.const_src < 468 ? consts + d1.const_src * 4 : zero;
+						}
+						else
+						{
+							const int idx = (a[l][d0.addr_reg_sel_1][d0.addr_swz] + static_cast<int>(d1.const_src)) & 511;
+							p = consts + idx * 4;
+						}
+						break;
+					default: break;
+					}
+					for (int i = 0; i < 4; ++i)
+					{
+						float x = p[sw[i]];
+						if (abs_) x = std::fabs(x);
+						if (neg) x = -x;
+						v[l][i] = x;
+					}
+				}
+			};
+
+			const u32 vop = d1.vec_opcode;
+			const u32 sop = d1.sca_opcode;
+			if (vop == RSX_VEC_OPCODE_TXL) return false;
+			if (d0.cond_test_enable && d0.cond != 7) return false; // condition-code tests are not interpreted
+
+			float s0[VPL][4], s1[VPL][4], s2[VPL][4];
+			fetch(0, s0); fetch(1, s1); fetch(2, s2);
+
+			float vr[VPL][4] = {};
+			bool vwrite = vop != RSX_VEC_OPCODE_NOP;
+#define R2_LANES for (int l = 0; l < VPL; ++l) for (int i = 0; i < 4; ++i)
+#define R2_LANE for (int l = 0; l < VPL; ++l)
