+	std::vector<m4> g_vote_rs; // vote_camera's per-draw R (reused: no per-frame allocation)
+	std::vector<u8> g_vote_lk; // per g_vote_rs entry: paired by loose key
+	// RSX_AA_VOTE_SCREEN: per g_vote_rs entry, where R moves 9 screen points at two far depths (x, y; NaN: behind the camera)
+	constexpr usz VOTE_SIG = 36;
+	std::vector<double> g_vote_sig;
