diff --git a/rpcs3/Emu/RSX/Common/tiled_dma_copy_fast.hpp b/rpcs3/Emu/RSX/Common/tiled_dma_copy_fast.hpp
new file mode 100644
index 0000000..eb21601
--- /dev/null
+++ b/rpcs3/Emu/RSX/Common/tiled_dma_copy_fast.hpp
@@ -0,0 +1,353 @@
+#pragma once
+
+// PORT: fast CPU tile/detile for RSX tiled main memory (RSX_DETILE_FAST, default on, =0 reverts to the per-texel
+// rsx::tiled_dma_copy reference in tiled_dma_copy.hpp).
+//
+// tiled_dma_copy() maps every texel through ~10 divisions/modulos. The mapping only depends on address bits [31:5]:
+// tile_address[4:0] == linear_address[4:0] and nothing else reads those bits, so every 32-byte aligned linear chunk is
+// one contiguous 32-byte tiled chunk. The per-256-byte block terms (tile x/y, selector, bank, line) are computed once
+// per block and each chunk is a fixed 32-byte memcpy (two SSE / one AVX move). The result is byte-identical to the
+// reference, including the out-of-bounds skip, the u32 wrap of the tiled offset and the row-major write order.
+// Conditions (otherwise callers fall back to the reference): tile base 32-byte aligned, the first texel bpp-aligned,
+// bpp 2 or 4, linear pitch == tile pitch and a valid (non-zero) tiles-per-row.
+// Byte-exact test + micro-benchmark: scratch\detile_bench\detile_bench.cpp.
+
+#include "tiled_dma_copy.hpp"
+
+#include <algorithm>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include "../../../../../../../project/port_native_summary.h"   // port_native_parse_bool (shared switch rules)
+
+namespace rsx
+{
+	inline bool detile_fast_enabled()
+	{
+		static const bool s_on = []()
+		{
+			const char* e = std::getenv("RSX_DETILE_FAST");
+			const bool on = port_native_parse_bool(e, 1) != 0;
+			std::fprintf(stderr, "[tiling] RSX_DETILE_FAST=%d (%s CPU tile/detile)\n", on ? 1 : 0, on ? "chunked 32-byte" : "reference per-texel");
+			return on;
+		}();
+		return s_on;
+	}
+
+	inline bool tiled_dma_fast_ok(const detiler_config& c)
+	{
+		return c.num_tiles_per_row != 0 &&
+			(c.image_bpp == 2 || c.image_bpp == 4) &&
+			(c.tile_base_address & 31) == 0 &&
+			((c.tile_base_address + c.tile_address_offset) % c.image_bpp) == 0 &&
+			c.image_pitch == c.tile_pitch;
+	}
+
+	// Copies the linear byte range [lin_begin, lin_end) (linear index o <-> RSX address tile_base + tile_address_offset + o,
+	// which holds because image_pitch == tile_pitch). Equivalent to calling tiled_dma_copy for every texel in the range.
+	// Decode only: if raw_linear is set, bytes the reference would leave untouched (out-of-bounds texels) are copied
+	// from raw_linear + o instead, which saves a separate prefill pass over the range.
+	template <bool Decode>
+	inline void tiled_dma_copy_range(const detiler_config& c, char* tiled_data, char* linear_data, uint32_t lin_begin, uint32_t lin_end, const char* raw_linear = nullptr)
+	{
+		const uint32_t bpp = c.image_bpp;
+		lin_begin -= lin_begin % bpp;
+		if (const uint32_t r = lin_end % bpp) lin_end += bpp - r;
+
+		static constexpr uint32_t bank_lut[16] = { 0, 1, 2, 3, 2, 3, 0, 1, 1, 2, 3, 0, 3, 0, 1, 2 };
+		const uint32_t base = c.tile_base_address;
+		const uint32_t a0 = base + c.tile_address_offset;
+		const uint32_t ntpr = c.num_tiles_per_row;
+
+		uint32_t cached_block = UINT32_MAX;
+		uint32_t base_bits = 0, line_b2 = 0, twiddle = 0;
+
+		uint64_t o = lin_begin;
+		while (o < lin_end)
+		{
+			const uint32_t addr = a0 + static_cast<uint32_t>(o);
+			const uint32_t a32 = addr & ~31u;
+			const uint32_t k0 = addr & 31u;
+			const uint64_t stop = std::min<uint64_t>(o + (32 - k0), lin_end);
+			const uint32_t k1 = k0 + static_cast<uint32_t>(stop - o);
+
+			const uint32_t texel_offset = (a32 - base) >> 8;
+			if (texel_offset != cached_block)
+			{
+				cached_block = texel_offset;
+				const uint32_t tile_x = texel_offset % ntpr;
+				const uint32_t q = texel_offset / ntpr;
+				const uint32_t tile_y = q / 64;
+				const uint32_t line = q % 64;
+				const uint32_t tile_selector = ((tile_y * ntpr + tile_x) + (base >> 14)) & 0x3ffff;
+				const uint32_t row_address = (tile_selector >> 2) & 0xffff;
+
+				uint32_t bank = 0;
+				if (c.factor == 1) bank = tile_selector & 3;
+				else if (c.factor == 2) bank = bank_lut[((tile_selector + ((tile_y & 1) << 1)) & 3) * 4 + (tile_y & 3)];
+				else if (c.factor >= 4) bank = bank_lut[(tile_selector & 3) * 4 + (tile_y & 3)];
+				bank = (bank + c.tile_bank) & 3;
+
+				base_bits = (row_address << 16) | (bank << 14) | (((line >> 3) & 7) << 11) | ((line & 3) << 5);
+				line_b2 = (line >> 2) & 1;
+				twiddle = (bank ^ tile_selector) & 1;
+			}
+
+			uint32_t ta = base_bits | (((a32 >> 5) & 7) << 8) | (((line_b2 + ((a32 >> 6) & 1)) & 1) << 7);
+			ta ^= (((ta >> 12) ^ twiddle ^ (ta >> 14)) & 1) << 9;
+			ta ^= ((ta >> 11) & 1) << 10;
+
+			const uint32_t off = ta - base; // tile_base_offset of byte 0 of the chunk
+			uint32_t raw_from = k0;
+			if (off < c.tile_size)
+			{
+				// Texels start on bpp multiples inside the chunk; each one is copied whole if its first byte is in bounds
+				uint32_t kend = k1;
+				const uint32_t lim = c.tile_size - off;
+				if (lim < kend)
+				{
+					const uint32_t lim_px = lim + (bpp - 1) - ((lim + (bpp - 1)) % bpp);
+					kend = std::min(kend, lim_px);
+				}
+
+				if (kend > k0)
+				{
+					raw_from = kend;
+					const uint32_t n = kend - k0;
+					const uint32_t d = off + k0 - c.tile_rw_offset; // u32 wrap matches the reference pointer math
+					char* lin = linear_data + static_cast<uint32_t>(o);
+
+					if (d <= UINT32_MAX - n) [[likely]]
+					{
+						char* til = tiled_data + d;
+						if (n == 32)
+						{
+							if constexpr (Decode) std::memcpy(lin, til, 32);
+							else std::memcpy(til, lin, 32);
+						}
+						else
+						{
+							if constexpr (Decode) std::memcpy(lin, til, n);
+							else std::memcpy(til, lin, n);
+						}
+					}
+					else
+					{
+						for (uint32_t k = 0; k < n; k += bpp)
+						{
+							char* til = tiled_data + static_cast<uint32_t>(d + k);
+							if constexpr (Decode) std::memcpy(lin + k, til, bpp);
+							else std::memcpy(til, lin + k, bpp);
+						}
+					}
+				}
+			}
+
+			if constexpr (Decode)
+			{
+				if (raw_linear && raw_from < k1)
+				{
+					const uint32_t ro = static_cast<uint32_t>(o) + (raw_from - k0);
+					std::memcpy(linear_data + ro, raw_linear + ro, k1 - raw_from);
+				}
+			}
+
+			o = stop;
+		}
+	}
+
+	// Drop-in for tile_texel_data<T, Decode> (same arguments, same output); falls back to it when the fast path
+	// does not apply or RSX_DETILE_FAST=0.
+	template <typename T, bool Decode = false>
+	void tile_texel_data_fast(void* dst, const void* src, uint32_t base_address, uint32_t base_offset, uint32_t tile_size, uint8_t bank_sense, uint16_t row_pitch_in_bytes, uint16_t image_width, uint16_t image_height)
+	{
+		const uint32_t pitch = row_pitch_in_bytes;
+		const uint32_t pbase = pitch >> 8;
+		uint32_t prime = 0, factor = 0;
+		if ((pitch & (pitch - 1)) == 0) { prime = 1; factor = pbase; }
+		else for (const uint32_t p : { 3u, 5u, 7u, 11u, 13u }) { if (pbase % p == 0) { prime = p; factor = pbase / p; break; } }
+
+		const detiler_config dconf = {
+			.prime = prime,
+			.factor = factor,
+			.num_tiles_per_row = prime * factor,
+			.tile_base_address = base_address,
+			.tile_size = tile_size,
+			.tile_address_offset = base_offset,
+			.tile_rw_offset = base_offset,
+			.tile_pitch = pitch,
+			.tile_bank = bank_sense,
+			.image_width = image_width,
+			.image_height = image_height,
+			.image_pitch = pitch,
+			.image_bpp = sizeof(T)
+		};
+
+		if (!detile_fast_enabled() || !tiled_dma_fast_ok(dconf))
+		{
+			tile_texel_data<T, Decode>(dst, src, base_address, base_offset, tile_size, bank_sense, row_pitch_in_bytes, image_width, image_height);
+			return;
+		}
+
+		char* tiled = static_cast<char*>(Decode ? const_cast<void*>(src) : dst);
+		char* linear = static_cast<char*>(Decode ? dst : const_cast<void*>(src));
+		const uint32_t row_bytes = static_cast<uint32_t>(image_width) * sizeof(T);
+
+		for (uint32_t row = 0; row < image_height; ++row)
+		{
+			const uint32_t o = row * pitch;
+			tiled_dma_copy_range<Decode>(dconf, tiled, linear, o, o + row_bytes);
+		}
+	}
+
+	// ---- CPU blit (nv3089 image_in) source detile ------------------------------------------------------------------
+	// Source bytes the CPU blit path reads, relative to src.pixels, in rows of src.pitch:
+	//  - mirrored (scale_x < 0 || scale_y < 0): _mirror_transform reads height rows, walking UP from src.pixels when
+	//    scale_y < 0 (rows -(height-1)..0); per row width*bpp bytes, or with scale_x < 0 rsx::memcpy_r reads texels
+	//    0, -1, .. -(width-1), i.e. bytes [-(width-1)*bpp, bpp). Everything after it reads the mirror buffer.
+	//  - otherwise linear_copy / clip_image / swizzled_copy_* / sws read at most max(width, out_w, clip_x + clip_w) texels
+	//    of max(height, out_h, clip_y + clip_h) rows (clip_image is bounded by out_h, not src.height), and
+	//  - swizzle2d destinations with a non-power-of-2 out_w/out_h and no clip/convert go through pad_texture, which
+	//    reads out_w*out_h*bpp CONTIGUOUS bytes from src.pixels ignoring the pitch (contig_bytes).
+	struct blit_src_read_set
+	{
+		int32_t row_lo;        // first row read (<= 0)
+		uint32_t rows;         // number of rows read
+		int32_t col_lo;        // first byte read in each row, relative to the row's src.pixels column (<= 0)
+		uint32_t row_bytes;    // bytes read per row, starting at col_lo
+		uint32_t contig_bytes; // plus [0, contig_bytes) from src.pixels regardless of rows (0 = none)
+	};
+
+	inline blit_src_read_set blit_src_reads(uint32_t width, uint32_t height, uint32_t bpp, bool flip_x, bool flip_y,
+		uint32_t out_w, uint32_t out_h, uint32_t clip_x, uint32_t clip_y, uint32_t clip_w, uint32_t clip_h, uint32_t contig_bytes)
+	{
+		if (flip_x || flip_y)
+		{
+			const int32_t row_lo = flip_y ? -static_cast<int32_t>(height ? height - 1 : 0) : 0;
+			const int32_t col_lo = flip_x ? -static_cast<int32_t>((width ? width - 1 : 0) * bpp) : 0;
+			return { row_lo, height, col_lo, width * bpp, 0 };
+		}
+
+		return { 0, std::max({ height, out_h, clip_y + clip_h }), 0, std::max({ width, out_w, clip_x + clip_w }) * bpp, contig_bytes };
+	}
+
+	// Whole-row scratch window holding the read set. rows_addr = start of the row containing src.pixels
+	// (src.rsx_address + in_offset - row_skip), as the original port code anchored it.
+	struct blit_src_window
+	{
+		uint32_t addr = 0;         // guest address of window byte 0 (row aligned)
+		uint32_t len = 0;          // nrows * pitch
+		uint32_t pixel_offset = 0; // src.pixels == window + pixel_offset
+		bool valid = false;
+	};
+
+	inline blit_src_window blit_src_window_for(uint32_t rows_addr, uint32_t row_skip, uint32_t pitch, const blit_src_read_set& rs)
+	{
+		blit_src_window w{};
+		if (!pitch || !rs.rows || !rs.row_bytes) return w;
+
+		// Read extent relative to rows_addr
+		const int64_t lo = static_cast<int64_t>(row_skip) + static_cast<int64_t>(rs.row_lo) * pitch + rs.col_lo;
+		const int64_t hi = std::max<int64_t>(
+			static_cast<int64_t>(row_skip) + (static_cast<int64_t>(rs.row_lo) + rs.rows - 1) * pitch + rs.col_lo + rs.row_bytes,
+			static_cast<int64_t>(row_skip) + rs.contig_bytes);
+
+		const uint64_t up_rows = lo < 0 ? static_cast<uint64_t>((-lo + pitch - 1) / pitch) : 0;
+		const uint64_t up = up_rows * pitch;
+		if (up > rows_addr) return w;
+
+		const uint64_t len = ((static_cast<uint64_t>(hi + static_cast<int64_t>(up)) + pitch - 1) / pitch) * pitch;
+		if (len > 0x10000000ull || static_cast<uint64_t>(rows_addr) - up + len > 0x100000000ull) return w;
+
+		w.addr = static_cast<uint32_t>(rows_addr - up);
+		w.len = static_cast<uint32_t>(len);
+		w.pixel_offset = static_cast<uint32_t>(up) + row_skip;
+		w.valid = true;
+		return w;
+	}
+	// Fills out[0, w.len) for the read set: raw guest bytes (guest_window = guest pointer at w.addr) with every
+	// texel at or past the tile base detiled from tiled_base (guest pointer at tile_base). Rows starting before the
+	// tile base stay raw (clamped). fast=false is the original port algorithm (raw copy of the whole window, per-texel
+	// tiled_dma_copy of every full row); fast=true copies + detiles only the read set with tiled_dma_copy_range.
+	// Bytes outside the read set are unspecified in fast mode (nothing reads them).
+	inline void blit_src_detile(char* out, const char* guest_window, const char* tiled_base, const blit_src_window& w,
+		const blit_src_read_set& rs, uint32_t tile_base, uint32_t tile_size, uint32_t tile_bank, uint32_t prime, uint32_t factor,
+		uint32_t pitch, uint32_t bpp, bool fast)
+	{
+		// First window row at or past the tile base
+		const uint32_t dstart = w.addr >= tile_base ? 0u : ((tile_base - w.addr + pitch - 1) / pitch) * pitch;
+
+		detiler_config dconf =
+		{
+			.prime = prime,
+			.factor = factor,
+			.num_tiles_per_row = prime * factor,
+			.tile_base_address = tile_base,
+			.tile_size = tile_size,
+			.tile_address_offset = w.addr + dstart - tile_base,
+			.tile_rw_offset = 0,
+			.tile_pitch = pitch,
+			.tile_bank = tile_bank,
+			.image_width = pitch / bpp,
+			.image_height = dstart < w.len ? (w.len - dstart) / pitch : 0,
+			.image_pitch = pitch,
+			.image_bpp = bpp
+		};
+
+		char* const tiled = const_cast<char*>(tiled_base);
+
+		if (!fast || !tiled_dma_fast_ok(dconf))
+		{
+			std::memcpy(out, guest_window, w.len);
+			char* const linear = out + dstart;
+			for (uint32_t row = 0; row < dconf.image_height; ++row)
+			{
+				for (uint32_t col = 0; col < dconf.image_width; ++col)
+				{
+					tiled_dma_copy(row, col, dconf, tiled, linear, 1 /* RSX_DMA_OP_DECODE_TILE */);
+				}
+			}
+			return;
+		}
+
+		auto do_range = [&](uint32_t b, uint32_t e)
+		{
+			e = std::min(e, w.len);
+			if (b >= e) return;
+			if (b < dstart)
+			{
+				std::memcpy(out + b, guest_window + b, std::min(e, dstart) - b);
+			}
+			const uint32_t db = std::max(b, dstart);
+			if (db < e)
+			{
+				tiled_dma_copy_range<true>(dconf, tiled, out + dstart, db - dstart, e - dstart, guest_window + dstart);
+			}
+		};
+
+		// Window offset of the first byte read (>= 0 by construction of the window)
+		const int64_t first64 = static_cast<int64_t>(w.pixel_offset) + static_cast<int64_t>(rs.row_lo) * pitch + rs.col_lo;
+		const uint32_t first = first64 > 0 ? static_cast<uint32_t>(first64) : 0u;
+		const uint32_t first_col = first % pitch;
+
+		if (rs.row_bytes + first_col >= pitch || rs.row_bytes >= pitch)
+		{
+			do_range(first, first + (rs.rows - 1) * pitch + rs.row_bytes);
+		}
+		else
+		{
+			for (uint32_t r = 0; r < rs.rows; ++r)
+			{
+				const uint32_t b = first + r * pitch;
+				do_range(b, b + rs.row_bytes);
+			}
+		}
+
+		if (rs.contig_bytes)
+		{
+			// pad_texture's pitch-less read: fill the gaps between row bands identically to the slow path
+			do_range(w.pixel_offset, w.pixel_offset + rs.contig_bytes);
+		}
+	}
+}
