+	// R2PORT RSX_GUEST_SRC_MMFLUSH: make the protections queued for [addr, addr+len) effective before the CPU snapshot
+	void guest_src_mm_flush(u32 addr, u64 len)
+	{
+		if (!len || !rsx::guest_src_mmflush_enabled()) return;
+		rsx::mm_flush({ utils::address_range64::start_length(reinterpret_cast<u64>(vm::base(addr)), len) });
+	}
+
+	// Same for every guest-memory source of an upload, before the CPU decode or the zero-copy snapshot reads it
+	void guest_src_mm_flush_layouts(const std::vector<rsx::subresource_layout>& layouts)
+	{
+		if (!rsx::guest_src_mmflush_enabled()) return;
+		u64 lo = umax, hi = 0;
+		for (const auto& layout : layouts)
+		{
+			const auto [ptr, size] = layout.data.raw();
+			const u64 p = reinterpret_cast<u64>(ptr);
+			const u64 base = reinterpret_cast<u64>(vm::g_base_addr), sudo = reinterpret_cast<u64>(vm::g_sudo_addr);
+			u64 addr;
+			if (!p || !size) continue;
+			if (p >= sudo && p - sudo < 0x1'0000'0000ull) addr = p - sudo;
+			else if (p >= base && p - base < 0x1'0000'0000ull) addr = p - base;
+			else continue;
+			lo = std::min(lo, addr);
+			hi = std::max<u64>(hi, std::min<u64>(addr + size, 0x1'0000'0000ull));
+		}
+		if (lo < hi) guest_src_mm_flush(static_cast<u32>(lo), hi - lo);
+	}
+}
