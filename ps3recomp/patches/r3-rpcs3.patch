+namespace vk
+{
+	VkResult r2fg_create_instance(const VkInstanceCreateInfo& info, VkInstance* instance, bool fast)
+	{
+		static bool logged = false;
+		if (!fast && !logged && fgcfg().want)
+		{
+			logged = true;
+			std::fprintf(stderr, "[fg-vk] frame generation off: this build has no Streamline SDK\n");
+		}
+		return vkCreateInstance(&info, nullptr, instance);
+	}
