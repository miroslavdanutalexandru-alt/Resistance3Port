+				if (r2cfg().post_stable_shape && w && h && rw && rh &&
+					(w * 8 < rw || std::abs(double(w) * rh - double(h) * rw) > 0.05 * double(w) * rh))
+				{
+					st.stat_ps_skip_shape++;
+					pdg(addr, 6, w, h, static_cast<u32>(fmt));
+					continue;
+				}
+				const VkDeviceSize bytes = VkDeviceSize{w} * h * 4;
+				if (!w || !h || bytes > (VkDeviceSize{96} << 20)) { pdg(addr, 7, w, h, static_cast<u32>(fmt)); continue; }
+				auto it = std::find_if(st.ps_ents.begin(), st.ps_ents.end(), [&](const auto& e) { return e.addr == addr; });
+				if (it == st.ps_ents.end())
+				{
+					st.ps_ents.emplace_back();
+					it = std::prev(st.ps_ents.end());
+					it->addr = addr;
+				}
+				auto& e = *it;
+				e.seen = st.frame;
+				if (e.w != w || e.h != h || e.fmt != fmt || !e.cur)
+				{
+					e.valid = false;
+					e.w = w;
+					e.h = h;
+					e.fmt = fmt;
+					e.mode = mode;
+					auto mk = [&](std::unique_ptr<vk::buffer>& b)
+					{
+						if (b) vk::get_resource_manager()->dispose(b);
+						b = std::make_unique<vk::buffer>(dev, bytes, dev.get_memory_mapping().device_local, VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT,
+							VK_BUFFER_USAGE_STORAGE_BUFFER_BIT | VK_BUFFER_USAGE_TRANSFER_SRC_BIT | VK_BUFFER_USAGE_TRANSFER_DST_BIT, 0, VMM_ALLOCATION_POOL_UNDEFINED);
+					};
+					mk(e.cur);
+					mk(e.lck);
+					mk(e.out);
+					e.outf = 0;
+				}
+				VkBufferImageCopy bic{};
+				bic.imageSubresource = { asp, 0, 0, 1 };
+				bic.imageExtent = { w, h, 1 };
+				// RSX_AA_POST_DEJITTER: every frame, the content moved back by its recorded shift (jd_shift)
+				bool did = false;
+				const auto dsh = st.jd_shift.find(addr);
+				if (dejit && mode <= 3 && dsh != st.jd_shift.end())
+				{
+					const float shx = dsh->second.sx, shy = dsh->second.sy;
+					s->memory_barrier(cmd, rsx::surface_access::transfer_read);
+					s->push_layout(cmd, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL);
+					vkCmdCopyImageToBuffer(cmd, s->value, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, e.cur->value, 1, &bic);
+					s->pop_layout(cmd);
+					vk::insert_global_memory_barrier(cmd);
