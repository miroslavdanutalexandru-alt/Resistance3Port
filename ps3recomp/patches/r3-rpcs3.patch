+			//dma.get.store(RSX(ctx)->fifo_ctrl->get_pos() + 4);
+			dma.ref.store(arg);
+		}
+
+		void semaphore_acquire(context* ctx, u32 /*reg*/, u32 arg)
+		{
+			RSX(ctx)->sync_point_request.release(true);
+			const u32 addr = get_address(ctx, REGS(ctx)->semaphore_offset_406e(), REGS(ctx)->semaphore_context_dma_406e());
+
+			// Syncronization point, may be associated with memory changes without actually changing addresses
+			ctx->graphics_state |= rsx::pipeline_state::fragment_program_needs_rehash;
+
+			// Ensure atomic seq-cst memory ordering for FIFO GET update
+			atomic_fence_seq_cst();
+
+			const auto& sema = vm::_ref<RsxSemaphore>(addr);
+			const auto& atomic_sema = vm::_ref<atomic_t<RsxSemaphore>>(addr);
+
+			RSX(ctx)->last_sema_cmd = RSX(ctx)->fifo_ctrl->get_pos() - 4;
+			RSX(ctx)->last_sema_addr = addr;
+
+			// R2PORT: deferred labels whose reports are done land first; the rest drain if this has to wait
+			RSX(ctx)->r2_poll_deferred_labels(false);
+			if (sema != arg && RSX(ctx)->r2_has_deferred_labels())
+			{
+				RSX(ctx)->r2_poll_deferred_labels(true);
+			}
+
+			// R3_SEMFIX: an SPU clear of this label that a late RSX release overwrote counts as landed
+			semfix_set_base(ctx->fw.label_addr);
+			if (sema != arg && g_semfix_base && semfix_try_acquire(addr, arg) && g_semlog_on)
+			{
+				semlog_set_base(ctx->fw.label_addr);
+				semlog_note_val(addr, arg, 7, RSX(ctx)->last_sema_cmd, 0);
+			}
+
+			if (sema == arg)
+			{
+				if (g_semfix_base) semfix_acquired(addr);
+
+				// Flip semaphore doesnt need wake-up delay
+				if (addr != ctx->fw.label_addr + 0x10)
+				{
+					//RSX(ctx)->flush_fifo();
+					RSX(ctx)->fifo_wake_delay(2);
+				}
+
+				return;
+			}
+			else
+			{
+				//RSX(ctx)->flush_fifo();
+			}
+
+			u64 start = get_system_time();
+			u64 last_check_val = start;
+			const u64 r3_wait_begin = start; // R3_SEMLOG
+			int r3_timed_out = 0; // 1 driver timeout, 2 R3_SEMFIX_MS cap
+			// R3_SEMFIX_MS: shorter bound when the expected value is the one an SPU job stores to this label
+			const u64 r3_cap = g_semfix_base ? semfix_wait_cap_us(addr, arg) : 0;
+			u64 r3_next_wake = 0, r3_next_prog = 250'000, r3_next_zsync = 0;
+
+			while (sema != arg)
+			{
+				if (RSX(ctx)->test_stopped())
+				{
+					RSX(ctx)->state += cpu_flag::again;
+					return;
+				}
+
+				if (ctx->fw.free_requested)
+				{
+					// lv2 waits for the context to be freed, which only happens once this method returns
+					break;
+				}
+
+				// R3_SEMFIX: the SPU store and a late RSX release can also race after the check above
+				if (g_semfix_base && semfix_try_acquire(addr, arg))
+				{
+					if (g_semlog_on) semlog_note_val(addr, arg, 7, RSX(ctx)->last_sema_cmd, 1);
+					break;
+				}
+
+				{
+					const u64 r3_now = get_system_time();
+					const u64 r3_waited = r3_now - r3_wait_begin;
+
+					r3_semwait_zcull(ctx, addr, r3_waited, r3_now, r3_next_zsync);
+
+					// The short circular-wait cap only applies once no report the guest may be polling is still queued
+					if (r3_cap && r3_waited > r3_cap &&
+						(r3_waited > r3_cap + 50'000 || r3_semwait_zcull_us() == ~0u || !RSX(ctx)->zcull().has_pending()))
+					{
+						semfix_cap_taken(addr, arg, sema, r3_waited);
+						r3_timed_out = 2;
+						break;
+					}
+
+					if (const auto wake = g_rsx_label_wake_hook; wake && r3_now >= r3_next_wake)
+					{
+						wake(0); // R3_SEMWAKE: SPURS polls now, not after its idle back-off
+						r3_next_wake = r3_now + 1000;
+					}
+
+					if (g_semlog_on > 0 && r3_waited >= r3_next_prog)
+					{
+						semlog_wait_progress(addr, arg, sema, r3_waited, r3_next_prog == 250'000);
+						r3_next_prog += 250'000;
+					}
+				}
+
+				if (const auto tdr = static_cast<u64>(g_cfg.video.driver_recovery_timeout))
+				{
+					const u64 current = get_system_time();
+
+					if (current - last_check_val > 20'000)
+					{
+						// Suspicious amnount of time has passed
+						// External pause such as debuggers' pause or operating system sleep may have taken place
+						// Ignore it
+						start += current - last_check_val;
+					}
+
+					last_check_val = current;
+
+					if ((current - start) > tdr)
+					{
+						// If longer than driver timeout force exit
+						rsx_log.error("nv406e::semaphore_acquire has timed out. semaphore_address=0x%X", addr);
+						r3_timed_out = 1;
+						break;
+					}
+				}
+
+				if (RSX(ctx)->external_interrupt_lock ||
+					(RSX(ctx)->state & (cpu_flag::dbg_global_pause + cpu_flag::exit)) == cpu_flag::dbg_global_pause)
+				{
+					RSX(ctx)->cpu_wait({});
+					continue;
+				}
+
+				RSX(ctx)->renderer()->on_semaphore_acquire_wait();
+
+				// Wait until the value changes or until 100us pass.
+				utils::spin_on_cacheline_once(atomic_sema, sema, 100);
+			}
+
+			if (g_semfix_base && sema == arg) semfix_acquired(addr);
+
+			if (g_semlog_on)
+			{
+				semlog_set_base(ctx->fw.label_addr);
+				semlog_report(addr, arg, sema, RSX(ctx)->last_sema_cmd, get_system_time() - r3_wait_begin, r3_timed_out);
+			}
+
+			RSX(ctx)->fifo_wake_delay();
+			RSX(ctx)->performance_counters.idle_time += (get_system_time() - start);
+		}
+
+		void semaphore_release(context* ctx, u32 reg, u32 arg)
+		{
+			const u32 offset = REGS(ctx)->semaphore_offset_406e();
+
+			if (offset % 4)
+			{
+				rsx_log.warning("NV406E semaphore release is using unaligned semaphore, ignoring. (offset=0x%x)", offset);
+				return;
+			}
+
+			const u32 ctxt = REGS(ctx)->semaphore_context_dma_406e();
+
+			// By avoiding doing this on flip's semaphore release
+			// We allow last gcm's registers reset to occur in case of a crash
+			if (const bool is_flip_sema = (offset == 0x10 && ctxt == CELL_GCM_CONTEXT_DMA_SEMAPHORE_R);
+				!is_flip_sema)
+			{
+				RSX(ctx)->sync_point_request.release(true);
+			}
+
+			const u32 addr = get_address(ctx, offset, ctxt);
+
+			// TODO: Check if possible to write on reservations
+			if (ctx->fw.label_addr >> 28 != addr >> 28)
+			{
+				rsx_log.error("NV406E semaphore unexpected address. Please report to the developers. (offset=0x%x, addr=0x%x)", offset, addr);
+				RSX(ctx)->recover_fifo();
+				return;
+			}
+
+			if (addr == RSX(ctx)->device_addr + 0x30 && !arg)
+			{
+				// HW flip synchronization related, 1 is not written without display queue command (TODO: make it behave as real hw)
+				arg = 1;
+			}
+
+			util::write_gcm_label<false, true>(ctx, reg, addr, arg);
+		}
+	}
+}
