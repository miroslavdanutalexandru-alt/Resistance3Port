+	// Max operation on the magnitude of value while preserving the sign
+	// Clamp_val must be >= 0
+	static int mag_max(int value, int clamp_val)
+	{
+		if (value >= 0)
+		{
+			return std::max(value, clamp_val);
+		}
+
+		return -std::max(-value, clamp_val);
+	}
