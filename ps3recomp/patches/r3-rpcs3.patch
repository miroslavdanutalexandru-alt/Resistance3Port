+	void vote_obj_make(const m4& Mc, const m4& Mp, const m4& Sp, double* o)
+	{
+		static const double pts[4][3] = { {0, 0, 0}, {1, 0, 0}, {0, 1, 0}, {0, 0, 1} };
+		const m4 B = m4_mul(Sp, Mp);
+		for (int k = 0; k < 4; ++k)
+		{
+			double* q = o + k * 6;
+			for (int r = 0; r < 4; ++r)
+				q[r] = Mc.m[r][0] * pts[k][0] + Mc.m[r][1] * pts[k][1] + Mc.m[r][2] * pts[k][2] + Mc.m[r][3];
+			double a[4];
+			for (int r = 0; r < 4; ++r)
+				a[r] = B.m[r][0] * pts[k][0] + B.m[r][1] * pts[k][1] + B.m[r][2] * pts[k][2] + B.m[r][3];
+			if (!(a[3] > 1e-9) || !(q[3] > 1e-9))
+			{
+				if (!k) { o[0] = std::numeric_limits<double>::quiet_NaN(); return; }
+				q[3] = 0; // this axis point is skipped
+				continue;
+			}
+			q[4] = a[0] / a[3];
+			q[5] = a[1] / a[3];
+		}
+	}
+
+	// does the camera motion SpR (Sp * R) move draw b's origin / axes to where the draw put them last frame?
+	// -1: b has no object points (use the other metric)
+	int vote_obj_close(const m4& SpR, usz b, double tol)
+	{
+		const double* o = g_vote_obj.data() + b * VOTE_OBJ;
+		if (std::isnan(o[0])) return -1;
+		const double t2 = 4.0 * tol * tol;
+		for (int k = 0; k < 4; ++k)
+		{
+			const double* q = o + k * 6;
+			if (!(q[3] > 1e-9)) continue;
+			double c[4];
+			for (int r = 0; r < 4; ++r) c[r] = SpR.m[r][0] * q[0] + SpR.m[r][1] * q[1] + SpR.m[r][2] * q[2] + SpR.m[r][3] * q[3];
+			if (!(c[3] > 1e-9)) return k ? 0 : -1;
+			const double dx = c[0] / c[3] - q[4], dy = c[1] / c[3] - q[5];
+			if (!(dx * dx + dy * dy <= t2)) return 0;
+		}
+		return 1;
+	}
+
+	void vote_sig(const m4& r, double* o)
+	{
+		const auto& c = g_vote_scr;
+		const m4 T = m4_mul(c.Sp, m4_mul(r, c.sci));
+		int k = 0;
+		for (const double d : { c.inverted ? 0.01 : 0.99, c.inverted ? 0.0005 : 0.9995 })
+			for (const double px : { -0.8, 0.0, 0.8 })
+				for (const double py : { -0.8, 0.0, 0.8 })
+				{
+					const double v[4] = { px, py, d * c.zA + c.zB, 1.0 };
+					double q[4];
+					for (int i = 0; i < 4; ++i) q[i] = T.m[i][0] * v[0] + T.m[i][1] * v[1] + T.m[i][2] * v[2] + T.m[i][3] * v[3];
+					if (!(q[3] > 1e-9)) { o[0] = std::numeric_limits<double>::quiet_NaN(); return; }
+					o[k++] = q[0] / q[3];
+					o[k++] = q[1] / q[3];
+				}
+	}
+
+	// every point of the two signatures within tol (fraction of the screen height; NDC distance / 2)
+	bool vote_sig_close(const double* a, const double* b, double tol)
+	{
+		const double t2 = 4.0 * tol * tol;
+		for (usz k = 0; k < VOTE_SIG; k += 2)
+		{
+			const double dx = a[k] - b[k], dy = a[k + 1] - b[k + 1];
+			if (!(dx * dx + dy * dy <= t2)) return false;
+		}
+		return true;
+	}
