+	{
+		return texelFetch2DMS(tex, clamp_bounds, sample_count, ivec2(normalized_coords * image_size), ivec2(0));
+	}
+
+	// Plain bilinear like real RSX (no footprint averaging). Exact at texel centers, which matters
+	// for depth reinterpreted as color (R3PORT: box-averaging blended edge depths -> sparkles).
+	const vec2 texel = normalized_coords * vec2(image_size) - 0.5;
+	const vec2 base = floor(texel);
+	const vec2 f = texel - base;
