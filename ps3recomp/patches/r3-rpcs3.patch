+
+		// R2PORT (PORT_OSD): presents a frame of the swapchain OSD only (black, the port's r2pf_status panel and
+		// any other port layer) at most every 66 ms, or at once with true. Empty: the GDI screen above is used.
+		std::function<void(bool)> osd_present;
+
+		explicit r2_preload_log_dialog(rsx::shader_loading_dialog* in) : inner(in) {}
+
+		// The progress for the GDI screen; the r2pf_status panel when there is no such window or in OSD mode,
+		// with the skip keys on its second line (the window keeps handling them).
+		void show_status(u32 index, u32 value)
+		{
+			if (rsx_null_backend_splash(static_cast<int>(index) + 1, 2, value, limit[index]) && !osd_present) return;
+			char text[192];
+			const int n = std::snprintf(text, sizeof(text), "%s shaders %u / %u", index == 0 ? "Loading" : "Compiling", value, limit[index]);
+			if (osd_present && n > 0 && n < static_cast<int>(sizeof(text)))
+				std::snprintf(text + n, sizeof(text) - n, "\n%s", *m_skip_requested
+					? "Skipping: the rest compile while you play..."
+					: "Esc, Space or a click: skip (the rest compile in play)");
+			r2pf_status(text);
+		}
+
+		void poll_skip()
+		{
+			if (*m_skip_requested) return;
+			const bool user = rsx_null_backend_splash_skip() || inner->skip_requested();
+			const bool over = !user && budget_ms > 0 &&
+				std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - start).count() >= budget_ms;
+			if (!user && !over) return;
+			*m_skip_requested = true;
+			if (skip_logged) return;
+			skip_logged = true;
+			const bool linking = limit[1] && value[1];
+			if (osd_present)
+			{
+				show_status(linking ? 1 : 0, linking ? value[1] : value[0]);
+				osd_present(true);
+			}
+			std::printf("[r2rsx] shader preload: %s at %s %u/%u; the remaining pipelines are linked %s\n",
+				user ? "skipped by the user" : "time budget reached (R2_PRELOAD_BOOT_BUDGET)",
+				linking ? "compiling" : "loading", linking ? value[1] : value[0], linking ? limit[1] : limit[0],
+				background ? "by background threads during play" : "on demand during play");
+			std::fflush(stdout);
+		}
+
+		void create(const std::string& msg, const std::string& title) override { inner->create(msg, title); }
+		void update_msg(u32 index, std::string msg) override { inner->update_msg(index, std::move(msg)); }
+		void inc_value(u32 index, u32 value) override { inner->inc_value(index, value); }
+		void set_limit(u32 index, u32 l) override
+		{
+			inner->set_limit(index, l);
+			if (index < 2) { limit[index] = l; t0[index] = std::chrono::steady_clock::now(); }
+			if (index == 0)
+			{
+				if (osd_present) { show_status(0, 0); osd_present(true); }
+				else rsx_null_backend_splash(1, 2, 0, l);
+			}
+		}
+		void set_value(u32 index, u32 value) override
+		{
+			inner->set_value(index, value);
+			if (index >= 2 || !limit[index]) return;
+			this->value[index] = value;
+			const auto now = std::chrono::steady_clock::now();
+			if (value >= limit[index] || now - last_status >= std::chrono::milliseconds(50))
+			{
+				last_status = now;
+				show_status(index, value);
+			}
+			poll_skip();
+			if (osd_present) osd_present(false);
+			const u32 pct = static_cast<u32>(u64{value} * 10 / limit[index]) * 10;
+			if (pct == last_pct[index]) return;
+			last_pct[index] = pct;
+			const double ms = std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - t0[index]).count();
+			std::printf("[r2rsx] shader preload: %s %u/%u pipelines (%u%%, %.0f ms)\n",
+				index == 0 ? "loading" : "compiling", value, limit[index], pct, ms);
+			std::fflush(stdout);
+		}
+		void refresh() override { inner->refresh(); }
+		void close() override { inner->close(); r2pf_status(nullptr); }
+		void enable_hold_to_skip() override { inner->enable_hold_to_skip(); }
+	};
+}
