+	vk::r2_black_probe(cmd, st.final_img.get(), ow, oh, 1, label_why);
+	st.raw_w = ow; // RSX_DLSS_DEBUG_VIEW=5: this run's output area (also DLAA)
+	st.raw_h = oh;
+	// RSX_AA_POST_STABLE (see r2aa_settings): the passes after this run see a jitter-locked copy of the jittered
+	// surfaces they used last frame while the camera is still
+	if (r2cfg().post_stable)
+	{
+		// hold with hysteresis: enter after 2 calm runs (< 0.1 px); leave once the net camera motion since the lock passes
+		// RSX_AA_POST_STABLE_NET (=0: a jump > 0.5 px, 3 wobbly runs > 0.15 px in a row or > 1 px of drift above 0.1 px),
+		// or on a real cut (scene switch, size, camera cut); mv-confidence /
+		// hitch resets keep it (the locks don't depend on the upscaler's history)
+		const double ps_px = st.sl_snap == 'E' ? 0.0 : st.sl_px;
+		// 8: no previous frame (load, respawn, fade: the camera vote never ran), 32: the camera vote found nothing in
+		// common, 512: a confirmed parallax cut; other resets (mv-confidence, hitch) carry no motion measurement (sl_px is
+		// unset on reset runs): they leave the hold state as it is
+		const bool ps_cut = reset && (label_why & (1u | 2u | 4u | 8u | 16u | 32u | 128u | 512u));
+		if (reset && !ps_cut) {}
+		else if (st.ps_hold)
+		{
+			bool ps_far = false;
+			if (r2cfg().post_stable_net > 0.f)
+			{
+				// net motion since each surface's lock, every run (a slow pan adds up, hand tremor on the mouse cancels out):
+				// the game's exact VP motion (none for a bit-identical VP pair, so a held / voted camera bias never adds up);
+				// without it the chosen camera motion above the float-noise floor (0.01 px). A surface past the threshold
+				// relocks at the next small-jitter run; one run moving past it leaves the hold
+				const bool vp_ok = r2cfg().camera_exact && ps_vp != 0;
+				const bool add = vp_ok ? ps_vp == 2 : (st.sl_snap != 'E' && ps_px > 0.01);
+				const m4& M = vp_ok ? ps_vp_T : T_raw;
+				if (add && snap_px(M) > r2cfg().post_stable_net) ps_far = true;
+				// backstop whatever the VP says: this run's own camera motion past the threshold leaves the hold
+				if (st.sl_snap != 'E' && snap_px(T_raw) > r2cfg().post_stable_net) ps_far = true;
+				for (auto& e : st.ps_ents)
+				{
+					if (!e.valid) continue;
+					if (add) e.acc = m4_mul(M, e.acc);
+					if (snap_px(e.acc) > r2cfg().post_stable_net)
+					{
+						e.valid = false;
+						st.stat_ps_net++;
+					}
+				}
+			}
+			else
+			{
+				if (ps_px > 0.1) st.ps_drift += ps_px;
+				st.ps_wob = ps_px > 0.15 ? st.ps_wob + 1 : 0;
+				ps_far = ps_px > 0.5 || st.ps_wob >= 3 || st.ps_drift > 1.0;
+			}
+			if (ps_cut || ps_far)
+			{
+				st.ps_hold = false;
+				st.stat_ps_drop++;
+			}
+		}
+		else
+		{
+			st.ps_calm = (!ps_cut && ps_px < 0.1) ? st.ps_calm + 1 : 0;
+			if (st.ps_calm >= 2)
+			{
+				st.ps_hold = true;
+				st.ps_wob = 0;
+				st.ps_drift = 0.0;
+			}
+		}
+		if (!st.ps_hold)
+		{
+			for (auto& e : st.ps_ents) e.valid = false;
+		}
+		const float djx = st.jx * r2cfg().jit_scale, djy = st.jy * r2cfg().jit_scale;
+		const bool dejit = r2cfg().post_dejit && (djx != 0.f || djy != 0.f) && st.vw > 0 && st.vh > 0;
+		if (st.ps_hold || dejit)
+		{
+			auto& psc = res()->surface_cache;
+			auto& dev = *m_device;
+			// the first still run with a modest jitter takes the lock (no wait for one phase: the post passes would shake
+			// until then); it is refreshed at the same phase, so a refresh gives the same static content
+			const bool small_j = std::abs(st.jx) <= 0.3f && std::abs(st.jy) <= 0.3f;
+			u32 done = 0, upd = 0;
+			// last frame's post-run consumers plus held surfaces (a frame without the consumer must not drop back)
+			std::vector<u32> cand(st.ps_prev.begin(), st.ps_prev.end());
+			for (const auto& e : st.ps_ents)
+				if (e.valid && !st.ps_prev.count(e.addr)) cand.push_back(e.addr);
+			// why: 0 de-jittered, 1 not resampled (packed / no shift), 2 not jittered this frame, 3 no surface, 4 MSAA,
+			// 5 format, 6 not screen-shaped, 7 too big, 8 over the per-run cap
+			auto pdg = [&](u32 addr, u32 why, u32 w = 0, u32 h = 0, u32 fmt = 0, float sx = 0.f, float sy = 0.f, float gx = 1.f, float gy = 1.f)
+			{
+				if (!r2cfg().trigger_log) return;
+				auto it = std::find_if(st.ps_diag.begin(), st.ps_diag.end(), [&](const auto& v) { return v.addr == addr; });
+				if (it == st.ps_diag.end())
+				{
+					if (st.ps_diag.size() >= 8) return;
+					it = st.ps_diag.emplace(st.ps_diag.end());
+					it->addr = addr;
+				}
+				it->why = why;
+				it->n++;
+				if (w) { it->w = w; it->h = h; it->fmt = fmt; }
+				if (why <= 1) { it->sx = sx; it->sy = sy; it->gx = gx; it->gy = gy; }
+			};
+			for (const u32 addr : cand)
+			{
+				if (done >= 6) { pdg(addr, 8); continue; }
+				if (addr == st.scene_rt || !st.jd_depth.count(addr)) { pdg(addr, 2); continue; }
+				auto* s = psc.get_surface_at(addr);
+				if (!s || s->samples() != 1) { pdg(addr, s ? 4 : 3); continue; }
+				const VkFormat fmt = s->format();
+				u32 mode = 6;
+				VkImageAspectFlags asp = VK_IMAGE_ASPECT_COLOR_BIT;
+				switch (fmt)
+				{
+				case VK_FORMAT_D24_UNORM_S8_UINT: case VK_FORMAT_X8_D24_UNORM_PACK32: mode = 0; asp = VK_IMAGE_ASPECT_DEPTH_BIT; break;
+				case VK_FORMAT_D32_SFLOAT: case VK_FORMAT_D32_SFLOAT_S8_UINT: mode = 1; asp = VK_IMAGE_ASPECT_DEPTH_BIT; break;
+				case VK_FORMAT_R32_SFLOAT: mode = 1; break;
+				case VK_FORMAT_R8G8B8A8_UNORM: case VK_FORMAT_B8G8R8A8_UNORM: case VK_FORMAT_A8B8G8R8_UNORM_PACK32: mode = 2; break;
