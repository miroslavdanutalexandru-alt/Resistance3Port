+	// RSX_DLSS_OBJMV_MODE=onepass in effect (the device has the features)
+	bool om1_on()
+	{
+		return r2cfg().objmv == 1 && r2cfg().om_mode == 1 && vk::r2om_onepass_dev && !g_om2.op_failed;
+	}
+
+	// RSX_DLSS_OBJMV_DEFORM: issued right after the hcopy of the same slots (same barriers around them)
+	void om_issue_dcopy(VkCommandBuffer cmd)
+	{
+		auto& o = g_om2;
+		if (!o.dcopy.empty() && o.dbuf && o.dsrc)
+			vkCmdCopyBuffer(cmd, o.dsrc, o.dbuf->value, size32(o.dcopy), o.dcopy.data());
+		o.dcopy.clear();
+	}
+
+	// RSX_AA_OBJMV_DEFER: draw-time prediction. Pairs by key as om_classify does; a pair that was static last frame
+	// (matched, no own motion / deform / history slot) is taken as static now and queued for om_classify after the scene.
+	bool om_defer_predict(u32 i, om_finds* out = nullptr)
+	{
+		auto& st = g_r2;
+		if (!r2cfg().om_defer || r2cfg().objmv != 1) return false;
+		auto& e = st.cur_F.e[i];
+		if (e.om_nw) return false; // RSX_DLSS_OBJMV_NOWRITE: classified (moving) before its draw
+		if (e.prog->indexed) return false;
+		const u32* pp = st.om_prev.find(e.key, false);
+		bool loose = false;
+		if (out)
+		{
+			out->valid = true;
+			out->key = pp;
+		}
+		if (!pp && r2cfg().match_loose && e.lkey)
+		{
+			pp = st.prev_loose.find(e.lkey, false);
+			loose = pp != nullptr;
+			if (out)
+			{
+				out->loose_done = true;
+				out->loose = pp;
+			}
+		}
+		if (!pp || *pp >= st.prev_F.e.size()) return false;
+		const auto& p = st.prev_F.e[*pp];
+		if (p.prog != e.prog || !(p.om & om_matched) || (p.om & (om_new | om_skin | om_dyn | om_rigid)) || p.om_hslot || p.om_dsize ||
+			p.om_dage <= r2cfg().om_deform_carry)
+			return false;
+		e.om = static_cast<decltype(e.om)>(e.om | om_matched);
+		e.prev = *pp;
+		e.loose = loose;
+		st.om_defer_q.push_back(i);
+		return true;
+	}
+
+	// One persistent worker (detached, never freed: it may outlive the renderer at exit)
+	struct om_defer_worker
+	{
+		std::mutex m;
+		std::condition_variable cv;
+		std::function<void()> job;
+		bool busy = false;
+		om_defer_worker()
+		{
+			std::thread([this]
+			{
+				for (;;)
+				{
+					std::function<void()> j;
+					{
+						std::unique_lock lk(m);
+						cv.wait(lk, [&] { return static_cast<bool>(job); });
+						j = std::move(job);
+						job = nullptr;
+					}
+					j();
+					{
+						std::lock_guard lk(m);
+						busy = false;
+					}
+					cv.notify_all();
+				}
+			}).detach();
+		}
+		void start(std::function<void()> j)
+		{
+			{
+				std::lock_guard lk(m);
+				busy = true;
+				job = std::move(j);
+			}
+			cv.notify_all();
+		}
+		void wait()
+		{
+			std::unique_lock lk(m);
+			cv.wait(lk, [&] { return !busy; });
+		}
+	};
+	om_defer_worker& om_defer_w()
+	{
+		static om_defer_worker* w = new om_defer_worker();
+		return *w;
+	}
+	bool g_om_def_running = false; // render thread only
+
+	// RSX_RECORD_DEFER (round 10, item 4: DXVK-style split; 0 = off (default), 1 = on, 2 = on + verify). The draw-time
+	// objmv prediction + classification of a depth-writing scene draw (om_defer_predict / om_classify) runs on a helper
+	// thread while the render thread uploads the draw's constants, binds its textures and packs its vertices. Its
+	// outputs (the entry's om / om_dq / prev / loose / state / M, the classify-owned counters and clusters, om_defer_q)
+	// are read only by r2aa code, and every r2aa entry point joins first; its inputs (this entry, its captured
+	// constants, last frame's tables) are written by r2aa_on_draw / r2aa_on_flip only, i.e. after a join. Verify: a
+	// fingerprint of the inputs at the kick is compared at the join (a difference is the only way the result could
+	// differ from the inline run), and joins from unexpected entry points are counted.
+	struct om_lane_t
+	{
+		int mode = 0;
+		u32 spin_us = 200;
+		alignas(64) std::atomic<u32> posted{0};
+		std::atomic<u32> sleeping{0};
+		alignas(64) std::atomic<u32> done{0};
+		std::atomic<u64> work_ns{0};
+		alignas(64) u32 job_i = 0; // written before 'posted' (release), read by the helper after it (acquire)
+		bool job_hint = false;
+		alignas(64) u32 seq = 0;   // render thread only from here
+		bool running = false;
+		bool started = false;
+		u64 fp = 0;
+		usz qsz = 0; // om_defer_q size at the kick (the job may push this entry)
+		u64 jobs = 0, waited = 0, wait_ns = 0, early = 0, bad = 0;
+		const char* early_where = nullptr;
+		// RSX_PIPE_SPLIT: this job's stage-1 snapshot (written before 'posted'; ps.j_* / e fields by the helper before 'done')
+		struct ps_job_t
+		{
+			bool on = false;    // keys + capture of this entry run on the lane
+			bool loose = false; // the loose key is folded from lk0 + lk_w (RSX_AA_MATCH_LOOSE)
+			bool reuse = false; // RSX_AA_CAPTURE_REUSE
+			bool dm_pf = false; // RSX_AA_DRAW_MEMO prefetch
+			u32 lk_n = 0;
+			u64 lk0 = 0;
+			u64 lk_w[40] = {};
+			u64 xgen = 0;       // r2memo::g_xform_gen at the draw
+			const float* consts = nullptr;
+			const vp_info* pi = nullptr;
+			// RSX_PIPE_SPLIT=2: stage-1 expectations (v_lk2: the alternative when the ordinal table had no slot yet)
+			u64 v_lkey = 0, v_lkbase = 0, v_lk2 = 0, v_ch = 0;
+		} ps;
+		std::atomic<u64> ps_ns{0}; // keys + capture time on the helper
+		u64 ps_jobs = 0, ps_checked = 0, ps_bad = 0;
+		std::chrono::steady_clock::time_point ps_t0{};
+	};
+	om_lane_t g_lane;
+	thread_local bool t_lane_owner = false; // the thread that kicks jobs (the render thread)
+
+	// RSX_PIPE_SPLIT (round 10: two-stage rsx::thread; 0 = off (default), 1 = on, 2 = on + validate). Stage 2 is the
+	// RSX_RECORD_DEFER lane (turned on with the same mode unless RSX_RECORD_DEFER is set) plus the record thread
+	// (RSX_RECORD_THREAD). On top of the classification, a depth-writing objmv scene draw's loose key + ordinal and its
+	// transform-constant capture move to the lane job: stage 1 snapshots the key words and the capture inputs (the
+	// constants live in REGS; every constant writer joins the lane first via r2memo::before_xform_write, and end_draw /
+	// the emit_geometry early exits join too). Validate:
+	// stage 1 also derives the expected loose key / ordinal and a hash of the constants, compared at the join.
+	int pipe_split_mode()
+	{
+		static const int m = []
+		{
+			const char* v = std::getenv("RSX_PIPE_SPLIT");
+			const int r = v && *v ? std::atoi(v) : 0;
+			return r == 1 || r == 2 ? r : 0;
+		}();
+		return m;
+	}
+
+	int om_lane_mode()
+	{
+		static const int m = []
+		{
+			const char* v = std::getenv("RSX_RECORD_DEFER");
+			const int r = v && *v ? std::atoi(v) : pipe_split_mode(); // RSX_PIPE_SPLIT implies the lane unless RSX_RECORD_DEFER is set
+			if (r) r2log("RSX_RECORD_DEFER=%d: objmv draw classification on a helper thread, overlapped with the draw's uploads%s", r,
+				r == 2 ? " (verify: input fingerprints at kick vs join)" : "");
+			if (pipe_split_mode())
+				r2log("RSX_PIPE_SPLIT=%d: %s", pipe_split_mode(), r == 1 || r == 2 ?
+					"stage 2 (lane) takes the loose key, ordinal, constant capture and classification of depth-writing objmv scene draws" :
+					"inactive (RSX_RECORD_DEFER=0 turned the lane off)");
+			return r == 1 || r == 2 ? r : 0;
+		}();
+		return m;
+	}
+
+	// The constant capture of a scene draw entry (e.const_off + the constants its program reads), with RSX_AA_CAPTURE_REUSE.
+	// r2aa_on_draw inline, or the RSX_PIPE_SPLIT lane job with the inputs stage 1 snapshotted.
+	void om_capture(mvp_frame& f, mvp_entry& e, const vp_info* pi, const float* consts, bool reuse, u64 gen)
+	{
+		e.const_off = static_cast<u32>(f.consts.size());
+		if (reuse && f.cap_gen != gen) f.cap_reset(gen);
+		if (pi->indexed)
+		{
+			if (reuse && f.cap_full != UINT32_MAX)
+			{
+				e.const_off = f.cap_full;
+				g_r2.stat_cap_reused++;
+			}
+			else
+			{
+				f.consts.insert(f.consts.end(), consts, consts + 512 * 4);
+				if (reuse) f.cap_full = e.const_off;
+			}
+		}
+		else
+		{
+			u32 slot = UINT32_MAX;
+			if (reuse)
+				for (u32 k = 0; k < 4; ++k)
+					if (f.cap_prog[k] == pi) { slot = k; break; }
+			if (slot != UINT32_MAX)
+			{
+				e.const_off = f.cap_off[slot];
+				g_r2.stat_cap_reused++;
+			}
+			else
+			{
+				const usz base = f.consts.size();
+				f.consts.resize(base + pi->reads.size() * 4);
+				float* dst = f.consts.data() + base;
+				for (const u16 c : pi->reads)
+				{
+					std::memcpy(dst, consts + c * 4, 4 * sizeof(float));
+					dst += 4;
+				}
+				if (reuse)
+				{
+					f.cap_prog[f.cap_next] = pi;
+					f.cap_off[f.cap_next] = e.const_off;
+					f.cap_next = (f.cap_next + 1) & 3;
+				}
+			}
+		}
+	}
+
+	// RSX_PIPE_SPLIT=2: hash of the constants a capture of 'pi' holds (stage 1: from REGS; join: from the arena)
+	u64 om_capture_hash(const vp_info* pi, const float* consts, bool arena)
+	{
+		u64 h = 0x9e3779b97f4a7c15ull;
+		if (pi->indexed)
+		{
+			for (u32 k = 0; k < 512 * 4; ++k) h = mix64(h, std::bit_cast<u32>(consts[k]));
+			return h;
+		}
+		u32 i = 0;
+		for (const u16 c : pi->reads)
+		{
+			const float* s = arena ? consts + 4 * i++ : consts + c * 4;
+			for (u32 k = 0; k < 4; ++k) h = mix64(h, std::bit_cast<u32>(s[k]));
+		}
+		return h;
+	}
+
+	inline void om_lane_pause()
+	{
+#ifdef _WIN32
+		YieldProcessor();
+#else
+		std::this_thread::yield();
+#endif
+	}
+
+	u64 om_lane_fp(u32 ei);
+
+	// The inline code of r2aa_on_draw (prediction, then the classification of an unpredicted draw)
+	void om_lane_job(u32 ei, bool hint)
+	{
+		auto& f = g_r2.cur_F;
+		if (auto& L = g_lane; L.ps.on)
+		{
+			// RSX_PIPE_SPLIT: the entry's loose key + ordinal and its constant capture, in r2aa_on_draw's order
+			const auto t0 = std::chrono::steady_clock::now();
+			auto& J = L.ps;
+			auto& st = g_r2;
+			auto& e = f.e[ei];
+			if (J.loose)
+			{
+				u64 lk = J.lk0;
+				for (u32 k = 0; k < J.lk_n; ++k) lk = mix64(lk, J.lk_w[k]);
+				u32* locc = st.loose_occ.find(lk, true);
+				e.lkbase = locc ? lk : 0;
+				e.lkey = locc ? mix64(lk, (*locc)++) : 0;
+				if (J.dm_pf && e.lkey) st.prev_loose.prefetch(e.lkey);
+			}
+			om_capture(f, e, J.pi, J.consts, J.reuse, J.xgen);
+			if (L.mode == 2) L.fp = om_lane_fp(ei); // the classification's inputs, as the kick takes them without the split
+			L.ps_ns.fetch_add(static_cast<u64>(std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::steady_clock::now() - t0).count()),
+				std::memory_order_relaxed);
+		}
+		om_finds ofh;
+		const bool dq = om_defer_predict(ei, hint ? &ofh : nullptr);
+		f.e[ei].om_dq = dq;
+		if (!dq) om_classify(ei, &ofh);
+	}
+
+	// The job's inputs: the entry's identity and captured constants, the frame tables' extents
+	u64 om_lane_fp(u32 ei)
+	{
+		const auto& st = g_r2;
+		const auto& f = st.cur_F;
+		u64 h = mix64(f.e.size(), reinterpret_cast<u64>(f.e.data()));
+		h = mix64(h, mix64(f.consts.size(), reinterpret_cast<u64>(f.consts.data())));
+		h = mix64(h, mix64(st.prev_F.e.size(), reinterpret_cast<u64>(st.prev_F.e.data())));
+		h = mix64(h, mix64(st.prev_F.consts.size(), reinterpret_cast<u64>(st.prev_F.consts.data())));
+		if (ei >= f.e.size()) return h;
+		const auto& e = f.e[ei];
+		h = mix64(h, mix64(e.key, e.kbase));
+		h = mix64(h, mix64(e.lkey, e.lkbase));
+		h = mix64(h, mix64(reinterpret_cast<u64>(e.prog), (static_cast<u64>(e.branch_bits) << 32) | e.const_off));
+		const usz n = e.prog ? (e.prog->indexed ? 512 * 4 : e.prog->reads.size() * 4) : 0;
+		if (e.const_off + n <= f.consts.size())
+			for (usz k = 0; k < n; ++k) h = mix64(h, std::bit_cast<u32>(f.consts[e.const_off + k]));
+		return h;
+	}
+
+	void om_lane_main()
+	{
+		auto& L = g_lane;
+		u32 seen = 0;
+		for (;;)
+		{
+			u32 p = L.posted.load(std::memory_order_acquire);
+			auto t0 = std::chrono::steady_clock::now();
+			for (u32 n = 1; p == seen; ++n)
+			{
+				om_lane_pause();
+				p = L.posted.load(std::memory_order_acquire);
+				if (p != seen || (n & 255) || std::chrono::steady_clock::now() - t0 < std::chrono::microseconds(L.spin_us)) continue;
+				// Idle (between scenes): sleep. Dekker with the kick: sleeping (seq_cst) then posted / posted (seq_cst) then sleeping.
+				L.sleeping.store(1, std::memory_order_seq_cst);
+				p = L.posted.load(std::memory_order_seq_cst);
+				if (p == seen) L.posted.wait(seen, std::memory_order_acquire);
+				L.sleeping.store(0, std::memory_order_relaxed);
+				p = L.posted.load(std::memory_order_acquire);
+				t0 = std::chrono::steady_clock::now();
+			}
+			seen = p;
+			const auto w0 = std::chrono::steady_clock::now();
+			om_lane_job(L.job_i, L.job_hint);
+			L.work_ns.fetch_add(static_cast<u64>(std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::steady_clock::now() - w0).count()),
+				std::memory_order_relaxed);
+			L.done.store(p, std::memory_order_release);
+		}
+	}
+
+	void om_lane_join_slow(const char* where, bool expected);
+
+	void om_lane_kick(u32 ei, bool hint)
+	{
+		auto& L = g_lane;
+		if (!L.started)
+		{
+			L.started = true;
+			L.mode = om_lane_mode();
+			if (const char* v = std::getenv("RSX_RECORD_DEFER_SPIN_US"); v && *v) L.spin_us = static_cast<u32>(std::strtoul(v, nullptr, 0));
+			std::thread(om_lane_main).detach(); // never joined: it may outlive the renderer at exit (as om_defer_worker)
+		}
+		t_lane_owner = true;
+		L.job_i = ei;
+		L.job_hint = hint;
+		if (L.mode == 2) L.qsz = g_r2.om_defer_q.size();
+		if (L.mode == 2 && !L.ps.on) L.fp = om_lane_fp(ei); // RSX_PIPE_SPLIT: the helper takes it after the capture
+		if (L.ps.on)
+		{
+			L.ps_jobs++;
+			if (L.ps_t0 == std::chrono::steady_clock::time_point{}) L.ps_t0 = std::chrono::steady_clock::now();
+			// The job reads REGS->transform_constants (J.consts): any constant writer joins first (nv4097 decode,
+			// transform_constant_update_barrier on an emit_geometry path that never reaches pre_draw's join)
+			if (!r2memo::g_xform_reader_join) r2memo::g_xform_reader_join = [] { if (g_lane.running && t_lane_owner) om_lane_join_slow("transform constant write", false); };
+			r2memo::g_xform_reader_busy = true;
+		}
+		L.running = true;
+		L.jobs++;
+		L.posted.store(++L.seq, std::memory_order_seq_cst);
+		if (L.sleeping.load(std::memory_order_seq_cst)) L.posted.notify_one();
+	}
+
+	void om_lane_join_slow(const char* where, bool expected)
+	{
+		auto& L = g_lane;
+		if (L.done.load(std::memory_order_acquire) != L.seq)
+		{
+			const auto t0 = std::chrono::steady_clock::now();
+			while (L.done.load(std::memory_order_acquire) != L.seq) om_lane_pause();
+			L.waited++;
+			L.wait_ns += static_cast<u64>(std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::steady_clock::now() - t0).count());
+		}
+		L.running = false;
+		r2memo::g_xform_reader_busy = false;
+		if (L.ps.on && pipe_split_mode() == 2 && L.job_i < g_r2.cur_F.e.size())
+		{
+			// RSX_PIPE_SPLIT=2: the lane's loose key / ordinal / captured constants vs stage 1's expectations at the kick
+			const auto& J = L.ps;
+			const auto& f = g_r2.cur_F;
+			const auto& e = f.e[L.job_i];
+			const usz n = J.pi->indexed ? 512 * 4 : J.pi->reads.size() * 4;
+			const bool lk_ok = !J.loose || (e.lkey == J.v_lkey && e.lkbase == J.v_lkbase) || (J.v_lk2 && e.lkey == 0 && e.lkbase == 0);
+			const bool c_ok = e.const_off + n <= f.consts.size() && om_capture_hash(J.pi, f.consts.data() + e.const_off, true) == J.v_ch;
+			L.ps_checked++;
+			if ((!lk_ok || !c_ok) && L.ps_bad++ < 16)
+				r2log("WARNING RSX_PIPE_SPLIT=2: draw entry %u (join at %s): loose key %s (lane %016llx/%016llx, expected %016llx/%016llx), captured constants %s",
+					L.job_i, where, lk_ok ? "ok" : "MISMATCH", static_cast<unsigned long long>(e.lkey), static_cast<unsigned long long>(e.lkbase),
+					static_cast<unsigned long long>(J.v_lkey), static_cast<unsigned long long>(J.v_lkbase), c_ok ? "ok" : "MISMATCH");
+		}
+		if (!expected)
+		{
+			L.early++;
+			if (!L.early_where) L.early_where = where;
+		}
+		if (L.mode == 2 && (om_lane_fp(L.job_i) != L.fp ||
+			g_r2.om_defer_q.size() != L.qsz + (L.job_i < g_r2.cur_F.e.size() && g_r2.cur_F.e[L.job_i].om_dq ? 1 : 0)) && !L.bad++)
+			r2log("WARNING RSX_RECORD_DEFER=2: the inputs of draw entry %u changed while it was classified on the helper (join at %s)", L.job_i, where);
+	}
+
+	// Every r2aa entry point on the render thread, before it reads or writes cur_F / prev_F / the objmv state
+	inline void om_lane_join(const char* where, bool expected = false)
+	{
+		if (g_lane.running && t_lane_owner) [[unlikely]] om_lane_join_slow(where, expected);
+	}
+
+	// The queued entries, classified from scratch (pairing, stats); the draw-time bits (vertex hash, deform) are kept.
+	// Runs after the scene: the render thread no longer touches cur_F / prev_F / the resolve memo until om_defer_finish.
+	void om_defer_classify_all()
+	{
+		auto& st = g_r2;
+		const auto t0 = std::chrono::steady_clock::now();
+		for (const u32 i : st.om_defer_q)
+		{
+			if (i >= st.cur_F.e.size()) continue;
+			auto& e = st.cur_F.e[i];
+			e.om = static_cast<decltype(e.om)>(e.om & ~(om_matched | om_new));
+			e.loose = false;
+			om_classify(i);
+			if (e.om & (om_skin | om_rigid)) st.om_late_start++;
+		}
+		st.om_def_draws += size32(st.om_defer_q);
+		st.om_def_frames++;
+		st.om_def_ns += static_cast<u64>(std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::steady_clock::now() - t0).count());
+	}
+
+	// The first draw after the run (vote and exact VP have read cur_F)
+	void om_defer_kick()
+	{
+		if (r2cfg().om_defer != 1) return; // 2: at the flip
+		g_om_def_running = true;
+		om_defer_w().start(om_defer_classify_all);
+	}
+
+	// Before anything reads or swaps cur_F / prev_F or the objmv counters. classify: also the not yet classified entries.
+	void om_defer_finish(bool classify)
+	{
+		auto& st = g_r2;
+		if (g_om_def_running)
+		{
+			om_defer_w().wait();
+			g_om_def_running = false;
+			st.om_defer_q.clear();
+		}
+		if (classify && !st.om_defer_q.empty())
+		{
+			om_defer_classify_all();
+			st.om_defer_q.clear();
+		}
+	}
+
+	// RSX_AA_HOOK_OFFLOAD (default 1, 0 = off, 2 = also verify): before the camera vote (r2aa_run, render thread), the
+	// matrix extractions of this frame's paired entries are split with the objmv worker. Extraction is a pure function
+	// of the captured constants; the worker half skips the shared memo / neighbour reuse, which only cache that result.
+	struct hko_stats_t { u32 runs = 0, pre = 0, worker = 0, bad = 0, ph_runs = 0; u64 vote_ns = 0, pre_ns = 0; u64 ph[6] = {}; } g_hko;
+	// r2aa_run split: setup, camera, conf/objmv/mask, prep pass, upscaler evaluate, result/post
+	struct r2aa_phases
+	{
+		std::chrono::steady_clock::time_point t = std::chrono::steady_clock::now();
+		void mark(int k)
+		{
+			const auto n = std::chrono::steady_clock::now();
+			g_hko.ph[k] += static_cast<u64>(std::chrono::duration_cast<std::chrono::nanoseconds>(n - t).count());
+			t = n;
+			if (k == 5) g_hko.ph_runs++;
+		}
+	};
+	u8 resolve_pure(const mvp_frame& f, const mvp_entry& e, float* scratch, m4& M)
+	{
+		const vp_info& pi = *e.prog;
+		const float* src = f.consts.data() + e.const_off;
+		const float* consts = src;
+		if (!pi.indexed)
+		{
+			for (usz k = 0; k < pi.reads.size(); ++k) std::memcpy(scratch + pi.reads[k] * 4, src + k * 4, 4 * sizeof(float));
+			consts = scratch;
+		}
+		return vp_extract_matrix(pi.code(), consts, e.branch_bits, M) ? 1 : 2;
+	}
+	void hook_pre_resolve()
+	{
+		static const int mode = [] { const char* v = std::getenv("RSX_AA_HOOK_OFFLOAD"); return v && *v ? std::atoi(v) : 1; }();
+		auto& st = g_r2;
+		if (!mode || !r2cfg().objmv || g_om_def_running) return;
+		const auto t0 = std::chrono::steady_clock::now();
+		static std::vector<u32> todo;
+		todo.clear();
+		const u32 vsm = r2cfg().vote_sample;
+		const u32 ne = static_cast<u32>(st.cur_F.e.size());
+		const u32 vstride = vsm && ne > vsm ? (ne + vsm - 1) / vsm : 1;
+		for (u32 i = 0; i < ne; i += vstride)
+		{
+			const auto& e = st.cur_F.e[i];
+			if (e.state) continue;
+			const u32* pi = st.om_prev.find(e.key, false);
+			if (!pi && r2cfg().match_loose && e.lkey && !e.prog->indexed) pi = st.prev_loose.find(e.lkey, false);
+			if (pi) todo.push_back(i);
+		}
+		if (todo.size() < 32) return;
+		// worker: the upper half (indices above every render-thread entry, whose neighbour reuse reads lower entries only)
+		const usz mid = todo.size() / 2;
+		om_defer_w().start([mid]
+		{
+			alignas(16) static float s_scratch[512 * 4];
+			auto& f = g_r2.cur_F;
+			for (usz k = mid; k < todo.size(); ++k)
+			{
+				auto& e = f.e[todo[k]];
+				if (!e.state) e.state = resolve_pure(f, e, s_scratch, e.M);
+			}
+		});
+		for (usz k = 0; k < mid; ++k) resolve_entry(st.cur_F, todo[k]);
+		om_defer_w().wait();
+		if (mode == 2)
+		{
+			for (usz k = mid; k < todo.size(); ++k)
+			{
+				auto& e = st.cur_F.e[todo[k]];
+				const u8 s0 = e.state;
+				const m4 M0 = e.M;
+				e.state = 0;
+				resolve_entry(st.cur_F, todo[k]);
+				if (e.state != s0 || (s0 == 1 && std::memcmp(&M0, &e.M, sizeof(m4)) != 0))
+				{
+					if (!g_hko.bad++) r2log("WARNING RSX_AA_HOOK_OFFLOAD=2: worker matrix differs for entry %u (state %u vs %u)", todo[k], s0, e.state);
+				}
+			}
+		}
+		g_hko.pre += size32(todo);
+		g_hko.worker += static_cast<u32>(todo.size() - mid);
+		g_hko.pre_ns += static_cast<u64>(std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::steady_clock::now() - t0).count());
+	}
+
+	// Adds the render-thread time of a scope to the objmv CPU counter
+	struct om_cpu_scope
+	{
+		const std::chrono::steady_clock::time_point t0 = std::chrono::steady_clock::now();
+		~om_cpu_scope() { g_om2.cpu_ns += static_cast<u64>(std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::steady_clock::now() - t0).count()); }
+	};
+
+	// RSX_AA_OBJMV_DEFER_HIST: after om_defer_finish. Late starts get the history copy the inline path would have made:
+	// into hcopy when the velocity pass is still to come, else into 'out' (issued at the flip, same command buffer).
+	u32 om_defer_late_hist(std::vector<VkBufferCopy>& out, VkBuffer& out_src)
+	{
+		auto& o = g_om2;
+		auto& st = g_r2;
+		u32 n = 0;
+		// RSX_AA_OBJMV_DEFER_SPEC: the late starts among the draws copied at a command buffer end keep their slot
+		for (const auto& [ent, slot] : o.lspec)
+		{
+			if (ent >= st.cur_F.e.size()) continue;
+			auto& e = st.cur_F.e[ent];
+			if (!(e.om & (om_skin | om_rigid)) || e.om_hslot) continue;
+			e.om_hslot = static_cast<u16>(slot + 1);
+			o.t_late_promo++;
+			o.t_late_hist++;
+		}
+		o.lspec.clear();
+		if (o.late.empty()) return 0;
+		const bool to_h = !st.aa_done;
+		if (to_h && !o.hsrc && o.hcopy.empty()) o.hsrc = o.late_src;
+		if ((to_h ? o.late_src == o.hsrc : out.empty()) && o.sbuf)
+		{
+			for (const auto& l : o.late)
+			{
+				if (o.hn >= o.cap) break;
+				if (l.entry >= st.cur_F.e.size()) continue;
+				auto& e = st.cur_F.e[l.entry];
+				if (!(e.om & (om_skin | om_rigid)) || e.om_hslot) continue;
+				const u32 slot = o.hn++;
+				VkBufferCopy bc{};
+				bc.srcOffset = l.src;
+				bc.dstOffset = static_cast<VkDeviceSize>(o.cap) * 16 * (1 + static_cast<VkDeviceSize>(o.hpar) * 468) + static_cast<VkDeviceSize>(slot) * 468 * 16;
+				bc.size = l.size;
+				(to_h ? o.hcopy : out).push_back(bc);
+				e.om_hslot = static_cast<u16>(slot + 1);
+				n++;
+			}
+			if (!to_h) out_src = o.late_src;
+		}
+		o.t_late_hist += n;
+		o.late.clear();
+		o.late_src = VK_NULL_HANDLE;
+		return n;
+	}
+
+	// RSX_AA_OBJMV_DEFER: before a frame swap. Finishes the classification; late starts after the velocity pass get their
+	// history copies now (same command buffer as their draws, same barriers as om2_flush_history).
+	void om_defer_late_flush(vk::command_buffer_chunk* cmd)
+	{
+		om_defer_finish(true);
+		static std::vector<VkBufferCopy> s_late;
+		VkBuffer src = VK_NULL_HANDLE;
+		s_late.clear();
+		om_defer_late_hist(s_late, src);
+		auto& o = g_om2;
+		if (s_late.empty() || !src || !cmd || o.cb != cmd || o.cb_reset != cmd->reset_id || !o.sbuf) return;
+		if (vk::is_renderpass_open(*cmd)) vk::end_renderpass(*cmd);
+		vkCmdPipelineBarrier(*cmd, VK_PIPELINE_STAGE_VERTEX_SHADER_BIT, VK_PIPELINE_STAGE_TRANSFER_BIT, 0, 0, nullptr, 0, nullptr, 0, nullptr);
+		vkCmdCopyBuffer(*cmd, src, o.sbuf->value, size32(s_late), s_late.data());
+		const VkDeviceSize hbase = static_cast<VkDeviceSize>(o.cap) * 16 * (1 + static_cast<VkDeviceSize>(o.hpar) * 468);
+		for (const auto& c : s_late) o.hvalid[o.hpar][static_cast<usz>((c.dstOffset - hbase) / (468 * 16))] = 1;
+		VkMemoryBarrier mb{ VK_STRUCTURE_TYPE_MEMORY_BARRIER };
+		mb.srcAccessMask = VK_ACCESS_TRANSFER_WRITE_BIT;
+		mb.dstAccessMask = VK_ACCESS_SHADER_READ_BIT;
+		vkCmdPipelineBarrier(*cmd, VK_PIPELINE_STAGE_TRANSFER_BIT, VK_PIPELINE_STAGE_VERTEX_SHADER_BIT, 0, 1, &mb, 0, nullptr, 0, nullptr);
+		o.n_hist += size32(s_late);
+	}
+
+	void om2_frame_end()
+	{
+		auto& o = g_om2;
+		if (r2cfg().objmv != 1) return;
+		o.n_skip += size32(o.recs); // recorded but never replayed (no upscaler run)
+		o.recs.clear();
+		// History copies not executed (no velocity pass this frame) leave their slots invalid: camera motion next frame
+		o.hcopy.clear();
+		o.hsrc = VK_NULL_HANDLE;
+		o.late.clear();
+		o.late_src = VK_NULL_HANDLE;
+		o.lspec.clear();
+		o.dcopy.clear();
+		o.dsrc = VK_NULL_HANDLE;
+		o.dused = 0;
+		o.dn = 0;
+		o.dn_new = 0;
+		o.t_dcap += o.n_dcap; o.t_dfm += o.n_dfm; o.t_dmiss += o.n_dmiss;
+		o.n_dcap = o.n_dfm = o.n_dmiss = 0;
+		o.hpar ^= 1;
+		o.hn = 0;
+		std::fill(o.hvalid[o.hpar].begin(), o.hvalid[o.hpar].end(), u8{0});
+		if (r2cfg().om_log && (g_r2.frame % r2cfg().om_log) == 0)
+			r2log("O2 f%u objmv2 recorded %u replayed %u onepass %u pending-pipe %u skipped %u no-history %u camera-only %u gpu-history %u cpu %llu us", g_r2.frame,
+				o.n_rec, o.n_replay, o.n_op, o.n_pending, o.n_skip, o.n_nohist, o.n_static, o.n_hist, static_cast<unsigned long long>(o.cpu_ns / 1000));
+		o.t_rec += o.n_rec; o.t_replay += o.n_replay; o.t_pending += o.n_pending; o.t_skip += o.n_skip; o.t_nohist += o.n_nohist; o.t_hist += o.n_hist;
+		o.t_seg += o.n_seg;
+		o.t_op += o.n_op;
+		o.t_cpu_ns += o.cpu_ns;
+		o.t_frames++;
+		if (o.ran || o.applied) o.t_passes++; // R3: was 'ran || vb_written'; onepass consumption clears vb_written first (always 0)
+		o.applied = false;
+		o.n_new_hist = 0;
+		o.n_rec = o.n_replay = o.n_pending = o.n_skip = o.n_nohist = o.n_static = o.n_hist = o.n_seg = o.n_op = 0;
+		o.cpu_ns = 0;
+		o.ran = false;
+		o.vel_live = false;
+		// onepass velocity written but not consumed (no upscaler run this frame): stale until the next clear
+		if (o.vb_written) o.vb_clean = false;
+	}
+}
+
+// At most max_verts vertices in the whole draw call. get_elements_count() is only valid while the backend
+// iterates the sub-draws (it asserts on the current range: d3 killed the RSX thread).
+static bool r2aa_small_draw(const rsx::draw_clause& dc, u32 max_verts)
+{
+	if (dc.command == rsx::draw_command::inlined_array) return false;
+	const u32 n = dc.r2_total_elements();
+	return n > 0 && n <= max_verts;
+}
+
+// RSX_AA_POST_STABLE / RSX_AA_OCC_JITTER bookkeeping per jittered draw: the same target as the previous draw skips the hash
+static inline void jd_mark(r2aa_state& st, u32 a, u32 r)
+{
+	if (st.jdm_set[r] == a && st.jdm_set_gen[r] == st.jdm_gen) return;
+	st.jd_depth.insert(a);
+	st.jdm_set[r] = a;
+	st.jdm_set_gen[r] = st.jdm_gen;
+}
+
+static inline void jd_put(r2aa_state& st, u32 a, u32 r, const r2aa_state::jd_shift_t& sh)
+{
+	if (st.jdm_sh[r] != a || st.jdm_sh_gen[r] != st.jdm_gen)
+	{
+		st.jdm_shp[r] = &st.jd_shift[a];
+		st.jdm_sh[r] = a;
+		st.jdm_sh_gen[r] = st.jdm_gen;
+	}
+	*st.jdm_shp[r] = sh;
+}
