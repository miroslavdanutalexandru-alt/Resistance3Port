index 0000000..4354426
--- /dev/null
+++ b/rpcs3/Emu/RSX/VK/VKR2Fossilize.cpp
@@ -0,0 +1,420 @@
+// R2PORT (R2_FOSSILIZE): recording and replay of the renderer's Vulkan pipeline state with Valve's Fossilize
+// (ps3recomp/third_party/fossilize, MIT). Built in the r2_fossilize object library against Fossilize's headers.
+
+#include "VKR2Fossilize.h"
+
+#include "fossilize.hpp"
+#include "fossilize_db.hpp"
+
+#include <chrono>
+#include <condition_variable>
+#include <cstdio>
+#include <deque>
+#include <memory>
+#include <mutex>
+#include <string>
+#include <thread>
+#include <vector>
+
+#ifdef _WIN32
+#ifndef WIN32_LEAN_AND_MEAN
+#define WIN32_LEAN_AND_MEAN
+#endif
+#ifndef NOMINMAX
+#define NOMINMAX
+#endif
+#include <windows.h>
+#endif
+
+namespace r2foz
+{
+	std::atomic<bool> g_recording{ false };
+
+	namespace
+	{
+		void low_priority()
+		{
+#ifdef _WIN32
+			SetThreadPriority(GetCurrentThread(), THREAD_PRIORITY_BELOW_NORMAL);
+#endif
+		}
+
+		const void* find_pnext(const void* chain, VkStructureType type)
+		{
+			for (auto* s = static_cast<const VkBaseInStructure*>(chain); s; s = s->pNext)
+			{
+				if (s->sType == type) return s;
+			}
+			return nullptr;
+		}
+
+		// ------------------------------------------------------------------ recording
+		std::mutex g_rec_lock;
+		std::unique_ptr<Fossilize::DatabaseInterface> g_rec_db;
+		std::unique_ptr<Fossilize::StateRecorder> g_rec;
+		std::atomic<uint32_t> g_rec_pipelines{ 0 };
+		std::atomic<uint32_t> g_rec_failed{ 0 };
+
+		template <typename F>
+		void with_recorder(F&& f)
+		{
+			if (!recording()) return;
+			std::lock_guard lock(g_rec_lock);
+			if (g_rec && !f(*g_rec)) ++g_rec_failed;
+		}
+	}
+
+	bool record_init(const char* db_path)
+	{
+		std::lock_guard lock(g_rec_lock);
+		if (g_rec) return true;
+
+		std::unique_ptr<Fossilize::DatabaseInterface> db(Fossilize::create_stream_archive_database(db_path, Fossilize::DatabaseMode::Append));
+		if (!db) return false;
+
+		auto rec = std::make_unique<Fossilize::StateRecorder>();
+		rec->set_database_enable_compression(true);
+		rec->set_database_enable_checksum(true);
+		rec->init_recording_thread(db.get());
+
+		g_rec_db = std::move(db);
+		g_rec = std::move(rec);
+		g_rec_pipelines = 0;
+		g_rec_failed = 0;
+		g_recording = true;
+		return true;
+	}
+
+	void record_shutdown()
+	{
+		std::unique_ptr<Fossilize::StateRecorder> rec;
+		std::unique_ptr<Fossilize::DatabaseInterface> db;
+		{
+			std::lock_guard lock(g_rec_lock);
+			if (!g_rec) return;
+			g_recording = false;
+			rec = std::move(g_rec);
+			db = std::move(g_rec_db);
+		}
+
+		rec.reset(); // joins the recording thread, which flushes the database
+		db.reset();
+		std::printf("[r2foz] record: %u pipelines recorded this session (%u objects could not be recorded)\n",
+			g_rec_pipelines.load(), g_rec_failed.load());
+		std::fflush(stdout);
+	}
+
+	void record_shader_module(VkShaderModule module, const VkShaderModuleCreateInfo& info)
+	{
+		with_recorder([&](Fossilize::StateRecorder& r) { return r.record_shader_module(module, info); });
+	}
+
+	void record_descriptor_set_layout(VkDescriptorSetLayout layout, const VkDescriptorSetLayoutCreateInfo& info)
+	{
+		with_recorder([&](Fossilize::StateRecorder& r) { return r.record_descriptor_set_layout(layout, info); });
+	}
+
+	void record_pipeline_layout(VkPipelineLayout layout, const VkPipelineLayoutCreateInfo& info)
+	{
+		with_recorder([&](Fossilize::StateRecorder& r) { return r.record_pipeline_layout(layout, info); });
+	}
+
+	void record_render_pass(VkRenderPass pass, const VkRenderPassCreateInfo& info)
+	{
+		with_recorder([&](Fossilize::StateRecorder& r) { return r.record_render_pass(pass, info); });
+	}
+
+	void record_graphics_pipeline(VkPipeline pipeline, const VkGraphicsPipelineCreateInfo& info)
+	{
+		// Pipelines linked from libraries are not recorded: the monolithic pipeline and the parts are
+		if (find_pnext(info.pNext, VK_STRUCTURE_TYPE_PIPELINE_LIBRARY_CREATE_INFO_KHR)) return;
+		with_recorder([&](Fossilize::StateRecorder& r)
+		{
+			const bool ok = r.record_graphics_pipeline(pipeline, info, nullptr, 0);
+			if (ok) ++g_rec_pipelines;
+			return ok;
+		});
+	}
+
+	void record_compute_pipeline(VkPipeline pipeline, const VkComputePipelineCreateInfo& info)
+	{
+		with_recorder([&](Fossilize::StateRecorder& r)
+		{
+			const bool ok = r.record_compute_pipeline(pipeline, info, nullptr, 0);
+			if (ok) ++g_rec_pipelines;
+			return ok;
+		});
+	}
+
+	// ---------------------------------------------------------------------- replay
+	namespace
+	{
+		struct replay_job
+		{
+			const VkGraphicsPipelineCreateInfo* graphics = nullptr;
+			const VkComputePipelineCreateInfo* compute = nullptr;
+		};
+
+		struct replayer final : Fossilize::StateCreatorInterface
+		{
+			VkDevice dev = VK_NULL_HANDLE;
+			VkPhysicalDevice gpu = VK_NULL_HANDLE;
+			VkPipelineCache cache = VK_NULL_HANDLE;
+			bool allow_libraries = false;
+			bool allow_provoking_vertex = false;
+
+			std::vector<VkSampler> samplers;
+			std::vector<VkDescriptorSetLayout> set_layouts;
+			std::vector<VkPipelineLayout> layouts;
+			std::vector<VkShaderModule> modules;
+			std::vector<VkRenderPass> passes;
+
+			std::mutex lock;
+			std::condition_variable cv_work;
+			std::condition_variable cv_space;
+			std::deque<replay_job> queue;
+			bool parse_done = false;
+			std::atomic<bool>* stop = nullptr;
+			std::atomic<uint32_t> created{ 0 };
+			std::atomic<uint32_t> failed{ 0 };
+			uint32_t skipped = 0;
+
+			bool format_ok(VkFormat fmt, VkFormatFeatureFlags need)
+			{
+				if (!gpu || fmt == VK_FORMAT_UNDEFINED) return true;
+				VkFormatProperties props{};
+				vkGetPhysicalDeviceFormatProperties(gpu, fmt, &props);
+				return (props.optimalTilingFeatures & need) == need;
+			}
+
+			void push(const replay_job& job)
+			{
+				std::unique_lock lk(lock);
+				while (queue.size() >= 64 && !stop->load()) cv_space.wait_for(lk, std::chrono::milliseconds(50));
+				queue.push_back(job);
+				cv_work.notify_one();
+			}
+
+			bool enqueue_create_sampler(Fossilize::Hash, const VkSamplerCreateInfo* info, VkSampler* out) override
+			{
+				if (vkCreateSampler(dev, info, nullptr, out) != VK_SUCCESS) return false;
+				samplers.push_back(*out);
+				return true;
+			}
+
+			bool enqueue_create_descriptor_set_layout(Fossilize::Hash, const VkDescriptorSetLayoutCreateInfo* info, VkDescriptorSetLayout* out) override
+			{
+				if (vkCreateDescriptorSetLayout(dev, info, nullptr, out) != VK_SUCCESS) return false;
+				set_layouts.push_back(*out);
+				return true;
+			}
+
+			bool enqueue_create_pipeline_layout(Fossilize::Hash, const VkPipelineLayoutCreateInfo* info, VkPipelineLayout* out) override
+			{
+				if ((info->flags & VK_PIPELINE_LAYOUT_CREATE_INDEPENDENT_SETS_BIT_EXT) && !allow_libraries) return false;
+				if (vkCreatePipelineLayout(dev, info, nullptr, out) != VK_SUCCESS) return false;
+				layouts.push_back(*out);
+				return true;
+			}
+
+			bool enqueue_create_shader_module(Fossilize::Hash, const VkShaderModuleCreateInfo* info, VkShaderModule* out) override
+			{
+				if (vkCreateShaderModule(dev, info, nullptr, out) != VK_SUCCESS) return false;
+				modules.push_back(*out);
+				return true;
+			}
+
+			bool enqueue_create_render_pass(Fossilize::Hash, const VkRenderPassCreateInfo* info, VkRenderPass* out) override
+			{
+				// A database recorded on another GPU may use attachment formats this one lacks (e.g. D24S8)
+				for (uint32_t i = 0; i < info->attachmentCount; ++i)
+				{
+					const VkFormat f = info->pAttachments[i].format;
+					const bool depth = f == VK_FORMAT_D16_UNORM || f == VK_FORMAT_D32_SFLOAT || f == VK_FORMAT_D24_UNORM_S8_UINT ||
+						f == VK_FORMAT_D32_SFLOAT_S8_UINT || f == VK_FORMAT_D16_UNORM_S8_UINT || f == VK_FORMAT_X8_D24_UNORM_PACK32 || f == VK_FORMAT_S8_UINT;
+					if (!format_ok(f, depth ? VK_FORMAT_FEATURE_DEPTH_STENCIL_ATTACHMENT_BIT : VK_FORMAT_FEATURE_COLOR_ATTACHMENT_BIT)) return false;
+				}
+				if (vkCreateRenderPass(dev, info, nullptr, out) != VK_SUCCESS) return false;
+				passes.push_back(*out);
+				return true;
+			}
+
+			bool enqueue_create_render_pass2(Fossilize::Hash, const VkRenderPassCreateInfo2*, VkRenderPass*) override
+			{
+				return false; // the renderer only uses VkRenderPassCreateInfo
+			}
+
+			bool enqueue_create_compute_pipeline(Fossilize::Hash hash, const VkComputePipelineCreateInfo* info, VkPipeline* out) override
+			{
+				*out = reinterpret_cast<VkPipeline>(static_cast<uintptr_t>(hash)); // placeholder; nothing derives from it
+				replay_job job;
+				job.compute = info;
+				push(job);
+				return true;
+			}
+
+			bool enqueue_create_graphics_pipeline(Fossilize::Hash hash, const VkGraphicsPipelineCreateInfo* info, VkPipeline* out) override
+			{
+				*out = reinterpret_cast<VkPipeline>(static_cast<uintptr_t>(hash));
+				const bool linked = find_pnext(info->pNext, VK_STRUCTURE_TYPE_PIPELINE_LIBRARY_CREATE_INFO_KHR) != nullptr;
+				const bool library = (info->flags & VK_PIPELINE_CREATE_LIBRARY_BIT_KHR) != 0;
+				const bool provoking = info->pRasterizationState &&
+					find_pnext(info->pRasterizationState->pNext, VK_STRUCTURE_TYPE_PIPELINE_RASTERIZATION_PROVOKING_VERTEX_STATE_CREATE_INFO_EXT);
+				if (linked || (library && !allow_libraries) || (provoking && !allow_provoking_vertex))
+				{
+					++skipped;
+					return true;
+				}
+
+				replay_job job;
+				job.graphics = info;
+				push(job);
+				return true;
+			}
+
+			bool enqueue_create_raytracing_pipeline(Fossilize::Hash, const VkRayTracingPipelineCreateInfoKHR*, VkPipeline*) override
+			{
+				return false;
+			}
+
+			void worker()
+			{
+				low_priority();
+				for (;;)
+				{
+					replay_job job;
+					{
+						std::unique_lock lk(lock);
+						while (queue.empty() && !parse_done && !stop->load()) cv_work.wait_for(lk, std::chrono::milliseconds(50));
+						if (stop->load() || queue.empty()) return;
+						job = queue.front();
+						queue.pop_front();
+						cv_space.notify_one();
+					}
+
+					VkPipeline pipe = VK_NULL_HANDLE;
+					const VkResult res = job.graphics
+						? vkCreateGraphicsPipelines(dev, cache, 1, job.graphics, nullptr, &pipe)
+						: vkCreateComputePipelines(dev, cache, 1, job.compute, nullptr, &pipe);
+					if (res == VK_SUCCESS && pipe)
+					{
+						++created;
+						vkDestroyPipeline(dev, pipe, nullptr);
+					}
+					else
+					{
+						++failed;
+					}
+				}
+			}
+
+			void destroy_objects()
+			{
+				for (auto p : passes) vkDestroyRenderPass(dev, p, nullptr);
+				for (auto m : modules) vkDestroyShaderModule(dev, m, nullptr);
+				for (auto l : layouts) vkDestroyPipelineLayout(dev, l, nullptr);
+				for (auto l : set_layouts) vkDestroyDescriptorSetLayout(dev, l, nullptr);
+				for (auto s : samplers) vkDestroySampler(dev, s, nullptr);
+				passes.clear(); modules.clear(); layouts.clear(); set_layouts.clear(); samplers.clear();
+			}
+		};
+
+		std::mutex g_replay_lock;
+		std::thread g_replay_thread;
+		std::atomic<bool> g_replay_stop{ false };
+
+		void replay_main(VkDevice dev, VkPipelineCache cache, std::string path, unsigned threads, replay_progress progress,
+			bool allow_libraries, bool allow_provoking_vertex, VkPhysicalDevice gpu)
+		{
+			low_priority();
+			const auto t0 = std::chrono::steady_clock::now();
+			replay_stats stats;
+
+			std::unique_ptr<Fossilize::DatabaseInterface> db(Fossilize::create_stream_archive_database(path.c_str(), Fossilize::DatabaseMode::ReadOnly));
+			if (!db || !db->prepare())
+			{
+				std::printf("[r2foz] replay: cannot open %s\n", path.c_str());
+				std::fflush(stdout);
+				return;
+			}
+
+			auto rep = std::make_unique<Fossilize::StateReplayer>();
+			rep->set_resolve_derivative_pipeline_handles(false);
+
+			replayer c;
+			c.dev = dev;
+			c.gpu = gpu;
+			c.cache = cache;
+			c.allow_libraries = allow_libraries;
+			c.allow_provoking_vertex = allow_provoking_vertex;
+			c.stop = &g_replay_stop;
+
+			std::vector<std::thread> workers;
+			for (unsigned i = 0; i < threads; ++i) workers.emplace_back([&c] { c.worker(); });
+
+			std::vector<uint8_t> blob;
+			uint32_t parse_failed = 0;
+			for (const Fossilize::ResourceTag tag : { Fossilize::RESOURCE_GRAPHICS_PIPELINE, Fossilize::RESOURCE_COMPUTE_PIPELINE })
+			{
+				size_t count = 0;
+				if (!db->get_hash_list_for_resource_tag(tag, &count, nullptr)) continue;
+				std::vector<Fossilize::Hash> hashes(count);
+				if (!db->get_hash_list_for_resource_tag(tag, &count, hashes.data())) continue;
+				stats.total += static_cast<uint32_t>(count);
+
+				for (const Fossilize::Hash h : hashes)
+				{
+					if (g_replay_stop.load()) break;
+					size_t size = 0;
+					if (!db->read_entry(tag, h, &size, nullptr, Fossilize::PAYLOAD_READ_NO_FLAGS)) { ++parse_failed; continue; }
+					blob.resize(size);
+					if (!db->read_entry(tag, h, &size, blob.data(), Fossilize::PAYLOAD_READ_NO_FLAGS) ||
+						!rep->parse(c, db.get(), blob.data(), size))
+					{
+						++parse_failed;
+					}
+				}
+			}
+
+			{
+				std::lock_guard lk(c.lock);
+				c.parse_done = true;
+			}
+			c.cv_work.notify_all();
+			c.cv_space.notify_all();
+			for (auto& w : workers) w.join();
+
+			// The replayer's create infos and these objects are only needed by the pipelines above
+			c.destroy_objects();
+			rep.reset();
+
+			stats.created = c.created.load();
+			stats.failed = c.failed.load() + parse_failed;
+			stats.skipped = c.skipped;
+			stats.ms = std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - t0).count();
+			if (progress) progress(stats, !g_replay_stop.load());
+		}
+	}
+
+	bool replay_start(VkDevice dev, VkPhysicalDevice gpu, VkPipelineCache cache, const char* db_path, unsigned threads,
+		replay_progress progress, bool allow_libraries, bool allow_provoking_vertex)
+	{
+		std::lock_guard lock(g_replay_lock);
+		if (g_replay_thread.joinable()) return true;
+
+		if (FILE* f = std::fopen(db_path, "rb")) std::fclose(f);
+		else return false;
+
+		g_replay_stop = false;
+		g_replay_thread = std::thread(replay_main, dev, cache, std::string(db_path), threads ? threads : 1u, progress,
+			allow_libraries, allow_provoking_vertex, gpu);
+		return true;
+	}
+
+	void replay_stop()
+	{
+		std::lock_guard lock(g_replay_lock);
+		g_replay_stop = true;
+		if (g_replay_thread.joinable()) g_replay_thread.join();
+	}
+}
diff --git a/rpcs3/Emu/RSX/VK/VKR2Fossilize.h b/rpcs3/Emu/RSX/VK/VKR2Fossilize.h
new file mode 100644
index 0000000..36a656d
--- /dev/null
+++ b/rpcs3/Emu/RSX/VK/VKR2Fossilize.h
@@ -0,0 +1,48 @@
+#pragma once
+
+// R2PORT (R2_FOSSILIZE): Valve Fossilize (MIT, ps3recomp/third_party/fossilize) recording and replay of the
+// renderer's Vulkan pipeline state. VKR2Fossilize.cpp is compiled against Fossilize's own headers; this interface
+// only uses core Vulkan types.
+
+#include <atomic>
+#include <cstdint>
+#include <vulkan/vulkan_core.h>
+
+namespace r2foz
+{
+	extern std::atomic<bool> g_recording;
+
+	inline bool recording() { return g_recording.load(std::memory_order_relaxed); }
+
+	// Record mode: appends every recorded object to the stream archive at db_path (.foz)
+	bool record_init(const char* db_path);
+	void record_shutdown();
+
+	void record_shader_module(VkShaderModule module, const VkShaderModuleCreateInfo& info);
+	void record_descriptor_set_layout(VkDescriptorSetLayout layout, const VkDescriptorSetLayoutCreateInfo& info);
+	void record_pipeline_layout(VkPipelineLayout layout, const VkPipelineLayoutCreateInfo& info);
+	void record_render_pass(VkRenderPass pass, const VkRenderPassCreateInfo& info);
+	void record_graphics_pipeline(VkPipeline pipeline, const VkGraphicsPipelineCreateInfo& info);
+	void record_compute_pipeline(VkPipeline pipeline, const VkComputePipelineCreateInfo& info);
+
+	struct replay_stats
+	{
+		uint32_t total = 0;    // graphics + compute pipelines in the database
+		uint32_t created = 0;  // compiled (or found in the VkPipelineCache)
+		uint32_t failed = 0;   // parse or creation failed (e.g. a feature this device lacks)
+		uint32_t skipped = 0;  // linked from pipeline libraries (not replayed)
+		double ms = 0;
+	};
+
+	using replay_progress = void (*)(const replay_stats& stats, bool finished);
+
+	// Replays every pipeline in db_path on low-priority threads into the given VkPipelineCache (the pipelines are
+	// destroyed again; the point is the warm driver and pipeline caches). Returns false if the database is missing.
+	// Pipeline libraries / independent-set layouts need allow_libraries (GPL enabled on the device), provoking-vertex
+	// state needs VK_EXT_provoking_vertex; render passes with attachment formats the GPU lacks are skipped.
+	bool replay_start(VkDevice dev, VkPhysicalDevice gpu, VkPipelineCache cache, const char* db_path, unsigned threads,
+		replay_progress progress, bool allow_libraries, bool allow_provoking_vertex);
+
+	// Stops and joins the replay, destroys its objects. Must run before the device or the pipeline cache goes away.
+	void replay_stop();
+}
diff --git a/rpcs3/Emu/RSX/VK/VKR2FrameGen.cpp b/rpcs3/Emu/RSX/VK/VKR2FrameGen.cpp
new file mode 100644
index 0000000..96d97f0
--- /dev/null
+++ b/rpcs3/Emu/RSX/VK/VKR2FrameGen.cpp
@@ -0,0 +1,2313 @@
+// R2PORT: Resistance 2/3 port addition (not upstream RPCS3).
+// Frame generation, two backends:
+//  * NVIDIA DLSS Frame Generation through Streamline (manual hooking): sl.interposer.dll is loaded at run time
+//    from the exe folder and only its Vulkan proxies (instance, device, surface, swapchain, present) are used.
+//  * AMD FidelityFX FSR 3 frame interpolation (amd_fidelityfx_vk.dll, official FidelityFX API 1.1.4 headers):
+//    its frame-generation swapchain replaces RPCS3's swapchain; 2x only. Used for GPUs without DLSS-G.
+// The game's HUD is split from the scene in the RSX command stream (r2fg_on_draw) so that frame generation gets a
+// HUD-less colour buffer and a UI colour+alpha buffer and re-composites the UI on every generated frame.
+// Off unless R2_DLSS_FG (or R3_/R1_) is 2, 3, 4 or fsr3; R2_FG_BACKEND=auto|dlss|fsr3.
+// Design, switches and limitations: scratch/framegen_vk.md.
+#include "stdafx.h"
+#include "VKR2FrameGen.h"
+#include "VKGSRender.h"
+#include "VKCompute.h"
+#include "VKHelpers.h"
+#include "VKRenderPass.h"
+#include "VKResourceManager.h"
+#include "VKR2Upscaler.h"
+#include "VKR2PcExtras.h"
+#include "vkutils/sampler.h"
+#include "Emu/RSX/rsx_methods.h"
+#include "Emu/RSX/NV47/HW/context_accessors.define.h"
+
+#include <cstdio>
+#include <cstdarg>
+#include <cctype>
+#include <cstdlib>
+#include <cstring>
+#include <cmath>
+#include <algorithm>
+#include <atomic>
+#include <memory>
+#include <mutex>
+#include <string>
+#include <vector>
+
+#ifdef _WIN32
+#include <windows.h>
+#endif
+
+extern "C"
+{
+	volatile int g_r2fg_active = 0;
+
+	// game side (project/stubs.cpp, r?_pcport.cpp); builds without them link the defaults below
+	extern volatile unsigned long long g_r2_look_ms;
+	extern volatile int g_r2pc_paused;
+	int port_local_players(void);
+	// libs/input/cellPad.c: player input and the in-play / pause-menu ticks (menu detection that also works in vehicles)
+	extern volatile int g_ml_fed_rx, g_ml_fed_ry;
+	extern volatile unsigned long long g_kbm_mouse_abs;
+	extern volatile unsigned long long g_port_play_ms;
+	extern volatile int g_port_pause_ui; // always defined by cellPad.c; no default here (R2's rsx_eng_mt.inc has its own)
+	volatile unsigned long long r2fg_look_ms_default = 0;
+	volatile int r2fg_paused_default = 0;
+	int r2fg_local_players_default(void) { return 1; }
+	volatile int r2fg_int_default = 0;
+	volatile unsigned long long r2fg_u64_default = 0;
+}
+#ifdef _WIN32
+#pragma comment(linker, "/alternatename:g_r2_look_ms=r2fg_look_ms_default")
+#pragma comment(linker, "/alternatename:g_r2pc_paused=r2fg_paused_default")
+#pragma comment(linker, "/alternatename:port_local_players=r2fg_local_players_default")
+#pragma comment(linker, "/alternatename:g_ml_fed_rx=r2fg_int_default")
+#pragma comment(linker, "/alternatename:g_ml_fed_ry=r2fg_int_default")
+#pragma comment(linker, "/alternatename:g_kbm_mouse_abs=r2fg_u64_default")
+#pragma comment(linker, "/alternatename:g_port_play_ms=r2fg_u64_default")
+#endif
+
+namespace
+{
+	const char* penv(const char* name)
+	{
+		for (const char* pre : { "R2_", "R3_", "R1_" })
+		{
+			char full[96];
+			std::snprintf(full, sizeof(full), "%s%s", pre, name);
+			const char* e = std::getenv(full);
+			if (e && *e) return e;
+		}
+		return nullptr;
+	}
+	int penv_int(const char* name, int def) { const char* e = penv(name); return e ? std::atoi(e) : def; }
+
+	bool same_word(const char* a, const char* b)
+	{
+		if (!a || !b) return false;
+		for (; *a && *b; ++a, ++b)
+			if (std::tolower(static_cast<unsigned char>(*a)) != std::tolower(static_cast<unsigned char>(*b))) return false;
+		return *a == *b;
+	}
+
+	struct fg_config
+	{
+		int want = 0;          // requested multiplier: 0 off, 2, 3, 4
+		int backend = 0;       // R2_FG_BACKEND: 0 auto (DLSS-G, else FSR 3), 1 DLSS-G only, 2 FSR 3 only
+		bool hud = true;       // split the HUD from the scene (R2_DLSS_FG_HUD)
+		bool hud_debug = false; // tint the detected HUD / overlays on screen (R2_DLSS_FG_HUD_DEBUG)
+		bool debug = false;    // verbose Streamline log (R2_DLSS_FG_DEBUG)
+		int debug_level = 0;   // R2_DLSS_FG_DEBUG=2: FSR 3 tear lines and reset indicators
+		bool menu_off = true;  // off while the game's look code is idle (menus, movies, loading)
+		bool cap = true;       // Reflex frame cap so rendered x N stays under the refresh rate
+		bool yflip = true;     // clip-space y up for the Streamline matrices
+	};
+
+	const fg_config& fgcfg()
+	{
+		static const fg_config c = []
+		{
+			fg_config r;
+			// R2_DLSS_FG=fsr3 (the launcher's "FSR 3 2x") is 2x on the FSR 3 backend
+			const char* fg = penv("DLSS_FG");
+			const bool fsr_word = same_word(fg, "fsr3") || same_word(fg, "fsr");
+			const int v = fsr_word ? 2 : penv_int("DLSS_FG", 0);
+			r.want = (v >= 2 && v <= 4) ? v : 0;
+			if (v && !r.want) std::fprintf(stderr, "[fg-vk] R2_DLSS_FG=%d ignored (use 0, 2, 3, 4 or fsr3)\n", v);
+			const char* b = penv("FG_BACKEND");
+			r.backend = fsr_word ? 2 : same_word(b, "dlss") ? 1 : (same_word(b, "fsr3") || same_word(b, "fsr")) ? 2 : 0;
+			if (b && !r.backend && !same_word(b, "auto")) std::fprintf(stderr, "[fg-vk] R2_FG_BACKEND=%s ignored (use auto, dlss or fsr3)\n", b);
+			r.hud = penv_int("DLSS_FG_HUD", 1) != 0;
+			r.hud_debug = penv_int("DLSS_FG_HUD_DEBUG", 0) != 0;
+			r.debug_level = penv_int("DLSS_FG_DEBUG", 0);
+			r.debug = r.debug_level != 0;
+			r.menu_off = penv_int("DLSS_FG_MENU_OFF", 1) != 0;
+			r.cap = penv_int("DLSS_FG_CAP", 1) != 0;
+			r.yflip = penv_int("DLSS_FG_YFLIP", 1) != 0;
+			return r;
+		}();
+		return c;
+	}
+}
+
+#if defined(_WIN32) && defined(R2PORT_HAVE_SL)
+
+// sl_pcl.h 2.14.16 has 'using to_underlying = std::to_underlying;' under C++23, which is not valid C++; let the
+// headers take their C++20 branch (their own to_underlying template) and restore the value afterwards.
+#pragma clang diagnostic push
+#pragma clang diagnostic ignored "-Wbuiltin-macro-redefined"
+#if __cplusplus > 202002L
+#undef __cplusplus
+#define __cplusplus 202002L
+#define R2FG_RESTORE_CPLUSPLUS 1
+#endif
+#include "sl.h"
+#include "sl_dlss_g.h"
+#include "sl_reflex.h"
+#include "sl_pcl.h"
+#ifdef R2FG_RESTORE_CPLUSPLUS
+#undef __cplusplus
+#define __cplusplus 202302L
+#endif
+#pragma clang diagnostic pop
+
+#ifdef R2PORT_HAVE_FFX
+#include "ffx_api/ffx_api.h"
+#include "ffx_api/ffx_framegeneration.h"
+#include "ffx_api/vk/ffx_api_vk.h"
+#include <chrono>
+#include <cstddef>
+#include <thread>
+
+// The FSR 3 frame-generation descriptors are passed by pointer into amd_fidelityfx_vk.dll (FidelityFX API 1.1.4).
+// Their layouts, checked against the DLL's own headers, must not drift.
