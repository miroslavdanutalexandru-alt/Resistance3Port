+
+		// VkWriteDescriptorSet arrays (push descriptors, vkUpdateDescriptorSets)
+		enum class wkind { image, buffer, texel, unsupported };
+		wkind write_kind(VkDescriptorType t)
+		{
+			switch (t)
+			{
+			case VK_DESCRIPTOR_TYPE_SAMPLER:
+			case VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER:
+			case VK_DESCRIPTOR_TYPE_SAMPLED_IMAGE:
+			case VK_DESCRIPTOR_TYPE_STORAGE_IMAGE:
+			case VK_DESCRIPTOR_TYPE_INPUT_ATTACHMENT:
+				return wkind::image;
+			case VK_DESCRIPTOR_TYPE_UNIFORM_BUFFER:
+			case VK_DESCRIPTOR_TYPE_STORAGE_BUFFER:
+			case VK_DESCRIPTOR_TYPE_UNIFORM_BUFFER_DYNAMIC:
+			case VK_DESCRIPTOR_TYPE_STORAGE_BUFFER_DYNAMIC:
+				return wkind::buffer;
+			case VK_DESCRIPTOR_TYPE_UNIFORM_TEXEL_BUFFER:
+			case VK_DESCRIPTOR_TYPE_STORAGE_TEXEL_BUFFER:
+				return wkind::texel;
+			default:
+				return wkind::unsupported;
+			}
+		}
+
+		// Size of the deep copy, or SIZE_MAX when the writes cannot be captured
+		size_t writes_bytes(const VkWriteDescriptorSet* w, u32 n)
+		{
+			size_t sz = bytes(w, n);
+			for (u32 i = 0; i < n; i++)
+			{
+				if (w[i].pNext) return SIZE_MAX;
+				switch (write_kind(w[i].descriptorType))
+				{
+				case wkind::image: sz += bytes(w[i].pImageInfo, w[i].descriptorCount); break;
+				case wkind::buffer: sz += bytes(w[i].pBufferInfo, w[i].descriptorCount); break;
+				case wkind::texel: sz += bytes(w[i].pTexelBufferView, w[i].descriptorCount); break;
+				default: return SIZE_MAX;
+				}
+			}
+			return sz;
+		}
+
+		template <typename P>
+		VkWriteDescriptorSet* copy_writes(packet<P>& pk, const VkWriteDescriptorSet* w, u32 n)
+		{
+			VkWriteDescriptorSet* out = pk.copy(w, n);
+			for (u32 i = 0; i < n; i++)
+			{
+				VkWriteDescriptorSet& o = out[i];
+				const wkind k = write_kind(o.descriptorType);
+				o.pImageInfo = k == wkind::image ? pk.copy(w[i].pImageInfo, w[i].descriptorCount) : nullptr;
+				o.pBufferInfo = k == wkind::buffer ? pk.copy(w[i].pBufferInfo, w[i].descriptorCount) : nullptr;
+				o.pTexelBufferView = k == wkind::texel ? pk.copy(w[i].pTexelBufferView, w[i].descriptorCount) : nullptr;
+			}
+			return out;
+		}
+
+		// VkDependencyInfo (synchronization2)
+		bool dep_ok(const VkDependencyInfo& d)
+		{
+			return !d.pNext && chain_free(d.pMemoryBarriers, d.memoryBarrierCount) &&
+				chain_free(d.pBufferMemoryBarriers, d.bufferMemoryBarrierCount) && chain_free(d.pImageMemoryBarriers, d.imageMemoryBarrierCount);
+		}
+		size_t dep_bytes(const VkDependencyInfo& d)
+		{
+			return bytes(d.pMemoryBarriers, d.memoryBarrierCount) + bytes(d.pBufferMemoryBarriers, d.bufferMemoryBarrierCount) +
+				bytes(d.pImageMemoryBarriers, d.imageMemoryBarrierCount);
+		}
+		template <typename P>
+		void dep_copy(packet<P>& pk, VkDependencyInfo& o, const VkDependencyInfo& d)
+		{
+			o = d;
+			o.pMemoryBarriers = pk.copy(d.pMemoryBarriers, d.memoryBarrierCount);
+			o.pBufferMemoryBarriers = pk.copy(d.pBufferMemoryBarriers, d.bufferMemoryBarrierCount);
+			o.pImageMemoryBarriers = pk.copy(d.pImageMemoryBarriers, d.imageMemoryBarrierCount);
+		}
+
+		int env_int(const char* name, int def)
+		{
+			const char* v = std::getenv(name);
+			return (v && *v) ? std::atoi(v) : def;
+		}
+	}
+
+	void sync_slow(reason r)
+	{
+		if (!g.running)
+		{
+			return;
+		}
+		if (t_defer)
+		{
+			publish_now(); // the producer: its batched packets are part of this drain
+		}
+		const u64 target = g.head.load(std::memory_order_acquire);
+		if (g.tail.load(std::memory_order_acquire) >= target)
+		{
+			return;
+		}
+		g.drains[static_cast<size_t>(r)].fetch_add(1, std::memory_order_relaxed);
+		if (!t_defer && r != reason::foreign && r != reason::flip)
+		{
+			g.other_drains.fetch_add(1, std::memory_order_relaxed);
+		}
+		const u64 t0 = now_ns();
+		if (g_mode == 2)
+		{
+			std::lock_guard lock(g.replay_mtx);
+			replay_pending();
+		}
+		else
+		{
+			wake_if_sleeping(); // packets published by a plain store may have arrived after the record thread slept
+			wait_for_tail(target);
+		}
+		g.drain_wait_ns.fetch_add(now_ns() - t0, std::memory_order_relaxed);
+	}
+
+	void start()
+	{
+		if (g.running)
+		{
+			t_defer = true;
+			return;
+		}
+		const int mode = env_int("RSX_RECORD_THREAD", 0);
+		if (mode != 1 && mode != 2)
+		{
+			return;
+		}
+		int mb = env_int("RSX_RECORD_RING_MB", 16);
+		mb = mb < 2 ? 2 : (mb > 256 ? 256 : mb);
+		u64 size = 1;
+		while (size < static_cast<u64>(mb) << 20) size <<= 1;
+
+		if (g.mem && g.size != size)
+		{
+			size = g.size; // a renderer reset keeps the first ring
+		}
+		if (!g.mem)
+		{
+#ifdef _WIN32
+			g.mem = static_cast<u8*>(VirtualAlloc(nullptr, size, MEM_COMMIT | MEM_RESERVE, PAGE_READWRITE));
+#else
+			g.mem = static_cast<u8*>(std::aligned_alloc(4096, size));
+#endif
+		}
+		if (!g.mem)
+		{
+			std::fprintf(stderr, "[rec] RSX_RECORD_THREAD: ring allocation failed, recording stays on the rsx thread\n");
+			return;
+		}
+		g.size = size;
+		g.mask = size - 1;
+		g.local_head = 0;
+		g.pub_head = 0;
+		g.cached_tail = 0;
+		g.pub_bytes = static_cast<u64>(std::max(0, env_int("RSX_RECORD_PUB_BYTES", 2048)));
+		g.head.store(0);
+		g.tail.store(0);
+		g.quit.store(false);
+		g.spin_us = env_int("RSX_RECORD_SPIN_US", 250);
+		g.stats = env_int("RSX_RECORD_STATS", 1) != 0;
+		g.win_t0 = now_ns();
+		g.running = true;
+		g_mode = mode;
+		if (mode == 1)
+		{
+			g.thr = std::thread(record_thread_main);
+		}
+		t_defer = true;
+		std::fprintf(stderr, "[rec] RSX_RECORD_THREAD=%d (%s): ring %llu MB, spin %d us\n", mode,
+			mode == 1 ? "record thread" : "validation, same-thread replay", static_cast<unsigned long long>(size >> 20), g.spin_us);
+	}
+
+	void stop()
+	{
+		if (!g.running)
+		{
+			return;
+		}
+		sync_slow(reason::shutdown);
+		g_mode = 0;
+		t_defer = false;
+		if (g.thr.joinable())
+		{
+			g.quit.store(true, std::memory_order_seq_cst);
+			g.wake_seq.fetch_add(1, std::memory_order_seq_cst);
+			g.wake_seq.notify_all();
+			g.thr.join();
+		}
+		g.running = false;
+		// The ring stays allocated: a late caller on another thread may still read g.head/g.tail
+	}
+
+	void on_flip()
+	{
+		micro_on_flip();
+		if (!g.running || !g.stats)
+		{
+			return;
+		}
+		g.win_frames++;
+		const u64 t = now_ns();
+		const u64 dt = t - g.win_t0;
+		if (dt < 5'000'000'000ull)
+		{
+			return;
+		}
+
+		auto take = [](std::atomic<u64>& v, u64& last) { const u64 c = v.load(std::memory_order_relaxed); const u64 d = c - last; last = c; return d; };
+		auto take_p = [](u64 c, u64& last) { const u64 d = c - last; last = c; return d; };
+		const double f = static_cast<double>(g.win_frames ? g.win_frames : 1);
+		const u64 pk = take_p(g.p_packets, g.last_packets);
+		const u64 by = take_p(g.p_bytes, g.last_bytes);
+		const u64 pubs = take_p(g.p_publishes, g.last_publishes);
+		const u64 busy = take(g.busy_ns, g.last_busy);
+		const u64 wait = take(g.drain_wait_ns, g.last_wait);
+		const u64 st = take(g.stalls, g.last_stalls);
+		const u64 stn = take(g.stall_ns, g.last_stall_ns);
+		const u64 fb = take(g.fallbacks, g.last_fallbacks);
+		const u64 oth = take(g.other_drains, g.last_other);
+
+		char reasons[512];
+		size_t len = 0;
+		u64 total_drains = 0;
+		reasons[0] = 0;
+		for (size_t i = 0; i < static_cast<size_t>(reason::count); i++)
+		{
+			const u64 d = take(g.drains[i], g.last_drains[i]);
+			total_drains += d;
+			if (d && len < sizeof(reasons) - 40)
+			{
+				len += std::snprintf(reasons + len, sizeof(reasons) - len, " %s=%.1f", c_reason_names[i], d / f);
+			}
+		}
+
+		std::fprintf(stderr,
+			"[rec] mode=%d %.1f fps | packets/f=%.0f KB/f=%.0f publishes/f=%.0f (pub_bytes %llu) | %s ms/f=%.2f busy=%.0f%% | drains/f=%.1f wait ms/f=%.2f (other-thread %llu) |"
+			" stalls=%llu (%.1f ms) fallbacks=%llu | per frame:%s\n",
+			g_mode, f * 1e9 / dt, pk / f, by / f / 1024.0, pubs / f, static_cast<unsigned long long>(g.pub_bytes), g_mode == 1 ? "record" : "replay", busy / f / 1e6, 100.0 * busy / dt,
+			total_drains / f, wait / f / 1e6, static_cast<unsigned long long>(oth), static_cast<unsigned long long>(st), stn / 1e6,
+			static_cast<unsigned long long>(fb), reasons);
+		g.win_t0 = t;
+		g.win_frames = 0;
+	}
