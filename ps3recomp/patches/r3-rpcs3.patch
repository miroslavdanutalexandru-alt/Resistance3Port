+				"		else if (opts2.x > 0.5)\n"
+				"		{\n"
+				"			ivec2 ip = ivec2(floor((q.xy / q.w + unpackHalf2x16(floatBitsToUint(opts3.w)) + 1.0) * 0.5 * view.zw));\n"
+				"			ivec2 lim = ivec2(opts.zw) - 1;\n"
+				"			if (all(greaterThanEqual(ip, ivec2(0))) && all(lessThanEqual(ip, lim)))\n"
+				"			{\n"
+				"				float lo = 1e30, hi = -1e30;\n"
+				"				for (int y = -1; y <= 1; ++y)\n"
+				"					for (int x = -1; x <= 1; ++x)\n"
+				"					{\n"
+				"						float l = lin(texelFetch(PrevDepthIn, clamp(ip + ivec2(x, y), ivec2(0), lim), 0).r);\n"
+				"						lo = min(lo, l); hi = max(hi, l);\n"
+				"					}\n"
+				"				float lc = lin(((q.z / q.w) - opts.y) / opts.x);\n"
