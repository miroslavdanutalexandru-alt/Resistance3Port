@@ -0,0 +1,469 @@
+#pragma once
+
+// R3PORT texture-source diagnostics (opt-in; nothing runs and nothing changes when the switches are unset).
+//
+//  RSX_DEBUG_TEX_SRC=1      classify every bound fragment texture per draw (CPU upload / blit section / render target /
+//                           render-target copy / other deferred op) and log the first sighting of every texture whose
+//                           surface source does not match what the draw asked for:
+//                             FMT    the surface's format differs from the requested gcm format
+//                             BPP    ... with a different texel size (reinterpreted bytes: stripes / noise)
+//                             DEPTH  a depth surface sampled with a colour format
+//                             SWZ    a swizzled texture served by a (linear) surface
+//                             SIZE   the texture's byte range runs past the surface it was taken from
+//                             OVER   a CPU upload whose bytes overlap a live render target / depth surface
+//                                    (the guest memory under a GPU-written surface may be stale)
+//                           =2 additionally logs every new texture key (address catalogue), flagged or not.
+//                           [texsrc] lines on stderr (run.log); a [texsrc] summary every 2 s.
+//  RSX_DEBUG_TEX_SRC_LINES  cap on logged texture lines (default 3000; also max 40 per second).
+//  RSX_DEBUG_TINT_SURFACE   bit mask; a draw with a matching texture gets every fragment texture replaced by solid green
+//                           (1 = FMT/BPP, 2 = DEPTH, 4 = any surface source (RT, RT copy, blit), 8 = OVER, 16 = OVER on
+//                           textures of at most 64x64). SWZ and SIZE are log-only: SIZE flags every post pass that reads a
+//                           resolution-scaled target. 2 also hits full-screen depth-as-colour post passes.
+//                           Depth-format views get a same-format depth image cleared to 1.0 instead (flat colour, not
+//                           necessarily green); MSAA textures are never replaced. OVER is re-tested on every bind.
+//                           "1" = format mismatch only. Implies the classifier (no log lines unless RSX_DEBUG_TEX_SRC).
+//  RSX_DEBUG_TINT_ADDR      comma-separated texture addresses (hex), tinted green whatever their source.
+
+#include "VKResourceManager.h"
+#include "../Common/TextureUtils.h"
+#include "../Program/ProgramStateCache.h"
+
+#include <atomic>
+#include <chrono>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <unordered_map>
+#include <vector>
+
+namespace r3texsrc
+{
+	enum cls : u32 { c_upload, c_blit, c_rt, c_rt_copy, c_deferred, c_count };
+	enum flag : u32 { f_fmt = 1, f_bpp = 2, f_depth = 4, f_swz = 8, f_size = 16, f_over = 32, f_surface = 64 };
+
+	struct config
+	{
+		int src = 0;              // RSX_DEBUG_TEX_SRC
+		u32 tint = 0;             // RSX_DEBUG_TINT_SURFACE
+		u32 max_lines = 3000;     // RSX_DEBUG_TEX_SRC_LINES
+		std::vector<u32> tint_addr; // RSX_DEBUG_TINT_ADDR
+		bool on = false;
+	};
+
+	static inline const config& cfg()
+	{
+		static const config c = []
+		{
+			config r;
+			if (const char* e = std::getenv("RSX_DEBUG_TEX_SRC"); e && *e) r.src = std::atoi(e);
+			if (const char* e = std::getenv("RSX_DEBUG_TINT_SURFACE"); e && *e) r.tint = static_cast<u32>(std::strtoul(e, nullptr, 0));
+			if (const char* e = std::getenv("RSX_DEBUG_TEX_SRC_LINES"); e && *e) r.max_lines = static_cast<u32>(std::strtoul(e, nullptr, 0));
+			if (const char* e = std::getenv("RSX_DEBUG_TINT_ADDR"); e && *e)
+			{
+				for (const char* p = e; *p;)
+				{
+					char* end = nullptr;
+					const unsigned long v = std::strtoul(p, &end, 16);
+					if (end == p) { ++p; continue; }
+					r.tint_addr.push_back(static_cast<u32>(v));
+					p = end;
+				}
+			}
+			r.on = r.src > 0 || r.tint != 0 || !r.tint_addr.empty();
+			if (r.on)
+			{
+				std::fprintf(stderr, "[texsrc] RSX_DEBUG_TEX_SRC=%d RSX_DEBUG_TINT_SURFACE=0x%x (1 fmt/bpp, 2 depth-as-colour, 4 any surface, 8 upload over RT, 16 upload over RT <= 64px) tint addrs %u, line cap %u\n",
+					r.src, r.tint, static_cast<u32>(r.tint_addr.size()), r.max_lines);
+			}
+			return r;
+		}();
+		return c;
+	}
+
+	static inline bool on() { return cfg().on; }
+
+	struct state_t
+	{
+		std::unordered_map<u64, u32> seen; // texture key -> flags (bit 31: logged)
+		u64 binds[c_count]{};
+		u64 flagged[7]{};
+		u64 tinted = 0, draws = 0, new_keys = 0;
+		u32 lines = 0, lines_sec = 0, suppressed = 0;
+		u64 t_last = 0, t_sec = 0;
+	};
+
+	static inline state_t& st()
+	{
+		static state_t s;
+		return s;
+	}
+
+	static inline u64 now_ms()
+	{
+		return static_cast<u64>(std::chrono::duration_cast<std::chrono::milliseconds>(std::chrono::steady_clock::now().time_since_epoch()).count());
+	}
+
+	static inline u64 mix(u64 h, u64 v)
+	{
+		h ^= v + 0x9E3779B97F4A7C15ull + (h << 6) + (h >> 2);
+		return h * 0xFF51AFD7ED558CCDull;
+	}
+
+	static inline u32 norm_gcm(u32 f)
+	{
+		switch (f)
+		{
+		case CELL_GCM_TEXTURE_D8R8G8B8: return CELL_GCM_TEXTURE_A8R8G8B8;
+		case CELL_GCM_TEXTURE_DEPTH24_D8_FLOAT: return CELL_GCM_TEXTURE_DEPTH24_D8;
+		case CELL_GCM_TEXTURE_DEPTH16_FLOAT: return CELL_GCM_TEXTURE_DEPTH16;
+		default: return f;
+		}
+	}
+
+	static inline bool is_depth_gcm(u32 f)
+	{
+		switch (f)
+		{
+		case CELL_GCM_TEXTURE_DEPTH16:
+		case CELL_GCM_TEXTURE_DEPTH16_FLOAT:
+		case CELL_GCM_TEXTURE_DEPTH24_D8:
+		case CELL_GCM_TEXTURE_DEPTH24_D8_FLOAT:
+			return true;
+		default:
+			return false;
+		}
+	}
+
+	// VKTextureCache.cpp render_target_format_is_compatible, as a 3-state answer (-1: no rule for this gcm format)
+	static inline int vk_format_ok(VkFormat vf, u32 gcm)
+	{
+		switch (gcm)
+		{
+		case CELL_GCM_TEXTURE_R5G6B5: return vf == VK_FORMAT_R5G6B5_UNORM_PACK16;
+		case CELL_GCM_TEXTURE_W16_Z16_Y16_X16_FLOAT: return vf == VK_FORMAT_R16G16B16A16_SFLOAT;
+		case CELL_GCM_TEXTURE_W32_Z32_Y32_X32_FLOAT: return vf == VK_FORMAT_R32G32B32A32_SFLOAT;
+		case CELL_GCM_TEXTURE_X32_FLOAT: return vf == VK_FORMAT_R32_SFLOAT;
+		case CELL_GCM_TEXTURE_A8R8G8B8:
+		case CELL_GCM_TEXTURE_D8R8G8B8: return vf == VK_FORMAT_B8G8R8A8_UNORM || vf == VK_FORMAT_R8G8B8A8_UNORM;
+		case CELL_GCM_TEXTURE_B8: return vf == VK_FORMAT_R8_UNORM;
+		case CELL_GCM_TEXTURE_G8B8: return vf == VK_FORMAT_R8G8_UNORM;
+		case CELL_GCM_TEXTURE_DEPTH24_D8:
+		case CELL_GCM_TEXTURE_DEPTH24_D8_FLOAT: return vf == VK_FORMAT_D24_UNORM_S8_UINT || vf == VK_FORMAT_D32_SFLOAT_S8_UINT;
+		case CELL_GCM_TEXTURE_X16:
+		case CELL_GCM_TEXTURE_DEPTH16:
+		case CELL_GCM_TEXTURE_DEPTH16_FLOAT: return vf == VK_FORMAT_D16_UNORM || vf == VK_FORMAT_D32_SFLOAT;
+		default: return -1;
+		}
+	}
+
+	static inline const char* cls_name(u32 c)
+	{
+		static const char* n[] = { "upload", "blit", "rt", "rt-copy", "deferred" };
+		return c < c_count ? n[c] : "?";
+	}
+
+	static inline void flag_names(u32 f, char* out, usz cap)
+	{
+		out[0] = 0;
+		static const char* n[] = { "FMT", "BPP", "DEPTH", "SWZ", "SIZE", "OVER", "SURF" };
+		for (u32 b = 0; b < 7; ++b)
+		{
+			if (f & (1u << b))
+			{
+				if (out[0]) std::strncat(out, "|", cap - std::strlen(out) - 1);
+				std::strncat(out, n[b], cap - std::strlen(out) - 1);
+			}
+		}
+		if (!out[0]) std::strncat(out, "-", cap - 1);
+	}
+
+	static inline bool may_log()
+	{
+		auto& s = st();
+		const u64 t = now_ms();
+		if (t - s.t_sec >= 1000) { s.t_sec = t; s.lines_sec = 0; }
+		if (s.lines >= cfg().max_lines || s.lines_sec >= 40) { s.suppressed++; return false; }
+		s.lines++; s.lines_sec++;
+		return true;
+	}
+
+	static inline void summary()
+	{
+		auto& s = st();
+		const u64 t = now_ms();
+		if (!s.t_last) { s.t_last = t; return; }
+		if (t - s.t_last < 2000) return;
+		std::fprintf(stderr, "[texsrc] %.1fs: draws %llu | binds upload %llu blit %llu rt %llu rt-copy %llu deferred %llu | flagged binds FMT %llu BPP %llu DEPTH %llu SWZ %llu SIZE %llu OVER %llu | tinted draws %llu | new keys %llu, lines %u (suppressed %u)\n",
+			(t - s.t_last) / 1000.0, static_cast<unsigned long long>(s.draws),
+			static_cast<unsigned long long>(s.binds[c_upload]), static_cast<unsigned long long>(s.binds[c_blit]),
+			static_cast<unsigned long long>(s.binds[c_rt]), static_cast<unsigned long long>(s.binds[c_rt_copy]),
+			static_cast<unsigned long long>(s.binds[c_deferred]),
+			static_cast<unsigned long long>(s.flagged[0]), static_cast<unsigned long long>(s.flagged[1]),
+			static_cast<unsigned long long>(s.flagged[2]), static_cast<unsigned long long>(s.flagged[3]),
+			static_cast<unsigned long long>(s.flagged[4]), static_cast<unsigned long long>(s.flagged[5]),
+			static_cast<unsigned long long>(s.tinted), static_cast<unsigned long long>(s.new_keys), s.lines, s.suppressed);
+		s.t_last = t;
+		s.draws = s.tinted = s.new_keys = 0;
+		std::memset(s.binds, 0, sizeof(s.binds));
+		std::memset(s.flagged, 0, sizeof(s.flagged));
+	}
+
+	// Classifies the draw's fragment textures; returns true when the draw is to be tinted.
+	// get(i) -> vk::texture_cache::sampled_image_descriptor* for TIU i.
+	template <typename GetDesc, typename SurfaceStore>
+	bool scan_draw(rsx::context* ctx, GetDesc&& get, SurfaceStore& rtts)
+	{
+		const auto& c = cfg();
+		auto& s = st();
+		s.draws++;
+		bool tint = false;
+		usz fp_hash = 0;
+
+		for (u32 mask = ctx->program.fp_metadata.referenced_textures_mask, i = 0; mask; mask >>= 1, ++i)
+		{
+			if (!(mask & 1))
+			{
+				continue;
+			}
+
+			const auto& tex = REGS(ctx)->fragment_textures[i];
+			auto* d = get(i);
+			if (!d || !tex.enabled() || !d->validate())
+			{
+				continue;
+			}
+
+			const u32 address = rsx::get_address(ctx, tex.offset(), tex.location());
+			if (!c.tint_addr.empty())
+			{
+				for (u32 a : c.tint_addr)
+				{
+					if (a == address) tint = true;
+				}
+			}
+
+			const u32 raw_fmt = tex.format();
+			const u32 gcm = raw_fmt & ~(CELL_GCM_TEXTURE_LN | CELL_GCM_TEXTURE_UN);
+			const bool swizzled = !(raw_fmt & CELL_GCM_TEXTURE_LN);
+			vk::image* img = d->image_handle ? d->image_handle->image() : d->external_subresource_desc.src0();
+			vk::render_target* rtt = img ? vk::try_as_rtt(img) : nullptr;
+			const auto op = d->external_subresource_desc.op;
+
+			u32 kind;
+			if (d->image_handle)
+			{
+				kind = rtt ? c_rt :
+					(d->upload_context == rsx::texture_upload_context::blit_engine_src || d->upload_context == rsx::texture_upload_context::blit_engine_dst) ? c_blit : c_upload;
+			}
+			else
+			{
+				kind = rtt ? c_rt_copy : c_deferred;
+			}
+			s.binds[kind]++;
+
+			u64 key = mix(mix(mix(0, address), (u64{raw_fmt} << 32) | (u32{tex.width()} << 16) | tex.height()),
+				(u64{tex.pitch()} << 32) | (u64{tex.depth()} << 8) | kind);
+			key = mix(mix(key, reinterpret_cast<uintptr_t>(img)), static_cast<u64>(op) | (static_cast<u64>(d->upload_context) << 8));
+
+			// Map value: bits 0..15 = flags, bits 16..23 = flags already reported in a log line.
+			u32 flags = 0, logged_flags = 0;
+			bool fresh = false;
+			auto it = s.seen.find(key);
+			if (it != s.seen.end())
+			{
+				flags = it->second & 0xffffu;
+				logged_flags = (it->second >> 16) & 0xffu;
+			}
+			else
+			{
+				fresh = true;
+				s.new_keys++;
+				if (s.seen.size() > 262144) s.seen.clear();
+
+				const u32 tex_len = static_cast<u32>(std::max<usz>(rsx::get_texture_size(tex), 1));
+				const auto range = utils::address_range32::start_length(address, tex_len);
+				if (rtt)
+				{
+					flags |= f_surface;
+					const u32 surf_gcm = rtt->get_gcm_format();
+					if (rtt->is_depth_surface())
+					{
+						if (!is_depth_gcm(gcm)) flags |= f_depth;
+						else if (norm_gcm(gcm) != norm_gcm(surf_gcm)) flags |= f_fmt;
+					}
+					else if (is_depth_gcm(gcm) || norm_gcm(gcm) != norm_gcm(surf_gcm))
+					{
+						flags |= f_fmt;
+					}
+
+					if (!rsx::texture_cache_helpers::is_compressed_gcm_format(gcm) &&
+						rsx::get_format_block_size_in_bytes(gcm) != rtt->get_bpp())
+					{
+						flags |= f_bpp;
+					}
+
+					if (swizzled && tex.height() > 1 && tex.width() > 1) flags |= f_swz;
+					const auto srange = rtt->get_memory_range();
+					if (range.end > srange.end && rtt->base_addr <= address) flags |= f_size;
+				}
+				else if (kind == c_blit || kind == c_deferred)
+				{
+					flags |= f_surface;
+					if (img && vk_format_ok(img->format(), gcm) == 0) flags |= f_fmt;
+				}
+			}
+
+			// OVER depends on the surface store, which changes every frame while the key does not: re-test every bind.
+			if (kind == c_upload && (c.src > 0 || (c.tint & (8 | 16))))
+			{
+				const u32 tex_len = static_cast<u32>(std::max<usz>(rsx::get_texture_size(tex), 1));
+				u32 nc = 0, nd = 0;
+				if (rtts.r3_find_overlap(utils::address_range32::start_length(address, tex_len), nc, nd)) flags |= f_over;
+				else flags &= ~f_over;
+			}
+
+			for (u32 b = 0; b < 6; ++b)
+			{
+				if (flags & (1u << b)) s.flagged[b]++;
+			}
+
+			if (((c.tint & 1) && (flags & (f_fmt | f_bpp))) ||
+				((c.tint & 2) && (flags & f_depth)) ||
+				((c.tint & 4) && (flags & f_surface)) ||
+				((c.tint & 8) && (flags & f_over)) ||
+				((c.tint & 16) && (flags & f_over) && tex.width() <= 64 && tex.height() <= 64))
+			{
+				tint = true;
+			}
+
+			const u32 new_bad = flags & ~f_surface & ~logged_flags;
+			if (c.src > 0 && (new_bad || (fresh && c.src >= 2)) && may_log())
+			{
+				logged_flags |= flags & 0xffu;
+				if (!fp_hash) fp_hash = program_hash_util::fragment_program_utils::get_fragment_program_ucode_hash(ctx->program.fragment_program);
+
+				char fl[64];
+				flag_names(flags, fl, sizeof(fl));
+				char surf[256] = "";
+				if (rtt)
+				{
+					const auto srange = rtt->get_memory_range();
+					std::snprintf(surf, sizeof(surf), " | surface 0x%08x..0x%08x %s fmt %u (gcm 0x%02x) vk %u %ux%u pitch %u bpp %u aa %u scale %u%% %s at +0x%x",
+						srange.start, srange.end, rtt->is_depth_surface() ? "depth" : "colour",
+						rtt->is_depth_surface() ? static_cast<u32>(rtt->get_surface_depth_format()) : static_cast<u32>(rtt->get_surface_color_format()),
+						rtt->get_gcm_format(), static_cast<u32>(rtt->format()), rtt->template get_surface_width<rsx::surface_metrics::pixels>(),
+						rtt->template get_surface_height<rsx::surface_metrics::pixels>(), rtt->get_rsx_pitch(), rtt->get_bpp(),
+						rtt->samples(), static_cast<u32>(rtt->resolution_scaling_config.scale_percent),
+						rtt->dirty() ? "dirty" : "clean", address >= rtt->base_addr ? address - rtt->base_addr : 0u);
+				}
+				else if (img)
+				{
+					std::snprintf(surf, sizeof(surf), " | image vk %u %ux%ux%u", static_cast<u32>(img->format()), img->width(), img->height(), img->depth());
+				}
+
+				if (flags & f_over)
+				{
+					const u32 tex_len = static_cast<u32>(std::max<usz>(rsx::get_texture_size(tex), 1));
+					u32 nc = 0, nd = 0;
+					if (auto* o = rtts.r3_find_overlap(utils::address_range32::start_length(address, tex_len), nc, nd))
+					{
+						const auto orange = o->get_memory_range();
+						const usz len = std::strlen(surf);
+						std::snprintf(surf + len, sizeof(surf) - len, " | overlaps %s surface 0x%08x..0x%08x %ux%u pitch %u gcm 0x%02x %s (%u colour, %u depth)",
+							o->is_depth_surface() ? "depth" : "colour", orange.start, orange.end,
+							o->template get_surface_width<rsx::surface_metrics::pixels>(), o->template get_surface_height<rsx::surface_metrics::pixels>(),
+							o->get_rsx_pitch(), o->get_gcm_format(), o->dirty() ? "dirty" : "clean", nc, nd);
+					}
+				}
+
+				const u32 rt0 = rtts.m_bound_render_targets[0].first;
+				std::fprintf(stderr, "[texsrc] %s tiu %u addr 0x%08x gcm 0x%02x %s %ux%ux%u pitch %u mips %u dim %u | src %s ctx %u op %u%s | fp %016llx rt0 0x%08x zeta 0x%08x\n",
+					fl, i, address, gcm, swizzled ? "swz" : "lin", tex.width(), tex.height(), tex.depth(), tex.pitch(),
+					tex.get_exact_mipmap_count(), static_cast<u32>(tex.get_extended_texture_dimension()),
+					cls_name(kind), static_cast<u32>(d->upload_context), static_cast<u32>(op), surf,
+					static_cast<unsigned long long>(fp_hash), rt0, rtts.m_bound_depth_stencil.first);
+			}
+
+			const u32 value = (flags & 0xffffu) | ((logged_flags & 0xffu) << 16);
+			if (fresh)
+			{
+				s.seen.emplace(key, value);
+			}
+			else
+			{
+				it->second = value;
+			}
+		}
+
+		summary();
+		return tint;
+	}
+
+	// Counts draws that really had at least one texture replaced (scan_draw only decides; MSAA binds etc. are skipped).
+	static inline void note_tinted() { st().tinted++; }
+
+	// Placeholder bound instead of a tinted texture. Colour views get solid green (B8G8R8A8 0,1,0,1). Depth views (depth
+	// sources sampled through the depth decode or as shadow maps) get an image of the same depth/stencil format cleared to
+	// depth 1.0 / stencil 0, so the shader's descriptor type and decode stay valid: the chunk shows a flat constant colour
+	// instead of its texture (not necessarily green). nullptr when no safe placeholder exists (3D/1D depth).
+	// Never freed (diagnostic only); rebuilt for a new device.
+	static inline vk::image_view* green_view(const vk::command_buffer& cmd, VkImageViewType type, VkFormat view_format = VK_FORMAT_B8G8R8A8_UNORM)
+	{
+		static const vk::render_device* dev = nullptr;
+		static std::unordered_map<u64, vk::viewable_image*> images;
+		const auto* cur = vk::get_current_renderer();
+		if (dev != cur)
+		{
+			images.clear();
+			dev = cur;
+		}
+
+		const VkImageAspectFlags aspect = vk::get_aspect_flags(view_format);
+		const bool depth = (aspect & (VK_IMAGE_ASPECT_DEPTH_BIT | VK_IMAGE_ASPECT_STENCIL_BIT)) != 0;
+		const VkFormat format = depth ? view_format : VK_FORMAT_B8G8R8A8_UNORM;
+		if (depth && type != VK_IMAGE_VIEW_TYPE_2D && type != VK_IMAGE_VIEW_TYPE_2D_ARRAY && type != VK_IMAGE_VIEW_TYPE_CUBE)
+		{
+			return nullptr;
+		}
+
+		const u64 key = (u64{static_cast<u32>(format)} << 32) | static_cast<u32>(type);
+		if (auto it = images.find(key); it != images.end())
+		{
+			return it->second->get_view(rsx::default_remap_vector.with_encoding(vk::VK_REMAP_IDENTITY));
+		}
+
+		VkImageType image_type = VK_IMAGE_TYPE_2D;
+		u32 layers = 1, flags = 0;
+		switch (type)
+		{
+		case VK_IMAGE_VIEW_TYPE_1D: image_type = VK_IMAGE_TYPE_1D; break;
+		case VK_IMAGE_VIEW_TYPE_3D: image_type = VK_IMAGE_TYPE_3D; break;
+		case VK_IMAGE_VIEW_TYPE_CUBE: layers = 6; flags = VK_IMAGE_CREATE_CUBE_COMPATIBLE_BIT; break;
+		case VK_IMAGE_VIEW_TYPE_2D_ARRAY: layers = 2; break;
+		default: break;
+		}
+
+		auto* img = new vk::viewable_image(*cur, cur->get_memory_mapping().device_local, VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT,
+			image_type, format, 1, 1, 1, 1, layers, VK_SAMPLE_COUNT_1_BIT, VK_IMAGE_LAYOUT_UNDEFINED,
+			VK_IMAGE_TILING_OPTIMAL, VK_IMAGE_USAGE_TRANSFER_DST_BIT | VK_IMAGE_USAGE_SAMPLED_BIT, flags, vk::VMM_ALLOCATION_POOL_SCRATCH);
+
+		img->change_layout(cmd, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL);
+		const VkImageSubresourceRange range = { depth ? aspect : VkImageAspectFlags{VK_IMAGE_ASPECT_COLOR_BIT}, 0, 1, 0, layers };
+		if (depth)
+		{
+			const VkClearDepthStencilValue clear = { 1.f, 0 };
+			vkCmdClearDepthStencilImage(cmd, img->value, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, &clear, 1, &range);
+		}
+		else
+		{
+			VkClearColorValue green = {};
+			green.float32[1] = 1.f;
+			green.float32[3] = 1.f;
+			vkCmdClearColorImage(cmd, img->value, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, &green, 1, &range);
+		}
+		img->change_layout(cmd, VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL);
+
+		images[key] = img;
+		return img->get_view(rsx::default_remap_vector.with_encoding(vk::VK_REMAP_IDENTITY));
+	}
+}
diff --git a/rpcs3/Emu/RSX/VK/VKRecordThread.cpp b/rpcs3/Emu/RSX/VK/VKRecordThread.cpp
