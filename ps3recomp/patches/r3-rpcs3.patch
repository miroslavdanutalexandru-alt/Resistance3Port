new file mode 100644
index 0000000..9a29d36
--- /dev/null
+++ b/rpcs3/Emu/RSX/VK/VKR3DofGpu.cpp
@@ -0,0 +1,462 @@
+// R3PORT R3_DOF_GPU (default on; host side and env in project\r3_native_dof.c): the "PC fast" aim-down-sights blur on the GPU.
+//
+// With R3_DOF_GPU_APPROX=1 the host skips SPU job 419 (the ADS depth of field) and computes a close approximation of its
+// output on the CPU: that needs the light buffer at 0x30030000 (the game typeless-blits the post colour and depth into this
+// FP16 surface) read back to guest memory (~4.3 ms) and a CPU blur (~1.8 ms). With R3_DOF_GPU the host only posts a request
+// (frame serial, image size, depth column, the job's CoC parameters) before its sync-line and label-77 writes; when the
+// composite then samples the region as ARGB8, the texture cache calls r3_dof_gpu_serve: the rows of the light-buffer
+// surface(s) the readback would pick are copied raw into a buffer, four compute passes (VKR3DofGpuGlsl.h, same arithmetic
+// as r3dof_fast_run) produce the job's output, and it is copied into an image served as a framebuffer_storage descriptor.
+// Guest memory is not touched: the light buffer stays a normal flushable surface (the CPU never reads the job output).
+//
+// Logs: "[dof-gpu] RSX: ..." on the first frame and every 600 frames (record cost on the RSX thread, GPU time from timestamps),
+// the one-time comparison against the CPU path's output for the same frame (PSNR of RGB, exact CoC bytes), and reasons it can't
+// serve a request (the host then falls back to the CPU path).
+#include "stdafx.h"
+#include "Emu/RSX/VK/VKGSRenderTypes.hpp"
+#include "VKTextureCache.h"
+#include "VKCompute.h"
+#include "VKRenderPass.h"
+#include "VKRenderTargets.h"
+#include "VKResourceManager.h"
+#include "vkutils/buffer_object.h"
+#include "VKR3DofGpuGlsl.h"
+
+#include <chrono>
+#include <cmath>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <memory>
+#include <vector>
+
+// The host side (r3_native_dof.c). geom: w, h, depth byte column, check flag; par: the 12 r3dof_fast_params floats;
+// ref (check frames): the CPU path's output, w x h guest-order words. Builds without it link the defaults (never serves).
+extern "C" int r3_dof_gpu_request(uint32_t* serial, uint32_t* geom, float* par, const uint8_t** ref);
+extern "C" void r3_dof_gpu_result(uint32_t serial, int status, double a, double b);
+extern "C" int r3_dof_gpu_request_default(uint32_t*, uint32_t*, float*, const uint8_t**) { return 0; }
+extern "C" void r3_dof_gpu_result_default(uint32_t, int, double, double) {}
+#pragma comment(linker, "/alternatename:r3_dof_gpu_request=r3_dof_gpu_request_default")
+#pragma comment(linker, "/alternatename:r3_dof_gpu_result=r3_dof_gpu_result_default")
+// the host enables R3_DOF_GPU only while this backend's texture cache exists (no hook on other backends)
+extern "C" void r3_dof_gpu_set_ready(int ready);
+extern "C" void r3_dof_gpu_set_ready_default(int) {}
+#pragma comment(linker, "/alternatename:r3_dof_gpu_set_ready=r3_dof_gpu_set_ready_default")
+// 1 = the host no longer writes the CPU result to guest memory (check passed): a failure here has no fallback image
+extern "C" int r3_dof_gpu_trusted(void);
+extern "C" int r3_dof_gpu_trusted_default(void) { return 0; }
+#pragma comment(linker, "/alternatename:r3_dof_gpu_trusted=r3_dof_gpu_trusted_default")
+// R3_DOF_GUEST_GUARD: restores job 419's output lines in guest memory that were overwritten after its writer finished
+// (sudo view, size = the 352 x 8192 region, comp = the light buffer's draw tag: one composite); 1 = guest memory holds that output, decode it
+extern "C" int r3_dof_guest_guard(uint8_t* sudo, uint32_t size, uint64_t comp);
+extern "C" int r3_dof_guest_guard_default(uint8_t*, uint32_t, uint64_t) { return 0; }
+#pragma comment(linker, "/alternatename:r3_dof_guest_guard=r3_dof_guest_guard_default")
+
+namespace vk
+{
+	struct r3dof_gpu_task : compute_task
+	{
+		const vk::buffer* buf[4] = {};
+		u64 size[4] = {};
+
+		r3dof_gpu_task()
+		{
+			m_src = r3dof_gpu_rsx_glsl;
+			ssbo_count = 4;
+			use_push_constants = true;
+			push_constants_size = 16;
+			create();
+		}
+
+		void bind_resources(const vk::command_buffer&) override
+		{
+			for (u32 i = 0; i < 4; i++)
+			{
+				m_program->bind_uniform({ *buf[i], 0, size[i] }, 0, i);
+			}
+		}
+
+		void dispatch(const vk::command_buffer& cmd, u32 pass, u32 w, u32 h)
+		{
+			load_program(cmd);
+			const u32 pc[4] = { pass, 0, 0, 0 };
+			vkCmdPushConstants(cmd, m_program->layout(), VK_SHADER_STAGE_COMPUTE_BIT, 0, 16, pc);
+			vkCmdDispatch(cmd, (w + 7) / 8, (h + 7) / 8, 1);
+		}
+	};
+}
+
+namespace
+{
+	enum : u32 { DG_FAIL_SURFACE = 1, DG_FAIL_FORMAT, DG_FAIL_GEOM, DG_FAIL_TEXDIMS };
+
+	struct dofgpu_state
+	{
+		std::unique_ptr<vk::buffer> src, out, scr, par, rb;
+		std::unique_ptr<vk::viewable_image> img;
+		VkQueryPool qp = VK_NULL_HANDLE;
+		VkDevice dev = VK_NULL_HANDLE;
+		bool q_used[4] = {};
+		u32 q_next = 0;
+		double ts_period = 1.0;
+
+		u32 served = 0;                  // serial of the image currently in `img`
+		std::chrono::steady_clock::time_point served_t{};
+		const vk::render_target* rt = nullptr;
+		u64 rt_tag = 0, rt2_tag = 0;
+		u32 tw = 0, th = 0;
+
+		bool check_pending = false;
+		u32 check_serial = 0, check_w = 0, check_h = 0, check_tw = 0, check_frames = 0;
+		u64 check_eid = 0;
+		std::vector<u8> check_ref;
+
+		u64 frames = 0;
+		double rec_ms = 0, gpu_ms = 0;
+		u64 gpu_n = 0;
+		u32 fail_logged = 0;
+	};
+
+	dofgpu_state g_dg;
+
+	void dg_fail(u32 serial, u32 why, const char* text)
+	{
+		if (g_dg.fail_logged++ < 8)
+		{
+			std::fprintf(stderr, "[dof-gpu] RSX: frame serial 0x%X not served: %s\n", serial, text);
+			std::fflush(stderr);
+		}
+		r3_dof_gpu_result(serial, -static_cast<int>(why), 0, 0);
+	}
+
+	void dg_poll_timestamps()
+	{
+		if (!g_dg.qp) return;
+		for (u32 s = 0; s < 4; s++)
+		{
+			if (!g_dg.q_used[s]) continue;
+			u64 r[4] = {};
+			if (vkGetQueryPoolResults(g_dg.dev, g_dg.qp, s * 2, 2, sizeof(r), r, 2 * sizeof(u64),
+				VK_QUERY_RESULT_64_BIT | VK_QUERY_RESULT_WITH_AVAILABILITY_BIT) != VK_SUCCESS || !r[1] || !r[3])
+			{
+				continue;
+			}
+			g_dg.q_used[s] = false;
+			if (r[2] >= r[0])
+			{
+				g_dg.gpu_ms += static_cast<double>(r[2] - r[0]) * g_dg.ts_period * 1e-6;
+				g_dg.gpu_n++;
+			}
+		}
+	}
+
+	// the one-time comparison against the CPU path's output once the GPU finished the check frame
+	void dg_poll_check()
+	{
+		if (!g_dg.check_pending || ++g_dg.check_frames < 3 || vk::last_completed_event_id() < g_dg.check_eid) return;
+		g_dg.check_pending = false;
+		const u32 w = g_dg.check_w, h = g_dg.check_h, tw = g_dg.check_tw;
+		const u8* got = static_cast<const u8*>(g_dg.rb->map(0, u64{tw} * h * 4));
+		const u8* ref = g_dg.check_ref.data();
+		double se = 0;
+		u64 amatch = 0, exact = 0;
+		for (u32 y = 0; y < h; y++)
+		{
+			for (u32 x = 0; x < w; x++)
+			{
+				const u8* g = got + (u64{y} * tw + x) * 4;   // B G R A
+				const u8* r = ref + (u64{y} * w + x) * 4;    // A R G B
+				const int d0 = int(g[2]) - r[1], d1 = int(g[1]) - r[2], d2 = int(g[0]) - r[3];
+				se += d0 * d0 + d1 * d1 + d2 * d2;
+				amatch += g[3] == r[0];
+				exact += g[3] == r[0] && !d0 && !d1 && !d2;
+			}
+		}
+		g_dg.rb->unmap();
+		const double npx = double(w) * h;
+		const double mse = se / (npx * 3);
+		const double psnr = mse > 0 ? 10.0 * std::log10(255.0 * 255.0 / mse) : 99.0;
+		const double am = 100.0 * amatch / npx;
+		std::fprintf(stderr, "[dof-gpu] RSX: check frame serial 0x%X (%ux%u): GPU vs CPU path PSNR %.2f dB, CoC bytes %.2f%% equal, %.2f%% pixels identical\n",
+			g_dg.check_serial, w, h, psnr, am, 100.0 * exact / npx);
+		std::fflush(stderr);
+		r3_dof_gpu_result(g_dg.check_serial, 2, psnr, am);
+		std::vector<u8>().swap(g_dg.check_ref);
+	}
+
+	void dg_ensure_buffer(std::unique_ptr<vk::buffer>& b, u64 size, const vk::memory_type_info& mem, VkMemoryPropertyFlags props, VkBufferUsageFlags usage)
+	{
+		if (b && b->size() >= size) return;
+		if (b) vk::get_resource_manager()->dispose(b);
+		b = std::make_unique<vk::buffer>(*vk::g_render_device, size + (size >> 3), mem, props, usage, 0, vk::VMM_ALLOCATION_POOL_UNDEFINED);
+	}
+}
+
+namespace vk
+{
+	void texture_cache::r3_dof_gpu_init()
+	{
+		r3_dof_gpu_set_ready(1);
+	}
+
+	void texture_cache::r3_dof_gpu_release()
+	{
+		r3_dof_gpu_set_ready(0);
+		if (g_dg.qp) vkDestroyQueryPool(g_dg.dev, g_dg.qp, nullptr);
+		g_dg = {};
+	}
+
+	bool texture_cache::r3_dof_guest_guard(u64 comp)
+	{
+		return ::r3_dof_guest_guard(vm::get_super_ptr<u8>(rbattr::r3_dof_ea()), 352u * 8192u, comp) != 0;
+	}
+
+	vk::image_view* texture_cache::r3_dof_gpu_serve(vk::command_buffer& cmd, vk::image* surf, vk::image* surf2, u32 tex_w, u32 tex_h,
+		const rsx::texture_channel_remap_t& remap)
+	{
+		u32 serial = 0, geom[4] = {};
+		float par[12] = {};
+		const u8* ref = nullptr;
+		// 2 = withdrawn (a later frame ran job 419 on the SPU): only further binds of the served frame's composite
+		const int req = r3_dof_gpu_request(&serial, geom, par, &ref);
+		if (!req || !serial)
+		{
+			return nullptr;
+		}
+
+		auto rt = dynamic_cast<vk::render_target*>(surf);
+		auto rt2 = dynamic_cast<vk::render_target*>(surf2);
+		const auto fp16 = [](const vk::render_target* s)
+		{
+			return s && s->format() == VK_FORMAT_R16G16B16A16_SFLOAT && s->samples() == 1 && s->get_rsx_pitch() == 8192u &&
+				s->surface_width && s->surface_height && s->width() && s->height();
+		};
+		if (!rt2 || !fp16(rt2) || rt2->last_use_tag <= (rt ? rt->last_use_tag : 0))
+		{
+			rt2 = nullptr;   // the 480-wide surface at +0xF00 only supplies the bytes it overlaps when it is the newer one
+		}
+
+		// not computable once the host skips the CPU result: guest memory holds the light buffer, so the previous
+		// frame's blurred image (same size) is the better picture. Only while the request is a GPU-owned frame (the
+		// host withdraws it once a frame runs job 419 on the SPU, whose output is then in guest memory) and only for
+		// an image served within the last R3_DOF_GPU_STALE_MS (default 250; 0 = no reuse)
+		const auto stale = [&](const char* why) -> vk::image_view*
+		{
+			static const long s_max_ms = []
+			{
+				const char* e = std::getenv("R3_DOF_GPU_STALE_MS");
+				return e && *e ? std::max(0L, std::strtol(e, nullptr, 10)) : 250L;
+			}();
+			const auto age = std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - g_dg.served_t).count();
+			if (!r3_dof_gpu_trusted() || !g_dg.img || !g_dg.frames || g_dg.tw != tex_w || g_dg.th != tex_h || age > s_max_ms)
+			{
+				return nullptr;
+			}
+			static u32 s_n = 0;
+			if (++s_n <= 16 || (s_n & (s_n - 1)) == 0)
+			{
+				std::fprintf(stderr, "[dof-gpu] RSX: serial 0x%X: %s -> previous frame's blurred image (serial 0x%X, %.1f ms old) reused (%u times)\n",
+				serial, why, g_dg.served, age, s_n);
+				std::fflush(stderr);
+			}
+			return g_dg.img->get_view(remap);
+		};
+
+		// the same frame again (another bind of the composite's texture): the image as long as the surfaces are unchanged
+		if (serial == g_dg.served)
+		{
+			if (rt == g_dg.rt && rt && rt->last_use_tag == g_dg.rt_tag && (rt2 ? rt2->last_use_tag : 0) == g_dg.rt2_tag &&
+				tex_w == g_dg.tw && tex_h == g_dg.th && g_dg.img)
+			{
+				return g_dg.img->get_view(remap);
+			}
+			return req == 2 ? nullptr : stale("light buffer redrawn since this request was computed");
+		}
+		if (req == 2)
+		{
+			return nullptr;
+		}
+
+		if (!rt)
+		{
+			dg_fail(serial, DG_FAIL_SURFACE, "no render target at the DOF light buffer");
+			return stale("no render target at the DOF light buffer");
+		}
+		if (!fp16(rt))
+		{
+			char why[128];
+			std::snprintf(why, sizeof why, "light buffer is vkformat %u, %u samples, pitch %u (expected RGBA16F, 1, 8192)",
+				static_cast<u32>(rt->format()), static_cast<u32>(rt->samples()), rt->get_rsx_pitch());
+			dg_fail(serial, DG_FAIL_FORMAT, why);
+			return stale("light buffer format");
+		}
+
+		const u32 w = geom[0], h = geom[1], zx = geom[2];
+		if (!w || !h || (w & 1) || (h & 1) || w > 512 || h > 512 || (zx & 3) || zx < w * 4 || zx + w * 4 > 8192u)
+		{
+			dg_fail(serial, DG_FAIL_GEOM, "bad image geometry in the request");
+			return stale("bad image geometry");
+		}
+		if (tex_w > 2048 || tex_h > 1024 || !tex_w || !tex_h)
+		{
+			dg_fail(serial, DG_FAIL_TEXDIMS, "unexpected texture size");
+			return stale("unexpected texture size");
+		}
+
+		const auto t0 = std::chrono::steady_clock::now();
+		dg_poll_timestamps();
+		dg_poll_check();
+
+		// guest rows the shader reads, raw host rows per surface
+		const u32 rows = std::max(h, tex_h);
+		const u32 a_gh = rt->surface_height, a_hw = rt->width() * 2;   // host 32-bit words per row
+		if (rows > a_gh)
+		{
+			dg_fail(serial, DG_FAIL_GEOM, "texture taller than the light buffer");
+			return stale("texture taller than the light buffer");
+		}
+		const u32 b_rows = rt2 ? std::min<u32>(rows, rt2->surface_height) : 0;
+		const u32 b_hw = rt2 ? rt2->width() * 2 : 0;
+		const u64 a_words = u64{rows} * a_hw, b_words = u64{b_rows} * b_hw;
+
+		u32 pw[R3DOF_GPU_PAR_WORDS] = {};
+		pw[0] = w; pw[1] = h; pw[2] = zx; pw[3] = tex_w; pw[4] = tex_h;
+		pw[5] = a_hw; pw[6] = rt->surface_width * 2u; pw[7] = a_hw;
+		pw[8] = 0xFFFFFFFFu;
+		if (rt2)
+		{
+			pw[8] = 0xF00u / 4; pw[9] = rt2->surface_width * 2u; pw[10] = b_hw; pw[11] = b_hw; pw[12] = static_cast<u32>(a_words);
+		}
+		std::memcpy(pw + 14, par, sizeof par);
+
+		const auto& mem = m_device->get_memory_mapping();
+		const VkBufferUsageFlags ssbo = VK_BUFFER_USAGE_STORAGE_BUFFER_BIT | VK_BUFFER_USAGE_TRANSFER_SRC_BIT | VK_BUFFER_USAGE_TRANSFER_DST_BIT;
+		dg_ensure_buffer(g_dg.src, (a_words + b_words) * 4, mem.device_local, VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT, ssbo);
+		dg_ensure_buffer(g_dg.out, u64{tex_w} * tex_h * 4, mem.device_local, VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT, ssbo);
+		dg_ensure_buffer(g_dg.scr, u64{w / 2} * (h / 2) * 3 * 2 * 4, mem.device_local, VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT, ssbo);
+		dg_ensure_buffer(g_dg.par, R3DOF_GPU_PAR_WORDS * 4, mem.device_local, VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT, ssbo);
+		if (!g_dg.img || g_dg.img->width() != tex_w || g_dg.img->height() != tex_h)
+		{
+			if (g_dg.img) vk::get_resource_manager()->dispose(g_dg.img);
+			g_dg.img = std::make_unique<vk::viewable_image>(*m_device, mem.device_local, VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT,
+				VK_IMAGE_TYPE_2D, VK_FORMAT_B8G8R8A8_UNORM, tex_w, tex_h, 1, 1, 1, VK_SAMPLE_COUNT_1_BIT, VK_IMAGE_LAYOUT_UNDEFINED,
+				VK_IMAGE_TILING_OPTIMAL, VK_IMAGE_USAGE_TRANSFER_DST_BIT | VK_IMAGE_USAGE_TRANSFER_SRC_BIT | VK_IMAGE_USAGE_SAMPLED_BIT, 0,
+				VMM_ALLOCATION_POOL_TEXTURE_CACHE, RSX_FORMAT_CLASS_COLOR);
+			g_dg.img->native_component_map = apply_component_mapping_flags(CELL_GCM_TEXTURE_A8R8G8B8, rsx::component_order::default_, rsx::default_remap_vector);
+		}
+		if (!g_dg.qp)
+		{
+			g_dg.dev = *m_device;
+			g_dg.ts_period = m_device->gpu().get_limits().timestampPeriod;
+			VkQueryPoolCreateInfo qi{ VK_STRUCTURE_TYPE_QUERY_POOL_CREATE_INFO };
+			qi.queryType = VK_QUERY_TYPE_TIMESTAMP;
+			qi.queryCount = 8;
+			if (vkCreateQueryPool(g_dg.dev, &qi, nullptr, &g_dg.qp) != VK_SUCCESS) g_dg.qp = VK_NULL_HANDLE;
+		}
+
+		if (vk::is_renderpass_open(cmd)) vk::end_renderpass(cmd);
+		u32 qs = 0;
+		if (g_dg.qp && !g_dg.q_used[g_dg.q_next])
+		{
+			qs = g_dg.q_next + 1;
+			g_dg.q_next = (g_dg.q_next + 1) & 3;
+			vkCmdResetQueryPool(cmd, g_dg.qp, (qs - 1) * 2, 2);
+			vkCmdWriteTimestamp(cmd, VK_PIPELINE_STAGE_TOP_OF_PIPE_BIT, g_dg.qp, (qs - 1) * 2);
+		}
+
+		// the previous run's reads / writes of the buffers before this run's copies
+		vk::insert_global_memory_barrier(cmd, VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT | VK_PIPELINE_STAGE_TRANSFER_BIT, VK_PIPELINE_STAGE_TRANSFER_BIT,
+			VK_ACCESS_SHADER_READ_BIT | VK_ACCESS_SHADER_WRITE_BIT | VK_ACCESS_TRANSFER_READ_BIT | VK_ACCESS_TRANSFER_WRITE_BIT,
+			VK_ACCESS_TRANSFER_READ_BIT | VK_ACCESS_TRANSFER_WRITE_BIT);
+		vkCmdUpdateBuffer(cmd, g_dg.par->value, 0, sizeof pw, pw);
+
+		// RSX_DOF_FIX's point mapping of guest row y: host row floor((2y + 1) * host h / (2 * guest h))
+		auto copy_rows = [&](vk::render_target* s, u32 n, u64 word_off)
+		{
+			s->memory_barrier(cmd, rsx::surface_access::transfer_read);
+			vk::image* img = s->get_surface(rsx::surface_access::transfer_read);
+			std::vector<VkBufferImageCopy> rg(n);
+			for (u32 y = 0; y < n; y++)
+			{
+				auto& r = rg[y];
+				r.bufferOffset = (word_off + u64{y} * img->width() * 2) * 4;
+				r.imageSubresource = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1 };
+				r.imageOffset = { 0, static_cast<s32>((2 * y + 1) * img->height() / (2u * s->surface_height)), 0 };
+				r.imageExtent = { img->width(), 1, 1 };
+			}
+			img->push_layout(cmd, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL);
+			vkCmdCopyImageToBuffer(cmd, img->value, img->current_layout, g_dg.src->value, n, rg.data());
+			img->pop_layout(cmd);
+		};
+		copy_rows(rt, rows, 0);
+		if (rt2 && b_rows) copy_rows(rt2, b_rows, a_words);
+
+		vk::insert_global_memory_barrier(cmd, VK_PIPELINE_STAGE_TRANSFER_BIT, VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT,
+			VK_ACCESS_TRANSFER_WRITE_BIT, VK_ACCESS_SHADER_READ_BIT | VK_ACCESS_SHADER_WRITE_BIT);
+
+		auto* task = vk::get_compute_task<vk::r3dof_gpu_task>();
+		task->buf[0] = g_dg.src.get(); task->size[0] = (a_words + b_words) * 4;
+		task->buf[1] = g_dg.out.get(); task->size[1] = u64{tex_w} * tex_h * 4;
+		task->buf[2] = g_dg.scr.get(); task->size[2] = u64{w / 2} * (h / 2) * 3 * 2 * 4;
+		task->buf[3] = g_dg.par.get(); task->size[3] = R3DOF_GPU_PAR_WORDS * 4;
+		for (u32 pass = 0; pass < 4; pass++)
+		{
+			task->dispatch(cmd, pass, pass < 3 ? w / 2 : tex_w, pass < 3 ? h / 2 : tex_h);
+			vk::insert_global_memory_barrier(cmd, VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT,
+				pass < 3 ? VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT : VK_PIPELINE_STAGE_TRANSFER_BIT,
+				VK_ACCESS_SHADER_WRITE_BIT, pass < 3 ? VK_ACCESS_SHADER_READ_BIT | VK_ACCESS_SHADER_WRITE_BIT : VK_ACCESS_TRANSFER_READ_BIT);
+		}
+
+		VkBufferImageCopy oc{};
+		oc.imageSubresource = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1 };
+		oc.imageExtent = { tex_w, tex_h, 1 };
+		g_dg.img->change_layout(cmd, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL);
+		vkCmdCopyBufferToImage(cmd, g_dg.out->value, g_dg.img->value, g_dg.img->current_layout, 1, &oc);
+		g_dg.img->change_layout(cmd, VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL);
+
+		const bool check = geom[3] && ref && !g_dg.check_pending && w <= tex_w && h <= tex_h;
+		if (check)
+		{
+			dg_ensure_buffer(g_dg.rb, u64{tex_w} * tex_h * 4, mem.host_visible_coherent,
+				VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT | VK_MEMORY_PROPERTY_HOST_COHERENT_BIT, VK_BUFFER_USAGE_TRANSFER_DST_BIT);
+			VkBufferCopy bc{ 0, 0, u64{tex_w} * tex_h * 4 };
+			vkCmdCopyBuffer(cmd, g_dg.out->value, g_dg.rb->value, 1, &bc);
+			vk::insert_global_memory_barrier(cmd, VK_PIPELINE_STAGE_TRANSFER_BIT, VK_PIPELINE_STAGE_HOST_BIT,
+				VK_ACCESS_TRANSFER_WRITE_BIT, VK_ACCESS_HOST_READ_BIT);
+			g_dg.check_ref.assign(ref, ref + u64{w} * h * 4);
+			g_dg.check_pending = true;
+			g_dg.check_serial = serial; g_dg.check_w = w; g_dg.check_h = h; g_dg.check_tw = tex_w;
+			g_dg.check_frames = 0;
+			g_dg.check_eid = vk::current_event_id();
+		}
+		else if (geom[3] && !g_dg.check_pending)
+		{
+			r3_dof_gpu_result(serial, 3, 0, 0);   // no comparison possible: the host must not wait for one
+		}
+		if (qs)
+		{
+			vkCmdWriteTimestamp(cmd, VK_PIPELINE_STAGE_BOTTOM_OF_PIPE_BIT, g_dg.qp, (qs - 1) * 2 + 1);
+			g_dg.q_used[qs - 1] = true;
+		}
+		cmd.r2_invalidate_state_cache();
+		cmd.flags |= vk::command_buffer::cb_reload_dynamic_state;
+
+		g_dg.served = serial;
+		g_dg.served_t = std::chrono::steady_clock::now();
+		g_dg.rt = rt; g_dg.rt_tag = rt->last_use_tag; g_dg.rt2_tag = rt2 ? rt2->last_use_tag : 0;
+		g_dg.tw = tex_w; g_dg.th = tex_h;
+
+		const double ms = std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - t0).count();
+		g_dg.rec_ms += ms;
+		if (++g_dg.frames == 1 || (g_dg.frames % 600) == 0)
+		{
+			std::fprintf(stderr, "[dof-gpu] RSX: %llu frames computed on the GPU (image %ux%u, depth col %u, texture %ux%u, light buffer %ux%u host%s), "
+				"record avg %.3f ms, GPU avg %.3f ms (%llu timed)\n",
+				static_cast<unsigned long long>(g_dg.frames), w, h, zx, tex_w, tex_h, rt->width(), rt->height(), rt2 ? " + 0xF00" : "",
+				g_dg.rec_ms / g_dg.frames, g_dg.gpu_n ? g_dg.gpu_ms / g_dg.gpu_n : 0.0, static_cast<unsigned long long>(g_dg.gpu_n));
+			std::fflush(stderr);
+		}
+		r3_dof_gpu_result(serial, 1, ms, 0);
+		return g_dg.img->get_view(remap);
+	}
+}
diff --git a/rpcs3/Emu/RSX/VK/VKR3DofGpuGlsl.h b/rpcs3/Emu/RSX/VK/VKR3DofGpuGlsl.h
new file mode 100644
index 0000000..8edc644
--- /dev/null
+++ b/rpcs3/Emu/RSX/VK/VKR3DofGpuGlsl.h
@@ -0,0 +1,143 @@
+// R3PORT R3_DOF_GPU: compute shader of the GPU aim-down-sights blur (VKR3DofGpu.cpp). Port of r3dof_fast_run
+// (project\r3_dof_fast.c, the "PC fast" CPU approximation of SPU job 419) and of scratch\gpu_dof\r3_dof_gpu_glsl.h, which
+// was checked bit-exact against it offline. Instead of the tiled guest region it reads the job's inputs straight from the
+// FP16 light-buffer surface(s) at 0x30030000 (the game typeless-blits ARGB8 colour and D24S8 depth into it): the rows of
+// the resolution-scaled surface the readback would pick are copied raw into `src`, and each guest 32-bit word is fetched
+// with RSX_DOF_FIX's point mapping (host word floor((2i+1) * host words / (2 * guest words)), same for rows) plus the
+// 16-bit byte swap of the FP16 flush, i.e. exactly the bytes the CPU path reads back from guest memory.
+//
+// Bindings (set 0): 0 src (raw surface rows), 1 out (texture texels, B8G8R8A8 byte order), 2 scratch floats, 3 par (uints):
+//   0 w, 1 h, 2 depth byte column, 3 texture w, 4 texture h, 5 A row words, 6 A guest words, 7 A host words,
+//   8 B first guest word (0xFFFFFFFF = no B), 9 B guest words, 10 B host words, 11 B row words, 12 B buffer word offset,
+//   13 -, 14..25 the 12 r3dof_fast_params floats in struct order.
+// Push constant: pass (0 downsample, 1 horizontal blur, 2 vertical blur, 3 CoC + composite + pass-through).
+#pragma once
+
+#define R3DOF_GPU_PAR_WORDS 32u
+
+static const char* const r3dof_gpu_rsx_glsl = R"GLSL(#version 450
+layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
+layout(std430, set = 0, binding = 0) readonly restrict buffer SrcBlock { uint src[]; };
+layout(std430, set = 0, binding = 1) writeonly restrict buffer OutBlock { uint outw[]; };
+layout(std430, set = 0, binding = 2) restrict buffer ScratchBlock { float scr[]; };
+layout(std430, set = 0, binding = 3) readonly restrict buffer ParBlock { uint par[]; };
+layout(push_constant) uniform PC { uvec4 pc; };
+
+float P(int i) { return uintBitsToFloat(par[14 + i]); }
+
+uint guest_word(uint i, uint y)
+{
+	uint gi, gw, sw, base;
+	if (par[8] != 0xffffffffu && i >= par[8] && i - par[8] < par[9]) { gi = i - par[8]; gw = par[9]; sw = par[10]; base = par[12] + y * par[11]; }
+	else if (i < par[6]) { gi = i; gw = par[6]; sw = par[7]; base = y * par[5]; }
+	else return 0u;
+	uint raw = src[base + ((2u * gi + 1u) * sw) / (2u * gw)];
+	return ((raw & 0x00ff00ffu) << 8) | ((raw >> 8) & 0x00ff00ffu);
+}
+
+uint bswap(uint w) { return (w >> 24) | ((w >> 8) & 0xff00u) | ((w << 8) & 0xff0000u) | (w << 24); }
+uint colour_word(int x, int y) { return guest_word(uint(x), uint(y)); }   // bytes A R G B
+uint depth_word(int x, int y) { return bswap(guest_word(par[2] / 4u + uint(x), uint(y))); }   // big-endian D24S8
+
+// correctly rounded 1/s (round to nearest even), including subnormals, zero, inf, NaN
+float rcp_rne(float s)
+{
+	uint b = floatBitsToUint(s);
+	uint sign = b & 0x80000000u, e = (b >> 23) & 0xffu, m = b & 0x7fffffu;
+	if (e == 0xffu) return m != 0u ? uintBitsToFloat(b | 0x400000u) : uintBitsToFloat(sign);
+	if (e == 0u && m == 0u) return uintBitsToFloat(sign | 0x7f800000u);
+	int E;
+	if (e == 0u) { int sh = 0; while ((m & 0x800000u) == 0u) { m <<= 1; sh++; } E = -126 - sh; }
+	else { m |= 0x800000u; E = int(e) - 127; }
+	uint q, sticky = 0u;
+	if (m == 0x800000u) q = 1u << 25;
+	else {
+		uint r = 0x800000u; q = 0u;
+		for (int i = 0; i < 25; i++) { r <<= 1; q <<= 1; if (r >= m) { r -= m; q |= 1u; } }
+		sticky = r != 0u ? 1u : 0u;
+	}
+	int R = -1 - E;
+	int drop = 1;
+	if (R < -126) { drop += -126 - R; R = -127; }
+	if (drop > 26) return uintBitsToFloat(sign);
+	uint mant = q >> uint(drop), rem = q & ((1u << uint(drop)) - 1u), half_ = 1u << uint(drop - 1);
+	if (rem > half_ || (rem == half_ && (sticky != 0u || (mant & 1u) != 0u))) mant++;
+	if (R == -127) return uintBitsToFloat(sign | mant);
+	if (R > 127) return uintBitsToFloat(sign | 0x7f800000u);
+	return uintBitsToFloat(sign | ((uint(R + 127) << 23) + (mant - 0x800000u)));
+}
+
+float sat(float v) { return v < 0.0 ? 0.0 : (v > 1.0 ? 1.0 : v); }
+
+void main()
+{
+	const int W = int(par[0]), H = int(par[1]), HW = W / 2, HH = H / 2, PLANE = HW * HH * 3;
+	const uint pass = pc.x;
+	int x = int(gl_GlobalInvocationID.x), y = int(gl_GlobalInvocationID.y);
+	if (pass == 0u) {
+		if (x >= HW || y >= HH) return;
+		uint w00 = colour_word(2 * x, 2 * y), w01 = colour_word(2 * x + 1, 2 * y);
+		uint w10 = colour_word(2 * x, 2 * y + 1), w11 = colour_word(2 * x + 1, 2 * y + 1);
+		for (int c = 0; c < 3; c++) {
+			uint sh = uint(8 * (c + 1));
+			int sum = int(((w00 >> sh) & 0xffu) + ((w01 >> sh) & 0xffu) + ((w10 >> sh) & 0xffu) + ((w11 >> sh) & 0xffu));
+			precise float v = float(sum) * 0.25;
+			scr[(y * HW + x) * 3 + c] = v;
+		}
+	} else if (pass == 1u || pass == 2u) {
+		if (x >= HW || y >= HH) return;
+		const float wt[4] = float[4](0.3125, 0.234375, 0.09375, 0.015625);   // 20, 15, 6, 1 / 64
+		int s0 = pass == 1u ? 0 : PLANE, d0 = pass == 1u ? PLANE : 0;
+		for (int c = 0; c < 3; c++) {
+			precise float acc = scr[s0 + (y * HW + x) * 3 + c] * wt[0];
+			for (int k = 1; k < 4; k++) {
+				int i0, i1;
+				if (pass == 1u) { i0 = y * HW + max(x - k, 0); i1 = y * HW + min(x + k, HW - 1); }
+				else { i0 = max(y - k, 0) * HW + x; i1 = min(y + k, HH - 1) * HW + x; }
+				precise float pr = scr[s0 + i0 * 3 + c] + scr[s0 + i1 * 3 + c];
+				precise float t = pr * wt[k];
+				acc = acc + t;
+			}
+			scr[d0 + (y * HW + x) * 3 + c] = acc;
+		}
+	} else {
+		const int TW = int(par[3]), TH = int(par[4]);
+		if (x >= TW || y >= TH) return;
+		uint cw = colour_word(x, y);
+		if (x >= W || y >= H) { outw[y * TW + x] = bswap(cw); return; }   // outside the job's image: guest bytes as they are
+		const float lin_a = P(0), lin_b = P(1), lin_c = P(2), lin_d = P(3), lin_split = P(4);
+		const float near_a = P(5), near_b = P(6), near_max = P(7), split = P(8), far_a = P(9), far_b = P(10), far_max = P(11);
+		precise float d = float(depth_word(x, y) >> 8);
+		precise float s;
+		if (d > lin_split) { precise float t = d * lin_a; s = t + lin_b; }
+		else { precise float t = d * lin_c; s = t + lin_d; }
+		precise float lin = rcp_rne(s);
+		precise float coc;
+		if (lin > split) { precise float t = lin * far_a; precise float u = t + far_b; coc = sat(u) * far_max; }
+		else { precise float t = lin * near_a; precise float u = t + near_b; coc = sat(u) * near_max; }
+		uint o;
+		if (!(coc > 0.0)) o = cw & 0xffffff00u;
+		else {
+			precise float fy = float(y) + 0.5; fy = fy * 0.5; fy = fy - 0.5; if (fy < 0.0) fy = 0.0;
+			precise float fx = float(x) + 0.5; fx = fx * 0.5; fx = fx - 0.5; if (fx < 0.0) fx = 0.0;
+			int y0 = int(fy), y1 = min(y0 + 1, HH - 1), x0 = int(fx), x1 = min(x0 + 1, HW - 1);
+			precise float ty = fy - float(y0), tx = fx - float(x0);
+			precise float k = coc < 1.0 ? coc : 1.0;
+			precise float av = coc * 256.0;
+			o = av >= 255.0 ? 255u : uint(int(av));
+			for (int ch = 0; ch < 3; ch++) {
+				precise float a00 = scr[(y0 * HW + x0) * 3 + ch], a01 = scr[(y0 * HW + x1) * 3 + ch];
+				precise float a10 = scr[(y1 * HW + x0) * 3 + ch], a11 = scr[(y1 * HW + x1) * 3 + ch];
+				precise float t0 = a01 - a00; t0 = t0 * tx; t0 = a00 + t0;
+				precise float t1 = a11 - a10; t1 = t1 * tx; t1 = a10 + t1;
+				precise float bl = t1 - t0; bl = bl * ty; bl = t0 + bl;
+				precise float c = float((cw >> uint(8 * (ch + 1))) & 0xffu);
+				precise float v = bl - c; v = v * k; v = c + v; v = v + 0.5;
+				uint ob = v >= 255.0 ? 255u : uint(int(v));
+				o |= ob << uint(8 * (ch + 1));
+			}
+		}
+		outw[y * TW + x] = bswap(o);
+	}
+}
+)GLSL";
diff --git a/rpcs3/Emu/RSX/VK/VKR3Rdoc.h b/rpcs3/Emu/RSX/VK/VKR3Rdoc.h
new file mode 100644
index 0000000..d6cd756
--- /dev/null
+++ b/rpcs3/Emu/RSX/VK/VKR3Rdoc.h
@@ -0,0 +1,144 @@
+#pragma once
+
+// R3PORT RSX_RDOC_FRAMES=N (default 0 = off): RenderDoc captures of whole guest frames.
+// RenderDoc's own F12 captures one present-to-present interval. A guest frame spans more than one present (frame
+// generation / the UI split present separately), so an F12 capture can hold the second half of one guest frame and
+// none of the next one's scene draws. With this switch, pressing RSX_RDOC_KEY (default F6; "F1".."F12" or a hex
+// virtual-key code; F8 is the mouse-release key) while the game window has focus starts a capture at the start of the
+// next guest flip's present and ends it at the start of the (N+1)-th guest flip's present after that, so the capture
+// holds N complete guest frames (scene, post-processing, upscaler, UI and their presents) plus the tail of the
+// previous frame's present. The hook is at the top of present_frame: the DLSS / frame-generation present paths
+// return before its end (r13: a hook there never fired).
+// RSX_RDOC_AT=K additionally starts one capture automatically at guest flip K (counted from renderer start).
+// Only active when the process runs under RenderDoc (renderdoc.bat); [rdoc] lines on stderr.
+
+#ifdef _WIN32
+#include <windows.h>
+#endif
+
+#include "renderdoc_app.h"
+
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+
+namespace r3rdoc
+{
+	struct state_t
+	{
+		RENDERDOC_API_1_1_2* api = nullptr;
+		u32 frames = 0;
+		int key = 0x75; // VK_F6 (F8 = cellPad mouse release)
+		unsigned long long at = 0;
+		unsigned long long flip = 0;
+		u32 left = 0;
+		bool capturing = false;
+		bool key_was = false;
+		bool init = false;
+	};
+
+	static inline state_t& st()
+	{
+		static state_t s;
+		return s;
+	}
+
+	static inline void init(state_t& s)
+	{
+		s.init = true;
+		if (const char* e = std::getenv("RSX_RDOC_FRAMES"); e && *e) s.frames = static_cast<u32>(std::strtoul(e, nullptr, 0));
+		if (!s.frames)
+		{
+			return;
+		}
+
+		if (const char* e = std::getenv("RSX_RDOC_KEY"); e && *e)
+		{
+			if ((e[0] == 'F' || e[0] == 'f') && e[1] >= '1' && e[1] <= '9')
+			{
+				const int n = std::atoi(e + 1);
+				s.key = (n >= 1 && n <= 24) ? 0x70 + (n - 1) : 0;
+			}
+			else
+			{
+				s.key = static_cast<int>(std::strtol(e, nullptr, 16));
+			}
+		}
+		if (const char* e = std::getenv("RSX_RDOC_AT"); e && *e) s.at = std::strtoull(e, nullptr, 0);
+
+#ifdef _WIN32
+		if (HMODULE mod = GetModuleHandleA("renderdoc.dll"))
+		{
+			if (auto get_api = reinterpret_cast<pRENDERDOC_GetAPI>(GetProcAddress(mod, "RENDERDOC_GetAPI")))
+			{
+				if (get_api(eRENDERDOC_API_Version_1_1_2, reinterpret_cast<void**>(&s.api)) != 1)
+				{
+					s.api = nullptr;
+				}
+			}
+		}
+#endif
+		if (s.api)
+		{
+			std::fprintf(stderr, "[rdoc] RSX_RDOC_FRAMES=%u: key 0x%x captures %u whole guest frame(s) flip-to-flip%s\n",
+				s.frames, s.key, s.frames, s.at ? " (plus RSX_RDOC_AT)" : "");
+		}
+		else
+		{
+			std::fprintf(stderr, "[rdoc] RSX_RDOC_FRAMES=%u but RenderDoc is not loaded (run renderdoc.bat); off\n", s.frames);
+		}
+	}
+
+	static inline bool key_pressed(const state_t& s)
+	{
+#ifdef _WIN32
+		if (!s.key || !(GetAsyncKeyState(s.key) & 0x8001)) // held now, or pressed since the last poll
+		{
+			return false;
+		}
+		DWORD pid = 0;
+		GetWindowThreadProcessId(GetForegroundWindow(), &pid);
+		return pid == GetCurrentProcessId();
+#else
+		return false;
+#endif
+	}
+
+	// Call at the start of every guest (emu) flip's present_frame
+	static inline void on_guest_flip()
+	{
+		auto& s = st();
+		if (!s.init) [[unlikely]]
+		{
+			init(s);
+		}
+		if (!s.api) [[likely]]
+		{
+			return;
+		}
+
+		s.flip++;
+		if (s.capturing)
+		{
+			if (--s.left == 0)
+			{
+				const u32 ok = s.api->EndFrameCapture(nullptr, nullptr);
+				s.capturing = false;
+				std::fprintf(stderr, "[rdoc] capture %s at guest flip %llu (%u frame(s)); captures so far %u\n",
+					ok ? "written" : "FAILED", s.flip, s.frames, s.api->GetNumCaptures());
+			}
+			return;
+		}
+
+		const bool down = key_pressed(s);
+		const bool edge = down && !s.key_was;
+		s.key_was = down;
+		if (edge || (s.at && s.flip == s.at))
+		{
+			s.api->StartFrameCapture(nullptr, nullptr);
+			s.capturing = true;
+			s.left = s.frames + 1;
+			std::fprintf(stderr, "[rdoc] capture started at guest flip %llu (%u frame(s))\n", s.flip, s.frames);
+		}
+	}
+}
diff --git a/rpcs3/Emu/RSX/VK/VKR3RtReinterpret.cpp b/rpcs3/Emu/RSX/VK/VKR3RtReinterpret.cpp
new file mode 100644
index 0000000..fae30d5
--- /dev/null
+++ b/rpcs3/Emu/RSX/VK/VKR3RtReinterpret.cpp
@@ -0,0 +1,400 @@
+// R3PORT RSX_RT_GPU_REINTERPRET / RSX_ADS_RSX_LATE (port_rbattr.h; common side in Common/texture_cache.h, r3_rt_gpu_path).
+//
+// A texture that misses the cache and overlaps render targets (R3: an FP16 surface sampled as ARGB8 in the aim-down-sights
+// scenes, B8 ping-pong surfaces) was built by flushing those surfaces (GPU copy into the DMA block, submit, wait, copy to guest memory) and
+// decoding guest memory, ~2.8 ms of RSX-thread stall per texture. Here the same bytes are assembled on the GPU:
+//   1. the guest bytes of the span (snapshot into the upload heap, what the decode reads where no surface flushes),
+//   2. for each flushing section, oldest write first, its DMA block bytes over its range (what imp_flush copies),
+//   3. the 32-bit byteswap the CPU decode does for A8R8G8B8/D8R8G8B8 (none for B8), then a buffer-to-image copy at the guest pitch,
+// into an image with the format, mutable view formats and component map upload_image_from_cpu gives the texture.
+// Guest memory is not written and the sections stay locked (a later CPU read flushes them as before).
+//
+// RSX_ADS_RSX_LATE: textures the reinterpret can't build (other formats) keep a copy of the last upload; every other frame
+// that copy is served instead of a new readback (never two frames in a row, never in 0x30030000..0x304B0000).
+#include "stdafx.h"
+#include "Emu/RSX/VK/VKGSRenderTypes.hpp"
+#include "VKTextureCache.h"
+#include "VKCompute.h"
+#include "VKDMA.h"
+#include "VKFormats.h"
+#include "VKRenderPass.h"
+#include "VKResourceManager.h"
+#include "VKR2Gfx.h"
+#include "../port_adsrb.h"
+#include "../port_rbattr.h"
+#include "vkutils/buffer_object.h"
+#include "vkutils/data_heap.h"
+#include "vkutils/sync.h"
+#include "Emu/RSX/RSXThread.h"
+#include "Emu/system_config.h"
+
+#include <cstdio>
+#include <cstring>
+#include <memory>
+#include <vector>
+
+namespace
+{
+	struct rt_image
+	{
+		u32 address = 0, w = 0, h = 0, fmt = 0, pitch = 0;
+		std::unique_ptr<vk::viewable_image> img;
+
+		// RSX_RT_GPU_REINTERPRET: the inputs of the last build (reused when nothing changed in the same frame)
+		bool built = false;
+		u64 sig = 0, frame = 0;
+		std::vector<std::pair<VkBuffer, u32>> maps;
+		std::vector<u8> snap;
+
+		// RSX_ADS_RSX_LATE
+		u64 fresh_frame = ~0ull, stale_frame = ~0ull;
+	};
+
+	struct rt_state
+	{
+		std::vector<std::unique_ptr<rt_image>> reint, late;
+		std::unique_ptr<vk::buffer> span;   // device-local working copy of the span (guest byte order, then swapped)
+		std::unique_ptr<vk::buffer> rb;     // RSX_RT_GPU_REINTERPRET_CHECK readback
+	};
+
+	rt_state g_rt;
+	constexpr usz max_images = 48;
+
+	void rt_ensure_buffer(std::unique_ptr<vk::buffer>& b, u64 size, const vk::memory_type_info& mem, VkMemoryPropertyFlags props, VkBufferUsageFlags usage)
+	{
+		if (b && b->size() >= size) return;
+		if (b) vk::get_resource_manager()->dispose(b);
+		b = std::make_unique<vk::buffer>(*vk::g_render_device, size + (size >> 3), mem, props, usage, 0, vk::VMM_ALLOCATION_POOL_UNDEFINED);
+	}
+
+	rt_image* rt_find(std::vector<std::unique_ptr<rt_image>>& list, u32 address, u32 w, u32 h, u32 fmt, u32 pitch, bool create)
+	{
+		for (auto& e : list)
+		{
+			if (e->address == address && e->w == w && e->h == h && e->fmt == fmt && e->pitch == pitch) return e.get();
+		}
+		if (!create || list.size() >= max_images) return nullptr;
+		auto e = std::make_unique<rt_image>();
+		e->address = address; e->w = w; e->h = h; e->fmt = fmt; e->pitch = pitch;
+		list.push_back(std::move(e));
+		return list.back().get();
+	}
+
+	bool rt_owned(const std::vector<std::unique_ptr<rt_image>>& list, const vk::image* img)
+	{
+		for (const auto& e : list)
+		{
+			if (e->img.get() == img) return true;
+		}
+		return false;
+	}
+}
+
+namespace vk
+{
+	void texture_cache::r3_rt_release()
+	{
+		g_rt = {};
+	}
+
+	bool texture_cache::r3_rt_reint_range_ok(const utils::address_range32& range)
+	{
+		// Tiled readbacks write a whole tile layout (and the texture decode detiles); texture packs replace by guest hash;
+		// RSX_ADS_STALE_OK may serve an older readback
+		return !r2gx::texpack_active && !adsrb::cfg().stale_ok && !rsx::get_current_renderer()->get_tiled_memory_region(range);
+	}
+
+	bool texture_cache::r3_rt_reint_owns(vk::image_view* view)
+	{
+		const vk::image* img = view ? view->image() : nullptr;
+		return img && (rt_owned(g_rt.reint, img) || rt_owned(g_rt.late, img));
+	}
+
+	vk::image_view* texture_cache::r3_rt_reinterpret(vk::command_buffer& cmd, const r3_rt_req& rq, const rsx::texture_channel_remap_t& remap)
+	{
+		const u32 linear = rq.pitch * rq.height;   // what the buffer-to-image copy addresses (rows at the guest pitch)
+		const u32 snap_len = std::min(rq.span, linear);
+		if (rq.width > 0x1000 || rq.height > 0x1000 || rq.dma.empty() || (rq.bpp != 1 && rq.bpp != 4) || (rq.pitch % rq.bpp))
+		{
+			return nullptr;
+		}
+
+		// The DMA block of each section range, as imp_flush's flush_dma would read it
+		std::vector<std::pair<VkBuffer, u32>> maps;
+		std::vector<vk::buffer*> bufs;
+		for (const auto& r : rq.dma)
+		{
+			const auto m = vk::peek_dma(r.start, r.length());
+			if (!m.second)
+			{
+				return nullptr;
+			}
+			maps.emplace_back(m.second->value, m.first);
+			bufs.push_back(m.second);
+		}
+
+		rt_image* e = rt_find(g_rt.reint, rq.address, rq.width, rq.height, rq.gcm_format, rq.pitch, true);
+		if (!e)
+		{
+			return nullptr;
+		}
+
+		const u8* guest = vm::get_super_ptr<const u8>(rq.address);
+		if (!rq.check_out && !rq.recopied && e->built && e->img && e->frame == m_r3_frame && e->sig == rq.sig && e->maps == maps &&
+			e->snap.size() == snap_len && std::memcmp(e->snap.data(), guest, snap_len) == 0)
+		{
+			rbattr::st().reint_reuse.fetch_add(1, std::memory_order_relaxed);
+			return e->img->get_view(remap);
+		}
+
+		// The image upload_image_from_cpu would create for this texture (format, mutable view formats, component map)
+		const VkFormat vk_format = vk::get_compatible_sampler_format(m_formats_support, rq.gcm_format);
+		if (!e->img || e->img->format() != vk_format)
+		{
+			rsx::simple_array<VkFormat> mutable_format_list;
+			VkImageCreateFlags create_flags = 0;
+			if (!g_cfg.video.disable_hardware_texel_remapping)
+			{
+				const VkFormat snorm_fmt = vk::get_compatible_snorm_format(vk_format);
+				const VkFormat srgb_fmt = vk::get_compatible_srgb_format(vk_format);
+				if (snorm_fmt != VK_FORMAT_UNDEFINED) mutable_format_list.push_back(snorm_fmt);
+				if (srgb_fmt != VK_FORMAT_UNDEFINED) mutable_format_list.push_back(srgb_fmt);
+				if (!mutable_format_list.empty())
+				{
+					create_flags |= VK_IMAGE_CREATE_MUTABLE_FORMAT_BIT;
+					mutable_format_list.push_back(vk_format);
+				}
+			}
+
+			VkFormatEx create_format = vk_format;
+			if (!mutable_format_list.empty())
+			{
+				create_format.pViewFormats = mutable_format_list.data();
+				create_format.viewFormatCount = mutable_format_list.size();
+			}
+
+			if (e->img) vk::get_resource_manager()->dispose(e->img);
+			e->img = std::make_unique<vk::viewable_image>(*m_device, m_memory_types.device_local, VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT,
+				VK_IMAGE_TYPE_2D, create_format, rq.width, rq.height, 1, 1, 1, VK_SAMPLE_COUNT_1_BIT, VK_IMAGE_LAYOUT_UNDEFINED,
+				VK_IMAGE_TILING_OPTIMAL, VK_IMAGE_USAGE_TRANSFER_DST_BIT | VK_IMAGE_USAGE_TRANSFER_SRC_BIT | VK_IMAGE_USAGE_SAMPLED_BIT,
+				create_flags, VMM_ALLOCATION_POOL_TEXTURE_CACHE, rsx::classify_format(rq.gcm_format));
+			e->img->set_debug_name(fmt::format("R3 reinterpret @0x%x", rq.address));
+			e->built = false;
+		}
+		e->img->native_component_map = apply_component_mapping_flags(rq.gcm_format, rsx::component_order::default_, rsx::default_remap_vector);
+
+		const u32 span_size = utils::align(linear, 256u);
+		rt_ensure_buffer(g_rt.span, span_size, m_memory_types.device_local, VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT,
+			VK_BUFFER_USAGE_TRANSFER_SRC_BIT | VK_BUFFER_USAGE_TRANSFER_DST_BIT | VK_BUFFER_USAGE_STORAGE_BUFFER_BIT);
+
+		if (vk::is_renderpass_open(cmd))
+		{
+			vk::end_renderpass(cmd);
+		}
+
+		// Earlier uses of the working buffer / image and the sections' DMA copies (recorded above or in earlier submits)
+		vk::insert_global_memory_barrier(cmd, VK_PIPELINE_STAGE_ALL_COMMANDS_BIT, VK_PIPELINE_STAGE_TRANSFER_BIT,
+			VK_ACCESS_MEMORY_READ_BIT | VK_ACCESS_MEMORY_WRITE_BIT, VK_ACCESS_TRANSFER_READ_BIT | VK_ACCESS_TRANSFER_WRITE_BIT);
+
+		// 1. guest bytes of the span
+		const auto heap_offset = m_texture_upload_heap->alloc<512>(snap_len);
+		std::memcpy(m_texture_upload_heap->map(heap_offset, snap_len), guest, snap_len);
+		m_texture_upload_heap->unmap();
+		{
+			const VkBufferCopy bc{ heap_offset, 0, snap_len };
+			vkCmdCopyBuffer(cmd, m_texture_upload_heap->heap->value, g_rt.span->value, 1, &bc);
+		}
+
+		// 2. the readback bytes, in flush order
+		u64 dma_bytes = 0;
+		for (usz i = 0; i < rq.dma.size(); i++)
+		{
+			const auto& r = rq.dma[i];
+			if (r.start - rq.address >= snap_len)
+			{
+				continue;
+			}
+			vk::insert_global_memory_barrier(cmd, VK_PIPELINE_STAGE_TRANSFER_BIT, VK_PIPELINE_STAGE_TRANSFER_BIT,
+				VK_ACCESS_TRANSFER_WRITE_BIT, VK_ACCESS_TRANSFER_READ_BIT | VK_ACCESS_TRANSFER_WRITE_BIT);
+			const u32 len = std::min<u32>(r.length(), snap_len - (r.start - rq.address));
+			const VkBufferCopy bc{ maps[i].second, r.start - rq.address, len };
+			vkCmdCopyBuffer(cmd, bufs[i]->value, g_rt.span->value, 1, &bc);
+			dma_bytes += len;
+		}
+
+		vk::insert_global_memory_barrier(cmd, VK_PIPELINE_STAGE_TRANSFER_BIT, VK_PIPELINE_STAGE_TRANSFER_BIT | VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT,
+			VK_ACCESS_TRANSFER_WRITE_BIT, VK_ACCESS_TRANSFER_READ_BIT | VK_ACCESS_SHADER_READ_BIT | VK_ACCESS_SHADER_WRITE_BIT);
+
+		std::unique_ptr<vk::event> check_event;
+		if (rq.check_out)
+		{
+			rt_ensure_buffer(g_rt.rb, span_size, m_memory_types.host_visible_coherent,
+				VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT | VK_MEMORY_PROPERTY_HOST_COHERENT_BIT, VK_BUFFER_USAGE_TRANSFER_DST_BIT);
+			const VkBufferCopy bc{ 0, 0, snap_len };
+			vkCmdCopyBuffer(cmd, g_rt.span->value, g_rt.rb->value, 1, &bc);
+			vk::insert_global_memory_barrier(cmd, VK_PIPELINE_STAGE_TRANSFER_BIT, VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT | VK_PIPELINE_STAGE_HOST_BIT,
+				VK_ACCESS_TRANSFER_READ_BIT | VK_ACCESS_TRANSFER_WRITE_BIT, VK_ACCESS_SHADER_WRITE_BIT | VK_ACCESS_HOST_READ_BIT);
+		}
+
+		// 3. the A8R8G8B8/D8R8G8B8 decode: one 32-bit byteswap per texel (B8: the bytes as they are), rows at the guest pitch
+		if (rq.bpp == 4)
+		{
+			vk::get_compute_task<vk::cs_shuffle_32>()->run(cmd, g_rt.span.get(), utils::align(linear, 4u));
+			vk::insert_global_memory_barrier(cmd, VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT, VK_PIPELINE_STAGE_TRANSFER_BIT,
+				VK_ACCESS_SHADER_WRITE_BIT, VK_ACCESS_TRANSFER_READ_BIT);
+		}
+
+		VkBufferImageCopy ic{};
+		ic.bufferOffset = 0;
+		ic.bufferRowLength = rq.pitch / rq.bpp;
+		ic.imageSubresource = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1 };
+		ic.imageExtent = { rq.width, rq.height, 1 };
+		e->img->change_layout(cmd, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL);
+		vkCmdCopyBufferToImage(cmd, g_rt.span->value, e->img->value, e->img->current_layout, 1, &ic);
+		e->img->change_layout(cmd, VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL);
+
+		if (rq.check_out)
+		{
+			VkMemoryBarrier2KHR mb =
+			{
+				.sType = VK_STRUCTURE_TYPE_MEMORY_BARRIER_2_KHR,
+				.srcStageMask = VK_PIPELINE_STAGE_2_TRANSFER_BIT_KHR,
+				.srcAccessMask = VK_ACCESS_2_TRANSFER_WRITE_BIT_KHR,
+				.dstStageMask = VK_PIPELINE_STAGE_2_HOST_BIT_KHR,
+				.dstAccessMask = VK_ACCESS_2_HOST_READ_BIT_KHR
+			};
+			check_event = std::make_unique<vk::event>(*m_device, sync_domain::host);
+			check_event->signal(cmd,
+			{
+				.sType = VK_STRUCTURE_TYPE_DEPENDENCY_INFO,
+				.memoryBarrierCount = 1,
+				.pMemoryBarriers = &mb
+			});
+
+			// Submit and wait like flush_set does for a readback
+			prepare_for_dma_transfers(cmd);
+			cleanup_after_dma_transfers(cmd);
+			vk::wait_for_event(check_event.get(), GENERAL_WAIT_TIMEOUT);
+
+			const u8* p = static_cast<const u8*>(g_rt.rb->map(0, snap_len));
+			rq.check_out->assign(p, p + snap_len);
+			g_rt.rb->unmap();
+			vk::get_resource_manager()->dispose(check_event);
+		}
+
+		cmd.r2_invalidate_state_cache();
+		cmd.flags |= vk::command_buffer::cb_reload_dynamic_state;
+
+		e->built = !rq.check_out;
+		e->sig = rq.sig;
+		e->frame = m_r3_frame;
+		e->maps = std::move(maps);
+		e->snap.assign(guest, guest + snap_len);
+
+		auto& s = rbattr::st();
+		s.reint.fetch_add(1, std::memory_order_relaxed);
+		s.reint_bytes.fetch_add(dma_bytes + snap_len, std::memory_order_relaxed);
+
+		static u32 s_logged = 0;
+		if (s_logged < 8)
+		{
+			s_logged++;
+			std::printf("[rt-reint] RSX_RT_GPU_REINTERPRET: texture 0x%08X %ux%u pitch %u fmt 0x%X built on the GPU from %zu surface range(s) "
+				"(%llu DMA bytes, %u guest bytes), no readback\n", rq.address, rq.width, rq.height, rq.pitch, rq.gcm_format, rq.dma.size(),
+				static_cast<unsigned long long>(dma_bytes), snap_len);
+			std::fflush(stdout);
+		}
+
+		return e->img->get_view(remap);
+	}
+
+	vk::image_view* texture_cache::r3_rt_late_serve(vk::command_buffer& /*cmd*/, u32 address, u32 w, u32 h, u32 fmt, u32 pitch, u64 frame,
+		const rsx::texture_channel_remap_t& remap)
+	{
+		if (rsx::get_current_renderer()->get_backend_config().supports_asynchronous_compute)
+		{
+			return nullptr;
+		}
+
+		rt_image* e = rt_find(g_rt.late, address, w, h, fmt, pitch, false);
+		if (!e || !e->img)
+		{
+			return nullptr;
+		}
+
+		if (e->stale_frame != frame)
+		{
+			// Only right after a frame that read it back, and never on two frames in a row
+			if (e->fresh_frame + 1 != frame || e->stale_frame + 1 == frame)
+			{
+				rbattr::st().late_skip.fetch_add(1, std::memory_order_relaxed);
+				return nullptr;
+			}
+			e->stale_frame = frame;
+		}
+
+		return e->img->get_view(remap);
+	}
+
+	void texture_cache::r3_rt_late_store(vk::command_buffer& cmd, u32 address, u32 w, u32 h, u32 fmt, u32 pitch, u64 frame, cached_texture_section* uploaded)
+	{
+		if (rsx::get_current_renderer()->get_backend_config().supports_asynchronous_compute || r2gx::texpack_active)
+		{
+			return;
+		}
+
+		auto src = dynamic_cast<vk::viewable_image*>(uploaded->get_raw_texture());
+		if (!src || src->mipmaps() != 1 || src->layers() != 1 || src->depth() != 1 || !(src->aspect() & VK_IMAGE_ASPECT_COLOR_BIT))
+		{
+			return;
+		}
+
+		rt_image* e = rt_find(g_rt.late, address, w, h, fmt, pitch, true);
+		if (!e)
+		{
+			return;
+		}
+
+		if (!e->img || e->img->format() != src->format() || e->img->width() != src->width() || e->img->height() != src->height() ||
+			e->img->info.flags != src->info.flags)
+		{
+			if (e->img) vk::get_resource_manager()->dispose(e->img);
+			std::vector<VkFormat> fmts;
+			VkFormatEx create_format = src->format();
+			if (src->info.flags & VK_IMAGE_CREATE_MUTABLE_FORMAT_BIT)
+			{
+				const VkFormat snorm_fmt = vk::get_compatible_snorm_format(src->format());
+				const VkFormat srgb_fmt = vk::get_compatible_srgb_format(src->format());
+				if (snorm_fmt != VK_FORMAT_UNDEFINED) fmts.push_back(snorm_fmt);
+				if (srgb_fmt != VK_FORMAT_UNDEFINED) fmts.push_back(srgb_fmt);
+				fmts.push_back(src->format());
+				create_format.pViewFormats = fmts.data();
+				create_format.viewFormatCount = static_cast<u32>(fmts.size());
+			}
+			e->img = std::make_unique<vk::viewable_image>(*m_device, m_memory_types.device_local, VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT,
+				VK_IMAGE_TYPE_2D, create_format, src->width(), src->height(), 1, 1, 1, VK_SAMPLE_COUNT_1_BIT, VK_IMAGE_LAYOUT_UNDEFINED,
+				VK_IMAGE_TILING_OPTIMAL, VK_IMAGE_USAGE_TRANSFER_DST_BIT | VK_IMAGE_USAGE_TRANSFER_SRC_BIT | VK_IMAGE_USAGE_SAMPLED_BIT,
+				src->info.flags & VK_IMAGE_CREATE_MUTABLE_FORMAT_BIT, VMM_ALLOCATION_POOL_TEXTURE_CACHE, src->format_class());
+			e->img->set_debug_name(fmt::format("R3 late copy @0x%x", address));
+		}
+		e->img->native_component_map = src->native_component_map;
+
+		if (vk::is_renderpass_open(cmd))
+		{
+			vk::end_renderpass(cmd);
+		}
+
+		VkImageCopy rg{};
+		rg.srcSubresource = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1 };
+		rg.dstSubresource = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1 };
+		rg.extent = { src->width(), src->height(), 1 };
+		src->push_layout(cmd, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL);
+		e->img->change_layout(cmd, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL);
+		vkCmdCopyImage(cmd, src->value, src->current_layout, e->img->value, e->img->current_layout, 1, &rg);
+		src->pop_layout(cmd);
+		e->img->change_layout(cmd, VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL);
+
+		e->fresh_frame = frame;
+		rbattr::st().late_fresh.fetch_add(1, std::memory_order_relaxed);
+	}
+}
