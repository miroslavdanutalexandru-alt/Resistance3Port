+namespace
+{
+	// Lines are queued and written by a background thread: a pass-log dump (R2_UPS_LOG) is a few hundred lines in
+	// one frame, and a printf + fflush each on the render thread stalled that frame by ~20-100 ms.
+	struct r2log_queue
+	{
+		std::mutex mtx;
+		std::condition_variable cv;
+		std::string buf;
+		bool started = false;
+	};
+	r2log_queue& r2log_q()
+	{
+		static r2log_queue* q = new r2log_queue(); // never destroyed: the writer thread outlives static teardown
+		return *q;
+	}
+	void r2log(const char* fmt, ...)
+	{
+		char buf[1024];
+		va_list ap;
+		va_start(ap, fmt);
+		std::vsnprintf(buf, sizeof(buf), fmt, ap);
+		va_end(ap);
+		auto& q = r2log_q();
+		std::lock_guard lock(q.mtx);
+		q.buf += "[r2aa] ";
+		q.buf += buf;
+		q.buf += '\n';
+		if (!q.started)
+		{
+			q.started = true;
+			std::thread([]
+			{
+				auto& q = r2log_q();
+				std::string out;
+				for (;;)
+				{
+					{
+						std::unique_lock lock(q.mtx);
+						q.cv.wait_for(lock, std::chrono::milliseconds(50), [&] { return q.buf.size() > (256u << 10); });
+						out.swap(q.buf);
+					}
+					if (!out.empty())
+					{
+						std::fwrite(out.data(), 1, out.size(), stdout);
+						std::fflush(stdout);
+						out.clear();
+					}
+				}
+			}).detach();
+		}
+		else if (q.buf.size() > (256u << 10))
+		{
+			q.cv.notify_one();
+		}
+	}
