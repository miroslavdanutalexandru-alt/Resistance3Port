+	st.depth->change_layout(cmd, VK_IMAGE_LAYOUT_GENERAL);
+	st.mv->change_layout(cmd, VK_IMAGE_LAYOUT_GENERAL);
+	st.mask->change_layout(cmd, VK_IMAGE_LAYOUT_GENERAL);
+	st.depth_prev->change_layout(cmd, VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL);
