+	};
+	// RSX_AA_POST_STABLE: per texel, the locked value while it and the current value each stay inside the other's
+	// neighbourhood range (static content seen at another jitter phase), else the current one (it moved or appeared); the
+	// lock is read-only (refreshed by a copy at its own phase); both buffers hold the surface's texels
+	// (4 bytes: mode 0 D24 in the low 24 bits, 1 float, 2 RGBA8 unorm, 3 RG16F; packed: 4 16-bit unorm, 5 8-bit unorm)
+	struct r2aa_pstab_pass : compute_task
+	{
+		const vk::buffer* cur = nullptr;
+		const vk::buffer* lck = nullptr;
+		const vk::buffer* out = nullptr;
+
+		r2aa_pstab_pass()
+		{
+			m_src =
+				"#version 450\n"
+				"layout(local_size_x = 8, local_size_y = 8) in;\n"
+				"layout(std430, set=0, binding=0) readonly buffer Cur { uint cur[]; };\n"
+				"layout(std430, set=0, binding=1) readonly buffer Lck { uint lck[]; };\n"
+				"layout(std430, set=0, binding=2) writeonly buffer Out { uint outv[]; };\n"
+				// w, h, mode, radius
+				"layout(push_constant) uniform PC { uvec4 opts; };\n"
+				"vec4 dec(uint v)\n"
+				"{\n"
+				"	if (opts.z == 0u) return vec4(float(v & 0xFFFFFFu) / 16777215.0, 0.0, 0.0, 0.0);\n"
+				"	if (opts.z == 1u) return vec4(uintBitsToFloat(v), 0.0, 0.0, 0.0);\n"
+				"	if (opts.z == 2u) return unpackUnorm4x8(v);\n"
+				"	return vec4(unpackHalf2x16(v), 0.0, 0.0);\n"
+				"}\n"
+				"void main()\n"
+				"{\n"
+				"	ivec2 p = ivec2(gl_GlobalInvocationID.xy);\n"
+				"	ivec2 sz = ivec2(opts.xy);\n"
+				"	if (any(greaterThanEqual(p, sz))) return;\n"
+				"	uint i = uint(p.y) * opts.x + uint(p.x);\n"
+				"	if (opts.z >= 4u)\n"
+				"	{\n"
+				"		uint per = opts.z == 4u ? 2u : 4u, bits = 32u / per, m = (1u << bits) - 1u;\n"
+				"		uint total = opts.x * opts.y;\n"
+				"		if (i >= (total + per - 1u) / per) return;\n"
+				"		uint cw = cur[i], lw = lck[i], ow = 0u;\n"
+				"		int r = int(opts.w & 0xFFu);\n"
+				"		for (uint k = 0u; k < per; ++k)\n"
+				"		{\n"
+				"			uint t = i * per + k, sh = k * bits;\n"
+				"			if (t >= total) { ow |= cw & (m << sh); continue; }\n"
+				"			ivec2 pt = ivec2(int(t % opts.x), int(t / opts.x));\n"
+				"			float lv = float((lw >> sh) & m), cv = float((cw >> sh) & m);\n"
+				"			float lo = 1e30, hi = -1e30, llo = 1e30, lhi = -1e30;\n"
+				"			for (int y = -r; y <= r; ++y)\n"
+				"				for (int x = -r; x <= r; ++x)\n"
+				"				{\n"
+				"					ivec2 q = clamp(pt + ivec2(x, y), ivec2(0), sz - 1);\n"
+				"					uint tq = uint(q.y) * opts.x + uint(q.x);\n"
+				"					uint qs = (tq % per) * bits;\n"
+				"					float v = float((cur[tq / per] >> qs) & m), u = float((lck[tq / per] >> qs) & m);\n"
+				"					lo = min(lo, v); hi = max(hi, v); llo = min(llo, u); lhi = max(lhi, u);\n"
+				"				}\n"
+				"			float tt = (hi - lo) * 0.125 + 1.5, lt = (lhi - llo) * 0.125 + 1.5;\n"
+				"			bool keep = lv >= lo - tt && lv <= hi + tt && cv >= llo - lt && cv <= lhi + lt;\n"
+				"			ow |= (keep ? lw : cw) & (m << sh);\n"
+				"		}\n"
+				"		outv[i] = ow;\n"
+				"		return;\n"
+				"	}\n"
+				"	uint c = cur[i];\n"
+				"	uint l = lck[i];\n"
+				"	vec4 lv = dec(l), cv = dec(c);\n"
+				"	vec4 lo = vec4(1e30), hi = vec4(-1e30), llo = vec4(1e30), lhi = vec4(-1e30);\n"
+				"	int r = int(opts.w & 0xFFu);\n"
+				"	for (int y = -r; y <= r; ++y)\n"
+				"		for (int x = -r; x <= r; ++x)\n"
+				"		{\n"
+				"			ivec2 q = clamp(p + ivec2(x, y), ivec2(0), sz - 1);\n"
+				"			uint qi = uint(q.y) * opts.x + uint(q.x);\n"
+				"			vec4 v = dec(cur[qi]), u = dec(lck[qi]);\n"
+				"			lo = min(lo, v); hi = max(hi, v); llo = min(llo, u); lhi = max(lhi, u);\n"
+				"		}\n"
+				"	vec4 e = opts.z == 0u ? vec4(2e-6) : opts.z == 1u ? abs(lv) * 1e-5 + 1e-7 : opts.z == 2u ? vec4(1.5 / 255.0) : abs(lv) * 1e-3 + 1e-4;\n"
+				"	vec4 t = (hi - lo) * 0.125 + e, lt = (lhi - llo) * 0.125 + e;\n"
+				// both ways: the lock fits the current neighbourhood (static content at another phase) and the current value fits
+				// the lock's (else a thin new thing, e.g. a particle, inside the range would be replaced by the locked background)
+				"	bool keep = all(greaterThanEqual(lv, lo - t)) && all(lessThanEqual(lv, hi + t)) && all(greaterThanEqual(cv, llo - lt)) &&\n"
+				"		all(lessThanEqual(cv, lhi + lt)) && !any(isnan(lv));\n"
+				// RSX_AA_POST_STABLE_THIN (opts.w bit 8, depth modes): a mismatch thinner than the jitter footprint along x or y
+				// (both texels r away unchanged: inside the other's range and close to their locked value) is a sub-pixel
+				// feature the jittered samples cover only at some phases: keep the lock
+				"	if (!keep && (opts.w & 0x100u) != 0u && opts.z <= 1u && !isnan(lv.x))\n"
+				"	{\n"
+				"		float tol = max(t.x, lt.x);\n"
+				"		for (int ax = 0; ax < 2 && !keep; ++ax)\n"
+				"		{\n"
+				"			ivec2 d = ax == 0 ? ivec2(r, 0) : ivec2(0, r);\n"
+				"			bool ok = true;\n"
+				"			for (int sgn = -1; sgn <= 1; sgn += 2)\n"
+				"			{\n"
+				"				ivec2 q = clamp(p + d * sgn, ivec2(0), sz - 1);\n"
+				"				uint qi = uint(q.y) * opts.x + uint(q.x);\n"
+				"				float v = dec(cur[qi]).x, u = dec(lck[qi]).x;\n"
+				"				ok = ok && q != p && abs(v - u) <= tol && v >= llo.x - lt.x && v <= lhi.x + lt.x && u >= lo.x - t.x && u <= hi.x + t.x;\n"
+				"			}\n"
+				"			keep = ok;\n"
+				"		}\n"
+				"	}\n"
+				"	uint o = keep ? l : c;\n"
+				"	if (opts.z == 0u) o = (o & 0xFFFFFFu) | (c & 0xFF000000u);\n"
+				"	outv[i] = o;\n"
+				"}\n";
+			ssbo_count = 0;
+			use_push_constants = true;
+			push_constants_size = 16;
+			create();
+		}
+
+		std::vector<glsl::program_input> get_inputs() override
+		{
+			auto result = compute_task::get_inputs();
+			result.push_back(glsl::program_input::make(::glsl::program_domain::glsl_compute_program, "Cur", vk::glsl::input_type_storage_buffer, 0, 0));
+			result.push_back(glsl::program_input::make(::glsl::program_domain::glsl_compute_program, "Lck", vk::glsl::input_type_storage_buffer, 0, 1));
+			result.push_back(glsl::program_input::make(::glsl::program_domain::glsl_compute_program, "Out", vk::glsl::input_type_storage_buffer, 0, 2));
+			return result;
+		}
+
+		void bind_resources(const vk::command_buffer&) override
+		{
+			m_program->bind_uniform({ *cur, 0, cur->size() }, 0, 0);
+			m_program->bind_uniform({ *lck, 0, lck->size() }, 0, 1);
+			m_program->bind_uniform({ *out, 0, out->size() }, 0, 2);
+		}
+
+		void run(const vk::command_buffer& cmd, const u32* constants, u32 w, u32 h)
+		{
+			if (!m_program) load_program(cmd);
+			vkCmdPushConstants(cmd, m_program->layout(), VK_SHADER_STAGE_COMPUTE_BIT, 0, push_constants_size, constants);
+			compute_task::run(cmd, (w + 7) / 8, (h + 7) / 8, 1);
+		}
+	};
+	// RSX_AA_POST_DEJITTER: the surface resampled at p + shift (its jittered content sits at +jitter): depth / R32F
+	// bilinear inside a surface (exact for planes: device depth is affine in screen space), the nearest texel across a
+	// depth edge (never a blend of foreground and background); colour bilinear unless a channel jumps (packed flags)
+	// (4 bytes: mode 0 D24 in the low 24 bits, 1 float, 2 RGBA8 unorm, 3 RG16F)
+	struct r2aa_dejit_pass : compute_task
+	{
+		const vk::buffer* cur = nullptr;
+		const vk::buffer* out = nullptr;
+
+		r2aa_dejit_pass()
+		{
+			m_src =
+				"#version 450\n"
+				"layout(local_size_x = 8, local_size_y = 8) in;\n"
+				"layout(std430, set=0, binding=0) readonly buffer Cur { uint cur[]; };\n"
+				// Out holds last frame's output for this surface on entry (read only at this texel: RSX_AA_POST_DEJITTER_STICKY)
+				"layout(std430, set=0, binding=1) buffer Out { uint outv[]; };\n"
+				// w, h, mode, edge key (0: 1 - device depth, 1: inverted device depth, 2: |value|); shift x, y (texels),
+				// depth edge ratio, colour edge
+				// grid: x, y = surface size over the jittered source's (RSX_AA_POST_DEJITTER_GRID; 1 = none); z = 1: Out is
+				// last frame's output (sticky depth edges)
+				"layout(push_constant) uniform PC { uvec4 opts; vec4 sh; vec4 grid; };\n"
+				"vec4 dec(uint v)\n"
+				"{\n"
+				"	if (opts.z == 0u) return vec4(float(v & 0xFFFFFFu) / 16777215.0, 0.0, 0.0, 0.0);\n"
+				"	if (opts.z == 1u) return vec4(uintBitsToFloat(v), 0.0, 0.0, 0.0);\n"
+				"	if (opts.z == 2u) return unpackUnorm4x8(v);\n"
+				"	return vec4(unpackHalf2x16(v), 0.0, 0.0);\n"
+				"}\n"
+				"float key(uint v) { float x = dec(v).x; return opts.w == 0u ? 1.0 - x : abs(x); }\n"
+				"uint at(ivec2 q) { q = clamp(q, ivec2(0), ivec2(opts.xy) - 1); return cur[uint(q.y) * opts.x + uint(q.x)]; }\n"
+				"uint dm(uint v) { return opts.z == 0u ? (v & 0xFFFFFFu) : v; }\n"
+				// along this axis the surface is a nearest-upscaled copy of the jittered grid (equal neighbours)
+				"bool stair(ivec2 p, ivec2 d)\n"
+				"{\n"
+				"	uint a = dm(at(p - 2 * d)), b = dm(at(p - d)), c = dm(at(p)), e = dm(at(p + d)), g = dm(at(p + 2 * d));\n"
+				"	return a == b || b == c || c == e || e == g;\n"
+				"}\n"
+				// the texel holding source-grid index q (either rounding of the upscale copy)
+				"int xm(int q, float r) { return r > 1.0 ? int(floor((float(q) + 0.5) * r)) : q; }\n"
+				"void main()\n"
+				"{\n"
+				"	ivec2 p = ivec2(gl_GlobalInvocationID.xy);\n"
+				"	if (any(greaterThanEqual(p, ivec2(opts.xy)))) return;\n"
+				"	uint i = uint(p.y) * opts.x + uint(p.x);\n"
+				// staircase axes are resampled in source-grid units (the jittered plane evaluated at this texel's centre);
+				// r = 1 is the plain resample at p + shift
+				"	vec2 r = vec2(1.0);\n"
+				"	if (opts.z <= 1u)\n"
+				"	{\n"
+				"		if (grid.x > 1.0 && stair(p, ivec2(1, 0))) r.x = grid.x;\n"
+				"		if (grid.y > 1.0 && stair(p, ivec2(0, 1))) r.y = grid.y;\n"
+				"	}\n"
+				"	vec2 sp = (vec2(p) + 0.5) / r - 0.5 + sh.xy / r;\n"
+				"	ivec2 b = ivec2(floor(sp));\n"
+				"	vec2 f = sp - vec2(b);\n"
+				"	ivec2 x0 = ivec2(xm(b.x, r.x), xm(b.y, r.y)), x1 = ivec2(xm(b.x + 1, r.x), xm(b.y + 1, r.y));\n"
+				"	ivec2 bn = ivec2(floor(sp + 0.5));\n"
+				"	uint c = cur[i];\n"
+				"	uint t00 = at(x0), t10 = at(ivec2(x1.x, x0.y)), t01 = at(ivec2(x0.x, x1.y)), t11 = at(x1);\n"
+				"	uint n = at(ivec2(xm(bn.x, r.x), xm(bn.y, r.y)));\n"
+				"	uint o;\n"
+				"	if (opts.z <= 1u)\n"
+				"	{\n"
+				"		float k0 = key(t00), k1 = key(t10), k2 = key(t01), k3 = key(t11);\n"
+				"		float lo = min(min(k0, k1), min(k2, k3)), hi = max(max(k0, k1), max(k2, k3));\n"
+				"		if (!(hi <= lo * (1.0 + sh.z) + 1e-7)) o = n;\n"
+				"		else if (opts.z == 0u)\n"
+				"		{\n"
+				// in D24 units relative to one tap (exact integers below 2^24)
+				"			int a = int(t00 & 0xFFFFFFu);\n"
+				"			float d10 = float(int(t10 & 0xFFFFFFu) - a), d01 = float(int(t01 & 0xFFFFFFu) - a), d11 = float(int(t11 & 0xFFFFFFu) - a);\n"
+				"			float v = mix(mix(0.0, d10, f.x), mix(d01, d11, f.x), f.y);\n"
+				"			o = uint(clamp(a + int(round(v)), 0, 16777215));\n"
+				"		}\n"
+				"		else if (opts.w == 2u && grid.w > 0.5)\n"
+				// |value| edge key (signed per-pixel flags, e.g. R3 linear depth): blend magnitudes, keep the nearest tap's sign
+				// (RSX_AA_DEJIT_SIGNED, default 1; a plain signed blend of +d / -d taps is garbage)
+				"		{\n"
+				"			float v = mix(mix(abs(dec(t00).x), abs(dec(t10).x), f.x), mix(abs(dec(t01).x), abs(dec(t11).x), f.x), f.y);\n"
+				"			o = (floatBitsToUint(dec(n).x) & 0x80000000u) | (floatBitsToUint(v) & 0x7FFFFFFFu);\n"
+				"		}\n"
+				"		else o = floatBitsToUint(mix(mix(dec(t00).x, dec(t10).x, f.x), mix(dec(t01).x, dec(t11).x, f.x), f.y));\n"
+				// across a depth edge from last frame's output: the nearest tap within 3x3 on last frame's side
+				"		if (grid.z > 0.5)\n"
+				"		{\n"
+				"			float pk = key(outv[i]), ok = key(o);\n"
+				"			if (!(max(ok, pk) <= min(ok, pk) * (1.0 + sh.z) + 1e-7))\n"
+				"			{\n"
+				"				float bd = 1e30;\n"
+				"				for (int dy = -1; dy <= 1; dy++)\n"
+				"				for (int dx = -1; dx <= 1; dx++)\n"
+				"				{\n"
+				"					ivec2 q = bn + ivec2(dx, dy);\n"
+				"					uint t = at(ivec2(xm(q.x, r.x), xm(q.y, r.y)));\n"
+				"					float kt = key(t);\n"
+				"					vec2 dd = vec2(q) - sp;\n"
+				"					float d2 = dot(dd, dd);\n"
+				"					if (max(kt, pk) <= min(kt, pk) * (1.0 + sh.z) + 1e-7 && d2 < bd) { bd = d2; o = t; }\n"
+				"				}\n"
+				"			}\n"
+				"		}\n"
+				"	}\n"
+				"	else\n"
+				"	{\n"
+				"		vec4 a0 = dec(t00), a1 = dec(t10), a2 = dec(t01), a3 = dec(t11);\n"
+				"		vec4 rg = max(max(a0, a1), max(a2, a3)) - min(min(a0, a1), min(a2, a3));\n"
+				"		if (any(greaterThan(rg, vec4(sh.w))) || any(isnan(rg))) o = n;\n"
+				"		else\n"
+				"		{\n"
+				"			vec4 v = mix(mix(a0, a1, f.x), mix(a2, a3, f.x), f.y);\n"
+				"			o = opts.z == 2u ? packUnorm4x8(v) : packHalf2x16(v.xy);\n"
+				"		}\n"
+				"	}\n"
+				"	if (opts.z == 0u) o = (o & 0xFFFFFFu) | (c & 0xFF000000u);\n"
+				"	outv[i] = o;\n"
+				"}\n";
+			ssbo_count = 0;
+			use_push_constants = true;
+			push_constants_size = 48;
+			create();
+		}
+
+		std::vector<glsl::program_input> get_inputs() override
+		{
+			auto result = compute_task::get_inputs();
+			result.push_back(glsl::program_input::make(::glsl::program_domain::glsl_compute_program, "Cur", vk::glsl::input_type_storage_buffer, 0, 0));
+			result.push_back(glsl::program_input::make(::glsl::program_domain::glsl_compute_program, "Out", vk::glsl::input_type_storage_buffer, 0, 1));
+			return result;
+		}
+
+		void bind_resources(const vk::command_buffer&) override
+		{
+			m_program->bind_uniform({ *cur, 0, cur->size() }, 0, 0);
+			m_program->bind_uniform({ *out, 0, out->size() }, 0, 1);
+		}
+
+		void run(const vk::command_buffer& cmd, const u32* constants, u32 w, u32 h)
+		{
+			if (!m_program) load_program(cmd);
+			vkCmdPushConstants(cmd, m_program->layout(), VK_SHADER_STAGE_COMPUTE_BIT, 0, push_constants_size, constants);
+			compute_task::run(cmd, (w + 7) / 8, (h + 7) / 8, 1);
+		}
+	};
+}
