+					dp->cur = e.cur.get();
+					dp->out = e.out.get();
+					const r2aa_state::jd_shift_t& dj = dsh->second;
+					const bool grid = r2cfg().post_dejit_grid && mode <= 1;
+					const float grx = grid && dj.gw && dj.gw < w ? float(w) / float(dj.gw) : 1.f;
