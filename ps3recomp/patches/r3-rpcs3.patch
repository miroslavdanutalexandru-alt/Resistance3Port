+	st.depth_prev_valid = ok;
+	if (!ok) return;
+
+	vk::insert_global_memory_barrier(cmd);
+
+	// 3. Result (+ original alpha) -> scene colour target
+	st.out->change_layout(cmd, VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL);
+	st.final_img->change_layout(cmd, VK_IMAGE_LAYOUT_GENERAL);
+	const float mpc[8] = { swap ? 1.f : 0.f, static_cast<float>(ow), static_cast<float>(oh), static_cast<float>(r2cfg().view),
+		static_cast<float>(rw) / ow, static_cast<float>(rh) / oh, 50.f, st.inverted ? 1.f : 0.f };
+	if (half)
+	{
+		auto merge = vk::get_compute_task<vk::r2aa_merge_pass<true>>();
+		merge->in_result = plain_view(st.out.get());
+		merge->in_orig = plain_view(st.color.get());
+		merge->out_final = plain_view(st.final_img.get());
+		merge->in_mv = plain_view(st.mv.get());
+		merge->in_mask = plain_view(st.mask.get());
+		merge->in_depth = plain_view(st.depth_prev.get()); // this frame's depth (swapped above)
+		merge->run(cmd, mpc, ow, oh);
+	}
+	else
+	{
+		auto merge = vk::get_compute_task<vk::r2aa_merge_pass<false>>();
+		merge->in_result = plain_view(st.out.get());
+		merge->in_orig = plain_view(st.color.get());
+		merge->out_final = plain_view(st.final_img.get());
+		merge->in_mv = plain_view(st.mv.get());
+		merge->in_mask = plain_view(st.mask.get());
+		merge->in_depth = plain_view(st.depth_prev.get()); // this frame's depth (swapped above)
+		merge->run(cmd, mpc, ow, oh);
