+		if (!ok && !vk::r2xess::usable()) st.res_w = 0;
+	}
+#ifdef R2PORT_HAVE_FFX
+	else if (st.backend == 1)
+	{
+		ffxDispatchDescUpscale d{};
+		d.header.type = FFX_API_DISPATCH_DESC_TYPE_UPSCALE;
+		d.commandList = static_cast<VkCommandBuffer>(cmd);
+		d.color = ffx_res(st.color.get(), FFX_API_RESOURCE_USAGE_READ_ONLY, FFX_API_RESOURCE_STATE_COMPUTE_READ);
+		d.depth = ffx_res(st.depth.get(), FFX_API_RESOURCE_USAGE_READ_ONLY, FFX_API_RESOURCE_STATE_COMPUTE_READ);
+		d.motionVectors = ffx_res(st.mv.get(), FFX_API_RESOURCE_USAGE_READ_ONLY, FFX_API_RESOURCE_STATE_COMPUTE_READ);
