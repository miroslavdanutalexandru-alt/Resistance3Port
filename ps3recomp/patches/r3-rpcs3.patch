+	vk::image_view* plain_view(vk::viewable_image* img)
+	{
+		return img->get_view(rsx::default_remap_vector.with_encoding(vk::VK_REMAP_IDENTITY), VK_IMAGE_ASPECT_COLOR_BIT);
+	}
+
+	// RSX_AA_PRECREATE: the scene size of the last session, to create the upscaler before the first scene
+	void save_last_size(u32 rw, u32 rh, u32 ow, u32 oh, VkFormat fmt, bool inverted)
+	{
+		if (!r2cfg().precreate) return;
+		static u32 last[6] = {};
+		const u32 v[6] = { rw, rh, ow, oh, static_cast<u32>(fmt), inverted ? 1u : 0u };
+		if (!std::memcmp(last, v, sizeof(v))) return;
+		std::memcpy(last, v, sizeof(v));
+		if (FILE* f = _wfopen((exe_dir() + L"\\r2aa_size.txt").c_str(), L"w"))
+		{
+			std::fprintf(f, "%u %u %u %u %u %u %d\n", rw, rh, ow, oh, v[4], v[5], r2cfg().mode);
+			std::fclose(f);
+		}
+	}
+
+	bool load_last_size(u32 (&v)[6])
+	{
+		FILE* f = _wfopen((exe_dir() + L"\\r2aa_size.txt").c_str(), L"r");
+		if (!f) return false;
+		int mode = -1;
+		const bool ok = std::fscanf(f, "%u %u %u %u %u %u %d", &v[0], &v[1], &v[2], &v[3], &v[4], &v[5], &mode) == 7;
+		std::fclose(f);
+		return ok && mode == r2cfg().mode && v[0] >= 16 && v[1] >= 16 && v[0] <= 8192 && v[1] <= 8192 && v[2] >= v[0] && v[3] >= v[1] &&
+			v[2] <= 16384 && v[3] <= 16384;
+	}
+
+	// The upscaler's compute passes, compiled on a worker at the first flip instead of at the first scene
+	std::atomic<int> g_warm{ 0 }; // 0 not started, 1 compiling, 2 done
+
+	void warm_compile(vk::compute_task* t)
+	{
+		if (t->m_program) return;
+		t->m_shader.create(::glsl::program_domain::glsl_compute_program, t->m_src);
+		const auto handle = t->m_shader.compile();
+		VkComputePipelineCreateInfo info{ VK_STRUCTURE_TYPE_COMPUTE_PIPELINE_CREATE_INFO };
+		info.stage.sType = VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO;
+		info.stage.stage = VK_SHADER_STAGE_COMPUTE_BIT;
+		info.stage.module = handle;
+		info.stage.pName = "main";
+		t->m_program = vk::get_pipe_compiler()->compile(info, vk::pipe_compiler::COMPILE_INLINE, {}, t->get_inputs());
+	}
+
+	void warm_begin()
+	{
+		if (g_warm.load() != 0) return;
+		g_warm = 1;
+		// Created here (render thread); only their programs are built on the worker. r2aa_run waits for it.
+		vk::compute_task* tasks[3] = { vk::get_compute_task<vk::r2aa_prep_pass>(), vk::get_compute_task<vk::r2aa_merge_pass<true>>(),
+			vk::get_compute_task<vk::r2aa_merge_pass<false>>() };
+		std::thread([t0 = tasks[0], t1 = tasks[1], t2 = tasks[2]]
+		{
+			warm_compile(t0);
+			warm_compile(t1);
+			warm_compile(t2);
+			g_warm = 2;
+		}).detach();
+	}
+
+	void warm_wait()
+	{
+		while (g_warm.load() == 1) std::this_thread::yield();
+	}
+
+#ifdef R2PORT_HAVE_FFX
+	FfxApiResource ffx_res(vk::viewable_image* img, uint32_t usage, uint32_t state)
+	{
+		return ffxApiGetResourceVK(reinterpret_cast<void*>(img->value), ffxApiGetImageResourceDescriptionVK(img->value, img->info, usage), state);
+	}
+#endif
+}
+
+// RSX_AA_PRECREATE: at the first flips (boot logos), compile the compute passes and create the upscaler with the
+// size the last session used, so the first scene does not stall on them
+void VKGSRender::r2aa_precreate()
+{
+	auto& st = g_r2;
+	if (st.precreated || st.disabled) return;
+	st.precreated = true;
+	if (!r2cfg().precreate) return;
+	warm_begin();
+	u32 v[6];
+	if (st.backend || !load_last_size(v)) return;
+	const VkFormat fmt = static_cast<VkFormat>(v[4]);
+	if (fmt != VK_FORMAT_R16G16B16A16_SFLOAT && fmt != VK_FORMAT_B8G8R8A8_UNORM && fmt != VK_FORMAT_R8G8B8A8_UNORM) return;
+	if (vk::is_renderpass_open(*m_current_command_buffer)) vk::end_renderpass(*m_current_command_buffer);
+	st.inverted = v[5] != 0;
+	r2log("pre-creating the upscaler for %ux%u -> %ux%u (last session's scene)", v[0], v[1], v[2], v[3]);
+	r2aa_create(v[0], v[1], v[2], v[3], fmt);
+}
+
+// The images and upscaler context for a rw x rh -> ow x oh scene (also used to pre-create them, r2aa_precreate)
+bool VKGSRender::r2aa_create(u32 rw, u32 rh, u32 ow, u32 oh, VkFormat cfmt)
+{
+	auto& st = g_r2;
+	const bool half = cfmt == VK_FORMAT_R16G16B16A16_SFLOAT;
+	if (st.backend)
+	{
+		flush_command_queue(true);
+		release_backend();
+	}
+	auto dispose = [](std::unique_ptr<vk::viewable_image>& img) { if (img) vk::get_resource_manager()->dispose(img); };
+	dispose(st.color); dispose(st.depth); dispose(st.mv); dispose(st.out); dispose(st.final_img); dispose(st.depth_prev); dispose(st.mask);
+
+	const VkImageUsageFlags rw_usage = VK_IMAGE_USAGE_SAMPLED_BIT | VK_IMAGE_USAGE_STORAGE_BIT;
+	st.color = make_image(VK_FORMAT_R16G16B16A16_SFLOAT, rw, rh, rw_usage);
+	st.depth = make_image(VK_FORMAT_R32_SFLOAT, rw, rh, rw_usage);
+	st.depth_prev = make_image(VK_FORMAT_R32_SFLOAT, rw, rh, rw_usage);
+	st.mask = make_image(VK_FORMAT_R8_UNORM, rw, rh, rw_usage);
+	st.depth_prev_valid = false;
+	st.mv = make_image(VK_FORMAT_R16G16_SFLOAT, rw, rh, rw_usage);
+	st.out = make_image(VK_FORMAT_R16G16B16A16_SFLOAT, ow, oh, rw_usage);
+	st.final_img = make_image(half ? VK_FORMAT_R16G16B16A16_SFLOAT : VK_FORMAT_R8G8B8A8_UNORM, ow, oh,
+		VK_IMAGE_USAGE_STORAGE_BIT | VK_IMAGE_USAGE_TRANSFER_SRC_BIT);
+	st.res_w = rw;
+	st.res_h = rh;
+	st.res_ow = ow;
+	st.res_oh = oh;
+	st.res_fmt = cfmt;
+	st.res_inverted = st.inverted;
+	st.need_reset = true;
+	st.reset_why |= 2;
+
+	auto& ccmd = *m_current_command_buffer;
+	if (r2cfg().mode == 2 && g_dlss.dll && !g_dlss.failed)
+	{
+		if (!g_dlss.usable)
+		{
+			const std::wstring dir = exe_dir();
+			const auto& gpu = m_device->gpu();
+			g_dlss.usable = g_dlss.init(static_cast<VkInstance>(gpu), static_cast<VkPhysicalDevice>(gpu), *m_device,
+				vkGetInstanceProcAddr, vkGetDeviceProcAddr, dir.c_str(), dlss_log) == 1;
+			if (!g_dlss.usable)
+			{
+				g_dlss.failed = true;
+				r2aa_fallback(2, "NGX reports DLSS unavailable: non-RTX GPU, old driver or no nvngx_dlss.dll");
+			}
+		}
+		if (g_dlss.usable)
+		{
+			if (g_dlss.create(ccmd, rw, rh, ow, oh, (st.inverted ? 1 : 0) | (half ? 2 : 0), r2cfg().preset) == 1)
+			{
+				st.backend = 2;
+				r2log("%s active at %ux%u -> %ux%u (%s depth, %s)", ow > rw ? "DLSS" : "DLAA", rw, rh, ow, oh, st.inverted ? "inverted" : "standard", half ? "FP16" : "8-bit");
+				// nvsdk_ngx_defs.h (SDK 310.x): preset 0 = K (transformer) for DLAA/Quality/Balanced, M (transformer 2) for
+				// Performance, L for Ultra Performance; RSX_DLSS_PRESET=11 forces K, 13 M
+				const float ratio = static_cast<float>(rw) / static_cast<float>(std::max(ow, 1u));
+				const unsigned pr = r2cfg().preset;
+				r2log("DLSS preset %u = %s (RSX_DLSS_PRESET)", pr, pr ? (pr == 11 ? "K transformer" : pr == 12 ? "L transformer" : pr == 13 ? "M transformer" : pr == 10 ? "J transformer" : "legacy/other") :
+					ratio > 0.54f ? "NVIDIA default: K transformer" : ratio > 0.42f ? "NVIDIA default: M transformer (Performance)" : "NVIDIA default: L transformer (Ultra Performance)");
+			}
+			else
+			{
+				g_dlss.failed = true;
+				r2aa_fallback(2, "DLSS feature creation failed");
+			}
+		}
+	}
+
+	if (r2cfg().mode == 4 && vk::r2xess::usable())
+	{
+		const auto& gpu = m_device->gpu();
+		if (vk::r2xess::create(static_cast<VkInstance>(gpu), static_cast<VkPhysicalDevice>(gpu), *m_device, rw, rh, ow, oh,
+			(st.inverted ? 1 : 0) | (half ? 2 : 0)))
+		{
+			st.backend = 3;
+			r2log("Intel XeSS %s active at %ux%u -> %ux%u (%s depth, %s)", vk::r2xess::quality_name(), rw, rh, ow, oh,
+				st.inverted ? "inverted" : "standard", half ? "FP16" : "8-bit");
+		}
+	}
+
+#ifdef R2PORT_HAVE_FFX
+	if (!st.backend && g_ffx.dll && !g_ffx.failed)
+	{
+		ffxCreateBackendVKDesc be{};
+		be.header.type = FFX_API_CREATE_CONTEXT_DESC_TYPE_BACKEND_VK;
+		be.vkDevice = *m_device;
+		be.vkPhysicalDevice = m_device->gpu();
+		be.vkDeviceProcAddr = vkGetDeviceProcAddr;
+
+		ffxCreateContextDescUpscale cd{};
+		cd.header.type = FFX_API_CREATE_CONTEXT_DESC_TYPE_UPSCALE;
+		cd.header.pNext = &be.header;
+		cd.flags = (half ? (FFX_UPSCALE_ENABLE_HIGH_DYNAMIC_RANGE | FFX_UPSCALE_ENABLE_AUTO_EXPOSURE) : FFX_UPSCALE_ENABLE_NON_LINEAR_COLORSPACE) |
+			(st.inverted ? FFX_UPSCALE_ENABLE_DEPTH_INVERTED : 0);
+		cd.maxRenderSize = { rw, rh };
+		cd.maxUpscaleSize = { ow, oh };
+		cd.fpMessage = ffx_message;
+		const ffxReturnCode_t rc = g_ffx.create(&g_ffx.ctx, &cd.header, nullptr);
+		if (rc == FFX_API_RETURN_OK)
+		{
+			st.backend = 1;
+			r2log("FSR 3.1 active at %ux%u -> %ux%u (%s depth, %s)", rw, rh, ow, oh, st.inverted ? "inverted" : "standard", half ? "FP16" : "8-bit");
+		}
+		else
+		{
+			g_ffx.failed = true;
+			g_ffx.ctx = nullptr;
+			r2log("FSR 3.1 context creation failed (code %u)", rc);
+		}
+	}
+#endif
+	if (!st.backend)
+	{
+		st.disabled = true;
+		r2aa_fallback(1, "no upscaler could be created");
+		return false;
+	}
+	return true;
+}
+
+namespace
+{
+	// RSX_DLSS_OBJMV=1: velocity pipelines. The draw's own vertex shader turned into a two-pass variant (om2_make_vs),
+	// a fragment shader writing current - previous NDC, the game's vertex set layout + ours. Built on a worker thread;
+	// until a pipeline is ready its draws keep camera motion. The render thread never waits for it.
+	constexpr u32 om2_loc = 20; // varying locations 20/21: RPCS3 uses 0-17
+	constexpr VkFormat om2_format = VK_FORMAT_R16G16B16A16_SFLOAT;
+
+	bool om2_make_vs(std::string& s)
+	{
+		auto rep = [&](std::string_view a, std::string_view b)
+		{
+			const usz p = s.find(a);
+			if (p == std::string::npos) return false;
+			s.replace(p, a.size(), b);
+			return true;
+		};
+		if (s.find("gl_Position = dst_reg0;") == std::string::npos) return false;
+		const std::string decl =
+			"layout(std430, set=1, binding=0) readonly restrict buffer R2ObjMV { uvec4 r2om[]; };\n"
+			"bool r2om_prev = false;\n"
+			"layout(location=" + std::to_string(om2_loc) + ") out vec4 r2om_cur;\n"
+			"layout(location=" + std::to_string(om2_loc + 1) + ") out vec4 r2om_old;\n"
+			"#define draw_parameters_offset r2om[uint(gl_BaseInstanceARB)].x\n";
+		return rep("#define draw_parameters_offset uint(gl_BaseInstanceARB)\n", decl) &&
+			rep("#define _fetch_constant(x) vc[(x) + xform_constants_offset]",
+				"#define _fetch_constant(x) (r2om_prev ? uintBitsToFloat(r2om[(x) + xform_constants_offset]) : vc[(x) + xform_constants_offset])") &&
+			rep("uint xform_constants_offset = get_draw_params().xform_constants_offset;",
+				"uint xform_constants_offset = r2om_prev ? r2om[uint(gl_BaseInstanceARB)].y : get_draw_params().xform_constants_offset;") &&
+			rep("\tvs_main();\n", "\tr2om_prev = true;\n\tvs_main();\n\tvec4 r2om_pp = dst_reg0;\n\tr2om_prev = false;\n\tvs_main();\n") &&
+			rep("\tgl_Position = gl_Position * scale_offset_mat;\n",
+				"\tgl_Position = gl_Position * scale_offset_mat;\n\tr2om_cur = gl_Position;\n\tr2om_old = r2om_pp * scale_offset_mat;\n");
+	}
+
+	// RSX_DLSS_OBJMV_MODE=onepass: the game's own vertex shader, also run with the previous frame's constants (GPU history,
+	// vec4 base in a push constant: the game pipelines using draw parameters have none) -> clip positions at 20/21.
+	// The draw parameters stay those of the real draw.
+	bool om1_make_vs(std::string& s)
+	{
+		auto rep = [&](std::string_view a, std::string_view b)
+		{
+			const usz p = s.find(a);
+			if (p == std::string::npos) return false;
+			s.replace(p, a.size(), b);
+			return true;
+		};
+		if (s.find("gl_Position = dst_reg0;") == std::string::npos || s.find("push_constant") != std::string::npos) return false;
+		const std::string decl =
+			"layout(std430, set=2, binding=0) readonly restrict buffer R2ObjMV { uvec4 r2om[]; };\n"
+			"layout(set=2, binding=2) uniform usamplerBuffer r2om_pstream;\n"
+			"layout(push_constant) uniform R2OmPC { uint r2om_base; uint r2om_deform; int r2om_doff; };\n"
+			"bool r2om_prev = false;\n"
+			"layout(location=" + std::to_string(om2_loc) + ") out vec4 r2om_cur;\n"
+			"layout(location=" + std::to_string(om2_loc + 1) + ") out vec4 r2om_old;\n"
+			"#define draw_parameters_offset uint(gl_BaseInstanceARB)\n";
+		const bool ok = rep("#define draw_parameters_offset uint(gl_BaseInstanceARB)\n", decl) &&
+			rep("#define _fetch_constant(x) vc[(x) + xform_constants_offset]",
+				"#define _fetch_constant(x) (r2om_prev ? uintBitsToFloat(r2om[(x) + xform_constants_offset]) : vc[(x) + xform_constants_offset])") &&
+			rep("uint xform_constants_offset = get_draw_params().xform_constants_offset;",
+				"uint xform_constants_offset = r2om_prev ? r2om_base : get_draw_params().xform_constants_offset;") &&
+			rep("\tvs_main();\n", "\tr2om_prev = true;\n\tvs_main();\n\tvec4 r2om_pp = dst_reg0;\n\tr2om_prev = false;\n\tvs_main();\n") &&
+			rep("\tgl_Position = gl_Position * scale_offset_mat;\n",
+				"\tgl_Position = gl_Position * scale_offset_mat;\n\tr2om_cur = gl_Position;\n\tr2om_old = r2om_pp * scale_offset_mat;\n");
+		// RSX_DLSS_OBJMV_DEFORM: the previous evaluation reads the persistent stream from the deform history. Without
+		// this hook (unexpected fetch code) r2om_deform is ignored: previous constants only, as before.
+		if (ok)
+			rep("return fetch_attribute(desc, vertex_id, persistent_input_stream);",
+				"if (r2om_prev && r2om_deform != 0u)\n"
+				"\t\t{\n"
+				"\t\t\tdesc.starting_offset = uint(int(desc.starting_offset) + r2om_doff);\n"
+				"\t\t\treturn fetch_attribute(desc, vertex_id, r2om_pstream);\n"
+				"\t\t}\n"
+				"\t\treturn fetch_attribute(desc, vertex_id, persistent_input_stream);");
+		return ok;
+	}
+
+	// The game's own fragment shader plus, at the very end of main (after its discards / alpha test), the velocity of
+	// the fragment kept per pixel when it is the nearest so far. Colour outputs, blending and depth are untouched.
+	bool om1_make_fs(std::string& s)
+	{
+		if (s.find("push_constant") != std::string::npos) return false;
+		const usz v = s.find("#version");
+		const usz vl = v == std::string::npos ? v : s.find('\n', v);
+		const usz m = s.rfind("\nvoid main()");
+		const usz e = s.rfind('}');
+		if (vl == std::string::npos || m == std::string::npos || e == std::string::npos || e < m) return false;
+		s.insert(e,
+			"\t// R2PORT objmv onepass\n"
+			"\tif (r2om_c.w > 1e-6 && r2om_q.w > 1e-6)\n"
+			"\t{\n"
+			"\t\tuvec2 r2p = uvec2(gl_FragCoord.xy);\n"
+			"\t\tif (r2p.x < r2vw.x && r2p.y < r2vw.y)\n"
+			"\t\t{\n"
+			"\t\t\tuint r2z = floatBitsToUint(gl_FragCoord.z);\n"
+			"\t\t\tif (r2vw.z != 0u) r2z = ~r2z;\n"
+			"\t\t\tatomicMin(r2v[r2p.y * r2vw.x + r2p.x], (uint64_t(r2z) << 32) | uint64_t(packHalf2x16(r2om_c.xy / r2om_c.w - r2om_q.xy / r2om_q.w)));\n"
+			"\t\t}\n"
+			"\t}\n");
+		s.insert(m + 1,
+			"layout(location=" + std::to_string(om2_loc) + ") in vec4 r2om_c;\n"
+			"layout(location=" + std::to_string(om2_loc + 1) + ") in vec4 r2om_q;\n"
+			"layout(std430, set=2, binding=1) restrict buffer R2Vel { uvec4 r2vw; uint64_t r2v[]; };\n\n");
+		s.insert(vl + 1,
+			"#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require\n"
+			"#extension GL_EXT_shader_atomic_int64 : require\n");
+		return true;
+	}
+
+	struct om2_job
+	{
+		int kind = 0;                 // 0: replay velocity pass, 1: onepass variant of the game pipeline
+		u64 key = 0;
+		std::string src;
+		std::string fsrc;             // onepass: the game's fragment shader
+		vk::pipeline_props props{};   // onepass: the game pipeline's state
+		bool provoking_last = false, depth_bounds_dyn = false;
+		VkPipelineLayout layout = VK_NULL_HANDLE;
+		VkRenderPass rp = VK_NULL_HANDLE;
+		VkPipelineInputAssemblyStateCreateInfo ia{};
+		VkPipelineRasterizationStateCreateInfo rs{};
+		VkCompareOp cmp = VK_COMPARE_OP_LESS_OR_EQUAL;
+	};
+
+	struct om2_pipes_t
+	{
+		std::mutex mtx;
+		std::condition_variable cv;
+		std::unordered_map<u64, VkPipeline> done; // VK_NULL_HANDLE: creation failed
+		std::unordered_set<u64> queued;
+		std::vector<om2_job> jobs;
+		VkDevice dev = VK_NULL_HANDLE;
+		// worker only
+		std::unordered_map<usz, VkShaderModule> vs_mods; // variant source hash -> module (null: failed)
+		std::vector<std::unique_ptr<vk::glsl::shader>> keep;
+		VkShaderModule fs_mod = VK_NULL_HANDLE;
+		bool fs_tried = false;
+		u32 failures = 0;
+
+		VkShaderModule compile(::glsl::program_domain domain, const std::string& src)
+		{
+			auto sh = std::make_unique<vk::glsl::shader>();
+			sh->create(domain, src);
+			VkShaderModule m = VK_NULL_HANDLE;
+			try { m = sh->compile(); }
+			catch (...) { m = VK_NULL_HANDLE; }
+			if (m) keep.push_back(std::move(sh));
+			return m;
+		}
+
+		VkShaderModule module_for(::glsl::program_domain domain, const std::string& src)
+		{
+			const usz h = std::hash<std::string>{}(src) ^ (domain == ::glsl::program_domain::glsl_fragment_program ? 0x5bd1e995ull : 0ull);
+			if (const auto it = vs_mods.find(h); it != vs_mods.end()) return it->second;
+			const VkShaderModule m = compile(domain, src);
+			vs_mods[h] = m;
+			return m;
+		}
+
+		// The game pipeline's create info (r2_gfx_info::monolithic in VKPipelineCompiler.cpp) with the variant shaders
+		VkPipeline build_onepass(om2_job& j)
+		{
+			if (!om1_make_vs(j.src) || !om1_make_fs(j.fsrc))
+			{
+				if (failures++ < 4) rsx_log.warning("R2AA: objmv onepass: unexpected shader layout, draws keep camera motion");
+				return VK_NULL_HANDLE;
+			}
+			const VkShaderModule vs = module_for(::glsl::program_domain::glsl_vertex_program, j.src);
+			const VkShaderModule fs = vs ? module_for(::glsl::program_domain::glsl_fragment_program, j.fsrc) : VK_NULL_HANDLE;
+			if (!vs || !fs)
+			{
+				if (failures++ < 4) rsx_log.warning("R2AA: objmv onepass: a variant shader failed to compile");
+				return VK_NULL_HANDLE;
+			}
+			const auto& ps = j.props.state;
+			VkPipelineShaderStageCreateInfo stages[2]{};
+			stages[0].sType = stages[1].sType = VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO;
+			stages[0].stage = VK_SHADER_STAGE_VERTEX_BIT;
+			stages[0].module = vs;
+			stages[0].pName = "main";
+			stages[1].stage = VK_SHADER_STAGE_FRAGMENT_BIT;
+			stages[1].module = fs;
+			stages[1].pName = "main";
+			VkDynamicState dyn[9] = { VK_DYNAMIC_STATE_VIEWPORT, VK_DYNAMIC_STATE_SCISSOR, VK_DYNAMIC_STATE_LINE_WIDTH, VK_DYNAMIC_STATE_BLEND_CONSTANTS,
+				VK_DYNAMIC_STATE_STENCIL_COMPARE_MASK, VK_DYNAMIC_STATE_STENCIL_WRITE_MASK, VK_DYNAMIC_STATE_STENCIL_REFERENCE, VK_DYNAMIC_STATE_DEPTH_BIAS,
+				VK_DYNAMIC_STATE_DEPTH_BOUNDS };
+			VkPipelineDynamicStateCreateInfo dy{ VK_STRUCTURE_TYPE_PIPELINE_DYNAMIC_STATE_CREATE_INFO };
+			dy.dynamicStateCount = j.depth_bounds_dyn ? 9 : 8;
+			dy.pDynamicStates = dyn;
+			VkPipelineDepthStencilStateCreateInfo ds = ps.ds;
+			if (!j.depth_bounds_dyn) ds.depthBoundsTestEnable = VK_FALSE;
+			VkPipelineMultisampleStateCreateInfo ms = ps.ms;
+			ms.pSampleMask = nullptr; // single-sampled only
+			ms.sampleShadingEnable = VK_FALSE;
+			VkPipelineColorBlendStateCreateInfo cb = ps.cs;
+			cb.pAttachments = ps.att_state;
+			VkPipelineRasterizationStateCreateInfo rs = ps.rs;
+			VkPipelineRasterizationProvokingVertexStateCreateInfoEXT pv{ VK_STRUCTURE_TYPE_PIPELINE_RASTERIZATION_PROVOKING_VERTEX_STATE_CREATE_INFO_EXT };
+			if (j.provoking_last)
+			{
+				pv.pNext = rs.pNext;
+				pv.provokingVertexMode = VK_PROVOKING_VERTEX_MODE_LAST_VERTEX_EXT;
+				rs.pNext = &pv;
+			}
+			VkPipelineVertexInputStateCreateInfo vi{ VK_STRUCTURE_TYPE_PIPELINE_VERTEX_INPUT_STATE_CREATE_INFO };
+			VkPipelineViewportStateCreateInfo vp{ VK_STRUCTURE_TYPE_PIPELINE_VIEWPORT_STATE_CREATE_INFO };
+			vp.viewportCount = vp.scissorCount = 1;
+			VkGraphicsPipelineCreateInfo info{ VK_STRUCTURE_TYPE_GRAPHICS_PIPELINE_CREATE_INFO };
+			info.stageCount = 2;
+			info.pStages = stages;
+			info.pVertexInputState = &vi;
+			info.pInputAssemblyState = &ps.ia;
+			info.pViewportState = &vp;
+			info.pRasterizationState = &rs;
+			info.pMultisampleState = &ms;
+			info.pDepthStencilState = &ds;
+			info.pColorBlendState = &cb;
+			info.pDynamicState = &dy;
+			info.layout = j.layout;
+			info.renderPass = j.rp;
+			info.basePipelineIndex = -1;
+			VkPipeline pipe = VK_NULL_HANDLE;
+			if (vkCreateGraphicsPipelines(dev, VK_NULL_HANDLE, 1, &info, nullptr, &pipe) != VK_SUCCESS) pipe = VK_NULL_HANDLE;
+			return pipe;
+		}
+
+		VkPipeline build(om2_job& j)
+		{
+			if (j.kind == 1) return build_onepass(j);
+			if (!fs_tried)
+			{
+				fs_tried = true;
+				fs_mod = compile(::glsl::program_domain::glsl_fragment_program,
+					"#version 450\n"
+					"layout(location=" + std::to_string(om2_loc) + ") in vec4 c;\n"
+					"layout(location=" + std::to_string(om2_loc + 1) + ") in vec4 q;\n"
+					"layout(location=0) out vec4 o;\n"
+					"void main()\n"
+					"{\n"
+					"	if (c.w <= 1e-6 || q.w <= 1e-6) { o = vec4(0.0); return; }\n"
+					// R3: z/w = the redrawn depth (standard: 1 - z, inverted: z; FP16 keeps their relative precision)
+					// so the prep pass can drop velocity hidden by later draws (mid-frame segment replays)
+					"	o = vec4(c.xy / c.w - q.xy / q.w, 1.0 - gl_FragCoord.z, gl_FragCoord.z);\n"
+					"}\n");
+			}
+			if (!fs_mod || !om2_make_vs(j.src))
+			{
+				if (fs_mod && failures++ < 4) rsx_log.warning("R2AA: objmv2: unexpected vertex shader layout, draws keep camera motion");
+				return VK_NULL_HANDLE;
+			}
+			const usz h = std::hash<std::string>{}(j.src);
+			VkShaderModule vs;
+			if (const auto it = vs_mods.find(h); it != vs_mods.end()) vs = it->second;
+			else
+			{
+				vs = compile(::glsl::program_domain::glsl_vertex_program, j.src);
+				vs_mods[h] = vs;
+				if (!vs && failures++ < 4) rsx_log.warning("R2AA: objmv2: a velocity vertex shader failed to compile");
+			}
+			if (!vs) return VK_NULL_HANDLE;
+			VkPipelineShaderStageCreateInfo stages[2]{};
+			stages[0].sType = stages[1].sType = VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO;
+			stages[0].stage = VK_SHADER_STAGE_VERTEX_BIT;
+			stages[0].module = vs;
+			stages[0].pName = "main";
+			stages[1].stage = VK_SHADER_STAGE_FRAGMENT_BIT;
+			stages[1].module = fs_mod;
+			stages[1].pName = "main";
+			VkPipelineVertexInputStateCreateInfo vi{ VK_STRUCTURE_TYPE_PIPELINE_VERTEX_INPUT_STATE_CREATE_INFO };
+			VkPipelineViewportStateCreateInfo vp{ VK_STRUCTURE_TYPE_PIPELINE_VIEWPORT_STATE_CREATE_INFO };
+			vp.viewportCount = vp.scissorCount = 1;
+			VkPipelineMultisampleStateCreateInfo ms{ VK_STRUCTURE_TYPE_PIPELINE_MULTISAMPLE_STATE_CREATE_INFO };
+			ms.rasterizationSamples = VK_SAMPLE_COUNT_1_BIT;
+			VkPipelineDepthStencilStateCreateInfo ds{ VK_STRUCTURE_TYPE_PIPELINE_DEPTH_STENCIL_STATE_CREATE_INFO };
+			ds.depthTestEnable = VK_TRUE;
+			ds.depthWriteEnable = VK_FALSE;
+			ds.depthCompareOp = j.cmp;
+			ds.minDepthBounds = 0.f;
+			ds.maxDepthBounds = 1.f;
+			VkPipelineColorBlendAttachmentState att{};
+			att.colorWriteMask = VK_COLOR_COMPONENT_R_BIT | VK_COLOR_COMPONENT_G_BIT | VK_COLOR_COMPONENT_B_BIT | VK_COLOR_COMPONENT_A_BIT;
+			VkPipelineColorBlendStateCreateInfo cb{ VK_STRUCTURE_TYPE_PIPELINE_COLOR_BLEND_STATE_CREATE_INFO };
+			cb.attachmentCount = 1;
+			cb.pAttachments = &att;
+			const VkDynamicState dyn[3] = { VK_DYNAMIC_STATE_VIEWPORT, VK_DYNAMIC_STATE_SCISSOR, VK_DYNAMIC_STATE_DEPTH_BIAS };
+			VkPipelineDynamicStateCreateInfo dy{ VK_STRUCTURE_TYPE_PIPELINE_DYNAMIC_STATE_CREATE_INFO };
+			dy.dynamicStateCount = 3;
+			dy.pDynamicStates = dyn;
+			VkGraphicsPipelineCreateInfo info{ VK_STRUCTURE_TYPE_GRAPHICS_PIPELINE_CREATE_INFO };
+			info.stageCount = 2;
+			info.pStages = stages;
+			info.pVertexInputState = &vi;
+			info.pInputAssemblyState = &j.ia;
+			info.pViewportState = &vp;
+			info.pRasterizationState = &j.rs;
+			info.pMultisampleState = &ms;
+			info.pDepthStencilState = &ds;
+			info.pColorBlendState = &cb;
+			info.pDynamicState = &dy;
+			info.layout = j.layout;
+			info.renderPass = j.rp;
+			info.basePipelineIndex = -1;
+			VkPipeline pipe = VK_NULL_HANDLE;
+			if (vkCreateGraphicsPipelines(dev, VK_NULL_HANDLE, 1, &info, nullptr, &pipe) != VK_SUCCESS) pipe = VK_NULL_HANDLE;
+			return pipe;
+		}
+
+		void run()
+		{
+			for (;;)
+			{
+				om2_job j;
+				{
+					std::unique_lock lock(mtx);
+					cv.wait(lock, [&] { return !jobs.empty(); });
+					j = std::move(jobs.back());
+					jobs.pop_back();
+				}
+				const VkPipeline pipe = build(j);
+				std::lock_guard lock(mtx);
+				done[j.key] = pipe;
+				queued.erase(j.key);
+			}
+		}
+
+		// Queue the pipeline for this key unless it exists or is being built; make() is only called then
+		template <typename F>
+		void request(u64 key, F&& make)
+		{
+			std::lock_guard lock(mtx);
+			if (done.count(key) || queued.count(key)) return;
+			queued.insert(key);
+			jobs.push_back(make());
+			cv.notify_one();
+		}
+
+		VkPipeline peek(u64 key, bool& pending)
+		{
+			std::lock_guard lock(mtx);
+			if (const auto it = done.find(key); it != done.end()) { pending = false; return it->second; }
+			pending = queued.count(key) != 0;
+			return VK_NULL_HANDLE;
+		}
+	};
+
+	om2_pipes_t* om2_pipes(VkDevice dev)
+	{
+		// Never destroyed: the worker sleeps until process exit
+		static om2_pipes_t* p = [&]
+		{
+			auto* r = new om2_pipes_t;
+			r->dev = dev;
+			std::thread([r] { r->run(); }).detach();
+			return r;
+		}();
+		return p;
+	}
+
+	// The velocity pass resources (once)
+	bool om2_init(const vk::render_device& dev)
+	{
+		auto& o = g_om2;
+		if (o.failed) return false;
+		if (!o.set)
+		{
+			o.cap = std::max(1u, std::min(r2cfg().om_max_replays, 384u));
+			o.hvalid[0].assign(o.cap, 0);
+			o.hvalid[1].assign(o.cap, 0);
+			const VkDeviceSize size = static_cast<VkDeviceSize>(o.cap) * 16 * (1 + 2 * 468);
+			o.sbuf = std::make_unique<vk::buffer>(dev, size, dev.get_memory_mapping().device_local, VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT,
+				VK_BUFFER_USAGE_STORAGE_BUFFER_BIT | VK_BUFFER_USAGE_TRANSFER_DST_BIT, 0, VMM_ALLOCATION_POOL_UNDEFINED);
+			VkDescriptorSetLayoutBinding b{};
+			b.binding = 0;
+			b.descriptorType = VK_DESCRIPTOR_TYPE_STORAGE_BUFFER;
+			b.descriptorCount = 1;
+			b.stageFlags = VK_SHADER_STAGE_VERTEX_BIT;
+			VkDescriptorSetLayoutCreateInfo li{ VK_STRUCTURE_TYPE_DESCRIPTOR_SET_LAYOUT_CREATE_INFO };
+			li.bindingCount = 1;
+			li.pBindings = &b;
+			VkDescriptorPoolSize ps{ VK_DESCRIPTOR_TYPE_STORAGE_BUFFER, 1 };
+			VkDescriptorPoolCreateInfo pi{ VK_STRUCTURE_TYPE_DESCRIPTOR_POOL_CREATE_INFO };
+			pi.maxSets = 1;
+			pi.poolSizeCount = 1;
+			pi.pPoolSizes = &ps;
+			if (!o.sbuf || vkCreateDescriptorSetLayout(dev, &li, nullptr, &o.set_layout) != VK_SUCCESS ||
+				vkCreateDescriptorPool(dev, &pi, nullptr, &o.pool) != VK_SUCCESS)
+			{
+				o.failed = true;
+				r2log("per-object motion (v2) unavailable: resource creation failed");
+				return false;
+			}
+			VkDescriptorSetAllocateInfo ai{ VK_STRUCTURE_TYPE_DESCRIPTOR_SET_ALLOCATE_INFO };
+			ai.descriptorPool = o.pool;
+			ai.descriptorSetCount = 1;
+			ai.pSetLayouts = &o.set_layout;
+			if (vkAllocateDescriptorSets(dev, &ai, &o.set) != VK_SUCCESS)
+			{
+				o.set = VK_NULL_HANDLE;
+				o.failed = true;
+				return false;
+			}
+			const VkDescriptorBufferInfo bi{ o.sbuf->value, 0, VK_WHOLE_SIZE };
+			VkWriteDescriptorSet w{ VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET };
+			w.dstSet = o.set;
+			w.descriptorCount = 1;
+			w.descriptorType = VK_DESCRIPTOR_TYPE_STORAGE_BUFFER;
+			w.pBufferInfo = &bi;
+			vkUpdateDescriptorSets(dev, 1, &w, 0, nullptr);
+			r2log("per-object motion (v2): %u redraws per frame, %llu KB GPU constants history", o.cap, static_cast<unsigned long long>(size >> 10));
+		}
+		return true;
+	}
+
+	// The pipeline layout for a game vertex set layout
+	VkPipelineLayout om2_layout(const vk::render_device& dev, VkDescriptorSetLayout set0)
+	{
+		auto& o = g_om2;
+		if (!om2_init(dev)) return VK_NULL_HANDLE;
+		if (const auto it = o.layouts.find(set0); it != o.layouts.end()) return it->second;
+		const VkDescriptorSetLayout sl[2] = { set0, o.set_layout };
+		VkPipelineLayoutCreateInfo pl{ VK_STRUCTURE_TYPE_PIPELINE_LAYOUT_CREATE_INFO };
+		pl.setLayoutCount = 2;
+		pl.pSetLayouts = sl;
+		VkPipelineLayout layout = VK_NULL_HANDLE;
+		if (vkCreatePipelineLayout(dev, &pl, nullptr, &layout) != VK_SUCCESS) layout = VK_NULL_HANDLE;
+		o.layouts[set0] = layout;
+		return layout;
+	}
+
+	// RSX_DLSS_OBJMV_MODE=onepass resources (once): our descriptor set layout (set 2 of the variant pipelines) and pool
+	bool om1_init(const vk::render_device& dev)
+	{
+		auto& o = g_om2;
+		if (o.op_failed || !om2_init(dev)) return false;
+		if (o.op_set_layout) return true;
+		{
+			// RSX_DLSS_OBJMV_DEFORM history (a 256-byte stand-in when off: the binding always exists)
+			const VkDeviceSize max_el = dev.gpu().get_limits().maxTexelBufferElements;
+			o.dhalf = r2cfg().om_deform ? std::min<VkDeviceSize>(static_cast<VkDeviceSize>(r2cfg().om_deform_mb) << 20, max_el / 2) & ~VkDeviceSize{255} : 0;
+			const VkDeviceSize dsize = o.dhalf ? o.dhalf * 2 : 256;
+			o.dbuf = std::make_unique<vk::buffer>(dev, dsize, dev.get_memory_mapping().device_local, VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT,
+				VK_BUFFER_USAGE_UNIFORM_TEXEL_BUFFER_BIT | VK_BUFFER_USAGE_TRANSFER_DST_BIT, 0, VMM_ALLOCATION_POOL_UNDEFINED);
+			if (o.dbuf && o.dbuf->value)
+				o.dview = std::make_unique<vk::buffer_view>(dev, o.dbuf->value, VK_FORMAT_R8_UINT, 0, dsize);
+			if (!o.dview || !o.dview->value)
+			{
+				o.op_failed = true;
+				r2log("objmv onepass unavailable: deform history creation failed, draws keep camera motion");
+				return false;
+			}
+		}
+		VkDescriptorSetLayoutBinding b[3]{};
+		b[0].binding = 0;
+		b[0].descriptorType = VK_DESCRIPTOR_TYPE_STORAGE_BUFFER;
+		b[0].descriptorCount = 1;
+		b[0].stageFlags = VK_SHADER_STAGE_VERTEX_BIT;
+		b[1] = b[0];
+		b[1].binding = 1;
+		b[1].stageFlags = VK_SHADER_STAGE_FRAGMENT_BIT;
+		b[2] = b[0];
+		b[2].binding = 2;
+		b[2].descriptorType = VK_DESCRIPTOR_TYPE_UNIFORM_TEXEL_BUFFER;
+		VkDescriptorSetLayoutCreateInfo li{ VK_STRUCTURE_TYPE_DESCRIPTOR_SET_LAYOUT_CREATE_INFO };
+		li.bindingCount = 3;
+		li.pBindings = b;
+		constexpr u32 max_sets = 16;
+		const VkDescriptorPoolSize ps[2] = { { VK_DESCRIPTOR_TYPE_STORAGE_BUFFER, 2 * max_sets }, { VK_DESCRIPTOR_TYPE_UNIFORM_TEXEL_BUFFER, max_sets } };
+		VkDescriptorPoolCreateInfo pi{ VK_STRUCTURE_TYPE_DESCRIPTOR_POOL_CREATE_INFO };
+		pi.maxSets = max_sets;
+		pi.poolSizeCount = 2;
+		pi.pPoolSizes = ps;
+		if (vkCreateDescriptorSetLayout(dev, &li, nullptr, &o.op_set_layout) != VK_SUCCESS ||
+			vkCreateDescriptorPool(dev, &pi, nullptr, &o.op_pool) != VK_SUCCESS)
+		{
+			o.op_set_layout = VK_NULL_HANDLE;
+			o.op_failed = true;
+			r2log("objmv onepass unavailable: resource creation failed, draws keep camera motion");
+			return false;
+		}
+		o.op_sets_left = max_sets;
+		r2log("objmv onepass: moving draws write their own velocity (no replay); deformed meshes: %s", o.dhalf ? "on" : "off");
+		return true;
+	}
+
+	// The variant pipeline layout: the game's vertex + fragment set layouts, ours, the previous-constants base
+	VkPipelineLayout om1_layout(const vk::render_device& dev, VkDescriptorSetLayout set0, VkDescriptorSetLayout set1)
+	{
+		auto& o = g_om2;
+		const u64 k = mix64(reinterpret_cast<u64>(set0), reinterpret_cast<u64>(set1));
+		if (const auto it = o.op_layouts.find(k); it != o.op_layouts.end()) return it->second;
+		const VkDescriptorSetLayout sl[3] = { set0, set1, o.op_set_layout };
+		const VkPushConstantRange pr{ VK_SHADER_STAGE_VERTEX_BIT, 0, 12 }; // r2om_base, r2om_deform, r2om_doff
+		VkPipelineLayoutCreateInfo pl{ VK_STRUCTURE_TYPE_PIPELINE_LAYOUT_CREATE_INFO };
+		pl.setLayoutCount = 3;
+		pl.pSetLayouts = sl;
+		pl.pushConstantRangeCount = 1;
+		pl.pPushConstantRanges = &pr;
+		VkPipelineLayout layout = VK_NULL_HANDLE;
+		if (vkCreatePipelineLayout(dev, &pl, nullptr, &layout) != VK_SUCCESS) layout = VK_NULL_HANDLE;
+		o.op_layouts[k] = layout;
+		return layout;
+	}
+
+	// After the prep pass consumed it (outside a render pass): clear the per-pixel velocity buffer for the next frame,
+	// sized for the scene depth (w x h). Until a clear has run, draws keep camera motion.
+	void om1_clear(VkCommandBuffer cmd, const vk::render_device& dev, u32 w, u32 h, bool inverted)
+	{
+		auto& o = g_om2;
+		o.vb_clean = false;
+		o.vb_written = false;
+		if (!w || !h || !om1_init(dev)) return;
+		const VkDeviceSize need = 16 + static_cast<VkDeviceSize>(w) * h * 8;
+		if (!o.vb || o.vb_size < need)
+		{
+			if (!o.op_sets_left)
+			{
+				o.op_failed = true;
+				r2log("objmv onepass: too many velocity buffer resizes, draws keep camera motion");
+				return;
+			}
+			if (o.vb) vk::get_resource_manager()->dispose(o.vb);
+			o.vb = std::make_unique<vk::buffer>(dev, need, dev.get_memory_mapping().device_local, VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT,
+				VK_BUFFER_USAGE_STORAGE_BUFFER_BIT | VK_BUFFER_USAGE_TRANSFER_DST_BIT, 0, VMM_ALLOCATION_POOL_UNDEFINED);
+			o.vb_size = need;
+			VkDescriptorSetAllocateInfo ai{ VK_STRUCTURE_TYPE_DESCRIPTOR_SET_ALLOCATE_INFO };
+			ai.descriptorPool = o.op_pool;
+			ai.descriptorSetCount = 1;
+			ai.pSetLayouts = &o.op_set_layout;
+			if (!o.vb || vkAllocateDescriptorSets(dev, &ai, &o.op_set) != VK_SUCCESS)
+			{
+				o.op_set = VK_NULL_HANDLE;
+				o.op_failed = true;
+				r2log("objmv onepass: velocity buffer creation failed, draws keep camera motion");
+				return;
+			}
+			o.op_sets_left--;
+			const VkDescriptorBufferInfo bi[2] = { { o.sbuf->value, 0, VK_WHOLE_SIZE }, { o.vb->value, 0, VK_WHOLE_SIZE } };
+			VkWriteDescriptorSet wr[3]{};
+			for (u32 i = 0; i < 2; ++i)
+			{
+				wr[i].sType = VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET;
+				wr[i].dstSet = o.op_set;
+				wr[i].dstBinding = i;
+				wr[i].descriptorCount = 1;
+				wr[i].descriptorType = VK_DESCRIPTOR_TYPE_STORAGE_BUFFER;
+				wr[i].pBufferInfo = &bi[i];
+			}
+			wr[2].sType = VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET;
+			wr[2].dstSet = o.op_set;
+			wr[2].dstBinding = 2;
+			wr[2].descriptorCount = 1;
+			wr[2].descriptorType = VK_DESCRIPTOR_TYPE_UNIFORM_TEXEL_BUFFER;
+			wr[2].pTexelBufferView = &o.dview->value;
+			vkUpdateDescriptorSets(dev, 3, wr, 0, nullptr);
+		}
+		// previous readers (prep pass) / writers (last frame's draws) are behind the caller's global barrier
+		vkCmdFillBuffer(cmd, o.vb->value, 16, need - 16, 0xffffffffu);
+		const u32 hdr[4] = { w, h, inverted ? 1u : 0u, 0u };
+		vkCmdUpdateBuffer(cmd, o.vb->value, 0, sizeof(hdr), hdr);
+		VkMemoryBarrier mb{ VK_STRUCTURE_TYPE_MEMORY_BARRIER };
+		mb.srcAccessMask = VK_ACCESS_TRANSFER_WRITE_BIT;
+		mb.dstAccessMask = VK_ACCESS_SHADER_READ_BIT | VK_ACCESS_SHADER_WRITE_BIT;
+		vkCmdPipelineBarrier(cmd, VK_PIPELINE_STAGE_TRANSFER_BIT, VK_PIPELINE_STAGE_FRAGMENT_SHADER_BIT | VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT,
+			0, 1, &mb, 0, nullptr, 0, nullptr);
+		o.vb_w = w;
+		o.vb_h = h;
+		o.vb_clean = true;
+	}
+
+	void om2_update(VkCommandBuffer cmd, VkBuffer buf, VkDeviceSize offset, const void* data, usz bytes)
+	{
+		const u8* p = static_cast<const u8*>(data);
+		while (bytes)
+		{
+			const usz n = std::min<usz>(bytes, 65536);
+			vkCmdUpdateBuffer(cmd, buf, offset, n, p);
+			p += n;
+			offset += n;
+			bytes -= n;
+		}
+	}
+
+	// Once per frame, after the scene and before the prep pass: the recorded draws again with the velocity variant of
+	// their vertex shader, depth-tested against the scene depth (no writes). Returns true when o.vel holds them.
+	// R3: also called with 'segment' right before a mid-frame submit (label waits / flushes, many per frame in R3):
+	// the draws recorded in that command buffer are replayed while their descriptor sets are guaranteed, into the
+	// same velocity target (cleared once per frame). The prep pass drops velocity hidden by later draws (depth check).
+	bool om2_replay(vk::command_buffer_chunk& cmd, vk::render_target* ds, const vk::render_device& dev, bool segment)
+	{
+		auto& o = g_om2;
+		if (o.cb != &cmd || o.cb_reset != cmd.reset_id || !o.sbuf || !o.set || ds->samples() != 1)
+		{
+			// The command buffer was submitted since (descriptor sets / ring data of the draws may be gone)
+			o.n_skip += size32(o.recs);
+			o.recs.clear();
+			o.hcopy.clear();
+			o.dcopy.clear();
+			return o.vel_live && !segment;
+		}
+		if (segment) o.n_seg++;
+		struct draw_t { const om2_rec* r; VkPipeline pipe; };
+		static std::vector<draw_t> draws; // reused
+		draws.clear();
+		o.table.clear();
+		om2_pipes_t* pipes = om2_pipes(dev);
+		for (const auto& r : o.recs)
+		{
+			bool pending = false;
+			const VkPipeline pipe = pipes->peek(r.key, pending);
+			if (!pipe)
+			{
+				if (pending) o.n_pending++;
+				else o.n_skip++;
+				continue;
+			}
+			o.table.insert(o.table.end(), { r.dp_index, r.prev_base, 0u, 0u });
+			draws.push_back({ &r, pipe });
+		}
+		if (draws.empty() && o.hcopy.empty())
+		{
+			o.recs.clear();
+			return o.vel_live && !segment;
+		}
+
+		// The previous frame's reads of the last pass are done (write-after-read). This frame's constants are copied
+		// on the GPU from the transform ring into this frame's history half (read by the next frame's redraws), the
+		// redraws read the previous half. Then visible to vertex shaders.
+		vkCmdPipelineBarrier(cmd, VK_PIPELINE_STAGE_VERTEX_SHADER_BIT, VK_PIPELINE_STAGE_TRANSFER_BIT, 0, 0, nullptr, 0, nullptr, 0, nullptr);
+		if (!o.hcopy.empty())
+		{
+			vkCmdCopyBuffer(cmd, o.hsrc, o.sbuf->value, size32(o.hcopy), o.hcopy.data());
+			const VkDeviceSize hbase = static_cast<VkDeviceSize>(o.cap) * 16 * (1 + static_cast<VkDeviceSize>(o.hpar) * 468);
+			for (const auto& c : o.hcopy) o.hvalid[o.hpar][static_cast<usz>((c.dstOffset - hbase) / (468 * 16))] = 1;
+			o.n_hist += size32(o.hcopy);
+			o.hcopy.clear();
+			om_issue_dcopy(cmd);
+		}
+		if (!o.table.empty()) om2_update(cmd, o.sbuf->value, 0, o.table.data(), o.table.size() * sizeof(u32));
+		VkMemoryBarrier mb{ VK_STRUCTURE_TYPE_MEMORY_BARRIER };
+		mb.srcAccessMask = VK_ACCESS_TRANSFER_WRITE_BIT;
+		mb.dstAccessMask = VK_ACCESS_SHADER_READ_BIT;
+		vkCmdPipelineBarrier(cmd, VK_PIPELINE_STAGE_TRANSFER_BIT, VK_PIPELINE_STAGE_VERTEX_SHADER_BIT, 0, 1, &mb, 0, nullptr, 0, nullptr);
+		if (draws.empty())
+		{
+			o.recs.clear();
+			return o.vel_live && !segment;
+		}
+
+		if (!o.vel || o.vel->width() < ds->width() || o.vel->height() < ds->height())
+		{
+			const u32 w = std::max(ds->width(), o.vel ? o.vel->width() : 0u);
+			const u32 h = std::max(ds->height(), o.vel ? o.vel->height() : 0u);
+			if (o.vel)
+			{
+				vk::remove_framebuffers_with_image(o.vel.get());
+				vk::get_resource_manager()->dispose(o.vel);
+			}
+			o.vel_live = false;
+			o.vel = make_image(om2_format, w, h, VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT | VK_IMAGE_USAGE_SAMPLED_BIT | VK_IMAGE_USAGE_TRANSFER_DST_BIT);
+			if (!o.vel)
+			{
+				o.failed = true;
+				o.recs.clear();
+				return false;
+			}
+		}
+		if (!o.vel_live)
+		{
+			o.vel->change_layout(cmd, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL);
+			const VkClearColorValue zero{};
+			const VkImageSubresourceRange range{ VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0, 1 };
+			vkCmdClearColorImage(cmd, o.vel->value, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, &zero, 1, &range);
+			o.vel_live = true;
+		}
+		o.vel->change_layout(cmd, VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL);
+		{
+			// a previous segment's redraws (write-after-write on the velocity target)
+			VkMemoryBarrier vb{ VK_STRUCTURE_TYPE_MEMORY_BARRIER };
+			vb.srcAccessMask = VK_ACCESS_COLOR_ATTACHMENT_WRITE_BIT;
+			vb.dstAccessMask = VK_ACCESS_COLOR_ATTACHMENT_READ_BIT | VK_ACCESS_COLOR_ATTACHMENT_WRITE_BIT;
+			vkCmdPipelineBarrier(cmd, VK_PIPELINE_STAGE_COLOR_ATTACHMENT_OUTPUT_BIT, VK_PIPELINE_STAGE_COLOR_ATTACHMENT_OUTPUT_BIT, 0, 1, &vb, 0, nullptr, 0, nullptr);
+		}
+		ds->read_barrier(cmd);
+		ds->push_layout(cmd, VK_IMAGE_LAYOUT_DEPTH_STENCIL_ATTACHMENT_OPTIMAL);
+
+		const u16 fw = static_cast<u16>(std::min(ds->width(), 0xffffu)), fh = static_cast<u16>(std::min(ds->height(), 0xffffu));
+		const VkRenderPass rp = vk::get_renderpass(dev, vk::get_renderpass_key({ o.vel.get(), ds }));
+		auto* fbo = vk::get_framebuffer(dev, fw, fh, VK_FALSE, rp, { o.vel.get(), ds });
+		fbo->add_ref();
+		vk::begin_renderpass(cmd, rp, fbo->value, { positionu{ 0u, 0u }, sizeu{ fw, fh } });
+		VkPipeline bound = VK_NULL_HANDLE;
+		for (u32 i = 0; i < size32(draws); ++i)
+		{
+			const om2_rec& r = *draws[i].r;
+			if (draws[i].pipe != bound)
+			{
+				bound = draws[i].pipe;
+				vkCmdBindPipeline(cmd, VK_PIPELINE_BIND_POINT_GRAPHICS, bound);
+			}
+			const VkDescriptorSet sets[2] = { r.set0, o.set };
+			vkCmdBindDescriptorSets(cmd, VK_PIPELINE_BIND_POINT_GRAPHICS, r.layout, 0, 2, sets, 0, nullptr);
+			vkCmdSetViewport(cmd, 0, 1, &r.vp);
+			vkCmdSetScissor(cmd, 0, 1, &r.sc);
+			// Toward the camera: the redrawn surface passes against its own depth (relaxed compare)
+			vkCmdSetDepthBias(cmd, r.inverted ? 4.f : -4.f, 0.f, r.inverted ? 1.f : -1.f);
+			if (r.indexed)
+			{
+				vkCmdBindIndexBuffer(cmd, r.ibuf, r.ioff, r.itype);
+				vkCmdDrawIndexed(cmd, r.count, 1, 0, 0, i);
+			}
+			else
+			{
+				vkCmdDraw(cmd, r.count, 1, 0, i);
+			}
+			o.n_replay++;
+		}
+		vk::end_renderpass(cmd);
+		fbo->release();
+		ds->pop_layout(cmd);
+		cmd.r2_invalidate_state_cache();
+		cmd.flags |= vk::command_buffer::cb_reload_dynamic_state;
+		o.recs.clear();
+		o.ran = true;
+		return true;
+	}
+}
+
+void VKGSRender::r2aa_run()
+{
+	auto& st = g_r2;
+	st.aa_done = true;
+	st.boundary_pending = r2cfg().split;
+	if (r2cfg().trace && (st.frame % static_cast<u32>(r2cfg().trace)) == 0 && st.frame) r2log("T f%u AA RUN before draw %u", st.frame, st.draw_index);
+	if (st.disabled) return;
+	run_timer timer(true);
+
+	auto& sc = res()->surface_cache;
+	vk::render_target* rt = st.rt_ptr;
+	vk::render_target* ds = st.ds_ptr;
+	if (st.resolve_wait)
+	{
+		// Upscale the resolved scene: the surface now at the scene colour address
+		st.resolve_wait = false;
+		rt = sc.get_surface_at(st.scene_rt);
+		if (rt && !(rt->resolution_scaling_config == RSX(m_ctx)->resolution_scaling_config)) rt = nullptr;
+	}
+	if (!st.scene_draws || !rt || !ds || !st.frame_S.valid || st.vw < 1 || st.vh < 1)
+	{
+		skip_once("scene incomplete (no colour/depth target seen)");
+		return;
+	}
+	if (sc.get_surface_at(st.scene_rt) != rt || (sc.get_surface_at(st.scene_ds) != ds && sc.m_bound_depth_stencil.second != ds))
+	{
+		// The scene address may be rebound in another layout before the upscaler runs. The surface now there holds
+		// the latest scene (it inherited the old one): use it when it is usable.
+		const auto& cur_cfg = RSX(m_ctx)->resolution_scaling_config;
+		auto usable = [&](vk::render_target* s, bool depth)
+		{
+			return s && s->is_depth_surface() == depth && s->samples() == 1 && s->resolution_scaling_config == cur_cfg;
+		};
+		auto* cur_rt = sc.get_surface_at(st.scene_rt);
+		auto* cur_ds = sc.m_bound_depth_stencil.second == ds ? ds : sc.get_surface_at(st.scene_ds);
+		if (usable(cur_rt, false) && usable(cur_ds, true))
+		{
+			rt = cur_rt;
+			ds = cur_ds;
+		}
+		else
+		{
+			if (r2cfg().debug && (st.frame % 300) < 2)
+			{
+				r2log("surfaces replaced at draw %u: rt %p/%p ds %p/%p bound rt %08x ds %08x", st.draw_index,
+					static_cast<void*>(sc.get_surface_at(st.scene_rt)), static_cast<void*>(rt),
+					static_cast<void*>(sc.get_surface_at(st.scene_ds)), static_cast<void*>(ds),
+					sc.m_bound_render_targets[0].first, sc.m_bound_depth_stencil.first);
+			}
+			skip_once("scene surfaces were replaced before the upscaler ran");
+			return;
+		}
+	}
+	if (rt->samples() > 1 || ds->samples() > 1)
+	{
+		skip_once("scene is multisampled; set the RPCS3 MSAA option off");
+		return;
+	}
+
+	const VkFormat cfmt = rt->info.format;
+	const bool half = cfmt == VK_FORMAT_R16G16B16A16_SFLOAT;
+	const bool swap = cfmt == VK_FORMAT_B8G8R8A8_UNORM;
+	if (!half && !swap && cfmt != VK_FORMAT_R8G8B8A8_UNORM)
+	{
+		skip_once("unsupported scene colour format " + std::to_string(static_cast<int>(cfmt)));
+		return;
+	}
+
+	const u32 cw = std::min({ static_cast<u32>(st.vw), rt->info.extent.width, ds->info.extent.width });
+	const u32 ch = std::min({ static_cast<u32>(st.vh), rt->info.extent.height, ds->info.extent.height });
+	if (cw < 16 || ch < 16)
+	{
+		skip_once("scene too small");
+		return;
+	}
+	// Output size: the full-resolution scene viewport when the scene section was rendered at a reduced scale
+	const bool upscaling = st.window;
+	// Lock the input to the area every layout of the scene covers (see lock_w): it only shrinks, and starts over
+	// on a scene change, a switch between upscaling and DLAA, or content much smaller than the lock.
+	if (st.lock_w && (st.lock_up != upscaling || cw * 4 < st.lock_w * 3 || ch * 4 < st.lock_h * 3)) st.lock_w = st.lock_h = 0;
+	// A larger scene for a long time (no run at the locked size for ~5 s): the game's scene really grew
+	st.lock_bigger = (st.lock_w && (cw > st.lock_w || ch > st.lock_h)) ? st.lock_bigger + 1 : 0;
+	if (st.lock_bigger > 300) st.lock_w = st.lock_h = st.lock_bigger = 0;
+	if (!st.lock_w || cw < st.lock_w || ch < st.lock_h)
+	{
+		const u32 nw = st.lock_w ? std::min(st.lock_w, cw) : cw;
+		const u32 nh = st.lock_h ? std::min(st.lock_h, ch) : ch;
+		if (st.lock_w && (nw != st.lock_w || nh != st.lock_h))
+			r2log("scene area %ux%u -> %ux%u (the scene target is bound with another size; using the common area)", st.lock_w, st.lock_h, nw, nh);
+		st.lock_w = nw;
+		st.lock_h = nh;
+		st.lock_up = upscaling;
+	}
+	const u32 rw = st.lock_w;
+	const u32 rh = st.lock_h;
+	// Same ratio as the viewport's full-resolution size to its reduced one (RSX_RES_SCALE / upscaled scale)
+	const u32 ow = upscaling && st.vw > 0 ? std::max(rw, static_cast<u32>(std::lround(rw * (st.ow / st.vw)))) : rw;
+	const u32 oh = upscaling && st.vh > 0 ? std::max(rh, static_cast<u32>(std::lround(rh * (st.oh / st.vh)))) : rh;
+	if (r2cfg().trace && (st.frame % static_cast<u32>(r2cfg().trace)) == 0 && st.frame)
