+		struct ring_state
+		{
+			u8* mem = nullptr;
+			u64 size = 0;
+			u64 mask = 0;
+
+			// Producer-only line (round 10): nothing here is touched by the record thread, so writing a packet
+			// does not pull a cache line the record thread is reading
+			alignas(64) u64 local_head = 0; // producer cursor (packets being written)
+			u64 pub_head = 0;    // last value stored to head
+			u64 cached_tail = 0; // last tail seen; the real tail is only re-read when the ring looks full
+			u64 pub_bytes = 0;   // RSX_RECORD_PUB_BYTES
+			u64 p_packets = 0, p_bytes = 0, p_publishes = 0;
+
+			alignas(64) std::atomic<u64> head{0}; // published by the producer
+			alignas(64) std::atomic<u64> tail{0}; // advanced by the replayer
+			alignas(64) std::atomic<u32> sleeping{0};
+			std::atomic<u32> wake_seq{0};
+			std::atomic<bool> quit{false};
+
+			std::thread thr;
+			std::mutex replay_mtx; // mode 2: replays on whichever thread drains
+			int spin_us = 250;
+			bool stats = true;
+			bool running = false;
+
+			// stats (cumulative); busy_ns is written by the record thread, keep it off the producer's lines
+			alignas(64) std::atomic<u64> busy_ns{0};
+			alignas(64) std::atomic<u64> drain_wait_ns{0}, stalls{0}, stall_ns{0}, fallbacks{0}, other_drains{0};
+			std::atomic<u64> drains[static_cast<size_t>(reason::count)]{};
+
+			// stats window (producer only)
+			u64 win_t0 = 0, win_frames = 0;
+			u64 last_packets = 0, last_bytes = 0, last_publishes = 0, last_busy = 0, last_wait = 0, last_stalls = 0, last_stall_ns = 0, last_fallbacks = 0, last_other = 0;
+			u64 last_drains[static_cast<size_t>(reason::count)]{};
+		};
+
+		ring_state g;
+
+		// Replays [tail, head). Mode 1: the record thread only. Mode 2: under replay_mtx.
+		void replay_pending()
+		{
+			u64 t = g.tail.load(std::memory_order_relaxed);
+			u64 h = g.head.load(std::memory_order_acquire);
+			if (t == h)
+			{
+				return;
+			}
+
+			const u64 t0 = now_ns();
+			while (t != h)
+			{
+				const header* hd = reinterpret_cast<const header*>(g.mem + (t & g.mask));
+				if (hd->fn)
+				{
+					hd->fn(hd + 1);
+				}
+				t += hd->size;
+				g.tail.store(t, std::memory_order_release);
+				if (t == h)
+				{
+					h = g.head.load(std::memory_order_acquire);
+				}
+			}
+			g.busy_ns.fetch_add(now_ns() - t0, std::memory_order_relaxed);
+		}
+
+		void record_thread_main()
+		{
+#ifdef _WIN32
+			SetThreadDescription(GetCurrentThread(), L"rsx record");
+			SetThreadPriority(GetCurrentThread(), THREAD_PRIORITY_ABOVE_NORMAL);
+#endif
+			const u64 spin_ns = static_cast<u64>(g.spin_us) * 1000;
+			for (;;)
+			{
+				replay_pending();
+
+				const u64 t = g.tail.load(std::memory_order_relaxed);
+				// Spin a little: packets arrive every few microseconds while the guest draws
+				const u64 s0 = now_ns();
+				u32 it = 0;
+				bool work = false;
+				while (true)
+				{
+					if (g.head.load(std::memory_order_acquire) != t) { work = true; break; }
+					if (g.quit.load(std::memory_order_relaxed)) break;
+					cpu_relax();
+					if ((++it & 63) == 0 && now_ns() - s0 >= spin_ns) break;
+				}
+				if (work)
+				{
+					continue;
+				}
+				if (g.quit.load(std::memory_order_acquire) && g.head.load(std::memory_order_acquire) == t)
+				{
+					break;
+				}
+
+				// Sleep (Dekker with the producer's publish: store sleeping, then re-check head)
+				g.sleeping.store(1, std::memory_order_seq_cst);
+				const u32 ws = g.wake_seq.load(std::memory_order_seq_cst);
+				if (g.head.load(std::memory_order_seq_cst) == t && !g.quit.load(std::memory_order_seq_cst))
+				{
+					g.wake_seq.wait(ws, std::memory_order_seq_cst);
+				}
+				g.sleeping.store(0, std::memory_order_relaxed);
+			}
+		}
+
+		void publish_now()
+		{
+			if (g.pub_head == g.local_head)
+			{
+				return;
+			}
+			g.pub_head = g.local_head;
+			g.p_publishes++;
+			if (g_mode == 1)
+			{
+				g.head.store(g.local_head, std::memory_order_seq_cst);
+				if (g.sleeping.load(std::memory_order_seq_cst))
+				{
+					g.wake_seq.fetch_add(1, std::memory_order_seq_cst);
+					g.wake_seq.notify_one();
+				}
+			}
+			else
+			{
+				g.head.store(g.local_head, std::memory_order_release);
+			}
+		}
+
+		// RSX_RECORD_PUB_BYTES (round 10): every packet is still published at once (a plain release store, so a drain on
+		// any thread covers everything recorded before it), but the seq_cst store + sleeping check that can wake the
+		// record thread (a locked instruction that waits for the head line to come back from the spinning record
+		// thread) runs only once this many bytes accumulated. A record thread that went to sleep in between is woken
+		// by that, by any drain (producer or foreign, sync_slow) or by a full ring (ensure_space).
+		// 0 = the full publish for every packet (round 9).
+		void publish()
+		{
+			if (g.local_head - g.pub_head >= g.pub_bytes)
+			{
+				publish_now();
+				return;
+			}
+			g.head.store(g.local_head, std::memory_order_release);
+		}
+
+		void wake_if_sleeping()
+		{
+			if (g_mode == 1 && g.sleeping.load(std::memory_order_seq_cst))
+			{
+				g.wake_seq.fetch_add(1, std::memory_order_seq_cst);
+				g.wake_seq.notify_one();
+			}
+		}
+
+		void wait_for_tail(u64 target)
+		{
+			u32 it = 0;
+			while (g.tail.load(std::memory_order_acquire) < target)
+			{
+				if (++it < 20000)
+				{
+					cpu_relax();
+				}
+				else
+				{
+					std::this_thread::yield();
+				}
+			}
+		}
+
+		// Make room for n bytes after the producer cursor
+		void ensure_space(u64 n)
+		{
+			if (g.local_head + n - g.cached_tail <= g.size)
+			{
+				return;
+			}
+			g.cached_tail = g.tail.load(std::memory_order_acquire);
+			if (g.local_head + n - g.cached_tail <= g.size)
+			{
+				return;
+			}
+			const u64 t0 = now_ns();
+			g.stalls.fetch_add(1, std::memory_order_relaxed);
+			publish_now(); // the record thread can only free space up to the published head
+			if (g_mode == 2)
+			{
+				std::lock_guard lock(g.replay_mtx);
+				replay_pending();
+			}
+			else
+			{
+				wait_for_tail(g.local_head + n - g.size);
+			}
+			g.cached_tail = g.tail.load(std::memory_order_acquire);
+			g.stall_ns.fetch_add(now_ns() - t0, std::memory_order_relaxed);
+		}
+
+		// Reserves a packet; nullptr when it is too large for the ring (the caller records directly)
+		u8* begin_packet(size_t payload, replay_fn fn)
+		{
+			const u64 n = align16(sizeof(header) + payload);
+			if (n > g.size / 4)
+			{
+				return nullptr;
+			}
+			const u64 off = g.local_head & g.mask;
+			if (off + n > g.size)
+			{
+				const u64 waste = g.size - off;
+				ensure_space(waste + n);
+				header* wrap = reinterpret_cast<header*>(g.mem + off);
+				wrap->size = static_cast<u32>(waste);
+				wrap->fn = nullptr;
+				g.local_head += waste;
+			}
+			else
+			{
+				ensure_space(n);
+			}
+			header* hd = reinterpret_cast<header*>(g.mem + (g.local_head & g.mask));
+			hd->size = static_cast<u32>(n);
+			hd->fn = fn;
+			g.local_head += n;
+			g.p_packets++;
+			g.p_bytes += n;
+			return reinterpret_cast<u8*>(hd + 1);
+		}
+
+		// Packet with an argument struct P followed by deep-copied arrays
+		template <typename P>
+		struct packet
+		{
+			P* args = nullptr;
+			u8* cur = nullptr;
+
+			packet(size_t extra, replay_fn fn)
+			{
+				if (u8* m = begin_packet(align16(sizeof(P)) + extra, fn))
+				{
+					args = new (m) P{};
+					cur = m + align16(sizeof(P));
+				}
+			}
+			~packet()
+			{
+				if (args) publish();
+			}
+			explicit operator bool() const { return args != nullptr; }
+
+			template <typename T>
+			T* copy(const T* src, size_t n)
+			{
+				if (!src || !n) return nullptr;
+				T* dst = reinterpret_cast<T*>(cur);
+				std::memcpy(dst, src, sizeof(T) * n);
+				cur += align16(sizeof(T) * n);
+				return dst;
+			}
+			void* copy_bytes(const void* src, size_t n)
+			{
+				if (!src || !n) return nullptr;
+				void* dst = cur;
+				std::memcpy(dst, src, n);
+				cur += align16(n);
+				return dst;
+			}
+		};
+
+		template <typename T>
+		constexpr size_t bytes(const T* src, size_t n) { return (src && n) ? align16(sizeof(T) * n) : 0; }
+
+		// Plain arguments: a tuple replayed with std::apply
+		template <auto Fn, typename T>
+		void replay_tuple(const void* d)
+		{
+			std::apply(Fn, *static_cast<const T*>(d));
+		}
+
+		template <auto Fn, typename... A>
+		void pod(A... a)
+		{
+			using T = std::tuple<A...>;
+			u8* m = begin_packet(sizeof(T), &replay_tuple<Fn, T>);
+			new (m) T(a...);
+			publish();
+		}
+
+		void fallback()
+		{
+			g.fallbacks.fetch_add(1, std::memory_order_relaxed);
+			sync_slow(reason::fallback);
+		}
+
+		template <typename T>
+		bool chain_free(const T* arr, u32 n)
+		{
+			for (u32 i = 0; arr && i < n; i++)
+			{
+				if (arr[i].pNext) return false;
+			}
+			return true;
+		}
