+	// Screen transform of the vertex env: (sx,ox,sy,oy,sz,oz) -> 4x4 applied to the raw clip position
+	struct screen_xform
+	{
+		float sx = 1, ox = 0, sy = 1, oy = 0, sz = 1, oz = 0, n = 0, f = 1;
+		bool valid = false;
+	};
+
+	m4 m4_screen(const screen_xform& s)
+	{
+		m4 r{};
+		r.m[0][0] = s.sx; r.m[0][3] = s.ox;
+		r.m[1][1] = s.sy; r.m[1][3] = s.oy;
+		r.m[2][2] = s.sz; r.m[2][3] = s.oz;
+		r.m[3][3] = 1.0;
+		return r;
+	}
+
+	// RSX_AA_FRAME_S_VOTE: screen_xform <-> the 8 floats of pdq_s_tally
+	void s_to_arr(const screen_xform& s, float* o)
+	{
+		o[0] = s.sx; o[1] = s.ox; o[2] = s.sy; o[3] = s.oy; o[4] = s.sz; o[5] = s.oz; o[6] = s.n; o[7] = s.f;
+	}
+	screen_xform s_from_arr(const float* a)
+	{
+		return { a[0], a[1], a[2], a[3], a[4], a[5], a[6], a[7], true };
+	}
+
+	// Camera of a perspective world -> clip matrix V (rows: clip x, y, z, w) for FSR / frame generation: distances along
+	// the view axis at depth buffer values 0 and 1 (near / far, as the upscalers' depth linearisation expects) and the
+	// vertical FOV. Window depth = S.sz * z/w + S.oz, buffer = (window - zB) / zA. False unless V is a plain pinhole
+	// projection (clip z row parallel to the w row) with plausible results.
+	bool camera_planes(const m4& V, const screen_xform& S, double zA, double zB, double& n, double& f, double& fov)
+	{
+		double ww = 0, zw = 0, zz = 0, yy = 0;
+		for (int i = 0; i < 3; ++i)
+		{
+			ww += V.m[3][i] * V.m[3][i];
+			zw += V.m[2][i] * V.m[3][i];
+			zz += V.m[2][i] * V.m[2][i];
+			yy += V.m[1][i] * V.m[1][i];
+		}
+		if (!(ww > 1e-20) || !(yy > 1e-20) || std::fabs(S.sz) < 1e-9 || std::fabs(zA) < 1e-9) return false;
+		const double a = zw / ww;                         // clip z = a * w + b
+		if (zz - a * a * ww > 1e-6 * zz) return false;
+		const double b = V.m[2][3] - a * V.m[3][3];
+		const double wl = std::sqrt(ww);                  // view distance = w / wl
+		auto dist = [&](double t)
+		{
+			const double q = ((t * zA + zB) - S.oz) / S.sz - a;
+			return std::fabs(q) > 1e-12 ? b / (wl * q) : -1.0;
+		};
+		const double d0 = dist(0.0), d1 = dist(1.0);
+		const bool p0 = std::isfinite(d0) && d0 > 0, p1 = std::isfinite(d1) && d1 > 0;
+		if (p0 && p1) { n = std::fmin(d0, d1); f = std::fmax(d0, d1); }
+		else if (p0 || p1) { n = p0 ? d0 : d1; f = n * 1e5; } // far plane at infinity
+		else return false;
+		fov = 2.0 * std::atan(wl / std::sqrt(yy));
+		return n > 1e-6 && f > n * 1.001 && std::isfinite(f) && fov > 0.05 && fov < 3.0;
+	}
+
+	// ---- RSX vertex program interpreter (enough to evaluate the position output) ----
+	// Runs the program for VPL input positions at once ("lanes"): each instruction is decoded once and every lane
+	// does exactly the arithmetic a separate single-point run would do. Control flow depends only on the branch
+	// bits (condition-code tests are not interpreted), so all lanes follow the same path.
+	constexpr int VPL = 5;
+
+	struct vp_code
+	{
+		const u32* data = nullptr;
+		u32 count = 0; // instructions
+		u32 pc0 = 0;   // entry - base_address
+	};
+
+	// R2PORT: RSX_VPRUN_FAST (default on). vp_run with a specialised operand fetch: only the sources the vector and
+	// scalar opcodes read are fetched, the register-type switch runs once per source instead of once per lane, a
+	// lane-invariant source (constant without address register, unused input, unwritten temp) is fetched once and
+	// copied to the other lanes, and abs/neg are the IEEE sign-bit operations fabs/negate perform. The arithmetic,
+	// its order, the stores and the control flow are vp_run's own, so out_pos and the result are bit-identical
+	// (scratch\rsx_native\vp_bench.cpp: differential fuzz over random programs, constants and inputs incl. NaN/inf).
+	bool vp_run_fast(const vp_code& vp, const float* consts, u32 branch_bits, const float in0[VPL][4], float out_pos[VPL][4])
+	{
+		static const float zero[4] = {};
+		// Sources read per vector opcode (bit 0: src0, bit 1: src1, bit 2: src2); 0x80: not interpreted (vp_run returns false)
+		static constexpr u8 vec_use[32] =
+		{
+			0, 1, 3, 5, 7, 3, 3, 3,             // NOP MOV MUL ADD MAD DP3 DPH DP4
+			3, 3, 3, 3, 3, 1, 1, 1,             // DST MIN MAX SLT SGE ARL FRC FLR
+			3, 0, 3, 3, 3, 0, 1, 0x80,          // SEQ SFL SGT SLE SNE STR SSG -
+			0x80, 0x80, 0x80, 0x80, 0x80, 0x80, 0x80, 0x80,
+		};
+		float r[64][VPL][4];
+		u64 rinit = 0;
+		float o[VPL][4] = {};
+		for (auto& v : o) v[3] = 1.f;
+		int a[VPL][2][4] = {};
+		u32 stack[8];
+		int sp = 0;
+
+		const u32* data = vp.data;
+		const u32 count = vp.count;
+		u32 pc = vp.pc0;
+
+		auto temp_w = [&](u32 idx) -> float(*)[4]
+		{
+			if (!((rinit >> idx) & 1))
+			{
+				std::memset(r[idx], 0, sizeof(r[idx]));
+				rinit |= 1ull << idx;
+			}
+			return r[idx];
+		};
+
+		for (int steps = 0; steps < 2048; ++steps)
+		{
+			if (pc >= count) return false;
+
+			D0 d0; D1 d1; D2 d2; D3 d3;
+			d0.HEX = data[pc * 4 + 0];
+			d1.HEX = data[pc * 4 + 1];
+			d2.HEX = data[pc * 4 + 2];
+			d3.HEX = data[pc * 4 + 3];
+
+			SRC src[3];
+			for (auto& s : src) s.HEX = 0;
+			src[0].src0l = d2.src0l;
+			src[0].src0h = d1.src0h;
+			src[1].src1 = d2.src1;
+			src[2].src2l = d3.src2l;
+			src[2].src2h = d2.src2h;
+
+			if (!src[0].reg_type || !src[1].reg_type || !src[2].reg_type)
+			{
+				break;
+			}
+
+			const u32 vop = d1.vec_opcode;
+			const u32 sop = d1.sca_opcode;
+			if (vop == RSX_VEC_OPCODE_TXL) return false;
+			if (d0.cond_test_enable && d0.cond != 7) return false;
+			const u32 vuse = vec_use[vop];
+			if (vuse & 0x80) return false;
+			const bool sreads = (sop >= RSX_SCA_OPCODE_MOV && sop <= RSX_SCA_OPCODE_LIT) || (sop >= RSX_SCA_OPCODE_LG2 && sop <= RSX_SCA_OPCODE_COS);
+			const u32 use = vuse | (sreads ? 4u : 0u);
+
+			auto fetch = [&](int n, float v[VPL][4])
+			{
+				const SRC& s = src[n];
+				const u32 sw0 = s.swz_x, sw1 = s.swz_y, sw2 = s.swz_z, sw3 = s.swz_w;
+				const bool abs_ = n == 0 ? d0.src0_abs : n == 1 ? d0.src1_abs : d0.src2_abs;
+				const u32 and_m = abs_ ? 0x7fffffffu : 0xffffffffu;
+				const u32 xor_m = s.neg ? 0x80000000u : 0u;
+				auto put = [&](float* dst, const float* p)
+				{
+					const float x[4] = { p[sw0], p[sw1], p[sw2], p[sw3] };
+					for (int i = 0; i < 4; ++i) dst[i] = std::bit_cast<float>((std::bit_cast<u32>(x[i]) & and_m) ^ xor_m);
+				};
+				auto put_all = [&](const float* p)
+				{
+					put(v[0], p);
+					for (int l = 1; l < VPL; ++l) std::memcpy(v[l], v[0], sizeof(v[0]));
+				};
+				switch (s.reg_type)
+				{
+				case RSX_VP_REGISTER_TYPE_TEMP:
+					if ((rinit >> s.tmp_src) & 1)
+						for (int l = 0; l < VPL; ++l) put(v[l], r[s.tmp_src][l]);
+					else
+						put_all(zero);
+					break;
