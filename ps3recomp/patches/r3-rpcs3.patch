+	prep->out_color = plain_view(st.color.get());
+	prep->out_depth = plain_view(st.depth.get());
+	prep->out_mv = plain_view(st.mv.get());
+	prep->in_prev_depth = plain_view(st.depth_prev.get());
+	prep->out_mask = plain_view(st.mask.get());
