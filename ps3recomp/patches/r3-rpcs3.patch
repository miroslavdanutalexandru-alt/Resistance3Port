+		// bias-current-colour mask there (strengths RSX_DLSS_BIAS_SKIN / _DYN / _NEW, 0..1). Opt-in (1); 0 (default): off.
+		bool biasmask = false;
+		float bias_skin = 0.6f, bias_dyn = 1.f, bias_new = 0.5f;
+		u32 om_max_replays = 384;   // RSX_DLSS_OBJMV_MAX: ID redraws / GPU history slots per frame (was 128: R2 jungle intro filled all 128 every frame, later moving draws got camera motion only)
+		float om_max_motion = 0.1f; // RSX_DLSS_OBJMV_LIMIT: larger per-object motion (screen fraction) = a wrong match
+		// RSX_DLSS_OBJMV_REPAIR=0: off. A draw paired with last frame's same-key draw by occurrence ordinal whose motion
+		// disagrees with the camera is first re-paired with another occurrence of that key that agrees with it (rows of
+		// identical props, e.g. parked cars, reordered or culled: car N paired with car N+1 got that car's motion).
+		bool om_repair = true;
+		// RSX_DLSS_OBJMV_HSUBMIT=0: at a mid-frame submit where the segment replay can't run, drop the pending history
+		// copies instead of issuing them (old behaviour)
+		bool om_hsubmit = true;
+		// RSX_DLSS_MASK_PREVJIT=0: the moving-object mask looks up the previous depth without the previous frame's jitter
+		bool mask_prevjit = true;
+		// RSX_DLSS_OBJMV_MODE=onepass|replay (RSX_DLSS_OBJMV=1 only). replay: every moving draw is recorded and drawn
+		// again into a velocity target after the scene (old path). onepass (default): the moving draw itself runs with a
+		// variant of its own pipeline whose vertex shader also evaluates the previous frame's constants and whose
+		// fragment shader stores the velocity (nearest fragment wins, 64-bit atomic min) into a per-pixel buffer: no
+		// second draw, no extra render pass. Needs shaderBufferInt64Atomics + fragmentStoresAndAtomics, else replay.
+		int om_mode = 1; // 0 replay, 1 onepass
+		// RSX_DLSS_OBJMV_DEFORM (default 1; onepass only): matched draws whose vertex data the CPU/SPU rewrote since last
+		// frame (cloth, SPU skinning; sparse hash) keep a GPU copy of their uploaded vertex stream; next frame the variant
