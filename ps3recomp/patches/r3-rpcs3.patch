+	std::wstring exe_dir()
+	{
+		wchar_t path[MAX_PATH * 2] = {};
+		const DWORD n = GetModuleFileNameW(nullptr, path, static_cast<DWORD>(std::size(path)));
+		std::wstring s(path, n);
