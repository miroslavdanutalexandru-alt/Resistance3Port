+		u32 vel_len = 32;
+		std::unique_ptr<vk::sampler> m_sampler;
+
+		r2aa_prep_pass()
+		{
+			m_src = std::string(
+				"#version 450\n"
+				"layout(local_size_x = 8, local_size_y = 8) in;\n"
+				"layout(set=0, binding=0) uniform sampler2D ColorIn;\n"
+				"layout(set=0, binding=1) uniform sampler2D DepthIn;\n"
+				"layout(set=0, binding=2, rgba16f) uniform writeonly image2D ColorOut;\n"
+				"layout(set=0, binding=3, r32f) uniform writeonly image2D DepthOut;\n"
+				"layout(set=0, binding=4, rg16f) uniform writeonly image2D MvOut;\n"
+				"layout(set=0, binding=5) uniform sampler2D PrevDepthIn;\n"
+				"layout(set=0, binding=6, r8) uniform writeonly image2D MaskOut;\n"
+				"layout(set=0, binding=7) uniform sampler2D IdIn;\n"
+				"struct ObjE { mat4 T; vec4 info; };\n"
+				"layout(std430, set=0, binding=8) readonly buffer ObjTable { ObjE obj[]; };\n"
+				"layout(std430, set=0, binding=9) readonly buffer VelBuf { uvec4 vw; uvec2 vel[]; };\n"
+				// view: jitter ndc xy, viewport wh; opts: zA, zB, rw, rh; opts2: has previous depth, depth inverted,
+				// half2(mask lo, hi-lo), RSX_DLSS_MASK_FAR lin (0 = off)
+				// opts3: object IDs valid, ID count, depth tolerance
+				"layout(push_constant) uniform PC { mat4 T; vec4 view; vec4 opts; vec4 opts2; vec4 opts3; };\n"
+				// depth -> a value proportional to 1 / view distance (relative comparisons = distance ratios)
+				"float lin(float raw) { return opts2.y > 0.5 ? raw : 1.0 - raw; }\n" +
+				r2_om_guard_glsl() +
+				"void main()\n"
+				"{\n"
+				"	float r2dbg = 0.0;\n"
+				// RSX_AA_DYNRES: the images can be larger than the scene (rw x rh): the rest repeats the edge pixels
+				"	ivec2 o = ivec2(gl_GlobalInvocationID.xy);\n"
+				"	if (any(greaterThanEqual(o, imageSize(ColorOut)))) return;\n"
+				"	ivec2 p = min(o, ivec2(opts.zw) - 1);\n"
+				"	vec4 c = texelFetch(ColorIn, p, 0);\n") +
+				// RSX_DLSS_SANITIZE: NaN/Inf/negative HDR texels (fp16 light/DOF math) never reach the upscaler history
+				(r2cfg().dlss_sanitize ? "	for (int i = 0; i < 4; ++i) if (isnan(c[i]) || isinf(c[i])) c[i] = 0.0;\n"
+				                         "	c.rgb = clamp(c.rgb, 0.0, 65504.0);\n" : "") +
+				"	float d = texelFetch(DepthIn, p, 0).r;\n"
+				"	imageStore(ColorOut, o, c);\n"
+				"	imageStore(DepthOut, o, vec4(d));\n"
+				"	vec2 ndc = (vec2(p) + 0.5) / view.zw * 2.0 - 1.0 - view.xy;\n"
+				// a pixel last written by an ID-redrawn draw (same depth): that object's reprojection / mask strength
+				"	mat4 Tm = T;\n"
+				"	float mb = 0.0;\n"
+				"	if (opts3.x > 0.5 && opts3.x < 1.5)\n"
+				"	{\n"
+				"		vec2 iz = texelFetch(IdIn, p, 0).rg;\n"
+				"		int id = int(iz.r + 0.5);\n"
+				"		if (id > 0 && id <= int(opts3.y) && abs(iz.g - d) <= opts3.z)\n"
+				"		{\n"
+				"			vec4 info = obj[id - 1].info;\n"
