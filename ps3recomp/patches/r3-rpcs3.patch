+		VkDescriptorSetLayout op_set_layout = VK_NULL_HANDLE; // binding 0: sbuf (vertex), 1: vb (fragment), 2: dview (vertex)
+		VkDescriptorPool op_pool = VK_NULL_HANDLE;
