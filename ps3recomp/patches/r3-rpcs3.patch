+		u32 op_sets_left = 0;
+		std::unordered_map<u64, VkPipelineLayout> op_layouts; // per game (vertex, fragment) set layouts
+		std::unique_ptr<vk::buffer> vb;                       // uvec4 (w, h, inverted, 0) + w * h u64
+		std::unique_ptr<vk::buffer> vb_dummy;                 // prep pass binding when vb doesn't exist
+		VkDeviceSize vb_size = 0;
+		u32 vb_w = 0, vb_h = 0;                               // grid of the last clear (the scene depth size)
+		bool vb_clean = false;                                // cleared, not consumed yet: onepass draws may write
+		bool vb_written = false;                              // a onepass draw ran since the clear
+		bool op_failed = false;
+		u32 t_op_keep = 0; // RSX_OBJMV_ONEPASS_KEEP_DYN: onepass draws that kept dynamic state + index binding (stats window)
+		u32 n_op = 0, t_op = 0; u32 t_op_push = 0; // RSX_VK_PUSH_DESC=1: onepass draws whose fragment set was re-pushed (stats window)                               // onepass draws
+		// RSX_DLSS_OBJMV_DEFORM: previous vertex streams. [2][dhalf] bytes, an R8_UINT texel view (set 2, binding 2).
+		// dcopy is issued with hcopy (same slots, so hvalid also covers it).
+		std::unique_ptr<vk::buffer> dbuf;
+		std::unique_ptr<vk::buffer_view> dview;
+		VkDeviceSize dhalf = 0, dused = 0;
+		std::vector<VkBufferCopy> dcopy;
+		VkBuffer dsrc = VK_NULL_HANDLE;
+		u32 dn = 0;
+		u32 n_dcap = 0, n_dfm = 0, n_dmiss = 0, t_dcap = 0, t_dfm = 0, t_dmiss = 0; // captured / used / guard fallbacks
+		u64 cpu_ns = 0, t_cpu_ns = 0;                         // render-thread time in the objmv code
+	};
+	om2_state_t g_om2;
