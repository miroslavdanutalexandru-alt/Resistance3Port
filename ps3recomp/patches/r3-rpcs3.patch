+	}
+	if (!st.cur_scene && st.link_bind && st.window && st.section && !st.aa_done && r2cfg().link_jit && (!dwrite || r2cfg().link_jit == 2) &&
+		!(r2cfg().link_quad && !dtest && r2aa_small_draw(regs->current_draw_clause, 6)))
+	{
+		// R2PORT: RSX_DLSS_LINK_FULLSCREEN / RSX_DLSS_DARKPATCH_LOG (dark-patch investigation, default off)
+		const bool dp_skip = r2cfg().dp_link_fs && !dtest && !dwrite;
+		if (r2cfg().dp_log)
+		{
+			static int dp_logged = 0;
+			if (dp_logged < r2cfg().dp_log)
+			{
+				dp_logged++;
+				const auto& dc = regs->current_draw_clause;
+				std::string tex;
+				for (u32 mask = m_ctx->program.fp_metadata.referenced_textures_mask, i = 0; mask; mask >>= 1, ++i)
+				{
+					if (!(mask & 1) || !regs->fragment_textures[i].enabled()) continue;
+					char b[40];
+					std::snprintf(b, sizeof(b), " t%u=%08x", i, regs->fragment_textures[i].offset());
+					tex += b;
+				}
+				r2log("darkpatch f%u d%u: linked-pass draw rt %08x ds %08x %s %u elements dtest %d dwrite %d -> %s%s",
+					st.frame, st.draw_index, rt_addr, ds_addr, dc.command == rsx::draw_command::inlined_array ? "inlined" :
+					dc.command == rsx::draw_command::indexed ? "indexed" : "array", dc.r2_total_elements(), dtest ? 1 : 0,
+					dwrite ? 1 : 0, dp_skip ? "NOT jittered (RSX_DLSS_LINK_FULLSCREEN)" : "jittered", tex.c_str());
+			}
+		}
+		if (!dp_skip)
+		{
+		// RSX_AA_LINK_JITTER: same jitter as the scene draws whose depth/G-buffer this pass reads
+		const auto& vp = m_ctx->draw_state.viewport;
+		const auto [cw, ch] = rsx::apply_resolution_scale<true>(RSX(m_ctx)->resolution_scaling_config, vp.clip_width, vp.clip_height);
+		st.vw = static_cast<float>(cw);
+		st.vh = static_cast<float>(ch);
+		st.cur_jit = true;
+		}
+	}
+	const bool nocolor = !rt_addr || !regs->color_write_enabled(0);
+	const bool query = RSX(m_ctx)->zcull().is_zpass_count_active();
+	if (st.pl.open)
+	{
+		if (query) st.pl.query++;
+		if (nocolor) st.pl.nocolor++;
+	}
+	if (!st.cur_jit && r2cfg().post_jit && st.aa_done && !st.window && dtest && !dwrite && ds_addr && (st.jx != 0.f || st.jy != 0.f) &&
+		(r2cfg().post_jit == 2 || nocolor) && st.red_cfg.scale_percent &&
+		(ds_addr == st.scene_ds || st.link_prev.count(ds_addr) || st.link_cur.count(ds_addr)))
+	{
+		// RSX_AA_POST_JITTER: the depth was rendered reduced and jittered by (jx, jy) reduced pixels
+		const auto& vp = m_ctx->draw_state.viewport;
+		const auto [cw, ch] = rsx::apply_resolution_scale<true>(st.red_cfg, vp.clip_width, vp.clip_height);
+		st.vw = static_cast<float>(cw);
+		st.vh = static_cast<float>(ch);
+		st.cur_jit = true;
+	}
+	if (r2cfg().ds_latch && ds_addr && (dtest || dwrite))
+	{
+		// RSX_AA_DS_LATCH: the same jitter as the draw that laid down this depth (see r2aa_before_bind for the scale)
+		r2aa_state::ds_latch_t* lp = st.lat_memo_addr == ds_addr ? st.lat_memo : nullptr;
+		if (!lp)
+		{
+			const auto fi = st.ds_lat.find(ds_addr);
+			if (fi != st.ds_lat.end())
+			{
+				lp = &fi->second;
+				st.lat_memo_addr = ds_addr;
+				st.lat_memo = lp;
+			}
+		}
+		if (lp && lp->live && pdq_latch_expires(st.frame, lp->frame, lp->wframe, lp->written, st.part_start, r2cfg().latch_keep)) lp->live = false;
+		else if (lp && lp->live && st.frame - lp->frame >= 2) st.stat_latch_keep++;
+		const bool live = lp && lp->live;
+		const bool same_frame = live && lp->jit_frame == st.frame;
+		// Jitter is latched within a frame only (the upscaler is handed this frame's jitter), and only up to the
+		// upscaler run (at DLAA nothing after the run is jittered); the scale latch (r2aa_before_bind) spans frames
+		if (same_frame && lp->reduced == st.section && st.scene_valid && !st.aa_done)
+		{
+			const auto& L = *lp;
+			// Jitter values always follow the depth; jitter on/off is forced only where a mismatch breaks the depth
+			// test (depth writes, EQUAL unless RSX_AA_JITTER_EQUAL=0): RSX_AA_JITTER_SCOPE keeps read-only LESS
+			// passes (light volumes) unjittered
+			const bool must = dwrite || (r2cfg().jit_equal && dtest && regs->depth_func() == rsx::comparison_function::equal);
+			const bool jit = (must || st.cur_jit) ? L.jit : false;
+			const bool differs = jit != st.cur_jit || (jit && (L.jx != st.jx || L.jy != st.jy));
+			if (differs)
+			{
+				st.stat_lat_jit++;
+				if (jit)
+				{
+					const auto& vp = m_ctx->draw_state.viewport;
+					const auto [cw, ch] = rsx::apply_resolution_scale<true>(RSX(m_ctx)->resolution_scaling_config, vp.clip_width, vp.clip_height);
+					st.vw = static_cast<float>(cw);
+					st.vh = static_cast<float>(ch);
+				}
+			}
+			st.cur_jit = jit;
+			st.use_jx = L.jx;
+			st.use_jy = L.jy;
+		}
+		else if (r2cfg().latch_eq_jit && live && lp->written && !dwrite && dtest && lp->reduced == st.section &&
+			regs->depth_func() == rsx::comparison_function::equal)
+		{
+			// RSX_AA_LATCH_EQ_JIT: EQUAL against depth laid down in an earlier logical frame / before the run
+			const auto& L = *lp;
+			if (L.wjit != st.cur_jit || (L.wjit && (L.wjx != st.use_jx || L.wjy != st.use_jy)))
+			{
+				st.stat_eq_jit++;
+				if (L.wjit)
+				{
+					const auto& vp = m_ctx->draw_state.viewport;
+					const auto [cw, ch] = rsx::apply_resolution_scale<true>(RSX(m_ctx)->resolution_scaling_config, vp.clip_width, vp.clip_height);
+					st.vw = static_cast<float>(cw);
+					st.vh = static_cast<float>(ch);
+				}
+			}
+			st.cur_jit = L.wjit;
+			st.use_jx = L.wjx;
+			st.use_jy = L.wjy;
+		}
+		// (Re)latch on the first depth write of a frame or a write at another scale, but once the upscaler ran never
+		// replace a live latch: full-scale draws after the window (first-person weapon) are overlays, not the scene.
+		// A depth with no live latch still latches after the run: that is a scene pre-pass that lands after an early
+		// upscaler run (R3 capture 5208), whose EQUAL material pass must then stay at the same scale.
+		// A depth write at the latch's scale by choice (not forced by the latch: lat_forced_ds) renews the scale age,
+		// also after the upscaler run for a latch formed after a run: a pre-pass that lands after an early run (5208)
+		// keeps its material pass at the same scale every frame. Forced writes never renew it, and neither do post-run
+		// writes (first-person weapon) into a latch formed before the run, so a stale latch still expires in two frames.
+		if (dwrite && live && lp->reduced == st.section && st.lat_forced_ds != ds_addr && (!st.aa_done || lp->late))
+			lp->frame = st.frame;
+		if (dwrite && (!live || (!st.aa_done && (!same_frame || lp->reduced != st.section))))
+		{
+			auto& L = st.ds_lat[ds_addr];
+			st.lat_memo_addr = ds_addr;
+			st.lat_memo = &L;
+			// The scale age restarts only for a new latch or a scale change: a depth rewritten every frame without a
+			// clear keeps aging, so a transitional full-scale latch expires after two frames instead of looping
+			if (!live || L.reduced != st.section)
+			{
+				L.frame = st.frame;
+				L.late = st.aa_done;
+			}
+			L.live = true;
+			L.reduced = st.section;
+			L.jit = st.cur_jit;
+			L.jx = st.cur_jit ? st.jx : 0.f;
+			L.jy = st.cur_jit ? st.jy : 0.f;
+			L.jit_frame = st.frame;
+		}
+		if (dwrite)
+		{
+			// The jitter / frame of the depth content as drawn (RSX_AA_LATCH_EQ_JIT, RSX_AA_LATCH_KEEP)
+			r2aa_state::ds_latch_t* wp = st.lat_memo_addr == ds_addr ? st.lat_memo : lp;
+			if (wp && wp->live)
+			{
+				wp->written = true;
+				wp->wframe = st.frame;
+				wp->wjit = st.cur_jit;
+				wp->wjx = st.cur_jit ? st.use_jx : 0.f;
+				wp->wjy = st.cur_jit ? st.use_jy : 0.f;
+			}
+		}
+		if (st.window && !st.section && st.scene_valid && rt_addr == st.scene_rt && ds_addr == st.scene_ds && st.lat_forced_ds == ds_addr)
+			st.lat_full_scene = true;
+	}
+	if (!st.cur_jit && r2cfg().occ_jit && st.scene_valid && !st.aa_done && dtest && !dwrite && nocolor && ds_addr &&
+		(st.jx != 0.f || st.jy != 0.f) && (r2cfg().occ_jit_stencil || !regs->stencil_test_enabled()) && st.jd_depth.count(ds_addr))
+	{
+		// RSX_AA_OCC_JITTER: an occlusion probe against a copy of the jittered depth gets the shift that copy holds
+		const auto si = st.jd_shift.find(ds_addr);
+		const auto& vp = m_ctx->draw_state.viewport;
+		const auto [cw, ch] = rsx::apply_resolution_scale<true>(RSX(m_ctx)->resolution_scaling_config, vp.clip_width, vp.clip_height);
+		const float js = r2cfg().jit_scale;
+		if (si != st.jd_shift.end() && si->second.w == cw && si->second.h == ch && cw && ch && js != 0.f &&
+			(si->second.sx != 0.f || si->second.sy != 0.f))
+		{
+			st.vw = static_cast<float>(cw);
+			st.vh = static_cast<float>(ch);
+			st.use_jx = si->second.sx / js;
+			st.use_jy = si->second.sy / js;
+			st.cur_jit = true;
+			st.stat_occ_jit++;
+			if (regs->stencil_test_enabled()) st.stat_occ_jit_st++;
+			if (!st.occ_jit_logged)
+			{
+				st.occ_jit_logged = true;
+				r2log("occlusion probe jitter f%u: depth-test-only draw against %08x (%ux%u, a copy of the jittered depth) shifted by "
+					"%.3f, %.3f px like its content (RSX_AA_OCC_JITTER=0: off)", st.frame, ds_addr, cw, ch, si->second.sx, si->second.sy);
+			}
+		}
+	}
+	st.lj_mask = 0;
+	if (!st.cur_jit && r2cfg().light_jit && st.scene_valid && !st.aa_done && !nocolor && ds_addr && (st.jx != 0.f || st.jy != 0.f) &&
+		st.jd_depth.count(ds_addr))
+	{
+		// RSX_AA_LIGHT_JITTER: the light quad gets its stencil marks' shift; its screen textures keep their coordinates
+		const auto& dc = regs->current_draw_clause;
+		const u32 elems = dc.command == rsx::draw_command::inlined_array ? 0u : dc.r2_total_elements();
+		const auto si = st.jd_shift.find(ds_addr);
+		const auto& vp = m_ctx->draw_state.viewport;
+		const auto [cw, ch] = rsx::apply_resolution_scale<true>(RSX(m_ctx)->resolution_scaling_config, vp.clip_width, vp.clip_height);
+		const float js = r2cfg().jit_scale;
+		if (si != st.jd_shift.end() && si->second.w == cw && si->second.h == ch && cw && ch && js != 0.f &&
+			(si->second.sx != 0.f || si->second.sy != 0.f) &&
+			pdq_light_jitter_draw(r2cfg().light_jit, !nocolor, dwrite, regs->stencil_test_enabled(), elems) &&
+			!vk::r2aa_uvj_scan(m_ctx->program.vertex_program, false))
+		{
+			auto& lsc = res()->surface_cache;
+			u16 mask = 0;
+			bool ok = true;
+			float bu = 0.f, bv = 0.f;
+			for (u32 m = m_ctx->program.fp_metadata.referenced_textures_mask & 0xffff, i = 0; m && ok; m >>= 1, ++i)
+			{
+				if (!(m & 1) || !regs->fragment_textures[i].enabled()) continue;
+				const auto& tex = regs->fragment_textures[i];
+				const u32 addr = rsx::get_address(m_ctx, tex.offset(), tex.location());
+				if (!st.jd_depth.count(addr))
+				{
+					// shadow maps (depth targets) and plain textures follow the shifted position; an unshifted colour
+					// target may be a screen texture of unknown mapping: leave the quad alone
+					const auto* s = lsc.get_surface_at(addr);
+					ok = !s || s->is_depth_surface();
+					continue;
+				}
+				if (r2cfg().light_smap && pdq_light_shadow_tex(tex.format() & ~(CELL_GCM_TEXTURE_LN | CELL_GCM_TEXTURE_UN), tex.width(),
+					tex.height(), vp.clip_width, vp.clip_height))
+				{
+					// RSX_AA_LIGHT_SMAP: a shadow map in the jittered-target set keeps its coordinates
+					st.stat_light_smap++;
+					if (!st.light_smap_logged)
+					{
+						st.light_smap_logged = true;
+						const auto ti = st.jd_shift.find(addr);
+						const bool te = ti != st.jd_shift.end();
+						r2log("light quad shadow map f%u: unit %u %08x (%ux%u fmt 0x%02x) is in the jittered-target set (entry %ux%u shift %.3f, %.3f) "
+							"but is a shadow map: no screen bias (RSX_AA_LIGHT_SMAP=0: old, biased)", st.frame, i, addr, tex.width(), tex.height(),
+							tex.format(), te ? ti->second.w : 0u, te ? ti->second.h : 0u, te ? ti->second.sx : 0.f, te ? ti->second.sy : 0.f);
+					}
+					continue;
+				}
+				const auto ti = st.jd_shift.find(addr);
+				ok = ti != st.jd_shift.end() &&
+					pdq_light_jitter_bias(si->second.sx, cw, ti->second.sx, ti->second.w, 0.05f, &bu) &&
+					pdq_light_jitter_bias(si->second.sy, ch, ti->second.sy, ti->second.h, 0.05f, &bv);
+				if (ok) mask |= static_cast<u16>(1u << i);
+			}
+			if (ok && mask)
+			{
+				st.vw = static_cast<float>(cw);
+				st.vh = static_cast<float>(ch);
+				st.use_jx = si->second.sx / js;
+				st.use_jy = si->second.sy / js;
+				st.cur_jit = true;
+				st.lj_mask = mask;
+				st.lj_bu = bu;
+				st.lj_bv = bv;
+				st.stat_light_jit++;
+				if (!st.light_jit_logged)
+				{
+					st.light_jit_logged = true;
+					r2log("light quad jitter f%u: stencil-tested light quad on %08x (%ux%u) shifted by %.3f, %.3f px like its stencil "
+						"marks; screen textures 0x%04x keep their coordinates (bias %.6f, %.6f) (RSX_AA_LIGHT_JITTER=0: off)",
+						st.frame, ds_addr, cw, ch, si->second.sx, si->second.sy, mask, bu, bv);
+				}
+			}
+			else if (!ok) st.stat_light_ref++;
+		}
+	}
+	if (st.fx_unj && st.cur_jit && !st.lj_mask && st.scene_valid && !st.aa_done)
+	{
+		// RSX_FX_UNJITTER: last, after the latch / probe / light rules (none of them applies to these draws)
+		st.cur_jit = false;
+		if (st.fx_unj_frame != st.frame) { st.fx_unj_frame = st.frame; st.fx_unj_frames++; }
+		if (!st.fx_unj_draws++ || !(st.fx_unj_draws % 100000))
+			r2log("fx unjitter f%u: %llu effect draws in %llu frames drawn without the scene jitter (RSX_FX_UNJITTER=%d; 0: off)",
+				st.frame, static_cast<unsigned long long>(st.fx_unj_draws), static_cast<unsigned long long>(st.fx_unj_frames), r2cfg().fx_unjit);
+	}
+	if (st.pl.open && st.cur_jit) st.pl.jit++;
+	const bool jd_diag = r2cfg().trigger_log && r2cfg().jit_diag;
+	if ((jd_diag || r2cfg().post_stable || r2cfg().occ_jit) && (st.jx != 0.f || st.jy != 0.f) && (rt_addr || ds_addr))
+	{
+		auto& T = jd_diag ? st.jd_tgt[pair] : st.jd_scratch;
+		if (!T.w)
+		{
+			const auto& vp = m_ctx->draw_state.viewport;
+			const auto [cw, ch] = rsx::apply_resolution_scale<true>(RSX(m_ctx)->resolution_scaling_config, vp.clip_width, vp.clip_height);
+			T.w = cw;
+			T.h = ch;
+		}
+		if (st.cur_jit)
+		{
+			T.jit++;
+			st.sl_jit++;
+			if (st.use_jx != st.jx || st.use_jy != st.jy) st.sl_jit_other++;
+			if (dwrite && ds_addr) jd_mark(st, ds_addr, 0);
+			if (!nocolor) jd_mark(st, rt_addr, 1);
+			if (st.vw > 0 && st.vh > 0)
+			{
+				const auto& vp = m_ctx->draw_state.viewport;
+				const auto [cw, ch] = rsx::apply_resolution_scale<true>(RSX(m_ctx)->resolution_scaling_config, vp.clip_width, vp.clip_height);
+				const float js = r2cfg().jit_scale;
+				const r2aa_state::jd_shift_t sh{ st.use_jx * js * (cw / st.vw), st.use_jy * js * (ch / st.vh), cw, ch, cw, ch };
+				if (dwrite && ds_addr) jd_put(st, ds_addr, 0, sh);
+				if (!nocolor) jd_put(st, rt_addr, 1, sh);
+			}
+		}
+		else
+		{
+			T.unjit++;
+			if (dtest && ds_addr && st.jd_depth.count(ds_addr))
+			{
+				jd_touch = true;
+				const bool eq = regs->depth_func() == rsx::comparison_function::equal;
+				if (st.aa_done) { T.post_jd++; st.sl_post_jd++; if (eq) T.post_jd_eq++; st.ps_seen.insert(ds_addr); }
+				else { T.unjit_jd++; if (eq) T.unjit_jd_eq++; }
+			}
+			if (st.jd_samp)
+			{
+				if (st.aa_done) { st.sl_post_samp++; T.post_samp++; T.samp_addr = st.jd_samp_addr; }
+				// copies / derivations of a jittered surface (depth copy c1380000, linear depth c1640000) hold its jitter
+				if (dwrite && ds_addr) jd_mark(st, ds_addr, 0);
+				if (!nocolor) jd_mark(st, rt_addr, 1);
+				const auto si = st.jd_shift.find(st.jd_samp_addr);
+				const auto& vp = m_ctx->draw_state.viewport;
+				const auto [cw, ch] = rsx::apply_resolution_scale<true>(RSX(m_ctx)->resolution_scaling_config, vp.clip_width, vp.clip_height);
+				if (si != st.jd_shift.end() && si->second.w && si->second.h && cw && ch)
+				{
+					const r2aa_state::jd_shift_t src = si->second;
+					const r2aa_state::jd_shift_t sh{ src.sx * cw / src.w, src.sy * ch / src.h, cw, ch,
+						std::min<u32>(src.gw ? src.gw : src.w, cw), std::min<u32>(src.gh ? src.gh : src.h, ch) };
+					if (dwrite && ds_addr) jd_put(st, ds_addr, 0, sh);
+					if (!nocolor) jd_put(st, rt_addr, 1, sh);
+				}
+			}
+		}
+	}
+	if (fexit)
+	{
+		// RSX_AA_FAST_EXIT: nothing done for this draw -> the next one with the same signature returns early
+		st.fast_ok = !st.cur_scene && !st.cur_jit && !st.fx_cur && st.om_cur < 0 && !jd_touch && !jd_samp_in && st.fast_gen == fgen_in;
+		st.fast_sig = fsig;
+		st.fast_gen_seen = fgen_in;
+	}
+	if (pd_t0)
+	{
+		st.pd_ns[4] += r2prof::now_ns() - pd_t4;
+		st.pd_n[0]++;
+	}
+	st.jd_samp = false;
+	const float want_x = st.cur_jit ? st.use_jx : 0.f;
+	const float want_y = st.cur_jit ? st.use_jy : 0.f;
+	return (want_x != st.baked_x || want_y != st.baked_y) ? 1 : 0;
+}
+
+void VKGSRender::r2aa_patch_vertex_env(void* env)
+{
+	if (r2cfg().uv_jitter) static_cast<float*>(env)[23] = 0.f; // vertex_context_t.reserved[2]: RSX_AA_UV_JITTER (none)
+	if (!r2cfg().mode || g_r2.disabled) return;
+	auto& st = g_r2;
+	float* f = static_cast<float*>(env);
+	st.last_S = { f[0], f[3], f[5], f[7], f[10], f[11], f[19], f[20], true };
+	st.baked_x = st.baked_y = 0.f;
+	if (!st.cur_scene && !st.cur_jit) return;
+
+	if (st.cur_scene)
+	{
+		st.frame_S = st.last_S;
+		float sa[8];
+		s_to_arr(st.last_S, sa);
+		pdq_s_amend(&st.s_tal, sa, REGS(m_ctx)->depth_write_enabled());
+	}
+	if (st.cur_jit && st.vw > 0 && st.vh > 0)
+	{
+		const float js = r2cfg().jit_scale;
+		const float dx = 2.f * st.use_jx * js / st.vw, dy = 2.f * st.use_jy * js / st.vh;
+		f[3] += dx;
+		f[7] += dy;
+		st.baked_x = st.use_jx;
+		st.baked_y = st.use_jy;
+		if (r2cfg().trigger_log && r2cfg().jit_diag && (st.use_jx != 0.f || st.use_jy != 0.f))
+		{
+			// Scale check: one render pixel of the bound Vulkan viewport is 2 / m_viewport.width in NDC
+			st.jd_env++;
+			const float vpw = m_viewport.width, vph = std::abs(m_viewport.height);
+			const float ex = vpw > 0 ? 2.f * st.use_jx * js / vpw : 0.f, ey = vph > 0 ? 2.f * st.use_jy * js / vph : 0.f;
+			const float err = std::max(std::abs(st.use_jx) > 1e-4f ? std::abs(dx / ex - 1.f) : 0.f, std::abs(st.use_jy) > 1e-4f ? std::abs(dy / ey - 1.f) : 0.f);
+			if (err > 0.01f) st.jd_env_bad++;
+			if (err > st.jd_worst || !st.jd_s_vw)
+			{
+				st.jd_worst = std::max(st.jd_worst, err);
+				st.jd_s_j = st.use_jx;
+				st.jd_s_dx = dx;
+				st.jd_s_vw = st.vw;
+				st.jd_s_vpw = vpw;
+				st.jd_s_fbw = m_draw_fbo ? static_cast<float>(m_draw_fbo->width()) : 0.f;
+			}
+		}
+		if (r2cfg().uv_jitter && f[0] != 0.f && f[5] != 0.f)
+		{
+			// The same NDC shift for clip-position texture coordinates, in the program's clip units (before scale_offset):
+			// tc.xy += j * tc.w (VKVertexProgram.cpp). Packed as half2 in the one free float of the vertex env.
+			const u32 bits = r2_half(dx / f[0]) | (r2_half(dy / f[5]) << 16);
+			f[23] = std::bit_cast<float>(bits);
+		}
+	}
+}
+
+void VKGSRender::r2aa_check_texture_reads()
+{
+	om_lane_join("r2aa_check_texture_reads", true); // RSX_RECORD_DEFER
+	auto& st = g_r2;
+	r2prof::scope_x r2_tr(r2prof::aa_texr_ns); // R2PORT: RSX_AA_TEXREAD_MEMO cost split
+	// R2PORT RSX_AA_TEXREAD_MEMO (default 1, 0 = off): the jittered-content check below runs for every draw of a jittered
+	// frame. Its only per-draw output is jd_samp / jd_samp_addr (consumed and reset by r2aa_on_draw); its other effects
+	// (ps_seen inserts) are idempotent within a frame. jd_depth only grows within a frame (cleared once, before st.frame++),
+	// so the same frame + the same jd_depth size means the same set: the same sampled addresses give the same answer.
+	// The ps_inner diagnostic (RSX_AA_TRIGGER_LOG) always runs the full check. The sampled addresses are also computed
+	// once per call for every check (an exact refactor of the per-check loops).
+	static const bool memo_on = []
+	{
+		const char* v = std::getenv("RSX_AA_TEXREAD_MEMO");
+		return !(v && v[0] == '0');
+	}();
+	struct jd_memo_t { u32 frame = umax; usz jd_n = 0; u32 scene_rt = 0; bool aa_done = false, post_stable = false, any = false; u32 n = umax; u32 hit = 0; u32 a[16]; };
+	static jd_memo_t s_jd;
+
+	const auto regs = REGS(m_ctx);
+	u32 tn = 0;
+	u32 tunit[16], taddr[16];
+	bool gathered = false;
+	const auto gather = [&]
+	{
+		if (gathered) return;
+		gathered = true;
+		for (u32 mask = m_ctx->program.fp_metadata.referenced_textures_mask & 0xffff, i = 0; mask; mask >>= 1, ++i)
+		{
+			if (!(mask & 1) || !regs->fragment_textures[i].enabled()) continue;
+			const auto& tex = regs->fragment_textures[i];
+			tunit[tn] = i;
+			taddr[tn++] = rsx::get_address(m_ctx, tex.offset(), tex.location());
+		}
+	};
+
+	if (r2cfg().mode && !st.disabled && ((r2cfg().trigger_log && r2cfg().jit_diag) || r2cfg().post_stable || r2cfg().occ_jit) && (st.jx != 0.f || st.jy != 0.f) && !st.jd_depth.empty())
+	{
+		gather();
+		const bool can_memo = memo_on && !r2cfg().trigger_log;
+		r2prof::addx(r2prof::aa_texr_jd);
+		// RSX_AA_DRAW_MEMO: behind the single entry, the last 8 address lists of this frame (same key fields, all compared)
+		struct jd_val { bool any; u32 hit; };
+		static r2aamemo::exact_memo<22, jd_val, 8> s_jdm;
+		const int dm = can_memo ? r2aamemo::mode() : 0;
+		const bool single = can_memo && s_jd.n == tn && s_jd.frame == st.frame && s_jd.jd_n == st.jd_depth.size() && s_jd.aa_done == st.aa_done &&
+			s_jd.scene_rt == st.scene_rt && s_jd.post_stable == r2cfg().post_stable && std::memcmp(s_jd.a, taddr, tn * sizeof(u32)) == 0;
+		u32 jkw[22] = {};
+		const jd_val* mh = nullptr;
+		if (!single && dm)
+		{
+			const u64 jn = st.jd_depth.size();
+			jkw[0] = st.frame;
+			jkw[1] = static_cast<u32>(jn);
+			jkw[2] = static_cast<u32>(jn >> 32);
+			jkw[3] = st.scene_rt;
+			jkw[4] = (st.aa_done ? 1u : 0u) | (r2cfg().post_stable ? 2u : 0u);
+			jkw[5] = tn;
+			std::memcpy(jkw + 6, taddr, tn * sizeof(u32));
+			mh = s_jdm.find(jkw);
+			if (mh) g_dm.jd.hit++;
+			else g_dm.jd.miss++;
+		}
+		const auto put_single = [&](bool any, u32 hit)
+		{
+			s_jd.frame = st.frame;
+			s_jd.jd_n = st.jd_depth.size();
+			s_jd.scene_rt = st.scene_rt;
+			s_jd.aa_done = st.aa_done;
+			s_jd.post_stable = r2cfg().post_stable;
+			s_jd.any = any;
+			s_jd.hit = hit;
+			s_jd.n = tn;
+			std::memcpy(s_jd.a, taddr, tn * sizeof(u32));
+		};
+		if (single || (mh && dm == 1))
+		{
+			r2prof::addx(r2prof::aa_texr_memo);
+			if (!single) put_single(mh->any, mh->hit);
+			if (s_jd.any)
+			{
+				if (!st.jd_samp) st.jd_samp_addr = s_jd.hit;
+				st.jd_samp = true;
+			}
+		}
+		else
+		{
+			bool any = false;
+			u32 hit = 0;
+			for (u32 k = 0; k < tn; ++k)
+			{
+				const u32 addr = taddr[k];
+				if (st.aa_done && addr == st.scene_rt) continue; // the upscaled image
+				if (st.aa_done && r2cfg().trigger_log && r2cfg().post_stable && !st.jd_depth.count(addr) && st.ps_inner.size() < 8)
+				{
+					for (const auto& jent : st.jd_shift)
+					{
+						const u32 ja = jent.first;
+						if (addr <= ja || !st.jd_depth.count(ja)) continue;
+						// the guest memory range of the surface (native pitch x height), not its scaled host extent
+						const auto* jsurf = res()->surface_cache.get_surface_at(ja);
+						if (jsurf && addr <= jsurf->get_memory_range().end)
+						{
+							if (std::find_if(st.ps_inner.begin(), st.ps_inner.end(), [&](const auto& v) { return v.first == addr; }) == st.ps_inner.end())
+								st.ps_inner.emplace_back(addr, ja);
+							break;
+						}
+					}
+				}
+				if (st.jd_depth.count(addr))
+				{
+					if (!any) { any = true; hit = addr; }
+					if (!st.jd_samp) st.jd_samp_addr = addr;
+					st.jd_samp = true;
+					if (!st.aa_done || !r2cfg().post_stable) break;
+					st.ps_seen.insert(addr); // RSX_AA_POST_STABLE
+				}
+			}
+			if (mh && (mh->any != any || mh->hit != hit)) g_dm.jd.bad++;
+			if (can_memo) put_single(any, hit);
+			if (dm && !mh) s_jdm.store(jkw, { any, hit });
+		}
+	}
+	if (r2cfg().mode && !st.disabled && r2cfg().link && r2cfg().strict && st.window && !st.aa_done && st.scene_valid)
+	{
+		// RSX_AA_LINK: scene-size colour targets sampled by the scene material draws follow the scene scale next frame
+		auto& lsc = res()->surface_cache;
+		if (lsc.m_bound_render_targets[0].second && lsc.m_bound_render_targets[0].first == st.scene_rt)
+		{
+			gather();
+			// RSX_AA_LINK_MEMO (default 1): remember rejected addresses until a surface is stored or the window changes
+			static const bool lm_on = r2memo::env_switch("RSX_AA_LINK_MEMO", true);
+			struct lm_t { u32 addr = 0; u32 w = 0, h = 0; u64 gen = ~0ull; };
+			static lm_t s_lm[64];
+			// RSX_AA_DRAW_MEMO: the memo slot (array compare) before the link_cur set lookup; both skip the address
+			const bool lm_first = lm_on && r2aamemo::mode() == 1;
+			for (u32 k = 0; k < tn; ++k)
+			{
+				const u32 addr = taddr[k];
+				lm_t& m = s_lm[(addr >> 12 ^ addr >> 20) & 63];
+				const bool lm_hit = lm_on && m.addr == addr && m.gen == lsc.r2_insert_gen && m.w == st.win_w && m.h == st.win_h;
+				if (lm_first && lm_hit && addr != st.scene_rt && addr != st.scene_ds)
+				{
+					g_dm.link_first++;
+					r2prof::addx(r2prof::aa_link_memo);
+					continue;
+				}
+				if (addr == st.scene_rt || addr == st.scene_ds || st.link_cur.count(addr)) continue;
+				if (lm_hit)
+				{
+					r2prof::addx(r2prof::aa_link_memo);
+					continue;
+				}
+				auto* s = lsc.get_surface_at(addr);
+				if (s && !(r2cfg().link_nofloat && (s->format() == VK_FORMAT_R16G16B16A16_SFLOAT || s->format() == VK_FORMAT_R32G32B32A32_SFLOAT || s->format() == VK_FORMAT_R32_SFLOAT)) &&
+					!s->is_depth_surface() && s->get_surface_width() == st.win_w && s->get_surface_height() == st.win_h)
+					st.link_cur.insert(addr);
+				else if (lm_on) // R3 aim DOF float targets (0x30030000 typeless payloads read back by the SPU) stay at one scale
+					m = { addr, st.win_w, st.win_h, lsc.r2_insert_gen };
+			}
+		}
+	}
+	if (r2cfg().mode && !st.disabled && !st.tex_checked && (r2cfg().classify || st.pl.open))
+	{
+		// First draw of each bind: remember which addresses are sampled (scene vote, pass log)
+		st.tex_checked = true;
+		gather();
+		for (u32 k = 0; k < tn; ++k)
+		{
+			const u32 addr = taddr[k];
+			st.sampled_rt[addr]++;
+			if (st.pl.open && st.pl.tex.size() < 160)
+			{
+				const auto& tex = regs->fragment_textures[tunit[k]];
+				char b[48];
+				std::snprintf(b, sizeof(b), " t%u=%08x(%ux%u)", tunit[k], addr, tex.width(), tex.height());
+				st.pl.tex += b;
+			}
+		}
+	}
+	if (st.late_open && !st.late_sampled && st.late_range.start < st.late_range.end)
+	{
+		gather();
+		for (u32 k = 0; k < tn; ++k)
+		{
+			const u32 addr = taddr[k];
+			if (addr >= st.late_range.start && addr <= st.late_range.end) { st.late_sampled = true; break; }
+		}
+	}
+	if (!r2cfg().mode || st.disabled || !st.scene_draws || st.aa_done || !st.rt_ptr || !scene_passes_done()) return; // reads between the scene passes are the light passes
+	if (st.resolve_wait) return; // the resolve pass reads the scene; upscale its output once it is done
+
+	auto& sc = res()->surface_cache;
+	if (sc.m_bound_render_targets[0].second && sc.m_bound_render_targets[0].first == st.scene_rt) return;
+
+	if (st.defer_bind)
+	{
+		// RSX_AA_BIND_DEFER: first draw into the deferred target. Run and write the upscaled scene back before this
+		// draw's textures load (load_texture_env follows): it may sample the scene (the post pass c19c0000 <- c0880000)
+		st.run_why = "first draw after a bind of another target";
+		st.stat_defer_run++;
+		r2aa_run();
+		r2aa_close_window();
+		return;
+	}
+
+	gather();
+	for (u32 k = 0; k < tn; ++k)
+	{
+		const u32 addr = taddr[k];
+		if (addr >= st.rt_range.start && addr <= st.rt_range.end)
+		{
+			st.run_why = "scene sampled as a texture";
+			r2aa_run();
+			return;
+		}
+	}
+}
+
+void VKGSRender::r2aa_before_bind(u32 color0, u32 zeta)
+{
+	om_lane_join("r2aa_before_bind"); // RSX_RECORD_DEFER
+	g_r2.fast_gen++; // RSX_AA_FAST_EXIT
+	auto& st = g_r2;
+	if (!r2cfg().mode || st.disabled) return;
+	st.tex_checked = false;
+	st.link_bind = false;
+	st.lat_forced_ds = 0;
+	if (r2cfg().passlog)
+	{
+		auto& p = st.pl;
+		if (p.open)
+			r2log("P f%u #%u rt=%08x ds=%08x %ux%u%s draws=%u dtest=%u dwrite=%u jitter=%u query=%u nocolour=%u%s%s", st.frame, p.idx, p.rt, p.ds, p.w, p.h,
+				p.scaled ? " reduced" : "", p.draws, p.dt, p.dw, p.jit, p.query, p.nocolor, p.draws ? "" : " (no draws: clear/resolve)", p.tex.c_str());
+		p = {};
+		p.open = (st.frame % static_cast<u32>(r2cfg().passlog)) == 0;
+		p.idx = st.pl_idx++;
+		p.rt = color0;
+		p.ds = zeta;
+		p.w = m_ctx->fb.layout.width;
+		p.h = m_ctx->fb.layout.height;
+	}
+	const bool scene_bind = color0 == st.scene_rt && zeta == st.scene_ds;
+	// RSX_AA_BIND_DEFER: the run may wait for the bound target's first draw only if that target stays full scale and
+	// shares no scene memory (the state it would have after the run): linked / depth-latched / scene-memory binds run now
+	const auto defer_ok = [&]() -> bool
+	{
+		if (!color0 || zeta == st.scene_ds || st.link_prev.count(color0) || (zeta && st.link_prev.count(zeta))) return false;
+		const auto lat = zeta ? st.ds_lat.find(zeta) : st.ds_lat.end();
+		if (lat != st.ds_lat.end() && lat->second.live && lat->second.reduced) return false;
+		const auto& fl = m_ctx->fb.layout;
+		const auto hits = [&](u32 a, u32 pitch)
+		{
+			if (!a) return false;
+			const u64 end = u64(a) + u64(std::max<u32>(pitch, 64)) * std::max<u16>(fl.height, 1) - 1;
+			return u64(a) <= st.rt_range.end && end >= st.rt_range.start;
+		};
+		for (const u8 i : rsx::utility::get_rtt_indexes(fl.target))
+			if (hits(fl.color_addresses[i], fl.actual_color_pitch[i])) return false;
+		return !hits(fl.zeta_address, fl.actual_zeta_pitch) && !hits(color0, fl.actual_color_pitch[0]);
+	};
+	if (st.boundary_pending && scene_bind && !st.window)
+	{
+		om_defer_late_flush(m_current_command_buffer); // RSX_AA_OBJMV_DEFER_HIST
+		frame_boundary();
+	}
+	if (st.scene_valid && st.scene_draws && !st.aa_done && st.rt_ptr && scene_passes_done() && !scene_bind)
+	{
+		auto& sc = res()->surface_cache;
+		if (st.resolve_wait)
+		{
+			// The resolve pass (and whatever it drew into the scene address) is done once another target is bound
+			if (color0 && color0 != st.scene_rt) { st.run_why = "bind after the resolve pass"; r2aa_run(); }
+		}
+		else if (sc.m_bound_render_targets[0].first == st.scene_rt && sc.m_bound_depth_stencil.first == st.scene_ds)
+		{
+			if (st.window && (color0 == st.scene_rt || !color0))
+			{
+				// R2 resolves the (2x horizontal) scene into a plain target at the same address. Keep that pass inside
+				// the reduced-scale window and upscale its result: the full-scale scene layout is never rebuilt.
+				// A depth-only bind (depth clear) may come first.
+				st.resolve_wait = true;
+			}
+			else if (r2cfg().split && r2cfg().bind_defer && r2cfg().strict && st.window && defer_ok())
+			{
+				st.defer_bind = true;
+				st.defer_rt = color0;
+				st.defer_ds = zeta;
+				st.stat_defer++;
+			}
+			else
+			{
+				st.run_why = "bind of another target";
+				r2aa_run();
+			}
+		}
+		else if (st.defer_bind)
+		{
+			// Another target again before the deferred one drew: the same checks for it, else run now (old behaviour)
+			if (defer_ok()) { st.defer_rt = color0; st.defer_ds = zeta; }
+			else
+			{
+				st.run_why = "bind of another target";
+				st.stat_defer_abort++;
+				r2aa_run();
+			}
+		}
+	}
+	if (st.defer_bind && scene_bind && !st.aa_done)
+	{
+		// The scene pass continues after a bind without draws: no run, no new logical frame
+		st.defer_bind = false;
+		st.stat_defer_cancel++;
+		if (st.diag_defer < 8 && r2cfg().trigger_log)
+		{
+			st.diag_defer++;
+			r2log("bind deferral f%u: %08x/%08x bound after the scene passes without drawing, then the scene pair again before draw %u: "
+				"the scene pass continues, no upscaler run yet (RSX_AA_BIND_DEFER=0: old immediate run)", st.frame, st.defer_rt, st.defer_ds, st.draw_index);
+		}
+	}
+
+	const auto& layout = m_ctx->fb.layout;
+	if (st.window && st.aa_done)
+	{
+		// Scene window over: everything after it (transparents, post, HUD) renders at full resolution
+		st.window = false;
+		r2aa_set_section(false);
+		st.wb_armed = st.wb_pending;
+		st.wb_pending = false;
+		r2aa_writeback(); // before the next targets are bound: they may alias the scene memory (R2's quarter-size post buffers)
+	}
+	else if (!st.window && !st.aa_done && !st.scene_draws && st.scene_valid && scene_bind && r2cfg().upscale < 1.f)
+	{
+		st.window = true;
+		st.stat_win_open++;
+		st.full_cfg = RSX(m_ctx)->resolution_scaling_config;
+		st.win_w = layout.width;
+		st.win_h = layout.height;
+	}
+	if (st.window)
+	{
+		bool on = layout.width == st.win_w && layout.height == st.win_h;
+		if (on && r2cfg().strict)
+		{
+			on = (color0 && color0 == st.scene_rt) || (zeta && zeta == st.scene_ds);
+			if (!on && r2cfg().link && !st.aa_done)
+			{
+				const bool lc = color0 && st.link_prev.count(color0);
+				// RSX_AA_LINK_DEPTH_ONLY: a linked depth alone only reduces depth-only binds; an unlinked colour target bound
+				// with it stays full scale (R3 ADS: the previous frame's final image c19c0000 gets the scope/DOF overlay
+				// drawn with the linked depth c1380000 inside the scene window; reduced, the shown frame was halved and smeared)
+				on = lc || (zeta && (!color0 || !r2cfg().link_zonly) && st.link_prev.count(zeta));
+				st.link_bind = on;
+				if (lc && zeta) st.link_cur.insert(zeta); // its depth (light volume stencil) follows the same scale
+			}
+		}
+		st.lat_forced_ds = 0;
+		if (r2cfg().ds_latch && zeta)
+		{
+			// RSX_AA_DS_LATCH: a depth buffer holding depth drawn at one scale keeps that scale until it is cleared, so
+			// a later depth-EQUAL / LESS pass never tests against a resampled copy (the window opened, closed or a
+			// flip came between the pre-pass and the material pass)
+			auto it = st.ds_lat.find(zeta);
+			if (it != st.ds_lat.end() && it->second.live)
+			{
+				auto& L = it->second;
+				if (pdq_latch_expires(st.frame, L.frame, L.wframe, L.written, st.part_start, r2cfg().latch_keep)) L.live = false;
+				else if (st.frame - L.frame >= 2) st.stat_latch_keep++;
+			}
+			if (it != st.ds_lat.end() && it->second.live && it->second.reduced != on &&
+				(!it->second.reduced || !color0 || color0 == st.scene_rt || st.link_prev.count(color0)))
+			{
+				// (never reduces an unlinked colour target: RSX_AA_LINK_DEPTH_ONLY, the R3 ADS overlay on c19c0000)
+				on = it->second.reduced;
+				st.lat_forced_ds = zeta;
+				st.stat_lat_scale++;
+				if (st.diag_lat < 8)
+				{
+					st.diag_lat++;
+					r2log("depth latch f%u: rt %08x ds %08x bound at %s scale like the depth already drawn into it (window wanted %s; RSX_AA_DS_LATCH=0: old rule)",
+						st.frame, color0, zeta, on ? "the reduced" : "full", on ? "full" : "the reduced");
+				}
+			}
+		}
+		if (on && st.defer_bind && !st.aa_done)
+		{
+			// RSX_AA_BIND_DEFER: a deferring bind would be reduced (not expected after defer_ok): run now, as without it
+			st.run_why = "bind of another target";
+			st.stat_defer_abort++;
+			r2aa_run();
+			r2aa_close_window();
+			on = false;
+		}
+		r2aa_set_section(on);
+	}
+	float bias = 0.f;
+	if (st.window && st.section && color0 && color0 == st.scene_rt)
+	{
+		bias = r2cfg().mipbias;
+		if (r2cfg().mipbias_mode && r2cfg().upscale < 1.f && st.vh > 0.f && st.oh > 0.f)
+		{
+			const float shown = (r2cfg().mipbias_mode == 2 && m_swapchain_dims.height) ? std::fmin(st.oh, static_cast<float>(m_swapchain_dims.height)) : st.oh;
+			const float nv = r2cfg().mipbias_mode == 3 ? -1.f : 0.f; // PORT_UPSCALE_LOD_BIAS=nv
+			bias = std::fmin(std::fmax(std::log2(st.vh / shown) + nv, -4.f), 0.f);
+			bias = std::round(bias * 4.f) * 0.25f; // few sampler permutations
+		}
+		st.fol_bias = bias;
+	}
+	st.pl.scaled = st.section;
+	if (bias != st.bias_now)
+	{
+		st.bias_now = bias;
+		m_ctx->textures.fragment_textures_dirty = ~0u; // samplers are rebuilt with the new bias (r2aa_lod_bias)
+		if (bias != 0.f && st.bias_logged < 8)
+		{
+			st.bias_logged++;
+			r2log("mip bias %.2f (%s: render %.0f, output %.0f, window %u lines; RSX_AA_MIPBIAS=display|0|<n>)", bias,
+				r2cfg().mipbias_mode == 1 ? "output" : r2cfg().mipbias_mode == 2 ? "display" : r2cfg().mipbias_mode == 3 ? "output-1" : "fixed", st.vh, st.oh, m_swapchain_dims.height);
+		}
+	}
+}
+
+namespace vk
+{
+	// RSX_RECORD_DEFER / RSX_PIPE_SPLIT: wait for the r2aa lane job (no-op when idle). VKGSRender::end_draw and the
+	// emit_geometry early exits, which skip pre_draw's join
+	void r2aa_lane_sync()
+	{
+		om_lane_join("r2aa_lane_sync", true);
+	}
+
+	// Alpha-tested foliage/fences: a negative LOD bias sharpens the alpha mask, so its cut-out edge aliases at the
+	// internal resolution and DLSS cannot resolve it (shimmer). Those draws keep at least atest_floor.
+	float r2aa_lod_bias()
+	{
+		const auto& st = g_r2;
+		return (st.atest_now && r2cfg().atest) ? std::fmax(st.bias_now, r2cfg().atest_floor) : st.bias_now;
+	}
+
+	// R2PORT: RSX_DLSS_LOD_BIAS_SCOPE (dark-patch investigation). Unset: exactly r2aa_lod_bias().
+	float r2aa_lod_bias_for(bool tex_2d, bool color_class, bool depth_compare)
+	{
+		const bool plain = tex_2d && color_class && !depth_compare;
+		if (!plain && r2cfg().dp_log) [[unlikely]]
+		{
+			static bool logged[8] = {};
+			const int k = (tex_2d ? 1 : 0) | (color_class ? 2 : 0) | (depth_compare ? 4 : 0);
+			const float b = r2aa_lod_bias();
+			if (b != 0.f && !logged[k])
+			{
+				logged[k] = true;
+				r2log("darkpatch: mip bias %.2f %s on a %s%s%s mipmapped texture", b, r2cfg().dp_bias_2d ? "suppressed" : "applied",
+					tex_2d ? "2D" : "cube/3D/1D", color_class ? "" : " non-colour", depth_compare ? " depth-compare" : "");
+			}
+		}
+		if (r2cfg().dp_bias_2d && !plain) return 0.f;
+		return r2aa_lod_bias();
+	}
+
+	bool r2aa_alpha_tested(bool atest)
+	{
+		auto& st = g_r2;
+		const bool changed = atest != st.atest_now;
+		st.atest_now = atest;
+		if (!changed || !r2cfg().atest || st.bias_now >= r2cfg().atest_floor) return false;
+		static bool logged = false;
+		if (!logged)
+		{
+			logged = true;
+			r2log("mip bias %.2f for alpha-tested/KIL draws (scene %.2f; RSX_AA_MIPBIAS_ATEST=on|off|<bias>)", r2cfg().atest_floor, st.bias_now);
+		}
+		return true;
+	}
+
+	bool r2aa_active()
+	{
+		return r2cfg().mode && !g_r2.disabled;
+	}
+	bool r2aa_light_tex_pending()
+	{
+		return g_r2.lj_mask || g_r2.lj_applied;
+	}
+	void r2aa_light_tex_patch(void* buf)
+	{
+		// RSX_AA_LIGHT_JITTER: buf = the 16 sampler_info slots just written (48 bytes each: scale[3], bias[3], ...)
+		auto& st = g_r2;
+		const u16 m = st.lj_mask;
+		st.lj_mask = 0;
+		st.lj_applied = m;
+		for (u32 i = 0; i < 16; ++i)
+		{
+			if (!(m & (1u << i))) continue;
+			float* f = static_cast<float*>(buf) + i * 12;
+			f[3] += st.lj_bu;
+			f[4] += st.lj_bv;
+		}
+	}
+	bool r2aa_atest_scene()
+	{
+		// RSX_AA_ATEST_MIPSCALE applies to jittered draws into the scene depth (r2aa_on_draw): the geometry pre-pass and
+		// the material pass take the same decision, so cut-out depth and colour edges stay aligned; shadow maps and
+		// other offscreen passes (another depth target) keep the plain test
+		return r2cfg().atest_mips > 0.f && !g_r2.disabled && g_r2.cur_scene && g_r2.cur_jit;
+	}
+	int r2aa_scene_draw()
+	{
+		if (g_r2.disabled) return 0;
+		if (g_r2.cur_scene && g_r2.cur_jit) return 2;
+		return (g_r2.cur_scene || g_r2.cur_eq_scene) ? 1 : 0;
+	}
+	void r2aa_atest_draw(bool atest, bool a2c)
+	{
+		auto& st = g_r2;
+		if (st.fol_logged) return;
+		st.fol_atest += atest ? 1u : 0u;
+		st.fol_a2c += (a2c && r2cfg().atest_a2c && r2cfg().a2c == PDQ_A2C_STABLE) ? 1u : 0u;
+	}
+
+	void r2aa_camera(float& n, float& f, float& fov)
+	{
+		const float cn = g_r2.cam_n, cf = g_r2.cam_f, cv = g_r2.cam_fov;
+		if (cn > 0.f && cf > cn && cv > 0.f) { n = cn; f = cf; fov = cv; }
+		else
+		{
+			n = 0.1f; f = 1000.f; fov = 1.0f;
+			static bool logged = false;
+			if (!logged)
+			{
+				logged = true;
+				r2log("FSR camera: no view-projection found yet, placeholder near 0.1 / far 1000 / FOV 57 deg until one is");
+			}
+		}
+	}
+
+	// RSX_AA_BLACK_DIAG (default 0 = off, 1 = on): R3 ADS firing showed single frames whose whole 3D scene was black (HUD
+	// intact). 16 texels on a 4x4 grid of the upscaler input (game scene), its output and the presented image are copied
+	// to a host buffer and read 8 uses later; a black (>= 14 of 16 texels) or non-finite frame is logged with the wall
+	// clock, so the stage that went black can be told apart: input = game side, output only = upscaler, present only =
+	// after the upscaler (writeback, post passes, composite).
+	bool r2_black_probe_enabled()
+	{
+		static const bool on = [] { const char* e = std::getenv("RSX_AA_BLACK_DIAG"); return e && std::atoi(e) != 0; }();
+		return on;
+	}
+
+	void r2_black_probe(const vk::command_buffer& cmd, vk::image* img, u32 w, u32 h, int which, u32 meta)
+	{
+		if (!r2_black_probe_enabled() || !img || !img->value || w < 4 || h < 4 || which < 0 || which > 3 || img->aspect() != VK_IMAGE_ASPECT_COLOR_BIT) return;
+		constexpr u32 slots = 16, lag = 8, slot_sz = 16 + 16 * 8;
+		struct ring_t { std::unique_ptr<vk::buffer> buf; u32 n = 0; VkFormat fmt[slots] = {}; u32 meta[slots] = {}, rf[slots] = {}; };
+		static ring_t rings[4];
+		// per-frame lines: the first 16 (boot) and then up to 6 per 5 s window, so gameplay blacks are not lost
+		static u32 cnt_black[4] = {}, cnt_nf[4] = {}, cnt_n[4] = {}, logged = 0, logged_win = 0;
+		static auto t_sum = std::chrono::steady_clock::now();
+		static const char* const names[4] = { "upscaler input (game scene)", "upscaler output", "presented image",
+			"composite source (first scene-sized texture read into the display buffer)" };
+		auto& r = rings[which];
+		auto* pdev = vk::get_current_renderer();
+		if (!r.buf)
+			r.buf = std::make_unique<vk::buffer>(*pdev, slots * slot_sz, pdev->get_memory_mapping().host_visible_coherent,
+				VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT | VK_MEMORY_PROPERTY_HOST_COHERENT_BIT, VK_BUFFER_USAGE_TRANSFER_DST_BIT, 0, VMM_ALLOCATION_POOL_UNDEFINED);
+		// the use 'lag' calls ago has long completed (a slot is stamped after its copies: a mismatch is skipped)
+		if (r.n >= lag)
+		{
+			const u32 id = r.n - lag, s = id % slots;
+			if (const u8* d = static_cast<const u8*>(r.buf->map(s * slot_sz, slot_sz)))
+			{
+				u32 stamp;
+				std::memcpy(&stamp, d, 4);
+				u32 black = 0, nf = 0, valid = 0;
+				if (stamp == id + 1)
+				{
+					const VkFormat f = r.fmt[s];
+					for (u32 t = 0; t < 16; ++t)
+					{
+						const u8* p = d + 16 + t * 8;
+						if (f == VK_FORMAT_R16G16B16A16_SFLOAT)
+						{
+							u16 c[3];
+							std::memcpy(c, p, 6);
+							bool dark = true;
+							for (u16 v : c)
+							{
+								if ((v & 0x7C00) == 0x7C00) { nf++; dark = false; break; }
+								dark &= (v & 0x7FFF) < 0x1800; // |v| < 2^-9
+							}
+							black += dark;
+						}
+						else if (f == VK_FORMAT_R8G8B8A8_UNORM || f == VK_FORMAT_B8G8R8A8_UNORM || f == VK_FORMAT_R8G8B8A8_SRGB || f == VK_FORMAT_B8G8R8A8_SRGB)
+							black += p[0] <= 1 && p[1] <= 1 && p[2] <= 1;
+						else if (f == VK_FORMAT_A2B10G10R10_UNORM_PACK32 || f == VK_FORMAT_A2R10G10B10_UNORM_PACK32)
+						{
+							u32 v;
+							std::memcpy(&v, p, 4);
+							black += (v & 0x3FF) <= 4 && ((v >> 10) & 0x3FF) <= 4 && ((v >> 20) & 0x3FF) <= 4;
+						}
+						else { valid = 0; break; }
+						valid = 1;
+					}
+				}
+				r.buf->unmap();
+				if (valid)
+				{
+					cnt_n[which]++;
+					const bool is_black = black >= 14;
+					cnt_black[which] += is_black;
+					cnt_nf[which] += nf ? 1 : 0;
+					if ((is_black || nf) && (logged < 16 || logged_win < 6))
+					{
+						logged++;
+						logged_win++;
+						const auto now = std::chrono::system_clock::now();
+						const std::time_t tt = std::chrono::system_clock::to_time_t(now);
+						std::tm tm{};
+#ifdef _WIN32
+						localtime_s(&tm, &tt);
+#else
+						localtime_r(&tt, &tm);
+#endif
+						const int ms = static_cast<int>(std::chrono::duration_cast<std::chrono::milliseconds>(now.time_since_epoch()).count() % 1000);
+						const u32 f = r.rf[s];
+						const auto& st = g_r2;
+						r2log("black-diag %02d:%02d:%02d.%03d (read ~%u frames late): %s of r2aa f%u is %s (%u/16 dark texels, %u non-finite, format %d); "
+							"meta 0x%x (input/output: reset_why; present: upscaler runs; composite source: guest address), late scene draws f%u..f%u: %u %u %u, run trigger now '%s'",
+							tm.tm_hour, tm.tm_min, tm.tm_sec, ms, lag, names[which], f, is_black ? "BLACK" : "not black", black, nf, static_cast<int>(r.fmt[s]),
+							r.meta[s], f - 1, f + 1, st.late_hist[(f - 1) % 64], st.late_hist[f % 64], st.late_hist[(f + 1) % 64], st.run_why ? st.run_why : "?");
+					}
+				}
+			}
+		}
+		const auto tn = std::chrono::steady_clock::now();
+		if (tn - t_sum >= std::chrono::seconds(5))
+		{
+			t_sum = tn;
+			if (cnt_black[0] + cnt_black[1] + cnt_black[2] + cnt_black[3] + cnt_nf[0] + cnt_nf[1] + cnt_nf[2] + cnt_nf[3])
+				r2log("black-diag 5 s (RSX_AA_BLACK_DIAG=0: off): black frames input %u/%u output %u/%u present %u/%u composite source %u/%u; with non-finite texels %u %u %u %u",
+					cnt_black[0], cnt_n[0], cnt_black[1], cnt_n[1], cnt_black[2], cnt_n[2], cnt_black[3], cnt_n[3], cnt_nf[0], cnt_nf[1], cnt_nf[2], cnt_nf[3]);
+			logged_win = 0;
+			for (int i = 0; i < 4; ++i) cnt_black[i] = cnt_nf[i] = cnt_n[i] = 0;
+		}
+		const VkFormat fmt = img->format();
+		const u32 tw = vk::get_format_texel_width(fmt);
+		if (tw != 4 && tw != 8) return;
+		const u32 id = r.n++, s = id % slots;
+		r.fmt[s] = fmt;
+		r.meta[s] = meta;
+		r.rf[s] = g_r2.frame;
+		VkBufferImageCopy reg[16] = {};
+		static const float fr[4] = { 0.15f, 0.38f, 0.62f, 0.85f };
+		for (u32 t = 0; t < 16; ++t)
+		{
+			reg[t].bufferOffset = s * slot_sz + 16 + t * 8;
+			reg[t].imageSubresource = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1 };
+			reg[t].imageOffset = { static_cast<s32>(w * fr[t % 4]), static_cast<s32>(h * fr[t / 4]), 0 };
+			reg[t].imageExtent = { 1, 1, 1 };
+		}
+		img->push_layout(cmd, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL);
+		vkCmdCopyImageToBuffer(cmd, img->value, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, r.buf->value, 16, reg);
+		img->pop_layout(cmd);
+		VkMemoryBarrier tb{ VK_STRUCTURE_TYPE_MEMORY_BARRIER, nullptr, VK_ACCESS_TRANSFER_WRITE_BIT, VK_ACCESS_TRANSFER_WRITE_BIT };
+		vkCmdPipelineBarrier(cmd, VK_PIPELINE_STAGE_TRANSFER_BIT, VK_PIPELINE_STAGE_TRANSFER_BIT, 0, 1, &tb, 0, nullptr, 0, nullptr);
+		vkCmdFillBuffer(cmd, r.buf->value, s * slot_sz, 4, id + 1);
+		VkMemoryBarrier hb{ VK_STRUCTURE_TYPE_MEMORY_BARRIER, nullptr, VK_ACCESS_TRANSFER_WRITE_BIT, VK_ACCESS_HOST_READ_BIT };
+		vkCmdPipelineBarrier(cmd, VK_PIPELINE_STAGE_TRANSFER_BIT, VK_PIPELINE_STAGE_HOST_BIT, 0, 1, &hb, 0, nullptr, 0, nullptr);
+	}
+
+	// RSX_PRESENT_DOWNSCALE (default 1; 0 = RPCS3's single bilinear blit): res=3 into a 900p window shrinks the
+	// 3840x2112 image 2.4:1. One bilinear blit reads 2x2 of every ~2.4x2.4 source pixels: thin lines (wire fences,
+	// branches, cables) fall between the taps or not as they move by a fraction of a pixel and crawl ("boiling").
+	// Exact 2:1 linear blits (a 2x2 box each) first, until less than 2:1 remains for the final bilinear blit.
+	vk::viewable_image* r2_present_downscale(const vk::command_buffer& cmd, vk::viewable_image* src, u32& w, u32& h, u32 dw, u32 dh)
+	{
+		static const bool on = [] { const char* e = std::getenv("RSX_PRESENT_DOWNSCALE"); return !e || std::atoi(e) != 0; }();
+		static std::vector<std::unique_ptr<vk::viewable_image>> chain;
+		static u32 logged = 0;
+		r2_black_probe(cmd, src, w, h, 2, g_r2.stat_runs);
+		// RSX_DLSS_DEBUG_VIEW=5: the raw upscaler output (written within the last 200 ms) instead of the game's image
+		if (r2cfg().raw_view && g_r2.final_img && g_r2.runs && std::chrono::steady_clock::now() - g_r2.last_run < std::chrono::milliseconds(200))
+		{
+			static bool raw_logged = false;
+			if (!raw_logged)
+			{
+				raw_logged = true;
+				r2log("RSX_DLSS_DEBUG_VIEW=5: presenting the raw upscaled scene %ux%u (no post passes, post-run draws or HUD)", g_r2.final_img->width(), g_r2.final_img->height());
+			}
+			src = g_r2.final_img.get();
+			// RSX_AA_DYNRES may size the images for a peak: only the last run's output area is current
+			w = g_r2.raw_w ? std::min(g_r2.raw_w, src->width()) : src->width();
+			h = g_r2.raw_h ? std::min(g_r2.raw_h, src->height()) : src->height();
+			if (w != src->width() || h != src->height())
+			{
+				// crop, so paths that sample the whole image (calibration / HDR present) see no stale strips
+				static std::unique_ptr<vk::viewable_image> crop;
+				auto* pdev = vk::get_current_renderer();
+				if (crop && (crop->width() != w || crop->height() != h || crop->format() != src->format()))
+					vk::get_resource_manager()->dispose(crop);
+				if (!crop)
+				{
+					crop = std::make_unique<vk::viewable_image>(*pdev, pdev->get_memory_mapping().device_local, VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT,
+						VK_IMAGE_TYPE_2D, src->format(), w, h, 1, 1, 1, VK_SAMPLE_COUNT_1_BIT, VK_IMAGE_LAYOUT_UNDEFINED, VK_IMAGE_TILING_OPTIMAL,
+						VK_IMAGE_USAGE_TRANSFER_SRC_BIT | VK_IMAGE_USAGE_TRANSFER_DST_BIT | VK_IMAGE_USAGE_SAMPLED_BIT,
+						vk::VK_IMAGE_CREATE_ALLOW_NULL_RPCS3, VMM_ALLOCATION_POOL_SWAPCHAIN, RSX_FORMAT_CLASS_COLOR);
+					if (!crop->value) crop.reset();
+				}
+				if (crop)
+				{
+					VkImageCopy region{};
+					region.srcSubresource = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1 };
+					region.dstSubresource = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1 };
+					region.extent = { w, h, 1 };
+					src->push_layout(cmd, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL);
+					crop->change_layout(cmd, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL);
+					vkCmdCopyImage(cmd, src->value, src->current_layout, crop->value, crop->current_layout, 1, &region);
+					src->pop_layout(cmd);
+					src = crop.get();
+				}
+			}
+		}
+		if (!on || !src || !dw || !dh || w / 2 < dw || h / 2 < dh) return src;
+		auto* pdev = vk::get_current_renderer();
+		const VkFormat fmt = src->format();
+		const VkFormatFeatureFlags need = VK_FORMAT_FEATURE_BLIT_SRC_BIT | VK_FORMAT_FEATURE_BLIT_DST_BIT | VK_FORMAT_FEATURE_SAMPLED_IMAGE_FILTER_LINEAR_BIT;
+		if ((pdev->get_format_properties(fmt).optimalTilingFeatures & need) != need || src->aspect() != VK_IMAGE_ASPECT_COLOR_BIT) return src;
+		const u32 w0 = w, h0 = h;
+		vk::viewable_image* cur = src;
+		u32 n = 0;
+		while (w / 2 >= dw && h / 2 >= dh && n < 4)
+		{
+			const u32 nw = w / 2, nh = h / 2;
+			if (chain.size() <= n) chain.emplace_back();
+			auto& img = chain[n];
+			if (img && (img->width() != nw || img->height() != nh || img->format() != fmt))
+				vk::get_resource_manager()->dispose(img);
+			if (!img)
+			{
+				img = std::make_unique<vk::viewable_image>(*pdev, pdev->get_memory_mapping().device_local, VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT,
+					VK_IMAGE_TYPE_2D, fmt, nw, nh, 1, 1, 1, VK_SAMPLE_COUNT_1_BIT, VK_IMAGE_LAYOUT_UNDEFINED, VK_IMAGE_TILING_OPTIMAL,
+					VK_IMAGE_USAGE_TRANSFER_SRC_BIT | VK_IMAGE_USAGE_TRANSFER_DST_BIT | VK_IMAGE_USAGE_SAMPLED_BIT,
+					vk::VK_IMAGE_CREATE_ALLOW_NULL_RPCS3, VMM_ALLOCATION_POOL_SWAPCHAIN, RSX_FORMAT_CLASS_COLOR);
+				if (!img->value)
+				{
+					img.reset();
+					break;
+				}
+			}
+			VkImageBlit b{};
+			b.srcSubresource = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1 };
+			b.dstSubresource = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1 };
+			b.srcOffsets[1] = { s32(nw * 2), s32(nh * 2), 1 };
+			b.dstOffsets[1] = { s32(nw), s32(nh), 1 };
+			cur->push_layout(cmd, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL);
+			img->change_layout(cmd, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL);
+			vkCmdBlitImage(cmd, cur->value, cur->current_layout, img->value, img->current_layout, 1, &b, VK_FILTER_LINEAR);
+			cur->pop_layout(cmd);
+			cur = img.get();
+			w = nw;
+			h = nh;
+			n++;
+		}
+		if (n && logged < 4)
+		{
+			logged++;
+			r2log("present downscale: %ux%u -> %ux%u (%u x 2:1 box) -> %ux%u bilinear (RSX_PRESENT_DOWNSCALE=0: one bilinear blit)",
+				w0, h0, w, h, n, dw, dh);
+		}
+		return cur;
+	}
+}
+
+void VKGSRender::r2aa_set_section(bool on)
+{
+	om_lane_join("r2aa_set_section"); // RSX_RECORD_DEFER
+	g_r2.fast_gen++; // RSX_AA_FAST_EXIT
+	auto& st = g_r2;
+	if (on == st.section) return;
+	auto& cfg = RSX(m_ctx)->resolution_scaling_config;
+	if (on)
+	{
+		const float pct = std::round(static_cast<float>(cfg.scale_percent) * r2cfg().upscale);
+		cfg.scale_percent = static_cast<u16>(std::max(10.f, pct));
+		st.red_cfg = cfg;
+		st.section = true;
+	}
+	else
+	{
+		cfg = st.full_cfg;
+		st.section = false;
+	}
+	// Viewport/scissor/WPOS and point size depend on the active scale
+	m_ctx->draw_state.dirty.set(rsx::draw_state_t::group::viewport);
+	m_ctx->draw_state.dirty.set(rsx::draw_state_t::group::scissor);
+	m_ctx->draw_state.dirty.set(rsx::draw_state_t::group::vertex_env);
+	m_ctx->draw_state.dirty.set(rsx::draw_state_t::group::fragment_env);
+}
+
+void VKGSRender::r2aa_close_window()
+{
+	om_lane_join("r2aa_close_window"); // RSX_RECORD_DEFER
+	g_r2.fast_gen++; // RSX_AA_FAST_EXIT
+	// The scene window ends at a run that its bind did not do (RSX_AA_BIND_DEFER): back to full scale and write the
+	// upscaled scene into the scene surface now, before the current draw loads its textures
+	auto& st = g_r2;
+	if (!st.window || !st.aa_done) return;
+	st.window = false;
+	r2aa_set_section(false);
+	st.wb_armed = st.wb_pending;
+	st.wb_pending = false;
+	r2aa_writeback();
+}
+
+void VKGSRender::r2aa_writeback()
+{
+	om_lane_join("r2aa_writeback"); // RSX_RECORD_DEFER
+	g_r2.fast_gen++; // RSX_AA_FAST_EXIT
+	auto& st = g_r2;
+	if (!st.wb_armed) return;
+	st.wb_armed = false;
+	run_timer timer(false);
+
+	auto& sc = res()->surface_cache;
+	auto& cmd = *m_current_command_buffer;
+	auto miss = [&](const std::string& why)
+	{
+		// Show the plain (scaled) frame
+		st.stat_wb_miss++;
+		st.jitter_cooldown = 10;
+		skip_once("upscaled scene could not be written back (" + why + ")");
+	};
+	if (!st.final_img) return miss("no result");
+
+	// Replace the reduced-scale scene surface with a full-resolution one holding the upscaled result. This runs before
+	// the next targets are bound, so whatever follows (post passes sampling the scene, or quarter-size buffers that
+	// alias its memory and inherit from it) sees the upscaled scene.
+	auto* old = sc.get_surface_at(st.scene_rt);
+	if (!old || old->is_depth_surface() || old->samples() > 1 || old->info.format != st.res_fmt)
+		return miss("scene surface gone");
+	if (r2cfg().strict && old != st.wb_src)
+		return miss("the scene address was rebound before the writeback");
+	if (vk::is_renderpass_open(cmd)) vk::end_renderpass(cmd);
+	auto* rt = old;
+	if (old->info.extent.width < st.out_w || old->info.extent.height < st.out_h)
+	{
+		rt = sc.r2_rescale_color_surface(cmd, old, st.full_cfg);
+		if (!rt) return miss("full-resolution surface could not be created");
+	}
+	// The surface now at the scene address may be another layout of the same memory: write the overlap.
+	const u32 cw = std::min(st.out_w, rt->info.extent.width);
+	const u32 ch = std::min(st.out_h, rt->info.extent.height);
+	if (cw * 4 < st.out_w * 3 || ch * 4 < st.out_h * 3)
+		return miss("full-resolution surface too small: " + std::to_string(rt->info.extent.width) + "x" + std::to_string(rt->info.extent.height) +
+			" for " + std::to_string(st.out_w) + "x" + std::to_string(st.out_h));
+	if ((cw < st.out_w || ch < st.out_h) && r2cfg().strict)
+		return miss("the surface at the scene address has another layout");
+	if ((cw < st.out_w || ch < st.out_h) && !st.stat_wb_clipped++)
+		r2log("upscaled scene %ux%u written to a %ux%u surface (overlap)", st.out_w, st.out_h, rt->info.extent.width, rt->info.extent.height);
+	if (!st.stat_wb_direct++) r2log("upscaled scene written to a %ux%u surface", rt->info.extent.width, rt->info.extent.height);
+	if (r2cfg().trace && (st.frame % static_cast<u32>(r2cfg().trace)) == 0 && st.frame)
+		r2log("T f%u WB old %ux%u (native %ux%u, %u%%) -> rt %ux%u (native %ux%u, %u%%) out %ux%u", st.frame,
+			old->info.extent.width, old->info.extent.height, old->get_surface_width(), old->get_surface_height(), old->resolution_scaling_config.scale_percent,
+			rt->info.extent.width, rt->info.extent.height, rt->get_surface_width(), rt->get_surface_height(), rt->resolution_scaling_config.scale_percent,
+			st.out_w, st.out_h);
+
+	// RSX_WB_SKIP_INHERIT (default 1, 0 = old): when the copy covers the whole surface, the inherited (scaled)
+	// contents and a background clear/memory load are overwritten at once; skip them (R2 capture 2684 EID 2715,
+	// R3 capture 5208 EID 644: a reduced -> full scale blit every frame, fully overwritten by the copy below)
+	static const bool skip_inherit = [] { const char* e = std::getenv("RSX_WB_SKIP_INHERIT"); return !e || *e != '0'; }();
+	if (skip_inherit && cw == rt->info.extent.width && ch == rt->info.extent.height && rt->samples() == 1)
+	{
+		rt->clear_rw_barrier();
+		rt->state_flags &= ~(rsx::surface_state_flags::force_data_load | rsx::surface_state_flags::erase_bkgnd);
+		rt->memory_barrier(cmd, rsx::surface_access::gpu_reference); // unspill only
+	}
+	else
+		rt->memory_barrier(cmd, rsx::surface_access::transfer_write); // pulls in the inherited (scaled) contents first
+	rt->push_layout(cmd, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL);
+	VkImageCopy region{};
+	region.srcSubresource = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1 };
+	region.dstSubresource = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1 };
+	region.extent = { cw, ch, 1 };
+	vkCmdCopyImage(cmd, st.final_img->value, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, rt->value, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, 1, &region);
+	rt->pop_layout(cmd);
+	rt->on_write_copy(rsx::get_shared_tag());
+
+	cmd.r2_invalidate_state_cache();
+	m_current_command_buffer->flags |= vk::command_buffer::cb_reload_dynamic_state;
+	st.ran_ok = true;
+}
+
+void VKGSRender::r2aa_check_read(u32 address)
+{
+	om_lane_join("r2aa_check_read"); // RSX_RECORD_DEFER
+	g_r2.fast_gen++; // RSX_AA_FAST_EXIT
+	auto& st = g_r2;
+	if (r2cfg().trace && (st.frame % static_cast<u32>(r2cfg().trace)) == 0 && st.frame) r2log("T f%u blit-read %08x", st.frame, address);
+	if (r2cfg().mode && !st.disabled && r2cfg().classify) st.sampled_rt[address]++;
+	if (st.late_open && address >= st.late_range.start && address <= st.late_range.end) st.late_sampled = true;
+	if (!r2cfg().mode || st.disabled || !st.scene_draws || st.aa_done || !st.rt_ptr || !scene_passes_done()) return; // reads between the scene passes are the light passes
+	if (st.resolve_wait) return; // the resolve pass reads the scene; upscale its output once it is done
+	if (address >= st.rt_range.start && address <= st.rt_range.end)
+	{
+		st.run_why = "scene read by a blit/copy";
+		const bool deferred = st.defer_bind;
+		r2aa_run();
+		if (deferred) r2aa_close_window(); // RSX_AA_BIND_DEFER: the blit reads the upscaled scene, as after a bind-time run
+	}
+}
+
+namespace
+{
+	// Next logical frame: pick its scene from this frame's draws, set its jitter
+	void frame_boundary()
+	{
+		auto& st = g_r2;
+		om_defer_finish(true); // RSX_AA_OBJMV_DEFER: before the frame swap
+		st.boundary_pending = false;
+		const u32 win_flips = st.flips_since;
+		st.flips_since = 0;
+		st.mat_done = false;
+		st.run_scene = false;
+		st.run_draws = st.run_dw = 0;
+		// Pick next frame's scene: the depth buffer with most depth-tested draws, then its busiest colour target
+		// RSX_AA_CLASSIFY: only pairs that look like the main view count (ReShade generic depth: skip small and
+		// shadow-map-like targets): colour wider than 512, at least half the largest candidate area, depth written.
+		const bool classify = r2cfg().classify;
+		u64 max_area = 0;
+		if (classify)
+			for (const auto& [key, t] : st.tally)
+				if ((key >> 32) && t.w > 512) max_area = std::max<u64>(max_area, static_cast<u64>(t.w) * t.h);
+		const auto eligible = [&](const pair_tally& t)
+		{
+			return !classify || (t.w > 512 && static_cast<u64>(t.w) * t.h * 2 >= max_area);
+		};
+		u64 best_ds = 0;
+		{
+			std::unordered_map<u32, u32> per_ds, ds_writes;
+			if (classify)
+				for (const auto& [key, t] : st.tally) ds_writes[static_cast<u32>(key)] += t.dwrites;
+			// RSX_AA_CLASSIFY_DWRITE: the most depth-writing draws on a depth bound with a main-view colour target
+			u32 max_writes = 0;
+			if (classify && r2cfg().classify_dwrite)
+				for (const auto& [key, t] : st.tally)
+					if ((key >> 32) && eligible(t)) max_writes = std::max(max_writes, ds_writes[static_cast<u32>(key)]);
+			u32 best = 0;
+			for (const auto& [key, t] : st.tally)
+			{
+				if (!(key >> 32)) continue; // depth-only (shadow maps) can't be the scene
+				if (!eligible(t)) continue;
+				const u32 ds = static_cast<u32>(key);
+				if (classify && !ds_writes[ds]) continue;
+				if (ds_writes[ds] * 4ull < max_writes) continue;
+				const u32 n = (per_ds[ds] += t.count);
+				if (n > best) { best = n; best_ds = ds; }
+			}
+		}
+
+		u32 max_count = 0;
+		for (const auto& [key, t] : st.tally)
+			if (static_cast<u32>(key) == best_ds && (key >> 32) && eligible(t)) max_count = std::max(max_count, t.count);
+
+		bool found = false, found_sampled = false;
+		u32 new_rt = 0, latest_first = 0;
+		for (const auto& [key, t] : st.tally)
+		{
+			if (static_cast<u32>(key) != best_ds || !(key >> 32) || !eligible(t)) continue;
+			if (t.count < std::max(30u, max_count / 4)) continue;
+			// Prefer a colour target that a later pass samples (the lit scene feeds post-processing)
+			const bool sampled = classify && st.sampled_rt.count(static_cast<u32>(key >> 32));
+			if (!found || (sampled && !found_sampled) || (sampled == found_sampled && t.first_draw > latest_first))
+			{
+				found = true;
+				found_sampled = sampled;
+				latest_first = t.first_draw;
+				new_rt = static_cast<u32>(key >> 32);
+			}
+		}
+		if (r2cfg().passlog && (st.frame % static_cast<u32>(r2cfg().passlog)) == 0)
+		{
+			for (const auto& [key, t] : st.tally)
+				r2log("V f%u pair rt=%08x ds=%08x %ux%u draws=%u dwrite=%u passes=%u first=%u sampled=%u eligible=%d",
+					st.frame, static_cast<u32>(key >> 32), static_cast<u32>(key), t.w, t.h, t.count, t.dwrites, t.segments, t.first_draw,
+					st.sampled_rt.count(static_cast<u32>(key >> 32)) ? st.sampled_rt[static_cast<u32>(key >> 32)] : 0u, eligible(t) ? 1 : 0);
+			r2log("V f%u pick rt=%08x ds=%08x (%s)", st.frame, new_rt, static_cast<u32>(best_ds), found ? "found" : "none");
+			if (r2cfg().objmv)
+			{
+				// O: per-object motion summary; OD: the draws that were classified (blanket / skinned / SPU-written meshes)
+				u32 n[8] = {}, dw = 0, logged = 0;
+				for (const auto& e : st.cur_F.e)
+				{
+					if (!(e.om & (om_matched | om_new))) continue;
+					dw++;
+					for (u32 b = 0; b < 8; ++b) if (e.om & (1u << b)) n[b]++;
+				}
+				r2log("O f%u objmv dwrite-draws=%u matched=%u unmatched=%u skinned=%u skinned-anim=%u dynvb=%u rigid-moving=%u replayed=%u objmv=%u masked=%u pending-pipe=%u skipped=%u",
+					st.frame, dw, n[0], n[1], n[6], n[2], n[3], n[4], st.om_replays, st.om_objmv, st.om_masked, st.om_pending, st.om_skipped);
+				for (u32 i = 0; i < st.cur_F.e.size() && logged < 64; ++i)
+				{
+					const auto& e = st.cur_F.e[i];
+					if (!(e.om & om_want)) continue;
+					logged++;
+					r2log("OD f%u e%u id=%u vp=%05x va0=%08x vb=%08x key=%016llx%s%s%s%s%s%s", st.frame, i, e.id, e.vp_addr, e.va0, e.vb_hash,
+						static_cast<unsigned long long>(e.key), (e.om & om_new) ? " new" : "", (e.om & om_indexed) ? " indexed" : "",
+						(e.om & om_skin) ? " skin-anim" : "", (e.om & om_dyn) ? " dynvb" : "", (e.om & om_rigid) ? " rigid-moving" : "",
+						(e.om & om_replayed) ? " replayed" : "");
+				}
+			}
+		}
+
+		const bool was_valid = st.scene_valid;
+		const u32 old_rt = st.scene_rt, old_ds = st.scene_ds;
+		const bool differs = found && was_valid && (new_rt != old_rt || static_cast<u32>(best_ds) != old_ds);
+		// RSX_AA_CLASSIFY_HOLD: no depth writes into the scene depth in this window = the window missed the scene's
+		// pre-pass (a boundary mid-frame); its vote is not representative
+		u32 old_dw = 0, old_pair_draws = 0;
+		for (const auto& [key, t] : st.tally)
+			if (static_cast<u32>(key) == old_ds)
+			{
+				old_dw += t.dwrites;
+				if (static_cast<u32>(key >> 32) == old_rt) old_pair_draws = t.count;
+			}
+		// A window without a flip is a partial frame (boundary right after a mid-frame upscaler run): the scene pair
+		// drawn there at all (8-10 draws in R3's diner) is present, not absent. Without this, such windows switched to
+		// the forward pair c19c0000/c1380000 at once every 2-3 frames, and each switch rendered the G-buffer pass
+		// unscaled/unjittered (blue/purple normals flashing on whole objects). flips_since only counts in split mode.
+		const bool partial_present = r2cfg().split && win_flips == 0 && old_pair_draws > 0;
+		st.part_start = r2cfg().split && win_flips == 0;
+		if (pdq_partial_hold(found, was_valid, r2cfg().split, r2cfg().classify_partial, win_flips, st.lat_skip_run, st.partial_row, 3))
+		{
+			// RSX_AA_CLASSIFY_PARTIAL: the next window (it spans a flip / holds the pre-pass) decides
+			found = true;
+			new_rt = old_rt;
+			best_ds = old_ds;
+			st.stat_partial_hold++;
+			st.partial_row++;
+			if (st.diag_partial < 4)
+			{
+				st.diag_partial++;
+				r2log("scene kept f%u: a window (%u flip(s), %u draws, %u scene-pair draws, %u scene depth writes, latch skip run %u) found no scene; "
+					"%08x/%08x stays (RSX_AA_CLASSIFY_PARTIAL=0: old rule)", st.frame, win_flips, st.draw_index, old_pair_draws, old_dw,
+					st.lat_skip_run, old_rt, old_ds);
+			}
+		}
+		else st.partial_row = 0;
+		bool held = false;
+		if (differs && classify && r2cfg().classify_hold)
+		{
+			// The scene pair must still be drawn (same threshold as the hysteresis): an absent pair is a real scene
+			// change (level load, cutscene, menu, re-created targets) and switches at once
+			if (!old_dw && (old_pair_draws >= 30 || partial_present) && st.hold_wins < r2cfg().classify_hold)
+			{
+				held = true;
+				st.hold_wins++;
+				if (st.diag_hold < 6)
+				{
+					st.diag_hold++;
+					r2log("scene vote held f%u (%u/%u): the window (%u draws, run '%s') has no depth writes into the scene depth %08x "
+						"(scene pair %u draws); it voted for %08x/%08x (RSX_AA_CLASSIFY_HOLD=0: switch)", st.frame, st.hold_wins,
+						r2cfg().classify_hold, st.draw_index, st.run_why ? st.run_why : "-", old_ds, old_pair_draws, new_rt, static_cast<u32>(best_ds));
+					u32 n = 0;
+					for (const auto& [key, t] : st.tally)
+						if (t.count >= 4 && n++ < 12)
+							r2log("  pair rt=%08x ds=%08x %ux%u draws=%u dwrite=%u passes=%u first=%u eligible=%d", static_cast<u32>(key >> 32),
+								static_cast<u32>(key), t.w, t.h, t.count, t.dwrites, t.segments, t.first_draw, eligible(t) ? 1 : 0);
+				}
+				new_rt = old_rt;
+				best_ds = old_ds;
+			}
+		}
+		// RSX_AA_CLASSIFY_CDW: the winner's own draws wrote no depth (its depth only got depth-only copies) while the
+		// scene pair's own draws still wrote depth in the window: a mid-frame window, not a scene change. At most
+		// RSX_AA_CLASSIFY_CDW_CAP windows in a row; past the cap the vote goes to the hysteresis until a window no
+		// longer meets the condition (a real change to a pair without depth writes of its own still switches)
+		bool refused = false;
+		bool cdw_case = false;
+		if (differs && !held && classify && r2cfg().classify_cdw)
+		{
+			const auto it_new = st.tally.find((static_cast<u64>(new_rt) << 32) | static_cast<u32>(best_ds));
+			const auto it_old = st.tally.find((static_cast<u64>(old_rt) << 32) | old_ds);
+			const u32 new_dw = it_new != st.tally.end() ? it_new->second.dwrites : 0;
+			const u32 old_draws = it_old != st.tally.end() ? it_old->second.count : 0;
+			const u32 old_dw = it_old != st.tally.end() ? it_old->second.dwrites : 0;
+			cdw_case = !new_dw && old_dw;
+			if (cdw_case && st.cdw_wins >= r2cfg().classify_cdw_cap)
+			{
+				if (st.cdw_wins == r2cfg().classify_cdw_cap && st.diag_cdw_cap < 6)
+				{
+					st.diag_cdw_cap++;
+					r2log("scene switch released f%u: %u windows in a row refused (RSX_AA_CLASSIFY_CDW_CAP); %08x/%08x goes to the "
+						"hysteresis (scene pair %08x/%08x: %u draws, %u depth writes)", st.frame, st.cdw_wins, new_rt,
+						static_cast<u32>(best_ds), old_rt, old_ds, old_draws, old_dw);
+				}
+				st.cdw_wins++;
+			}
+			else if (cdw_case)
+			{
+				refused = true;
+				st.cdw_wins++;
+				st.stat_cdw++;
+				if ((st.stat_cdw % 256) == 0)
+					r2log("scene switch refused %u times so far (RSX_AA_CLASSIFY_CDW)", st.stat_cdw);
+				if (st.diag_cdw < 6)
+				{
+					st.diag_cdw++;
+					r2log("scene switch refused f%u (#%u, %u in a row): %08x/%08x won the window (%u draws, run '%s', %u flip(s)) without a "
+						"depth write of its own; the scene pair %08x/%08x was drawn %u times with %u depth writes (RSX_AA_CLASSIFY_CDW=0: switch)",
+						st.frame, st.stat_cdw, st.cdw_wins, new_rt, static_cast<u32>(best_ds), st.draw_index, st.run_why ? st.run_why : "-",
+						win_flips, old_rt, old_ds, old_draws, old_dw);
+					u32 n = 0;
+					for (const auto& [key, t] : st.tally)
+						if (t.count >= 4 && n++ < 12)
+							r2log("  pair rt=%08x ds=%08x %ux%u draws=%u dwrite=%u passes=%u first=%u eligible=%d", static_cast<u32>(key >> 32),
+								static_cast<u32>(key), t.w, t.h, t.count, t.dwrites, t.segments, t.first_draw, eligible(t) ? 1 : 0);
+				}
+				new_rt = old_rt;
+				best_ds = old_ds;
+			}
+		}
+		if (!cdw_case) st.cdw_wins = 0;
+		if (!differs || (!held && !refused)) st.hold_wins = 0;
+		if (held || refused)
+		{
+			// the vote is ignored: the hysteresis count is neither advanced nor reset
+		}
+		else if (differs)
+		{
+			// Hysteresis: frames where two pairs are close (menus over the game, cutscene transitions) must not flip
+			// the scene every frame (each switch resets the upscaler history). Switch once the other pair wins 3 frames
+			// in a row, or at once when the current scene pair was not drawn at all.
+			const auto it = st.tally.find((static_cast<u64>(old_rt) << 32) | old_ds);
+			const bool old_present = (it != st.tally.end() && it->second.count >= 30) || partial_present;
+			if (old_present && ++st.switch_votes < 3)
+			{
+				new_rt = old_rt;
+				best_ds = old_ds;
+			}
+			else
+			{
+				st.switch_votes = 0;
+			}
+		}
+		else
+		{
+			st.switch_votes = 0;
+		}
+		st.scene_valid = found;
+		if (found)
+		{
+			st.scene_rt = new_rt;
+			st.scene_ds = static_cast<u32>(best_ds);
+		}
+		st.scene_changed = !was_valid || !found || old_rt != st.scene_rt || old_ds != st.scene_ds;
+		if (found)
+		{
+			const auto it = st.tally.find((static_cast<u64>(st.scene_rt) << 32) | st.scene_ds);
+			st.seg_target = it != st.tally.end() ? std::max(1u, it->second.segments) : 1u;
+		}
+		if (st.scene_changed && found)
+		{
+			r2log("scene: colour 0x%08x, depth 0x%08x (%u draws, %u passes)", st.scene_rt, st.scene_ds, max_count, st.seg_target);
+			if (was_valid && st.diag_switch < 8)
+			{
+				// One-shot: the vote window behind a switch between two valid scenes (each one resets the upscaler)
+				st.diag_switch++;
+				r2log("  switch f%u from %08x/%08x: window of %u draws, run '%s', %u flip(s) in it, hold %u", st.frame, old_rt, old_ds,
+					st.draw_index, st.run_why ? st.run_why : "-", win_flips, st.hold_wins);
+				u32 n = 0;
+				for (const auto& [key, t] : st.tally)
+					if (t.count >= 4 && n++ < 12)
+						r2log("  pair rt=%08x ds=%08x %ux%u draws=%u dwrite=%u passes=%u first=%u eligible=%d", static_cast<u32>(key >> 32),
+							static_cast<u32>(key), t.w, t.h, t.count, t.dwrites, t.segments, t.first_draw, eligible(t) ? 1 : 0);
+			}
+			st.need_reset = true;
+			st.reset_why |= 1;
+			st.lock_w = st.lock_h = 0;
+		}
+
+		if (r2cfg().debug && (st.frame % 300) == 0)
+		{
+			r2log("frame %u: %u scene draws, %u matrix evals (%u failed), vote %u/%u", st.frame, st.scene_draws, st.evals, st.eval_fail, st.vote_hits, st.vote_total);
+		}
+
+		// Next frame
+		g_evp_swaps++; // RSX_AA_EXACT_MEMO
+		st.prev_F.e.swap(st.cur_F.e);
+		st.prev_F.consts.swap(st.cur_F.consts);
+		st.prev_F.c2.swap(st.cur_F.c2);
+		st.prev_F.cam_h = st.cur_F.cam_h;
+		st.om_cam_cur = 0;
+		st.cur_F.clear();
+		om2_frame_end();
+		st.om_prev.clear();
+		if (r2cfg().objmv)
+			for (u32 i = 0; i < st.prev_F.e.size(); ++i)
+				if (u32* v = st.om_prev.find(st.prev_F.e[i].key, true)) *v = i;
+		st.prev_loose.clear();
+		if (r2cfg().match_loose)
+			for (u32 i = 0; i < st.prev_F.e.size(); ++i)
+				if (st.prev_F.e[i].lkey)
+					if (u32* v = st.prev_loose.find(st.prev_F.e[i].lkey, true)) *v = i;
+		st.loose_occ.clear();
+		if (st.evals >= r2cfg().evals_max) st.stat_evals_cap++;
+		st.stat_nw_cut += st.evals_nw_cut;
+		st.om_nclus = 0;
+		st.om_cur = -1;
+		st.id_next = 0;
+		st.om_replays = st.om_skipped = st.om_pending = st.om_objmv = st.om_masked = 0;
+		st.fx_tot_draws += st.fx_draws;
+		st.fx_tot_skipped += st.fx_skipped + st.fx_pending;
+		st.fx_draws = st.fx_skipped = st.fx_pending = 0;
+		st.fx_cur = false;
+		st.occurrences.clear();
+		st.tally.clear();
+		st.sampled_rt.clear();
+		if (const u32 hold = static_cast<u32>(r2cfg().link_hold))
+		{
+			// RSX_AA_LINK_HOLD: a target the material draws did not sample this frame (ping-pong history, ADS frames
+			// with another scene bind size) keeps the scene scale for `hold` more frames instead of flipping to full
+			// scale and back; each flip turns its 1:1 copies/reads into cross-scale resamples
+			for (const u32 a : st.link_cur) st.link_age[a] = 0;
+			for (auto it = st.link_age.begin(); it != st.link_age.end();)
+			{
+				if (!st.link_cur.count(it->first) && ++it->second > hold)
+				{
+					it = st.link_age.erase(it);
+					continue;
+				}
+				st.link_cur.insert(it->first);
+				++it;
+			}
+		}
+		st.link_prev.swap(st.link_cur);
+		st.link_cur.clear();
+		st.jd_depth.clear();
+		st.jd_shift.clear();
+		st.jdm_gen++;
+		st.sl_prev_post_jd = st.sl_post_jd;
+		st.sl_prev_post_samp = st.sl_post_samp;
+		st.sl_jit = st.sl_jit_other = st.sl_post_jd = st.sl_post_samp = 0;
+		st.ps_prev.swap(st.ps_seen);
+		st.ps_seen.clear();
+		st.pl_idx = 0;
+		st.last_tally = nullptr;
+		st.last_tally_pair = ~0ull;
+		st.last_pair = ~0ull;
+		st.seg_count = 0;
+		st.prev_S = st.frame_S;
+		st.prev_valid = st.frame_S.valid && st.ran_ok;
+		// Jitter only while the upscaler is known to run on this scene: it ran last frame and the scene is unchanged.
+		// Otherwise (menus, loading screens, the first frame of a new scene, a failed pass) draw without jitter.
+		if (st.jitter_cooldown) st.jitter_cooldown--;
+		const bool jitter_on = st.ran_ok && st.scene_valid && !st.scene_changed && !st.jitter_cooldown && r2cfg().jitter;
+		st.ran_ok = false;
+		st.scene_draws_last = st.scene_draws;
+		st.scene_draws = 0;
+		st.draw_index = 0;
+		st.win_dw = st.win_ndw = 0;
+		st.evals = st.eval_fail = 0;
+		st.evals_nw = st.evals_nw_cut = 0;
+		st.aa_done = false;
+		st.lat_full_scene = false;
+		st.pre_fs = 0;
+		st.rt_ptr = nullptr;
+		st.ds_ptr = nullptr;
+		st.frame_S.valid = false;
+		pdq_s_reset(&st.s_tal);
+		st.frame++;
+		g_r2_trace_now = r2cfg().trace && (st.frame % static_cast<u32>(r2cfg().trace)) < 2 && st.frame > 1;
+		// RSX_AA_PHASE_ON_RUN (default 1; 0 = old: the frame counter): the Halton index advances only on jittered frames,
+		// so empty / unjittered flips (no scene, cooldown, scene change) don't skip phases of the sequence
+		const bool jhold = pdq_jitter_hold(r2cfg().jit_hold, st.part_start, jitter_on, st.jit_last_on, st.jit_hold_row, 3) != 0;
+		st.jit_hold_row = jhold ? st.jit_hold_row + 1 : 0;
+		st.jit_last_on = jitter_on;
+		if (jhold) st.stat_jit_hold++;
+		if (jitter_on && !jhold) st.jit_seq++;
+		const u32 phase = jhold ? st.sl_phase : ((r2cfg().phase_on_run ? st.jit_seq : st.frame) % static_cast<u32>(r2cfg().phases)) + 1;
+		if (!jhold)
+		{
+			st.jx = jitter_on ? pdq_jitter_untie(halton(phase, 2) - 0.5f, r2cfg().jit_tie) : 0.f;
+			st.jy = jitter_on ? pdq_jitter_untie(halton(phase, 3) - 0.5f, r2cfg().jit_tie) : 0.f;
+		}
+	st.sl_phase = phase;
+		if (jitter_on) st.stat_jitter++;
+		if (jitter_on && !st.fol_logged) st.fol_frames++;
+	}
+}
