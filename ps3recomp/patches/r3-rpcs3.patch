index 0000000..37635a7
--- /dev/null
+++ b/rpcs3/Emu/RSX/VK/VKR2Hdr.cpp
@@ -0,0 +1,206 @@
+// R2PORT PC extras (not upstream RPCS3): HDR output settings, Windows HDR detection, SDR -> HDR present code.
+//
+// Inverse tone mapping (same curve as R1's port_hdr.h, the C reference; keep them in step):
+// decode the 8-bit image with a 2.2 power, keep BT.709 luminance up to the knee (linear 0.6) exactly at
+// paper white, expand above it with Y' = k + (1-k) u (1 + a u^3) (slope 1 at the knee, SDR white -> peak),
+// scale rgb by Y'/Y, BT.709 -> BT.2020, optional saturation, cap the largest channel at the peak, then
+// PQ (HDR10) or back to BT.709 / 80 nits (scRGB). A +-1 code TPDF dither covers the stretched top range.
+// The HUD has no separate pass, so it sits at paper white; peak = paper turns the expansion off.
+
+#include "VKR2Hdr.h"
+
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <mutex>
+
+#ifdef _WIN32
+#ifndef NOMINMAX
+#define NOMINMAX
+#endif
+#ifndef WIN32_LEAN_AND_MEAN
+#define WIN32_LEAN_AND_MEAN
+#endif
+#include <windows.h>
+#include <dxgi1_6.h>
+#pragma comment(lib, "dxgi.lib")
+#endif
+
+namespace
+{
+	// R2_ / R3_ / R1_ (the ports' own names), then PORT_
+	const char* henv(const char* name)
+	{
+		for (const char* pre : { "R2_", "R3_", "R1_", "PORT_" })
+		{
+			char full[96];
+			std::snprintf(full, sizeof(full), "%s%s", pre, name);
+			const char* e = std::getenv(full);
+			if (e && *e) return e;
+		}
+		return nullptr;
+	}
+
+	float clampf(float v, float lo, float hi) { return v < lo ? lo : v > hi ? hi : v; }
+
+	struct req_t { int mode; bool automatic; };
+	const req_t& req()
+	{
+		static const req_t r = []
+		{
+			const char* e = henv("HDR");
+			if (!e || !std::strcmp(e, "0") || !_stricmp(e, "off")) return req_t{ 0, false };
+			if (!_stricmp(e, "auto")) return req_t{ 1, true };
+			if (!_stricmp(e, "scrgb") || !std::strcmp(e, "2")) return req_t{ 2, false };
+			if (!std::strcmp(e, "1") || !_stricmp(e, "on") || !_stricmp(e, "hdr10")) return req_t{ 1, false };
+			std::fprintf(stderr, "[pcx-vk] HDR: unknown setting '%s'; off\n", e);
+			return req_t{ 0, false };
+		}();
+		return r;
+	}
+
+	struct display_t { int hdr = -1; float peak = 0.f; };
+
+#ifdef _WIN32
+	BOOL CALLBACK find_window(HWND w, LPARAM lp)
+	{
+		DWORD pid = 0;
+		GetWindowThreadProcessId(w, &pid);
+		if (pid != GetCurrentProcessId() || !IsWindowVisible(w)) return TRUE;
+		if (GetWindowLongW(w, GWL_EXSTYLE) & (WS_EX_TOOLWINDOW | WS_EX_LAYERED)) return TRUE; // overlays / toasts
+		RECT r;
+		if (!GetWindowRect(w, &r)) return TRUE;
+		auto* best = reinterpret_cast<std::pair<HWND, long long>*>(lp);
+		const long long area = static_cast<long long>(r.right - r.left) * (r.bottom - r.top);
+		if (area > best->second) *best = { w, area };
+		return TRUE;
+	}
+
+	display_t query_display()
+	{
+		display_t d;
+		std::pair<HWND, long long> best{ nullptr, 0 };
+		EnumWindows(find_window, reinterpret_cast<LPARAM>(&best));
+		const HMONITOR mon = best.first ? MonitorFromWindow(best.first, MONITOR_DEFAULTTOPRIMARY)
+		                                : MonitorFromPoint(POINT{ 0, 0 }, MONITOR_DEFAULTTOPRIMARY);
+		IDXGIFactory1* f = nullptr;
+		if (FAILED(CreateDXGIFactory1(__uuidof(IDXGIFactory1), reinterpret_cast<void**>(&f))) || !f) return d;
+		IDXGIAdapter1* a = nullptr;
+		for (UINT ai = 0; d.hdr < 0 && f->EnumAdapters1(ai, &a) != DXGI_ERROR_NOT_FOUND; ai++)
+		{
+			IDXGIOutput* o = nullptr;
+			for (UINT oi = 0; d.hdr < 0 && a->EnumOutputs(oi, &o) != DXGI_ERROR_NOT_FOUND; oi++)
+			{
+				IDXGIOutput6* o6 = nullptr;
+				DXGI_OUTPUT_DESC1 od;
+				if (SUCCEEDED(o->QueryInterface(__uuidof(IDXGIOutput6), reinterpret_cast<void**>(&o6))) && o6)
+				{
+					if (SUCCEEDED(o6->GetDesc1(&od)) && od.Monitor == mon)
+					{
+						d.hdr = od.ColorSpace == DXGI_COLOR_SPACE_RGB_FULL_G2084_NONE_P2020 ? 1 : 0;
+						d.peak = od.MaxLuminance;
+					}
+					o6->Release();
+				}
+				o->Release();
+			}
+			a->Release();
+		}
+		f->Release();
+		return d;
+	}
+#else
+	display_t query_display() { return {}; }
+#endif
+
+	const display_t& display()
+	{
+		static const display_t d = query_display();
+		return d;
+	}
+
+	struct levels_t { float paper, peak, sat; const char* src; };
+	const levels_t& levels()
+	{
+		static const levels_t l = []
+		{
+			levels_t v{};
+			const char* e = henv("HDR_PAPER");
+			v.paper = clampf(e && std::atof(e) > 0 ? static_cast<float>(std::atof(e)) : 203.f, 80.f, 500.f);
+			e = henv("HDR_PEAK");
+			const float dp = req().mode ? display().peak : 0.f;
+			if (e && std::atof(e) > 0) v.peak = static_cast<float>(std::atof(e)), v.src = "setting";
+			else if (dp >= 100.f && dp <= 10000.f) v.peak = dp, v.src = "display";
+			else v.peak = 1000.f, v.src = "default";
+			v.peak = clampf(v.peak, v.paper, 10000.f);
+			e = henv("HDR_SAT");
+			v.sat = e ? static_cast<float>(std::atof(e)) : 1.f;
+			v.sat = v.sat >= 0.f ? clampf(v.sat, 0.f, 2.f) : 1.f;
+			return v;
+		}();
+		return l;
+	}
+}
+
+namespace r2hdr
+{
+	int request() { return req().mode; }
+	bool is_auto() { return req().automatic; }
+	int display_hdr() { return req().mode ? display().hdr : -1; }
+
+	bool allowed()
+	{
+		if (!req().mode) return false;
+		const int d = display_hdr();
+		return req().automatic ? d == 1 : d != 0;
+	}
+
+	float paper() { return levels().paper; }
+	float peak() { return levels().peak; }
+	float sat() { return levels().sat; }
+	const char* peak_source() { return levels().src; }
+
+	const char* glsl()
+	{
+		return R"(
+uint r2pc_pcg(uint v)
+{
+	uint s = v * 747796405u + 2891336453u;
+	uint w = ((s >> ((s >> 28u) + 4u)) ^ s) * 277803737u;
+	return (w >> 22u) ^ w;
+}
+vec3 r2pc_hdr(vec3 c, vec2 frag_xy, int mode, float paper, float peak, float sat)
+{
+	// +-1 code TPDF dither where the expansion stretches the 8-bit steps
+	uvec2 q = uvec2(frag_xy);
+	uint h = r2pc_pcg(q.x + r2pc_pcg(q.y));
+	float t = (float(h & 0xFFFFu) + float(h >> 16u)) / 65535.0 - 1.0;
+	c = clamp(c, 0.0, 1.0);
+	c = clamp(c + t / 255.0 * clamp((max(c.r, max(c.g, c.b)) - 0.74) * 20.0, 0.0, 1.0), 0.0, 1.0);
+	vec3 l = pow(c, vec3(2.2));
+	float y = dot(l, vec3(0.2126, 0.7152, 0.0722));
+	const float kn = 0.6;
+	float r = max(peak / paper, 1.0);
+	if (y > kn)
+	{
+		float u = clamp((y - kn) / (1.0 - kn), 0.0, 1.0);
+		float a = (r - 1.0) / (1.0 - kn);
+		l *= (kn + (1.0 - kn) * u * (1.0 + a * u * u * u)) / y;
+	}
+	const mat3 bt709_to_2020 = mat3(0.627404, 0.069097, 0.016391, 0.329283, 0.919540, 0.088013, 0.043313, 0.011362, 0.895595);
+	vec3 n = bt709_to_2020 * l;
+	float y2 = dot(n, vec3(0.2627, 0.6780, 0.0593));
+	n = max(vec3(y2) + (n - vec3(y2)) * sat, vec3(0.0)) * paper;
+	float m = max(n.r, max(n.g, n.b));
+	if (m > peak) n *= peak / m;
+	if (mode == 2)
+	{
+		const mat3 bt2020_to_709 = mat3(1.660491, -0.124550, -0.018151, -0.587641, 1.132900, -0.100579, -0.072850, -0.008349, 1.118730);
+		return bt2020_to_709 * n / 80.0;
+	}
+	vec3 p = pow(clamp(n / 10000.0, 0.0, 1.0), vec3(0.1593017578125));
+	return pow((0.8359375 + 18.8515625 * p) / (1.0 + 18.6875 * p), vec3(78.84375));
+}
+)";
+	}
+}
diff --git a/rpcs3/Emu/RSX/VK/VKR2Hdr.h b/rpcs3/Emu/RSX/VK/VKR2Hdr.h
new file mode 100644
index 0000000..2e561b0
--- /dev/null
+++ b/rpcs3/Emu/RSX/VK/VKR2Hdr.h
@@ -0,0 +1,29 @@
+// R2PORT PC extras: HDR output settings, Windows HDR detection and the SDR -> HDR present code
+// (VKR2PcExtras.cpp does the Vulkan side and calls these). Nothing here runs unless HDR is asked for.
+#pragma once
+
+namespace r2hdr
+{
+	// What the settings ask for: 0 off, 1 HDR10, 2 scRGB. R2_HDR / R3_HDR / R1_HDR, else PORT_HDR:
+	// 0 / off / unset, 1 / on / hdr10, 2 / scrgb, auto (HDR10 only when Windows HDR is on for the display).
+	int request();
+	bool is_auto();
+
+	// Whether Windows HDR is on for the game's display (DXGI): 1 on, 0 off, -1 unknown. Cached; also
+	// reads the display's peak brightness. Call only when HDR is asked for.
+	int display_hdr();
+
+	// The swapchain may be HDR: the request, and Windows HDR not known to be off (auto: known to be on).
+	bool allowed();
+
+	// Settings: paper white nits (default 203), peak nits (default: the display's, else 1000; >= paper),
+	// saturation (default 1). *_HDR_PAPER / *_HDR_PEAK / *_HDR_SAT.
+	float paper();
+	float peak();
+	float sat();
+	const char* peak_source(); // "setting", "display" or "default"
+
+	// GLSL for the present pass: vec3 r2pc_hdr(vec3 c, vec2 frag_xy, int mode, float paper, float peak, float sat),
+	// c = the final SDR colour (0..1, gamma), mode 1 = HDR10 (PQ), 2 = scRGB.
+	const char* glsl();
+}
diff --git a/rpcs3/Emu/RSX/VK/VKR2PassDump.cpp b/rpcs3/Emu/RSX/VK/VKR2PassDump.cpp
new file mode 100644
index 0000000..268ccb4
--- /dev/null
+++ b/rpcs3/Emu/RSX/VK/VKR2PassDump.cpp
@@ -0,0 +1,611 @@
+// R2PORT: Resistance 2 port addition (not upstream RPCS3).
+//
+// Pass-by-pass capture of the RPCS3 Vulkan renderer, the counterpart of the native draw engine's
+// RSX_ENGINE_PASS_DUMP (ps3recomp/libs/video/rsx_draw_engine.c, "per-pass capture"). Same
+// environment variables, same file names and, as far as the two renderers allow, the same line
+// formats, so scratch/passdiff.py can align the two dumps pass by pass.
+//
+//  RSX_ENGINE_PASS_DUMP=<existing dir>   enable; inert (one branch per draw/clear/bind/flip) when unset
+//  RSX_ENGINE_PASS_DUMP_AFTER=<s>        start at the first draw <s> seconds after the first draw
+//  RSX_ENGINE_PASS_DUMP_MINDRAWS=<n>     without _AFTER: start after the first flip of a frame of >= n draws (1)
+//  RSX_ENGINE_PASS_DUMP_MAX=<n>          passes per capture window (64)
+//  RSX_ENGINE_PASS_DUMP_DRAWS=1          also <dir>/draws.txt, one line per draw / clear
+//  RSX_ENGINE_PASS_DUMP_TRIGGER=<file>   windows on demand: every 30 flips, if <file> exists its content
+//                                        names a subdirectory; the file is deleted and _MAX passes are
+//                                        captured into <dir>/<name>/ from the next frame. Repeatable.
+//
+// A pass is a run of draws and clears into one surface set (colour addresses + zeta + formats + AA mode).
+// It is closed when on_framebuffer_bound binds a different set (before the old surfaces are released) and
+// at each flip. Closing reads back every bound colour target to passNNN_tK.ppm and the depth target to
+// passNNN_z.pgm (stretched from its smallest to its largest value). Multisampled targets are expanded to
+// RPCS3's sample grid (width * samples_x, height * samples_y) with RPCS3's own resolve shaders -- the same
+// layout the native engine keeps antialiased surfaces in. Images are at the resolution scale in effect.
+// Readback costs a hard GPU sync per pass; nothing of it runs unless the dump is capturing.
+
+#include "stdafx.h"
+#include "VKGSRender.h"
+#include "VKHelpers.h"
+#include "VKRenderTargets.h"
+#include "VKResourceManager.h"
+#include "vkutils/buffer_object.h"
+
+#include "Emu/RSX/rsx_methods.h"
+#include "Emu/RSX/NV47/HW/context_accessors.define.h"
+
+#include <algorithm>
+#include <cmath>
+#include <cstdarg>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <ctime>
+#include <filesystem>
+#include <string>
+#include <vector>
+
+struct VKGSRender::r2pd_job
+{
+	std::unique_ptr<vk::viewable_image> tmp; // sample-grid resolve of a multisampled target
+	std::unique_ptr<vk::buffer> buf;
+	VkFormat fmt = VK_FORMAT_UNDEFINED;
+	u32 w = 0, h = 0;
+	bool depth = false;
+	bool ok = false;
+	std::string path;
+	float lo = -1.f, hi = -1.f;
+};
+
+namespace
+{
+	struct pd_key
+	{
+		u32 c[4]{};
+		u32 z = 0, cfmt = 0, zfmt = 0, aa = 0;
+		bool operator==(const pd_key& o) const { return !std::memcmp(this, &o, sizeof(*this)); }
+	};
+
+	struct pd_state_t
+	{
+		int state = 0; // 0 unread, 1 waiting, 2 capturing, 3 off
+		std::string base, dir, trigger;
+		u32 min_draws = 1, after_s = 0, max_passes = 64;
+		bool draws_env = false;
+		time_t start = 0;
+		FILE* index = nullptr;
+		FILE* draws_log = nullptr;
+		u32 pass = 0;
+		bool open = false;
+		pd_key key{};
+		u32 draws = 0, clears = 0, skipped = 0;
+		std::string first;
+		u32 frame_draws = 0, frames = 0, flips = 0;
+	} g_pd;
+
+	std::string sfmt(const char* f, ...)
+	{
+		char buf[4096];
+		va_list ap;
+		va_start(ap, f);
+		std::vsnprintf(buf, sizeof(buf), f, ap);
+		va_end(ap);
+		return buf;
+	}
+
+	u32 local_offset(u32 address)
+	{
+		return address >= rsx::constants::local_mem_base ? address - rsx::constants::local_mem_base : address;
+	}
+
+	float as_float(u32 v)
+	{
+		float f;
+		std::memcpy(&f, &v, 4);
+		return f;
+	}
+
+	float half_to_float(u16 h)
+	{
+		const u32 e = (h >> 10) & 0x1Fu, m = h & 0x3FFu;
+		float v;
+		if (e == 0) v = static_cast<float>(m) / 16777216.0f;
+		else if (e == 31) v = m ? 0.0f : 65504.0f;
+		else v = std::ldexp(1.0f + static_cast<float>(m) / 1024.0f, static_cast<int>(e) - 15);
+		return (h & 0x8000u) ? -v : v;
+	}
+
+	u8 unit(float v)
+	{
+		if (!(v > 0.0f)) return 0;
+		if (v >= 1.0f) return 255;
+		return static_cast<u8>(v * 255.0f + 0.5f);
+	}
+
+	u32 texel_bytes(VkFormat fmt, bool depth)
+	{
+		if (depth)
+		{
+			switch (fmt)
+			{
+			case VK_FORMAT_D16_UNORM: return 2;
+			case VK_FORMAT_D24_UNORM_S8_UINT:
+			case VK_FORMAT_D32_SFLOAT:
+			case VK_FORMAT_D32_SFLOAT_S8_UINT: return 4;
+			default: return 0;
+			}
+		}
+		switch (fmt)
+		{
+		case VK_FORMAT_B8G8R8A8_UNORM:
+		case VK_FORMAT_R8G8B8A8_UNORM:
+		case VK_FORMAT_R32_SFLOAT: return 4;
+		case VK_FORMAT_R16G16B16A16_SFLOAT: return 8;
+		case VK_FORMAT_R32G32B32A32_SFLOAT: return 16;
+		case VK_FORMAT_R8_UNORM: return 1;
+		case VK_FORMAT_R8G8_UNORM:
+		case VK_FORMAT_R5G6B5_UNORM_PACK16:
+		case VK_FORMAT_A1R5G5B5_UNORM_PACK16:
+		case VK_FORMAT_R16_SFLOAT: return 2;
+		default: return 0;
+		}
+	}
+
+	// One colour image to a binary PPM, alpha dropped, floats clamped to [0,1].
+	void write_ppm(const std::string& path, const u8* raw, VkFormat fmt, u32 w, u32 h)
+	{
+		std::vector<u8> rgb(static_cast<usz>(w) * h * 3);
+		const u32 bpp = texel_bytes(fmt, false);
+		for (usz i = 0; i < static_cast<usz>(w) * h; i++)
+		{
+			const u8* p = raw + i * bpp;
+			u8* o = &rgb[i * 3];
+			switch (fmt)
+			{
+			case VK_FORMAT_B8G8R8A8_UNORM: o[0] = p[2]; o[1] = p[1]; o[2] = p[0]; break;
+			case VK_FORMAT_R8G8B8A8_UNORM: o[0] = p[0]; o[1] = p[1]; o[2] = p[2]; break;
+			case VK_FORMAT_R16G16B16A16_SFLOAT:
+				for (int c = 0; c < 3; c++) { u16 v; std::memcpy(&v, p + c * 2, 2); o[c] = unit(half_to_float(v)); }
+				break;
+			case VK_FORMAT_R32G32B32A32_SFLOAT:
+				for (int c = 0; c < 3; c++) { float v; std::memcpy(&v, p + c * 4, 4); o[c] = unit(v); }
+				break;
+			case VK_FORMAT_R32_SFLOAT: { float v; std::memcpy(&v, p, 4); o[0] = o[1] = o[2] = unit(v); break; }
+			case VK_FORMAT_R16_SFLOAT: { u16 v; std::memcpy(&v, p, 2); o[0] = o[1] = o[2] = unit(half_to_float(v)); break; }
+			case VK_FORMAT_R8_UNORM: o[0] = o[1] = o[2] = p[0]; break;
+			case VK_FORMAT_R8G8_UNORM: o[0] = p[0]; o[1] = p[1]; o[2] = 0; break;
+			case VK_FORMAT_R5G6B5_UNORM_PACK16:
+			{
+				u16 v; std::memcpy(&v, p, 2);
+				o[0] = static_cast<u8>(((v >> 11) & 31) * 255 / 31);
+				o[1] = static_cast<u8>(((v >> 5) & 63) * 255 / 63);
+				o[2] = static_cast<u8>((v & 31) * 255 / 31);
+				break;
+			}
+			case VK_FORMAT_A1R5G5B5_UNORM_PACK16:
+			{
+				u16 v; std::memcpy(&v, p, 2);
+				o[0] = static_cast<u8>(((v >> 10) & 31) * 255 / 31);
+				o[1] = static_cast<u8>(((v >> 5) & 31) * 255 / 31);
+				o[2] = static_cast<u8>((v & 31) * 255 / 31);
+				break;
+			}
+			default: break;
+			}
+		}
+		if (FILE* f = std::fopen(path.c_str(), "wb"))
+		{
+			std::fprintf(f, "P6\n%u %u\n255\n", w, h);
+			std::fwrite(rgb.data(), 1, rgb.size(), f);
+			std::fclose(f);
+		}
+	}
+
+	// A depth image to a greyscale PGM stretched from its smallest to its largest value.
+	void write_pgm(const std::string& path, const u8* raw, VkFormat fmt, u32 w, u32 h, float& lo, float& hi)
+	{
+		const usz n = static_cast<usz>(w) * h;
+		std::vector<float> d(n);
+		for (usz i = 0; i < n; i++)
+		{
+			if (fmt == VK_FORMAT_D16_UNORM) { u16 v; std::memcpy(&v, raw + i * 2, 2); d[i] = v / 65535.0f; }
+			else if (fmt == VK_FORMAT_D24_UNORM_S8_UINT) { u32 v; std::memcpy(&v, raw + i * 4, 4); d[i] = (v & 0xFFFFFFu) / 16777215.0f; }
+			else { std::memcpy(&d[i], raw + i * 4, 4); }
+		}
+		lo = 1.0f; hi = 0.0f;
+		for (float v : d) { if (v < lo) lo = v; if (v > hi) hi = v; }
+		const float span = hi > lo ? hi - lo : 1.0f;
+		std::vector<u8> px(n);
+		for (usz i = 0; i < n; i++) px[i] = static_cast<u8>(std::clamp((d[i] - lo) / span, 0.0f, 1.0f) * 255.0f);
+		if (FILE* f = std::fopen(path.c_str(), "wb"))
+		{
+			std::fprintf(f, "P5\n%u %u\n255\n", w, h);
+			std::fwrite(px.data(), 1, n, f);
+			std::fclose(f);
+		}
+	}
+
+	bool pd_open_index()
+	{
+		auto& s = g_pd;
+		s.index = std::fopen((s.dir + "/passes.txt").c_str(), "w");
+		if (!s.index)
+		{
+			s.state = s.trigger.empty() ? 3 : 1;
+			return false;
+		}
+		if (s.draws_env)
+			s.draws_log = std::fopen((s.dir + "/draws.txt").c_str(), "w");
+		s.state = 2;
+		s.open = false;
+		s.pass = 0;
+		return true;
+	}
+
+	void pd_init()
+	{
+		auto& s = g_pd;
+		auto env = [](const char* n) -> const char* { const char* e = std::getenv(n); return e && *e ? e : nullptr; };
+		const char* d = env("RSX_ENGINE_PASS_DUMP");
+		s.state = d ? 1 : 3;
+		if (!d) return;
+		s.base = s.dir = d;
+		if (const char* m = env("RSX_ENGINE_PASS_DUMP_MINDRAWS")) s.min_draws = static_cast<u32>(std::strtoul(m, nullptr, 0));
+		if (const char* a = env("RSX_ENGINE_PASS_DUMP_AFTER")) s.after_s = static_cast<u32>(std::strtoul(a, nullptr, 0));
+		if (const char* x = env("RSX_ENGINE_PASS_DUMP_MAX")) s.max_passes = static_cast<u32>(std::strtoul(x, nullptr, 0));
+		if (const char* t = env("RSX_ENGINE_PASS_DUMP_TRIGGER")) s.trigger = t;
+		s.draws_env = !!env("RSX_ENGINE_PASS_DUMP_DRAWS");
+		s.start = std::time(nullptr);
+		std::printf("[r2rsx] pass dump enabled: %s%s%s\n", d, s.trigger.empty() ? "" : ", trigger file ", s.trigger.c_str());
+	}
+
+	// RSX_ENGINE_PASS_DUMP_TRIGGER: every 30 flips while idle, a trigger file names the next window's subdirectory.
+	void pd_trigger_poll()
+	{
+		auto& s = g_pd;
+		if (s.flips++ % 30u) return;
+		FILE* f = std::fopen(s.trigger.c_str(), "rb");
+		if (!f) return;
+		char buf[128]{};
+		const usz n = std::fread(buf, 1, sizeof(buf) - 1, f);
+		std::fclose(f);
+		std::remove(s.trigger.c_str());
+		std::string name;
+		for (usz i = 0; i < n; i++)
+		{
+			const char c = buf[i];
+			if ((c >= '0' && c <= '9') || (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || c == '-' || c == '_' || c == '.')
+				name += c;
+			else if (c == '\r' || c == '\n')
+				break;
+		}
+		if (name.empty() || name == "." || name == "..")
+			name = "trigger" + std::to_string(s.flips);
+		s.dir = s.base + "/" + name;
+		std::error_code ec;
+		std::filesystem::create_directories(s.dir, ec);
+		if (!pd_open_index()) return;
+		std::fprintf(s.index, "trigger '%s' at frame %u (after a frame of %u guest draws)\n", name.c_str(), s.frames + 1, s.frame_draws);
+		std::printf("[r2rsx] pass dump: trigger '%s', capturing into %s\n", name.c_str(), s.dir.c_str());
+	}
+
+	bool pd_capturing()
+	{
+		auto& s = g_pd;
+		if (s.state == 0) pd_init();
+		if (s.state == 1 && s.after_s && s.trigger.empty() &&
+			std::difftime(std::time(nullptr), s.start) >= static_cast<double>(s.after_s) && pd_open_index())
+		{
+			std::fprintf(s.index, "from a draw of frame %u, %u s in\n", s.frames, s.after_s);
+		}
+		return s.state == 2;
+	}
+}
+
+static pd_key r2pd_layout_key(const rsx::framebuffer_layout& l)
+{
+	pd_key k{};
+	for (u8 i : rsx::utility::get_rtt_indexes(l.target))
+		if (i < 4) k.c[i] = l.color_addresses[i];
+	k.z = l.zeta_address;
+	k.cfmt = static_cast<u32>(l.color_format);
+	k.zfmt = static_cast<u32>(l.depth_format);
+	k.aa = static_cast<u32>(l.aa_mode);
+	return k;
+}
+
+static void r2pd_barrier(const vk::command_buffer& cmd)
+{
+	VkMemoryBarrier mb{ VK_STRUCTURE_TYPE_MEMORY_BARRIER };
+	mb.srcAccessMask = VK_ACCESS_MEMORY_WRITE_BIT;
+	mb.dstAccessMask = VK_ACCESS_MEMORY_READ_BIT | VK_ACCESS_MEMORY_WRITE_BIT;
+	vkCmdPipelineBarrier(cmd, VK_PIPELINE_STAGE_ALL_COMMANDS_BIT, VK_PIPELINE_STAGE_ALL_COMMANDS_BIT, 0, 1, &mb, 0, nullptr, 0, nullptr);
+}
+
+// Record the copy of one image (expanded to its sample grid when multisampled) into a host-visible buffer.
+void VKGSRender::r2pd_record(r2pd_job& j, vk::viewable_image* img, u32 max_w, u32 max_h)
+{
+	if (!img || !img->value) return;
+	auto& cmd = *m_current_command_buffer;
+	j.depth = !!(img->aspect() & VK_IMAGE_ASPECT_DEPTH_BIT);
+	vk::image* src = img;
+
+	if (img->samples() > 1)
+	{
+		auto rt = dynamic_cast<vk::render_target*>(img);
+		if (!rt) return;
+		if ((rt->msaa_flags & rsx::surface_state_flags::require_unresolve) && rt->resolve_surface)
+		{
+			// The sample-grid copy is the newer data
+			src = rt->resolve_surface.get();
+		}
+		else
+		{
+			const u32 w = rt->width() * rt->samples_x, h = rt->height() * rt->samples_y;
+			const VkImageUsageFlags usage = VK_IMAGE_USAGE_TRANSFER_SRC_BIT | VK_IMAGE_USAGE_SAMPLED_BIT |
+				(j.depth ? VK_IMAGE_USAGE_DEPTH_STENCIL_ATTACHMENT_BIT : VK_IMAGE_USAGE_STORAGE_BIT);
+			j.tmp.reset(new vk::drawable_surface_t(*m_device, m_device->get_memory_mapping().device_local,
+				VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT, VK_IMAGE_TYPE_2D, rt->format(), w, h, 1, 1, 1,
+				VK_SAMPLE_COUNT_1_BIT, VK_IMAGE_LAYOUT_UNDEFINED, VK_IMAGE_TILING_OPTIMAL, usage, 0,
+				VMM_ALLOCATION_POOL_UNDEFINED, rt->format_class()));
+			r2pd_barrier(cmd);
+			if (!j.depth)
+			{
+				rt->push_layout(cmd, VK_IMAGE_LAYOUT_GENERAL);
+				j.tmp->change_layout(cmd, VK_IMAGE_LAYOUT_GENERAL);
+			}
+			else
+			{
+				rt->push_layout(cmd, VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL);
+				j.tmp->change_layout(cmd, VK_IMAGE_LAYOUT_DEPTH_STENCIL_ATTACHMENT_OPTIMAL);
+			}
+			vk::resolve_image(cmd, j.tmp.get(), rt);
+			rt->pop_layout(cmd);
+			src = j.tmp.get();
+		}
+	}
+
+	j.fmt = src->format();
+	const u32 bpp = texel_bytes(j.fmt, j.depth);
+	if (!bpp) return;
+	j.w = std::min(src->width(), max_w);
+	j.h = std::min(src->height(), max_h);
+	if (!j.w || !j.h) return;
+
+	j.buf = std::make_unique<vk::buffer>(*m_device, static_cast<u64>(j.w) * j.h * bpp,
+		m_device->get_memory_mapping().host_visible_coherent,
+		VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT | VK_MEMORY_PROPERTY_HOST_COHERENT_BIT,
+		VK_BUFFER_USAGE_TRANSFER_DST_BIT, 0, VMM_ALLOCATION_POOL_UNDEFINED);
+
+	r2pd_barrier(cmd);
+	src->push_layout(cmd, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL);
+	VkBufferImageCopy region{};
+	region.imageSubresource = { static_cast<VkImageAspectFlags>(j.depth ? VK_IMAGE_ASPECT_DEPTH_BIT : VK_IMAGE_ASPECT_COLOR_BIT), 0, 0, 1 };
+	region.imageExtent = { j.w, j.h, 1 };
+	vkCmdCopyImageToBuffer(cmd, src->value, src->current_layout, j.buf->value, 1, &region);
+	src->pop_layout(cmd);
+	r2pd_barrier(cmd);
+	j.ok = true;
+}
+
+// Execute the recorded copies (hard sync) and write the images.
+void VKGSRender::r2pd_finish(std::vector<r2pd_job>& jobs)
+{
+	if (jobs.empty()) return;
+	flush_command_queue(true);
+	for (auto& j : jobs)
+	{
+		if (j.ok)
+		{
+			const u32 bpp = texel_bytes(j.fmt, j.depth);
+			const u8* raw = static_cast<const u8*>(j.buf->map(0, static_cast<u64>(j.w) * j.h * bpp));
+			if (j.depth) write_pgm(j.path, raw, j.fmt, j.w, j.h, j.lo, j.hi);
+			else write_ppm(j.path, raw, j.fmt, j.w, j.h);
+			j.buf->unmap();
+		}
+		if (j.buf) vk::get_resource_manager()->dispose(j.buf);
+		if (j.tmp) vk::get_resource_manager()->dispose(j.tmp);
+	}
+}
+
+// Close the open pass: read back the currently bound targets (still the pass's own) unless told not to.
+void VKGSRender::r2pd_close_pass(bool readback)
+{
+	auto& s = g_pd;
+	if (!s.open) return;
+	char path[1024];
+	auto& sc = res()->surface_cache;
+	std::vector<r2pd_job> jobs;
+
+	std::string line = sfmt("pass %03u: draws %u clears %u", s.pass, s.draws, s.clears);
+	if (s.skipped) line += sfmt(" skipped %u", s.skipped);
+	line += " |";
+
+	{
+		u32 k = 0;
+		for (u8 index : m_draw_buffers)
+		{
+			auto rt = sc.m_bound_render_targets[index].second;
+			if (!rt || !readback) continue;
+			line += sfmt(" %c 0x%08X fmt %d %ux%u p%u", 'A' + static_cast<int>(k), local_offset(rt->base_addr),
+				static_cast<int>(rt->get_surface_color_format()), rt->template get_surface_width<rsx::surface_metrics::samples>(),
+				rt->template get_surface_height<rsx::surface_metrics::samples>(), rt->get_rsx_pitch());
+			if (readback)
+			{
+				if (vk::is_renderpass_open(*m_current_command_buffer)) close_render_pass();
+				auto& j = jobs.emplace_back();
+				std::snprintf(path, sizeof(path), "%s/pass%03u_t%u.ppm", s.dir.c_str(), s.pass, k);
+				j.path = path;
+				r2pd_record(j, rt, umax, umax);
+			}
+			k++;
+		}
+	}
+
+	auto ds = readback ? sc.m_bound_depth_stencil.second : nullptr;
+	if (ds)
+	{
+		if (vk::is_renderpass_open(*m_current_command_buffer)) close_render_pass();
+		auto& j = jobs.emplace_back();
+		std::snprintf(path, sizeof(path), "%s/pass%03u_z.pgm", s.dir.c_str(), s.pass);
+		j.path = path;
+		r2pd_record(j, ds, umax, umax);
+	}
+
+	r2pd_finish(jobs);
+
+	if (ds)
+	{
+		float lo = -1.f, hi = -1.f;
+		if (!jobs.empty() && jobs.back().depth) { lo = jobs.back().lo; hi = jobs.back().hi; }
+		const u32 w = ds->template get_surface_width<rsx::surface_metrics::samples>();
+		const u32 h = ds->template get_surface_height<rsx::surface_metrics::samples>();
+		line += sfmt(" | zeta 0x%08X p%u depth %.9g..%.9g (%ux%u, written %ux%u)", local_offset(ds->base_addr),
+			ds->get_rsx_pitch(), lo, hi, w, h, w, h);
+	}
+	if (!readback) line += " | (no readback: surface set changed without a rebind)";
+	std::fprintf(s.index, "%s |%s\n", line.c_str(), s.first.c_str());
+	std::fflush(s.index);
+	s.pass++;
+	s.open = false;
+	if (s.pass >= s.max_passes)
+	{
+		std::fprintf(s.index, "stopped after %u passes\n", s.pass);
+		std::fclose(s.index);
+		s.index = nullptr;
+		if (s.draws_log) { std::fclose(s.draws_log); s.draws_log = nullptr; }
+		s.state = s.trigger.empty() ? 3 : 1;
+		std::printf("[r2rsx] pass dump: %u passes written to %s\n", s.pass, s.dir.c_str());
+	}
+}
+
+void VKGSRender::r2pd_before_bind()
+{
+	if (g_pd.state == 3 || !pd_capturing() || !g_pd.open) return;
+	if (!(r2pd_layout_key(m_ctx->fb.layout) == g_pd.key))
+		r2pd_close_pass(true);
+}
+
+void VKGSRender::r2pd_note(int kind)
+{
+	auto& s = g_pd;
+	if (s.state == 3) return;
+	if (kind != 2) s.frame_draws++;
+	if (!pd_capturing()) return;
+
+	const pd_key key = r2pd_layout_key(m_ctx->fb.layout);
+	if (s.open && !(key == s.key))
+		r2pd_close_pass(false);
+	if (s.state != 2) return;
+	if (!s.open)
+	{
+		s.open = true;
+		s.key = key;
+		s.draws = s.clears = s.skipped = 0;
+		s.first.clear();
+	}
+
+	const auto& r = REGS(m_ctx)->registers;
+	const u32 surf_fmt = r[NV4097_SET_SURFACE_FORMAT];
+	const u32 cfmt = surf_fmt & 0x1Fu, zfmt = (surf_fmt >> 5) & 0x7u, aa = (surf_fmt >> 12) & 0xFu;
+
+	if (kind == 2)
+	{
+		auto& sc = res()->surface_cache;
+		const u32 h = r[NV4097_SET_SCISSOR_HORIZONTAL], v = r[NV4097_SET_SCISSOR_VERTICAL];
+		const u32 zfloat = (r[0x03B0 >> 2] >> 12) & 1u;
+		const u32 mask = m_ctx->draw_state.clear.mask;
+		s.clears++;
+		const std::string info = sfmt(
+			"mask 0x%02X zs 0x%08X smask 0x%02X zfmt %u%s aa %u tgt 0x%02X z %u:0x%08X p%u c0 0x%08X p%u zlive %u clive %u ds %X ch %X",
+			r[NV4097_CLEAR_SURFACE] & 0xFFu, r[NV4097_SET_ZSTENCIL_CLEAR_VALUE], r[NV4097_SET_STENCIL_MASK] & 0xFFu, zfmt,
+			zfloat ? "f" : "", aa, r[NV4097_SET_SURFACE_COLOR_TARGET] & 0xFFu, r[NV4097_SET_CONTEXT_DMA_ZETA] & 1u,
+			r[NV4097_SET_SURFACE_ZETA_OFFSET], r[NV4097_SET_SURFACE_PITCH_Z], r[NV4097_SET_SURFACE_COLOR_AOFFSET],
+			r[NV4097_SET_SURFACE_PITCH_A], sc.m_bound_depth_stencil.second ? 1u : 0u, m_draw_buffers.empty() ? 0u : 1u,
+			mask & 3u, (mask >> 4) & 0xFu);
+		s.first += sfmt(" [clear after %u draws, scissor %u,%u %ux%u, %s]", s.draws, h & 0xFFFFu, v & 0xFFFFu, h >> 16, v >> 16, info.c_str());
+		if (s.draws_log)
+			std::fprintf(s.draws_log, "pass %03u clear after %u draws: %s\n", s.pass, s.draws, info.c_str());
+		return;
+	}
+
+	const auto regs = REGS(m_ctx);
+	const u32 pipe = r[NV4097_SET_SHADER_PROGRAM];
+	const u32 sfac = r[NV4097_SET_BLEND_FUNC_SFACTOR], dfac = r[NV4097_SET_BLEND_FUNC_DFACTOR];
+	const u32 cmask = r[NV4097_SET_COLOR_MASK];
+	const u32 blend = r[NV4097_SET_BLEND_ENABLE] & 1u, dt = r[NV4097_SET_DEPTH_TEST_ENABLE] & 1u;
+	const u32 dw = r[NV4097_SET_DEPTH_MASK] & 1u, at = r[NV4097_SET_ALPHA_TEST_ENABLE] & 1u;
+
+	if (s.draws_log)
+	{
+		std::string l = sfmt("pass %03u draw %u: pipe %u cmask %08X blend %u %X/%X dt %u dw %u at %u |",
+			s.pass, s.draws + s.skipped, pipe, cmask, blend, sfac & 0xFFFFu, dfac & 0xFFFFu, dt, dw, at);
+		for (u32 mask = m_ctx->program.fp_metadata.referenced_textures_mask, i = 0; mask; mask >>= 1, ++i)
+		{
+			if (!(mask & 1)) continue;
+			const auto& t = regs->fragment_textures[i];
+			if (!t.enabled()) continue;
+			l += sfmt(" t%u %u:0x%08X f%02X %ux%u", i, t.location(), t.offset(), t.format(), t.width(), t.height());
+		}
+		if (kind == 1) l += " skipped (program not ready)";
+		std::fprintf(s.draws_log, "%s\n", l.c_str());
+	}
+	if (kind == 1) { s.skipped++; return; }
+	if (s.draws++) return;
+
+	const u32 ch = r[NV4097_SET_SURFACE_CLIP_HORIZONTAL], cv = r[NV4097_SET_SURFACE_CLIP_VERTICAL];
+	s.first += sfmt(" rt_sel %u cfmt %u zfmt %u clip %ux%u | pipe %u dt %u dw %u df %u cmask %08X blend %u %X/%X stencil %u vpz %g+%g |",
+		r[NV4097_SET_SURFACE_COLOR_TARGET], cfmt, zfmt, ch >> 16, cv >> 16, pipe, dt, dw, r[NV4097_SET_DEPTH_FUNC], cmask,
+		blend, sfac & 0xFFFFu, dfac & 0xFFFFu, r[NV4097_SET_STENCIL_TEST_ENABLE] & 1u,
+		as_float(r[NV4097_SET_VIEWPORT_SCALE + 2]), as_float(r[NV4097_SET_VIEWPORT_OFFSET + 2]));
+	for (u32 mask = m_ctx->program.fp_metadata.referenced_textures_mask, i = 0; mask; mask >>= 1, ++i)
+	{
+		if (!(mask & 1)) continue;
+		const auto& t = regs->fragment_textures[i];
+		if (!t.enabled()) continue;
+		const u32 addr = rsx::get_address(m_ctx, t.offset(), t.location());
+		const char* src = "G";
+		if (auto surf = res()->surface_cache.get_surface_at(addr))
+			src = surf->is_depth_surface() ? "Z" : "S";
+		s.first += sfmt(" t%u %u:0x%08X f%02X %ux%u p%u%s r%04X zf%u %s", i, t.location(), t.offset(), t.format(),
+			t.width(), t.height(), t.pitch(), t.cubemap() ? " cube" : "", t.remap() & 0xFFFFu,
+			r[NV4097_SET_TEXTURE_ADDRESS + i * 8] >> 28, src);
+	}
+}
+
+void VKGSRender::r2pd_present(vk::viewable_image* image, u32 offset, u32 width, u32 height)
+{
+	auto& s = g_pd;
+	if (s.state == 3) return;
+	if (s.state == 0) pd_capturing();
+
+	if (s.state == 1 && !s.trigger.empty())
+	{
+		pd_trigger_poll();
+	}
+	else if (s.state == 1 && !s.after_s && s.frame_draws >= s.min_draws)
+	{
+		if (pd_open_index())
+			std::fprintf(s.index, "frame %u (after a frame of %u guest draws)\n", s.frames + 1, s.frame_draws);
+	}
+	else if (s.state == 2)
+	{
+		r2pd_close_pass(true);
+		if (s.state == 2)
+		{
+			char path[1024];
+			std::snprintf(path, sizeof(path), "%s/present%03u.ppm", s.dir.c_str(), s.pass);
+			std::vector<r2pd_job> jobs;
+			if (image && image->samples() == 1)
+			{
+				if (vk::is_renderpass_open(*m_current_command_buffer)) close_render_pass();
+				auto& j = jobs.emplace_back();
+				j.path = path;
+				r2pd_record(j, image, width, height);
+			}
+			r2pd_finish(jobs);
+			std::fprintf(s.index, "present%03u: surface 0 0x%08X, %u guest draws\n", s.pass, offset, s.frame_draws);
+			std::fflush(s.index);
+		}
+	}
+	s.frames++;
+	s.frame_draws = 0;
+}
diff --git a/rpcs3/Emu/RSX/VK/VKR2PcExtras.cpp b/rpcs3/Emu/RSX/VK/VKR2PcExtras.cpp
new file mode 100644
index 0000000..3963289
--- /dev/null
+++ b/rpcs3/Emu/RSX/VK/VKR2PcExtras.cpp
@@ -0,0 +1,322 @@
+// R2PORT PC extras (not upstream RPCS3): HDR output, colour-blind filter, NVIDIA Reflex.
+//
+//  * HDR (R2_HDR=0 / auto / 1 HDR10 / scrgb, R2_HDR_PAPER nits, R2_HDR_PEAK nits, R2_HDR_SAT 0..2;
+//    PORT_HDR* too -- settings, Windows HDR detection and the shader code are in VKR2Hdr.cpp):
+//    VK_EXT_swapchain_colorspace picks an A2B10G10R10 + ST2084 (HDR10) or RGBA16F +
+//    extended-sRGB-linear (scRGB) swapchain, as SpecialK does on DXGI. The final present pass
+//    (video_out_calibration_pass) keeps the SDR image at paper white, expands only the highlights
+//    towards the display peak, and encodes PQ / scRGB. VK_EXT_hdr_metadata sends the
+//    mastering metadata. Windows HDR off or no HDR swapchain format -> SDR, logged.
+//  * Colour-blind filter (R2_COLORBLIND=1/2/3, live via g_pc_cvd_mode): daltonization in the same pass.
+//  * Reflex (R2_REFLEX=1, 2 = boost): VK_NV_low_latency2 sleep mode on the swapchain and a
+//    vkLatencySleepNV at the start of each game frame (r2pc_reflex_sleep, called by the game's
+//    frame limiter). minimumIntervalUs stays 0: the game's own limiter remains the only limiter.
+//  Overlays RPCS3 draws after the present pass (none in normal play) stay SDR-encoded.
+
+#include "stdafx.h"
+#include "VKR2PcExtras.h"
+#include "VKR2Hdr.h"
+#include "VKR2FrameGen.h" // R2PORT frame generation
+
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <mutex>
+
+extern "C"
+{
+	volatile int g_pc_cvd_mode = 0;
+	volatile int g_pc_hdr_active = 0;
+	volatile int g_pc_reflex_active = 0;
+}
+
+namespace
+{
+	const char* penv(const char* name)
+	{
+		for (const char* pre : { "R2_", "R3_", "R1_" })
+		{
+			char full[96];
+			std::snprintf(full, sizeof(full), "%s%s", pre, name);
+			const char* e = std::getenv(full);
+			if (e && *e) return e;
+		}
+		return nullptr;
+	}
+	int penv_int(const char* name, int def) { const char* e = penv(name); return e ? std::atoi(e) : def; }
+
+	// 0 off, 1 HDR10, 2 scRGB (VKR2Hdr: R2_/R3_/R1_HDR, else PORT_HDR; auto counts as HDR10 here)
+	int hdr_request()
+	{
+		return r2hdr::request();
+	}
+	int reflex_request()
+	{
+		if (vk::r2fg_owns_reflex()) return 0; // Streamline drives Reflex for frame generation
+		static int r = -1;
+		if (r < 0) r = std::max(0, std::min(2, penv_int("REFLEX", 0)));
+		return r;
+	}
+
+	struct pc_state
+	{
+		std::mutex mu;
+		VkDevice dev = VK_NULL_HANDLE;
+		VkSwapchainKHR swapchain = VK_NULL_HANDLE;
+		bool hdr_metadata_ext = false;
+		bool low_latency_ext = false;
+		VkSemaphore timeline = VK_NULL_HANDLE;
+		uint64_t value = 0;
+		PFN_vkSetLatencySleepModeNV set_sleep_mode = nullptr;
+		PFN_vkLatencySleepNV sleep = nullptr;
+		PFN_vkWaitSemaphores wait = nullptr;
+		PFN_vkSetHdrMetadataEXT set_hdr = nullptr;
+	} g_pc;
+
+	void log(const char* fmt, const char* a = "", int b = 0)
+	{
+		std::fprintf(stderr, "[pcx-vk] ");
+		std::fprintf(stderr, fmt, a, b);
+		std::fputc('\n', stderr);
+	}
+}
+
+extern "C" int r2pc_post_active(void)
+{
+	return g_pc_hdr_active || g_pc_cvd_mode;
+}
+
+extern "C" void r2pc_reflex_sleep(void)
+{
+	if (r2fg_game_frame()) return; // R2PORT frame generation: Reflex sleep + markers through Streamline
+	if (!g_pc_reflex_active) return;
+	VkDevice dev;
+	uint64_t v;
+	{
+		std::lock_guard lk(g_pc.mu);
+		if (!g_pc.swapchain || !g_pc.timeline || !g_pc.sleep) return;
+		dev = g_pc.dev;
+		v = ++g_pc.value;
+		VkLatencySleepInfoNV si{ .sType = VK_STRUCTURE_TYPE_LATENCY_SLEEP_INFO_NV, .signalSemaphore = g_pc.timeline, .value = v };
+		if (g_pc.sleep(dev, g_pc.swapchain, &si) != VK_SUCCESS) return;
+	}
+	VkSemaphoreWaitInfo wi{ .sType = VK_STRUCTURE_TYPE_SEMAPHORE_WAIT_INFO, .semaphoreCount = 1, .pSemaphores = &g_pc.timeline, .pValues = &v };
+	g_pc.wait(dev, &wi, 50'000'000ull); // 50 ms at most: never hold the game up for long
+}
+
+namespace vk
+{
+	void r2pc_extend_instance(std::vector<const char*>& extensions)
+	{
+		if (!hdr_request()) return;
+		u32 count = 0;
+		vkEnumerateInstanceExtensionProperties(nullptr, &count, nullptr);
+		std::vector<VkExtensionProperties> props(count);
+		vkEnumerateInstanceExtensionProperties(nullptr, &count, props.data());
+		for (const auto& p : props)
+		{
+			if (std::strcmp(p.extensionName, VK_EXT_SWAPCHAIN_COLOR_SPACE_EXTENSION_NAME) == 0)
+			{
+				for (const char* e : extensions) if (std::strcmp(e, VK_EXT_SWAPCHAIN_COLOR_SPACE_EXTENSION_NAME) == 0) return;
+				extensions.push_back(VK_EXT_SWAPCHAIN_COLOR_SPACE_EXTENSION_NAME);
+				return;
+			}
+		}
+		log("HDR: %sthe Vulkan driver has no VK_EXT_swapchain_colorspace; SDR output");
+	}
+
+	void r2pc_pick_surface_format(const std::vector<VkSurfaceFormatKHR>& formats, VkFormat& format, VkColorSpaceKHR& color_space)
+	{
+		g_pc_hdr_active = 0;
+		const int want = hdr_request();
+		if (!want) return;
+		if (!r2hdr::allowed())
+		{
+			log(r2hdr::display_hdr() == 0 ? "HDR%s: Windows HDR is off for this display; SDR output"
+			                              : "HDR%s: the display's HDR state is unknown; SDR output", r2hdr::is_auto() ? " (auto)" : "");
+			return;
+		}
+		auto find = [&](std::initializer_list<VkFormat> fmts, VkColorSpaceKHR cs) -> bool
+		{
+			for (VkFormat f : fmts)
+				for (const auto& sf : formats)
+					if (sf.format == f && sf.colorSpace == cs) { format = f; color_space = cs; return true; }
+			return false;
+		};
+		const auto hdr10 = [&] { return find({ VK_FORMAT_A2B10G10R10_UNORM_PACK32, VK_FORMAT_A2R10G10B10_UNORM_PACK32 }, VK_COLOR_SPACE_HDR10_ST2084_EXT); };
+		const auto scrgb = [&] { return find({ VK_FORMAT_R16G16B16A16_SFLOAT }, VK_COLOR_SPACE_EXTENDED_SRGB_LINEAR_EXT); };
+		if (want == 2) g_pc_hdr_active = scrgb() ? 2 : hdr10() ? 1 : 0;
+		else g_pc_hdr_active = hdr10() ? 1 : scrgb() ? 2 : 0;
+		if (g_pc_hdr_active)
+			std::fprintf(stderr, "[pcx-vk] HDR output%s: %s swapchain (format %d), paper white %.0f nits, peak %.0f nits (%s), saturation %.2f\n",
+				r2hdr::is_auto() ? " (auto)" : "", g_pc_hdr_active == 1 ? "HDR10 / PQ" : "scRGB", static_cast<int>(format),
+				r2hdr::paper(), r2hdr::peak(), r2hdr::peak_source(), r2hdr::sat());
+		else log("HDR: %sno HDR swapchain format on this display (is Windows HDR on?); SDR output");
+	}
+
+	void r2pc_extend_device(VkPhysicalDevice pdev, std::vector<const char*>& extensions,
+		VkPhysicalDeviceVulkan12Features& vulkan12, VkDeviceCreateInfo& info)
+	{
+		if (!hdr_request() && !reflex_request()) return;
+		u32 count = 0;
+		vkEnumerateDeviceExtensionProperties(pdev, nullptr, &count, nullptr);
+		std::vector<VkExtensionProperties> props(count);
+		vkEnumerateDeviceExtensionProperties(pdev, nullptr, &count, props.data());
+		auto supported = [&](const char* name)
+		{
+			for (const auto& p : props) if (std::strcmp(p.extensionName, name) == 0) return true;
+			return false;
+		};
+		auto push = [&](const char* name)
+		{
+			for (const char* e : extensions) if (std::strcmp(e, name) == 0) return;
+			extensions.push_back(name);
+		};
+		if (hdr_request() && supported(VK_EXT_HDR_METADATA_EXTENSION_NAME))
+		{
+			push(VK_EXT_HDR_METADATA_EXTENSION_NAME);
+			g_pc.hdr_metadata_ext = true;
+		}
+		if (reflex_request())
+		{
+			VkPhysicalDeviceVulkan12Features v12{ .sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_VULKAN_1_2_FEATURES };
+			VkPhysicalDeviceFeatures2 f2{ .sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_FEATURES_2, .pNext = &v12 };
+			vkGetPhysicalDeviceFeatures2(pdev, &f2);
+			if (supported(VK_NV_LOW_LATENCY_2_EXTENSION_NAME) && v12.timelineSemaphore)
+			{
+				push(VK_NV_LOW_LATENCY_2_EXTENSION_NAME);
+				vulkan12.timelineSemaphore = VK_TRUE;
+				g_pc.low_latency_ext = true;
+				log("Reflex: VK_NV_low_latency2 enabled%s", reflex_request() == 2 ? " (boost)" : "");
+			}
+			else log("Reflex: %sVK_NV_low_latency2 not available (NVIDIA driver 535+ needed); off");
+		}
+		info.enabledExtensionCount = static_cast<u32>(extensions.size());
+		info.ppEnabledExtensionNames = extensions.data();
+	}
+
+	void r2pc_swapchain_pre_create(VkSwapchainCreateInfoKHR& info)
+	{
+		if (!g_pc.low_latency_ext) return;
+		static VkSwapchainLatencyCreateInfoNV lci{ .sType = VK_STRUCTURE_TYPE_SWAPCHAIN_LATENCY_CREATE_INFO_NV };
+		lci.pNext = info.pNext;
+		lci.latencyModeEnable = VK_TRUE;
+		info.pNext = &lci;
+	}
+
+	void r2pc_swapchain_created(VkDevice dev, VkSwapchainKHR swapchain)
+	{
+		std::lock_guard lk(g_pc.mu);
+		if (!swapchain)
+		{
+			if (g_pc.timeline && g_pc.dev) vkDestroySemaphore(g_pc.dev, g_pc.timeline, nullptr);
+			g_pc.timeline = VK_NULL_HANDLE;
+			g_pc.swapchain = VK_NULL_HANDLE;
+			g_pc_reflex_active = 0;
+			return;
+		}
+		g_pc.dev = dev;
+		g_pc.swapchain = swapchain;
+
+		if (g_pc_hdr_active && g_pc.hdr_metadata_ext)
+		{
+			if (!g_pc.set_hdr) g_pc.set_hdr = reinterpret_cast<PFN_vkSetHdrMetadataEXT>(vkGetDeviceProcAddr(dev, "vkSetHdrMetadataEXT"));
+			if (g_pc.set_hdr)
+			{
+				const float peak = r2hdr::peak(), paper = r2hdr::paper();
+				VkHdrMetadataEXT md{ .sType = VK_STRUCTURE_TYPE_HDR_METADATA_EXT };
+				// Rec.2020 primaries for HDR10, Rec.709 for scRGB; D65 white
+				if (g_pc_hdr_active == 1) { md.displayPrimaryRed = { 0.708f, 0.292f }; md.displayPrimaryGreen = { 0.170f, 0.797f }; md.displayPrimaryBlue = { 0.131f, 0.046f }; }
+				else { md.displayPrimaryRed = { 0.640f, 0.330f }; md.displayPrimaryGreen = { 0.300f, 0.600f }; md.displayPrimaryBlue = { 0.150f, 0.060f }; }
+				md.whitePoint = { 0.3127f, 0.3290f };
+				md.maxLuminance = peak;
+				md.minLuminance = 0.001f;
+				md.maxContentLightLevel = peak;
+				md.maxFrameAverageLightLevel = paper;
+				if (!vk::r2fg_set_hdr_metadata(dev, swapchain, &md)) g_pc.set_hdr(dev, 1, &swapchain, &md); // R2PORT FSR 3 swapchain
+			}
+		}
+
+		if (g_pc.low_latency_ext)
+		{
+			if (!g_pc.sleep)
+			{
+				g_pc.set_sleep_mode = reinterpret_cast<PFN_vkSetLatencySleepModeNV>(vkGetDeviceProcAddr(dev, "vkSetLatencySleepModeNV"));
+				g_pc.sleep = reinterpret_cast<PFN_vkLatencySleepNV>(vkGetDeviceProcAddr(dev, "vkLatencySleepNV"));
+				g_pc.wait = reinterpret_cast<PFN_vkWaitSemaphores>(vkGetDeviceProcAddr(dev, "vkWaitSemaphores"));
+			}
+			if (!g_pc.timeline)
+			{
+				VkSemaphoreTypeCreateInfo ti{ .sType = VK_STRUCTURE_TYPE_SEMAPHORE_TYPE_CREATE_INFO, .semaphoreType = VK_SEMAPHORE_TYPE_TIMELINE, .initialValue = 0 };
+				VkSemaphoreCreateInfo ci{ .sType = VK_STRUCTURE_TYPE_SEMAPHORE_CREATE_INFO, .pNext = &ti };
+				if (vkCreateSemaphore(dev, &ci, nullptr, &g_pc.timeline) != VK_SUCCESS) g_pc.timeline = VK_NULL_HANDLE;
+				g_pc.value = 0;
+			}
+			VkLatencySleepModeInfoNV mode{ .sType = VK_STRUCTURE_TYPE_LATENCY_SLEEP_MODE_INFO_NV };
+			mode.lowLatencyMode = VK_TRUE;
+			mode.lowLatencyBoost = reflex_request() == 2 ? VK_TRUE : VK_FALSE;
+			mode.minimumIntervalUs = 0; // not a limiter: the game's frame limiter stays in charge
+			const bool ok = g_pc.set_sleep_mode && g_pc.sleep && g_pc.wait && g_pc.timeline &&
+				g_pc.set_sleep_mode(dev, swapchain, &mode) == VK_SUCCESS;
+			g_pc_reflex_active = ok ? 1 : 0;
+			if (!ok) log("Reflex: %scould not set the latency sleep mode; off");
+		}
+	}
+
+	std::string r2pc_patch_calibration_fs(const std::string& src)
+	{
+		static const std::string funcs = std::string(R"(
+// R2PORT PC extras: colour-blind filter and SDR -> HDR (PQ / scRGB). Parameters ride in
+// right_anaglyph_matrix when stereo is off: [0] = (hdr mode, cvd mode, saturation), [1] = (paper nits, peak nits).
+vec3 r2pc_cvd(vec3 c, int m)
+{
+	const mat3 rgb2lms = mat3(17.8824, 3.45565, 0.0299566, 43.5161, 27.1554, 0.184309, 4.11935, 3.86714, 1.46709);
+	const mat3 lms2rgb = mat3(0.0809444479, -0.0102485335, -0.000365296938, -0.130504409, 0.0540193266, -0.00412161469,
+		0.116721066, -0.113614708, 0.693511405);
+	vec3 lms = rgb2lms * c;
+	vec3 s = lms;
+	if (m == 1) s.x = 2.02344 * lms.y - 2.52581 * lms.z;
+	else if (m == 2) s.y = 0.494207 * lms.x + 1.24827 * lms.z;
+	else s.z = -0.395913 * lms.x + 0.801109 * lms.y;
+	vec3 err = c - lms2rgb * s;
+	return clamp(c + vec3(0.0, 0.7 * err.r + err.g, 0.7 * err.r + err.b), 0.0, 1.0);
+}
+)") + r2hdr::glsl() + R"(
+vec4 r2pc_post(vec4 o)
+{
+	if (stereo_display_mode != STEREO_MODE_DISABLED) return o;
+	const int hdr = int(right_anaglyph_matrix[0].x + 0.5);
+	const int cvd = int(right_anaglyph_matrix[0].y + 0.5);
+	vec3 c = o.rgb;
+	if (cvd > 0) c = r2pc_cvd(c, cvd);
+	if (hdr > 0) c = r2pc_hdr(c, gl_FragCoord.xy, hdr, right_anaglyph_matrix[1].x, right_anaglyph_matrix[1].y, right_anaglyph_matrix[0].z);
+	return vec4(c, o.a);
+}
+
+void main()
+)";
+		std::string out = src;
+		const auto m = out.find("void main()");
+		const auto a = out.find("ocol.a = 1.f;");
+		if (m == std::string::npos || a == std::string::npos || a < m)
+		{
+			log("colour filter / HDR: %sthe present shader changed; PC post code not added");
+			return src;
+		}
+		out.replace(a, std::strlen("ocol.a = 1.f;"), "ocol.a = 1.f;\n\tocol = r2pc_post(ocol);");
+		out.replace(m, std::strlen("void main()"), funcs);
+		return out;
+	}
+
+	void r2pc_calibration_params(float* col0, float* col1, bool stereo)
+	{
+		if (stereo) return;
+		const bool hdr = g_pc_hdr_active != 0;   // the HDR settings (and DXGI) are only read once HDR is on
+		col0[0] = static_cast<float>(g_pc_hdr_active);
+		col0[1] = static_cast<float>(g_pc_cvd_mode);
+		col0[2] = hdr ? r2hdr::sat() : 0.f;
+		col1[0] = hdr ? r2hdr::paper() : 203.f;
+		col1[1] = hdr ? r2hdr::peak() : 203.f;
+		col1[2] = 0.f;
+	}
+}
diff --git a/rpcs3/Emu/RSX/VK/VKR2PcExtras.h b/rpcs3/Emu/RSX/VK/VKR2PcExtras.h
new file mode 100644
index 0000000..9fd8000
--- /dev/null
+++ b/rpcs3/Emu/RSX/VK/VKR2PcExtras.h
@@ -0,0 +1,27 @@
+// R2PORT PC extras: HDR output, colour-blind filter and NVIDIA Reflex for the Vulkan present path.
+// All of it is off unless asked for (R2_HDR / R2_COLORBLIND / R2_REFLEX, or the R3_ names).
+#pragma once
+#include "VulkanAPI.h"
+#include <string>
+#include <vector>
+
+extern "C"
+{
+	extern volatile int g_pc_cvd_mode;      // 0 off, 1 protanopia, 2 deuteranopia, 3 tritanopia (live)
+	extern volatile int g_pc_hdr_active;    // 0 SDR, 1 HDR10 (PQ), 2 scRGB
+	extern volatile int g_pc_reflex_active; // VK_NV_low_latency2 sleep mode is on
+	int r2pc_post_active(void);             // the final pass must run the PC post code
+	void r2pc_reflex_sleep(void);           // the game's frame start (Reflex sleep); no-op when off
+}
+
+namespace vk
+{
+	void r2pc_extend_instance(std::vector<const char*>& extensions);
+	void r2pc_pick_surface_format(const std::vector<VkSurfaceFormatKHR>& formats, VkFormat& format, VkColorSpaceKHR& color_space);
+	void r2pc_extend_device(VkPhysicalDevice pdev, std::vector<const char*>& extensions,
+		VkPhysicalDeviceVulkan12Features& vulkan12, VkDeviceCreateInfo& info);
+	void r2pc_swapchain_pre_create(VkSwapchainCreateInfoKHR& info);
+	void r2pc_swapchain_created(VkDevice dev, VkSwapchainKHR swapchain);
+	std::string r2pc_patch_calibration_fs(const std::string& src);
+	void r2pc_calibration_params(float* col0, float* col1, bool stereo);
+}
diff --git a/rpcs3/Emu/RSX/VK/VKR2Pipe.cpp b/rpcs3/Emu/RSX/VK/VKR2Pipe.cpp
new file mode 100644
index 0000000..f6a4121
--- /dev/null
+++ b/rpcs3/Emu/RSX/VK/VKR2Pipe.cpp
@@ -0,0 +1,157 @@
+#include "stdafx.h"
+#include "VKR2Pipe.h"
+#include "Emu/RSX/port_r2pipe.h"
+#include "Emu/RSX/port_r2memo.h"
+#include "../../../../../../include/ps3emu/port_hitch.h" // R2PORT: [hitch] logger
+
+#include <atomic>
+#include <chrono>
+#include <cstdio>
+#include <mutex>
+
+namespace vk::r2pipe
+{
+	namespace
+	{
+		std::atomic<u64> g_counters[c_count]{};
+		std::atomic<int> g_queue{ 0 };
+		std::atomic<u32> g_bg_done{ 0 };
+		std::atomic<u32> g_bg_total{ 0 };
+
+		std::mutex g_lock;
+		::r2pipe::stall_window g_window;
+		::r2pipe::report_timer g_timer;
+		u64 g_last_counters[c_count]{};
+
+		thread_local int t_scope_depth = 0;
+		thread_local bool t_render_thread = false;
+		thread_local bool t_work = false;
+
+		u64 take_delta(counter c)
+		{
+			const u64 v = g_counters[c].load(std::memory_order_relaxed);
+			const u64 d = v - g_last_counters[c];
+			g_last_counters[c] = v;
+			return d;
+		}
+	}
+
+	bool log_enabled()
+	{
+		static const bool on = r2memo::env_switch("R2_PIPE_LOG", true);
+		return on;
+	}
+
+	u64 now_ns()
+	{
+		return static_cast<u64>(std::chrono::duration_cast<std::chrono::nanoseconds>(
+			std::chrono::steady_clock::now().time_since_epoch()).count());
+	}
+
+	void add(counter c, u32 n)
+	{
+		g_counters[c].fetch_add(n, std::memory_order_relaxed);
+	}
+
+	void queue_delta(int delta)
+	{
+		g_queue.fetch_add(delta, std::memory_order_relaxed);
+	}
+
+	void set_bg_preload(u32 done, u32 total)
+	{
+		g_bg_done.store(done, std::memory_order_relaxed);
+		g_bg_total.store(total, std::memory_order_relaxed);
+	}
+
+	void note_stall_ns(u64 ns)
+	{
+		if (t_render_thread) port_hitch_add_ns(PH_PIPE, ns); // R2PORT: [hitch]
+		if (!log_enabled() || !t_render_thread) return;
+		std::lock_guard lock(g_lock);
+		g_window.add_stall(static_cast<double>(ns) / 1e6);
+	}
+
+	render_scope::render_scope()
+	{
+		t_render_thread = true;
+		if (t_scope_depth++ == 0) t_work = false;
+	}
+
+	render_scope::~render_scope()
+	{
+		t_scope_depth--;
+	}
+
+	bool in_render_scope() { return t_scope_depth > 0; }
+	bool is_render_thread() { return t_render_thread; }
+	void note_work() { if (t_scope_depth > 0) t_work = true; }
+
+	void note_shader_compile()
+	{
+		if (t_scope_depth > 0)
+		{
+			add(c_shader_compile);
+			t_work = true;
+		}
+	}
+
+	bool take_work()
+	{
+		const bool w = t_work;
+		t_work = false;
+		return w;
+	}
+
+	inline_timer::inline_timer()
+	{
+		if (t_render_thread && t_scope_depth == 0 && log_enabled()) t0 = now_ns();
+	}
+
+	inline_timer::~inline_timer()
+	{
+		if (!t0) return;
+		add(c_inline_other);
+		note_stall_ns(now_ns() - t0);
+	}
+
+	void on_flip()
+	{
+		if (!log_enabled()) return;
+		const u64 now = now_ns();
+
+		::r2pipe::stall_window w;
+		{
+			std::lock_guard lock(g_lock);
+			g_window.end_frame();
+			if (!g_timer.due(now)) return;
+			w = g_window;
+			g_window.reset();
+		}
+
+		u64 d[c_count];
+		for (int i = 0; i < c_count; ++i) d[i] = take_delta(static_cast<counter>(i));
+
+		const u32 bg_total = g_bg_total.load(std::memory_order_relaxed);
+		char bg[48] = "";
+		if (bg_total) std::snprintf(bg, sizeof(bg), " bg-preload %u/%u", g_bg_done.load(std::memory_order_relaxed), bg_total);
+
+		// R2PORT: queued to a writer thread -- a printf + fflush here (render thread, inside present) cost a ~21 ms frame every 5 s
+		port_log_async(0, "[pipe] %llu frames: stall %.1f ms (%.2f ms/frame, worst frame %.1f ms, worst wait %.1f ms, %llu frames >=2 ms) "
+			"| waits>2ms 2-4:%llu 4-8:%llu 8-16:%llu 16-33:%llu >33:%llu "
+			"| new %llu skipped-draws %llu shaders %llu sync %llu async %llu other %llu "
+			"| gpl fast-link %llu+%llu libs %llu optimised %llu fallback %llu | queue %d%s\n",
+			static_cast<unsigned long long>(w.frames), w.total_ms, w.per_frame_ms(), w.worst_frame_ms, w.worst_stall_ms,
+			static_cast<unsigned long long>(w.frames_with_stall),
+			static_cast<unsigned long long>(w.hist[0]), static_cast<unsigned long long>(w.hist[1]),
+			static_cast<unsigned long long>(w.hist[2]), static_cast<unsigned long long>(w.hist[3]),
+			static_cast<unsigned long long>(w.hist[4]),
+			static_cast<unsigned long long>(d[c_new_pipeline]), static_cast<unsigned long long>(d[c_skipped_draw]),
+			static_cast<unsigned long long>(d[c_shader_compile]), static_cast<unsigned long long>(d[c_sync_link]),
+			static_cast<unsigned long long>(d[c_async_link]), static_cast<unsigned long long>(d[c_inline_other]),
+			static_cast<unsigned long long>(d[c_fast_link_inline]), static_cast<unsigned long long>(d[c_fast_link_worker]),
+			static_cast<unsigned long long>(d[c_gpl_library]), static_cast<unsigned long long>(d[c_opt_swap]),
+			static_cast<unsigned long long>(d[c_gpl_fallback]),
+			g_queue.load(std::memory_order_relaxed), bg);
+	}
+}
diff --git a/rpcs3/Emu/RSX/VK/VKR2Pipe.h b/rpcs3/Emu/RSX/VK/VKR2Pipe.h
new file mode 100644
index 0000000..41cee9c
--- /dev/null
+++ b/rpcs3/Emu/RSX/VK/VKR2Pipe.h
@@ -0,0 +1,59 @@
+#pragma once
+
+// R2PORT pipeline-stutter instrumentation (R2_PIPE_LOG, default on): time the render thread spends waiting on
+// pipeline / shader creation, printed as a [pipe] line every 5 s. Pure logic lives in Emu/RSX/port_r2pipe.h.
+
+#include "util/types.hpp"
+
+namespace vk::r2pipe
+{
+	enum counter : int
+	{
+		c_new_pipeline,      // pipelines requested by the render thread (play-time cache misses)
+		c_skipped_draw,      // draws skipped because their pipeline was still compiling (async mode)
+		c_shader_compile,    // vertex/fragment programs decompiled + compiled to SPIR-V on the render thread
+		c_sync_link,         // monolithic pipelines built on the render thread (recompiler mode, GPL off/unusable)
+		c_async_link,        // monolithic pipelines queued to the compiler threads
+		c_fast_link_inline,  // GPL: all four libraries cached, linked on the render thread (no skipped draw)
+		c_fast_link_worker,  // GPL: missing libraries built + linked on a compiler thread
+		c_gpl_library,       // GPL: library parts created
+		c_gpl_fallback,      // GPL: library path failed, monolithic used instead
+		c_opt_swap,          // GPL: optimised monolithic pipeline swapped in
+		c_inline_other,      // other inline pipeline creations on the render thread (overlays, compute passes)
+		c_count
+	};
+
+	bool log_enabled();
+	u64 now_ns();
+
+	void add(counter c, u32 n = 1);
+	void queue_delta(int delta);             // pending compiler jobs
+	void set_bg_preload(u32 done, u32 total); // background start-up preload progress
+	void note_stall_ns(u64 ns);              // render-thread wait (any thread is ignored unless it is the render thread)
+
+	// Render-thread scope around the program cache lookup. Work done inside it (shader compiles, pipeline links)
+	// is timed as one stall by the caller.
+	struct render_scope
+	{
+		render_scope();
+		~render_scope();
+		render_scope(const render_scope&) = delete;
+		render_scope& operator=(const render_scope&) = delete;
+	};
+
+	bool in_render_scope();          // inside a render_scope on this thread
+	bool is_render_thread();         // this thread has entered a render_scope before
+	void note_work();                // something was compiled inside the current render scope
+	void note_shader_compile();      // VP/FP decompile+compile; counted when inside a render scope
+	bool take_work();                // returns and clears the work flag of this thread
+
+	// Times inline pipeline creation on the render thread outside a render_scope (overlay / compute pipelines)
+	struct inline_timer
+	{
+		u64 t0 = 0;
+		inline_timer();
+		~inline_timer();
+	};
+
+	void on_flip(); // once per emulated flip: closes the frame and prints [pipe] every 5 s
+}
diff --git a/rpcs3/Emu/RSX/VK/VKR2Upscaler.cpp b/rpcs3/Emu/RSX/VK/VKR2Upscaler.cpp
new file mode 100644
index 0000000..317b3e7
--- /dev/null
+++ b/rpcs3/Emu/RSX/VK/VKR2Upscaler.cpp
@@ -0,0 +1,5745 @@
+// R2PORT: Resistance 2 port addition (not upstream RPCS3). See VKR2Upscaler.h.
+//
+// How it works (all inert unless RSX_FSR=1/2/4; 4 = Intel XeSS, VKR2XeSS.cpp, FSR 3.1 fallback):
+//  * Scene detection: every draw is tallied by (colour target, depth target). At each flip the pair with
+//    the most depth-tested draws becomes next frame's "scene".
+//  * Jitter: draws into the scene colour target or writing the scene depth get a Halton(2,3) sub-pixel offset added to the viewport
+//    offset of RPCS3's scale_offset matrix (vertex env), so no shader changes are needed.
+//  * Motion: the RSX vertex program of scene draws is run on the CPU for 4 basis points to get its
+//    affine object->clip matrix M. For each draw also seen last frame, R = M_prev * M_cur^-1; the most
+//    common R (static geometry) is the camera motion. A compute pass turns depth + R into motion vectors.
+//  * The upscaler (FSR 3.1 or DLAA, native resolution) runs when the scene colour is first read
+//    (post-processing / blit) or at flip, and its result is copied back into the scene colour target.
+
+#include "stdafx.h"
+#include "VKR2Upscaler.h"
+#include "VKR2XeSS.h"
+#include "VKR2FrameGen.h" // R2PORT frame generation
+#include "VKGSRender.h"
+#include "VKCompute.h"
+#include "VKHelpers.h"
+#include "VKRenderPass.h"
+#include "VKFramebuffer.h"
+#include "VKResourceManager.h"
+#include "vkutils/barriers.h"
+#include "vkutils/sampler.h"
+
+#include "Emu/RSX/rsx_methods.h"
+#include "Emu/system_config.h"
+#include "Emu/RSX/NV47/HW/context_accessors.define.h"
+
+#ifdef R2PORT_HAVE_FFX
+#include "ffx_api/ffx_api.h"
+#include "ffx_api/ffx_upscale.h"
+#include "ffx_api/vk/ffx_api_vk.h"
+#endif
+
+#include <cstdarg>
+#include <cstdio>
+#include <cstdlib>
