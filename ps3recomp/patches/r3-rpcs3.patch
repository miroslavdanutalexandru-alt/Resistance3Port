+// R2PORT: optional graphics-quality upgrades (VKR2Gfx.cpp). Everything here is inert unless its switch is set:
+//   RSX_SHADOW_SCALE=2|4   shadow maps (square depth-only targets) rendered at 2x/4x the resolution
+//   RSX_FX_FULLRES=1|2     half-resolution (1) and also quarter-resolution (2) effect targets at scene resolution
+//   RSX_HUD_FIX=1          with a stretched Hor+ picture (R2_ASPECT), draws into the display buffer are squeezed
+//                          back to 16:9 proportions around the centre (full-screen quads are left alone)
+//   RSX_SSAO=1             experimental screen-space ambient occlusion on the opaque scene
+//   RSX_TEXDUMP=1          dump every uploaded 2D texture (DDS for DXT1/3/5, PNG for A8R8G8B8) to texdump\
+//   RSX_TEXPACK=1|<dir>    replace textures by guest-data hash from mods\textures (or <dir>)
+#pragma once
+
+#include "util/types.hpp"
+#include <vector>
+
+namespace rsx
+{
+	struct subresource_layout;
+	enum class texture_dimension_extended : u8;
+}
+
+namespace r2gx
+{
+	// VKDraw.cpp: slope-scaled depth bias multiplier for the bound target (1 unless a shadow map is upscaled)
+	float slope_bias_scale();
+
+	// VKVertexProgram.cpp: emit the HUD squeeze in the vertex shader epilogue (RSX_HUD_FIX)
+	bool hud_fix_enabled();
+
+	// VKTextureCache.cpp: texture packs. 'texpack_active' is a plain bool so the upload path costs one test
+	// when neither RSX_TEXDUMP nor RSX_TEXPACK is set.
+	extern bool texpack_active;
+	void texpack_init();
+	const std::vector<rsx::subresource_layout>* texpack_upload(u32 address, u16 width, u16 height, u16 depth, u16 mipmaps,
+		u32 gcm_format, rsx::texture_dimension_extended type, bool& swizzled,
+		const std::vector<rsx::subresource_layout>& layout, std::vector<rsx::subresource_layout>& tmp);
+}
