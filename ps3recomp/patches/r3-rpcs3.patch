+namespace
+{
+	// RSX_DLSS_DEPTH_BIAS (default "scale"; 0/off = upstream): Vulkan's slope depth bias uses dz/dx per HOST pixel, so on a
+	// surface drawn at resolution scale s the slope term is 1/s of what the PS3 applied. Coplanar decals (carpets,
+	// posters, blood) with polygon offset then lose their bias at grazing angles and z-fight / vanish; DLSS
+	// jitter turns that into flicker. "scale" (or 1) multiplies the slope factor by the bound target's scale
+	// (the reduced DLSS/FSR scale inside the scene window); a number k > 1 multiplies it by scale * k.
+	// "color" = same, but depth-only targets (shadow maps) keep the upstream slope.
+	// Default "scale" (2026-11-14, was "color"): shadow maps are resolution-scaled too (300% = 1/3 of the PS3 slope bias),
+	// but the game's PCF taps and receiver depths are in guest texels, so grazing / distant receivers (R3 Haven carpet,
+	// far walls) self-shadowed into dark blotches. RSX_SHADOW_SCALE already scales the slope; this covers the base scale.
+	// RSX_DLSS_DEPTH_BIAS_LOG=N logs the first N polygon-offset draws (factors, target, scale).
+	struct depth_bias_cfg { bool on = false; bool color_only = false; float k = 1.f; u32 log = 0; };
+	const depth_bias_cfg& dbcfg()
+	{
+		static const depth_bias_cfg c = []
+		{
+			depth_bias_cfg r;
+			const char* dbe = std::getenv("RSX_DLSS_DEPTH_BIAS");
+			if (!dbe || !*dbe) dbe = "scale"; // default "scale" (2026-11-14); =color = 11-13 default; =0/off = upstream slope everywhere
+			if (const char* e = dbe; *e != '0' && _stricmp(e, "off"))
+			{
+				r.on = true;
+				r.color_only = !_stricmp(e, "color");
+				const float v = static_cast<float>(std::atof(e));
+				if (v > 1.f) r.k = std::min(v, 8.f);
+			}
+			if (const char* e = std::getenv("RSX_DLSS_DEPTH_BIAS_LOG")) r.log = static_cast<u32>(std::max(0, std::atoi(e)));
+			if (r.on || r.log) gxlog("depth bias: slope x target scale %s%s (k %.2f), log %u", r.on ? "on" : "off",
+				r.color_only ? " (colour targets only)" : "", r.k, r.log);
+			return r;
+		}();
+		return c;
+	}
+	float g_bind_scale = 1.f; // resolution scale of the bound target (set in r2gx_bind phase 1)
+	u32 g_bind_seq = 1;       // incremented by every r2gx_bind(1): RSX_FX_PREFILTER results are reused within one bind
+
+	// RSX_SHADOW_SLOPE_K (default 1 = off; pdq_shadow_slope_k): the shadow-map scale paths multiply their slope ratio by
+	// k. 5 s counter of the shadow binds it applied to.
+	float shadow_slope_k()
+	{
+		static const float k = []
+		{
+			const float v = pdq_shadow_slope_k(pdq_env_float("RSX_SHADOW_SLOPE_K", 1.f));
+			gxlog("shadow-map slope bias x%.2f (RSX_SHADOW_SLOPE_K; 1 = off)", v);
+			return v;
+		}();
+		return k;
+	}
+	float shadow_slope_note()
+	{
+		const float k = shadow_slope_k();
+		if (k == 1.f) return k;
+		static u32 binds = 0;
+		static std::chrono::steady_clock::time_point t{};
+		binds++;
+		const auto now = std::chrono::steady_clock::now();
+		if (t == std::chrono::steady_clock::time_point{}) t = now;
+		else if (now - t >= std::chrono::seconds(5))
+		{
+			gxlog("shadow slope bias x%.2f (RSX_SHADOW_SLOPE_K): %u shadow-map binds in %.1f s", k, binds,
+				std::chrono::duration<float>(now - t).count());
+			binds = 0;
+			t = now;
+		}
+		return k;
+	}
+}
+
+float r2gx::slope_bias_scale()
+{
+	const auto& d = dbcfg();
+	return d.on ? g_gx.slope * g_bind_scale * d.k : g_gx.slope;
+}
+
+bool r2gx::hud_fix_enabled()
+{
+	return gxcfg().hud;
+}
+
+// R2PORT: RSX_VP_PRECISE_DOT (see VKR2Gfx.h; the same sequence as pdq_dot2 in VKR2DlssQuality.h)
+bool r2gx::vp_precise_dot()
+{
+	static const bool on = []
+	{
+		const char* e = std::getenv("RSX_VP_PRECISE_DOT");
+		// round 12: default on again. Round 11 turned it off as a rubble-garbage suspect, but the garbage persisted with it
+		// off (T2 r11 log: "plain fp32 dot()"), so it is cleared; 0 / off = plain fp32 dot().
+		const bool r = !(e && *e && (e[0] == '0' || _stricmp(e, "off") == 0));
+		gxlog("vertex-program DP4/DPH: %s (RSX_VP_PRECISE_DOT)", r ? "compensated dot product (stable depth where surfaces meet)" :
+			"plain fp32 dot()");
+		return r;
+	}();
+	return on;
+}
+
+const char* r2gx::vp_precise_dot_glsl()
+{
+	return
+		"float _r2_dp4(const in vec4 a, const in vec4 b)\n"
+		"{\n"
+		"	precise float p = a.x * b.x;\n"
+		"	precise float s = fma(a.x, b.x, -p);\n"
+		"	precise float h, r, q, z;\n"
+		"	h = a.y * b.y; r = fma(a.y, b.y, -h); q = p + h; z = q - p; s = s + (((p - (q - z)) + (h - z)) + r); p = q;\n"
+		"	h = a.z * b.z; r = fma(a.z, b.z, -h); q = p + h; z = q - p; s = s + (((p - (q - z)) + (h - z)) + r); p = q;\n"
+		"	h = a.w * b.w; r = fma(a.w, b.w, -h); q = p + h; z = q - p; s = s + (((p - (q - z)) + (h - z)) + r); p = q;\n"
+		"	precise float res = p + s;\n"
+		"	return (isnan(res) || isinf(res)) ? dot(a, b) : res;\n"
+		"}\n\n";
+}
+
+void r2gx::vp_precise_dot_count(u32 ops)
+{
+	static std::atomic<u32> progs{0}, total_ops{0}, plain{0};
+	if (!ops) { ++plain; return; }
+	const u32 n = ++progs;
+	const u32 o = (total_ops += ops);
+	if (n == 1 || n == 100 || n % 1000 == 0)
+		gxlog("RSX_VP_PRECISE_DOT: %u vertex programs with %u DP4/DPH ops use the compensated dot (%u without DP4/DPH)", n, o,
+			plain.load());
+}
+
+bool VKGSRender::r2gx_is_display(u32 addr) const
+{
+	if (!addr) return false;
+	for (u32 i = 0; i < m_ctx->display_buffers_count; ++i)
+	{
+		const auto& buffer = m_ctx->display_buffers[i];
+		if (buffer.valid() && rsx::get_address(m_ctx, buffer.offset, CELL_GCM_LOCATION_LOCAL) == addr)
+			return true;
+	}
+	return false;
+}
+
+void VKGSRender::r2gx_set_scale(u16 pct, float slope)
+{
+	auto& cfg = RSX(m_ctx)->resolution_scaling_config;
+	if (!g_gx.applied)
+	{
+		g_gx.saved = cfg;
+		g_gx.applied = true;
+	}
+	cfg.scale_percent = pct;
+	g_gx.slope = slope;
+	m_ctx->draw_state.dirty.set(rsx::draw_state_t::group::viewport);
+	m_ctx->draw_state.dirty.set(rsx::draw_state_t::group::scissor);
+	m_ctx->draw_state.dirty.set(rsx::draw_state_t::group::vertex_env);
+	m_ctx->draw_state.dirty.set(rsx::draw_state_t::group::fragment_env);
+}
+
+void VKGSRender::r2gx_bind(int phase)
+{
+	static const bool tp_once = (r2gx::texpack_init(), true); // textures are uploaded by draws, after the first bind
+	(void)tp_once;
+	if (phase != 0) ++g_bind_seq;
+	if (phase != 0 && (dbcfg().on || dbcfg().log))
+	{
+		// before r2gx's own shadow/effect scale: that is carried in g_gx.slope
+		const auto& L0 = m_ctx->fb.layout;
+		const auto& rc = RSX(m_ctx)->resolution_scaling_config;
+		g_bind_scale = std::max<u32>(L0.width, L0.height) > rc.min_scalable_dimension ? std::max(rc.scale_factor(), 0.01f) : 1.f;
+		if (dbcfg().color_only && !layout_has_color(L0)) g_bind_scale = 1.f;
+	}
+	const auto& c = gxcfg();
+	if (phase != 0 && r2gx::texpack_active)
+	{
+		const auto& Lb = m_ctx->fb.layout;
+		r2gx::texpack_ui_bind = layout_has_color(Lb) && r2gx_is_display(Lb.color_addresses[0]);
+	}
+	if (!c.any) return;
+	// R2PORT: build the SSAO compute pipelines at the first bind (boot), not at the first
+	// gameplay frame that wants SSAO (a render-thread compile there is a visible hitch)
+	static const bool ao_prewarm = c.ssao ? (vk::get_compute_task<vk::r2gx_ao_pass>(), vk::get_compute_task<vk::r2gx_ao_apply_pass<true>>(),
+		vk::get_compute_task<vk::r2gx_ao_apply_pass<false>>(), true) : false;
+	(void)ao_prewarm;
+	auto& st = g_gx;
+	const auto& L = m_ctx->fb.layout; // the layout about to be bound
+
+	if (phase == 0)
+	{
+		// SSAO at the end of the last scene-sized colour+depth pass, when the first smaller colour pass
+		// (the post-processing chain) is bound. Depth-only binds (shadow maps) in between don't end it.
+		// Under an active upscaler it runs inside r2aa_run instead (r2gx_ssao_upscaler).
+		if (c.ssao && st.cur_scene && !st.ao_done && st.cur_draws >= 8 && layout_has_color(L) &&
+			!(L.width == st.scene_w && L.height == st.scene_h) && !(c.ssao_ups && vk::r2aa_active()))
+		{
+			st.ao_done = true;
+			r2gx_ssao();
+		}
+		if (st.applied)
+		{
+			RSX(m_ctx)->resolution_scaling_config = st.saved;
+			st.applied = false;
+			st.slope = 1.f;
+			m_ctx->draw_state.dirty.set(rsx::draw_state_t::group::viewport);
+			m_ctx->draw_state.dirty.set(rsx::draw_state_t::group::scissor);
+			m_ctx->draw_state.dirty.set(rsx::draw_state_t::group::vertex_env);
+			m_ctx->draw_state.dirty.set(rsx::draw_state_t::group::fragment_env);
+		}
+		return;
+	}
+
+	const bool color = layout_has_color(L);
+	const bool disp = color && r2gx_is_display(L.color_addresses[0]);
+	st.cur_scene = false;
+	st.cur_draws = 0;
+	st.hud_x = st.hud_y = 0.f;
+
+	if (disp)
+	{
+		if (r2gx::decal_bias_steps() > 0.f)
+		{
+			// RSX_DECAL_ZBIAS_FOLLOW: an address key may name another decal after a level load / streaming
+			st.decal_idle = st.decal_frame == st.frame ? 0u : st.decal_idle + 1;
+			if (st.decal_idle == gx_state::decal_idle_clear) decal_poison_clear(st);
+			// RSX_DECAL_ZBIAS_EQGUARD: the quiet period restarts on every idle frame of a load, however long, so
+			// the first gameplay frames are never biased before their EQUAL material pass is seen
+			if (st.decal_idle >= gx_state::decal_idle_clear) st.decal_eq_frame = st.frame;
+		}
+		++st.frame;
+		++st.decal_frames_seen;
+		if (r2gx::decal_bias_steps() > 0.f)
+		{
+			const auto now = std::chrono::steady_clock::now();
+			if (st.decal_log_t == std::chrono::steady_clock::time_point{}) st.decal_log_t = now;
+			else if (now - st.decal_log_t >= std::chrono::seconds(5))
+			{
+				if (st.decal_biased || st.decal_missed || st.decal_full || st.decal_redraws || st.decal_refused || st.decal_clears ||
+					st.decal_eq_held || st.decal_nowrite)
+					gxlog("decal bias: %u pre-pass draws biased, %u EQUAL quad redraws (%u matched biased, %u without a pre-pass draw), "
+						"%u LEQUAL no-write redraws biased, %u ambiguous (shared quad), %u left unbiased (table full), "
+						"%u left unbiased (redraw not followed: %u keys, %u new, %u released by a match; %u misses not counted (incomplete "
+						"frame), %u table clears), %u left unbiased (EQUAL material pass in the last %u frames: %u EQUAL draws), "
+						"%u no-write quads biased (RSX_DECAL_ZBIAS_NOWRITE) (%u frames)",
+						st.decal_biased, st.decal_redraws, st.decal_matched, st.decal_missed, st.decal_leq, st.decal_ambig, st.decal_full,
+						st.decal_refused, st.decal_poison_cnt, st.decal_poison_new, st.decal_unpoison, st.decal_unsafe, st.decal_clears,
+						st.decal_eq_held, gx_state::decal_eq_quiet, st.decal_eq_draws, st.decal_nowrite, st.decal_frames_seen);
+				st.decal_biased = st.decal_matched = st.decal_missed = st.decal_ambig = st.decal_full = st.decal_frames_seen = 0;
+				st.decal_redraws = st.decal_leq = st.decal_refused = st.decal_poison_new = 0;
+				st.decal_unpoison = st.decal_unsafe = st.decal_clears = 0;
+				st.decal_eq_held = st.decal_eq_draws = 0;
+				st.decal_nowrite = 0;
+				if (r2gx::decal_pair_mode())
+				{
+					u32 confirmed = 0, blocked = 0;
+					for (const auto& [k, v] : st.pair_learn)
+					{
+						if (v.confirm >= gx_state::pair_need) ++confirmed;
+						if (st.frame < v.block_until) ++blocked;
+					}
+					gxlog("decal pairing (RSX_DECAL_ZBIAS_PAIR=%d): %u EQUAL quad redraws paired by content, %u unpaired (no pre-pass "
+						"quad with the same positions), %u with the same positions but other constants, %u without content (unreadable), "
+						"%u keys learned (%u confirmed, %u blocked), %u key-frames confirmed, %u broken, %u pre-pass quads and %u redraws "
+						"biased by a pair, %u biased pre-pass quads not redrawn (key blocked %u frames)",
+						r2gx::decal_pair_mode(), st.pair_matched, st.pair_unmatched, st.pair_mismatch, st.pair_noread,
+						static_cast<u32>(st.pair_learn.size()), confirmed, blocked, st.pair_confirmed_frames, st.pair_broken,
+						st.pair_pre_biased, st.pair_red_biased, st.pair_lost, gx_state::pair_block);
+					st.pair_matched = st.pair_unmatched = st.pair_mismatch = st.pair_noread = 0;
+					st.pair_confirmed_frames = st.pair_broken = st.pair_pre_biased = st.pair_red_biased = st.pair_lost = 0;
+				}
+				st.decal_log_t = now;
+			}
+		}
+		// a new frame's scene is measured from scratch (dynamic resolution changes it between frames)
+		st.scene_w = st.scene_h = 0;
+		st.ao_done = false;
+		if (c.hud && g_cfg.video.stretch_to_display_area && m_swapchain_dims.width > 64 && m_swapchain_dims.height > 64 && L.height)
+		{
+			const float base = static_cast<float>(L.width) / static_cast<float>(L.height);
+			const float win = static_cast<float>(m_swapchain_dims.width) / static_cast<float>(m_swapchain_dims.height);
+			if (win > base * 1.01f) st.hud_x = base / win;
+			else if (win < base / 1.01f) st.hud_y = win / base;
+		}
+		return;
+	}
+
+	if (color && L.zeta_address && L.width >= 640 && L.height >= 360 && L.width != L.height &&
+		static_cast<u32>(L.width) * L.height >= static_cast<u32>(st.scene_w) * st.scene_h)
+	{
+		st.scene_w = L.width;
+		st.scene_h = L.height;
+	}
+	st.cur_scene = color && L.zeta_address && L.width == st.scene_w && L.height == st.scene_h;
+	st.cur_w = L.width;
+	st.cur_h = L.height;
+
+	const auto& cfg = RSX(m_ctx)->resolution_scaling_config;
+	// RSX_SHADOW_NATIVE (R3 default 1, R2 default 0): the game's shadow maps (Z16, depth-only, any size up to 2048)
+	// are rendered at the PS3 resolution instead of the global scale (300% made the 1024^2 map 3072^2, a 32^2 one 96^2).
+	// R3 packs many small maps back to back and samples pairs / quads of them as one taller texture (128x256 over two
+	// 128^2 maps, 512x1024, 128x512 ...), with UN coordinates on the 1024^2 map and linear PCF; at a scale every such
+	// read goes through scaled atlas-gather / clip copies, and the game's per-map bias (units 200-1600) and PCF are
+	// tuned for guest texels. User 2026-11-16: Haven carpet / floor under the bulb dark in hard straight-edged regions
+	// that change with the camera (RSX_ANISO_SHADOW=0 did not fix it; cond-render 0). Native maps are bit-for-bit the
+	// PS3 shadow layout (slope multiplier back to 1, no scaled gather), and cheaper. RSX_SHADOW_NATIVE=0: scaled (old).
+	if (c.shadow_native && L.zeta_address && layout_depth_only(L) && cfg.scale_percent > 100 &&
+		(L.depth_format == rsx::surface_depth_format2::z16_uint || L.depth_format == rsx::surface_depth_format2::z16_float) &&
+		L.width && L.height && L.width <= 2048 && L.height <= 2048)
+	{
+		// g_bind_scale (computed above at the global scale) multiplies the slope bias; cancel it at 100%
+		const float ratio = dbcfg().on ? 1.f / std::max(g_bind_scale, 0.01f) : 1.f;
+		r2gx_set_scale(100, ratio * shadow_slope_note());
+		if (st.logged_shadow < 8)
+		{
+			st.logged_shadow++;
+			gxlog("shadow map %ux%u (depth 0x%08x, Z16): native 100%% instead of %u%% (RSX_SHADOW_NATIVE)", L.width, L.height,
+				L.zeta_address, st.saved.scale_percent);
+		}
+		return;
+	}
+	int k = 1;
+	bool shadow = false;
+	bool aa_full = false;
+	// RSX_SHADOW_SLOPE_K for the shadow maps no scale path takes (scale <= 100% or <= the cap, native / cap off: R2's
+	// defaults): same resolution, only the slope bias x k
+	const auto slope_only = [&]
+	{
+		if (shadow_slope_k() != 1.f && L.zeta_address && layout_depth_only(L) &&
+			(L.depth_format == rsx::surface_depth_format2::z16_uint || L.depth_format == rsx::surface_depth_format2::z16_float) &&
+			L.width && L.height && L.width <= 2048 && L.height <= 2048)
+			r2gx_set_scale(cfg.scale_percent, shadow_slope_note());
+	};
+	// RSX_AA_SAMPLE_RES (default 1, 0 = old): with host MSAA off (forced by DLSS/FSR/XeSS) a 4-sample (2x2) target was
+	// a 1-sample image at its pixel size, but its guest memory holds the 2x2 sample grid. R2's half-size effect buffer
+	// (640x352 4x AA) aliases the 1280x704 post buffer that way: every bind inherited the post buffer scaled down by
+	// NEAREST and the next post bind inherited it back scaled up, ~15 round trips a frame (RenderDoc 2684 EIDs
+	// 2785/2830 ...): the post chain, then the final image, was a pixel-doubled half-resolution copy (plus the
+	// matching depth round trips). At twice the scale the image has one texel per guest sample: the copies are 1:1.
+	if (c.aa_samples && g_cfg.video.antialiasing_level == msaa_level::none &&
+		(L.aa_mode == rsx::surface_antialiasing::square_centered_4_samples || L.aa_mode == rsx::surface_antialiasing::square_rotated_4_samples) &&
+		st.scene_w && 2 * L.width <= st.scene_w + 4 && 2 * L.height <= st.scene_h + 4) // sample grid within the scene size
+	{
+		k = 2;
+		aa_full = true;
+	}
+	else if (c.shadow > 1 && layout_depth_only(L) && L.zeta_address && L.width == L.height && L.width >= 256 && L.width <= 2048 &&
+		(L.width & (L.width - 1)) == 0)
+	{
+		k = c.shadow;
+		shadow = true;
+	}
+	else if (L.zeta_address && pdq_shadow_cap_applies(c.shadow_cap, cfg.scale_percent, layout_depth_only(L),
+		L.depth_format == rsx::surface_depth_format2::z16_uint || L.depth_format == rsx::surface_depth_format2::z16_float, L.width, L.height))
+	{
+		// RSX_SHADOW_SCALE_CAP: below the global scale; a scaled slope bias follows (g_bind_scale * ratio = cap / 100).
+		// Every Z16 map RSX_SHADOW_NATIVE covers is capped, not only the square ones: R3 samples neighbouring packed maps
+		// (1024^2, 128^2, 32x64, 256x128 ...) as one taller texture, so they must share one scale (r8b: 128^2 / 32x64 maps
+		// stayed at 300% next to 200% ones; spot-light shadows crawled up close)
+		const float ratio = dbcfg().on && !dbcfg().color_only ? static_cast<float>(c.shadow_cap) / static_cast<float>(cfg.scale_percent) : 1.f;
+		r2gx_set_scale(static_cast<u16>(c.shadow_cap), ratio * shadow_slope_note());
+		if (st.logged_shadow < 8)
+		{
+			st.logged_shadow++;
+			gxlog("shadow map %ux%u (depth 0x%08x): scale %u%% capped to %d%% (RSX_SHADOW_SCALE_CAP)", L.width, L.height,
+				L.zeta_address, st.saved.scale_percent, c.shadow_cap);
+		}
+		return;
+	}
+	else if (c.fx && color)
+	{
+		const int sw = st.scene_w, sh = st.scene_h, w = L.width, h = L.height;
+		if (sw && w < sw)
+		{
+			if (std::abs(2 * w - sw) <= 4 && std::abs(2 * h - sh) <= 4) k = 2;
+			else if (c.fx >= 2 && std::abs(4 * w - sw) <= 8 && std::abs(4 * h - sh) <= 8) k = 4;
+		}
+	}
+	if (k <= 1)
+	{
+		slope_only();
+		return;
+	}
+
+	u32 pct = static_cast<u32>(cfg.scale_percent) * k;
+	const u32 max_dim = 8192;
+	const u32 dim = std::max<u32>(L.width, L.height);
+	if (dim * pct / 100 > max_dim) pct = max_dim * 100 / dim;
+	if (pct <= cfg.scale_percent)
+	{
+		slope_only();
+		return;
+	}
+	const float ratio = static_cast<float>(pct) / static_cast<float>(cfg.scale_percent);
+	r2gx_set_scale(static_cast<u16>(pct), shadow ? ratio * shadow_slope_note() : 1.f);
+
+	u32& logged = shadow ? st.logged_shadow : st.logged_fx;
+	if (logged < 8)
+	{
+		logged++;
+		gxlog("%s target %ux%u (color 0x%08x, depth 0x%08x): scale %u%% -> %u%%", shadow ? "shadow map" : aa_full ? "4-sample (RSX_AA_SAMPLE_RES)" : "effect",
+			L.width, L.height, L.color_addresses[0], L.zeta_address, st.saved.scale_percent, pct);
+	}
+}
+
+int VKGSRender::r2gx_on_draw()
+{
+	auto& st = g_gx;
+	if (const auto& d = dbcfg(); d.log)
+	{
+		static u32 logged = 0;
+		if (logged < d.log && REGS(m_ctx)->poly_offset_fill_enabled())
+		{
+			logged++;
+			const auto& L = m_ctx->fb.layout;
+			gxlog("depth bias draw %u: scale(slope) %.3f bias %.3f, target %ux%u color 0x%08x depth 0x%08x fmt %u, bind scale %.2f, slope mult %.2f",
+				logged, REGS(m_ctx)->poly_offset_scale(), REGS(m_ctx)->poly_offset_bias(), L.width, L.height, L.color_addresses[0],
+				L.zeta_address, static_cast<u32>(L.depth_format), g_bind_scale, r2gx::slope_bias_scale());
+		}
+	}
+	// RSX_SHADOW_DIAG=N (default 0 = off): one line per distinct polygon-offset setup (target, depth format,
+	// viewport = cascade rect inside an atlas, raw factors, host slope multiplier)
+	if (REGS(m_ctx)->poly_offset_fill_enabled())
+	{
+		static const u32 diag_max = [] { const char* e = std::getenv("RSX_SHADOW_DIAG"); return e && *e ? static_cast<u32>(std::max(0, std::atoi(e))) : 0u; }();
+		static std::vector<std::array<u32, 8>> seen;
+		if (seen.size() < diag_max)
+		{
+			const auto& L = m_ctx->fb.layout;
+			const auto* R = REGS(m_ctx);
+			const float fs = R->poly_offset_scale(), fb = R->poly_offset_bias();
+			u32 fsu, fbu;
+			std::memcpy(&fsu, &fs, 4);
+			std::memcpy(&fbu, &fb, 4);
+			const std::array<u32, 8> key{ L.zeta_address, (u32{L.width} << 16) | L.height, static_cast<u32>(L.depth_format) | (layout_depth_only(L) ? 0u : 0x100u),
+				(u32{R->viewport_origin_x()} << 16) | R->viewport_origin_y(), (u32{R->viewport_width()} << 16) | R->viewport_height(), fsu, fbu,
+				static_cast<u32>(R->depth_func()) };
+			if (std::find(seen.begin(), seen.end(), key) == seen.end())
+			{
+				seen.push_back(key);
+				std::fprintf(stderr, "[shadowdiag] polyoffset target %ux%u depth 0x%08x fmt %u color %u vp %u,%u %ux%u | factor %.3f units %.3f"
+					" zfunc 0x%X | bind scale %.2f slope mult %.2f\n", L.width, L.height, L.zeta_address, static_cast<u32>(L.depth_format),
+					layout_depth_only(L) ? 0u : 1u, R->viewport_origin_x(), R->viewport_origin_y(), R->viewport_width(), R->viewport_height(),
+					fs, fb, static_cast<u32>(R->depth_func()), g_bind_scale, r2gx::slope_bias_scale());
+			}
+		}
+	}
+	// RSX_DEPTH_DIAG=N (default 0 = off; logging only): one line per distinct depth-path mechanism set on draws
+	// that use polygon offset, depth func EQUAL, LEQUAL with alpha test / depth bounds, or a conditional render. Says
+	// which of offset / depth bounds / conditional render / alpha test / upscaler jitter / shadow compare were active.
+	{
+		static const u32 diag_max = [] { const char* e = std::getenv("RSX_DEPTH_DIAG"); return e && *e ? static_cast<u32>(std::max(0, std::atoi(e))) : 0u; }();
+		static std::vector<std::array<u32, 10>> seen;
+		const auto* R = REGS(m_ctx);
+		if (seen.size() < diag_max && R->depth_test_enabled())
+		{
+			const auto zf = R->depth_func();
+			const bool po = R->poly_offset_fill_enabled(), db = R->depth_bounds_test_enabled(), at = R->alpha_test_enabled();
+			const bool cr = m_ctx->cond_render.enabled;
+			if (po || zf == rsx::comparison_function::equal || cr ||
+				(zf == rsx::comparison_function::less_or_equal && (at || db)))
+			{
+				const auto& L = m_ctx->fb.layout;
+				const u32 shadow = m_ctx->program.fragment_program.texture_state.shadow_textures;
+				const bool jit = vk::r2aa_active();
+				const u32 flags = (po ? 1u : 0u) | (db ? 2u : 0u) | (at ? 4u : 0u) | (cr ? 8u : 0u) | (m_ctx->cond_render.hw_cond_active ? 16u : 0u) |
+					(m_ctx->cond_render.eval_pending() ? 32u : 0u) | (jit ? 64u : 0u) | (R->depth_write_enabled() ? 128u : 0u) |
+					(R->cull_face_enabled() ? 256u : 0u) | (R->stencil_test_enabled() ? 512u : 0u) | (g_gx.cur_scene ? 1024u : 0u) |
+					(layout_has_color(L) ? 2048u : 0u);
+				float dmin = R->depth_bounds_min(), dmax = R->depth_bounds_max(), aref = R->alpha_ref(), fs = R->poly_offset_scale(), fb = R->poly_offset_bias();
+				u32 bits[5];
+				std::memcpy(&bits[0], &dmin, 4); std::memcpy(&bits[1], &dmax, 4); std::memcpy(&bits[2], &aref, 4);
+				std::memcpy(&bits[3], &fs, 4); std::memcpy(&bits[4], &fb, 4);
+				const std::array<u32, 10> key{ L.zeta_address, (u32{L.width} << 16) | L.height, static_cast<u32>(zf) | (static_cast<u32>(R->alpha_func()) << 16),
+					flags, shadow, po ? bits[3] : 0u, po ? bits[4] : 0u, db ? bits[0] : 0u, db ? bits[1] : 0u, at ? bits[2] : 0u };
+				if (std::find(seen.begin(), seen.end(), key) == seen.end())
+				{
+					seen.push_back(key);
+					std::fprintf(stderr, "[depthdiag] zfunc 0x%X target %ux%u depth 0x%08x fmt %u color %u scene %u | polyoffset %u (factor %.3f units %.3f,"
+						" slope mult %.2f) | dbounds %u [%.5f, %.5f] | clip [%.5f, %.5f] | alphatest %u func 0x%X ref %.3f | cond %u hw %u pending %u"
+						" (CPU-skipped draws so far %llu, GPU-predicated draws so far %llu) | upscaler jitter %u bind scale %.2f | dwrite %u cull %u ff %u stencil %u | shadow units 0x%X\n",
+						static_cast<u32>(zf), L.width, L.height, L.zeta_address, static_cast<u32>(L.depth_format), layout_has_color(L) ? 1u : 0u,
+						g_gx.cur_scene ? 1u : 0u, po ? 1u : 0u, fs, fb, r2gx::slope_bias_scale(), db ? 1u : 0u, dmin, dmax, R->clip_min(), R->clip_max(),
+						at ? 1u : 0u, static_cast<u32>(R->alpha_func()), aref, cr ? 1u : 0u, m_ctx->cond_render.hw_cond_active ? 1u : 0u,
+						m_ctx->cond_render.eval_pending() ? 1u : 0u, static_cast<unsigned long long>(r2_cond_render_skipped.load(std::memory_order_relaxed)),
+						static_cast<unsigned long long>(r2_cond_render_hwpred.load(std::memory_order_relaxed)),
+						jit ? 1u : 0u, g_bind_scale, R->depth_write_enabled() ? 1u : 0u, R->cull_face_enabled() ? 1u : 0u,
+						static_cast<u32>(R->front_face_mode()), R->stencil_test_enabled() ? 1u : 0u, shadow);
+				}
+			}
+		}
+	}
+	const auto& c = gxcfg();
+	if (!c.any) return 0;
+	if (st.cur_scene && REGS(m_ctx)->depth_test_enabled()) st.cur_draws++;
+	return (c.hud && (st.hud_x != st.env_x || st.hud_y != st.env_y)) ? 1 : 0;
+}
+
+void VKGSRender::r2gx_patch_vertex_env(void* env)
+{
+	// vertex_context_t.reserved[0..1] (bytes 84..91): HUD squeeze factors read by the RSX_HUD_FIX epilogue
+	if (!gxcfg().hud) return;
+	float* f = static_cast<float*>(env);
+	f[21] = g_gx.hud_x;
+	f[22] = g_gx.hud_y;
+	g_gx.env_x = g_gx.hud_x;
+	g_gx.env_y = g_gx.hud_y;
+}
+
+namespace
+{
+	// RSX_SSAO_UV (default 1): sample depth and AO in the drawn region only. Under DLSS/FSR the scene is drawn at a
+	// reduced scale inside surfaces allocated for the full scale, and the AO image keeps the largest size seen;
+	// normalised 0..1 coordinates over the whole image stretched the depth / AO term (a dark offset copy of every
+	// character, growing toward the bottom right). 0 = old behaviour.
+	bool gx_uv_fix()
+	{
+		static const bool on = [] { const char* e = std::getenv("RSX_SSAO_UV"); return !e || std::atoi(e) != 0; }();
+		return on;
+	}
+}
+
+void VKGSRender::r2gx_ssao()
+{
+	auto& st = g_gx;
+	auto& sc = res()->surface_cache;
+	auto* rt = sc.m_bound_render_targets[0].second;
+	auto* ds = sc.m_bound_depth_stencil.second;
+	if (!rt || !ds)
+	{
+		if (!st.ao_warned)
+		{
+			st.ao_warned = true;
+			gxlog("SSAO skipped: no scene targets bound");
+		}
+		return;
+	}
+	const auto [sw, sh] = rsx::apply_resolution_scale<true>(rt->resolution_scaling_config, st.cur_w, st.cur_h);
+	const auto [dsw, dsh] = rsx::apply_resolution_scale<true>(ds->resolution_scaling_config, st.cur_w, st.cur_h);
+	const bool uv_fix = gx_uv_fix();
+	r2gx_ssao_apply(rt, ds, std::min<u32>(sw, rt->info.extent.width), std::min<u32>(sh, rt->info.extent.height),
+		uv_fix ? std::min<u32>(dsw, ds->info.extent.width) : ds->info.extent.width,
+		uv_fix ? std::min<u32>(dsh, ds->info.extent.height) : ds->info.extent.height, "scene pass end");
+}
+
+void VKGSRender::r2gx_ssao_upscaler(vk::render_target* rt, vk::render_target* ds, u32 w, u32 h, u32 dw, u32 dh)
+{
+	const auto& c = gxcfg();
+	if (!c.ssao || !c.ssao_ups || !rt || !ds) return;
+	r2gx_ssao_apply(rt, ds, w, h, dw, dh, "upscaler input");
+}
+
+// AO of the w x h region of 'ds' (its top-left dw x dh texels cover the same area) multiplied into the w x h region of 'rt'
+void VKGSRender::r2gx_ssao_apply(vk::render_target* rt, vk::render_target* ds, u32 w, u32 h, u32 dw, u32 dh, const char* path)
+{
+	auto& st = g_gx;
+	const auto skip = [&](const char* why)
+	{
+		if (!st.ao_warned)
+		{
+			st.ao_warned = true;
+			gxlog("SSAO skipped: %s", why);
+		}
+	};
+	if (rt->samples() > 1 || ds->samples() > 1) return skip("the scene is multisampled (set R2_MSAA=0 or use DLSS/FSR)");
+	const VkFormat cfmt = rt->info.format;
+	const bool half = cfmt == VK_FORMAT_R16G16B16A16_SFLOAT;
+	const bool swap = cfmt == VK_FORMAT_B8G8R8A8_UNORM;
+	if (!half && !swap && cfmt != VK_FORMAT_R8G8B8A8_UNORM) return skip("unsupported scene colour format");
+	w = std::min<u32>(w, rt->info.extent.width);
+	h = std::min<u32>(h, rt->info.extent.height);
+	dw = std::max<u32>(1, std::min<u32>(dw, ds->info.extent.width));
+	dh = std::max<u32>(1, std::min<u32>(dh, ds->info.extent.height));
+	if (w < 64 || h < 64) return;
+
+	const VkImageUsageFlags usage = VK_IMAGE_USAGE_STORAGE_BIT | VK_IMAGE_USAGE_SAMPLED_BIT | VK_IMAGE_USAGE_TRANSFER_SRC_BIT;
+	const VkFormat ofmt = half ? VK_FORMAT_R16G16B16A16_SFLOAT : VK_FORMAT_R8G8B8A8_UNORM;
+	if (!st.ao || st.ao->width() < w || st.ao->height() < h || st.ao_out_fmt != ofmt)
+	{
+		const u32 aw = std::max<u32>(w, st.ao ? st.ao->width() : 0), ah = std::max<u32>(h, st.ao ? st.ao->height() : 0);
+		// the old images may still be in use by submitted work
+		if (st.ao) vk::get_resource_manager()->dispose(st.ao);
+		if (st.ao_out) vk::get_resource_manager()->dispose(st.ao_out);
+		st.ao = gx_make_image(VK_FORMAT_R8_UNORM, aw, ah, usage);
+		st.ao_out = gx_make_image(ofmt, aw, ah, usage);
+		st.ao_out_fmt = ofmt;
+		gxlog("SSAO buffers %ux%u", aw, ah);
+	}
+
+	auto& cmd = *m_current_command_buffer;
+	if (vk::is_renderpass_open(cmd)) vk::end_renderpass(cmd);
+
+	const auto& c = gxcfg();
+	rt->read_barrier(cmd);
+	ds->read_barrier(cmd);
+	rt->push_layout(cmd, VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL);
+	ds->push_layout(cmd, VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL);
+	st.ao->change_layout(cmd, VK_IMAGE_LAYOUT_GENERAL);
+
+	auto* depth_view = gx_view(ds, VK_IMAGE_ASPECT_DEPTH_BIT);
+	const bool uv_fix = gx_uv_fix();
+	const float dx = static_cast<float>(dw) / ds->info.extent.width;
+	const float dy = static_cast<float>(dh) / ds->info.extent.height;
+	const float ax = uv_fix ? static_cast<float>(w) / st.ao->width() : 1.f;
+	const float ay = uv_fix ? static_cast<float>(h) / st.ao->height() : 1.f;
+	if (st.ao_geom_log < 4 && (st.ao_geom[0] != w || st.ao_geom[1] != h || st.ao_geom[2] != ds->info.extent.width || st.ao_geom[3] != dw))
+	{
+		st.ao_geom_log++;
+		st.ao_geom[0] = w; st.ao_geom[1] = h; st.ao_geom[2] = ds->info.extent.width; st.ao_geom[3] = dw;
+		gxlog("SSAO geometry (%s): colour region %ux%u (image %ux%u), depth region %ux%u (image %ux%u), AO image %ux%u, region-only sampling %s",
+			path, w, h, rt->info.extent.width, rt->info.extent.height, dw, dh, ds->info.extent.width, ds->info.extent.height,
+			st.ao->width(), st.ao->height(), uv_fix ? "on" : "off (RSX_SSAO_UV=0)");
+	}
+	if (c.ssao_log && (st.ao_runs < 8 || (st.ao_runs % static_cast<u32>(c.ssao_log)) == 0))
+	{
+		gxlog("SSAO run %u (%s): colour %08x %ux%u (%u%%, fmt %d) depth %08x %ux%u (%u%%), region %ux%u / depth %ux%u, guest bind %ux%u, %u scene draws",
+			st.ao_runs, path, rt->get_memory_range().start, rt->info.extent.width, rt->info.extent.height, rt->resolution_scaling_config.scale_percent,
+			static_cast<int>(cfmt), ds->get_memory_range().start, ds->info.extent.width, ds->info.extent.height, ds->resolution_scaling_config.scale_percent,
+			w, h, dw, dh, st.cur_w, st.cur_h, st.cur_draws);
+	}
+	{
+		auto pass = vk::get_compute_task<vk::r2gx_ao_pass>();
+		pass->in_depth = depth_view;
+		pass->out_ao = gx_view(st.ao.get());
+		const float k[8] = { static_cast<float>(w), static_cast<float>(h), c.ssao_strength, c.ssao_radius,
+			static_cast<float>(h) * 0.06f, dx, dy,
+			c.ssao_noise == PDQ_SSAO_TEMPORAL ? static_cast<float>(pdq_ssao_offset(st.ao_runs)) : 0.f };
+		pass->run(cmd, k, w, h);
+	}
+	st.ao->change_layout(cmd, VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL);
+	st.ao_out->change_layout(cmd, VK_IMAGE_LAYOUT_GENERAL);
+	{
+		const float k[8] = { static_cast<float>(w), static_cast<float>(h), swap ? 1.f : 0.f, c.ssao_debug ? 1.f : 0.f, dx, dy, ax, ay };
+		const auto setup = [&](auto* pass)
+		{
+			pass->in_color = gx_view(rt);
+			pass->in_ao = gx_view(st.ao.get());
+			pass->in_depth = depth_view;
+			pass->out_color = gx_view(st.ao_out.get());
+			pass->run(cmd, k, w, h);
+		};
+		if (half) setup(vk::get_compute_task<vk::r2gx_ao_apply_pass<true>>());
+		else setup(vk::get_compute_task<vk::r2gx_ao_apply_pass<false>>());
+	}
+	ds->pop_layout(cmd);
+	rt->pop_layout(cmd);
+
+	st.ao_out->change_layout(cmd, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL);
+	rt->push_layout(cmd, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL);
+	VkImageCopy region{};
+	region.srcSubresource = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1 };
+	region.dstSubresource = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1 };
+	region.extent = { w, h, 1 };
+	vkCmdCopyImage(cmd, st.ao_out->value, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, rt->value, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, 1, &region);
+	rt->pop_layout(cmd);
+
+	cmd.r2_invalidate_state_cache();
+	m_current_command_buffer->flags |= vk::command_buffer::cb_reload_dynamic_state;
+	if (!st.ao_runs++) gxlog("SSAO: first frame processed (%ux%u, %u scene draws)", w, h, st.cur_draws);
+}
+
+// ---------------------------------------------------------------------------------------------------------
+// RSX_FX_PREFILTER (default 1, 0 = off): downsample passes on resolution-scaled sources
+// ---------------------------------------------------------------------------------------------------------
+// The game's downsample shaders (R3 bloom bright-pass: 4 bilinear taps spaced for the PS3 texel size) cover every
+// source texel at native resolution, but only a fraction of them at k x (11% at 3x): thin bright details fall in
+// and out of the sampled texels with jitter and motion and the bloom pulses. When a pass samples a scaled colour
+// surface into a target at most half its guest size, the source is box-filtered to its guest resolution first
+// (exact for integer k) and the game's taps read that: the PS3 result, whatever the scale or the upscaler input ratio.
+namespace vk
+{
+	struct r2gx_prefilter_pass : compute_task
+	{
+		const vk::image_view* in_src = nullptr;
+		const vk::image_view* out_dst = nullptr;
+		std::unique_ptr<vk::sampler> m_sampler;
+
+		r2gx_prefilter_pass()
+		{
+			m_src =
+				"#version 450\n"
+				"layout(local_size_x = 8, local_size_y = 8) in;\n"
+				"layout(set=0, binding=0) uniform sampler2D Src;\n"
+				"layout(set=0, binding=1, rgba16f) uniform writeonly image2D Dst;\n"
+				// a: output w, h, samples per output texel x, y (box of the source texels the output texel covers)
+				"layout(push_constant) uniform PC { vec4 a; };\n"
+				"void main()\n"
+				"{\n"
+				"	ivec2 p = ivec2(gl_GlobalInvocationID.xy);\n"
+				"	if (p.x >= int(a.x) || p.y >= int(a.y)) return;\n"
+				"	int nx = int(a.z), ny = int(a.w);\n"
+				"	vec4 s = vec4(0.0);\n"
+				"	for (int j = 0; j < ny; ++j)\n"
+				"		for (int i = 0; i < nx; ++i)\n"
+				"			s += textureLod(Src, (vec2(p) + (vec2(i, j) + 0.5) / vec2(nx, ny)) / a.xy, 0.0);\n"
+				"	imageStore(Dst, p, s / float(nx * ny));\n"
+				"}\n";
+			ssbo_count = 0;
+			use_push_constants = true;
+			push_constants_size = 16;
+			create();
+		}
+
+		std::vector<glsl::program_input> get_inputs() override
+		{
+			auto result = compute_task::get_inputs();
+			result.push_back(glsl::program_input::make(::glsl::program_domain::glsl_compute_program, "Src", vk::glsl::input_type_texture, 0, 0));
+			result.push_back(glsl::program_input::make(::glsl::program_domain::glsl_compute_program, "Dst", vk::glsl::input_type_storage_texture, 0, 1));
+			return result;
+		}
+
+		void bind_resources(const vk::command_buffer&) override
+		{
+			if (!m_sampler)
+			{
+				m_sampler = std::make_unique<vk::sampler>(*vk::get_current_renderer(),
+					VK_SAMPLER_ADDRESS_MODE_CLAMP_TO_EDGE, VK_SAMPLER_ADDRESS_MODE_CLAMP_TO_EDGE, VK_SAMPLER_ADDRESS_MODE_CLAMP_TO_EDGE,
+					VK_FALSE, 0.f, 1.f, 0.f, 0.f, VK_FILTER_LINEAR, VK_FILTER_LINEAR, VK_SAMPLER_MIPMAP_MODE_NEAREST, VK_BORDER_COLOR_FLOAT_TRANSPARENT_BLACK);
+			}
+			m_program->bind_uniform({ *in_src, *m_sampler }, 0, 0);
+			m_program->bind_uniform({ *out_dst }, 0, 1);
+		}
+
+		void run(const vk::command_buffer& cmd, const float* constants, u32 w, u32 h)
+		{
+			if (!m_program) load_program(cmd);
+			vkCmdPushConstants(cmd, m_program->layout(), VK_SHADER_STAGE_COMPUTE_BIT, 0, push_constants_size, constants);
+			compute_task::run(cmd, (w + 7) / 8, (h + 7) / 8, 1);
+		}
+	};
+}
+
+namespace
+{
+	struct pf_entry
+	{
+		u64 src_uid = 0;
+		u32 seq = 0;
+		u32 used = 0;
+		std::unique_ptr<vk::viewable_image> out;
+	};
+	struct pf_state
+	{
+		pf_entry e[8];
+		u32 tick = 0;
+		u32 runs = 0, logged = 0;
+		u64 last_report_runs = 0;
+	};
+	pf_state g_pf;
+
+	bool pf_enabled()
+	{
+		static const bool on = []
+		{
+			bool r = true;
+			if (const char* e = std::getenv("RSX_FX_PREFILTER"); e && *e) r = std::atoi(e) != 0;
+			gxlog("downsample pre-filter %s (RSX_FX_PREFILTER)", r ? "on: scaled colour sources of passes at <= 1/2 guest size are box-filtered to guest resolution" : "off");
+			return r;
+		}();
+		return on;
+	}
+}
+
+vk::image_view* VKGSRender::r2gx_prefilter_view(u32 slot, vk::image_view* view, const rsx::sampled_image_descriptor_base* desc)
+{
+	if (!view || !desc) return view;
+	const auto& L = m_ctx->fb.layout;
+	if (!layout_has_color(L) || layout_depth_only(L)) return view;
+	// RSX_AA_BLACK_DIAG (VKR2Upscaler.cpp): the first scene-sized render-target texture read into the display buffer
+	// in a frame (the post chain's composite source) is probed too, so a black presented scene can be pinned on the
+	// composite's input or on the composite pass itself
+	if (static u32 s_probe_frame = 0; vk::r2_black_probe_enabled() && s_probe_frame != g_gx.frame && L.color_addresses[0] && r2gx_is_display(L.color_addresses[0]) &&
+		desc->upload_context == rsx::texture_upload_context::framebuffer_storage && !desc->is_cyclic_reference &&
+		desc->image_type == rsx::texture_dimension_extended::texture_dimension_2d && g_gx.scene_w &&
+		REGS(m_ctx)->fragment_textures[slot].width() * 2u >= g_gx.scene_w)
+	{
+		s_probe_frame = g_gx.frame;
+		if (auto* pimg = view->image(); pimg && pimg->samples() == 1 && view->info.subresourceRange.aspectMask == VK_IMAGE_ASPECT_COLOR_BIT)
+		{
+			auto& pcmd = *m_current_command_buffer;
+			if (vk::is_renderpass_open(pcmd))
+			{
+				vk::end_renderpass(pcmd);
+				if (pcmd.flags & vk::command_buffer::cb_has_open_query) emergency_query_cleanup(m_current_command_buffer);
+			}
+			// the texture's part of the image (a reduced scene inside a larger allocation)
+			const float psx = std::clamp(desc->texcoord_xform.scale[0], 0.f, 1.f), psy = std::clamp(desc->texcoord_xform.scale[1], 0.f, 1.f);
+			const u32 pw = static_cast<u32>(pimg->width() * (psx > 0.f ? psx : 1.f)), ph = static_cast<u32>(pimg->height() * (psy > 0.f ? psy : 1.f));
+			vk::r2_black_probe(pcmd, pimg, pw, ph, 3, desc->ref_address);
+		}
+	}
+	if (!pf_enabled()) return view;
+	const auto& tex = REGS(m_ctx)->fragment_textures[slot];
+	const u32 tw = tex.width(), th = tex.height();
+	// a downsample: the target is at most half the source's guest size on both axes
+	if (tw < 16 || th < 16 || L.width * 2u > tw || L.height * 2u > th) return view;
+	// why a downsample of a scene-sized source was skipped (the first 8, for the log)
+	const auto skip = [&](const char* why, float a = 0.f, float b = 0.f)
+	{
+		if (g_pf.logged < 8 && tw == g_gx.scene_w && th == g_gx.scene_h)
+		{
+			g_pf.logged++;
+			gxlog("pre-filter: scene-sized source %08x (guest %ux%u fmt %x, target %ux%u) left alone: %s %.3f %.3f",
+				desc->ref_address, tw, th, tex.format(), L.width, L.height, why, a, b);
+		}
+		return view;
+	};
+	if (desc->upload_context != rsx::texture_upload_context::framebuffer_storage) return skip("not a render target", static_cast<float>(static_cast<int>(desc->upload_context)));
+	if (desc->is_cyclic_reference || desc->image_type != rsx::texture_dimension_extended::texture_dimension_2d) return skip("cyclic / not 2D");
+	const u32 gfmt = tex.format() & ~(CELL_GCM_TEXTURE_LN | CELL_GCM_TEXTURE_UN);
+	if ((tex.format() & CELL_GCM_TEXTURE_UN) ||
+		(gfmt != CELL_GCM_TEXTURE_A8R8G8B8 && gfmt != CELL_GCM_TEXTURE_D8R8G8B8 && gfmt != CELL_GCM_TEXTURE_W16_Z16_Y16_X16_FLOAT))
+		return skip("guest format");
+	// filtered reads only (point-sampled packed payloads, e.g. depth in colour, must not be averaged)
+	const auto minf = tex.min_filter();
+	const auto magf = tex.mag_filter();
+	if ((minf != rsx::texture_minify_filter::linear && minf != rsx::texture_minify_filter::linear_nearest &&
+		 minf != rsx::texture_minify_filter::linear_linear && minf != rsx::texture_minify_filter::convolution_min) ||
+		(magf != rsx::texture_magnify_filter::linear && magf != rsx::texture_magnify_filter::convolution_mag))
+		return skip("not linear filtered (min, mag)", static_cast<float>(static_cast<int>(minf)), static_cast<float>(static_cast<int>(magf)));
+	auto* img = view->image();
+	if (!img || img->samples() > 1 || view->info.subresourceRange.aspectMask != VK_IMAGE_ASPECT_COLOR_BIT) return skip("image / MSAA / aspect");
+	const VkFormat vf = view->info.format;
+	if (vf != VK_FORMAT_B8G8R8A8_UNORM && vf != VK_FORMAT_R8G8B8A8_UNORM && vf != VK_FORMAT_R16G16B16A16_SFLOAT)
+		return skip("view format", static_cast<float>(vf));
+	for (const u8 index : rsx::utility::get_rtt_indexes(L.target))
+		if (L.color_addresses[index] && L.color_addresses[index] == desc->ref_address) return view;
+
+	// host texels per guest texel: the texcoord transform maps the guest texture onto the part of the image it
+	// occupies (a reduced upscaler input inside a larger allocation), so the scale is measured on that part
+	const u32 iw = img->width(), ih = img->height();
+	const float sx = desc->texcoord_xform.scale[0], sy = desc->texcoord_xform.scale[1];
+	if (!(sx > 0.f && sx <= 1.01f && sy > 0.f && sy <= 1.01f)) return skip("texcoord scale", sx, sy);
+	const float kx = iw * sx / tw, ky = ih * sy / th;
+	if (kx < 1.4f || ky < 1.4f || kx > 8.f || ky > 8.f || std::fabs(kx - ky) > 0.03f * kx)
+	{
+		if (g_pf.logged < 8 && (kx > 1.1f || ky > 1.1f))
+		{
+			g_pf.logged++;
+			gxlog("pre-filter: source %08x %ux%u (guest %ux%u, xform scale %.3f %.3f) left alone: scale %.2f x %.2f",
+				desc->ref_address, iw, ih, tw, th, sx, sy, kx, ky);
+		}
+		return view;
+	}
+	// uniform downscale of the whole image by k: normalised coordinates (and the transform) stay valid
+	const u32 ow = std::max<u32>(1, static_cast<u32>(std::lround(iw / kx)));
+	const u32 oh = std::max<u32>(1, static_cast<u32>(std::lround(ih / ky)));
+	const u32 nx = std::min<u32>(4, static_cast<u32>(std::ceil(kx - 0.01f)));
+	const u32 ny = std::min<u32>(4, static_cast<u32>(std::ceil(ky - 0.01f)));
+
+	auto& st = g_pf;
+	const u64 uid = img->uid();
+	pf_entry* hit = nullptr;
+	pf_entry* lru = &st.e[0];
+	for (auto& e : st.e)
+	{
+		if (e.src_uid == uid && e.out && e.out->width() == ow && e.out->height() == oh) { hit = &e; break; }
+		if (e.used < lru->used) lru = &e;
+	}
+	st.tick++;
+	if (hit && hit->seq == g_bind_seq)
+	{
+		hit->used = st.tick;
+		return gx_view(hit->out.get());
+	}
+	if (!hit)
+	{
+		hit = lru;
+		if (hit->out) vk::get_resource_manager()->dispose(hit->out);
+		hit->out = gx_make_image(VK_FORMAT_R16G16B16A16_SFLOAT, ow, oh, VK_IMAGE_USAGE_STORAGE_BIT | VK_IMAGE_USAGE_SAMPLED_BIT);
+		if (!hit->out) { hit->src_uid = 0; return view; }
+		hit->src_uid = uid;
+		if (st.logged < 8)
+		{
+			st.logged++;
+			gxlog("pre-filter: source %08x %ux%u (guest %ux%u, %.2fx, gcm fmt %02x, vk fmt %d) -> %ux%u box %ux%u for a %ux%u pass",
+				desc->ref_address, iw, ih, tw, th, kx, gfmt, static_cast<int>(vf), ow, oh, nx, ny, L.width, L.height);
+		}
+	}
+	hit->seq = g_bind_seq;
+	hit->used = st.tick;
+
+	auto& cmd = *m_current_command_buffer;
+	if (vk::is_renderpass_open(cmd))
+	{
+		vk::end_renderpass(cmd);
+		if (cmd.flags & vk::command_buffer::cb_has_open_query) emergency_query_cleanup(m_current_command_buffer);
+	}
+	// the source's writes were made visible to fragment reads only
+	vk::insert_global_memory_barrier(cmd, VK_PIPELINE_STAGE_ALL_COMMANDS_BIT, VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT,
+		VK_ACCESS_MEMORY_WRITE_BIT, VK_ACCESS_SHADER_READ_BIT);
+	hit->out->change_layout(cmd, VK_IMAGE_LAYOUT_GENERAL);
+	{
+		auto pass = vk::get_compute_task<vk::r2gx_prefilter_pass>();
+		pass->in_src = view;
+		pass->out_dst = gx_view(hit->out.get());
+		const float k[4] = { static_cast<float>(ow), static_cast<float>(oh), static_cast<float>(nx), static_cast<float>(ny) };
+		pass->run(cmd, k, ow, oh);
+	}
+	hit->out->change_layout(cmd, VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL);
+	cmd.r2_invalidate_state_cache();
+	m_current_command_buffer->flags |= vk::command_buffer::cb_reload_dynamic_state;
+	if (!st.runs++ || (st.runs % 3600) == 0) gxlog("pre-filter: %u runs", st.runs);
+	return gx_view(hit->out.get());
+}
+
+// ---------------------------------------------------------------------------------------------------------
+// RSX_AA_SCREEN_LINEAR (default 1, 0 = off; 2 = 8-bit RGBA screen targets too): screen-sized buffers at a finer
+// host resolution than the pass that reads them get a bilinear sampler instead of the guest's point sampler
+// ---------------------------------------------------------------------------------------------------------
+// R3 is light-pre-pass: the light buffer (RGBA16F) and an R8 screen mask stay at the full 3x scale (2880x2112)
+// while the scene that reads them is reduced to the DLSS input (1440x1056). The material pass point-samples them
+// at its pixel centres, i.e. exactly on the corner of a 2x2 texel block: which texel wins is decided by the
+// rounding of the interpolated, jittered coordinate, so every frame each pixel takes the lighting of a random
+// neighbour one light-pass pixel away. At shadow edges / normal-mapped lighting that is white noise DLSS cannot
+// resolve (r11: shadow edges 0.36-0.45 display px position std on a still camera vs 0.11 for texture edges).
+// On the PS3 both have the same size, so the point sample is exact; bilinear over the 2x2 block is the box
+// average the guest would have needed. Only same-guest-size, non-depth, unnormalised-free, clamped colour reads.
+vk::sampler* VKGSRender::r2gx_screen_sampler(u32 slot, vk::image_view* view, const rsx::sampled_image_descriptor_base* desc)
+{
+	static const int mode = []
+	{
+		int m = 1;
+		if (const char* e = std::getenv("RSX_AA_SCREEN_LINEAR"); e && *e) m = std::clamp(std::atoi(e), 0, 2);
+		gxlog("screen linear %d (RSX_AA_SCREEN_LINEAR; point-sampled screen buffers at a finer host resolution than the reading pass are read bilinear; 0: off)", m);
+		return m;
+	}();
+	if (!mode || !view || !desc) return nullptr;
+	if (desc->upload_context != rsx::texture_upload_context::framebuffer_storage || desc->is_cyclic_reference ||
+		desc->image_type != rsx::texture_dimension_extended::texture_dimension_2d)
+		return nullptr;
+	const auto& tex = REGS(m_ctx)->fragment_textures[slot];
+	if (tex.format() & CELL_GCM_TEXTURE_UN) return nullptr;
+	const auto minf = tex.min_filter();
+	if ((minf != rsx::texture_minify_filter::nearest && minf != rsx::texture_minify_filter::nearest_nearest) ||
+		tex.mag_filter() != rsx::texture_magnify_filter::nearest)
+		return nullptr;
+	const auto wrap_ok = [](rsx::texture_wrap_mode w) { return w != rsx::texture_wrap_mode::wrap && w != rsx::texture_wrap_mode::mirror; };
+	if (!wrap_ok(tex.wrap_s()) || !wrap_ok(tex.wrap_t())) return nullptr;
+	auto* img = view->image();
+	if (!img || img->samples() > 1 || view->info.subresourceRange.aspectMask != VK_IMAGE_ASPECT_COLOR_BIT) return nullptr;
+	const VkFormat vf = view->info.format;
+	const bool fmt_ok = vf == VK_FORMAT_R16G16B16A16_SFLOAT || vf == VK_FORMAT_R16G16_SFLOAT || vf == VK_FORMAT_R16_SFLOAT ||
+		vf == VK_FORMAT_R8_UNORM ||
+		(mode >= 2 && (vf == VK_FORMAT_B8G8R8A8_UNORM || vf == VK_FORMAT_R8G8B8A8_UNORM));
+	// screen-sized: the texture has the guest size of the pass reading it
+	const auto& vp = m_ctx->draw_state.viewport;
+	const u32 tw = tex.width(), th = tex.height();
+	if (!vp.clip_width || !vp.clip_height || tw + 1u < vp.clip_width || tw > vp.clip_width + 1u ||
+		th + 1u < vp.clip_height || th > vp.clip_height + 1u)
+		return nullptr;
+	// ... at a finer host resolution than that pass (the reduced DLSS-input scene reading a full-scale buffer)
+	const auto [cw, ch] = rsx::apply_resolution_scale<true>(RSX(m_ctx)->resolution_scaling_config, vp.clip_width, vp.clip_height);
+	const float sx = desc->texcoord_xform.scale[0], sy = desc->texcoord_xform.scale[1];
+	const float hw = img->width() * (sx > 0.f && sx <= 1.01f ? sx : 1.f), hh = img->height() * (sy > 0.f && sy <= 1.01f ? sy : 1.f);
+	if (!cw || !ch) return nullptr;
+	const float kx = hw / cw, ky = hh / ch;
+	if (kx < 1.4f || ky < 1.4f || std::fabs(kx - ky) > 0.05f * kx) return nullptr;
+	static u32 s_logged = 0, s_skipped = 0;
+	static u64 s_runs = 0;
+	if (!fmt_ok)
+	{
+		if (s_skipped < 4)
+		{
+			s_skipped++;
+			gxlog("screen linear: %08x %ux%u (guest %ux%u, vk fmt %d) read by a %ux%u pass left point-sampled: format (RSX_AA_SCREEN_LINEAR=2 adds 8-bit RGBA)",
+				desc->ref_address, img->width(), img->height(), tw, th, static_cast<int>(vf), cw, ch);
+		}
+		return nullptr;
+	}
+	if (!m_r2_screen_linear_sampler)
+	{
+		m_r2_screen_linear_sampler = std::make_unique<vk::sampler>(*m_device,
+			VK_SAMPLER_ADDRESS_MODE_CLAMP_TO_EDGE, VK_SAMPLER_ADDRESS_MODE_CLAMP_TO_EDGE, VK_SAMPLER_ADDRESS_MODE_CLAMP_TO_EDGE,
+			VK_FALSE, 0.f, 1.f, 0.f, 0.f,
+			VK_FILTER_LINEAR, VK_FILTER_LINEAR, VK_SAMPLER_MIPMAP_MODE_NEAREST,
+			VK_BORDER_COLOR_FLOAT_TRANSPARENT_BLACK);
+	}
+	if (s_logged < 8)
+	{
+		s_logged++;
+		gxlog("screen linear: %08x %ux%u (guest %ux%u, vk fmt %d, unit %u) read by a %ux%u pass (%.2fx) sampled bilinear instead of point",
+			desc->ref_address, img->width(), img->height(), tw, th, static_cast<int>(vf), slot, cw, ch, kx);
+	}
+	if (!(s_runs++ % 200000)) gxlog("screen linear: %llu reads bilinear", static_cast<unsigned long long>(s_runs));
+	return m_r2_screen_linear_sampler.get();
+}
+
+// ---------------------------------------------------------------------------------------------------------
+// RSX_DECAL_ZBIAS=<D24 steps> (default 96, 0 = off): decal quads pulled towards the camera
+// ---------------------------------------------------------------------------------------------------------
+// R3 posters are alpha-tested, depth-writing single quads drawn into the scene with LEQUAL and no polygon offset,
+// not quite parallel to the wall behind them: the visible edge is where the two surfaces cross in depth (~2 depth
+// steps per render pixel at 1920 wide), and jitter plus the different internal resolutions of the passes move
+// that line every frame. A constant bias in depth steps is independent of the render resolution.
+float r2gx::decal_bias_steps()
+{
+	static const float steps = []
+	{
+		float r = 96.f;
+		if (const char* e = std::getenv("RSX_DECAL_ZBIAS"); e && *e) r = std::clamp(static_cast<float>(std::atof(e)), 0.f, 4096.f);
+		gxlog("decal depth bias %.0f steps (RSX_DECAL_ZBIAS; alpha-tested depth-writing quads of <= 6 vertices in the scene pass)", r);
+		return r;
+	}();
+	return steps;
+}
+
+bool r2gx::scene_bound()
+{
+	return g_gx.cur_scene;
+}
+
+u64 r2gx::decal_key(const u32* words, usz count)
+{
+	u64 h = 1469598103934665603ull;
+	for (usz i = 0; i < count; ++i)
+		h = (h ^ words[i]) * 1099511628211ull;
+	return h;
+}
+
+namespace
+{
+	// RSX_DECAL_ZBIAS_PAIR: learn from the frame whose pre-pass table is about to be dropped
+	void decal_pair_learn(gx_state& st)
+	{
+		if (!r2gx::decal_pair_mode()) return;
+		struct agg { u32 entries, exact, lost; };
+		std::unordered_map<u64, agg> per;
+		for (const auto& e : st.pair_e)
+		{
+			auto& a = per[e.ckey];
+			++a.entries;
+			if (e.puses == 1) ++a.exact;
+			if (e.pbiased && !e.puses) ++a.lost;
+		}
+		for (const auto& [k, n] : st.pair_mis) per[k];
+		// an incomplete table (full) proves nothing either way, except for biased draws that were not redrawn
+		const bool learn = !st.decal_frame_unsafe && !st.pair_frame_full;
+		for (const auto& [k, a] : per)
+		{
+			const auto mis = st.pair_mis.find(k);
+			const u32 mismatched = mis == st.pair_mis.end() ? 0u : mis->second;
+			auto it = st.pair_learn.find(k);
+			if (it == st.pair_learn.end())
+			{
+				// only keys that paired at least once are worth remembering
+				if (!learn || !a.entries || a.exact != a.entries || mismatched) continue;
+				if (st.pair_learn.size() >= gx_state::pair_learn_cap)
+				{
+					std::erase_if(st.pair_learn, [&](const auto& kv) { return kv.second.confirm < gx_state::pair_need && st.frame >= kv.second.block_until; });
+					if (st.pair_learn.size() >= gx_state::pair_learn_cap) st.pair_learn.clear();
+				}
+				it = st.pair_learn.emplace(k, pdq_pair_state{ 0u, 0u }).first;
+			}
+			if (!learn && !a.lost) continue;
+			const unsigned before = it->second.confirm;
+			pdq_pair_frame_end(&it->second, st.frame, a.entries, a.exact, mismatched, a.lost, gx_state::pair_block);
+			if (a.lost) st.pair_lost += a.lost;
+			else if (it->second.confirm > before) ++st.pair_confirmed_frames;
+			else if (before) ++st.pair_broken;
+		}
+		st.pair_mis.clear();
+	}
+
+	void decal_frame_reset(gx_state& st)
+	{
+		if (st.decal_frame == st.frame) return;
+		decal_pair_learn(st);
+		st.decal_prev_unsafe = st.decal_frame_unsafe && st.decal_frame + 1 == st.frame;
+		st.decal_frame = st.frame;
+		st.decal_frame_biased = false;
+		st.decal_frame_unsafe = false;
+		st.decal_frame_notes = 0;
+		st.decal_e.clear();
+		st.decal_cid.clear();
+		st.decal_cval.clear();
+		st.pair_e.clear();
+		st.pair_frame_full = false;
+	}
+
+	// RSX_DECAL_ZBIAS_EQGUARD (default 1; 0 = off): no pre-pass bias near a depth EQUAL material pass. R3's material
+	// redraws are mostly batched (12..3000+ indices for quads the pre-pass drew one by one) and cannot be matched
+	// to a quad key, so a biased pre-pass quad leaves its pre-pass normals visible (neon green floors / foliage)
+	bool decal_eqguard()
+	{
+		static const bool on = []
+		{
+			const char* e = std::getenv("RSX_DECAL_ZBIAS_EQGUARD");
+			const bool r = !(e && *e == '0');
+			gxlog("decal bias EQUAL guard %s (RSX_DECAL_ZBIAS_EQGUARD; forward-rendered scenes only)", r ? "on" : "off");
+			return r;
+		}();
+		return on;
+	}
+
+	// RSX_DECAL_ZBIAS_FOLLOW (default 1; 0 = off): the poisoned-key table
+	bool decal_follow()
+	{
+		static const bool on = [] { const char* e = std::getenv("RSX_DECAL_ZBIAS_FOLLOW"); return !(e && *e == '0'); }();
+		return on;
+	}
+
+	gx_state::decal_poison_ent* decal_poison_find(gx_state& st, u64 key, bool insert)
+	{
+		const u64 k = key | 1;
+		const u32 h = static_cast<u32>(k ^ (k >> 29));
+		gx_state::decal_poison_ent* oldest = nullptr;
+		for (u32 i = 0; i < gx_state::decal_poison_probe; ++i)
+		{
+			auto& v = st.decal_poison[(h + i) & (gx_state::decal_poison_n - 1)];
+			if (v.key == k) return &v;
+			if (!v.key)
+			{
+				if (!insert) return nullptr;
+				v = { k, 0, 0 };
+				return &v;
+			}
+			if (!oldest || v.last < oldest->last) oldest = &v;
+		}
+		if (!insert) return nullptr;
+		if (oldest->misses >= gx_state::decal_poison_k && st.decal_poison_cnt) --st.decal_poison_cnt;
+		*oldest = { k, 0, 0 }; // probe run full: replace its least recently missed key
+		return oldest;
+	}
+
+	bool decal_poison_live(const gx_state& st, const gx_state::decal_poison_ent& v)
+	{
+		return v.misses >= gx_state::decal_poison_k && st.frame - v.last <= gx_state::decal_poison_age;
+	}
+
+	bool decal_poisoned(gx_state& st, u64 key)
+	{
+		const auto* v = decal_poison_find(st, key, false);
+		return v && decal_poison_live(st, *v);
+	}
+
+	void decal_poison(gx_state& st, u64 key)
+	{
+		if (st.decal_frame_unsafe || (!st.decal_frame_notes && st.decal_prev_unsafe))
+		{
+			// the table missed draws: this frame's, or (no pre-pass draw yet this frame: the redraw follows the
+			// previous frame's pre-pass) the previous frame's. Not counted
+			++st.decal_unsafe;
+			return;
+		}
+		auto* v = decal_poison_find(st, key, true);
+		if (v->misses && st.frame - v->last > gx_state::decal_poison_age)
+		{
+			if (v->misses >= gx_state::decal_poison_k && st.decal_poison_cnt) --st.decal_poison_cnt;
+			v->misses = 0; // expired: count afresh
+		}
+		if (v->misses && v->last == st.frame) return; // one miss per frame
+		v->last = st.frame;
+		if (++v->misses == gx_state::decal_poison_k)
+		{
+			++st.decal_poison_cnt;
+			++st.decal_poison_new;
+		}
+	}
+
+	void decal_unpoison(gx_state& st, u64 key)
+	{
+		auto* v = decal_poison_find(st, key, false);
+		if (!v || !v->misses) return;
+		if (v->misses >= gx_state::decal_poison_k)
+		{
+			if (st.decal_poison_cnt) --st.decal_poison_cnt;
+			++st.decal_unpoison;
+		}
+		v->misses = 0; // the slot stays (open addressing); 0 misses = not poisoned
+	}
+
+	void decal_poison_clear(gx_state& st)
+	{
+		if (!st.decal_poison_cnt)
+		{
+			bool any = false;
+			for (const auto& v : st.decal_poison)
+				if (v.misses) { any = true; break; }
+			if (!any) return;
+		}
+		std::memset(st.decal_poison, 0, sizeof(st.decal_poison));
+		st.decal_poison_cnt = 0;
+		++st.decal_clears;
+	}
+
+	u32 decal_bucket(u64 key)
+	{
+		return static_cast<u32>(key ^ (key >> 32)) & (gx_state::decal_buckets - 1);
+	}
+
+	// the recorded constants agree with the current ones on every register both vertex programs read
+	// (none shared or none recorded: no evidence against)
+	bool decal_consts_agree(const gx_state& st, const gx_state::decal_entry& e, const r2gx::decal_vs& vs)
+	{
+		for (u32 i = 0, j = 0; i < e.c_n; ++i)
+		{
+			const u16 id = st.decal_cid[e.c_off + i];
+			if (!vs.all)
+			{
+				while (j < vs.n && vs.ids[j] < id) ++j;
+				if (j == vs.n) break;
+				if (vs.ids[j] != id) continue;
+			}
+			if (std::memcmp(st.decal_cval[e.c_off + i].data(), vs.regs[id], 16) != 0) return false;
+		}
+		return true;
+	}
+
+	// RSX_DECAL_ZBIAS_PAIR: registers both programs read, compared (shared) and found different (differing)
+	void decal_consts_cmp(const gx_state& st, const gx_state::decal_entry& e, const r2gx::decal_vs& vs, u32& shared, u32& differing)
+	{
+		shared = differing = 0;
+		for (u32 i = 0, j = 0; i < e.c_n; ++i)
+		{
+			const u16 id = st.decal_cid[e.c_off + i];
+			if (!vs.all)
+			{
+				while (j < vs.n && vs.ids[j] < id) ++j;
+				if (j == vs.n) break;
+				if (vs.ids[j] != id) continue;
+			}
+			++shared;
+			if (std::memcmp(st.decal_cval[e.c_off + i].data(), vs.regs[id], 16) != 0) ++differing;
+		}
+	}
+
+	// the pre-pass draw of this frame an EQUAL quad redraw repeats by content: same position bytes and the same
+	// values in every shared transform constant (at least pair_min_shared); the least paired, oldest one
+	gx_state::pair_entry* decal_pair_find(gx_state& st, const r2gx::decal_vs& vs, bool& seen)
+	{
+		seen = false;
+		const u32 b = decal_bucket(vs.ckey);
+		if (st.decal_chead_frame[b] != st.frame) return nullptr;
+		gx_state::pair_entry* pick = nullptr;
+		for (u32 i = st.decal_chead[b]; i; i = st.pair_e[i - 1].cnext)
+		{
+			auto& e = st.pair_e[i - 1];
+			if (e.ckey != vs.ckey) continue;
+			seen = true;
+			u32 shared, differing;
+			decal_consts_cmp(st, st.decal_e[e.eidx - 1], vs, shared, differing);
+			if (!pdq_pair_consts_ok(shared, differing, gx_state::pair_min_shared)) continue;
+			if (!pick || e.puses <= pick->puses) pick = &e; // chain is newest first: '<=' ends on the oldest
+		}
+		return pick;
+	}
+
+	bool decal_pair_confirmed(gx_state& st, u64 ckey)
+	{
+		const auto it = st.pair_learn.find(ckey);
+		return it != st.pair_learn.end() && pdq_pair_bias(r2gx::decal_pair_mode(), &it->second, st.frame, gx_state::pair_need);
+	}
+}
+
+int r2gx::decal_pair_mode()
+{
+	static const int mode = []
+	{
+		int m = pdq_env_int("RSX_DECAL_ZBIAS_PAIR", 0);
+		if (m != 1 && m != 2) m = 0;
+		gxlog("decal pairing by content %s (RSX_DECAL_ZBIAS_PAIR=%d; 0 = off, 1 = bias learned pairs, 2 = learn and log only)",
+			m == 1 ? "on" : m == 2 ? "learning only" : "off", m);
+		return m;
+	}();
+	return mode;
+}
+
+bool r2gx::decal_note(u64 key, bool biased, const decal_vs& vs)
+{
+	auto& st = g_gx;
+	decal_frame_reset(st);
+	// RSX_DECAL_ZBIAS_PAIR=1: a learned pair (every redraw of this content followed its pre-pass draw on pair_need
+	// frames in a row) is biased whatever the alpha test, EQUAL guard and address-key misses say
+	const bool pmode = decal_pair_mode() != 0;
+	if (pmode && !vs.ckey) ++st.pair_noread;
+	// (only with room to record it: a pair-biased draw must be found by its redraw)
+	const bool pair = pmode && vs.ckey && st.pair_e.size() < gx_state::pair_cap && decal_pair_confirmed(st, vs.ckey);
+	if (pair) biased = true;
+	if (biased && !pair && decal_follow() && decal_poisoned(st, key))
+	{
+		++st.decal_refused;
+		biased = false;
+	}
+	if (biased && !pair && decal_eqguard() && st.frame <= st.decal_eq_frame + gx_state::decal_eq_quiet)
+	{
+		++st.decal_eq_held;
+		biased = false;
+	}
+	const u32 b = decal_bucket(key);
+	const bool store_c = !vs.all && vs.n && vs.n <= gx_state::decal_const_max;
+	const pdq_decal_id did = { key, vs.streams, biased ? 1 : 0, store_c ? 1 : 0 };
+	// RSX_DECAL_ZBIAS_PAIR: a content entry for this draw, linked to the decal entry it merged into or was added as
+	const auto pair_note = [&](u32 eidx)
+	{
+		if (!vs.ckey) return;
+		if (st.pair_e.size() >= gx_state::pair_cap)
+		{
+			st.pair_frame_full = true;
+			return;
+		}
+		const u32 cb = decal_bucket(vs.ckey);
+		st.pair_e.push_back({ vs.ckey, st.decal_chead_frame[cb] == st.frame ? st.decal_chead[cb] : 0u, eidx, u8{pair}, 0 });
+		st.decal_chead[cb] = static_cast<u32>(st.pair_e.size());
+		st.decal_chead_frame[cb] = st.frame;
+		if (pair) ++st.pair_pre_biased;
+	};
+	if (st.decal_head_frame[b] == st.frame)
+		for (u32 i = st.decal_head[b]; i; i = st.decal_e[i - 1].next)
+		{
+			const auto& e = st.decal_e[i - 1];
+			const pdq_decal_id eid = { e.key, e.streams, e.biased, e.c_n != 0 };
+			if (pdq_decal_same_draw(&eid, &did) && decal_consts_agree(st, e, vs))
+			{
+				if (biased) ++st.decal_biased;
+				if (pmode) pair_note(i);
+				return biased;
+			}
+		}
+	if (st.decal_e.size() >= gx_state::decal_cap)
+	{
+		if (biased) ++st.decal_full;
+		st.decal_frame_unsafe = true;
+		if (pmode && vs.ckey) st.pair_frame_full = true;
+		return false;
+	}
+	gx_state::decal_entry e{};
+	e.key = key;
+	e.streams = vs.streams;
+	e.next = st.decal_head_frame[b] == st.frame ? st.decal_head[b] : 0u;
+	e.c_off = static_cast<u32>(st.decal_cid.size());
+	e.biased = biased ? 1 : 0;
+	if (store_c && st.decal_cid.size() + vs.n <= gx_state::decal_const_cap)
+	{
+		for (usz i = 0; i < vs.n; ++i)
+		{
+			std::array<u32, 4> v;
+			std::memcpy(v.data(), vs.regs[vs.ids[i]], 16);
+			st.decal_cid.push_back(vs.ids[i]);
+			st.decal_cval.push_back(v);
+		}
+		e.c_n = static_cast<u16>(vs.n);
+	}
+	st.decal_e.push_back(e);
+	++st.decal_frame_notes;
+	st.decal_head[b] = static_cast<u32>(st.decal_e.size());
+	st.decal_head_frame[b] = st.frame;
+	if (pmode) pair_note(static_cast<u32>(st.decal_e.size()));
+	if (biased)
+	{
+		++st.decal_biased;
+		st.decal_frame_biased = true;
+	}
+	return biased;
+}
+
+// RSX_DECAL_ZBIAS_NOWRITE (default 0 = off; 1 = on): see pdq_decal_nowrite_bias (VKR2DlssQuality.h)
+bool r2gx::decal_nowrite(bool lequal, bool zwrite, bool color_write, bool stencil, bool tested, u32 elements)
+{
+	static const bool on = []
+	{
+		const bool r = pdq_env_int("RSX_DECAL_ZBIAS_NOWRITE", 0) != 0;
+		gxlog("decal bias for no-write LEQUAL alpha-tested quads without a pre-pass match %s (RSX_DECAL_ZBIAS_NOWRITE, opt-in)", r ? "on" : "off");
+		return r;
+	}();
+	if (!pdq_decal_nowrite_bias(on, lequal, zwrite, scene_bound(), color_write, stencil, tested, elements))
+		return false;
+	++g_gx.decal_nowrite;
+	return true;
+}
+
+void r2gx::decal_equal_seen()
+{
+	auto& st = g_gx;
+	st.decal_eq_frame = st.frame;
+	++st.decal_eq_draws;
+}
+
+bool r2gx::decal_match(u64 key, const decal_vs& vs, bool equal)
+{
+	auto& st = g_gx;
+	decal_frame_reset(st);
+	if (!equal && decal_pair_mode() == 1 && vs.ckey)
+	{
+		// a no-write LEQUAL overlay of a pair-biased quad follows it (else it fails its depth test and disappears)
+		bool seen = false;
+		if (auto* e = decal_pair_find(st, vs, seen); e && e->pbiased)
+		{
+			++st.decal_leq;
+			return true;
+		}
+	}
+	if (equal && decal_pair_mode())
+	{
+		// RSX_DECAL_ZBIAS_PAIR: by content first (the address key of R3's material pass rarely matches)
+		if (!vs.ckey) ++st.pair_noread;
+		else
+		{
+			bool seen = false;
+			if (auto* e = decal_pair_find(st, vs, seen))
+			{
+				++st.pair_matched;
+				if (e->puses < 255) ++e->puses;
+				if (decal_pair_mode() == 1)
+				{
+					auto& d = st.decal_e[e->eidx - 1];
+					if (d.uses < 255) ++d.uses;
+					++st.decal_redraws;
+					if (decal_follow()) decal_unpoison(st, key);
+					if (d.biased)
+					{
+						++st.decal_matched;
+						if (e->pbiased) ++st.pair_red_biased;
+					}
+					return d.biased != 0;
+				}
+			}
+			else if (seen)
+			{
+				++st.pair_mismatch;
+				++st.pair_mis[vs.ckey];
+			}
+			else ++st.pair_unmatched;
+		}
+	}
+	const u32 b = decal_bucket(key);
+	// every pre-pass draw of this geometry in the frame, newest first (the whole bucket chain: at most decal_cap
+	// entries, and only EQUAL quad redraws get here)
+	auto& cand = st.decal_cand;
+	auto& score = st.decal_score;
+	cand.clear();
+	u32 nb = 0;
+	if (st.decal_head_frame[b] == st.frame)
+		for (u32 i = st.decal_head[b]; i; i = st.decal_e[i - 1].next)
+			if (auto& e = st.decal_e[i - 1]; e.key == key)
+			{
+				cand.push_back(&e);
+				nb += e.biased;
+			}
+	const u32 nc = static_cast<u32>(cand.size());
+	if (equal) ++st.decal_redraws;
+	if (nc && equal && decal_follow()) decal_unpoison(st, key);
+	if (!nc)
+	{
+		if (equal)
+		{
+			++st.decal_missed;
+			if (decal_follow()) decal_poison(st, key);
+		}
+		return false;
+	}
+	gx_state::decal_entry* pick = cand[0];
+	if (nb != 0 && nb != nc)
+	{
+		// a shared quad drawn both biased and not: the pre-pass draw with the same vertex streams and transform
+		// constants, then the least used and oldest one (the material pass usually keeps the pre-pass order)
+		score.resize(nc);
+		u32 best = 0;
+		for (u32 i = 0; i < nc; ++i)
+		{
+			score[i] = (cand[i]->streams == vs.streams ? 2u : 0u) + (decal_consts_agree(st, *cand[i], vs) ? 1u : 0u);
+			best = std::max(best, score[i]);
+		}
+		u32 bb = 0, bn = 0;
+		pick = nullptr;
+		for (u32 i = nc; i-- > 0;)
+		{
+			if (score[i] != best) continue;
+			(cand[i]->biased ? bb : bn)++;
+			if (!pick || cand[i]->uses < pick->uses) pick = cand[i];
+		}
+		if (bb && bn) ++st.decal_ambig;
+	}
+	if (pick->uses < 255) ++pick->uses;
+	if (pick->biased) ++(equal ? st.decal_matched : st.decal_leq);
+	return pick->biased != 0;
+}
