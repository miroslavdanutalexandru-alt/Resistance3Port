+# R2PORT perf: CMake's RelWithDebInfo passes /Ob1, which clang-cl turns into
+# -finline-hint-functions: only functions spelt `inline` are inlined. STL
+# one-liners such as std::_Atomic_address_as (every std::atomic op), vm::cast,
+# FIFO_control::sync_get and vector allocation helpers stayed out-of-line calls
+# on rsx::thread. /Ob2 (the Release default, which upstream RPCS3 ships) restores
+# normal inlining for this project and its subprojects (asmjit, glslang,
+# yaml-cpp, fossilize). It changes no float semantics: no /arch and no
+# -ffp-contract change. -DRPCS3_RSX_FULL_INLINE=OFF builds the old way.
+option(RPCS3_RSX_FULL_INLINE "Normal inlining (/Ob2) in RelWithDebInfo" ON)
+if(RPCS3_RSX_FULL_INLINE)
+    foreach(_v CMAKE_C_FLAGS_RELWITHDEBINFO CMAKE_CXX_FLAGS_RELWITHDEBINFO)
+        string(REPLACE "/Ob1" "/Ob2" ${_v} "${${_v}}")
+    endforeach()
+endif()
+
+# R2PORT perf: code-generation options for rpcs3_rsx itself (rsx::thread, the VK backend, the bridge). ARCH and
+# GS_OFF do not change float results: /fp:precise stays, and AVX2 builds pass -mno-fma: clang-cl's default
+# -ffp-contract=on still emits llvm.fmuladd for a*b+c, folded fused at compile time and run as a separate
+# multiply + add, exactly as in the generic build (with FMA enabled they would fuse at run time; with
+# -ffp-contract=off the compile-time folds would round differently - the dlss_quality tests catch that). The defaults build the old way; build.bat passes
+# RPCS3_RSX_ARCH=AVX2 and RPCS3_RSX_LTO=ON (the exe already needs x86-64-v3: PORT_PPU_V3).
+#   RPCS3_RSX_ARCH=generic|AVX2   AVX2 = -march=x86-64-v3 -mno-fma (AVX2/BMI2/MOVBE/F16C, no FMA)
+#   RPCS3_RSX_GS_OFF=ON           /GS- (no stack cookies) and /Gw (per-variable COMDATs)
+#   RPCS3_RSX_LTO=ON              ThinLTO bitcode objects (clang-cl only; the exe must link with lld-link)
+#                                 Not bit-identical to the non-LTO build: a cross-TU inline that makes a*b+c constant
+#                                 is folded fused (same semantics as /O2 with -ffp-contract=on). PGO likewise.
+#   RPCS3_RSX_PGO=off|gen|use     clang instrumentation PGO; use needs RPCS3_RSX_PGO_PROFILE=<.profdata>.
+#                                 gen objects need clang_rt.profile at the exe link (project/CMakeLists.txt adds it).
+# The choice is written to <build>/rpcs3_rsx_codegen.txt for the game's CMake (LTO cache, profile runtime).
+set(RPCS3_RSX_ARCH "generic" CACHE STRING "rpcs3_rsx CPU target: generic | AVX2 (x86-64-v3 without FMA)")
+option(RPCS3_RSX_GS_OFF "rpcs3_rsx: /GS- and /Gw" ON)
+option(RPCS3_RSX_LTO "rpcs3_rsx: ThinLTO bitcode objects" OFF)
+set(RPCS3_RSX_PGO "off" CACHE STRING "rpcs3_rsx PGO: off | gen | use")
+set(RPCS3_RSX_PGO_PROFILE "" CACHE FILEPATH "Merged .profdata for RPCS3_RSX_PGO=use")
+if(NOT RPCS3_RSX_ARCH MATCHES "^(generic|AVX2)$")
+    message(FATAL_ERROR "RPCS3_RSX_ARCH must be generic or AVX2 (got '${RPCS3_RSX_ARCH}')")
+endif()
+if(NOT RPCS3_RSX_PGO MATCHES "^(off|gen|use)$")
+    message(FATAL_ERROR "RPCS3_RSX_PGO must be off, gen or use (got '${RPCS3_RSX_PGO}')")
+endif()
+set(RPCS3_RSX_CODEGEN_FLAGS "")
+if(RPCS3_RSX_GS_OFF)
+    list(APPEND RPCS3_RSX_CODEGEN_FLAGS /GS- /Gw)
+endif()
+if(CMAKE_CXX_COMPILER_ID MATCHES "Clang")
+    if(RPCS3_RSX_ARCH STREQUAL "AVX2")
+        list(APPEND RPCS3_RSX_CODEGEN_FLAGS /clang:-march=x86-64-v3 /clang:-mno-fma)
+    endif()
+    if(RPCS3_RSX_LTO)
+        list(APPEND RPCS3_RSX_CODEGEN_FLAGS -flto=thin)
+    endif()
+    if(RPCS3_RSX_PGO STREQUAL "gen")
+        list(APPEND RPCS3_RSX_CODEGEN_FLAGS -fprofile-instr-generate)
+    elseif(RPCS3_RSX_PGO STREQUAL "use")
+        if(NOT EXISTS "${RPCS3_RSX_PGO_PROFILE}")
+            message(FATAL_ERROR "RPCS3_RSX_PGO=use needs RPCS3_RSX_PGO_PROFILE=<merged .profdata> (got '${RPCS3_RSX_PGO_PROFILE}')")
+        endif()
+        file(TO_NATIVE_PATH "${RPCS3_RSX_PGO_PROFILE}" _rsx_pd)
+        list(APPEND RPCS3_RSX_CODEGEN_FLAGS "-fprofile-instr-use=${_rsx_pd}" -Wno-profile-instr-unprofiled
+             -Wno-profile-instr-out-of-date -Wno-backend-plugin)
+    endif()
 else()
-    if(NOT CMAKE_BUILD_TYPE)
-        message(STATUS "No build type selected, default to Release")
-        set(CMAKE_BUILD_TYPE "Release")
