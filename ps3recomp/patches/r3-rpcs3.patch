+	// float -> IEEE half bits (round to nearest; below the normal range flushes to zero, overflow saturates)
+	u32 r2_half(float v)
+	{
+		const u32 x = std::bit_cast<u32>(v);
+		const u32 sign = (x >> 16) & 0x8000u;
+		const int e = static_cast<int>((x >> 23) & 0xff) - 127 + 15;
+		if (e <= 0) return sign;
+		if (e >= 31) return sign | 0x7bffu;
+		u32 h = sign | (static_cast<u32>(e) << 10) | ((x >> 13) & 0x3ffu);
+		if (x & 0x1000u) h++; // carries into the exponent correctly
+		return std::min(h, sign | 0x7bffu);
+	}
+
+	// ---- small double-precision 4x4 math (row-major m[row][col]) ----
+	struct m4
+	{
+		double m[4][4];
+	};
+
+	m4 m4_identity()
+	{
+		m4 r{};
+		for (int i = 0; i < 4; ++i) r.m[i][i] = 1.0;
+		return r;
+	}
+
+	m4 m4_mul(const m4& a, const m4& b)
+	{
+		m4 r{};
+		for (int i = 0; i < 4; ++i)
+			for (int j = 0; j < 4; ++j)
+			{
+				double s = 0;
+				for (int k = 0; k < 4; ++k) s += a.m[i][k] * b.m[k][j];
+				r.m[i][j] = s;
+			}
+		return r;
+	}
+
+	bool m4_inverse(const m4& in, m4& out)
+	{
+		double a[4][8];
+		double scale = 0;
+		for (int i = 0; i < 4; ++i)
+			for (int j = 0; j < 4; ++j)
+			{
+				a[i][j] = in.m[i][j];
+				a[i][j + 4] = i == j ? 1.0 : 0.0;
+				scale = std::fmax(scale, std::fabs(in.m[i][j]));
+			}
+		if (!(scale > 0) || !std::isfinite(scale)) return false;
+		for (int c = 0; c < 4; ++c)
+		{
+			int p = c;
+			for (int r = c + 1; r < 4; ++r)
+				if (std::fabs(a[r][c]) > std::fabs(a[p][c])) p = r;
+			if (std::fabs(a[p][c]) < 1e-9 * scale) return false;
+			if (p != c)
+				for (int j = 0; j < 8; ++j) std::swap(a[p][j], a[c][j]);
+			const double inv = 1.0 / a[c][c];
+			for (int j = 0; j < 8; ++j) a[c][j] *= inv;
+			for (int r = 0; r < 4; ++r)
+			{
+				if (r == c) continue;
+				const double f = a[r][c];
+				if (f == 0) continue;
+				for (int j = 0; j < 8; ++j) a[r][j] -= f * a[c][j];
+			}
+		}
+		for (int i = 0; i < 4; ++i)
+			for (int j = 0; j < 4; ++j) out.m[i][j] = a[i][j + 4];
+		return true;
+	}
+
+	double m4_maxabs(const m4& a)
+	{
+		double r = 0;
+		for (auto& row : a.m) for (double v : row) r = std::fmax(r, std::fabs(v));
+		return r;
+	}
+
+	double m4_maxdiff(const m4& a, const m4& b)
+	{
+		double r = 0;
+		for (int i = 0; i < 4; ++i) for (int j = 0; j < 4; ++j) r = std::fmax(r, std::fabs(a.m[i][j] - b.m[i][j]));
+		return r;
+	}
+
+	// Screen transform of the vertex env: (sx,ox,sy,oy,sz,oz) -> 4x4 applied to the raw clip position
+	struct screen_xform
+	{
+		float sx = 1, ox = 0, sy = 1, oy = 0, sz = 1, oz = 0, n = 0, f = 1;
+		bool valid = false;
+	};
+
+	m4 m4_screen(const screen_xform& s)
+	{
+		m4 r{};
+		r.m[0][0] = s.sx; r.m[0][3] = s.ox;
+		r.m[1][1] = s.sy; r.m[1][3] = s.oy;
+		r.m[2][2] = s.sz; r.m[2][3] = s.oz;
+		r.m[3][3] = 1.0;
+		return r;
+	}
+
+	// Camera of a perspective world -> clip matrix V (rows: clip x, y, z, w) for FSR / frame generation: distances along
+	// the view axis at depth buffer values 0 and 1 (near / far, as the upscalers' depth linearisation expects) and the
+	// vertical FOV. Window depth = S.sz * z/w + S.oz, buffer = (window - zB) / zA. False unless V is a plain pinhole
+	// projection (clip z row parallel to the w row) with plausible results.
+	bool camera_planes(const m4& V, const screen_xform& S, double zA, double zB, double& n, double& f, double& fov)
+	{
+		double ww = 0, zw = 0, zz = 0, yy = 0;
+		for (int i = 0; i < 3; ++i)
+		{
+			ww += V.m[3][i] * V.m[3][i];
+			zw += V.m[2][i] * V.m[3][i];
+			zz += V.m[2][i] * V.m[2][i];
+			yy += V.m[1][i] * V.m[1][i];
+		}
+		if (!(ww > 1e-20) || !(yy > 1e-20) || std::fabs(S.sz) < 1e-9 || std::fabs(zA) < 1e-9) return false;
+		const double a = zw / ww;                         // clip z = a * w + b
+		if (zz - a * a * ww > 1e-6 * zz) return false;
+		const double b = V.m[2][3] - a * V.m[3][3];
+		const double wl = std::sqrt(ww);                  // view distance = w / wl
+		auto dist = [&](double t)
+		{
+			const double q = ((t * zA + zB) - S.oz) / S.sz - a;
+			return std::fabs(q) > 1e-12 ? b / (wl * q) : -1.0;
+		};
+		const double d0 = dist(0.0), d1 = dist(1.0);
+		const bool p0 = std::isfinite(d0) && d0 > 0, p1 = std::isfinite(d1) && d1 > 0;
+		if (p0 && p1) { n = std::fmin(d0, d1); f = std::fmax(d0, d1); }
+		else if (p0 || p1) { n = p0 ? d0 : d1; f = n * 1e5; } // far plane at infinity
+		else return false;
+		fov = 2.0 * std::atan(wl / std::sqrt(yy));
+		return n > 1e-6 && f > n * 1.001 && std::isfinite(f) && fov > 0.05 && fov < 3.0;
+	}
