+			if (!e.id || e.id > nid) continue;
+			float* t = tab.data() + (e.id - 1) * 20u;
+			float strength = 0.f;
+			bool own = false;
+			m4 inv;
+			if ((e.om & om_rigid) && have_R && e.state == 1 && st.prev_F.e[e.prev].state == 1 && m4_inverse(e.M, inv))
+			{
+				const m4& Mp = st.prev_F.e[e.prev].M;
+				const m4 Rk = m4_mul(Mp, inv);
+				if (m4_maxdiff(Rk, Rcam) > 1e-3 * (1.0 + m4_maxabs(Rk)))
+				{
+					// Plausibility: the object's origin moves by at most RSX_DLSS_OBJMV_LIMIT of the screen relative to
+					// the camera prediction; more is a wrong match (another instance of the same mesh)
+					double a[4], b[4];
+					for (int r = 0; r < 4; ++r)
+					{
+						a[r] = Mp.m[r][3];
+						b[r] = 0;
+						for (int k = 0; k < 4; ++k) b[r] += Rcam.m[r][k] * e.M.m[k][3];
+					}
+					const double d = (std::fabs(a[3]) > 1e-9 && std::fabs(b[3]) > 1e-9)
+						? std::hypot(a[0] / a[3] - b[0] / b[3], a[1] / a[3] - b[1] / b[3]) * 0.5 : 1e9;
+					if (std::isfinite(d) && d <= r2cfg().om_max_motion)
+					{
+						const m4 Tk = m4_mul(Sp, m4_mul(Rk, Rsci));
+						for (int c = 0; c < 4; ++c)
+							for (int r = 0; r < 4; ++r) t[c * 4 + r] = static_cast<float>(Tk.m[r][c]);
+						own = true;
+					}
+					else if (mask_new)
+					{
+						strength = r2cfg().bias_new;
+					}
+				}
+			}
+			if (r2cfg().biasmask)
+			{
+				if (e.om & om_dyn) strength = std::fmax(strength, r2cfg().bias_dyn);
+				if (e.om & om_skin) strength = std::fmax(strength, r2cfg().bias_skin);
+				if ((e.om & om_new) && mask_new) strength = std::fmax(strength, r2cfg().bias_new);
+			}
+			t[16] = own ? 1.f : 0.f;
+			t[17] = strength;
+			if (own) st.om_objmv++;
+			if (strength > 0.f) st.om_masked++;
