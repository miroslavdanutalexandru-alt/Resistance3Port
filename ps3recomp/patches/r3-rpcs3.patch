+				case VK_FORMAT_D16_UNORM: mode = 4; asp = VK_IMAGE_ASPECT_DEPTH_BIT; break;
+				case VK_FORMAT_R16_UNORM: mode = 4; break;
+				case VK_FORMAT_R8_UNORM: mode = 5; break;
+				default: break;
+				}
+				if (mode == 6)
+				{
+					st.stat_ps_skip_fmt++;
+					st.ps_last_skip_fmt = static_cast<u32>(fmt);
+					pdg(addr, 5, s->width(), s->height(), static_cast<u32>(fmt));
+					continue;
+				}
+				const u32 w = s->width(), h = s->height();
