+
+	cmd.r2_invalidate_state_cache();
+	m_current_command_buffer->flags |= vk::command_buffer::cb_reload_dynamic_state;
+
+	if (!st.runs++)
+	{
+		r2log("first frame processed (%u scene draws, camera motion %s)", st.scene_draws, st.vote_hits ? "found" : "not yet");
+	}
+	st.ran_ok = true;
+	st.stat_runs++;
+	st.last_skip.clear();
+}
+
+namespace
+{
+	// RSX_DLSS_OBJMV: ID-redraw pipelines. The game's vertex shader and pipeline layout (so the bound descriptor sets
+	// and push constants stay valid), a fragment shader writing (1, depth) blended with the constant (id, 1): the
+	// target gets (id, depth). Built on a worker thread; a draw whose pipeline is not ready yet is simply not redrawn.
+	struct om_pipe_job
+	{
+		u64 key;
+		VkShaderModule vs;
+		VkPipelineLayout layout;
+		VkRenderPass rp;
+		VkPipelineInputAssemblyStateCreateInfo ia;
+		VkPipelineRasterizationStateCreateInfo rs;
+		VkCompareOp cmp;
+	};
+
+	struct om_pipes_t
+	{
+		std::mutex mtx;
+		std::condition_variable cv;
+		std::unordered_map<u64, VkPipeline> done; // VK_NULL_HANDLE: creation failed
+		std::unordered_set<u64> queued;
+		std::vector<om_pipe_job> jobs;
+		VkDevice dev = VK_NULL_HANDLE;
+		bool depth_bounds = false;
+		vk::glsl::shader fs;
+		VkShaderModule fs_mod = VK_NULL_HANDLE;
+		bool fs_tried = false;
+
+		VkPipeline build(const om_pipe_job& j)
+		{
+			if (!fs_tried)
+			{
+				fs_tried = true;
+				fs.create(::glsl::program_domain::glsl_fragment_program,
+					"#version 450\nlayout(location=0) out vec4 o;\nvoid main() { o = vec4(1.0, gl_FragCoord.z, 0.0, 0.0); }\n");
+				fs_mod = fs.compile();
+			}
+			if (!fs_mod) return VK_NULL_HANDLE;
+			VkPipelineShaderStageCreateInfo stages[2]{};
+			stages[0].sType = stages[1].sType = VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO;
+			stages[0].stage = VK_SHADER_STAGE_VERTEX_BIT;
+			stages[0].module = j.vs;
+			stages[0].pName = "main";
+			stages[1].stage = VK_SHADER_STAGE_FRAGMENT_BIT;
+			stages[1].module = fs_mod;
+			stages[1].pName = "main";
+			VkPipelineVertexInputStateCreateInfo vi{ VK_STRUCTURE_TYPE_PIPELINE_VERTEX_INPUT_STATE_CREATE_INFO };
+			VkPipelineViewportStateCreateInfo vp{ VK_STRUCTURE_TYPE_PIPELINE_VIEWPORT_STATE_CREATE_INFO };
+			vp.viewportCount = vp.scissorCount = 1;
+			VkPipelineMultisampleStateCreateInfo ms{ VK_STRUCTURE_TYPE_PIPELINE_MULTISAMPLE_STATE_CREATE_INFO };
+			ms.rasterizationSamples = VK_SAMPLE_COUNT_1_BIT;
+			VkPipelineDepthStencilStateCreateInfo ds{ VK_STRUCTURE_TYPE_PIPELINE_DEPTH_STENCIL_STATE_CREATE_INFO };
+			ds.depthTestEnable = VK_TRUE;
+			ds.depthWriteEnable = VK_FALSE;
+			ds.depthCompareOp = j.cmp;
+			ds.minDepthBounds = 0.f;
+			ds.maxDepthBounds = 1.f;
+			VkPipelineColorBlendAttachmentState att{};
+			att.blendEnable = VK_TRUE;
+			att.srcColorBlendFactor = VK_BLEND_FACTOR_CONSTANT_COLOR;
+			att.dstColorBlendFactor = VK_BLEND_FACTOR_ZERO;
+			att.colorBlendOp = VK_BLEND_OP_ADD;
+			att.srcAlphaBlendFactor = VK_BLEND_FACTOR_ZERO;
+			att.dstAlphaBlendFactor = VK_BLEND_FACTOR_ZERO;
+			att.alphaBlendOp = VK_BLEND_OP_ADD;
+			att.colorWriteMask = VK_COLOR_COMPONENT_R_BIT | VK_COLOR_COMPONENT_G_BIT;
+			VkPipelineColorBlendStateCreateInfo cb{ VK_STRUCTURE_TYPE_PIPELINE_COLOR_BLEND_STATE_CREATE_INFO };
+			cb.attachmentCount = 1;
+			cb.pAttachments = &att;
+			// The same dynamic state as the game's pipelines: binding this one leaves all of theirs defined
+			VkDynamicState dyn[9] = { VK_DYNAMIC_STATE_VIEWPORT, VK_DYNAMIC_STATE_SCISSOR, VK_DYNAMIC_STATE_LINE_WIDTH,
+				VK_DYNAMIC_STATE_BLEND_CONSTANTS, VK_DYNAMIC_STATE_STENCIL_COMPARE_MASK, VK_DYNAMIC_STATE_STENCIL_WRITE_MASK,
+				VK_DYNAMIC_STATE_STENCIL_REFERENCE, VK_DYNAMIC_STATE_DEPTH_BIAS, VK_DYNAMIC_STATE_DEPTH_BOUNDS };
+			VkPipelineDynamicStateCreateInfo dy{ VK_STRUCTURE_TYPE_PIPELINE_DYNAMIC_STATE_CREATE_INFO };
+			dy.dynamicStateCount = depth_bounds ? 9 : 8;
+			dy.pDynamicStates = dyn;
+			VkGraphicsPipelineCreateInfo info{ VK_STRUCTURE_TYPE_GRAPHICS_PIPELINE_CREATE_INFO };
+			info.stageCount = 2;
+			info.pStages = stages;
+			info.pVertexInputState = &vi;
+			info.pInputAssemblyState = &j.ia;
+			info.pViewportState = &vp;
+			info.pRasterizationState = &j.rs;
+			info.pMultisampleState = &ms;
+			info.pDepthStencilState = &ds;
+			info.pColorBlendState = &cb;
+			info.pDynamicState = &dy;
+			info.layout = j.layout;
+			info.renderPass = j.rp;
+			info.basePipelineIndex = -1;
+			VkPipeline pipe = VK_NULL_HANDLE;
+			if (vkCreateGraphicsPipelines(dev, VK_NULL_HANDLE, 1, &info, nullptr, &pipe) != VK_SUCCESS) pipe = VK_NULL_HANDLE;
+			return pipe;
+		}
+
+		void run()
+		{
+			for (;;)
+			{
+				om_pipe_job j;
+				{
+					std::unique_lock lock(mtx);
+					cv.wait(lock, [&] { return !jobs.empty(); });
+					j = jobs.back();
+					jobs.pop_back();
+				}
+				const VkPipeline pipe = build(j);
+				std::lock_guard lock(mtx);
+				done[j.key] = pipe;
+				queued.erase(j.key);
+			}
+		}
+
+		// The pipeline for this key, or VK_NULL_HANDLE (pending = being built)
+		VkPipeline get(const om_pipe_job& j, bool& pending)
+		{
+			std::lock_guard lock(mtx);
+			if (const auto it = done.find(j.key); it != done.end()) { pending = false; return it->second; }
+			pending = true;
+			if (queued.insert(j.key).second)
+			{
+				jobs.push_back(j);
+				cv.notify_one();
+			}
+			return VK_NULL_HANDLE;
+		}
+	};
+
+	om_pipes_t* om_pipes(VkDevice dev, bool depth_bounds)
+	{
+		// Never destroyed: the worker sleeps until process exit
+		static om_pipes_t* p = [&]
+		{
+			auto* r = new om_pipes_t;
+			r->dev = dev;
+			r->depth_bounds = depth_bounds;
+			std::thread([r] { r->run(); }).detach();
+			return r;
+		}();
+		return p;
+	}
+
+	void om_barrier(VkCommandBuffer c)
+	{
+		VkMemoryBarrier mb{ VK_STRUCTURE_TYPE_MEMORY_BARRIER };
+		mb.srcAccessMask = VK_ACCESS_DEPTH_STENCIL_ATTACHMENT_WRITE_BIT | VK_ACCESS_COLOR_ATTACHMENT_WRITE_BIT;
+		mb.dstAccessMask = VK_ACCESS_DEPTH_STENCIL_ATTACHMENT_READ_BIT | VK_ACCESS_DEPTH_STENCIL_ATTACHMENT_WRITE_BIT |
+			VK_ACCESS_COLOR_ATTACHMENT_READ_BIT | VK_ACCESS_COLOR_ATTACHMENT_WRITE_BIT;
+		const VkPipelineStageFlags stages = VK_PIPELINE_STAGE_EARLY_FRAGMENT_TESTS_BIT | VK_PIPELINE_STAGE_LATE_FRAGMENT_TESTS_BIT |
+			VK_PIPELINE_STAGE_COLOR_ATTACHMENT_OUTPUT_BIT;
+		vkCmdPipelineBarrier(c, stages, stages, 0, 1, &mb, 0, nullptr, 0, nullptr);
+	}
+
+}
+
+namespace
+{
+	// History copies alone into the closing command buffer (when the segment replay can't run there): their ring data
+	// is still alive, so next frame's redraws have a previous-frame history. Same barriers as om2_replay.
+	// onepass: the only place (with the upscaler run) where this frame's history copies are issued.
+	void om2_flush_history(vk::command_buffer_chunk& cmd)
+	{
+		auto& o = g_om2;
+		if ((!r2cfg().om_hsubmit && !om1_on()) || o.hcopy.empty() || o.cb != &cmd || o.cb_reset != cmd.reset_id || !o.sbuf || !o.hsrc) return;
+		vkCmdPipelineBarrier(cmd, VK_PIPELINE_STAGE_VERTEX_SHADER_BIT, VK_PIPELINE_STAGE_TRANSFER_BIT, 0, 0, nullptr, 0, nullptr, 0, nullptr);
+		vkCmdCopyBuffer(cmd, o.hsrc, o.sbuf->value, size32(o.hcopy), o.hcopy.data());
+		const VkDeviceSize hbase = static_cast<VkDeviceSize>(o.cap) * 16 * (1 + static_cast<VkDeviceSize>(o.hpar) * 468);
+		for (const auto& c : o.hcopy) o.hvalid[o.hpar][static_cast<usz>((c.dstOffset - hbase) / (468 * 16))] = 1;
+		om_issue_dcopy(cmd);
+		VkMemoryBarrier mb{ VK_STRUCTURE_TYPE_MEMORY_BARRIER };
+		mb.srcAccessMask = VK_ACCESS_TRANSFER_WRITE_BIT;
+		mb.dstAccessMask = VK_ACCESS_SHADER_READ_BIT;
+		vkCmdPipelineBarrier(cmd, VK_PIPELINE_STAGE_TRANSFER_BIT, VK_PIPELINE_STAGE_VERTEX_SHADER_BIT, 0, 1, &mb, 0, nullptr, 0, nullptr);
+		o.n_hist += size32(o.hcopy);
+		o.t_hsubmit += size32(o.hcopy);
+		o.hcopy.clear();
+	}
+}
+
+// R3: RSX_DLSS_OBJMV=1, close_and_submit_command_buffer: a mid-frame submit (label waits, flushes) would drop the draws
+// recorded in this command buffer (their descriptor sets may be recycled after it): replay them now (om2_replay segment),
+// or at least issue the history copies.
+void VKGSRender::r2aa_objmv_segment()
+{
+	auto& o = g_om2;
+	if (r2cfg().objmv != 1 || o.failed || (o.recs.empty() && o.hcopy.empty())) return;
+	auto* cmd = m_current_command_buffer;
+	if (!cmd || o.cb != cmd || o.cb_reset != cmd->reset_id) return;
+	om_cpu_scope om_t;
+	auto* ds = g_r2.ds_ptr;
+	auto& sc = res()->surface_cache;
+	if (r2cfg().om_segments && !o.recs.empty() && ds && (sc.m_bound_depth_stencil.second == ds || sc.get_surface_at(g_r2.scene_ds) == ds))
+		om2_replay(*cmd, ds, *m_device, true);
+	om2_flush_history(*cmd);
+}
+
+// RSX_DLSS_OBJMV_MODE=onepass: emit_geometry, right before the draw commands. A moving draw with a previous-frame
+// history and a ready variant pipeline gets that pipeline bound (+ its sets, the history base): the draw then writes
+// its velocity itself. Also captures the history (r2aa_objmv_after_draw then has nothing left to do for this draw).
+namespace
+{
+	// Sparse hash of the uploaded vertex range (16 vertices x up to 16 bytes per block): SPU-written meshes
+	// (skinning, cloth) change it from frame to frame. 0: nothing hashed.
+	u32 om_vertex_hash(const rsx::vertex_input_layout& layout)
+	{
+		u32 h = 0x811c9dc5u, blocks = 0;
+		for (const auto* info : layout.interleaved_blocks)
+		{
+			if (!info || info->single_vertex || !info->attribute_stride || !info->vertex_range.second) continue;
+			const u32 stride = info->attribute_stride;
+			const u32 count = info->vertex_range.second;
+			const u32 bytes = std::min<u32>(stride, 16);
+			const u8* base = vm::_ptr<const u8>(info->real_offset_address) + static_cast<usz>(info->vertex_range.first) * stride;
+			for (u32 k = 0; k < 16; ++k)
+			{
+				const u8* q = base + static_cast<usz>(static_cast<u32>((static_cast<u64>(count - 1) * k) / 15)) * stride;
+				for (u32 b = 0; b < bytes; ++b) h = (h ^ q[b]) * 0x01000193u;
+			}
+			if (++blocks == 2) break;
+		}
+		return blocks ? (h | 1u) : 0u;
+	}
+
+	const vk::vertex_upload_info* g_om_vu = nullptr; // r2aa_objmv_pre_draw: this draw's vertex upload (RSX_DLSS_OBJMV_DEFORM)
+}
+
+bool VKGSRender::r2aa_objmv_pre_draw(u32 draw_count, const vk::vertex_upload_info& vu)
+{
+	if (g_r2.om_cur < 0 || !om1_on()) return false;
+	const u32 before = g_om2.n_op;
+	g_om_vu = &vu;
+	r2aa_objmv_after_draw(nullptr, nullptr, draw_count, -1, 0);
+	g_om_vu = nullptr;
+	return g_om2.n_op != before;
+}
+
+// RSX_DLSS_OBJMV: called by emit_geometry right after the draw commands. 'issue' re-records them. Inert (one compare)
+// unless the draw was classified as needing its own motion or the bias mask.
+void VKGSRender::r2aa_objmv_after_draw(void (*issue)(void*), void* issue_ctx, u32 draw_count, s64 index_offset, u32 index_type)
+{
+	auto& st = g_r2;
+	if (st.om_cur < 0) return;
+	if (r2cfg().objmv == 1)
+	{
+		// v2: capture the constants (every depth-writing scene draw: next frame's history) and record the draws that
+		// moved on their own for om2_replay. No commands are recorded here.
+		auto& o = g_om2;
+		auto& e = st.cur_F.e[static_cast<u32>(st.om_cur)];
+		st.om_cur = -1;
+		om_cpu_scope om_t;
+		const bool pre = !issue; // r2aa_objmv_pre_draw (onepass), before the draw commands
+		if (o.failed || !m_vertex_prog || !m_program || m_shader_interpreter.is_interpreter(m_program) || e.om_src) return;
+		const auto* regs = REGS(m_ctx);
+		e.vkvp = m_vertex_prog;
+		if (m_vertex_prog->has_indexed_constants)
+		{
+			if (e.prog->indexed) e.om_src = 1; // consts at const_off: all 512 registers
+		}
+		else
+		{
+			e.om_cnt = size32(m_vertex_prog->constant_ids);
+			if (e.om_cnt && e.om_cnt <= 468) e.om_src = 2;
+		}
+		if (!e.om_src) return;
+		auto* cmd = m_current_command_buffer;
+		if (o.cb != cmd || o.cb_reset != cmd->reset_id)
+		{
+			// Submitted since the last record: those draws' descriptor sets / ring data may be recycled
+			o.n_skip += size32(o.recs);
+			o.recs.clear();
+			o.hcopy.clear();
+			o.hsrc = VK_NULL_HANDLE;
+			o.dcopy.clear();
+			o.dsrc = VK_NULL_HANDLE;
+			o.cb = cmd;
+			o.cb_reset = cmd->reset_id;
+		}
+
+		// RSX_DLSS_OBJMV_DEFORM (onepass): vertex data the CPU/SPU rewrote since the matched previous-frame draw (cloth,
+		// SPU skinning: same constants, new positions). Sparse hash of the guest vertex range, as om_dyn below.
+		const bool dfm_on = pre && g_om_vu && o.dhalf && r2cfg().om_deform && om1_on() && !m_attrib_ring_info.has_shadow();
+		bool dfm = false;
+		u32 d_src = 0, d_size = 0;
+		u64 d_key = 0;
+		if (dfm_on)
+		{
+			if (!(e.om & om_hashed))
+			{
+				e.om |= om_hashed;
+				e.vb_hash = om_vertex_hash(m_vertex_layout);
+				if ((e.om & om_matched) && e.vb_hash)
+				{
+					const u32 ph = st.prev_F.e[e.prev].vb_hash;
+					if (ph && ph != e.vb_hash) e.om |= om_dyn;
+					else if (!ph) o.dg_noprev++;
+					else o.dg_same++;
+				}
+				else if (e.om & om_matched) o.dg_nohash++;
+			}
+			const auto* view = m_persistent_attribute_storage.get();
+			if ((e.om & om_dyn) && o.dn >= r2cfg().om_deform_max) o.dg_budget++;
+			if ((e.om & om_dyn) && o.dn < r2cfg().om_deform_max && view && view->info.buffer == m_attrib_ring_info.heap->value &&
+				(m_attrib_ring_info.heap->info.usage & VK_BUFFER_USAGE_TRANSFER_SRC_BIT) && !m_vertex_layout.interleaved_blocks.empty() &&
+				regs->current_draw_clause.command != rsx::draw_command::inlined_array)
+			{
+				const u32 bytes = RSX(m_ctx)->draw_processor()->calculate_memory_requirements(m_vertex_layout, g_om_vu->first_vertex, g_om_vu->allocated_vertex_count).first;
+				const u64 src = static_cast<u64>(view->info.offset) + g_om_vu->persistent_window_offset;
+				if (bytes && g_om_vu->persistent_window_offset != umax && src + bytes <= m_attrib_ring_info.size())
+				{
+					// Same layout, vertex range and size last frame = the same vertices at the same stream offsets
+					u64 k = mix64(g_om_vu->first_vertex, (static_cast<u64>(g_om_vu->allocated_vertex_count) << 32) | bytes);
+					k = mix64(k, g_om_vu->vertex_index_base);
+					for (const auto* b : m_vertex_layout.interleaved_blocks)
+					{
+						if (!b) continue;
+						k = mix64(k, (static_cast<u64>(b->attribute_stride) << 40) | (static_cast<u64>(b->single_vertex) << 32) | b->memory_location);
+						k = mix64(k, (static_cast<u64>(b->vertex_range.first) << 32) | b->vertex_range.second);
+						for (const auto& l : b->locations)
+						{
+							const auto& a = regs->vertex_arrays_info[l.index];
+							k = mix64(k, static_cast<u64>((a.offset() & 0x7fffffff) - b->base_offset));
+							k = mix64(k, (static_cast<u64>(l.index) << 48) | (static_cast<u64>(l.modulo) << 40) | (static_cast<u64>(l.frequency) << 16) |
+								(static_cast<u64>(static_cast<u8>(a.type())) << 8) | a.size());
+						}
+					}
+					dfm = true;
+					d_src = static_cast<u32>(src);
+					d_size = bytes;
+					d_key = k | 1;
+				}
+			}
+			if ((e.om & om_dyn) && !dfm && o.dn < r2cfg().om_deform_max) o.dg_stream++;
+		}
+
+		// Next frame's history: a GPU copy (at the velocity pass, same command buffer) of the constants this draw read,
+		// straight from the transform constants ring. Static matched geometry needs none (camera motion).
+		// R3 fix: om2_init sets o.cap; it used to be called only after 'o.hn < o.cap' (cap 0 -> never): no history
+		// copy, every moving draw "no-history", v2 never ran (R2 has the same bug).
+		const bool moving = (e.om & (om_skin | om_rigid)) || !(e.om & om_matched) || e.prog->indexed || dfm;
+		const bool om_ok = moving && om2_init(*m_device);
+		if (om_ok && m_transform_constants_ring_info.has_shadow())
+		{
+			static bool once = false;
+			if (!once) r2log("objmv2: the transform constants ring uses a staging copy on this driver: no per-object history (camera motion only)");
+			once = true;
+		}
+		// R3: unmatched draws (no previous frame: never replayed this frame) took every slot early in the frame, so the
+		// matched characters drawn later had none -> "no-history" next frame. RSX_DLSS_OBJMV_NEW_HIST caps their share.
+		bool slot_ok = o.hn < o.cap;
+		if (slot_ok && !(e.om & om_matched) && o.n_new_hist >= o.cap * static_cast<u32>(r2cfg().om_new_hist) / 100u)
+		{
+			slot_ok = false;
+			o.t_new_refused++;
+		}
+		if (om_ok && slot_ok && !(m_ctx->program.vertex_program.ctrl & RSX_SHADER_CONTROL_INSTANCED_CONSTANTS) &&
+			!m_transform_constants_ring_info.has_shadow())
+		{
+			const VkBuffer ring = m_transform_constants_ring_info.heap->value;
+			if (!o.hsrc) o.hsrc = ring;
+			if (ring == o.hsrc)
+			{
+				const u32 slot = o.hn++;
+				if (!(e.om & om_matched)) o.n_new_hist++;
+				VkBufferCopy bc{};
+				bc.srcOffset = m_vertex_constants_buffer_info.offset + m_xform_constants_dynamic_offset;
+				bc.dstOffset = static_cast<VkDeviceSize>(o.cap) * 16 * (1 + static_cast<VkDeviceSize>(o.hpar) * 468) + static_cast<VkDeviceSize>(slot) * 468 * 16;
+				bc.size = static_cast<VkDeviceSize>(e.om_src == 1 ? 468 : e.om_cnt) * 16;
+				o.hcopy.push_back(bc);
+				e.om_hslot = static_cast<u16>(slot + 1);
+				// RSX_DLSS_OBJMV_DEFORM: the vertex stream too, issued with the constants (hvalid covers both)
+				const VkBuffer vring = m_attrib_ring_info.heap->value;
+				if (dfm && !o.dsrc) o.dsrc = vring;
+				if (dfm && vring == o.dsrc && o.dused + d_size <= o.dhalf)
+				{
+					const VkDeviceSize dst = static_cast<VkDeviceSize>(o.hpar) * o.dhalf + o.dused;
+					o.dcopy.push_back({ d_src, dst, d_size });
+					e.om_doff = static_cast<u32>(dst);
+					e.om_dsize = d_size;
+					e.om_dkey = d_key;
+					o.dused += (static_cast<VkDeviceSize>(d_size) + 255) & ~VkDeviceSize{255};
+					o.dn++;
+					o.n_dcap++;
+				}
+			}
+		}
+
+		// RSX_DLSS_OBJMV_DEFORM: previous positions from last frame's copy of this draw's vertex stream
+		const mvp_entry* dp = (e.om & om_matched) ? &st.prev_F.e[e.prev] : nullptr;
+		const bool use_dfm = dfm && dp && dp->om_dsize == d_size && dp->om_dkey == d_key && dp->om_hslot && dp->om_hslot - 1u < o.cap &&
+			o.hvalid[o.hpar ^ 1][dp->om_hslot - 1u] && dp->om_doff + static_cast<u64>(d_size) <= o.dhalf * 2;
+		if (dfm && !use_dfm) o.n_dmiss++;
+
+		if (!(e.om & om_matched) || (!(e.om & (om_skin | om_rigid)) && !use_dfm))
+		{
+			o.n_static++;
+			return;
+		}
+		const auto& p = st.prev_F.e[e.prev];
+		const u32 pslot = p.om_hslot ? p.om_hslot - 1u : ~0u;
+		if (p.vkvp != e.vkvp || p.om_src != e.om_src || (e.om_src == 2 && p.om_cnt != e.om_cnt) || pslot >= o.cap ||
+			!o.hvalid[o.hpar ^ 1][pslot])
+		{
+			o.n_nohist++;
+			return;
+		}
+		const u32 prev_base = o.cap + ((o.hpar ^ 1) * o.cap + pslot) * 468;
+
+		auto* ds = res()->surface_cache.m_bound_depth_stencil.second;
+		const auto& clause = regs->current_draw_clause;
+		const auto& ps = m_pipeline_properties.state;
+		const VkDescriptorSet set0 = cmd->r2_bound_set(0);
+		const VkDescriptorSetLayout set0_layout = m_program->r2_set_layout(0);
+		if (!ds || ds != st.ds_ptr || ds->samples() != 1 || !draw_count || !m_vertex_prog->handle || !set0 || !set0_layout ||
+			!m_device->get_shader_draw_parameters_support() || clause.is_trivial_instanced_draw || !clause.is_single_draw() ||
+			(cmd->flags & vk::command_buffer::cb_has_conditional_render) ||
+			(m_ctx->program.vertex_program.ctrl & RSX_SHADER_CONTROL_INSTANCED_CONSTANTS) ||
+			(m_ctx->program.fragment_program.ctrl & RSX_SHADER_CONTROL_PROGRAMMABLE_BLENDING) ||
+			(ps.ds.depthTestEnable && ps.ds.depthCompareOp == VK_COMPARE_OP_NEVER))
+		{
+			o.n_skip++;
+			return;
+		}
+		if (om1_on())
+		{
+			// onepass: the variant of this very pipeline, bound for the draw that follows
+			const VkDescriptorSet set1 = cmd->r2_bound_set(1);
+			const VkDescriptorSetLayout set1_layout = m_program->has_set(1) ? m_program->r2_set_layout(1) : VK_NULL_HANDLE;
+			if (!pre || st.aa_done || !o.vb_clean || !o.op_set || ds->width() != o.vb_w || ds->height() != o.vb_h || !set1 || !set1_layout ||
+				!m_program->push_ranges().empty() || !m_fragment_prog || !m_fragment_prog->handle || !om1_init(*m_device))
+			{
+				o.n_skip++;
+				return;
+			}
+			const VkPipelineLayout layout = om1_layout(*m_device, set0_layout, set1_layout);
+			if (!layout)
+			{
+				o.n_skip++;
+				return;
+			}
+			u64 key = mix64(reinterpret_cast<u64>(m_vertex_prog->handle), reinterpret_cast<u64>(m_fragment_prog->handle));
+			key = mix64(key, reinterpret_cast<u64>(m_program) ^ (0x0b1ull << 48));
+			key = mix64(key, reinterpret_cast<u64>(layout));
+			key = mix64(key, m_pipeline_properties.renderpass_key);
+			auto* pipes = om2_pipes(*m_device);
+			bool pending = false;
+			VkPipeline pipe = pipes->peek(key, pending);
+			if (!pipe && !pending)
+			{
+				pipes->request(key, [&]
+				{
+					om2_job j;
+					j.kind = 1;
+					j.key = key;
+					j.src = m_vertex_prog->shader.get_source();
+					j.fsrc = m_fragment_prog->shader.get_source();
+					j.layout = layout;
+					j.rp = vk::get_renderpass(*m_device, m_pipeline_properties.renderpass_key);
+					j.props = m_pipeline_properties;
+					for (u32 i = 0; i < 4; ++i) j.props.state.att_state[i].colorWriteMask &= m_fragment_prog->output_color_masks[i];
+					j.props.state.ia.pNext = nullptr;
+					j.props.state.rs.pNext = nullptr;
+					j.provoking_last = (m_vertex_prog->Flags() & RSX_SHADER_CONTROL_FLAT_SHADING) && m_device->get_provoking_vertex_last_support();
+					j.depth_bounds_dyn = m_device->get_depth_bounds_support();
+					return j;
+				});
+				pipe = pipes->peek(key, pending);
+			}
+			if (!pipe)
+			{
+				if (pending) o.n_pending++;
+				else o.n_skip++;
+				return;
+			}
+			vkCmdBindPipeline(*cmd, VK_PIPELINE_BIND_POINT_GRAPHICS, pipe);
+			const VkDescriptorSet sets[3] = { set0, set1, o.op_set };
+			vkCmdBindDescriptorSets(*cmd, VK_PIPELINE_BIND_POINT_GRAPHICS, layout, 0, 3, sets, 0, nullptr);
+			const u32 pc[3] = { prev_base, use_dfm ? 1u : 0u,
+				use_dfm ? static_cast<u32>(static_cast<s32>(dp->om_doff) - static_cast<s32>(g_om_vu->persistent_window_offset)) : 0u };
+			vkCmdPushConstants(*cmd, layout, VK_SHADER_STAGE_VERTEX_BIT, 0, sizeof(pc), pc);
+			if (use_dfm) o.n_dfm++;
+			// the next draw rebinds the game pipeline and its sets
+			cmd->r2_invalidate_state_cache();
+			o.vb_written = true;
+			o.n_op++;
+			e.om |= om_replayed;
+			return;
+		}
+		if (pre) return;
+		const VkPipelineLayout layout = om2_layout(*m_device, set0_layout);
+		if (!layout || o.recs.size() >= o.cap)
+		{
+			o.n_skip++;
+			return;
+		}
+
+		// Depth test relaxed to "equal or better" (+ a small bias toward the camera at replay) so the surface passes
+		// against the depth it wrote; draws without a depth test still get one (hidden parts keep camera motion)
+		VkCompareOp cmp = ps.ds.depthTestEnable ? ps.ds.depthCompareOp : (st.inverted ? VK_COMPARE_OP_GREATER_OR_EQUAL : VK_COMPARE_OP_LESS_OR_EQUAL);
+		if (cmp == VK_COMPARE_OP_LESS || (cmp == VK_COMPARE_OP_EQUAL && !st.inverted)) cmp = VK_COMPARE_OP_LESS_OR_EQUAL;
+		else if (cmp == VK_COMPARE_OP_GREATER || cmp == VK_COMPARE_OP_EQUAL) cmp = VK_COMPARE_OP_GREATER_OR_EQUAL;
+		u64 key = mix64(reinterpret_cast<u64>(m_vertex_prog->handle), reinterpret_cast<u64>(layout));
+		key = mix64(key, static_cast<u64>(ds->format()) | (0x0b2ull << 32));
+		key = mix64(key, (static_cast<u64>(ps.ia.topology) << 1) | ps.ia.primitiveRestartEnable);
+		key = mix64(key, (static_cast<u64>(ps.rs.cullMode) << 8) | (static_cast<u64>(ps.rs.frontFace) << 4) | (static_cast<u64>(ps.rs.polygonMode) << 12) |
+			(static_cast<u64>(ps.rs.depthClampEnable) << 16));
+		key = mix64(key, static_cast<u64>(cmp));
+		om2_pipes(*m_device)->request(key, [&]
+		{
+			om2_job j;
+			j.key = key;
+			j.src = m_vertex_prog->shader.get_source();
+			j.layout = layout;
+			j.rp = vk::get_renderpass(*m_device, vk::get_renderpass_key(om2_format, ds->format(), 1, 1));
+			j.ia = ps.ia;
+			j.ia.pNext = nullptr;
+			j.rs = ps.rs;
+			j.rs.pNext = nullptr;
+			j.rs.rasterizerDiscardEnable = VK_FALSE;
+			j.rs.depthBiasEnable = VK_TRUE;
+			j.rs.lineWidth = 1.f;
+			j.cmp = cmp;
+			return j;
+		});
+
+		om2_rec r;
+		r.key = key;
+		r.layout = layout;
+		r.set0 = set0;
+		r.indexed = index_offset >= 0;
+		if (r.indexed)
+		{
+			r.ibuf = m_index_buffer_ring_info.heap->value;
+			r.ioff = static_cast<VkDeviceSize>(index_offset);
+			r.itype = static_cast<VkIndexType>(index_type);
+		}
+		r.inverted = cmp == VK_COMPARE_OP_GREATER_OR_EQUAL;
+		r.count = draw_count;
+		r.dp_index = m_draw_parameters_index;
+		r.vp = m_viewport;
+		r.sc = m_scissor;
+		r.prev_base = prev_base;
+		r.entry = static_cast<u32>(&e - st.cur_F.e.data());
+		o.recs.push_back(r);
+		o.n_rec++;
+		e.om |= om_replayed;
+		return;
+	}
+	auto& e = st.cur_F.e[static_cast<u32>(st.om_cur)];
+	if (!(e.om & om_hashed))
+	{
+		// Sparse hash of the uploaded vertex range (16 vertices x up to 16 bytes per block): SPU-written meshes
+		// (skinning, cloth) change it from frame to frame
+		e.om |= om_hashed;
+		e.vb_hash = om_vertex_hash(m_vertex_layout);
+		if ((e.om & om_matched) && e.vb_hash)
+		{
+			const u32 ph = st.prev_F.e[e.prev].vb_hash;
+			if (ph && ph != e.vb_hash) e.om |= om_dyn;
+		}
+	}
+	if (!(e.om & om_want)) return;
+	if (!r2cfg().biasmask && !(e.om & om_rigid)) return; // the ID would only feed the mask
+
+	auto* cmd = m_current_command_buffer;
+	auto* ds = res()->surface_cache.m_bound_depth_stencil.second;
+	if (!ds || ds->samples() != 1 || !m_draw_fbo || !m_vertex_prog || !m_vertex_prog->handle || !m_program || !m_program->layout() ||
+		m_shader_interpreter.is_interpreter(m_program) || (cmd->flags & vk::command_buffer::cb_has_conditional_render) ||
+		(m_ctx->program.fragment_program.ctrl & RSX_SHADER_CONTROL_PROGRAMMABLE_BLENDING) || !vk::is_renderpass_open(*cmd) ||
+		(st.id_frame == st.frame && st.id_ds != ds) || (!e.id && (st.id_next >= r2cfg().om_max_replays || st.id_next >= om_max_ids)) ||
+		ds->width() > 0xffff || ds->height() > 0xffff)
+	{
+		st.om_skipped++;
+		return;
+	}
+
+	if (!st.id_img || st.id_img->width() < ds->width() || st.id_img->height() < ds->height())
+	{
+		if (!st.id_img)
+		{
+			VkFormatProperties fp{};
+			vkGetPhysicalDeviceFormatProperties(m_device->gpu(), om_id_format, &fp);
+			const VkFormatFeatureFlags need = VK_FORMAT_FEATURE_COLOR_ATTACHMENT_BIT | VK_FORMAT_FEATURE_COLOR_ATTACHMENT_BLEND_BIT |
+				VK_FORMAT_FEATURE_SAMPLED_IMAGE_BIT;
+			if ((fp.optimalTilingFeatures & need) != need)
+			{
+				st.id_unsupported = true;
+				r2log("per-object motion unavailable: the GPU can't blend into R32G32_SFLOAT");
+				return;
+			}
+		}
+		const u32 w = std::max(ds->width(), st.id_img ? st.id_img->width() : 0u);
+		const u32 h = std::max(ds->height(), st.id_img ? st.id_img->height() : 0u);
+		if (st.id_img)
+		{
+			vk::remove_framebuffers_with_image(st.id_img.get());
+			vk::get_resource_manager()->dispose(st.id_img);
+		}
+		st.id_img = make_image(om_id_format, w, h, VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT | VK_IMAGE_USAGE_SAMPLED_BIT | VK_IMAGE_USAGE_TRANSFER_DST_BIT);
+		st.id_frame = ~0u;
+		if (!st.id_img)
+		{
+			st.id_unsupported = true;
+			return;
+		}
+	}
+
+	// Pipeline: the draw's vertex shader, layout, primitive and rasteriser state; depth test relaxed to "equal or
+	// better" so the pixels this draw just wrote pass, no depth/stencil writes
+	const auto& ps = m_pipeline_properties.state;
+	om_pipe_job j{};
+	j.vs = m_vertex_prog->handle;
+	j.layout = m_program->layout();
+	j.ia = ps.ia;
+	j.ia.pNext = nullptr;
+	j.rs = ps.rs;
+	j.rs.pNext = nullptr;
+	j.rs.rasterizerDiscardEnable = VK_FALSE;
+	j.rs.lineWidth = 1.f;
+	j.cmp = ps.ds.depthTestEnable ? ps.ds.depthCompareOp : VK_COMPARE_OP_ALWAYS;
+	if (j.cmp == VK_COMPARE_OP_LESS) j.cmp = VK_COMPARE_OP_LESS_OR_EQUAL;
+	else if (j.cmp == VK_COMPARE_OP_GREATER) j.cmp = VK_COMPARE_OP_GREATER_OR_EQUAL;
+	u64 key = mix64(reinterpret_cast<u64>(j.vs), reinterpret_cast<u64>(j.layout));
+	key = mix64(key, static_cast<u64>(ds->format()));
+	key = mix64(key, (static_cast<u64>(j.ia.topology) << 1) | j.ia.primitiveRestartEnable);
+	key = mix64(key, (static_cast<u64>(j.rs.cullMode) << 8) | (static_cast<u64>(j.rs.frontFace) << 4) | (static_cast<u64>(j.rs.polygonMode) << 12) |
+		(static_cast<u64>(j.rs.depthClampEnable) << 16) | (static_cast<u64>(j.rs.depthBiasEnable) << 17));
+	key = mix64(key, static_cast<u64>(j.cmp));
+	j.key = key;
+	j.rp = vk::get_renderpass(*m_device, vk::get_renderpass_key(om_id_format, ds->format(), 1, 1));
+	bool pending = false;
+	const VkPipeline pipe = om_pipes(*m_device, m_device->get_depth_bounds_support())->get(j, pending);
+	if (!pipe)
+	{
+		if (pending) st.om_pending++;
+		else st.om_skipped++;
+		return;
+	}
+
+	if (!e.id) e.id = static_cast<u16>(++st.id_next);
+	e.om |= om_replayed;
+	st.om_replays++;
+
+	vk::end_renderpass(*cmd);
+	if (cmd->flags & vk::command_buffer::cb_has_open_query)
+	{
+		// Keep the redraw out of the game's occlusion query: close it, the next draw opens a new one in the same slot
+		emergency_query_cleanup(cmd);
+		cmd->flags |= vk::command_buffer::cb_load_occluson_task;
+	}
+	om_barrier(*cmd);
+	if (st.id_frame != st.frame)
+	{
+		st.id_img->change_layout(*cmd, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL);
+		const VkClearColorValue zero{};
+		const VkImageSubresourceRange range{ VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0, 1 };
+		vkCmdClearColorImage(*cmd, st.id_img->value, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, &zero, 1, &range);
+		st.id_frame = st.frame;
+		st.id_ds = ds;
+	}
+	st.id_img->change_layout(*cmd, VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL);
+
+	const u16 fw = static_cast<u16>(ds->width()), fh = static_cast<u16>(ds->height());
+	const VkRenderPass rp = vk::get_renderpass(*m_device, vk::get_renderpass_key({ st.id_img.get(), ds }));
+	auto* fbo = vk::get_framebuffer(*m_device, fw, fh, VK_FALSE, rp, { st.id_img.get(), ds });
+	fbo->add_ref();
+	vk::begin_renderpass(*cmd, rp, fbo->value, { positionu{ 0u, 0u }, sizeu{ fw, fh } });
+	vkCmdBindPipeline(*cmd, VK_PIPELINE_BIND_POINT_GRAPHICS, pipe);
+	const float bc[4] = { static_cast<float>(e.id), 1.f, 0.f, 0.f };
+	vkCmdSetBlendConstants(*cmd, bc);
+	issue(issue_ctx);
+	vk::end_renderpass(*cmd);
+	fbo->release();
+	om_barrier(*cmd);
+
+	// Back to the game's pass: its pipeline (same layout: descriptor sets and push constants are still bound)
+	cmd->r2_invalidate_state_cache();
+	if (m_ctx->draw_state.blend.enable_mask) vkCmdSetBlendConstants(*cmd, m_ctx->draw_state.blend.constant_color.data());
+	begin_render_pass();
+	vkCmdBindPipeline(*cmd, VK_PIPELINE_BIND_POINT_GRAPHICS, m_program->value());
+}
diff --git a/rpcs3/Emu/RSX/VK/VKR2Upscaler.h b/rpcs3/Emu/RSX/VK/VKR2Upscaler.h
new file mode 100644
index 0000000..79b6ce8
--- /dev/null
+++ b/rpcs3/Emu/RSX/VK/VKR2Upscaler.h
@@ -0,0 +1,48 @@
+// R2PORT: Resistance 2 port addition (not upstream RPCS3).
+// Temporal anti-aliasing of the 3D scene with AMD FSR 3.1 (FidelityFX API, amd_fidelityfx_vk.dll) or
+// NVIDIA DLAA (r2_dlss.dll, NGX) or Intel XeSS (libxess.dll, VKR2XeSS.cpp). Enabled by RSX_FSR=1 (FSR 3.1) /
+// RSX_FSR=2 (DLAA, FSR fallback) / RSX_FSR=4 (XeSS, FSR fallback);
+// everything here is inert when RSX_FSR is unset or 0. The renderer hooks live in VKGSRender (r2aa_*).
+#pragma once
+
+#include "VulkanAPI.h"
+#include <vector>
+
+struct RSXVertexProgram;
+
+namespace vk
+{
+	class command_buffer;
+	class viewable_image;
+
+	// 0 off, 1 FSR 3.1, 2 DLAA, 4 Intel XeSS (from RSX_FSR)
+	int r2aa_mode();
+
+	// The temporal upscaler is enabled and has not given up: SSAO then runs inside r2aa_run, on the scene it consumes
+	bool r2aa_active();
+
+	// Camera near / far (view distance at depth buffer 0 / 1) and vertical FOV (radians) derived from the game's
+	// view-projection constants (RSX_AA_CAMERA_EXACT); nominal 0.1 / 1000 / 1.0 until they are known
+	void r2aa_camera(float& n, float& f, float& fov);
+
+	// RSX_AA_UV_JITTER (VKVertexProgram.cpp): bit N set = output register o[N] (texture coordinates, N >= 7) is a clip
+	// position of the program (same clip-matrix rows and input vector as o[0]) and gets the scene jitter.
+	// Always 0 when RSX_FSR is off or RSX_AA_UV_JITTER=0 (the generated shader is then unchanged).
+	unsigned r2aa_uvj_outputs(const RSXVertexProgram& prog);
+
+	// VKDraw.cpp sampler setup: extra LOD bias for the draw's bound targets (RSX_AA_MIPBIAS, 0 when off)
+	float r2aa_lod_bias();
+	bool r2aa_alpha_tested(bool atest); // per draw; true when the fragment samplers must be rebuilt (bias changed)
+
+	// VKPresent.cpp: area-filtered shrink (exact 2:1 box steps) of the w x h region of 'src' while it is at least twice
+	// the dw x dh output; returns the image to present and updates w, h (RSX_PRESENT_DOWNSCALE=0: returns src)
+	vk::viewable_image* r2_present_downscale(const vk::command_buffer& cmd, vk::viewable_image* src, u32& w, u32& h, u32 dw, u32 dh);
+
+	// instance.cpp: add the instance extensions NGX (RSX_FSR=2) or XeSS (RSX_FSR=4) needs
+	void r2aa_extend_instance(std::vector<const char*>& extensions);
+
+	// device.cpp, right before vkCreateDevice: enable the features/extensions FSR 3.1 and NGX use.
+	// Chains its own feature structs into 'info' and re-points the extension list at 'extensions'.
+	void r2aa_extend_device(VkPhysicalDevice pdev, std::vector<const char*>& extensions,
+		VkPhysicalDeviceFeatures& features, VkPhysicalDeviceVulkan12Features& vulkan12, VkDeviceCreateInfo& info);
+}
diff --git a/rpcs3/Emu/RSX/VK/VKR2XeSS.cpp b/rpcs3/Emu/RSX/VK/VKR2XeSS.cpp
new file mode 100644
index 0000000..bd4b459
--- /dev/null
+++ b/rpcs3/Emu/RSX/VK/VKR2XeSS.cpp
@@ -0,0 +1,574 @@
+// R2PORT: port addition (not upstream RPCS3). Intel XeSS backend of the VKR2Upscaler; see VKR2XeSS.h.
+
+#include "stdafx.h"
+#include "VKR2XeSS.h"
+
+#include <cstdarg>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <memory>
+#include <string>
+#include <type_traits>
+
+#ifdef _WIN32
+#include <windows.h>
+#endif
+
+#ifdef R2PORT_HAVE_XESS
+#include "xess/xess.h"
+#include "xess/xess_vk.h"
+#endif
+
+namespace
+{
+	void xlog(const char* fmt, ...)
+	{
+		char buf[1024];
+		va_list ap;
+		va_start(ap, fmt);
+		std::vsnprintf(buf, sizeof(buf), fmt, ap);
+		va_end(ap);
+		std::printf("[r2aa] XeSS: %s\n", buf);
+		std::fflush(stdout);
+	}
+
+	bool g_failed = false;
+}
+
+#if defined(R2PORT_HAVE_XESS) && defined(_WIN32)
+namespace
+{
+	struct xess_api
+	{
+		HMODULE dll = nullptr;
+		bool tried = false;
+		decltype(&xessGetVersion) get_version = nullptr;
+		decltype(&xessVKGetRequiredInstanceExtensions) req_instance = nullptr;
+		decltype(&xessVKGetRequiredDeviceExtensions) req_device = nullptr;
+		decltype(&xessVKGetRequiredDeviceFeatures) req_features = nullptr;
+		decltype(&xessVKCreateContext) create_context = nullptr;
+		decltype(&xessVKInit) init = nullptr;
+		decltype(&xessVKExecute) execute = nullptr;
+		decltype(&xessDestroyContext) destroy_context = nullptr;
+		decltype(&xessGetOptimalInputResolution) optimal_input = nullptr;
+		decltype(&xessSetVelocityScale) set_velocity_scale = nullptr;
+		decltype(&xessSetJitterScale) set_jitter_scale = nullptr;
+		decltype(&xessSetLoggingCallback) set_logging = nullptr;
+		decltype(&xessIsOptimalDriver) optimal_driver = nullptr;
+	} g_x;
+
+	struct xess_state
+	{
+		xess_context_handle_t ctx = nullptr;
+		int quality = 0;
+		float mv_x = 0.f, mv_y = 0.f;   // velocity scale last handed to XeSS
+		unsigned exec_fails = 0;
+	} g_s;
+
+	struct xess_settings
+	{
+		int quality = 0;      // 0 auto, else xess_quality_settings_t
+		float jsign = 1.f;
+		float jsign_y = 1.f;
+		bool log = false;
+	};
+
+	const xess_settings& xcfg()
+	{
+		static const xess_settings s = []
+		{
+			xess_settings r;
+			if (const char* e = std::getenv("RSX_XESS_QUALITY"); e && *e)
+			{
+				static const struct { const char* n; int v; } names[] = {
+					{ "aa", XESS_QUALITY_SETTING_AA }, { "native", XESS_QUALITY_SETTING_AA },
+					{ "uqp", XESS_QUALITY_SETTING_ULTRA_QUALITY_PLUS }, { "ultra_quality_plus", XESS_QUALITY_SETTING_ULTRA_QUALITY_PLUS },
+					{ "uq", XESS_QUALITY_SETTING_ULTRA_QUALITY }, { "ultra_quality", XESS_QUALITY_SETTING_ULTRA_QUALITY },
+					{ "q", XESS_QUALITY_SETTING_QUALITY }, { "quality", XESS_QUALITY_SETTING_QUALITY },
+					{ "b", XESS_QUALITY_SETTING_BALANCED }, { "balanced", XESS_QUALITY_SETTING_BALANCED },
+					{ "p", XESS_QUALITY_SETTING_PERFORMANCE }, { "performance", XESS_QUALITY_SETTING_PERFORMANCE },
+					{ "up", XESS_QUALITY_SETTING_ULTRA_PERFORMANCE }, { "ultra_performance", XESS_QUALITY_SETTING_ULTRA_PERFORMANCE } };
+				for (const auto& n : names)
+					if (_stricmp(e, n.n) == 0) r.quality = n.v;
+				if (!r.quality && std::atoi(e) >= XESS_QUALITY_SETTING_ULTRA_PERFORMANCE && std::atoi(e) <= XESS_QUALITY_SETTING_AA) r.quality = std::atoi(e);
+				if (!r.quality && _stricmp(e, "auto") != 0) xlog("RSX_XESS_QUALITY=%s not recognised; auto", e);
+			}
+			if (const char* e = std::getenv("RSX_XESS_JITTER_SIGN")) r.jsign = std::atof(e) < 0 ? -1.f : 1.f;
+			if (const char* e = std::getenv("RSX_XESS_JITTER_SIGN_Y")) r.jsign_y = std::atof(e) < 0 ? -1.f : 1.f;
+			if (const char* e = std::getenv("RSX_XESS_LOG")) r.log = std::atoi(e) != 0;
+			return r;
+		}();
+		return s;
+	}
+
+	const char* qname(int q)
+	{
+		switch (q)
+		{
+		case XESS_QUALITY_SETTING_AA: return "Native AA";
+		case XESS_QUALITY_SETTING_ULTRA_QUALITY_PLUS: return "Ultra Quality Plus";
+		case XESS_QUALITY_SETTING_ULTRA_QUALITY: return "Ultra Quality";
+		case XESS_QUALITY_SETTING_QUALITY: return "Quality";
+		case XESS_QUALITY_SETTING_BALANCED: return "Balanced";
+		case XESS_QUALITY_SETTING_PERFORMANCE: return "Performance";
+		case XESS_QUALITY_SETTING_ULTRA_PERFORMANCE: return "Ultra Performance";
+		default: return "none";
+		}
+	}
+
+	void xess_message(const char* msg, xess_logging_level_t level)
+	{
+		static int count = 0;
+		if (count++ > 60) return;
+		xlog("%s: %s", level >= XESS_LOGGING_LEVEL_ERROR ? "error" : level == XESS_LOGGING_LEVEL_WARNING ? "warning" : "info", msg ? msg : "");
+	}
+
+	bool fits(int q, uint32_t rw, uint32_t rh, uint32_t ow, uint32_t oh)
+	{
+		xess_2d_t out{ ow, oh }, opt{}, mn{}, mx{};
+		if (g_x.optimal_input(g_s.ctx, &out, static_cast<xess_quality_settings_t>(q), &opt, &mn, &mx) != XESS_RESULT_SUCCESS) return false;
+		return rw >= mn.x && rh >= mn.y && rw <= mx.x && rh <= mx.y;
+	}
+
+	// The preset for an rw x rh input and ow x oh output: native -> AA; else the preset made for this ratio,
+	// or the nearest one whose dynamic input range holds it.
+	int pick(uint32_t rw, uint32_t rh, uint32_t ow, uint32_t oh)
+	{
+		const int forced = xcfg().quality;
+		if (forced && fits(forced, rw, rh, ow, oh)) return forced;
+		if (forced)
+		{
+			static bool warned = false;
+			if (!warned) xlog("%s does not cover %ux%u -> %ux%u; picking automatically", qname(forced), rw, rh, ow, oh);
+			warned = true;
+		}
+		if (rw >= ow && rh >= oh) return XESS_QUALITY_SETTING_AA;
+		static const int order[6] = { XESS_QUALITY_SETTING_ULTRA_QUALITY_PLUS, XESS_QUALITY_SETTING_ULTRA_QUALITY, XESS_QUALITY_SETTING_QUALITY,
+			XESS_QUALITY_SETTING_BALANCED, XESS_QUALITY_SETTING_PERFORMANCE, XESS_QUALITY_SETTING_ULTRA_PERFORMANCE };
+		static const float ratio[6] = { 1.3f, 1.5f, 1.7f, 2.0f, 2.3f, 3.0f }; // XeSS 1.3+ scale factors
+		const float r = static_cast<float>(ow) / static_cast<float>(rw ? rw : 1);
+		for (int i = 0; i < 6; ++i)
+			if (ratio[i] >= r - 0.02f && fits(order[i], rw, rh, ow, oh)) return order[i];
+		for (int i = 5; i >= 0; --i)
+			if (fits(order[i], rw, rh, ow, oh)) return order[i];
+		return 0;
+	}
+
+	void push_unique(std::vector<const char*>& v, const char* name)
+	{
+		for (const char* e : v)
+			if (std::strcmp(e, name) == 0) return;
+		v.push_back(name);
+	}
+
+	// ---- device feature merging ----
+	// Sizes of the feature structs XeSS may return (all members after sType/pNext are VkBool32)
+	size_t feature_size(VkStructureType t)
+	{
+		switch (t)
+		{
+		case VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_VULKAN_1_1_FEATURES: return sizeof(VkPhysicalDeviceVulkan11Features);
+		case VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_VULKAN_1_2_FEATURES: return sizeof(VkPhysicalDeviceVulkan12Features);
+		case VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_VULKAN_1_3_FEATURES: return sizeof(VkPhysicalDeviceVulkan13Features);
+		case VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_SHADER_FLOAT16_INT8_FEATURES: return sizeof(VkPhysicalDeviceShaderFloat16Int8Features);
+		case VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_8BIT_STORAGE_FEATURES: return sizeof(VkPhysicalDevice8BitStorageFeatures);
+		case VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_16BIT_STORAGE_FEATURES: return sizeof(VkPhysicalDevice16BitStorageFeatures);
+		case VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_SHADER_INTEGER_DOT_PRODUCT_FEATURES: return sizeof(VkPhysicalDeviceShaderIntegerDotProductFeatures);
+		case VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_MUTABLE_DESCRIPTOR_TYPE_FEATURES_EXT: return sizeof(VkPhysicalDeviceMutableDescriptorTypeFeaturesEXT);
+		case VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_SUBGROUP_SIZE_CONTROL_FEATURES: return sizeof(VkPhysicalDeviceSubgroupSizeControlFeatures);
+		case VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_SHADER_SUBGROUP_EXTENDED_TYPES_FEATURES: return sizeof(VkPhysicalDeviceShaderSubgroupExtendedTypesFeatures);
+		case VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_DESCRIPTOR_INDEXING_FEATURES: return sizeof(VkPhysicalDeviceDescriptorIndexingFeatures);
+		case VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_SYNCHRONIZATION_2_FEATURES: return sizeof(VkPhysicalDeviceSynchronization2Features);
+		default: return 0;
+		}
+	}
+
+	constexpr size_t hdr = sizeof(VkBaseOutStructure);
+
+	void or_bools(void* dst, const void* src, size_t size)
+	{
+		auto* d = reinterpret_cast<VkBool32*>(static_cast<char*>(dst) + hdr);
+		const auto* s = reinterpret_cast<const VkBool32*>(static_cast<const char*>(src) + hdr);
+		for (size_t i = 0; i < (size - hdr) / sizeof(VkBool32); ++i) d[i] |= s[i];
+	}
+
+	VkBaseOutStructure* find_in_chain(const void* chain, VkStructureType t)
+	{
+		for (auto* p = static_cast<VkBaseOutStructure*>(const_cast<void*>(chain)); p; p = p->pNext)
+			if (p->sType == t) return p;
+		return nullptr;
+	}
+
+	// Feature structs promoted to Vulkan 1.2: they may not be chained next to VkPhysicalDeviceVulkan12Features
+	// (RPCS3 always chains that), so their fields go into it
+	bool merge_into_v12(const VkBaseOutStructure* s, VkPhysicalDeviceVulkan12Features& v12)
+	{
+		switch (s->sType)
+		{
+		case VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_VULKAN_1_2_FEATURES:
+			or_bools(&v12, s, sizeof(v12));
+			return true;
+		case VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_SHADER_FLOAT16_INT8_FEATURES:
+		{
+			const auto* f = reinterpret_cast<const VkPhysicalDeviceShaderFloat16Int8Features*>(s);
+			v12.shaderFloat16 |= f->shaderFloat16;
+			v12.shaderInt8 |= f->shaderInt8;
+			return true;
+		}
+		case VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_8BIT_STORAGE_FEATURES:
+		{
+			const auto* f = reinterpret_cast<const VkPhysicalDevice8BitStorageFeatures*>(s);
+			v12.storageBuffer8BitAccess |= f->storageBuffer8BitAccess;
+			v12.uniformAndStorageBuffer8BitAccess |= f->uniformAndStorageBuffer8BitAccess;
+			v12.storagePushConstant8 |= f->storagePushConstant8;
+			return true;
+		}
+		case VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_SHADER_SUBGROUP_EXTENDED_TYPES_FEATURES:
+			v12.shaderSubgroupExtendedTypes |= reinterpret_cast<const VkPhysicalDeviceShaderSubgroupExtendedTypesFeatures*>(s)->shaderSubgroupExtendedTypes;
+			return true;
+		case VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_DESCRIPTOR_INDEXING_FEATURES:
+			// same members, in the same order, as the descriptor-indexing block of the 1.2 struct
+			or_bools(reinterpret_cast<char*>(&v12.shaderInputAttachmentArrayDynamicIndexing) - hdr, s, sizeof(VkPhysicalDeviceDescriptorIndexingFeatures));
+			return true;
+		default:
+			return false;
+		}
+	}
+
+	// Copies of the structs chained into VkDeviceCreateInfo (they must outlive vkCreateDevice)
+	std::vector<std::unique_ptr<unsigned char[]>> g_chain_store;
+	std::vector<std::string> g_dev_ext_store;
+
+	// The XeSS requirement queries need the VkInstance the device is created from, which the device.cpp hook
+	// does not see: ask through a short-lived instance of the same API version on the same GPU (matched by UUID).
+	struct temp_instance
+	{
+		VkInstance inst = VK_NULL_HANDLE;
+		VkPhysicalDevice pdev = VK_NULL_HANDLE;
+		~temp_instance() { if (inst) vkDestroyInstance(inst, nullptr); }
+	};
+
+	bool open_temp_instance(VkPhysicalDevice target, temp_instance& t)
+	{
+		uint32_t n = 0;
+		const char* const* exts = nullptr;
+		uint32_t api = 0;
+		if (g_x.req_instance(&n, &exts, &api) != XESS_RESULT_SUCCESS) return false;
+		VkApplicationInfo app{ VK_STRUCTURE_TYPE_APPLICATION_INFO };
+		app.pApplicationName = "r2xess-query";
+		app.apiVersion = VK_API_VERSION_1_2;
+		VkInstanceCreateInfo ci{ VK_STRUCTURE_TYPE_INSTANCE_CREATE_INFO };
+		ci.pApplicationInfo = &app;
+		ci.enabledExtensionCount = n;
+		ci.ppEnabledExtensionNames = exts;
+		if (vkCreateInstance(&ci, nullptr, &t.inst) != VK_SUCCESS)
+		{
+			t.inst = VK_NULL_HANDLE;
+			return false;
+		}
+		VkPhysicalDeviceIDProperties want_id{ VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_ID_PROPERTIES };
+		VkPhysicalDeviceProperties2 want{ VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_PROPERTIES_2, &want_id };
+		vkGetPhysicalDeviceProperties2(target, &want);
+		uint32_t count = 0;
+		vkEnumeratePhysicalDevices(t.inst, &count, nullptr);
+		std::vector<VkPhysicalDevice> devs(count);
+		vkEnumeratePhysicalDevices(t.inst, &count, devs.data());
+		for (VkPhysicalDevice d : devs)
+		{
+			VkPhysicalDeviceIDProperties id{ VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_ID_PROPERTIES };
+			VkPhysicalDeviceProperties2 p{ VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_PROPERTIES_2, &id };
+			vkGetPhysicalDeviceProperties2(d, &p);
+			if (std::memcmp(id.deviceUUID, want_id.deviceUUID, VK_UUID_SIZE) == 0)
+			{
+				t.pdev = d;
+				return true;
+			}
+		}
+		return false;
+	}
+}
+
+namespace vk::r2xess
+{
+	bool load()
+	{
+		if (g_failed) return false;
+		if (g_x.tried) return g_x.dll != nullptr;
+		g_x.tried = true;
+		wchar_t path[MAX_PATH] = {};
+		DWORD n = GetModuleFileNameW(nullptr, path, MAX_PATH);
+		std::wstring dir(path, n);
+		const auto slash = dir.find_last_of(L"\\/");
+		dir = slash == std::wstring::npos ? std::wstring(L".") : dir.substr(0, slash);
+		const std::wstring dll = dir + L"\\libxess.dll";
+		HMODULE m = LoadLibraryExW(dll.c_str(), nullptr, LOAD_WITH_ALTERED_SEARCH_PATH);
+		if (!m)
+		{
+			fail("libxess.dll not found next to the game");
+			return false;
+		}
+		auto get = [m](auto& fn, const char* name) { fn = reinterpret_cast<std::remove_reference_t<decltype(fn)>>(reinterpret_cast<void*>(GetProcAddress(m, name))); return fn != nullptr; };
+		bool ok = true;
+		ok &= get(g_x.req_instance, "xessVKGetRequiredInstanceExtensions");
+		ok &= get(g_x.req_device, "xessVKGetRequiredDeviceExtensions");
+		ok &= get(g_x.req_features, "xessVKGetRequiredDeviceFeatures");
+		ok &= get(g_x.create_context, "xessVKCreateContext");
+		ok &= get(g_x.init, "xessVKInit");
+		ok &= get(g_x.execute, "xessVKExecute");
+		ok &= get(g_x.destroy_context, "xessDestroyContext");
+		ok &= get(g_x.optimal_input, "xessGetOptimalInputResolution");
+		ok &= get(g_x.set_velocity_scale, "xessSetVelocityScale");
+		get(g_x.get_version, "xessGetVersion");
+		get(g_x.set_jitter_scale, "xessSetJitterScale");
+		get(g_x.set_logging, "xessSetLoggingCallback");
+		get(g_x.optimal_driver, "xessIsOptimalDriver");
+		if (!ok)
+		{
+			FreeLibrary(m);
+			fail("libxess.dll has no XeSS Vulkan exports (too old?)");
+			return false;
+		}
+		g_x.dll = m;
+		xess_version_t v{};
+		if (g_x.get_version && g_x.get_version(&v) == XESS_RESULT_SUCCESS) xlog("libxess.dll %u.%u.%u loaded", v.major, v.minor, v.patch);
+		return true;
+	}
+
+	bool usable()
+	{
+		return !g_failed && g_x.dll;
+	}
+
+	void fail(const char* why)
+	{
+		if (g_failed) return;
+		g_failed = true;
+		xlog("unavailable (%s); falling back to FSR 3.1", why);
+	}
+
+	void extend_instance(std::vector<const char*>& extensions, uint32_t api_version)
+	{
+		if (!load()) return;
+		uint32_t n = 0;
+		const char* const* names = nullptr;
+		uint32_t min_api = 0;
+		const xess_result_t r = g_x.req_instance(&n, &names, &min_api);
+		if (r != XESS_RESULT_SUCCESS)
+		{
+			fail(("instance requirements query failed, code " + std::to_string(static_cast<int>(r))).c_str());
+			return;
+		}
+		if (min_api > api_version)
+		{
+			fail("needs a newer Vulkan API version than the renderer creates");
+			return;
+		}
+		for (uint32_t i = 0; i < n; ++i) push_unique(extensions, names[i]);
+	}
+
+	void extend_device(VkPhysicalDevice pdev, std::vector<const char*>& extensions, VkPhysicalDeviceFeatures& features,
+		VkPhysicalDeviceVulkan12Features& vulkan12, VkDeviceCreateInfo& info)
+	{
+		if (!load()) return;
+		temp_instance t;
+		if (!open_temp_instance(pdev, t))
+		{
+			fail("could not query the device requirements");
+			return;
+		}
+
+		uint32_t n = 0;
+		const char* const* names = nullptr;
+		xess_result_t r = g_x.req_device(t.inst, t.pdev, &n, &names);
+		if (r != XESS_RESULT_SUCCESS)
+		{
+			fail(("GPU or driver not supported (device extensions, code " + std::to_string(static_cast<int>(r)) + ")").c_str());
+			return;
+		}
+		VkPhysicalDeviceFeatures2 f2{ VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_FEATURES_2 };
+		void* chain = &f2;
+		r = g_x.req_features(t.inst, t.pdev, &chain);
+		if (r != XESS_RESULT_SUCCESS)
+		{
+			fail(("GPU or driver not supported (device features, code " + std::to_string(static_cast<int>(r)) + ")").c_str());
+			return;
+		}
+
+		// Everything below is copied: the strings and structs belong to the temporary instance's queries
+		g_dev_ext_store.clear();
+		g_chain_store.clear();
+		g_dev_ext_store.reserve(n);
+		for (uint32_t i = 0; i < n; ++i)
+		{
+			bool have = false;
+			for (const char* e : extensions) have = have || std::strcmp(e, names[i]) == 0;
+			if (have) continue;
+			g_dev_ext_store.emplace_back(names[i]);
+		}
+		// pointers taken after all strings are stored (the reserve keeps them stable)
+		for (const auto& s : g_dev_ext_store) push_unique(extensions, s.c_str());
+
+		auto* fb = reinterpret_cast<VkBool32*>(&features);
+		const auto* xb = reinterpret_cast<const VkBool32*>(&f2.features);
+		for (size_t i = 0; i < sizeof(VkPhysicalDeviceFeatures) / sizeof(VkBool32); ++i) fb[i] |= xb[i];
+
+		const auto* x = static_cast<const VkBaseOutStructure*>(f2.pNext);
+		for (; x; x = x->pNext)
+		{
+			if (merge_into_v12(x, vulkan12)) continue;
+			const size_t size = feature_size(x->sType);
+			if (!size)
+			{
+				xlog("device feature struct %d is not known here; XeSS may fail to start", static_cast<int>(x->sType));
+				continue;
+			}
+			if (VkBaseOutStructure* have = find_in_chain(info.pNext, x->sType))
+			{
+				or_bools(have, x, size);
+				continue;
+			}
+			if (x->sType == VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_VULKAN_1_1_FEATURES || x->sType == VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_VULKAN_1_3_FEATURES)
+			{
+				// the renderer is Vulkan 1.2 and chains the 1.1-promoted structs separately
+				xlog("XeSS asked for a Vulkan %s feature block; not chained", x->sType == VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_VULKAN_1_1_FEATURES ? "1.1" : "1.3");
+				continue;
+			}
+			auto copy = std::make_unique<unsigned char[]>(size);
+			std::memcpy(copy.get(), x, size);
+			auto* c = reinterpret_cast<VkBaseOutStructure*>(copy.get());
+			c->pNext = static_cast<VkBaseOutStructure*>(const_cast<void*>(info.pNext));
+			info.pNext = c;
+			g_chain_store.push_back(std::move(copy));
+		}
+		info.enabledExtensionCount = static_cast<uint32_t>(extensions.size());
+		info.ppEnabledExtensionNames = extensions.data();
+		xlog("device requirements added (%u extensions)", n);
+	}
+
+	bool create(VkInstance instance, VkPhysicalDevice pdev, VkDevice device, uint32_t rw, uint32_t rh, uint32_t ow, uint32_t oh, int flags)
+	{
+		if (!load()) return false;
+		if (!g_s.ctx)
+		{
+			const xess_result_t r = g_x.create_context(instance, pdev, device, &g_s.ctx);
+			if (r != XESS_RESULT_SUCCESS || !g_s.ctx)
+			{
+				g_s.ctx = nullptr;
+				fail(("context creation failed, code " + std::to_string(static_cast<int>(r)) + ": GPU or driver not supported").c_str());
+				return false;
+			}
+			if (g_x.set_logging)
+				g_x.set_logging(g_s.ctx, xcfg().log ? XESS_LOGGING_LEVEL_INFO : XESS_LOGGING_LEVEL_ERROR, xess_message);
+			if (g_x.optimal_driver && g_x.optimal_driver(g_s.ctx) == XESS_RESULT_WARNING_OLD_DRIVER)
+				xlog("note: the GPU driver is older than XeSS recommends");
+		}
+		const int q = pick(rw, rh, ow, oh);
+		if (!q)
+		{
+			release();
+			fail(("no XeSS preset covers " + std::to_string(rw) + "x" + std::to_string(rh) + " -> " + std::to_string(ow) + "x" + std::to_string(oh)).c_str());
+			return false;
+		}
+		xess_vk_init_params_t ip{};
+		ip.outputResolution = { ow, oh };
+		ip.qualitySetting = static_cast<xess_quality_settings_t>(q);
+		// low-res motion vectors (render size, the default) + depth; colour as the scene stores it
+		ip.initFlags = ((flags & 1) ? XESS_INIT_FLAG_INVERTED_DEPTH : 0u) |
+			((flags & 2) ? XESS_INIT_FLAG_ENABLE_AUTOEXPOSURE : XESS_INIT_FLAG_LDR_INPUT_COLOR);
+		const xess_result_t r = g_x.init(g_s.ctx, &ip);
+		if (r != XESS_RESULT_SUCCESS)
+		{
+			release();
+			fail(("initialisation failed, code " + std::to_string(static_cast<int>(r))).c_str());
+			return false;
+		}
+		g_s.quality = q;
+		g_s.mv_x = g_s.mv_y = 0.f;
+		g_s.exec_fails = 0;
+		if (g_x.set_jitter_scale) g_x.set_jitter_scale(g_s.ctx, xcfg().jsign, xcfg().jsign * xcfg().jsign_y);
+		xlog("%s at %ux%u -> %ux%u (%s depth, %s colour)", qname(q), rw, rh, ow, oh, (flags & 1) ? "inverted" : "standard", (flags & 2) ? "HDR" : "LDR");
+		return true;
+	}
+
+	bool eval(VkCommandBuffer cmd, const image& color, const image& depth, const image& mv, const image& out,
+		uint32_t rw, uint32_t rh, float jx, float jy, float mv_scale_x, float mv_scale_y, bool reset)
+	{
+		if (!g_s.ctx || g_failed) return false;
+		if (mv_scale_x != g_s.mv_x || mv_scale_y != g_s.mv_y)
+		{
+			g_x.set_velocity_scale(g_s.ctx, mv_scale_x, mv_scale_y);
+			g_s.mv_x = mv_scale_x;
+			g_s.mv_y = mv_scale_y;
+		}
+		auto info = [](const image& i)
+		{
+			xess_vk_image_view_info v{};
+			v.imageView = i.view;
+			v.image = i.image;
+			v.subresourceRange = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0, 1 };
+			v.format = i.format;
+			v.width = i.width;
+			v.height = i.height;
+			return v;
+		};
+		xess_vk_execute_params_t ep{};
+		ep.colorTexture = info(color);
+		ep.velocityTexture = info(mv);
+		ep.depthTexture = info(depth); // an R32_SFLOAT copy of the scene depth: a colour-aspect image
+		ep.outputTexture = info(out);
+		ep.jitterOffsetX = jx;
+		ep.jitterOffsetY = jy;
+		ep.exposureScale = 1.f;
+		ep.resetHistory = reset ? 1u : 0u;
+		ep.inputWidth = rw;
+		ep.inputHeight = rh;
+		const xess_result_t r = g_x.execute(g_s.ctx, cmd, &ep);
+		if (r == XESS_RESULT_SUCCESS)
+		{
+			g_s.exec_fails = 0;
+			return true;
+		}
+		if (++g_s.exec_fails >= 3)
+			fail(("execution failed 3 times, code " + std::to_string(static_cast<int>(r))).c_str());
+		else
+			xlog("execution failed, code %d", static_cast<int>(r));
+		return false;
+	}
+
+	void release()
+	{
+		if (g_s.ctx && g_x.destroy_context) g_x.destroy_context(g_s.ctx);
+		g_s.ctx = nullptr;
+		g_s.quality = 0;
+	}
+
+	const char* quality_name()
+	{
+		return qname(g_s.quality);
+	}
+}
+
+#else // no XeSS headers (or not Windows): inert
+
+namespace vk::r2xess
+{
+	bool load()
+	{
+		static bool logged = false;
+		if (!logged) xlog("built without the XeSS headers (tools/xess/inc); falling back to FSR 3.1");
+		logged = true;
+		g_failed = true;
+		return false;
+	}
+	bool usable() { return false; }
+	void fail(const char*) { g_failed = true; }
+	void extend_instance(std::vector<const char*>&, uint32_t) {}
+	void extend_device(VkPhysicalDevice, std::vector<const char*>&, VkPhysicalDeviceFeatures&, VkPhysicalDeviceVulkan12Features&, VkDeviceCreateInfo&) {}
+	bool create(VkInstance, VkPhysicalDevice, VkDevice, uint32_t, uint32_t, uint32_t, uint32_t, int) { return false; }
+	bool eval(VkCommandBuffer, const image&, const image&, const image&, const image&, uint32_t, uint32_t, float, float, float, float, bool) { return false; }
+	void release() {}
+	const char* quality_name() { return "none"; }
+}
+
+#endif
diff --git a/rpcs3/Emu/RSX/VK/VKR2XeSS.h b/rpcs3/Emu/RSX/VK/VKR2XeSS.h
new file mode 100644
index 0000000..b72f402
--- /dev/null
+++ b/rpcs3/Emu/RSX/VK/VKR2XeSS.h
@@ -0,0 +1,67 @@
+// R2PORT: port addition (not upstream RPCS3).
+// Intel XeSS (Xe Super Sampling, libxess.dll Vulkan API) as a third backend of the VKR2Upscaler temporal
+// AA / upscaler, next to FSR 3.1 and DLSS: RSX_FSR=4 (3 is FSR 3.1 on the native renderer). It takes exactly the inputs VKGSRender::r2aa_run prepares
+// for the other two (colour, depth, motion vectors at the render size; output at the upscaled size) and
+// falls back to FSR 3.1 when libxess.dll is missing or the GPU/driver cannot run it (XeSS runs on any
+// GPU with Vulkan 1.2 + VK_EXT_mutable_descriptor_type: XMX on Intel Arc, DP4a elsewhere).
+// libxess.dll is loaded at run time from the exe folder; nothing links it. Built with the XeSS headers
+// (tools/xess/inc, R2PORT_HAVE_XESS) or as inert stubs without them.
+//
+// Environment (read once):
+//   RSX_XESS_QUALITY       auto (default) | aa | uqp | uq | q | b | p | up  (preset; auto = the one made for the
+//                          scene's render scale, RSX_UPSCALE; "aa" = native-resolution anti-aliasing)
+//   RSX_XESS_JITTER_SIGN   -1 flips the jitter handed to XeSS (both axes; RSX_XESS_JITTER_SIGN_Y only vertical)
+//   RSX_XESS_LOG           1: XeSS's own warnings/info in the log (errors are always logged)
+#pragma once
+
+#include "VulkanAPI.h"
+#include <cstdint>
+#include <vector>
+
+namespace vk::r2xess
+{
+	// One input/output image: the full image is used, from (0,0); 'width'/'height' are its extent
+	struct image
+	{
+		VkImage image = VK_NULL_HANDLE;
+		VkImageView view = VK_NULL_HANDLE;
+		VkFormat format = VK_FORMAT_UNDEFINED;
+		uint32_t width = 0, height = 0;
+	};
+
+	// Loads libxess.dll next to the exe (once). False when it is missing, incomplete, or XeSS failed before.
+	bool load();
+
+	// Loaded and not given up on
+	bool usable();
+
+	// Gives up on XeSS for the rest of the session (logged once); the caller falls back to FSR 3.1
+	void fail(const char* why);
+
+	// instance.cpp hook (r2aa_extend_instance): add the instance extensions XeSS asks for.
+	// 'api_version' is the VkApplicationInfo::apiVersion the instance is created with.
+	void extend_instance(std::vector<const char*>& extensions, uint32_t api_version);
+
+	// device.cpp hook (r2aa_extend_device), right before vkCreateDevice: enable the device extensions and
+	// features XeSS needs. Features RPCS3 already chains are merged in place (base features, Vulkan 1.2 features,
+	// existing feature structs); others are chained into 'info'. Re-points 'info' at 'extensions'.
+	void extend_device(VkPhysicalDevice pdev, std::vector<const char*>& extensions, VkPhysicalDeviceFeatures& features,
+		VkPhysicalDeviceVulkan12Features& vulkan12, VkDeviceCreateInfo& info);
+
+	// (Re)initialises XeSS for rw x rh -> ow x oh. The GPU must be idle on the previous setup (the caller flushes).
+	// flags: 1 = inverted depth (near = 1), 2 = HDR input (linear FP16 colour; else display-referred LDR colour).
+	// True when XeSS is ready; on false the caller falls back (fail() has been called).
+	bool create(VkInstance instance, VkPhysicalDevice pdev, VkDevice device, uint32_t rw, uint32_t rh, uint32_t ow, uint32_t oh, int flags);
+
