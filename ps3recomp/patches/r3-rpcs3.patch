+						const u32* qq = map.find(mix64(base, k), false);
+						if (!qq) break;
+						if (*qq != *pp && unchanged(*qq)) hit = *qq;
+					}
+				};
+				scan(st.om_prev, e.kbase);
+				if (r2cfg().match_loose) scan(st.prev_loose, e.lkbase);
+			}
+			// 1 in 16 hits takes the full path (om_exact_ref keeps learning om_rows_whole)
+			if (hit != UINT32_MAX && (++st.om_fast_seq & 15) == 0)
+			{
+				st.om_fast_chk++;
+				hit = UINT32_MAX;
+			}
+			if (hit != UINT32_MAX)
+			{
+				if (hit != *pp)
+				{
+					e.prev = hit;
+					st.om_nr_repaired++;
+				}
+				st.om_fast++;
+				st.om_nr_exact++;
+				st.om_nr_static++;
+				return;
+			}
+		}
+		if (e.prog->indexed)
+		{
+			// Skinned: animated when a palette constant changed (direct reads = view/projection are left out)
+			if (p.prog != e.prog || !p.prog->indexed)
+			{
+				e.om |= om_skin;
+				return;
+			}
+			const float* a = st.cur_F.consts.data() + e.const_off;
+			const float* b = st.prev_F.consts.data() + p.const_off;
+			for (const u16 c : e.prog->pal)
+				if (std::memcmp(a + c * 4, b + c * 4, 4 * sizeof(float)) != 0)
+				{
+					// RSX_DLSS_OBJMV_PAIR_NEAREST: the palette of another instance (the draw order shifted)?
+					const auto pal_dist = [&](const mvp_entry& q, double bound) -> double
+					{
+						const float* qb = st.prev_F.consts.data() + q.const_off;
+						double d = 0;
+						for (const u16 k : e.prog->pal)
+						{
+							for (u32 j = 0; j < 4; ++j) d += std::fabs(static_cast<double>(a[k * 4 + j]) - qb[k * 4 + j]);
+							if (d >= bound) break;
+						}
+						return d;
+					};
+					if (om_pair_nearest(e, [&](const mvp_entry& q, double bound) -> double
+						{ return q.prog == e.prog ? pal_dist(q, bound) : -1.0; }, pal_dist(p, HUGE_VAL)))
+						return;
+					e.om |= om_skin;
+					return;
+				}
+			return;
+		}
+		if (!resolve_entry(st.cur_F, i) || !resolve_entry(st.prev_F, *pp))
+		{
+			// RSX_DLSS_OBJMV_NONAFFINE (default 1): a position that is no affine function of the input (wind-swayed
+			// foliage, waving cloth: sin(time + position)) has no matrix. It used to get camera motion only (boiling
+			// foliage); when its constants changed since last frame it is a moving draw: GPU history + onepass velocity.
+			if (r2cfg().om_nonaffine && e.state == 2 && p.prog == e.prog && !e.loose)
+			{
+				const float* a = st.cur_F.consts.data() + e.const_off;
+				const float* b = st.prev_F.consts.data() + p.const_off;
+				if (std::memcmp(a, b, e.prog->reads.size() * 4 * sizeof(float)) != 0)
+				{
+					// RSX_DLSS_OBJMV_PAIR_NEAREST: another instance's constants (the draw order shifted)? The camera rows
+					// (when known) are left out: the same for every previous-frame candidate.
+					const auto& rd = e.prog->reads;
+					const u32 row0 = e.prog->vprow >= 0 && e.prog->vp_ok == 1 ? static_cast<u32>(e.prog->vprow) : ~0u;
+					const auto c_dist = [&](const mvp_entry& q, double bound) -> double
+					{
+						if (q.prog != e.prog || q.branch_bits != e.branch_bits) return -1.0;
+						const float* qb = st.prev_F.consts.data() + q.const_off;
+						double d = 0;
+						for (usz k = 0; k < rd.size(); ++k)
+						{
+							if (rd[k] >= row0 && rd[k] < row0 + 4) continue;
+							for (u32 j = 0; j < 4; ++j) d += std::fabs(static_cast<double>(a[k * 4 + j]) - qb[k * 4 + j]);
+							if (d >= bound) break;
+						}
+						return d;
+					};
+					if (om_pair_nearest(e, c_dist, p.branch_bits == e.branch_bits ? c_dist(p, HUGE_VAL) : HUGE_VAL))
+						return;
+					e.om |= om_rigid;
+					st.om_nonaffine++;
+				}
+			}
+			return; // camera motion only
+		}
+		m4 inv;
+		if (!m4_inverse(e.M, inv)) return;
+		const m4 r = m4_mul(p.M, inv);
+		if (!std::isfinite(m4_maxabs(r))) return;
+		if (r2cfg().om_nearest && r2cfg().om_exact_ref)
+		{
+			m4 Rx;
+			if (om_exact_ref(e, p, Rx))
+			{
+				if (m4_maxdiff(Rx, r) <= 1e-3 * (1.0 + m4_maxabs(r)))
+				{
+					st.om_nr_exact++;
+					st.om_nr_static++;
+					return;
+				}
+				if (om_pick_nearest(e, *pp, Rx, true)) return;
+			}
+		}
+		// Provisional camera: the most common R so far this frame (static geometry). Draws agreeing with it need no
+		// redraw; the final vote at the upscaler decides for the redrawn ones.
+		const double tol = 1e-3 * (1.0 + m4_maxabs(r));
+		u32 hit = st.om_nclus;
+		for (u32 c = 0; c < st.om_nclus && hit == st.om_nclus; ++c)
+			if (m4_maxdiff(st.om_clus[c].R, r) <= tol) hit = c;
+		if (hit < st.om_nclus) st.om_clus[hit].n++;
+		else if (st.om_nclus < 4) { hit = st.om_nclus++; st.om_clus[hit] = { r, 1 }; }
+		else
+		{
+			u32 low = 0;
+			for (u32 c = 1; c < 4; ++c) if (st.om_clus[c].n < st.om_clus[low].n) low = c;
+			if (st.om_clus[low].n <= 1) { hit = low; st.om_clus[low] = { r, 1 }; }
+		}
+		u32 best = 0;
+		for (u32 c = 1; c < st.om_nclus; ++c) if (st.om_clus[c].n > st.om_clus[best].n) best = c;
+		if (!(hit < st.om_nclus && hit == best && st.om_clus[best].n >= 3))
+		{
+			if (r2cfg().om_nearest && st.om_clus[best].n >= 3)
+			{
+				const u32 st0 = st.om_nr_static;
+				const bool done = om_pick_nearest(e, *pp, st.om_clus[best].R, false);
+				if (st.om_nr_static != st0) st.om_clus[best].n++;
+				if (done) return;
+			}
+			// RSX_DLSS_OBJMV_REPAIR: a reordered/culled row of identical props pairs instance N with last frame's N+1.
+			// Another occurrence of the same key that moved exactly like the camera is this one, standing still.
+			if (r2cfg().om_repair && e.kbase && st.om_clus[best].n >= 3)
+			{
+				for (u32 k = 0; k < 64; ++k)
+				{
+					const u32* qq = st.om_prev.find(mix64(e.kbase, k), false);
+					if (!qq) break;
+					if (*qq == *pp || !resolve_entry(st.prev_F, *qq)) continue;
+					const m4 r2 = m4_mul(st.prev_F.e[*qq].M, inv);
+					if (std::isfinite(m4_maxabs(r2)) && m4_maxdiff(st.om_clus[best].R, r2) <= 1e-3 * (1.0 + m4_maxabs(r2)))
+					{
+						e.prev = *qq;
+						st.om_clus[best].n++;
+						st.om_repaired++;
+						return;
+					}
+				}
+			}
+			if (e.loose)
+			{
+				// RSX_AA_MATCH_LOOSE: the ordinal may pair two different objects of the same material. Re-pair with
+				// another loose occurrence that moved like the camera, else keep the pair only if the object's origin
+				// moved plausibly (RSX_DLSS_OBJMV_LIMIT) relative to the provisional camera; otherwise camera motion.
+				if (st.om_clus[best].n < 3)
+				{
+					om_loose_reject(e);
+					return;
+				}
+				if (r2cfg().om_repair && e.lkbase)
+				{
+					for (u32 k = 0; k < 64; ++k)
+					{
+						const u32* qq = st.prev_loose.find(mix64(e.lkbase, k), false);
+						if (!qq) break;
+						if (*qq == *pp || *qq >= st.prev_F.e.size() || st.prev_F.e[*qq].prog != e.prog || !resolve_entry(st.prev_F, *qq)) continue;
+						const m4 r2 = m4_mul(st.prev_F.e[*qq].M, inv);
+						if (std::isfinite(m4_maxabs(r2)) && m4_maxdiff(st.om_clus[best].R, r2) <= 1e-3 * (1.0 + m4_maxabs(r2)))
+						{
+							e.prev = *qq;
+							st.om_clus[best].n++;
+							st.om_repaired++;
+							return;
+						}
+					}
+				}
+				const m4& Mp = st.prev_F.e[e.prev].M;
+				const m4& Rc = st.om_clus[best].R;
+				double a[4], b[4];
+				for (int r = 0; r < 4; ++r)
+				{
+					a[r] = Mp.m[r][3];
+					b[r] = 0;
+					for (int k = 0; k < 4; ++k) b[r] += Rc.m[r][k] * e.M.m[k][3];
+				}
+				const double d = (std::fabs(a[3]) > 1e-9 && std::fabs(b[3]) > 1e-9)
+					? std::hypot(a[0] / a[3] - b[0] / b[3], a[1] / a[3] - b[1] / b[3]) * 0.5 : 1e9;
+				if (!(std::isfinite(d) && d <= r2cfg().om_max_motion))
+				{
+					om_loose_reject(e);
+					return;
+				}
+			}
+			e.om |= om_rigid;
+		}
+	}
