+	// Camera motion R = M_prev * M_cur^-1, voted over all draws present in both frames
+	bool vote_camera(m4& R, u32& matched, u32& members, double zA = 1.0, double zB = 0.0, double rh = 0.0)
+	{
+		auto& st = g_r2;
+		// RSX_AA_VOTE_OM_PREV (default 1, 0 = off): with objmv on, om_prev is this exact map, built at the swap
