+// R2PORT PC extras (not upstream RPCS3): HDR output, colour-blind filter, NVIDIA Reflex.
+//
+//  * HDR (R2_HDR=0 / auto / 1 HDR10 / scrgb, R2_HDR_PAPER nits, R2_HDR_PEAK nits, R2_HDR_SAT 0..2;
+//    PORT_HDR* too -- settings, Windows HDR detection and the shader code are in VKR2Hdr.cpp):
+//    VK_EXT_swapchain_colorspace picks an A2B10G10R10 + ST2084 (HDR10) or RGBA16F +
+//    extended-sRGB-linear (scRGB) swapchain, as SpecialK does on DXGI. The final present pass
+//    (video_out_calibration_pass) keeps the SDR image at paper white, expands only the highlights
+//    towards the display peak, and encodes PQ / scRGB. VK_EXT_hdr_metadata sends the
+//    mastering metadata. Windows HDR off or no HDR swapchain format -> SDR, logged.
+//  * Colour-blind filter (R2_COLORBLIND=1/2/3, live via g_pc_cvd_mode): daltonization in the same pass.
+//  * Reflex (R2_REFLEX=1, 2 = boost): VK_NV_low_latency2 sleep mode on the swapchain and a
+//    vkLatencySleepNV at the start of each game frame (r2pc_reflex_sleep, called by the game's
+//    frame limiter). minimumIntervalUs stays 0: the game's own limiter remains the only limiter.
+//    Latency markers (vkSetLatencyMarkerNV, placed as R1's rfom_reflex.cpp does; one id per game frame):
+//      SIMULATION_START / _END    game thread, r2pc_reflex_sleep (after the sleep / at the next frame start)
+//      INPUT_SAMPLE               first port-0 cellPadGetData of the frame (g_pad_input_hook)
+//      RENDERSUBMIT_START         RSX thread, first draw of the frame (r2pc_latency_render(0), VKGSRender.cpp)
+//      RENDERSUBMIT_END / PRESENT_START / PRESENT_END   around m_swapchain->present (VKPresent.cpp)
+//    The RSX thread runs behind the game thread: finished game frame ids are queued at SIMULATION_END
+//    and taken by the render side when it starts that frame. R2_REFLEX_MARKERS=0 = sleep only (old).
+//  * AMD Anti-Lag 2 (PORT_LATENCY=antilag / auto on a Radeon, port_latency.h): VK_AMD_anti_lag,
+//    vkAntiLagUpdateAMD with the INPUT stage at the game's frame start (where the delay is inserted) and
+//    the PRESENT stage just before vkQueuePresentKHR, same frame ids as the Reflex markers. Off while
+//    frame generation is on (it owns the swapchain).
+//  Overlays RPCS3 draws after the present pass (none in normal play) stay SDR-encoded.
+
+#include "stdafx.h"
+#include "VKR2PcExtras.h"
+#include "VKR2Hdr.h"
+#include "VKR2FrameGen.h" // R2PORT frame generation
+#include "../../../../../../include/ps3emu/port_latency.h"
+
+#include <atomic>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <mutex>
+
+extern "C"
+{
+	volatile int g_pc_cvd_mode = 0;
+	volatile int g_pc_hdr_active = 0;
+	volatile int g_pc_reflex_active = 0;
+	volatile int g_pc_antilag_active = 0;
+	// cellPad.c owns g_pad_input_hook; builds without cellPad (tools, tests) get this null pointer
+	void (*volatile r2pc_pad_input_hook_default)(void) = nullptr;
+	extern void (*volatile g_pad_input_hook)(void);
+}
+#ifdef _WIN32
+#pragma comment(linker, "/alternatename:g_pad_input_hook=r2pc_pad_input_hook_default")
+#endif
+
+namespace
+{
+	const char* penv(const char* name)
+	{
+		for (const char* pre : { "R2_", "R3_", "R1_" })
+		{
+			char full[96];
+			std::snprintf(full, sizeof(full), "%s%s", pre, name);
+			const char* e = std::getenv(full);
+			if (e && *e) return e;
+		}
+		return nullptr;
+	}
+	int penv_int(const char* name, int def) { const char* e = penv(name); return e ? std::atoi(e) : def; }
+
+	// 0 off, 1 HDR10, 2 scRGB (VKR2Hdr: R2_/R3_/R1_HDR, else PORT_HDR; auto counts as HDR10 here)
+	int hdr_request()
+	{
+		return r2hdr::request();
+	}
+	unsigned g_vendor = 0; // PCI vendor id of the device being created (r2pc_extend_device)
+
+	int latency_mode()
+	{
+		static int m = -1;
+		if (m < 0) m = port_latency_parse(std::getenv("PORT_LATENCY"));
+		return m;
+	}
+	int reflex_request()
+	{
+		if (vk::r2fg_owns_reflex()) return 0; // Streamline drives Reflex for frame generation
+		static int r = -1;
+		if (r < 0) r = port_latency_reflex(latency_mode(), penv_int("REFLEX", 0), g_vendor);
+		return r;
+	}
+	bool antilag_request()
+	{
+		if (vk::r2fg_owns_reflex()) return false; // frame generation owns the swapchain / latency handling
+		return port_latency_antilag(latency_mode(), g_vendor) != 0;
+	}
+
+	struct pc_state
+	{
+		std::mutex mu;
+		VkDevice dev = VK_NULL_HANDLE;
+		VkSwapchainKHR swapchain = VK_NULL_HANDLE;
+		bool hdr_metadata_ext = false;
+		bool low_latency_ext = false;
+		bool anti_lag_ext = false;
+		VkSemaphore timeline = VK_NULL_HANDLE;
+		uint64_t value = 0;
+		PFN_vkSetLatencySleepModeNV set_sleep_mode = nullptr;
+		PFN_vkLatencySleepNV sleep = nullptr;
+		PFN_vkSetLatencyMarkerNV set_marker = nullptr;
+		PFN_vkAntiLagUpdateAMD anti_lag = nullptr;
+		PFN_vkWaitSemaphores wait = nullptr;
+		PFN_vkSetHdrMetadataEXT set_hdr = nullptr;
+	} g_pc;
+
+	// Frame ids shared by the Reflex markers and the Anti-Lag 2 frame index (R1 rfom_reflex.cpp scheme).
+	// kind: 0 none, 1 Reflex markers (VK_NV_low_latency2), 2 Anti-Lag 2
+	std::atomic<int> s_lat_kind{0};
+	std::atomic<u64> s_sim{0};
+	std::atomic<int> s_input_done{0};
+	constexpr unsigned LAT_RING = 8;
+	u64 s_ring[LAT_RING];
+	std::atomic<unsigned> s_head{0}, s_tail{0};
+	u64 s_render_id = 0, s_render_last = 0; // RSX thread only
+	bool s_render_open = false;
+
+	void lat_emit(VkLatencyMarkerNV m, u64 id)
+	{
+		if (!id || s_lat_kind.load(std::memory_order_relaxed) != 1) return;
+		std::lock_guard lk(g_pc.mu);
+		if (!g_pc.swapchain || !g_pc.set_marker) return;
+		VkSetLatencyMarkerInfoNV mi{ .sType = VK_STRUCTURE_TYPE_SET_LATENCY_MARKER_INFO_NV, .presentID = id, .marker = m };
+		g_pc.set_marker(g_pc.dev, g_pc.swapchain, &mi);
+	}
+
+	// Anti-Lag 2: the INPUT stage call inserts the latency-reducing delay
+	void antilag_stage(VkAntiLagStageAMD stage, u64 id)
+	{
+		VkDevice dev;
+		PFN_vkAntiLagUpdateAMD fn;
+		{
+			std::lock_guard lk(g_pc.mu);
+			if (!g_pc.anti_lag || !g_pc.dev) return;
+			dev = g_pc.dev;
+			fn = g_pc.anti_lag;
+		}
+		VkAntiLagPresentationInfoAMD pi{ .sType = VK_STRUCTURE_TYPE_ANTI_LAG_PRESENTATION_INFO_AMD, .stage = stage, .frameIndex = id };
+		VkAntiLagDataAMD d{ .sType = VK_STRUCTURE_TYPE_ANTI_LAG_DATA_AMD, .mode = VK_ANTI_LAG_MODE_ON_AMD, .maxFPS = 0, .pPresentationInfo = &pi };
+		fn(dev, &d);
+	}
+
+	void lat_render(int ev)
+	{
+		const int kind = s_lat_kind.load(std::memory_order_relaxed);
+		if (!kind) return;
+		switch (ev)
+		{
+		case 0: // first draw of the frame: RENDERSUBMIT_START
+		{
+			if (s_render_open) return;
+			const unsigned t = s_tail.load(std::memory_order_relaxed);
+			const bool queued = t != s_head.load(std::memory_order_acquire);
+			// 0 = a present without a new game frame (load screens): no markers, never a made-up id
+			const u64 id = port_latency_render_id(queued, queued ? s_ring[t % LAT_RING] : 0, s_sim.load(std::memory_order_relaxed), s_render_last);
+			s_render_id = id;
+			s_render_open = true;
+			lat_emit(VK_LATENCY_MARKER_RENDERSUBMIT_START_NV, id);
+			break;
+		}
+		case 1: // just before vkQueuePresentKHR
+			if (!s_render_open) lat_render(0);
+			lat_emit(VK_LATENCY_MARKER_RENDERSUBMIT_END_NV, s_render_id);
+			lat_emit(VK_LATENCY_MARKER_PRESENT_START_NV, s_render_id);
+			if (kind == 2 && s_render_id) antilag_stage(VK_ANTI_LAG_STAGE_PRESENT_AMD, s_render_id);
+			break;
+		case 2: // after vkQueuePresentKHR
+		{
+			if (!s_render_open) return;
+			lat_emit(VK_LATENCY_MARKER_PRESENT_END_NV, s_render_id);
+			if (s_render_id) s_render_last = s_render_id;
+			s_render_open = false;
+			unsigned t = s_tail.load(std::memory_order_relaxed);
+			while (t != s_head.load(std::memory_order_acquire) && s_ring[t % LAT_RING] <= s_render_last) t++;
+			s_tail.store(t, std::memory_order_release);
+			break;
+		}
+		default: break;
+		}
+	}
+
+	void lat_pad_input()
+	{
+		if (s_lat_kind.load(std::memory_order_relaxed) != 1 || s_input_done.exchange(1, std::memory_order_relaxed)) return;
+		lat_emit(VK_LATENCY_MARKER_INPUT_SAMPLE_NV, s_sim.load(std::memory_order_relaxed));
+	}
+
+	// game thread, frame start: close the previous frame's simulation and queue it for the render side
+	u64 lat_sim_end()
+	{
+		const u64 id = s_sim.load(std::memory_order_relaxed);
+		if (!id) return 0;
+		lat_emit(VK_LATENCY_MARKER_SIMULATION_END_NV, id);
+		const unsigned h = s_head.load(std::memory_order_relaxed);
+		if (h - s_tail.load(std::memory_order_acquire) < LAT_RING) // else the render side is far behind: skip
+		{
+			s_ring[h % LAT_RING] = id;
+			s_head.store(h + 1, std::memory_order_release);
+		}
+		return id;
+	}
+	void lat_sim_start(u64 id)
+	{
+		s_sim.store(id, std::memory_order_relaxed);
+		s_input_done.store(0, std::memory_order_relaxed);
+		lat_emit(VK_LATENCY_MARKER_SIMULATION_START_NV, id);
+	}
+	bool markers_wanted()
+	{
+		static int m = -1;
+		if (m < 0) m = penv_int("REFLEX_MARKERS", 1) ? 1 : 0;
+		return m != 0;
+	}
+
+	void log(const char* fmt, const char* a = "", int b = 0)
+	{
+		std::fprintf(stderr, "[pcx-vk] ");
+		std::fprintf(stderr, fmt, a, b);
+		std::fputc('\n', stderr);
+	}
+}
+
+extern "C" int r2pc_post_active(void)
+{
+	return g_pc_hdr_active || g_pc_cvd_mode;
+}
+
+extern "C" void r2pc_reflex_sleep(void)
+{
+	if (r2fg_game_frame()) return; // R2PORT frame generation: Reflex sleep + markers through Streamline
+	const int kind = s_lat_kind.load(std::memory_order_relaxed);
+	if (kind == 2)
+	{
+		const u64 id = lat_sim_end() + 1;
+		antilag_stage(VK_ANTI_LAG_STAGE_INPUT_AMD, id);
+		lat_sim_start(id);
+		return;
+	}
+	if (!g_pc_reflex_active) return;
+	const u64 next = (kind == 1 ? lat_sim_end() : s_sim.load(std::memory_order_relaxed)) + 1;
+	VkDevice dev = VK_NULL_HANDLE;
+	uint64_t v = 0;
+	bool slept = false;
+	{
+		std::lock_guard lk(g_pc.mu);
+		if (g_pc.swapchain && g_pc.timeline && g_pc.sleep)
+		{
+			dev = g_pc.dev;
+			v = ++g_pc.value;
+			VkLatencySleepInfoNV si{ .sType = VK_STRUCTURE_TYPE_LATENCY_SLEEP_INFO_NV, .signalSemaphore = g_pc.timeline, .value = v };
+			slept = g_pc.sleep(dev, g_pc.swapchain, &si) == VK_SUCCESS;
+		}
+	}
+	if (slept)
+	{
+		VkSemaphoreWaitInfo wi{ .sType = VK_STRUCTURE_TYPE_SEMAPHORE_WAIT_INFO, .semaphoreCount = 1, .pSemaphores = &g_pc.timeline, .pValues = &v };
+		g_pc.wait(dev, &wi, 50'000'000ull); // 50 ms at most: never hold the game up for long
+	}
+	if (kind == 1) lat_sim_start(next);
+}
+
+// RSX thread: 0 = a draw (RENDERSUBMIT_START on the first one of the frame), 1 = just before present, 2 = after it
+extern "C" void r2pc_latency_render(int ev)
+{
+	if (s_lat_kind.load(std::memory_order_relaxed)) lat_render(ev);
+}
+
+namespace vk
+{
+	void r2pc_extend_instance(std::vector<const char*>& extensions)
+	{
+		if (!hdr_request()) return;
+		u32 count = 0;
+		vkEnumerateInstanceExtensionProperties(nullptr, &count, nullptr);
+		std::vector<VkExtensionProperties> props(count);
+		vkEnumerateInstanceExtensionProperties(nullptr, &count, props.data());
+		for (const auto& p : props)
+		{
+			if (std::strcmp(p.extensionName, VK_EXT_SWAPCHAIN_COLOR_SPACE_EXTENSION_NAME) == 0)
+			{
+				for (const char* e : extensions) if (std::strcmp(e, VK_EXT_SWAPCHAIN_COLOR_SPACE_EXTENSION_NAME) == 0) return;
+				extensions.push_back(VK_EXT_SWAPCHAIN_COLOR_SPACE_EXTENSION_NAME);
+				return;
+			}
+		}
+		log("HDR: %sthe Vulkan driver has no VK_EXT_swapchain_colorspace; SDR output");
+	}
+
+	void r2pc_pick_surface_format(const std::vector<VkSurfaceFormatKHR>& formats, VkFormat& format, VkColorSpaceKHR& color_space)
+	{
+		g_pc_hdr_active = 0;
+		const int want = hdr_request();
+		if (!want) return;
+		if (!r2hdr::allowed())
+		{
+			log(r2hdr::display_hdr() == 0 ? "HDR%s: Windows HDR is off for this display; SDR output"
+			                              : "HDR%s: the display's HDR state is unknown; SDR output", r2hdr::is_auto() ? " (auto)" : "");
+			return;
+		}
+		auto find = [&](std::initializer_list<VkFormat> fmts, VkColorSpaceKHR cs) -> bool
+		{
+			for (VkFormat f : fmts)
+				for (const auto& sf : formats)
+					if (sf.format == f && sf.colorSpace == cs) { format = f; color_space = cs; return true; }
+			return false;
+		};
+		const auto hdr10 = [&] { return find({ VK_FORMAT_A2B10G10R10_UNORM_PACK32, VK_FORMAT_A2R10G10B10_UNORM_PACK32 }, VK_COLOR_SPACE_HDR10_ST2084_EXT); };
+		const auto scrgb = [&] { return find({ VK_FORMAT_R16G16B16A16_SFLOAT }, VK_COLOR_SPACE_EXTENDED_SRGB_LINEAR_EXT); };
+		if (want == 2) g_pc_hdr_active = scrgb() ? 2 : hdr10() ? 1 : 0;
+		else g_pc_hdr_active = hdr10() ? 1 : scrgb() ? 2 : 0;
+		for (const auto& sf : formats) // R3 #13: what the display offers, for HDR colour reports
+			if (sf.colorSpace != VK_COLOR_SPACE_SRGB_NONLINEAR_KHR)
+				std::fprintf(stderr, "[pcx-vk] HDR: surface offers format %d colour space %d\n", static_cast<int>(sf.format), static_cast<int>(sf.colorSpace));
+		if (g_pc_hdr_active)
+			std::fprintf(stderr, "[pcx-vk] HDR output%s: %s swapchain (format %d), paper white %.0f nits, peak %.0f nits (%s), saturation %.2f\n",
+				r2hdr::is_auto() ? " (auto)" : "", g_pc_hdr_active == 1 ? "HDR10 / PQ" : "scRGB", static_cast<int>(format),
+				r2hdr::paper(), r2hdr::peak(), r2hdr::peak_source(), r2hdr::sat());
+		else log("HDR: %sno HDR swapchain format on this display (is Windows HDR on?); SDR output");
+	}
+
+	void r2pc_extend_device(VkPhysicalDevice pdev, std::vector<const char*>& extensions,
+		VkPhysicalDeviceVulkan12Features& vulkan12, VkDeviceCreateInfo& info)
+	{
+		{
+			VkPhysicalDeviceProperties pp{};
+			vkGetPhysicalDeviceProperties(pdev, &pp);
+			g_vendor = pp.vendorID;
+		}
+		if (!hdr_request() && !reflex_request() && !antilag_request()) return;
+		u32 count = 0;
+		vkEnumerateDeviceExtensionProperties(pdev, nullptr, &count, nullptr);
+		std::vector<VkExtensionProperties> props(count);
+		vkEnumerateDeviceExtensionProperties(pdev, nullptr, &count, props.data());
+		auto supported = [&](const char* name)
+		{
+			for (const auto& p : props) if (std::strcmp(p.extensionName, name) == 0) return true;
+			return false;
+		};
+		auto push = [&](const char* name)
+		{
+			for (const char* e : extensions) if (std::strcmp(e, name) == 0) return;
+			extensions.push_back(name);
+		};
+		if (hdr_request() && supported(VK_EXT_HDR_METADATA_EXTENSION_NAME))
+		{
+			push(VK_EXT_HDR_METADATA_EXTENSION_NAME);
+			g_pc.hdr_metadata_ext = true;
+		}
+		if (reflex_request())
+		{
+			VkPhysicalDeviceVulkan12Features v12{ .sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_VULKAN_1_2_FEATURES };
+			VkPhysicalDeviceFeatures2 f2{ .sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_FEATURES_2, .pNext = &v12 };
+			vkGetPhysicalDeviceFeatures2(pdev, &f2);
+			if (supported(VK_NV_LOW_LATENCY_2_EXTENSION_NAME) && v12.timelineSemaphore)
+			{
+				push(VK_NV_LOW_LATENCY_2_EXTENSION_NAME);
+				if (supported(VK_KHR_PRESENT_ID_EXTENSION_NAME)) push(VK_KHR_PRESENT_ID_EXTENSION_NAME); // listed dependency of low_latency2
+				vulkan12.timelineSemaphore = VK_TRUE;
+				g_pc.low_latency_ext = true;
+				log("Reflex: VK_NV_low_latency2 enabled%s", reflex_request() == 2 ? " (boost)" : "");
+			}
+			else log("Reflex: %sVK_NV_low_latency2 not available (NVIDIA driver 535+ needed); off");
+		}
+		else if (antilag_request())
+		{
+			VkPhysicalDeviceAntiLagFeaturesAMD al{ .sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_ANTI_LAG_FEATURES_AMD };
+			VkPhysicalDeviceFeatures2 f2{ .sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_FEATURES_2, .pNext = &al };
+			if (supported(VK_AMD_ANTI_LAG_EXTENSION_NAME)) vkGetPhysicalDeviceFeatures2(pdev, &f2);
+			if (al.antiLag)
+			{
+				push(VK_AMD_ANTI_LAG_EXTENSION_NAME);
+				static VkPhysicalDeviceAntiLagFeaturesAMD en{ .sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_ANTI_LAG_FEATURES_AMD };
+				en.antiLag = VK_TRUE;
+				en.pNext = const_cast<void*>(info.pNext);
+				info.pNext = &en;
+				g_pc.anti_lag_ext = true;
+				log("Anti-Lag 2: %sVK_AMD_anti_lag enabled");
+			}
+			else log("Anti-Lag 2: %sVK_AMD_anti_lag not available (Radeon RX 5000 or newer with a recent AMD driver needed); off");
+		}
+		info.enabledExtensionCount = static_cast<u32>(extensions.size());
+		info.ppEnabledExtensionNames = extensions.data();
+	}
+
+	void r2pc_swapchain_pre_create(VkSwapchainCreateInfoKHR& info)
+	{
+		if (!g_pc.low_latency_ext) return;
+		static VkSwapchainLatencyCreateInfoNV lci{ .sType = VK_STRUCTURE_TYPE_SWAPCHAIN_LATENCY_CREATE_INFO_NV };
+		lci.pNext = info.pNext;
+		lci.latencyModeEnable = VK_TRUE;
+		info.pNext = &lci;
+	}
+
+	void r2pc_swapchain_created(VkDevice dev, VkSwapchainKHR swapchain)
+	{
+		std::lock_guard lk(g_pc.mu);
+		if (!swapchain)
+		{
+			if (g_pc.timeline && g_pc.dev) vkDestroySemaphore(g_pc.dev, g_pc.timeline, nullptr);
+			g_pc.timeline = VK_NULL_HANDLE;
+			g_pc.swapchain = VK_NULL_HANDLE;
+			g_pc_reflex_active = 0;
+			s_lat_kind = 0;
+			return;
+		}
+		g_pc.dev = dev;
+		g_pc.swapchain = swapchain;
+
+		if (g_pc.anti_lag_ext)
+		{
+			if (!g_pc.anti_lag) g_pc.anti_lag = reinterpret_cast<PFN_vkAntiLagUpdateAMD>(vkGetDeviceProcAddr(dev, "vkAntiLagUpdateAMD"));
+			g_pc_antilag_active = g_pc.anti_lag ? 1 : 0;
+			s_lat_kind = g_pc.anti_lag ? 2 : 0;
+			static bool logged = false;
+			if (!logged) { logged = true; log(g_pc.anti_lag ? "Anti-Lag 2: %son (INPUT stage at the game's frame start, PRESENT stage before present)"
+			                                                : "Anti-Lag 2: %svkAntiLagUpdateAMD missing; off"); }
+		}
+
+		if (g_pc_hdr_active && g_pc.hdr_metadata_ext)
+		{
+			if (!g_pc.set_hdr) g_pc.set_hdr = reinterpret_cast<PFN_vkSetHdrMetadataEXT>(vkGetDeviceProcAddr(dev, "vkSetHdrMetadataEXT"));
+			if (g_pc.set_hdr)
+			{
+				const float peak = r2hdr::peak(), paper = r2hdr::paper();
+				VkHdrMetadataEXT md{ .sType = VK_STRUCTURE_TYPE_HDR_METADATA_EXT };
+				// Rec.2020 primaries for HDR10, Rec.709 for scRGB; D65 white
+				if (g_pc_hdr_active == 1) { md.displayPrimaryRed = { 0.708f, 0.292f }; md.displayPrimaryGreen = { 0.170f, 0.797f }; md.displayPrimaryBlue = { 0.131f, 0.046f }; }
+				else { md.displayPrimaryRed = { 0.640f, 0.330f }; md.displayPrimaryGreen = { 0.300f, 0.600f }; md.displayPrimaryBlue = { 0.150f, 0.060f }; }
+				md.whitePoint = { 0.3127f, 0.3290f };
+				md.maxLuminance = peak;
+				md.minLuminance = 0.001f;
+				md.maxContentLightLevel = peak;
+				md.maxFrameAverageLightLevel = paper;
+				if (!vk::r2fg_set_hdr_metadata(dev, swapchain, &md)) g_pc.set_hdr(dev, 1, &swapchain, &md); // R2PORT FSR 3 swapchain
+			}
+		}
+
+		if (g_pc.low_latency_ext)
+		{
+			if (!g_pc.sleep)
+			{
+				g_pc.set_sleep_mode = reinterpret_cast<PFN_vkSetLatencySleepModeNV>(vkGetDeviceProcAddr(dev, "vkSetLatencySleepModeNV"));
+				g_pc.sleep = reinterpret_cast<PFN_vkLatencySleepNV>(vkGetDeviceProcAddr(dev, "vkLatencySleepNV"));
+				g_pc.wait = reinterpret_cast<PFN_vkWaitSemaphores>(vkGetDeviceProcAddr(dev, "vkWaitSemaphores"));
+				g_pc.set_marker = reinterpret_cast<PFN_vkSetLatencyMarkerNV>(vkGetDeviceProcAddr(dev, "vkSetLatencyMarkerNV"));
+			}
+			if (!g_pc.timeline)
+			{
+				VkSemaphoreTypeCreateInfo ti{ .sType = VK_STRUCTURE_TYPE_SEMAPHORE_TYPE_CREATE_INFO, .semaphoreType = VK_SEMAPHORE_TYPE_TIMELINE, .initialValue = 0 };
+				VkSemaphoreCreateInfo ci{ .sType = VK_STRUCTURE_TYPE_SEMAPHORE_CREATE_INFO, .pNext = &ti };
+				if (vkCreateSemaphore(dev, &ci, nullptr, &g_pc.timeline) != VK_SUCCESS) g_pc.timeline = VK_NULL_HANDLE;
+				g_pc.value = 0;
+			}
+			VkLatencySleepModeInfoNV mode{ .sType = VK_STRUCTURE_TYPE_LATENCY_SLEEP_MODE_INFO_NV };
+			mode.lowLatencyMode = VK_TRUE;
+			mode.lowLatencyBoost = reflex_request() == 2 ? VK_TRUE : VK_FALSE;
+			mode.minimumIntervalUs = 0; // not a limiter: the game's frame limiter stays in charge
+			const bool ok = g_pc.set_sleep_mode && g_pc.sleep && g_pc.wait && g_pc.timeline &&
+				g_pc.set_sleep_mode(dev, swapchain, &mode) == VK_SUCCESS;
+			g_pc_reflex_active = ok ? 1 : 0;
+			if (!ok) log("Reflex: %scould not set the latency sleep mode; off");
+			s_lat_kind = ok && g_pc.set_marker && markers_wanted() ? 1 : 0;
+			static bool logged = false;
+			if (ok && !logged) { logged = true; log(s_lat_kind ? "Reflex: %slatency markers on (simulation, input, render submit, present)"
+			                                                   : "Reflex: %slatency markers off (sleep only)"); }
+		}
+		if (s_lat_kind && g_pad_input_hook != lat_pad_input) g_pad_input_hook = lat_pad_input;
+	}
