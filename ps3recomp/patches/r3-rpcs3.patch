+namespace vk
+{
+	// The upscaler's depth (R32F) and motion vectors (RG16F) -> frame generation's own copies (valid until present)
+	struct r2fg_copy_pass : compute_task
+	{
+		const vk::image_view* in_depth = nullptr;
+		const vk::image_view* in_mv = nullptr;
+		const vk::image_view* out_depth = nullptr;
+		const vk::image_view* out_mv = nullptr;
+		std::unique_ptr<vk::sampler> m_sampler;
+
+		r2fg_copy_pass()
+		{
+			m_src =
+				"#version 450\n"
+				"layout(local_size_x = 8, local_size_y = 8) in;\n"
+				"layout(set=0, binding=0) uniform sampler2D DepthIn;\n"
+				"layout(set=0, binding=1) uniform sampler2D MvIn;\n"
+				"layout(set=0, binding=2, r32f) uniform writeonly image2D DepthOut;\n"
+				"layout(set=0, binding=3, rg16f) uniform writeonly image2D MvOut;\n"
+				"layout(push_constant) uniform PC { vec4 a; vec4 b; };\n" // a.xy: size
+				"void main()\n"
+				"{\n"
+				"	ivec2 p = ivec2(gl_GlobalInvocationID.xy);\n"
+				"	if (p.x >= int(a.x) || p.y >= int(a.y)) return;\n"
+				"	imageStore(DepthOut, p, vec4(texelFetch(DepthIn, p, 0).r, 0.0, 0.0, 0.0));\n"
+				"	imageStore(MvOut, p, vec4(texelFetch(MvIn, p, 0).rg, 0.0, 0.0));\n"
+				"}\n";
+			ssbo_count = 0;
+			use_push_constants = true;
+			push_constants_size = 32;
+			create();
+		}
+
+		std::vector<glsl::program_input> get_inputs() override
+		{
+			auto r = compute_task::get_inputs();
+			r.push_back(glsl::program_input::make(::glsl::program_domain::glsl_compute_program, "DepthIn", vk::glsl::input_type_texture, 0, 0));
+			r.push_back(glsl::program_input::make(::glsl::program_domain::glsl_compute_program, "MvIn", vk::glsl::input_type_texture, 0, 1));
+			r.push_back(glsl::program_input::make(::glsl::program_domain::glsl_compute_program, "DepthOut", vk::glsl::input_type_storage_texture, 0, 2));
+			r.push_back(glsl::program_input::make(::glsl::program_domain::glsl_compute_program, "MvOut", vk::glsl::input_type_storage_texture, 0, 3));
+			return r;
+		}
+
+		void bind_resources(const vk::command_buffer&) override
+		{
+			if (!m_sampler)
+			{
+				m_sampler = std::make_unique<vk::sampler>(*vk::get_current_renderer(),
+					VK_SAMPLER_ADDRESS_MODE_CLAMP_TO_EDGE, VK_SAMPLER_ADDRESS_MODE_CLAMP_TO_EDGE, VK_SAMPLER_ADDRESS_MODE_CLAMP_TO_EDGE,
+					VK_FALSE, 0.f, 1.f, 0.f, 0.f, VK_FILTER_NEAREST, VK_FILTER_NEAREST, VK_SAMPLER_MIPMAP_MODE_NEAREST, VK_BORDER_COLOR_FLOAT_OPAQUE_WHITE);
+			}
+			m_program->bind_uniform({ *in_depth, *m_sampler }, 0, 0);
+			m_program->bind_uniform({ *in_mv, *m_sampler }, 0, 1);
+			m_program->bind_uniform({ *out_depth }, 0, 2);
+			m_program->bind_uniform({ *out_mv }, 0, 3);
+		}
+
+		void run(const vk::command_buffer& cmd, u32 w, u32 h)
+		{
+			if (!m_program) load_program(cmd);
+			const float k[8] = { static_cast<float>(w), static_cast<float>(h), 0.f, 0.f, 0.f, 0.f, 0.f, 0.f };
+			vkCmdPushConstants(cmd, m_program->layout(), VK_SHADER_STAGE_COMPUTE_BIT, 0, push_constants_size, k);
+			compute_task::run(cmd, (w + 7) / 8, (h + 7) / 8, 1);
+		}
+	};
+
+	// Shared GLSL of the HUD passes. Inputs: HudIn = the display buffer snapshotted right before the first HUD
+	// draw, FlipIn = the same buffer at flip (scene + HUD), B0 = the swapchain image before the port overlays,
+	// B1 = after them. a: game rectangle on the swapchain (x, y, w, h); b: uv scale of the used buffer region
+	// (x, y), swapchain size (z, w); c: HUD threshold, overlay threshold, HUD pixel limit, flags
+	// (1 = split the HUD this frame, 2 = HDR10 output, 4 = debug view).
+	const char* r2fg_hud_common =
+		"layout(set=0, binding=0) uniform sampler2D HudIn;\n"
+		"layout(set=0, binding=1) uniform sampler2D FlipIn;\n"
+		"layout(set=0, binding=2) uniform sampler2D B0;\n"
+		"layout(set=0, binding=3) uniform sampler2D B1;\n"
+		"layout(set=0, binding=4, r32ui) uniform uimage2D Count;\n"
+		"layout(push_constant) uniform PC { vec4 a; vec4 b; vec4 c; };\n"
+		"float maxdiff(vec3 x, vec3 y) { vec3 d = abs(x - y); return max(d.x, max(d.y, d.z)); }\n"
+		"bool game_uv(ivec2 p, out vec2 uv)\n"
+		"{\n"
+		"	vec2 q = (vec2(p) + 0.5 - a.xy) / a.zw;\n"
+		"	uv = q * b.xy;\n"
+		"	return all(greaterThanEqual(q, vec2(0.0))) && all(lessThan(q, vec2(1.0)));\n"
+		"}\n"
+		"bool hud_at(ivec2 p)\n"
+		"{\n"
+		"	vec2 uv;\n"
+		"	if (!game_uv(p, uv)) return false;\n"
+		"	return maxdiff(textureLod(HudIn, uv, 0.0).rgb, textureLod(FlipIn, uv, 0.0).rgb) > c.x;\n"
+		"}\n"
+		"bool overlay_at(ivec2 p) { return maxdiff(texelFetch(B0, p, 0).rgb, texelFetch(B1, p, 0).rgb) > c.y; }\n";
+
+	struct r2fg_hud_pass_base : compute_task
+	{
+		const vk::image_view* in[4] = {};
+		const vk::image_view* count = nullptr;
+		std::unique_ptr<vk::sampler> m_sampler;
+
+		void init(const std::string& body)
+		{
+			m_src = std::string("#version 450\nlayout(local_size_x = 8, local_size_y = 8) in;\n") + r2fg_hud_common + body;
+			ssbo_count = 0;
+			use_push_constants = true;
+			push_constants_size = 48;
+			create();
+		}
+
+		std::vector<glsl::program_input> get_inputs() override
+		{
+			auto r = compute_task::get_inputs();
+			const char* names[4] = { "HudIn", "FlipIn", "B0", "B1" };
+			for (u32 i = 0; i < 4; ++i)
+				r.push_back(glsl::program_input::make(::glsl::program_domain::glsl_compute_program, names[i], vk::glsl::input_type_texture, 0, i));
+			r.push_back(glsl::program_input::make(::glsl::program_domain::glsl_compute_program, "Count", vk::glsl::input_type_storage_texture, 0, 4));
+			return r;
+		}
+
+		void bind_resources(const vk::command_buffer&) override
+		{
+			if (!m_sampler)
+			{
+				m_sampler = std::make_unique<vk::sampler>(*vk::get_current_renderer(),
+					VK_SAMPLER_ADDRESS_MODE_CLAMP_TO_EDGE, VK_SAMPLER_ADDRESS_MODE_CLAMP_TO_EDGE, VK_SAMPLER_ADDRESS_MODE_CLAMP_TO_EDGE,
+					VK_FALSE, 0.f, 1.f, 0.f, 0.f, VK_FILTER_LINEAR, VK_FILTER_LINEAR, VK_SAMPLER_MIPMAP_MODE_NEAREST, VK_BORDER_COLOR_FLOAT_OPAQUE_BLACK);
+			}
+			for (u32 i = 0; i < 4; ++i) m_program->bind_uniform({ *in[i], *m_sampler }, 0, i);
+			m_program->bind_uniform({ *count }, 0, 4);
+		}
+
+		void run(const vk::command_buffer& cmd, const float* k, u32 w, u32 h)
+		{
+			if (!m_program) load_program(cmd);
+			vkCmdPushConstants(cmd, m_program->layout(), VK_SHADER_STAGE_COMPUTE_BIT, 0, push_constants_size, k);
+			compute_task::run(cmd, (w + 7) / 8, (h + 7) / 8, 1);
+		}
+	};
+
+	// Counts the HUD pixels (one atomic per work group): a frame whose "HUD" covers too much of the screen is a
+	// misclassification (a full-screen fade, a blended post effect) and is not split.
+	struct r2fg_mask_pass : r2fg_hud_pass_base
+	{
+		r2fg_mask_pass()
+		{
+			init(
+				"shared uint s_n;\n"
+				"void main()\n"
+				"{\n"
+				"	if (gl_LocalInvocationIndex == 0u) s_n = 0u;\n"
+				"	barrier();\n"
+				"	ivec2 p = ivec2(gl_GlobalInvocationID.xy);\n"
+				"	if (p.x < int(b.z) && p.y < int(b.w) && hud_at(p)) atomicAdd(s_n, 1u);\n"
+				"	barrier();\n"
+				"	if (gl_LocalInvocationIndex == 0u && s_n != 0u) imageAtomicAdd(Count, ivec2(0, 0), s_n);\n"
+				"}\n");
+		}
+	};
+
+	// Writes the HUD-less colour and the UI colour + alpha (both swapchain-sized)
+	template <bool HDR10>
+	struct r2fg_compose_pass : r2fg_hud_pass_base
+	{
+		const vk::image_view* out_hudless = nullptr;
+		const vk::image_view* out_ui = nullptr;
+
+		r2fg_compose_pass()
+		{
+			const std::string fmt = HDR10 ? "rgb10_a2" : "rgba8";
+			init(
+				"layout(set=0, binding=5, " + fmt + ") uniform writeonly image2D HudlessOut;\n"
+				"layout(set=0, binding=6, " + fmt + ") uniform writeonly image2D UiOut;\n"
+				"void main()\n"
+				"{\n"
+				"	ivec2 p = ivec2(gl_GlobalInvocationID.xy);\n"
+				"	ivec2 sz = ivec2(b.zw);\n"
+				"	if (p.x >= sz.x || p.y >= sz.y) return;\n"
+				"	uint flags = uint(c.w + 0.5);\n"
+				"	bool split = (flags & 1u) != 0u && float(imageLoad(Count, ivec2(0, 0)).r) < c.z;\n"
+				"	bool hud = false, ovl = false, hud_c = false;\n"
+				"	for (int dy = -1; dy <= 1; ++dy)\n"
+				"	for (int dx = -1; dx <= 1; ++dx)\n"
+				"	{\n"
+				"		ivec2 s = clamp(p + ivec2(dx, dy), ivec2(0), sz - 1);\n"
+				"		if (split && hud_at(s)) { hud = true; if (dx == 0 && dy == 0) hud_c = true; }\n"
+				"		if (overlay_at(s)) ovl = true;\n"
+				"	}\n"
+				"	vec4 b0 = texelFetch(B0, p, 0);\n"
+				"	vec4 b1 = texelFetch(B1, p, 0);\n"
+				"	vec3 hl = b0.rgb;\n"
+				"	vec2 uv;\n"
+				// SDR: take the HUD's own contribution back out of the presented scene. HDR10 (PQ) is not additive:
+				// the scene under the HUD keeps the HUD there, the opaque UI layer covers it on every frame.
+				"	if (hud_c && (flags & 2u) == 0u && game_uv(p, uv))\n"
+				"		hl = clamp(b0.rgb + textureLod(HudIn, uv, 0.0).rgb - textureLod(FlipIn, uv, 0.0).rgb, 0.0, 1.0);\n"
+				"	vec4 ui = (hud || ovl) ? vec4(b1.rgb, 1.0) : vec4(0.0);\n"
+				"	if ((flags & 4u) != 0u)\n"
+				"	{\n"
+				"		vec3 d = b1.rgb;\n"
+				"		if (hud) d = mix(d, vec3(1.0, 0.0, 1.0), 0.5);\n"
+				"		else if (ovl) d = mix(d, vec3(0.0, 1.0, 1.0), 0.5);\n"
+				"		hl = d;\n"
+				"	}\n"
+				"	imageStore(HudlessOut, p, vec4(hl, 1.0));\n"
+				"	imageStore(UiOut, p, ui);\n"
+				"}\n");
+		}
+
+		std::vector<glsl::program_input> get_inputs() override
+		{
+			auto r = r2fg_hud_pass_base::get_inputs();
+			r.push_back(glsl::program_input::make(::glsl::program_domain::glsl_compute_program, "HudlessOut", vk::glsl::input_type_storage_texture, 0, 5));
+			r.push_back(glsl::program_input::make(::glsl::program_domain::glsl_compute_program, "UiOut", vk::glsl::input_type_storage_texture, 0, 6));
+			return r;
+		}
+
+		void bind_resources(const vk::command_buffer& cmd) override
+		{
+			r2fg_hud_pass_base::bind_resources(cmd);
+			m_program->bind_uniform({ *out_hudless }, 0, 5);
+			m_program->bind_uniform({ *out_ui }, 0, 6);
+		}
+	};
+}
+
+namespace
+{
+	using image_ptr = std::unique_ptr<vk::viewable_image>;
+
+	struct fg_frame
+	{
+		// swapchain (create wrapper)
+		VkFormat sc_format = VK_FORMAT_UNDEFINED;
+		VkExtent2D sc_extent{};
+		u32 sc_images = 0;
+		double refresh_hz = 60.0;
+		bool sc_transfer = false;  // swapchain images can be copied from
+		bool sc_immediate = false; // FIFO was swapped for IMMEDIATE (DLSS-G without vsync support)
+		bool sc_new = true;
+
+		// scene inputs (VKR2Upscaler hook)
+		bool scene = false;
+		u32 rw = 0, rh = 0;
+		float jx = 0.f, jy = 0.f, mvsx = 1.f, mvsy = 1.f, zA = 1.f, zB = 0.f;
+		bool inverted = false, reset = false;
+		double T[16] = {};
+		image_ptr depth, mv;
+		u32 streak = 0;            // consecutive frames with a tagged scene
+
+		// HUD classifier (r2fg_on_draw)
+		bool hud_started = false;
+		bool unsure = false;
+		u32 hud_addr = 0, hud_draws = 0;
+		const void* hud_rt = nullptr;
+		image_ptr hud;
+
+		// present phases
+		image_ptr b0, b1, hudless, ui, count;
+		VkFormat out_fmt = VK_FORMAT_UNDEFINED;
+		bool have_b0 = false, have_ui = false, split = false;
+		s32 rx = 0, ry = 0, rwid = 0, rhei = 0; // game rectangle on the swapchain
+		bool ready = false;                    // phase 1 decided this frame
+		bool want_on = false;
+		u32 mult = 2;
+		bool debug_view = false;
+
+		// state across frames
+		bool prev_on = false;
+		u32 bad_status_frames = 0;
+		std::string reason;
+		unsigned long long reason_ms = 0;
+		int opt_key[16] = {};
+		bool opt_valid = false;
+		u32 reflex_limit = ~0u;
+		u32 hud_frames = 0, frames_on = 0;
+
+		// Reflex / PCL frame ids
+		std::mutex mu;
+		u32 sim_id = 0, present_id = 0, cur_rid = 0;
+		bool sim_open = false, render_open = false;
+
+		// menu detection: last camera change (tag_scene) / last mouse or right-stick input
+		unsigned long long cam_ms = 0, input_ms = 0;
+		unsigned long long last_mouse = 0;
+	};
+	fg_frame g_fg;
+
+	bool fg_usable() { return (sl_device() && g_sl.fg_supported) || fx_usable(); }
+	// the HUD/present passes run for frame generation, or for the debug view on its own
+	bool hud_path() { return fg_usable() || fgcfg().hud_debug; }
+
+	image_ptr fg_make_image(VkFormat fmt, u32 w, u32 h, VkImageUsageFlags usage)
+	{
+		const auto pdev = vk::get_current_renderer();
+		return std::make_unique<vk::viewable_image>(*pdev, pdev->get_memory_mapping().device_local, VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT,
+			VK_IMAGE_TYPE_2D, fmt, w, h, 1, 1, 1, VK_SAMPLE_COUNT_1_BIT, VK_IMAGE_LAYOUT_UNDEFINED, VK_IMAGE_TILING_OPTIMAL,
+			usage, vk::VK_IMAGE_CREATE_ALLOW_NULL_RPCS3, VMM_ALLOCATION_POOL_SWAPCHAIN, RSX_FORMAT_CLASS_COLOR);
+	}
+
+	// (re)creates 'img' unless it already has this format and size; the old one is freed once the GPU is done
+	void fg_ensure(image_ptr& img, VkFormat fmt, u32 w, u32 h, VkImageUsageFlags usage)
+	{
+		if (img && img->info.format == fmt && img->width() == w && img->height() == h) return;
+		if (img) vk::get_resource_manager()->dispose(img);
+		img = fg_make_image(fmt, w, h, usage);
+	}
+
+	vk::image_view* fg_view(vk::image* img)
+	{
+		return static_cast<vk::viewable_image*>(img)->get_view(rsx::default_remap_vector.with_encoding(vk::VK_REMAP_IDENTITY), VK_IMAGE_ASPECT_COLOR_BIT);
+	}
+
+	void fg_release_images()
+	{
+		auto& f = g_fg;
+		f.depth.reset(); f.mv.reset(); f.hud.reset();
+		f.b0.reset(); f.b1.reset(); f.hudless.reset(); f.ui.reset(); f.count.reset();
+		f.scene = f.hud_started = f.have_b0 = f.ready = false;
+	}
+
+	bool storage_ok(VkFormat fmt)
+	{
+		VkFormatProperties p{};
+		vkGetPhysicalDeviceFormatProperties(vk::get_current_renderer()->gpu(), fmt, &p);
+		return (p.optimalTilingFeatures & VK_FORMAT_FEATURE_STORAGE_IMAGE_BIT) != 0;
+	}
+
+	const VkImageSubresourceRange k_color_range{ VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0, 1 };
+
+	// swapchain image (in 'layout') -> dst (same format and size), both left as they were
+	void copy_from_target(vk::command_buffer& cmd, VkImage target, VkImageLayout layout, vk::viewable_image* dst)
+	{
+		vk::change_image_layout(cmd, target, layout, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, k_color_range);
+		dst->change_layout(cmd, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL);
+		VkImageCopy region{};
+		region.srcSubresource = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1 };
+		region.dstSubresource = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1 };
+		region.extent = { dst->width(), dst->height(), 1 };
+		vkCmdCopyImage(cmd, target, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, dst->value, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, 1, &region);
+		vk::change_image_layout(cmd, target, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, layout, k_color_range);
+		dst->change_layout(cmd, VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL);
+	}
+
+	unsigned long long now_ms() { return GetTickCount64(); }
+
+	// One line per change of the reason frame generation is not running (empty = running)
+	void set_reason(const std::string& why)
+	{
+		auto& f = g_fg;
+		if (why == f.reason) return;
+		const unsigned long long t = now_ms();
+		f.reason = why;
+		if (t - f.reason_ms < 500 && !fgcfg().debug) return;
+		f.reason_ms = t;
+		if (why.empty()) fglog("frame generation %ux on", f.mult);
+		else fglog("frame generation paused: %s", why.c_str());
+	}
+}
+
+namespace vk
+{
+	void r2fg_tag_scene(vk::command_buffer& cmd, vk::viewable_image* depth, vk::viewable_image* mv, u32 rw, u32 rh,
+		float jx, float jy, float mv_w, float mv_h, bool inverted, bool reset, const double* T, float zA, float zB)
+	{
+		if (!hud_path() || !depth || !mv || rw < 64 || rh < 64) return;
+		auto& f = g_fg;
+		if (vk::is_renderpass_open(cmd)) vk::end_renderpass(cmd);
+		const VkImageUsageFlags usage = VK_IMAGE_USAGE_STORAGE_BIT | VK_IMAGE_USAGE_SAMPLED_BIT;
+		fg_ensure(f.depth, VK_FORMAT_R32_SFLOAT, rw, rh, usage);
+		fg_ensure(f.mv, VK_FORMAT_R16G16_SFLOAT, rw, rh, usage);
+		f.depth->change_layout(cmd, VK_IMAGE_LAYOUT_GENERAL);
+		f.mv->change_layout(cmd, VK_IMAGE_LAYOUT_GENERAL);
+		auto pass = vk::get_compute_task<vk::r2fg_copy_pass>();
+		pass->in_depth = fg_view(depth);
+		pass->in_mv = fg_view(mv);
+		pass->out_depth = fg_view(f.depth.get());
+		pass->out_mv = fg_view(f.mv.get());
+		pass->run(cmd, rw, rh);
+		f.depth->change_layout(cmd, VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL);
+		f.mv->change_layout(cmd, VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL);
+
+		f.rw = rw; f.rh = rh;
+		f.jx = jx; f.jy = jy;
+		f.mvsx = mv_w / static_cast<float>(rw);
+		f.mvsy = mv_h / static_cast<float>(rh);
+		f.inverted = inverted;
+		f.reset = f.reset || reset;
+		double moved = 0.0;
+		for (int i = 0; i < 16; ++i) moved += std::fabs(T[i] - f.T[i]);
+		if (moved > 1e-4) f.cam_ms = now_ms();
+		std::memcpy(f.T, T, sizeof(f.T));
+		f.zA = zA; f.zB = zB;
+		f.scene = true;
+		// the HUD of this frame starts after the scene: classification restarts here
+		f.hud_started = false;
+		f.unsure = false;
+		f.hud_draws = 0;
+		f.hud_rt = nullptr;
+	}
+}
+
+// HUD classifier, called for every draw from load_program_env (before the draw's render pass begins).
+// Conservative: the HUD starts at the first blended, depth-test-off draw into a display buffer after the
+// scene was handed to DLSS; the buffer is snapshotted right before it. Any depth-tested draw into it after
+// that, or a late opaque draw, marks the frame unsure and it is not split.
+void VKGSRender::r2fg_on_draw()
+{
+	auto& f = g_fg;
+	if (sl_device() && g_sl.reflex && !f.render_open)
+	{
+		std::lock_guard lk(f.mu);
+		f.cur_rid = std::max(f.present_id + 1, f.sim_id);
+		sl::FrameToken* tok = nullptr;
+		if (g_sl.fn_token(tok, &f.cur_rid) == sl::Result::eOk && tok) g_sl.fn_marker(sl::PCLMarker::eRenderSubmitStart, *tok);
+		f.render_open = true;
+	}
+	if (!f.scene || f.unsure || !fgcfg().hud || !hud_path()) return;
+
+	auto& sc = res()->surface_cache;
+	const u32 addr = sc.m_bound_render_targets[0].first;
+	auto* rt = sc.m_bound_render_targets[0].second;
+	const bool depth = REGS(m_ctx)->depth_test_enabled() && sc.m_bound_depth_stencil.second;
+	const bool blend = REGS(m_ctx)->blend_enabled();
+
+	const auto snapshot = [&]
+	{
+		if (rt->samples() > 1 || !(rt->info.usage & VK_IMAGE_USAGE_TRANSFER_SRC_BIT))
+		{
+			f.unsure = true;
+			return;
+		}
+		auto& cmd = *m_current_command_buffer;
+		if (vk::is_renderpass_open(cmd)) vk::end_renderpass(cmd);
+		fg_ensure(f.hud, rt->info.format, rt->width(), rt->height(), VK_IMAGE_USAGE_TRANSFER_DST_BIT | VK_IMAGE_USAGE_SAMPLED_BIT);
+		rt->push_layout(cmd, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL);
+		f.hud->change_layout(cmd, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL);
+		VkImageCopy region{};
+		region.srcSubresource = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1 };
+		region.dstSubresource = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1 };
+		region.extent = { rt->width(), rt->height(), 1 };
+		vkCmdCopyImage(cmd, rt->value, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, f.hud->value, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, 1, &region);
+		rt->pop_layout(cmd);
+		f.hud->change_layout(cmd, VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL);
+		f.hud_rt = rt;
+	};
+
+	if (!f.hud_started)
+	{
+		if (!rt || !addr || depth || !blend || !r2gx_is_display(addr)) return;
+		f.hud_started = true;
+		f.hud_addr = addr;
+		f.hud_draws = 1;
+		snapshot();
+		return;
+	}
+	if (addr != f.hud_addr) return; // off-screen work (UI render-to-texture, next frame's shadows) is not the HUD
+	if (depth)
+	{
+		f.unsure = true;
+		return;
+	}
+	if (!blend && f.hud_draws < 2)
+	{
+		// an opaque pass right after a lone blended one: that was post-processing, start over. Later opaque
+		// depth-off draws (alpha-tested icons) count as HUD; a full-screen one trips the coverage limit.
+		f.hud_started = false;
+		return;
+	}
+	f.hud_draws++;
+}
+
+namespace
+{
+	bool is_srgb(VkFormat f)
+	{
+		return f == VK_FORMAT_B8G8R8A8_SRGB || f == VK_FORMAT_R8G8B8A8_SRGB || f == VK_FORMAT_A8B8G8R8_SRGB_PACK32;
+	}
+	bool is_10bit(VkFormat f)
+	{
+		return f == VK_FORMAT_A2B10G10R10_UNORM_PACK32 || f == VK_FORMAT_A2R10G10B10_UNORM_PACK32;
+	}
+
+	// Phase 1: should frame generation run for this frame, and why not
+	void fg_decide()
+	{
+		auto& f = g_fg;
+		f.want_on = false;
+		f.streak = f.scene ? f.streak + 1 : 0;
+		if (f.bad_status_frames) f.bad_status_frames--;
+		if (!fg_usable()) return;
+		f.mult = fx_usable() ? 2u : std::min<u32>(fgcfg().want, g_sl.max_mult);
+
+		// menu detection: no look input, play tick, camera movement or mouse / right-stick input for 1.5 s. The look tick alone
+		// goes stale in vehicles (the turret aims without it), so any of these keeps frame generation on.
+		const unsigned long long t = now_ms();
+		if (!g_port_pause_ui)
+		{
+			const unsigned long long mouse = g_kbm_mouse_abs;
+			const int rx = g_ml_fed_rx, ry = g_ml_fed_ry;
+			if (mouse != f.last_mouse || std::abs(rx) > 16 || std::abs(ry) > 16) f.input_ms = t;
+			f.last_mouse = mouse;
+		}
+		const unsigned long long look_ms = g_r2_look_ms, play_ms = g_port_play_ms;
+		const unsigned long long look = std::max(std::max(look_ms, play_ms), std::max(f.cam_ms, f.input_ms));
+		std::string why;
+		if (!f.scene) why = "no 3D scene this frame (menu, movie or loading screen)";
+		else if (g_r2pc_paused) why = "game paused";
+		else if (port_local_players() > 1) why = "split-screen co-op";
+		else if (g_pc_hdr_active == 2) why = "scRGB HDR output is not supported (use HDR10)";
+		else if (is_srgb(f.sc_format)) why = "sRGB swapchain format";
+#ifdef R2PORT_HAVE_FFX
+		else if (fx_usable() && !g_fx.sc_ok) why = g_fx.sc_why.empty() ? std::string("FSR 3 swapchain unavailable") : g_fx.sc_why;
+#endif
+		else if (fgcfg().menu_off && (g_port_pause_ui || (look && t - look > 1500))) why = "in a menu (R2_DLSS_FG_MENU_OFF=0 keeps it on)";
+		else if (f.bad_status_frames) why = f.reason.empty() ? std::string("DLSS-G reported a problem") : f.reason;
+		else if (f.streak < 3) return; // warm-up after a menu: silent
+		set_reason(why);
+		f.want_on = why.empty();
+	}
+}
+
+namespace vk
+{
+	static void r2fg_present_body(int phase, vk::command_buffer& cmd, VkImage target, VkImageLayout layout, vk::viewable_image* src,
+		u32 buffer_w, u32 buffer_h, s32 x1, s32 y1, s32 x2, s32 y2)
+	{
+		auto& f = g_fg;
+		if (!hud_path()) return;
+		if (phase == 0)
+		{
+			f.have_b0 = false;
+			const u32 W = f.sc_extent.width, H = f.sc_extent.height;
+			if (!f.scene || !src || !target || !f.sc_transfer || !W || !H || f.sc_format == VK_FORMAT_UNDEFINED) return;
+			if (vk::is_renderpass_open(cmd)) vk::end_renderpass(cmd);
+			fg_ensure(f.b0, f.sc_format, W, H, VK_IMAGE_USAGE_TRANSFER_DST_BIT | VK_IMAGE_USAGE_SAMPLED_BIT);
+			copy_from_target(cmd, target, layout, f.b0.get());
+			f.have_b0 = true;
+			return;
+		}
+
+		f.ready = true;
+		f.have_ui = false;
+		f.split = false;
+		fg_decide();
+		f.debug_view = fgcfg().hud_debug;
+		if (!(f.want_on || f.debug_view) || !f.have_b0 || !src || !target || x2 <= x1 || y2 <= y1 || !buffer_w || !buffer_h) return;
+
+		const u32 W = f.sc_extent.width, H = f.sc_extent.height;
+		const bool hdr10 = is_10bit(f.sc_format);
+		const VkFormat out_fmt = hdr10 ? VK_FORMAT_A2B10G10R10_UNORM_PACK32 : VK_FORMAT_R8G8B8A8_UNORM;
+		static int fmt_ok[2] = { -1, -1 };
+		int& ok = fmt_ok[hdr10 ? 1 : 0];
+		if (ok < 0)
+		{
+			ok = storage_ok(out_fmt) && storage_ok(VK_FORMAT_R32_UINT) ? 1 : 0;
+			if (!ok) fglog("HUD split unavailable: the GPU cannot write format %d from compute", static_cast<int>(out_fmt));
+		}
+		if (!ok) return;
+
+		if (vk::is_renderpass_open(cmd)) vk::end_renderpass(cmd);
+		fg_ensure(f.b1, f.sc_format, W, H, VK_IMAGE_USAGE_TRANSFER_DST_BIT | VK_IMAGE_USAGE_SAMPLED_BIT);
+		copy_from_target(cmd, target, layout, f.b1.get());
+
+		const VkImageUsageFlags out_usage = VK_IMAGE_USAGE_STORAGE_BIT | VK_IMAGE_USAGE_SAMPLED_BIT | VK_IMAGE_USAGE_TRANSFER_SRC_BIT;
+		fg_ensure(f.hudless, out_fmt, W, H, out_usage);
+		fg_ensure(f.ui, out_fmt, W, H, out_usage);
+		fg_ensure(f.count, VK_FORMAT_R32_UINT, 1, 1, VK_IMAGE_USAGE_STORAGE_BIT | VK_IMAGE_USAGE_TRANSFER_DST_BIT);
+		f.out_fmt = out_fmt;
+
+		const bool split = fgcfg().hud && f.hud && f.hud_rt == src && !f.unsure && f.hud_draws &&
+			f.hud->info.format == src->info.format && f.hud->width() == src->width() && f.hud->height() == src->height();
+
+		f.count->change_layout(cmd, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL);
+		const VkClearColorValue zero{};
+		vkCmdClearColorImage(cmd, f.count->value, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, &zero, 1, &k_color_range);
+		f.count->change_layout(cmd, VK_IMAGE_LAYOUT_GENERAL);
+		src->push_layout(cmd, VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL);
+
+		const float rect_w = static_cast<float>(x2 - x1), rect_h = static_cast<float>(y2 - y1);
+		const float k[12] = {
+			static_cast<float>(x1), static_cast<float>(y1), rect_w, rect_h,
+			static_cast<float>(std::min(buffer_w, src->width())) / static_cast<float>(src->width()),
+			static_cast<float>(std::min(buffer_h, src->height())) / static_cast<float>(src->height()),
+			static_cast<float>(W), static_cast<float>(H),
+			0.5f / 255.f, 0.25f / 1023.f, 0.3f * rect_w * rect_h,
+			static_cast<float>((split ? 1 : 0) | (hdr10 ? 2 : 0) | (f.debug_view ? 4 : 0)) };
+		const auto bind = [&](vk::r2fg_hud_pass_base* pass)
+		{
+			pass->in[0] = split ? fg_view(f.hud.get()) : fg_view(f.b0.get());
+			pass->in[1] = split ? fg_view(src) : fg_view(f.b0.get());
+			pass->in[2] = fg_view(f.b0.get());
+			pass->in[3] = fg_view(f.b1.get());
+			pass->count = fg_view(f.count.get());
+		};
+		if (split)
+		{
+			auto pass = vk::get_compute_task<vk::r2fg_mask_pass>();
+			bind(pass);
+			pass->run(cmd, k, W, H);
+			vk::insert_global_memory_barrier(cmd);
+		}
+		f.hudless->change_layout(cmd, VK_IMAGE_LAYOUT_GENERAL);
+		f.ui->change_layout(cmd, VK_IMAGE_LAYOUT_GENERAL);
+		const auto compose = [&](auto* pass)
+		{
+			bind(pass);
+			pass->out_hudless = fg_view(f.hudless.get());
+			pass->out_ui = fg_view(f.ui.get());
+			pass->run(cmd, k, W, H);
+		};
+		if (hdr10) compose(vk::get_compute_task<vk::r2fg_compose_pass<true>>());
+		else compose(vk::get_compute_task<vk::r2fg_compose_pass<false>>());
+		src->pop_layout(cmd);
+		f.ui->change_layout(cmd, VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL);
+
+		if (f.debug_view)
+		{
+			// the tinted frame replaces the swapchain image; nothing is tagged as UI
+			f.hudless->change_layout(cmd, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL);
+			vk::change_image_layout(cmd, target, layout, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, k_color_range);
+			VkImageBlit blit{};
+			blit.srcSubresource = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1 };
+			blit.dstSubresource = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1 };
+			blit.srcOffsets[1] = { static_cast<s32>(W), static_cast<s32>(H), 1 };
+			blit.dstOffsets[1] = { static_cast<s32>(W), static_cast<s32>(H), 1 };
+			vkCmdBlitImage(cmd, f.hudless->value, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, target, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, 1, &blit, VK_FILTER_NEAREST);
+			vk::change_image_layout(cmd, target, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, layout, k_color_range);
+		}
+		f.hudless->change_layout(cmd, VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL);
+		cmd.r2_invalidate_state_cache();
+
+		f.have_ui = !f.debug_view;
+		f.split = split;
+		f.rx = x1; f.ry = y1;
+		f.rwid = x2 - x1; f.rhei = y2 - y1;
+	}
+}
+
+namespace
+{
+	using mat4 = double[4][4];
+
+	void mat_mul(const mat4 a, const mat4 b, mat4 out)
+	{
+		mat4 r{};
+		for (int i = 0; i < 4; ++i)
+			for (int j = 0; j < 4; ++j)
+				for (int k = 0; k < 4; ++k) r[i][j] += a[i][k] * b[k][j];
+		std::memcpy(out, r, sizeof(r));
+	}
+
+	bool mat_inverse(const mat4 m, mat4 out)
+	{
+		double a[4][8];
+		for (int i = 0; i < 4; ++i)
+			for (int j = 0; j < 4; ++j)
+			{
+				a[i][j] = m[i][j];
+				a[i][j + 4] = i == j ? 1.0 : 0.0;
+			}
+		for (int c = 0; c < 4; ++c)
+		{
+			int p = c;
+			for (int r = c + 1; r < 4; ++r)
+				if (std::fabs(a[r][c]) > std::fabs(a[p][c])) p = r;
+			if (std::fabs(a[p][c]) < 1e-12) return false;
+			if (p != c)
+				for (int j = 0; j < 8; ++j) std::swap(a[p][j], a[c][j]);
+			const double d = a[c][c];
+			for (int j = 0; j < 8; ++j) a[c][j] /= d;
+			for (int r = 0; r < 4; ++r)
+			{
+				if (r == c || a[r][c] == 0.0) continue;
+				const double s = a[r][c];
+				for (int j = 0; j < 8; ++j) a[r][j] -= s * a[c][j];
+			}
+		}
+		for (int i = 0; i < 4; ++i)
+			for (int j = 0; j < 4; ++j) out[i][j] = a[i][j + 4];
+		return true;
+	}
+
+	// column-vector matrix -> Streamline's row-vector float4x4 (transposed)
+	void to_sl(const mat4 m, sl::float4x4& o)
+	{
+		for (int r = 0; r < 4; ++r)
+			o.row[r] = sl::float4(static_cast<float>(m[0][r]), static_cast<float>(m[1][r]), static_cast<float>(m[2][r]), static_cast<float>(m[3][r]));
+	}
+
+	// row-vector matrix copied as is
+	void to_sl_rows(const mat4 m, sl::float4x4& o)
+	{
+		for (int r = 0; r < 4; ++r)
+			o.row[r] = sl::float4(static_cast<float>(m[r][0]), static_cast<float>(m[r][1]), static_cast<float>(m[r][2]), static_cast<float>(m[r][3]));
+	}
+
+	void fill_constants(sl::Constants& c, bool reset)
+	{
+		const auto& f = g_fg;
+		// T maps this frame's (x, y, z_game, 1) clip position to last frame's; Z converts SL depth to z_game.
+		mat4 T, Z{}, Zi{}, F{}, A;
+		for (int i = 0; i < 16; ++i) T[i / 4][i % 4] = f.T[i];
+		const double zA = std::fabs(f.zA) > 1e-9 ? f.zA : 1.0;
+		for (int i = 0; i < 4; ++i) Z[i][i] = Zi[i][i] = F[i][i] = 1.0;
+		Z[2][2] = zA; Z[2][3] = f.zB;
+		Zi[2][2] = 1.0 / zA; Zi[2][3] = -f.zB / zA;
+		if (fgcfg().yflip) F[1][1] = -1.0;
+		mat_mul(Zi, T, A);
+		mat_mul(A, Z, A);
+		mat_mul(F, A, A);
+		mat_mul(A, F, A);
+		mat4 Ai;
+		if (!mat_inverse(A, Ai))
+		{
+			for (int i = 0; i < 4; ++i)
+				for (int j = 0; j < 4; ++j) A[i][j] = Ai[i][j] = i == j ? 1.0 : 0.0;
+			reset = true;
+		}
+		to_sl(A, c.clipToPrevClip);
+		to_sl(Ai, c.prevClipToClip);
+
+		// camera: DLSS-G only uses it for heuristics, the motion comes from clipToPrevClip and the vectors
+		float cn = 0.1f, cf = 1000.f, cv = 1.0f;
+		vk::r2aa_camera(cn, cf, cv);
+		const double n = cn, fa = cf, fov = cv, aspect = f.rh ? static_cast<double>(f.rw) / f.rh : 16.0 / 9.0;
+		const double ys = 1.0 / std::tan(fov * 0.5), xs = ys / aspect;
+		mat4 P{};
+		P[0][0] = xs;
+		P[1][1] = ys;
+		P[2][3] = 1.0;
+		if (f.inverted)
+		{
+			P[2][2] = -n / (fa - n);
+			P[3][2] = n * fa / (fa - n);
+		}
+		else
+		{
+			P[2][2] = fa / (fa - n);
+			P[3][2] = -n * fa / (fa - n);
+		}
+		mat4 Pi;
+		mat_inverse(P, Pi);
+		to_sl_rows(P, c.cameraViewToClip);
+		to_sl_rows(Pi, c.clipToCameraView);
+		mat4 I{};
+		for (int i = 0; i < 4; ++i) I[i][i] = 1.0;
+		to_sl_rows(I, c.clipToLensClip);
+
+		c.jitterOffset = sl::float2(f.jx, f.jy);
+		c.mvecScale = sl::float2(f.mvsx, f.mvsy);
+		c.cameraPinholeOffset = sl::float2(0.f, 0.f);
+		c.cameraPos = sl::float3(0.f, 0.f, 0.f);
+		c.cameraUp = sl::float3(0.f, 1.f, 0.f);
+		c.cameraRight = sl::float3(1.f, 0.f, 0.f);
+		c.cameraFwd = sl::float3(0.f, 0.f, 1.f);
+		c.cameraNear = static_cast<float>(n);
+		c.cameraFar = static_cast<float>(fa);
+		c.cameraFOV = static_cast<float>(fov);
+		c.cameraAspectRatio = static_cast<float>(aspect);
+		c.motionVectorsInvalidValue = 0.f;
+		c.depthInverted = f.inverted ? sl::Boolean::eTrue : sl::Boolean::eFalse;
+		c.cameraMotionIncluded = sl::Boolean::eTrue;
+		c.motionVectors3D = sl::Boolean::eFalse;
+		c.reset = reset ? sl::Boolean::eTrue : sl::Boolean::eFalse;
+		c.orthographicProjection = sl::Boolean::eFalse;
+		c.motionVectorsDilated = sl::Boolean::eFalse;
+		c.motionVectorsJittered = sl::Boolean::eFalse;
+		c.minRelativeLinearDepthObjectSeparation = 40.0f;
+	}
+
+	sl::Resource sl_res(vk::viewable_image* img)
+	{
+		sl::Resource r(sl::ResourceType::eTex2d, reinterpret_cast<void*>(img->value),
+			img->memory ? reinterpret_cast<void*>(img->memory->get_vk_device_memory()) : nullptr,
+			reinterpret_cast<void*>(fg_view(img)->value), static_cast<u32>(VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL));
+		r.width = img->width();
+		r.height = img->height();
+		r.nativeFormat = static_cast<u32>(img->info.format);
+		r.mipLevels = 1;
+		r.arrayLayers = 1;
+		r.usage = static_cast<u32>(img->info.usage);
+		r.flags = 0;
+		return r;
+	}
+
+	void sl_marker(sl::PCLMarker m, const sl::FrameToken* tok)
+	{
+		if (tok && g_sl.reflex && g_sl.fn_marker) g_sl.fn_marker(m, *tok);
+	}
+
+	double monitor_hz()
+	{
+		double hz = 60.0;
+		if (!g_sl.hwnd) return hz;
+		MONITORINFOEXW mi{};
+		mi.cbSize = sizeof(mi);
+		if (!GetMonitorInfoW(MonitorFromWindow(g_sl.hwnd, MONITOR_DEFAULTTONEAREST), &mi)) return hz;
+		DEVMODEW dm{};
+		dm.dmSize = sizeof(dm);
+		if (EnumDisplaySettingsW(mi.szDevice, ENUM_CURRENT_SETTINGS, &dm) && dm.dmDisplayFrequency > 1) hz = dm.dmDisplayFrequency;
+		return hz;
+	}
+
+	VkResult VKAPI_CALL fg_create_swapchain(VkDevice dev, const VkSwapchainCreateInfoKHR* info, const VkAllocationCallbacks* alloc, VkSwapchainKHR* sc)
+	{
+		auto& f = g_fg;
+		VkSwapchainCreateInfoKHR ci = *info;
+		VkSurfaceCapabilitiesKHR caps{};
+		if (vkGetPhysicalDeviceSurfaceCapabilitiesKHR(g_sl.pdev, ci.surface, &caps) == VK_SUCCESS && (caps.supportedUsageFlags & VK_IMAGE_USAGE_TRANSFER_SRC_BIT))
+			ci.imageUsage |= VK_IMAGE_USAGE_TRANSFER_SRC_BIT;
+
+		bool immediate = false;
+		if (g_sl.fg_supported && !g_sl.vsync_ok && (ci.presentMode == VK_PRESENT_MODE_FIFO_KHR || ci.presentMode == VK_PRESENT_MODE_FIFO_RELAXED_KHR))
+		{
+			// DLSS-G paces the generated frames itself; without driver vsync support it needs a non-blocking present mode
+			u32 n = 0;
+			vkGetPhysicalDeviceSurfacePresentModesKHR(g_sl.pdev, ci.surface, &n, nullptr);
+			std::vector<VkPresentModeKHR> modes(n);
+			if (n) vkGetPhysicalDeviceSurfacePresentModesKHR(g_sl.pdev, ci.surface, &n, modes.data());
+			if (std::find(modes.begin(), modes.end(), VK_PRESENT_MODE_IMMEDIATE_KHR) != modes.end())
+			{
+				ci.presentMode = VK_PRESENT_MODE_IMMEDIATE_KHR;
+				immediate = true;
+			}
+		}
+
+		VkResult r = g_sl.p_create_sc(dev, &ci, alloc, sc);
+		if (r != VK_SUCCESS)
+		{
+			ci = *info;
+			immediate = false;
+			r = g_sl.p_create_sc(dev, &ci, alloc, sc);
+		}
+		if (r != VK_SUCCESS) return r;
+
+		if (immediate && !f.sc_immediate)
+			fglog("frame generation: vsync replaced by the Reflex frame cap (driver lacks DLSS-G vsync support; use G-Sync to avoid tearing)");
+		f.sc_immediate = immediate;
+		f.sc_transfer = (ci.imageUsage & VK_IMAGE_USAGE_TRANSFER_SRC_BIT) != 0;
+		f.sc_format = ci.imageFormat;
+		f.sc_extent = ci.imageExtent;
+		u32 count = 0;
+		g_sl.p_sc_images(dev, *sc, &count, nullptr);
+		f.sc_images = count ? count : ci.minImageCount;
+		f.refresh_hz = monitor_hz();
+		f.sc_new = true;
+		if (!f.sc_transfer && fgcfg().want) fglog("frame generation: the swapchain cannot be copied from, HUD split off");
+		return r;
+	}
+
+	void VKAPI_CALL fg_destroy_swapchain(VkDevice dev, VkSwapchainKHR sc, const VkAllocationCallbacks* alloc)
+	{
+		g_fg.sc_new = true;
+		g_sl.p_destroy_sc(dev, sc, alloc);
+	}
+
+	void fg_set_options(bool on, u32 n)
+	{
+		auto& f = g_fg;
+		const bool ui = !f.debug_view;
+		const int key[16] = { on ? 1 : 0, static_cast<int>(n), static_cast<int>(f.sc_images), static_cast<int>(f.rw), static_cast<int>(f.rh),
+			static_cast<int>(f.sc_extent.width), static_cast<int>(f.sc_extent.height), static_cast<int>(f.sc_format),
+			static_cast<int>(f.out_fmt), ui ? 1 : 0 };
+		if (f.opt_valid && std::memcmp(key, f.opt_key, sizeof(key)) == 0) return;
+		if (!on && !f.opt_valid) return; // never turned on: nothing to switch off
+		std::memcpy(f.opt_key, key, sizeof(key));
+		f.opt_valid = true;
+
+		sl::DLSSGOptions o{};
+		o.mode = on ? sl::DLSSGMode::eOn : sl::DLSSGMode::eOff;
+		o.numFramesToGenerate = std::max<u32>(1, n - 1);
+		o.flags = sl::DLSSGFlags::eRetainResourcesWhenOff | sl::DLSSGFlags::eEnableFullscreenMenuDetection;
+		o.numBackBuffers = f.sc_images;
+		o.mvecDepthWidth = f.rw;
+		o.mvecDepthHeight = f.rh;
+		o.colorWidth = f.sc_extent.width;
+		o.colorHeight = f.sc_extent.height;
+		o.colorBufferFormat = static_cast<u32>(f.sc_format);
+		o.mvecBufferFormat = static_cast<u32>(VK_FORMAT_R16G16_SFLOAT);
+		o.depthBufferFormat = static_cast<u32>(VK_FORMAT_R32_SFLOAT);
+		o.hudLessBufferFormat = ui ? static_cast<u32>(f.out_fmt) : 0u;
+		o.uiBufferFormat = ui ? static_cast<u32>(f.out_fmt) : 0u;
+		o.enableUserInterfaceRecomposition = ui ? sl::Boolean::eTrue : sl::Boolean::eFalse;
+		const sl::Result r = g_sl.fn_g_options(sl::ViewportHandle(0u), o);
+		if (r != sl::Result::eOk) fglog("slDLSSGSetOptions failed (code %d)", static_cast<int>(r));
+	}
+
+	void fg_set_reflex_cap(bool on)
+	{
+		auto& f = g_fg;
+		// presented frames (generated ones included) must stay under the refresh rate (VRR range). With FG on,
+		// Streamline applies frameLimitUs to presented frames, so it already scales the rendered rate by 1/N.
+		// The game's own cap still applies on top.
+		u32 limit = 0;
+		if (fgcfg().cap && f.refresh_hz > 1.0 && (on || f.sc_immediate))
+			limit = static_cast<u32>(1e6 / (f.refresh_hz * 0.95));
+		if (limit == f.reflex_limit) return;
+		f.reflex_limit = limit;
+		sl::ReflexOptions ro{};
+		ro.mode = penv_int("REFLEX", 1) >= 2 ? sl::ReflexMode::eLowLatencyWithBoost : sl::ReflexMode::eLowLatency;
+		ro.frameLimitUs = limit;
+		g_sl.fn_r_options(ro);
+		if (fgcfg().debug) fglog("Reflex frame limit %u us", limit);
+	}
+
+	VkResult VKAPI_CALL fg_queue_present(VkQueue queue, const VkPresentInfoKHR* info)
+	{
+		auto& f = g_fg;
+		sl::FrameToken* tok = nullptr;
+		{
+			std::lock_guard lk(f.mu);
+			if (!f.render_open) f.cur_rid = std::max(f.present_id + 1, f.sim_id);
+			if (g_sl.fn_token(tok, &f.cur_rid) != sl::Result::eOk) tok = nullptr;
+			if (f.render_open) sl_marker(sl::PCLMarker::eRenderSubmitEnd, tok);
+			sl_marker(sl::PCLMarker::ePresentStart, tok);
+		}
+
+		bool on = false;
+		const u32 n = std::max<u32>(2, f.mult);
+		if (fg_usable())
+		{
+			on = tok && f.ready && f.want_on && f.depth && f.mv && (f.debug_view || (f.have_ui && f.hudless && f.ui));
+			fg_set_options(on, n);
+			fg_set_reflex_cap(on);
+			if (on)
+			{
+				const bool reset = !f.prev_on || f.sc_new || f.reset;
+				sl::Resource depth = sl_res(f.depth.get()), mv = sl_res(f.mv.get());
+				const sl::Extent scene_ext{ 0, 0, f.rw, f.rh };
+				const sl::Extent rect{ static_cast<u32>(std::max(0, f.rx)), static_cast<u32>(std::max(0, f.ry)),
+					static_cast<u32>(f.rwid), static_cast<u32>(f.rhei) };
+				const bool full = f.rx == 0 && f.ry == 0 && static_cast<u32>(f.rwid) == f.sc_extent.width && static_cast<u32>(f.rhei) == f.sc_extent.height;
+				std::vector<sl::ResourceTag> tags;
+				tags.emplace_back(&depth, sl::kBufferTypeDepth, sl::ResourceLifecycle::eValidUntilPresent, &scene_ext);
+				tags.emplace_back(&mv, sl::kBufferTypeMotionVectors, sl::ResourceLifecycle::eValidUntilPresent, &scene_ext);
+				sl::Resource hudless = f.hudless ? sl_res(f.hudless.get()) : sl::Resource(sl::ResourceType::eTex2d, nullptr);
+				sl::Resource ui = f.ui ? sl_res(f.ui.get()) : sl::Resource(sl::ResourceType::eTex2d, nullptr);
+				if (!f.debug_view)
+				{
+					tags.emplace_back(&hudless, sl::kBufferTypeHUDLessColor, sl::ResourceLifecycle::eValidUntilPresent, &rect);
+					tags.emplace_back(&ui, sl::kBufferTypeUIColorAndAlpha, sl::ResourceLifecycle::eValidUntilPresent, &rect);
+				}
+				if (!full) tags.emplace_back(nullptr, sl::kBufferTypeBackbuffer, sl::ResourceLifecycle::eValidUntilPresent, &rect);
+				sl::Result r = g_sl.fn_tag(*tok, sl::ViewportHandle(0u), tags.data(), static_cast<u32>(tags.size()), nullptr);
+				if (r == sl::Result::eOk)
+				{
+					sl::Constants c{};
+					fill_constants(c, reset);
+					r = g_sl.fn_consts(c, *tok, sl::ViewportHandle(0u));
+				}
+				if (r != sl::Result::eOk)
+				{
+					fglog("frame generation: Streamline rejected this frame's inputs (code %d)", static_cast<int>(r));
+					f.bad_status_frames = 120;
+				}
+				if (f.split) f.hud_frames++;
+				f.frames_on++;
+			}
+		}
+
+		const VkResult res = g_sl.p_present(queue, info);
+
+		if (on)
+		{
+			sl::DLSSGState st{};
+			if (g_sl.fn_g_state(sl::ViewportHandle(0u), st, nullptr) == sl::Result::eOk && st.status != sl::DLSSGStatus::eOk)
+			{
+				if (!f.bad_status_frames)
+				{
+					const u32 s = static_cast<u32>(st.status);
+					f.reason.clear();
+					set_reason(std::string("DLSS-G status 0x") + [&] { char b[16]; std::snprintf(b, sizeof(b), "%x", s); return std::string(b); }() +
+						((s & static_cast<u32>(sl::DLSSGStatus::eFailResolutionTooLow)) ? " (resolution too low)" : "") +
+						((s & static_cast<u32>(sl::DLSSGStatus::eFailReflexNotDetectedAtRuntime)) ? " (Reflex not detected)" : "") +
+						((s & static_cast<u32>(sl::DLSSGStatus::eFailHDRFormatNotSupported)) ? " (HDR format)" : "") +
+						((s & static_cast<u32>(sl::DLSSGStatus::eFailCommonConstantsInvalid)) ? " (constants invalid)" : ""));
+				}
+				f.bad_status_frames = 120;
+			}
+			if (fgcfg().debug && (f.frames_on % 600) == 1)
+				fglog("frame generation: %u frames on, HUD split on %u", f.frames_on, f.hud_frames);
+		}
+
+		{
+			std::lock_guard lk(f.mu);
+			sl_marker(sl::PCLMarker::ePresentEnd, tok);
+			f.present_id = f.cur_rid;
+			f.render_open = false;
+		}
+		g_r2fg_active = on ? static_cast<int>(n) : 0;
+		f.prev_on = on;
+		f.scene = f.ready = f.have_b0 = f.have_ui = f.reset = f.sc_new = false;
+		return res;
+	}
+
+#ifdef R2PORT_HAVE_FFX
+	// ---- FSR 3 frame interpolation: FidelityFX frame-generation swapchain + frame-generation context ----
+
+	FfxApiResource fx_res(vk::viewable_image* img, uint32_t state)
+	{
+		return ffxApiGetResourceVK(reinterpret_cast<void*>(img->value), ffxApiGetImageResourceDescriptionVK(img->value, img->info, 0), state);
+	}
+
+	// Called by the swapchain from vkQueuePresentKHR to record the interpolation pass
+	ffxReturnCode_t fx_fg_callback(ffxDispatchDescFrameGeneration* p, void*)
+	{
+		if (!g_fx.fg_ctx || !p) return FFX_API_RETURN_ERROR;
+		p->reset = p->reset || g_fx.pending_reset.load();
+		return g_fx.dispatch(&g_fx.fg_ctx, &p->header);
+	}
+
+	// caller holds fx_lock
+	void fx_wait_presents()
+	{
+		if (!g_fx.sc_ctx) return;
+		ffxDispatchDescFrameGenerationSwapChainWaitForPresentsVK w{};
+		w.header.type = FFX_API_DISPATCH_DESC_TYPE_FGSWAPCHAIN_WAIT_FOR_PRESENTS_VK;
+		g_fx.dispatch(&g_fx.sc_ctx, &w.header);
+	}
+
+	// caller holds fx_lock
+	void fx_destroy_fg()
+	{
+		auto& x = g_fx;
+		if (!x.fg_ctx) return;
+		if (x.sc_ctx)
+		{
+			ffxConfigureDescFrameGeneration c{};
+			c.header.type = FFX_API_CONFIGURE_DESC_TYPE_FRAMEGENERATION;
+			c.swapChain = reinterpret_cast<void*>(x.sc);
+			c.frameGenerationCallback = &fx_fg_callback;
+			c.frameGenerationEnabled = false;
+			c.frameID = x.frame_id;
+			x.configure(&x.fg_ctx, &c.header);
+			fx_wait_presents();
+		}
+		x.destroy(&x.fg_ctx, nullptr);
+		x.fg_ctx = nullptr;
+		std::memset(x.key, 0, sizeof(x.key));
+		x.max_rw = x.max_rh = 0;
+		x.prev_gen = false;
+		x.hold = 0;
+	}
+
+	// caller holds fx_lock; also destroys the replacement swapchain
+	void fx_teardown()
+	{
+		auto& x = g_fx;
+		fx_destroy_fg();
+		if (x.sc_ctx)
+		{
+			fx_wait_presents();
+			x.destroy(&x.sc_ctx, nullptr);
+			x.sc_ctx = nullptr;
+		}
+		x.sc = VK_NULL_HANDLE;
+		x.fns = {};
+		x.sc_ok = false;
+	}
+
+	std::vector<VkSwapchainKHR> g_fx_retired; // destroyed here already; RPCS3 destroys them as oldSwapchain right after
+
+	bool fx_take(std::vector<VkSwapchainKHR>& v, VkSwapchainKHR h)
+	{
+		const auto it = std::find(v.begin(), v.end(), h);
+		if (it == v.end()) return false;
+		v.erase(it);
+		return true;
+	}
+
+	VkResult VKAPI_CALL fx_create_swapchain(VkDevice dev, const VkSwapchainCreateInfoKHR* info, const VkAllocationCallbacks* alloc, VkSwapchainKHR* out)
+	{
+		auto& f = g_fg;
+		auto& x = g_fx;
+		VkSwapchainCreateInfoKHR ci = *info;
+		VkSurfaceCapabilitiesKHR caps{};
+		if (vkGetPhysicalDeviceSurfaceCapabilitiesKHR(x.pdev, ci.surface, &caps) == VK_SUCCESS && (caps.supportedUsageFlags & VK_IMAGE_USAGE_TRANSFER_SRC_BIT))
+			ci.imageUsage |= VK_IMAGE_USAGE_TRANSFER_SRC_BIT;
+
+		g_fx_retired.clear();
+		const VkSwapchainKHR old = ci.oldSwapchain;
+		bool old_real = old != VK_NULL_HANDLE && std::find(x.real_scs.begin(), x.real_scs.end(), old) != x.real_scs.end();
+		if (x.sc_ctx)
+		{
+			// the FSR 3 swapchain cannot be handed over as oldSwapchain: it is destroyed here, before the new one
+			fx_lock lk;
+			if (old != VK_NULL_HANDLE && old == x.sc) g_fx_retired.push_back(old);
+			fx_teardown();
+		}
+		if (!old_real) ci.oldSwapchain = VK_NULL_HANDLE;
+
+		VkResult r = VK_ERROR_INITIALIZATION_FAILED;
+		bool via_fx = false;
+		x.sc_why.clear();
+		if (!x.failed)
+		{
+			if (ffxApiGetSurfaceFormatVK(ci.imageFormat) == FFX_API_SURFACE_FORMAT_UNKNOWN)
+				x.sc_why = "FSR 3 does not support swapchain format " + std::to_string(static_cast<int>(ci.imageFormat));
+			else
+			{
+				if (old_real)
+				{
+					x.real_destroy(dev, old, alloc);
+					fx_take(x.real_scs, old);
+					g_fx_retired.push_back(old);
+					old_real = false;
+				}
+				VkSwapchainCreateInfoKHR fci = ci;
+				fci.oldSwapchain = VK_NULL_HANDLE;
+				VkSwapchainKHR s = VK_NULL_HANDLE;
+				ffxCreateContextDescFrameGenerationSwapChainVK d{};
+				d.header.type = FFX_API_CREATE_CONTEXT_DESC_TYPE_FGSWAPCHAIN_VK;
+				d.physicalDevice = x.pdev;
+				d.device = dev;
+				d.swapchain = &s;
+				d.allocator = nullptr;
+				d.createInfo = fci;
+				d.gameQueue = { x.game_q, x.gfam, &fx_game_submit };
+				d.asyncComputeQueue = { VK_NULL_HANDLE, 0, nullptr };
+				d.presentQueue = { x.present_q, x.pfam, nullptr };
+				d.imageAcquireQueue = { x.acquire_q, x.afam, nullptr };
+				fx_lock lk;
+				const ffxReturnCode_t rc = x.create(&x.sc_ctx, &d.header, nullptr);
+				ffxQueryDescSwapchainReplacementFunctionsVK q{};
+				q.header.type = FFX_API_QUERY_DESC_TYPE_FGSWAPCHAIN_FUNCTIONS_VK;
+				const bool ok = rc == FFX_API_RETURN_OK && s != VK_NULL_HANDLE && x.query(&x.sc_ctx, &q.header) == FFX_API_RETURN_OK &&
+					q.pOutGetSwapchainImagesKHR && q.pOutAcquireNextImageKHR && q.pOutQueuePresentKHR;
+				if (ok)
+				{
+					x.sc = s;
+					x.fns = q;
+					x.sc_ok = true;
+					via_fx = true;
+					*out = s;
+					r = VK_SUCCESS;
+				}
+				else
+				{
+					if (x.sc_ctx) x.destroy(&x.sc_ctx, nullptr);
+					x.sc_ctx = nullptr;
+					x.failed = true;
+					fglog("frame generation off: the FSR 3 frame-generation swapchain failed (code %d)", static_cast<int>(rc));
+				}
+			}
+		}
+		if (!via_fx)
+		{
+			r = x.real_create(dev, &ci, alloc, out);
+			if (r != VK_SUCCESS && ci.imageUsage != info->imageUsage)
+			{
+				ci.imageUsage = info->imageUsage;
+				r = x.real_create(dev, &ci, alloc, out);
+			}
+			if (r != VK_SUCCESS) return r;
+			x.real_scs.push_back(*out);
+		}
+
+		f.sc_immediate = false;
+		f.sc_transfer = (ci.imageUsage & VK_IMAGE_USAGE_TRANSFER_SRC_BIT) != 0;
+		f.sc_format = ci.imageFormat;
+		f.sc_extent = ci.imageExtent;
+		u32 count = 0;
+		if (via_fx) x.fns.pOutGetSwapchainImagesKHR(dev, *out, &count, nullptr);
+		else x.real_images(dev, *out, &count, nullptr);
+		f.sc_images = count ? count : ci.minImageCount;
+		f.refresh_hz = monitor_hz();
+		f.sc_new = true;
+		if (!f.sc_transfer) fglog("frame generation: the swapchain cannot be copied from, HUD split off");
+		return r;
+	}
+
+	void VKAPI_CALL fx_destroy_swapchain(VkDevice dev, VkSwapchainKHR sc, const VkAllocationCallbacks* alloc)
+	{
+		auto& x = g_fx;
+		g_fg.sc_new = true;
+		if (sc == VK_NULL_HANDLE || fx_take(g_fx_retired, sc)) return;
+		if (sc == x.sc)
+		{
+			fx_lock lk;
+			fx_teardown();
+			return;
+		}
+		if (fx_take(x.real_scs, sc)) x.real_destroy(dev, sc, alloc);
+	}
+
+	VkResult VKAPI_CALL fx_sc_images(VkDevice dev, VkSwapchainKHR sc, uint32_t* n, VkImage* images)
+	{
+		if (sc != VK_NULL_HANDLE && sc == g_fx.sc) return g_fx.fns.pOutGetSwapchainImagesKHR(dev, sc, n, images);
+		return g_fx.real_images(dev, sc, n, images);
+	}
+
+	VkResult VKAPI_CALL fx_acquire(VkDevice dev, VkSwapchainKHR sc, uint64_t timeout, VkSemaphore sem, VkFence fence, uint32_t* index)
+	{
+		if (sc != VK_NULL_HANDLE && sc == g_fx.sc) return g_fx.fns.pOutAcquireNextImageKHR(dev, sc, timeout, sem, fence, index);
+		return g_fx.real_acquire(dev, sc, timeout, sem, fence, index);
+	}
+
+	// Phase 1 tail (after the HUD split): FG context, HUD-less back buffer and the prepare pass for this frame
+	void fx_present_tail(vk::command_buffer& cmd, VkImage target, VkImageLayout layout)
+	{
+		auto& f = g_fg;
+		auto& x = g_fx;
+		x.gen = x.on = x.frame_reset = false;
+		if (!x.sc_ctx || !x.sc_ok) return;
+		const bool on = f.want_on && f.scene && f.depth && f.mv && (f.debug_view || (f.have_ui && f.hudless && f.ui));
+		x.hold = on ? 30u : (x.hold ? x.hold - 1 : 0u);
+		// a short hold keeps generation enabled (as reset frames) so that brief interruptions do not toggle it: every
+		// enable / disable waits for the presenter
+		const bool gen = on || (x.hold && x.prev_gen && f.depth && f.mv && f.rw && f.rh);
+		if (!gen || !target) return;
+
+		const u32 W = f.sc_extent.width, H = f.sc_extent.height;
+		const bool hdr10 = is_10bit(f.sc_format);
+		const u32 key[6] = { W, H, static_cast<u32>(f.sc_format), f.inverted ? 1u : 0u, hdr10 ? 1u : 0u, 1u };
+		if (x.fg_ctx && (std::memcmp(key, x.key, sizeof(key)) != 0 || f.rw > x.max_rw || f.rh > x.max_rh))
+		{
+			fx_lock lk;
+			fx_destroy_fg();
+		}
+		if (!x.fg_ctx)
+		{
+			x.max_rw = std::max(W, f.rw);
+			x.max_rh = std::max(H, f.rh);
+			ffxCreateBackendVKDesc be{};
+			be.header.type = FFX_API_CREATE_CONTEXT_DESC_TYPE_BACKEND_VK;
+			be.vkDevice = x.device;
+			be.vkPhysicalDevice = x.pdev;
+			be.vkDeviceProcAddr = vkGetDeviceProcAddr;
+			ffxCreateContextDescFrameGeneration cd{};
+			cd.header.type = FFX_API_CREATE_CONTEXT_DESC_TYPE_FRAMEGENERATION;
+			cd.header.pNext = &be.header;
+			cd.flags = (f.inverted ? FFX_FRAMEGENERATION_ENABLE_DEPTH_INVERTED : 0u) | (hdr10 ? FFX_FRAMEGENERATION_ENABLE_HIGH_DYNAMIC_RANGE : 0u);
+			cd.displaySize = { W, H };
+			cd.maxRenderSize = { x.max_rw, x.max_rh };
+			cd.backBufferFormat = ffxApiGetSurfaceFormatVK(f.sc_format);
+			ffxReturnCode_t rc;
+			{
+				fx_lock lk;
+				rc = x.create(&x.fg_ctx, &cd.header, nullptr);
+			}
+			if (rc != FFX_API_RETURN_OK || !x.fg_ctx)
+			{
+				x.fg_ctx = nullptr;
+				f.reason.clear();
+				set_reason("the FSR 3 frame-generation context failed (code " + std::to_string(static_cast<int>(rc)) + ")");
+				f.bad_status_frames = 600;
+				return;
+			}
+			std::memcpy(x.key, key, sizeof(key));
+		}
+
+		if (vk::is_renderpass_open(cmd)) vk::end_renderpass(cmd);
+		if (on && !f.debug_view)
+		{
+			// the swapchain composites the UI layer onto both the real and the generated frame: present the HUD-less scene
+			f.hudless->change_layout(cmd, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL);
+			vk::change_image_layout(cmd, target, layout, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, k_color_range);
+			VkImageBlit blit{};
+			blit.srcSubresource = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1 };
+			blit.dstSubresource = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1 };
+			blit.srcOffsets[1] = { static_cast<s32>(W), static_cast<s32>(H), 1 };
+			blit.dstOffsets[1] = { static_cast<s32>(W), static_cast<s32>(H), 1 };
+			vkCmdBlitImage(cmd, f.hudless->value, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, target, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, 1, &blit, VK_FILTER_NEAREST);
+			vk::change_image_layout(cmd, target, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, layout, k_color_range);
+			f.hudless->change_layout(cmd, VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL);
+		}
+		f.depth->change_layout(cmd, VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL);
+		f.mv->change_layout(cmd, VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL);
+
+		const auto now = std::chrono::steady_clock::now();
+		float dt = 1000.f / 30.f;
+		if (x.last_prep.time_since_epoch().count())
+			dt = std::clamp(std::chrono::duration<float, std::milli>(now - x.last_prep).count(), 1.f, 200.f);
+		x.last_prep = now;
+
+		ffxDispatchDescFrameGenerationPrepareCameraInfo cam{};
+		cam.header.type = FFX_API_DISPATCH_DESC_TYPE_FRAMEGENERATION_PREPARE_CAMERAINFO;
+		cam.cameraUp[1] = 1.f;
+		cam.cameraRight[0] = 1.f;
+		cam.cameraForward[2] = 1.f;
+		ffxDispatchDescFrameGenerationPrepare p{};
+		p.header.type = FFX_API_DISPATCH_DESC_TYPE_FRAMEGENERATION_PREPARE;
+		p.header.pNext = &cam.header;
+		p.frameID = x.frame_id + 1;
+		p.flags = 0;
+		p.commandList = static_cast<VkCommandBuffer>(cmd);
+		p.renderSize = { f.rw, f.rh };
+		p.jitterOffset = { f.jx, f.jy };
+		p.motionVectorScale = { f.mvsx * static_cast<float>(f.rw), f.mvsy * static_cast<float>(f.rh) };
+		p.frameTimeDelta = dt;
+		vk::r2aa_camera(p.cameraNear, p.cameraFar, p.cameraFovAngleVertical);
+		p.viewSpaceToMetersFactor = 1.f;
+		p.depth = fx_res(f.depth.get(), FFX_API_RESOURCE_STATE_COMPUTE_READ);
+		p.motionVectors = fx_res(f.mv.get(), FFX_API_RESOURCE_STATE_COMPUTE_READ);
+		const ffxReturnCode_t rc = x.dispatch(&x.fg_ctx, &p.header);
+		cmd.r2_invalidate_state_cache();
+		if (rc != FFX_API_RETURN_OK)
+		{
+			f.reason.clear();
+			set_reason("FSR 3 rejected this frame's inputs (code " + std::to_string(static_cast<int>(rc)) + ")");
+			f.bad_status_frames = 120;
+			return;
+		}
+		x.gen = true;
+		x.on = on;
+		x.frame_reset = !x.prev_gen || f.sc_new || f.reset || !on;
+	}
+
+	VkResult VKAPI_CALL fx_queue_present(VkQueue queue, const VkPresentInfoKHR* info)
+	{
+		auto& f = g_fg;
+		auto& x = g_fx;
+		bool mine = false;
+		for (u32 i = 0; i < info->swapchainCount; ++i)
+			if (x.sc != VK_NULL_HANDLE && info->pSwapchains[i] == x.sc) mine = true;
+		if (!mine)
+		{
+			const VkResult r = x.real_present(queue, info);
+			g_r2fg_active = 0;
+			f.prev_on = false;
+			f.scene = f.ready = f.have_b0 = f.have_ui = f.reset = f.sc_new = false;
+			return r;
+		}
+
+		const bool gen = x.gen && f.ready && x.fg_ctx;
+		if (gen && fgcfg().cap && f.refresh_hz > 1.0)
+		{
+			// rendered frames x2 must stay under the refresh rate (VRR range); the game's own cap applies on top
+			const auto step = std::chrono::duration_cast<std::chrono::steady_clock::duration>(std::chrono::duration<double>(2.0 / (f.refresh_hz * 0.95)));
+			auto now = std::chrono::steady_clock::now();
+			if (x.next_present > now)
+			{
+				if (x.next_present - now > std::chrono::milliseconds(2)) std::this_thread::sleep_for(x.next_present - now - std::chrono::milliseconds(1));
+				while (std::chrono::steady_clock::now() < x.next_present) std::this_thread::yield();
+				now = x.next_present;
+			}
+			x.next_present = (now - x.next_present > step) ? now + step : x.next_present + step;
+		}
+
+		if (x.fg_ctx)
+		{
+			fx_lock lk;
+			ffxConfigureDescFrameGeneration c{};
+			c.header.type = FFX_API_CONFIGURE_DESC_TYPE_FRAMEGENERATION;
+			c.swapChain = reinterpret_cast<void*>(x.sc);
+			c.presentCallback = nullptr;
+			c.frameGenerationCallback = &fx_fg_callback;
+			c.frameGenerationEnabled = gen;
+			c.allowAsyncWorkloads = false;
+			c.flags = fgcfg().debug_level >= 2 ? (FFX_FRAMEGENERATION_FLAG_DRAW_DEBUG_TEAR_LINES | FFX_FRAMEGENERATION_FLAG_DRAW_DEBUG_RESET_INDICATORS) : 0u;
+			c.onlyPresentGenerated = false;
+			if (gen && f.rwid > 0 && f.rhei > 0) c.generationRect = { f.rx, f.ry, f.rwid, f.rhei };
+			else c.generationRect = { 0, 0, static_cast<int32_t>(f.sc_extent.width), static_cast<int32_t>(f.sc_extent.height) };
+			c.frameID = ++x.frame_id;
+			ffxReturnCode_t rc = x.configure(&x.fg_ctx, &c.header);
+
+			ffxConfigureDescFrameGenerationSwapChainRegisterUiResourceVK u{};
+			u.header.type = FFX_API_CONFIGURE_DESC_TYPE_FGSWAPCHAIN_REGISTERUIRESOURCE_VK;
+			if (gen && x.on && !f.debug_view && f.have_ui && f.ui)
+			{
+				u.uiResource = fx_res(f.ui.get(), FFX_API_RESOURCE_STATE_PIXEL_COMPUTE_READ);
+				u.flags = FFX_FRAMEGENERATION_UI_COMPOSITION_FLAG_USE_PREMUL_ALPHA | FFX_FRAMEGENERATION_UI_COMPOSITION_FLAG_ENABLE_INTERNAL_UI_DOUBLE_BUFFERING;
+			}
+			if (rc == FFX_API_RETURN_OK) rc = x.configure(&x.sc_ctx, &u.header);
+			if (rc != FFX_API_RETURN_OK && !f.bad_status_frames)
+			{
+				f.reason.clear();
+				set_reason("FSR 3 frame generation configuration failed (code " + std::to_string(static_cast<int>(rc)) + ")");
+				f.bad_status_frames = 120;
+			}
+		}
+		x.pending_reset = x.frame_reset || !gen;
+
+		const VkResult res = x.fns.pOutQueuePresentKHR(queue, info);
+		if (res < 0)
+		{
+			fx_lock lk;
+			fx_wait_presents();
+		}
+
+		if (gen && x.on)
+		{
+			if (f.split) f.hud_frames++;
+			f.frames_on++;
+			if (fgcfg().debug && (f.frames_on % 600) == 1)
+				fglog("frame generation (FSR 3): %u frames on, HUD split on %u", f.frames_on, f.hud_frames);
+		}
+		g_r2fg_active = gen && x.on ? 2 : 0;
+		x.prev_gen = gen;
+		x.gen = x.on = x.frame_reset = false;
+		f.prev_on = gen && x.on;
+		f.scene = f.ready = f.have_b0 = f.have_ui = f.reset = f.sc_new = false;
+		return res;
+	}
+#endif
+}
+
+namespace vk
+{
+	void r2fg_present(int phase, vk::command_buffer& cmd, VkImage target, VkImageLayout layout, vk::viewable_image* src,
+		u32 buffer_w, u32 buffer_h, s32 x1, s32 y1, s32 x2, s32 y2)
+	{
+		r2fg_present_body(phase, cmd, target, layout, src, buffer_w, buffer_h, x1, y1, x2, y2);
+#ifdef R2PORT_HAVE_FFX
+		if (phase == 1 && fx_usable()) fx_present_tail(cmd, target, layout);
+#endif
+	}
+
+	bool r2fg_set_hdr_metadata(VkDevice device, VkSwapchainKHR swapchain, const VkHdrMetadataEXT* md)
+	{
+#ifdef R2PORT_HAVE_FFX
+		if (swapchain != VK_NULL_HANDLE && swapchain == g_fx.sc && g_fx.fns.pOutSetHdrMetadataEXT)
+		{
+			g_fx.fns.pOutSetHdrMetadataEXT(device, 1, &swapchain, md);
+			return true;
+		}
+#endif
+		return false;
+	}
+
+	void r2fg_swapchain_procs(VkDevice device, PFN_vkCreateSwapchainKHR& create, PFN_vkDestroySwapchainKHR& destroy,
+		PFN_vkGetSwapchainImagesKHR& images, PFN_vkAcquireNextImageKHR& acquire, PFN_vkQueuePresentKHR& present)
+	{
+#ifdef R2PORT_HAVE_FFX
+		if (fx_usable() && device == g_fx.device)
+		{
+			g_fx.real_create = create;
+			g_fx.real_destroy = destroy;
+			g_fx.real_images = images;
+			g_fx.real_acquire = acquire;
+			g_fx.real_present = present;
+			if (!create || !destroy || !images || !acquire || !present) return;
+			create = &fx_create_swapchain;
+			destroy = &fx_destroy_swapchain;
+			images = &fx_sc_images;
+			acquire = &fx_acquire;
+			present = &fx_queue_present;
+			return;
+		}
+#endif
+		if (!sl_device() || device != g_sl.device) return;
+		g_sl.p_create_sc = reinterpret_cast<PFN_vkCreateSwapchainKHR>(g_sl.gdpa(device, "vkCreateSwapchainKHR"));
+		g_sl.p_destroy_sc = reinterpret_cast<PFN_vkDestroySwapchainKHR>(g_sl.gdpa(device, "vkDestroySwapchainKHR"));
+		g_sl.p_sc_images = reinterpret_cast<PFN_vkGetSwapchainImagesKHR>(g_sl.gdpa(device, "vkGetSwapchainImagesKHR"));
+		g_sl.p_acquire = reinterpret_cast<PFN_vkAcquireNextImageKHR>(g_sl.gdpa(device, "vkAcquireNextImageKHR"));
+		g_sl.p_present = reinterpret_cast<PFN_vkQueuePresentKHR>(g_sl.gdpa(device, "vkQueuePresentKHR"));
+		if (!g_sl.p_create_sc || !g_sl.p_destroy_sc || !g_sl.p_sc_images || !g_sl.p_acquire || !g_sl.p_present)
+		{
+			fglog("frame generation off: Streamline swapchain proxies missing");
+			g_sl.fg_supported = false;
+			return;
+		}
+		create = &fg_create_swapchain;
+		destroy = &fg_destroy_swapchain;
+		images = g_sl.p_sc_images;
+		acquire = g_sl.p_acquire;
+		present = &fg_queue_present;
+	}
+
+	void r2fg_device_destroyed(VkDevice device)
+	{
+#ifdef R2PORT_HAVE_FFX
+		if (device != VK_NULL_HANDLE && device == g_fx.device)
+		{
+			{
+				fx_lock lk;
+				fx_teardown();
+				vkDeviceWaitIdle(device);
+			}
+			fg_release_images();
+			g_r2fg_active = 0;
+			g_fx.real_scs.clear();
+			g_fx_retired.clear();
+			g_fx.device = VK_NULL_HANDLE;
+			return;
+		}
+#endif
+		if (device == VK_NULL_HANDLE || device != g_sl.device) return;
+		if (g_sl.p_wait_idle) g_sl.p_wait_idle(device);
+		fg_release_images();
+		g_r2fg_active = 0;
+		g_sl.device = VK_NULL_HANDLE;
+		g_sl.fg_supported = false;
+		g_sl.reflex = false;
+		g_fg.opt_valid = false;
+		g_fg.reflex_limit = ~0u;
+		if (g_sl.inited) g_sl.fn_shutdown();
+		g_sl.inited = false;
+	}
+
+	// Streamline Reflex (DLSS-G), or FSR 3 frame generation (its swapchain does not support VK_NV_low_latency2)
+	bool r2fg_owns_reflex()
+	{
+#ifdef R2PORT_HAVE_FFX
+		if (g_fx.selected && !g_fx.failed) return true;
+#endif
+		return g_sl.inited;
+	}
+}
+
+// Once per game frame from the game's frame limiter: Reflex sleep plus the simulation markers
+extern "C" int r2fg_game_frame(void)
+{
+	if (!sl_device() || !g_sl.reflex) return 0;
+	auto& f = g_fg;
+	u32 id;
+	{
+		std::lock_guard lk(f.mu);
+		sl::FrameToken* tok = nullptr;
+		if (f.sim_open && g_sl.fn_token(tok, &f.sim_id) == sl::Result::eOk && tok) sl_marker(sl::PCLMarker::eSimulationEnd, tok);
+		f.sim_open = false;
+		f.sim_id = std::max(f.sim_id + 1, f.present_id + 1);
+		id = f.sim_id;
+	}
+	sl::FrameToken* tok = nullptr;
+	if (g_sl.fn_token(tok, &id) == sl::Result::eOk && tok) g_sl.fn_r_sleep(*tok);
+	{
+		std::lock_guard lk(f.mu);
+		tok = nullptr;
+		if (g_sl.fn_token(tok, &id) == sl::Result::eOk && tok) sl_marker(sl::PCLMarker::eSimulationStart, tok);
+		f.sim_open = true;
+	}
+	g_pc_reflex_active = 1;
+	return 1;
+}
