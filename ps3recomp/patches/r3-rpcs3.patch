+			case RSX_VEC_OPCODE_SGE: cmp([](float x, float y) { return x >= y; }); break;
+			case RSX_VEC_OPCODE_SEQ: cmp([](float x, float y) { return x == y; }); break;
+			case RSX_VEC_OPCODE_SGT: cmp([](float x, float y) { return x > y; }); break;
+			case RSX_VEC_OPCODE_SLE: cmp([](float x, float y) { return x <= y; }); break;
+			case RSX_VEC_OPCODE_SNE: cmp([](float x, float y) { return x != y; }); break;
+			case RSX_VEC_OPCODE_SFL: break;
+			case RSX_VEC_OPCODE_STR: R2_LANES vr[l][i] = 1.f; break;
+			case RSX_VEC_OPCODE_SSG: R2_LANES vr[l][i] = s0[l][i] > 0 ? 1.f : s0[l][i] < 0 ? -1.f : 0.f; break;
