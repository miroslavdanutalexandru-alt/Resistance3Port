+#endif
+
+	if (ok) vk::r2fg_tag_scene(cmd, st.depth.get(), st.mv.get(), rw, rh, jx, jy, st.vw, st.vh, st.inverted, reset, &T.m[0][0], zA, zB); // R2PORT frame generation
