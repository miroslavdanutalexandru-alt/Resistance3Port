+	bool fx_usable() { return g_fx.selected && !g_fx.failed && g_fx.device != VK_NULL_HANDLE; }
+
+	// Picks FSR 3 before the main Vulkan instance exists (the device needs extra queues for it)
+	bool fsr3_setup()
+	{
+		const auto off = [](const std::string& why)
+		{
+			fglog("frame generation off: %s", why.c_str());
+			return false;
+		};
+		if (vk::r2aa_mode() == 0)
+			return off("FSR 3 frame generation needs an anti-aliasing / upscaling mode (launcher Anti-aliasing: FSR, DLSS or XeSS) for depth and motion vectors");
+		const std::wstring path = exe_dir() + L"\\amd_fidelityfx_vk.dll";
+		if (GetFileAttributesW(path.c_str()) == INVALID_FILE_ATTRIBUTES) return off("missing amd_fidelityfx_vk.dll next to the exe (run setup.ps1 again)");
+		g_fx.dll = LoadLibraryW(path.c_str());
+		if (!g_fx.dll) return off("amd_fidelityfx_vk.dll failed to load");
+		g_fx.create = reinterpret_cast<PfnFfxCreateContext>(GetProcAddress(g_fx.dll, "ffxCreateContext"));
+		g_fx.destroy = reinterpret_cast<PfnFfxDestroyContext>(GetProcAddress(g_fx.dll, "ffxDestroyContext"));
+		g_fx.configure = reinterpret_cast<PfnFfxConfigure>(GetProcAddress(g_fx.dll, "ffxConfigure"));
+		g_fx.query = reinterpret_cast<PfnFfxQuery>(GetProcAddress(g_fx.dll, "ffxQuery"));
+		g_fx.dispatch = reinterpret_cast<PfnFfxDispatch>(GetProcAddress(g_fx.dll, "ffxDispatch"));
+		if (!g_fx.create || !g_fx.destroy || !g_fx.configure || !g_fx.query || !g_fx.dispatch)
+			return off("amd_fidelityfx_vk.dll has no FidelityFX API exports");
+		if (fgcfg().want > 2) fglog("FSR 3 frame generation is 2x only: using 2x");
+		if (penv_int("REFLEX", 0)) fglog("NVIDIA Reflex is off while FSR 3 frame generation is selected");
+		g_fx.selected = true;
+		return true;
+	}
+
+	// RPCS3 serialises vkQueueSubmit with g_submit_mutex; FSR 3 submits to (and waits on) the same graphics queue
+	thread_local bool t_fx_held = false;
+	struct fx_lock
+	{
+		fx_lock() { vk::acquire_global_submit_lock(); t_fx_held = true; }
+		~fx_lock() { t_fx_held = false; vk::release_global_submit_lock(); }
+		fx_lock(const fx_lock&) = delete;
+		fx_lock& operator=(const fx_lock&) = delete;
+	};
+
+	VkResult fx_game_submit(uint32_t count, const VkSubmitInfo* submits, VkFence fence)
+	{
+		if (t_fx_held) return vkQueueSubmit(g_fx.game_q, count, submits, fence);
+		vk::acquire_global_submit_lock();
+		const VkResult r = vkQueueSubmit(g_fx.game_q, count, submits, fence);
+		vk::release_global_submit_lock();
+		return r;
+	}
+
+	// The device RPCS3 asks for, plus a present queue and an image-acquire queue for the FSR 3 swapchain and the
+	// timeline semaphores it uses. Without them FSR 3 stays off (logged) and the device is created unchanged.
+	VkResult fx_create_device(VkPhysicalDevice pdev, const VkDeviceCreateInfo* info, VkDevice* device)
+	{
+		auto& x = g_fx;
+		const auto fail = [&](const std::string& why)
+		{
+			fglog("frame generation off: %s", why.c_str());
+			x.failed = true;
+			return vkCreateDevice(pdev, info, nullptr, device);
+		};
+		if (!info->queueCreateInfoCount || !info->pQueueCreateInfos) return fail("no device queues");
+
+		u32 nfam = 0;
+		vkGetPhysicalDeviceQueueFamilyProperties(pdev, &nfam, nullptr);
+		std::vector<VkQueueFamilyProperties> fams(nfam);
+		if (nfam) vkGetPhysicalDeviceQueueFamilyProperties(pdev, &nfam, fams.data());
+		std::vector<u32> used(nfam, 0);
+		for (u32 i = 0; i < info->queueCreateInfoCount; ++i)
+		{
+			const auto& q = info->pQueueCreateInfos[i];
+			if (q.queueFamilyIndex < nfam) used[q.queueFamilyIndex] = std::max(used[q.queueFamilyIndex], q.queueCount);
+		}
+		const u32 gfam = info->pQueueCreateInfos[0].queueFamilyIndex;
+		if (gfam >= nfam || nfam > 16) return fail("unexpected Vulkan queue families");
+		const auto spare = [&](u32 fam) { return fam < nfam && used[fam] < fams[fam].queueCount; };
+		const auto both = [&](u32 fam) { return (fams[fam].queueFlags & (VK_QUEUE_GRAPHICS_BIT | VK_QUEUE_COMPUTE_BIT)) != 0; };
+
+		// present queue: a second graphics queue, else another graphics/compute family that can present
+		int pfam = -1;
+		if (spare(gfam)) pfam = static_cast<int>(gfam);
+		for (u32 f = 0; pfam < 0 && f < nfam; ++f)
+			if (spare(f) && both(f) && vkGetPhysicalDeviceWin32PresentationSupportKHR(pdev, f)) pfam = static_cast<int>(f);
+		if (pfam < 0) return fail("FSR 3 needs a spare graphics or compute queue that can present on this GPU");
+		const u32 pidx = used[pfam]++;
+		// image-acquire queue: any spare queue, preferably a transfer-only one
+		int afam = -1;
+		for (u32 f = 0; afam < 0 && f < nfam; ++f)
+			if (spare(f) && !both(f)) afam = static_cast<int>(f);
+		for (u32 f = 0; afam < 0 && f < nfam; ++f)
+			if (spare(f)) afam = static_cast<int>(f);
+		if (afam < 0) return fail("FSR 3 needs one more spare Vulkan queue on this GPU");
+		const u32 aidx = used[afam]++;
+
+		// timeline semaphores (Vulkan 1.2 feature, in RPCS3's chained VkPhysicalDeviceVulkan12Features)
+		VkPhysicalDeviceVulkan12Features have12{ VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_VULKAN_1_2_FEATURES };
+		VkPhysicalDeviceFeatures2 f2{ VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_FEATURES_2 };
+		f2.pNext = &have12;
+		vkGetPhysicalDeviceFeatures2(pdev, &f2);
+		VkPhysicalDeviceVulkan12Features* chain12 = nullptr;
+		for (auto* p = static_cast<const VkBaseInStructure*>(info->pNext); p; p = p->pNext)
+			if (p->sType == VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_VULKAN_1_2_FEATURES)
+				chain12 = reinterpret_cast<VkPhysicalDeviceVulkan12Features*>(const_cast<VkBaseInStructure*>(p));
+		if (!have12.timelineSemaphore || !chain12) return fail("FSR 3 needs Vulkan timeline semaphores");
+		const VkBool32 old_timeline = chain12->timelineSemaphore;
+		chain12->timelineSemaphore = VK_TRUE;
+
+		std::vector<VkDeviceQueueCreateInfo> qs(info->pQueueCreateInfos, info->pQueueCreateInfos + info->queueCreateInfoCount);
+		std::vector<std::vector<float>> prios;
+		prios.reserve(nfam);
+		for (u32 f = 0; f < nfam; ++f)
+		{
+			if (!used[f]) continue;
+			auto it = std::find_if(qs.begin(), qs.end(), [&](const VkDeviceQueueCreateInfo& q) { return q.queueFamilyIndex == f; });
+			if (it == qs.end())
+			{
+				VkDeviceQueueCreateInfo q{ VK_STRUCTURE_TYPE_DEVICE_QUEUE_CREATE_INFO };
+				q.queueFamilyIndex = f;
+				it = qs.insert(qs.end(), q);
+			}
+			if (it->queueCount == used[f]) continue;
+			it->queueCount = used[f];
+			prios.emplace_back(used[f], 0.f);
+			it->pQueuePriorities = prios.back().data();
+		}
+		VkDeviceCreateInfo ci = *info;
+		ci.queueCreateInfoCount = static_cast<u32>(qs.size());
+		ci.pQueueCreateInfos = qs.data();
+		const VkResult r = vkCreateDevice(pdev, &ci, nullptr, device);
+		if (r != VK_SUCCESS)
+		{
+			chain12->timelineSemaphore = old_timeline;
+			return fail("the Vulkan device with FSR 3's extra queues failed (" + std::to_string(static_cast<int>(r)) + ")");
+		}
+		x.device = *device;
+		x.pdev = pdev;
+		x.gfam = gfam;
+		x.pfam = static_cast<u32>(pfam);
+		x.afam = static_cast<u32>(afam);
+		vkGetDeviceQueue(*device, gfam, 0, &x.game_q);
+		vkGetDeviceQueue(*device, x.pfam, pidx, &x.present_q);
+		vkGetDeviceQueue(*device, x.afam, aidx, &x.acquire_q);
+		VkPhysicalDeviceProperties props{};
+		vkGetPhysicalDeviceProperties(pdev, &props);
+		fglog("FSR 3 frame generation 2x ready on %s (HUD split %s)", props.deviceName, fgcfg().hud ? "on" : "off");
+		return r;
+	}
+#else
+	bool fx_usable() { return false; }
+#endif
+}
