diff --git a/rpcs3/Emu/RSX/VK/VKSplit2.h b/rpcs3/Emu/RSX/VK/VKSplit2.h
new file mode 100644
index 0000000..109bf25
--- /dev/null
+++ b/rpcs3/Emu/RSX/VK/VKSplit2.h
@@ -0,0 +1,305 @@
+#pragma once
+
+// RSX_SPLIT2 (r11 staged rsx::thread split, stage 2): the transform-constant UBO fill of VKGSRender::load_program_env
+// runs on a worker pipelined behind rsx::thread. rsx::thread still allocates, maps, windows and memoizes the ring range
+// exactly as before; only the byte copy REGS->transform_constants -> mapped ring moves. Jobs run strictly in kick order
+// (SPSC ring). The worker touches no guest memory, no Vulkan object and no renderer state, so it can never fault.
+//
+// Joins (rsx::thread waits until every kicked job is written):
+//  - before rsx::thread submits or queues (MTRSX) any command buffer (vk::queue_submit -> r2memo::before_gpu_submit). Every
+//    guest-visible sync point (label/semaphore release, report, flip, readback, texture-cache flush) submits first;
+//  - before any writer of REGS->transform_constants (r2memo::before_xform_write: nv4097 decode/barrier replay,
+//    rsx_state::init/operator=), so the worker always reads the constants of its own draw;
+//  - before a ring heap is unmapped (data_heap::grow/destroy -> r2memo::before_heap_unmap) and at VKGSRender::on_exit
+//    (vertex programs, whose constant_ids the jobs reference, are destroyed there).
+// Ring space is only recycled after the frame fence, i.e. after a submit, i.e. after a join.
+//
+// RSX_SPLIT2=0 (default) off, 1 on, 2 validate (rsx::thread hashes the bytes the inline path would write at the kick,
+// the worker hashes what it wrote; mismatches are counted and logged). RSX_SPLIT2_SPIN_US: worker spin before sleeping.
+
+#include <atomic>
+#include <chrono>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <thread>
+
+#if defined(_M_X64) || defined(__x86_64__)
+#include <immintrin.h>
+#define RSX_SPLIT2_X64 1
+#endif
+
+#include "../port_r2memo.h"
+
+namespace vk::split2
+{
+	enum join_reason : uint32_t { j_unmap, j_submit, j_xform, j_exit, j_count };
+	inline const char* const join_names[j_count] = { "unmap", "submit", "xform", "exit" };
+
+	inline int mode()
+	{
+		static const int m = []
+		{
+			const char* v = std::getenv("RSX_SPLIT2");
+			const int x = (v && *v) ? std::atoi(v) : 0;
+			if (x > 0) std::fprintf(stderr, "[split2] RSX_SPLIT2=%d: transform constant fill on the stage-2 worker%s\n", x > 2 ? 2 : x,
+				x >= 2 ? " (validate)" : "");
+			return x < 0 ? 0 : (x > 2 ? 2 : x);
+		}();
+		return m;
+	}
+
+	constexpr uint32_t ring_size = 1024;
+	constexpr size_t full_bytes = 468 * 4 * sizeof(float); // draw_command_processor::fill_vertex_program_constants_data
+
+	struct job
+	{
+		void* dst;
+		const void* src;     // REGS->transform_constants
+		const uint16_t* ids; // nullptr: the full 468-constant copy
+		uint32_t count;
+		uint32_t seq;
+		uint64_t expect;     // RSX_SPLIT2=2
+	};
+
+	struct state
+	{
+		job ring[ring_size]{};
+		alignas(64) std::atomic<uint32_t> head{ 0 };
+		alignas(64) std::atomic<uint32_t> done{ 0 };
+		alignas(64) std::atomic<uint32_t> sleeping{ 0 };
+		std::atomic<uint64_t> work_ns{ 0 }, validated{ 0 }, mismatches{ 0 }, foreign{ 0 }; // foreign: no-op joins from other threads
+
+		// rsx::thread only
+		alignas(64) uint32_t local_head = 0;
+		bool started = false;
+		uint32_t spin_us = 200;
+		std::thread::id owner{};
+		uint64_t jobs = 0, bytes = 0, frames = 0, full_stalls = 0, full_ns = 0;
+		uint64_t joins[j_count]{}, stalls[j_count]{}, stall_ns[j_count]{};
+		uint64_t mism_seen = 0;
+		std::chrono::steady_clock::time_point t0{};
+	};
+	inline state g_s2;
+
+	inline void cpu_pause()
+	{
+#ifdef RSX_SPLIT2_X64
+		_mm_pause();
+#else
+		std::this_thread::yield();
+#endif
+	}
+
+	inline uint64_t mix(uint64_t h, uint64_t v)
+	{
+		h ^= v + 0x9e3779b97f4a7c15ull + (h << 6) + (h >> 2);
+		return h * 0xff51afd7ed558ccdull;
+	}
+
+	inline uint64_t hash16(uint64_t h, const void* p)
+	{
+		uint64_t w[2];
+		std::memcpy(w, p, 16);
+		return mix(mix(h, w[0]), w[1]);
+	}
+
+	inline size_t job_bytes(const job& j) { return j.ids ? size_t{ j.count } * 16 : full_bytes; }
+
+	// The bytes the inline path (fill_vertex_program_constants_data) writes, read from the live registers
+	inline uint64_t hash_source(const job& j)
+	{
+		uint64_t h = 0x243f6a8885a308d3ull;
+		const auto* s = static_cast<const char*>(j.src);
+		if (j.ids)
+			for (uint32_t i = 0; i < j.count; ++i) h = hash16(h, s + size_t{ j.ids[i] } * 16);
+		else
+			for (size_t o = 0; o < full_bytes; o += 16) h = hash16(h, s + o);
+		return h;
+	}
+
+	inline uint64_t hash_dest(const job& j)
+	{
+		uint64_t h = 0x243f6a8885a308d3ull;
+		const auto* d = static_cast<const char*>(j.dst);
+		for (size_t o = 0, n = job_bytes(j); o < n; o += 16) h = hash16(h, d + o);
+		return h;
+	}
+
+	inline void run(const job& j)
+	{
+		auto* d = static_cast<char*>(j.dst);
+		const auto* s = static_cast<const char*>(j.src);
+		if (j.ids)
+		{
+			for (uint32_t i = 0; i < j.count; ++i, d += 16)
+			{
+#ifdef RSX_SPLIT2_X64
+				// Same non-temporal stores as utils::stream_vector_from_memory
+				_mm_stream_si128(reinterpret_cast<__m128i*>(d), _mm_loadu_si128(reinterpret_cast<const __m128i*>(s + size_t{ j.ids[i] } * 16)));
+#else
+				std::memcpy(d, s + size_t{ j.ids[i] } * 16, 16);
+#endif
+			}
+		}
+		else
+		{
+			std::memcpy(d, s, full_bytes);
+		}
+#ifdef RSX_SPLIT2_X64
+		_mm_sfence(); // the streamed stores are globally visible before 'done' publishes them
+#endif
+	}
+
+	inline void worker_main()
+	{
+		auto& S = g_s2;
+		const bool validate = mode() == 2;
+		uint32_t seen = 0;
+		for (;;)
+		{
+			uint32_t h = S.head.load(std::memory_order_acquire);
+			auto t0 = std::chrono::steady_clock::now();
+			for (uint32_t n = 1; h == seen; ++n)
+			{
+				cpu_pause();
+				h = S.head.load(std::memory_order_acquire);
+				if (h != seen || (n & 255) || std::chrono::steady_clock::now() - t0 < std::chrono::microseconds(S.spin_us)) continue;
+				// Idle: sleep. Dekker with kick(): sleeping (seq_cst) then head / head (seq_cst) then sleeping
+				S.sleeping.store(1, std::memory_order_seq_cst);
+				h = S.head.load(std::memory_order_seq_cst);
+				if (h == seen) S.head.wait(seen, std::memory_order_acquire);
+				S.sleeping.store(0, std::memory_order_relaxed);
+				h = S.head.load(std::memory_order_acquire);
+				t0 = std::chrono::steady_clock::now();
+			}
+			const auto w0 = std::chrono::steady_clock::now();
+			while (seen != h)
+			{
+				const job& j = S.ring[seen % ring_size];
+				run(j);
+				if (validate)
+				{
+					S.validated.fetch_add(1, std::memory_order_relaxed);
+					if (const uint64_t got = hash_dest(j); got != j.expect && S.mismatches.fetch_add(1, std::memory_order_relaxed) < 16)
+						std::fprintf(stderr, "[split2] WARNING RSX_SPLIT2=2: job %u (%s, %u constants) wrote %016llx, the inline path %016llx\n",
+							j.seq, j.ids ? "relocated" : "full", j.ids ? j.count : 468u, static_cast<unsigned long long>(got),
+							static_cast<unsigned long long>(j.expect));
+				}
+				S.done.store(++seen, std::memory_order_release);
+			}
+			S.work_ns.fetch_add(static_cast<uint64_t>(std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::steady_clock::now() - w0).count()),
+				std::memory_order_relaxed);
+		}
+	}
+
+	// Waits until every job kicked so far is written. From rsx::thread always. From any other thread only for j_exit /
+	// j_unmap (renderer teardown on its own thread, a ring heap unmapped by another thread): it waits for a snapshot of
+	// head, which terminates as the worker never blocks. Other foreign joins (the MTRSX offloader running a queued
+	// packet, a fault thread's texture-cache flush) return at once: every job feeds rsx::thread's own command buffers and
+	// rsx::thread joins before it submits or queues one (vk::queue_submit, close_and_submit_command_buffer).
+	inline void join_slow(uint32_t reason)
+	{
+		auto& S = g_s2;
+		if (std::this_thread::get_id() != S.owner)
+		{
+			S.foreign.fetch_add(1, std::memory_order_relaxed);
+			if (reason == j_exit || reason == j_unmap)
+			{
+				const uint32_t target = S.head.load(std::memory_order_acquire);
+				while (static_cast<int32_t>(S.done.load(std::memory_order_acquire) - target) < 0) cpu_pause();
+			}
+			return;
+		}
+		const uint32_t target = S.local_head;
+		// Wrap-safe: done is behind target while (int32_t)(done - target) < 0
+		if (static_cast<int32_t>(S.done.load(std::memory_order_acquire) - target) < 0)
+		{
+			const auto t0 = std::chrono::steady_clock::now();
+			while (static_cast<int32_t>(S.done.load(std::memory_order_acquire) - target) < 0) cpu_pause();
+			S.stalls[reason]++;
+			S.stall_ns[reason] += static_cast<uint64_t>(std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::steady_clock::now() - t0).count());
+		}
+		S.joins[reason]++;
+		r2memo::g_xform_reader2_busy = false;
+		r2memo::g_heap_writer_busy.store(false, std::memory_order_relaxed);
+	}
+
+	inline void join(uint32_t reason)
+	{
+		if (r2memo::g_heap_writer_busy.load(std::memory_order_relaxed)) [[unlikely]] join_slow(reason);
+	}
+
+	// rsx::thread: queue the fill of 'dst' (mapped ring memory) from REGS->transform_constants ('src').
+	// ids == nullptr selects the full copy (interpreter / indexed constants)
+	inline void kick(void* dst, const void* src, const uint16_t* ids, uint32_t count)
+	{
+		auto& S = g_s2;
+		if (!S.started)
+		{
+			S.started = true;
+			S.owner = std::this_thread::get_id();
+			if (const char* v = std::getenv("RSX_SPLIT2_SPIN_US"); v && *v) S.spin_us = static_cast<uint32_t>(std::strtoul(v, nullptr, 0));
+			r2memo::g_xform_reader2_join = [] { join_slow(j_xform); };
+			r2memo::g_heap_writer_join = [](int r) { join_slow(r == 0 ? j_unmap : j_submit); };
+			S.t0 = std::chrono::steady_clock::now();
+			std::thread(worker_main).detach(); // never joined: it may outlive the renderer at exit (as the r2aa lane)
+		}
+		const uint32_t h = S.local_head;
+		if (h - S.done.load(std::memory_order_acquire) >= ring_size) [[unlikely]]
+		{
+			const auto t0 = std::chrono::steady_clock::now();
+			while (h - S.done.load(std::memory_order_acquire) >= ring_size) cpu_pause();
+			S.full_stalls++;
+			S.full_ns += static_cast<uint64_t>(std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::steady_clock::now() - t0).count());
+		}
+		job& j = S.ring[h % ring_size];
+		j.dst = dst;
+		j.src = src;
+		j.ids = ids;
+		j.count = ids ? count : 0;
+		j.seq = h;
+		if (mode() == 2) j.expect = hash_source(j);
+		r2memo::g_xform_reader2_busy = true;
+		r2memo::g_heap_writer_busy.store(true, std::memory_order_relaxed);
+		S.jobs++;
+		S.bytes += job_bytes(j);
+		S.local_head = h + 1;
+		S.head.store(h + 1, std::memory_order_seq_cst);
+		if (S.sleeping.load(std::memory_order_seq_cst)) S.head.notify_one();
+	}
+
+	// rsx::thread, once per frame (VKGSRender::advance_queued_frames): the [split2] line every 5 s
+	inline void on_frame()
+	{
+		auto& S = g_s2;
+		if (!S.started) return;
+		S.frames++;
+		const auto now = std::chrono::steady_clock::now();
+		const double sec = std::chrono::duration<double>(now - S.t0).count();
+		if (sec < 5.0) return;
+		const double f = S.frames ? static_cast<double>(S.frames) : 1.0;
+		uint64_t joins = 0, stalls = 0, stall_ns = 0;
+		for (uint32_t r = 0; r < j_count; ++r)
+		{
+			joins += S.joins[r];
+			stalls += S.stalls[r];
+			stall_ns += S.stall_ns[r];
+		}
+		const uint64_t mism = S.mismatches.load(std::memory_order_relaxed);
+		std::fprintf(stderr,
+			"[split2] mode=%d fps=%.1f jobs/f=%.0f KB/f=%.1f moved=%.3f ms/f | joins/f=%.1f (unmap %.1f submit %.1f xform %.1f exit %.1f) "
+			"stalls/f=%.2f (%.0f us/f; submit %.2f/%.0fus xform %.2f/%.0fus) ring-full=%llu foreign=%llu | validated=%llu mismatches=%llu\n",
+			mode(), S.frames / sec, S.jobs / f, S.bytes / f / 1024.0, S.work_ns.exchange(0, std::memory_order_relaxed) / f / 1e6,
+			joins / f, S.joins[j_unmap] / f, S.joins[j_submit] / f, S.joins[j_xform] / f, S.joins[j_exit] / f,
+			stalls / f, stall_ns / f / 1e3, S.stalls[j_submit] / f, S.stall_ns[j_submit] / f / 1e3, S.stalls[j_xform] / f, S.stall_ns[j_xform] / f / 1e3,
+			static_cast<unsigned long long>(S.full_stalls), static_cast<unsigned long long>(S.foreign.exchange(0, std::memory_order_relaxed)), static_cast<unsigned long long>(S.validated.exchange(0, std::memory_order_relaxed)),
+			static_cast<unsigned long long>(mism));
+		if (mism != S.mism_seen) std::fprintf(stderr, "[split2] WARNING RSX_SPLIT2=2: %llu mismatching jobs so far\n", static_cast<unsigned long long>(mism));
+		S.mism_seen = mism;
+		S.jobs = S.bytes = S.frames = S.full_stalls = S.full_ns = 0;
+		for (uint32_t r = 0; r < j_count; ++r) S.joins[r] = S.stalls[r] = S.stall_ns[r] = 0;
+		S.t0 = now;
+	}
+}
