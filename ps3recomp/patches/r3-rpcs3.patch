+	// 1. Scene -> FSR/DLSS inputs
+	rt->read_barrier(cmd);
+	ds->read_barrier(cmd);
+	rt->push_layout(cmd, VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL);
+	ds->push_layout(cmd, VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL);
