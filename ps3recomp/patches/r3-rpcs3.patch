+				}
+				if (f.split) f.hud_frames++;
+				f.frames_on++;
+			}
+			else if (tok && f.opt_valid)
+			{
+				// DLSS-G guide: while depth / MVs are invalid (movies, loading, pause, menus) tag them as null so
+				// nothing stale from the last generated frame is reused. DLSS_FG_NULL_TAGS=1 (default 0 = old: no tags).
+				static const bool null_tags = penv_int("DLSS_FG_NULL_TAGS", 0) != 0;
+				if (null_tags)
+				{
+					sl::ResourceTag nt[2] = {
+						sl::ResourceTag(nullptr, sl::kBufferTypeDepth, sl::ResourceLifecycle::eValidUntilPresent),
+						sl::ResourceTag(nullptr, sl::kBufferTypeMotionVectors, sl::ResourceLifecycle::eValidUntilPresent) };
+					g_sl.fn_tag(*tok, sl::ViewportHandle(0u), nt, 2u, nullptr);
+				}
+			}
+		}
+
+		const bool diag = r2fgdiag::on();
+		const double diag_t0 = diag ? r2fgdiag::now_ms() : 0.0;
+		const VkResult res = g_sl.p_present(queue, info);
+		const double diag_call = diag ? r2fgdiag::now_ms() - diag_t0 : 0.0;
+
+		sl::DLSSGState gst{};
+		const bool have_gst = on && g_sl.fn_g_state(sl::ViewportHandle(0u), gst, nullptr) == sl::Result::eOk;
+		if (fg_usable())
+		{	// R3_FG_DIAG (and the always-on 10 s reset counters below)
+			r2fgdiag::present_in d{};
+			d.on = on; d.want = f.want_on; d.ready = f.ready; d.scene = f.scene; d.tok = tok != nullptr; d.immediate = f.sc_immediate;
+			d.resume = !f.prev_on; d.sc_new = f.sc_new; d.up_reset = f.reset; d.reset = diag_reset;
+			d.st_ok = have_gst; d.n = n; d.shown = have_gst ? gst.numFramesActuallyPresented : 0u; d.status = have_gst ? static_cast<u32>(gst.status) : 0u;
+			d.reflex_us = f.reflex_limit;
+			d.miss = (tok ? 0u : 1u) | (f.ready ? 0u : 2u) | (f.depth && f.mv ? 0u : 4u) | (f.debug_view || (f.have_ui && f.hudless && f.ui) ? 0u : 8u);
+			d.call_ms = diag_call;
+			d.reason = &f.reason;
+			r2fgdiag::present(d);
+		}
+		if (on)
+		{
+			const sl::DLSSGState& st = gst;
+			if (have_gst && st.status != sl::DLSSGStatus::eOk)
+			{
+				if (!f.bad_status_frames)
+				{
+					const u32 s = static_cast<u32>(st.status);
+					f.reason.clear();
+					set_reason(std::string("DLSS-G status 0x") + [&] { char b[16]; std::snprintf(b, sizeof(b), "%x", s); return std::string(b); }() +
+						((s & static_cast<u32>(sl::DLSSGStatus::eFailResolutionTooLow)) ? " (resolution too low)" : "") +
+						((s & static_cast<u32>(sl::DLSSGStatus::eFailReflexNotDetectedAtRuntime)) ? " (Reflex not detected)" : "") +
+						((s & static_cast<u32>(sl::DLSSGStatus::eFailHDRFormatNotSupported)) ? " (HDR format)" : "") +
+						((s & static_cast<u32>(sl::DLSSGStatus::eFailCommonConstantsInvalid)) ? " (constants invalid)" : ""));
+				}
+				f.bad_status_frames = 120;
+			}
+			if (fgcfg().debug && (f.frames_on % 600) == 1)
+				fglog("frame generation: %u frames on, HUD split on %u", f.frames_on, f.hud_frames);
+			// device-create time is too early for bIsVsyncSupportAvailable (logs said "no DLSS-G vsync support" on an
+			// RTX 5070 with a current driver): ask again once FG runs; if available, the next swapchain keeps the
+			// game's FIFO instead of the forced IMMEDIATE (tearing). R?_DLSS_FG_VSYNC_REQUERY=1 (default 0 = old: no re-query).
+			static const bool requery = [] { const char* e = penv("DLSS_FG_VSYNC_REQUERY"); return e && *e && *e != '0'; }();
+			if (requery && have_gst && f.sc_immediate && !g_sl.vsync_ok && f.frames_on == 120 &&
+				gst.bIsVsyncSupportAvailable == sl::Boolean::eTrue)
+			{
+				g_sl.vsync_ok = true;
+				fglog("DLSS-G vsync support is available after all: FIFO (vsync) is restored on the next swapchain (resize / Alt+Enter)");
+			}
+		}
+		{	// 10 s status line (always on while frame generation is wanted): is it on, and why not
+			static u64 t0 = 0;
+			static u32 rendered = 0, on_frames = 0;
+			static u64 shown = 0;
+			const u64 t = GetTickCount64();
+			if (!t0) t0 = t;
+			rendered++;
+			if (on)
+			{
+				on_frames++;
+				shown += have_gst && gst.numFramesActuallyPresented ? gst.numFramesActuallyPresented : n;
+			}
+			if (t - t0 >= 10000)
+			{
+				const double s = static_cast<double>(t - t0) / 1000.0;
+				if (f.want_on || on_frames)
+					fglog("DLSS-G %ux: on %.0f%% of frames | rendered %.1f fps -> presented %.1f fps | Reflex limit %s%s%s%s",
+						n, rendered ? 100.0 * on_frames / rendered : 0.0, rendered / s, static_cast<double>(shown + (rendered - on_frames)) / s,
+						f.reflex_limit == ~0u ? "none" : (std::to_string(f.reflex_limit) + " us").c_str(),
+						f.sc_immediate ? " | IMMEDIATE (no vsync)" : "",
+						f.reason.empty() ? "" : " | last pause: ", f.reason.c_str());
+				char rs[256];
+				if (r2fgdiag::summary10(rs, sizeof(rs))) fglog("%s", rs);
+				t0 = t; rendered = on_frames = 0; shown = 0;
+			}
+		}
+
+		{
+			std::lock_guard lk(f.mu);
+			sl_marker(sl::PCLMarker::ePresentEnd, tok);
+			f.present_id = f.cur_rid;
+			f.render_open = false;
+		}
+		g_r2fg_active = on ? static_cast<int>(n) : 0;
+		f.prev_on = on;
+		f.scene = f.ready = f.have_b0 = f.have_ui = f.reset = f.sc_new = false;
+		return res;
+	}
+
+#ifdef R2PORT_HAVE_FFX
+	// ---- FSR 3 frame interpolation: FidelityFX frame-generation swapchain + frame-generation context ----
+
+	FfxApiResource fx_res(vk::viewable_image* img, uint32_t state)
+	{
+		return ffxApiGetResourceVK(reinterpret_cast<void*>(img->value), ffxApiGetImageResourceDescriptionVK(img->value, img->info, 0), state);
+	}
+
+	// Called by the swapchain from vkQueuePresentKHR to record the interpolation pass
+	ffxReturnCode_t fx_fg_callback(ffxDispatchDescFrameGeneration* p, void*)
+	{
+		if (!g_fx.fg_ctx || !p) return FFX_API_RETURN_ERROR;
+		p->reset = p->reset || g_fx.pending_reset.load();
+		return g_fx.dispatch(&g_fx.fg_ctx, &p->header);
+	}
+
+	// caller holds fx_lock
+	void fx_wait_presents()
+	{
+		if (!g_fx.sc_ctx) return;
+		ffxDispatchDescFrameGenerationSwapChainWaitForPresentsVK w{};
+		w.header.type = FFX_API_DISPATCH_DESC_TYPE_FGSWAPCHAIN_WAIT_FOR_PRESENTS_VK;
+		g_fx.dispatch(&g_fx.sc_ctx, &w.header);
+	}
+
+	// caller holds fx_lock
+	void fx_destroy_fg()
+	{
+		auto& x = g_fx;
+		if (!x.fg_ctx) return;
+		if (x.sc_ctx)
+		{
+			ffxConfigureDescFrameGeneration c{};
+			c.header.type = FFX_API_CONFIGURE_DESC_TYPE_FRAMEGENERATION;
+			c.swapChain = reinterpret_cast<void*>(x.sc);
+			c.frameGenerationCallback = &fx_fg_callback;
+			c.frameGenerationEnabled = false;
+			c.frameID = x.frame_id;
+			x.configure(&x.fg_ctx, &c.header);
+			fx_wait_presents();
+		}
+		x.destroy(&x.fg_ctx, nullptr);
+		x.fg_ctx = nullptr;
+		std::memset(x.key, 0, sizeof(x.key));
+		x.max_rw = x.max_rh = 0;
+		x.prev_gen = false;
+		x.hold = 0;
+	}
+
+	// caller holds fx_lock; also destroys the replacement swapchain
+	void fx_teardown()
+	{
+		auto& x = g_fx;
+		fx_destroy_fg();
+		if (x.sc_ctx)
+		{
+			fx_wait_presents();
+			x.destroy(&x.sc_ctx, nullptr);
+			x.sc_ctx = nullptr;
+		}
+		x.sc = VK_NULL_HANDLE;
+		x.fns = {};
+		x.sc_ok = false;
+	}
+
+	std::vector<VkSwapchainKHR> g_fx_retired; // destroyed here already; RPCS3 destroys them as oldSwapchain right after
+
+	bool fx_take(std::vector<VkSwapchainKHR>& v, VkSwapchainKHR h)
+	{
+		const auto it = std::find(v.begin(), v.end(), h);
+		if (it == v.end()) return false;
+		v.erase(it);
+		return true;
+	}
+
+	VkResult VKAPI_CALL fx_create_swapchain(VkDevice dev, const VkSwapchainCreateInfoKHR* info, const VkAllocationCallbacks* alloc, VkSwapchainKHR* out)
+	{
+		auto& f = g_fg;
+		auto& x = g_fx;
+		VkSwapchainCreateInfoKHR ci = *info;
+		VkSurfaceCapabilitiesKHR caps{};
+		if (vkGetPhysicalDeviceSurfaceCapabilitiesKHR(x.pdev, ci.surface, &caps) == VK_SUCCESS && (caps.supportedUsageFlags & VK_IMAGE_USAGE_TRANSFER_SRC_BIT))
+			ci.imageUsage |= VK_IMAGE_USAGE_TRANSFER_SRC_BIT;
+
+		g_fx_retired.clear();
+		const VkSwapchainKHR old = ci.oldSwapchain;
+		bool old_real = old != VK_NULL_HANDLE && std::find(x.real_scs.begin(), x.real_scs.end(), old) != x.real_scs.end();
+		if (x.sc_ctx)
+		{
+			// the FSR 3 swapchain cannot be handed over as oldSwapchain: it is destroyed here, before the new one
+			fx_lock lk;
+			if (old != VK_NULL_HANDLE && old == x.sc) g_fx_retired.push_back(old);
+			fx_teardown();
+		}
+		if (!old_real) ci.oldSwapchain = VK_NULL_HANDLE;
+
+		VkResult r = VK_ERROR_INITIALIZATION_FAILED;
+		bool via_fx = false;
+		x.sc_why.clear();
+		if (!x.failed)
+		{
+			if (ffxApiGetSurfaceFormatVK(ci.imageFormat) == FFX_API_SURFACE_FORMAT_UNKNOWN)
+				x.sc_why = "FSR 3 does not support swapchain format " + std::to_string(static_cast<int>(ci.imageFormat));
+			else
+			{
+				if (old_real)
+				{
+					x.real_destroy(dev, old, alloc);
+					fx_take(x.real_scs, old);
+					g_fx_retired.push_back(old);
+					old_real = false;
+				}
+				VkSwapchainCreateInfoKHR fci = ci;
+				fci.oldSwapchain = VK_NULL_HANDLE;
+				VkSwapchainKHR s = VK_NULL_HANDLE;
+				ffxCreateContextDescFrameGenerationSwapChainVK d{};
+				d.header.type = FFX_API_CREATE_CONTEXT_DESC_TYPE_FGSWAPCHAIN_VK;
+				d.physicalDevice = x.pdev;
+				d.device = dev;
+				d.swapchain = &s;
+				d.allocator = nullptr;
+				d.createInfo = fci;
+				d.gameQueue = { x.game_q, x.gfam, &fx_game_submit };
+				d.asyncComputeQueue = { VK_NULL_HANDLE, 0, nullptr };
+				d.presentQueue = { x.present_q, x.pfam, nullptr };
+				d.imageAcquireQueue = { x.acquire_q, x.afam, nullptr };
+				fx_lock lk;
+				const ffxReturnCode_t rc = [&] { const r2preload::stage_scope r2_stage("rt:ffx_fg_swapchain"); return x.create(&x.sc_ctx, &d.header, nullptr); }(); // R2PORT: issue #10/#23
+				ffxQueryDescSwapchainReplacementFunctionsVK q{};
+				q.header.type = FFX_API_QUERY_DESC_TYPE_FGSWAPCHAIN_FUNCTIONS_VK;
+				const bool ok = rc == FFX_API_RETURN_OK && s != VK_NULL_HANDLE && x.query(&x.sc_ctx, &q.header) == FFX_API_RETURN_OK &&
+					q.pOutGetSwapchainImagesKHR && q.pOutAcquireNextImageKHR && q.pOutQueuePresentKHR;
+				if (ok)
+				{
+					x.sc = s;
+					x.fns = q;
+					x.sc_ok = true;
+					via_fx = true;
+					*out = s;
+					r = VK_SUCCESS;
+				}
+				else
+				{
+					if (x.sc_ctx) x.destroy(&x.sc_ctx, nullptr);
+					x.sc_ctx = nullptr;
+					x.failed = true;
+					fglog("frame generation off: the FSR 3 frame-generation swapchain failed (code %d)", static_cast<int>(rc));
+				}
+			}
+		}
+		if (!via_fx)
+		{
+			r = x.real_create(dev, &ci, alloc, out);
+			if (r != VK_SUCCESS && ci.imageUsage != info->imageUsage)
+			{
+				ci.imageUsage = info->imageUsage;
+				r = x.real_create(dev, &ci, alloc, out);
+			}
+			if (r != VK_SUCCESS) return r;
+			x.real_scs.push_back(*out);
+		}
+
+		f.sc_immediate = false;
+		f.sc_fifo = ci.presentMode == VK_PRESENT_MODE_FIFO_KHR || ci.presentMode == VK_PRESENT_MODE_FIFO_RELAXED_KHR;
+		f.sc_transfer = (ci.imageUsage & VK_IMAGE_USAGE_TRANSFER_SRC_BIT) != 0;
+		f.sc_format = ci.imageFormat;
+		f.sc_extent = ci.imageExtent;
+		u32 count = 0;
+		if (via_fx) x.fns.pOutGetSwapchainImagesKHR(dev, *out, &count, nullptr);
+		else x.real_images(dev, *out, &count, nullptr);
+		f.sc_images = count ? count : ci.minImageCount;
+		f.refresh_hz = monitor_hz();
+		f.sc_new = true;
+		if (!f.sc_transfer) fglog("frame generation: the swapchain cannot be copied from, HUD split off");
+		return r;
+	}
+
+	void VKAPI_CALL fx_destroy_swapchain(VkDevice dev, VkSwapchainKHR sc, const VkAllocationCallbacks* alloc)
+	{
+		auto& x = g_fx;
+		g_fg.sc_new = true;
+		if (sc == VK_NULL_HANDLE || fx_take(g_fx_retired, sc)) return;
+		if (sc == x.sc)
+		{
+			fx_lock lk;
+			fx_teardown();
+			return;
+		}
+		if (fx_take(x.real_scs, sc)) x.real_destroy(dev, sc, alloc);
+	}
+
+	VkResult VKAPI_CALL fx_sc_images(VkDevice dev, VkSwapchainKHR sc, uint32_t* n, VkImage* images)
+	{
+		if (sc != VK_NULL_HANDLE && sc == g_fx.sc) return g_fx.fns.pOutGetSwapchainImagesKHR(dev, sc, n, images);
+		return g_fx.real_images(dev, sc, n, images);
+	}
+
+	VkResult VKAPI_CALL fx_acquire(VkDevice dev, VkSwapchainKHR sc, uint64_t timeout, VkSemaphore sem, VkFence fence, uint32_t* index)
+	{
+		if (sc != VK_NULL_HANDLE && sc == g_fx.sc) return g_fx.fns.pOutAcquireNextImageKHR(dev, sc, timeout, sem, fence, index);
+		return g_fx.real_acquire(dev, sc, timeout, sem, fence, index);
+	}
+
+	// Phase 1 tail (after the HUD split): FG context, HUD-less back buffer and the prepare pass for this frame
+	void fx_present_tail(vk::command_buffer& cmd, VkImage target, VkImageLayout layout)
+	{
+		auto& f = g_fg;
+		auto& x = g_fx;
+		x.gen = x.on = x.frame_reset = false;
+		if (!x.sc_ctx || !x.sc_ok) return;
+		const bool on = f.want_on && f.scene && f.depth && f.mv && (f.debug_view || (f.have_ui && f.hudless && f.ui));
+		// a short hold keeps generation enabled (as reset frames) so that brief interruptions do not toggle it: every
+		// enable / disable waits for the presenter
+		const bool gen = pfg_fx_hold_step(&x.hold, on, x.prev_gen, f.depth && f.mv && f.rw && f.rh) != 0;
+		if (!gen || !target) return;
+
+		const u32 W = f.sc_extent.width, H = f.sc_extent.height;
+		const bool hdr10 = is_10bit(f.sc_format);
+		const u32 key[6] = { W, H, static_cast<u32>(f.sc_format), f.inverted ? 1u : 0u, hdr10 ? 1u : 0u, 1u };
+		if (x.fg_ctx && (std::memcmp(key, x.key, sizeof(key)) != 0 || f.rw > x.max_rw || f.rh > x.max_rh))
+		{
+			fx_lock lk;
+			fx_destroy_fg();
+		}
+		if (!x.fg_ctx)
+		{
+			x.max_rw = std::max(W, f.rw);
+			x.max_rh = std::max(H, f.rh);
+			ffxCreateBackendVKDesc be{};
+			be.header.type = FFX_API_CREATE_CONTEXT_DESC_TYPE_BACKEND_VK;
+			be.vkDevice = x.device;
+			be.vkPhysicalDevice = x.pdev;
+			be.vkDeviceProcAddr = vkGetDeviceProcAddr;
+			ffxCreateContextDescFrameGeneration cd{};
+			cd.header.type = FFX_API_CREATE_CONTEXT_DESC_TYPE_FRAMEGENERATION;
+			cd.header.pNext = &be.header;
+			cd.flags = (f.inverted ? FFX_FRAMEGENERATION_ENABLE_DEPTH_INVERTED : 0u) | (hdr10 ? FFX_FRAMEGENERATION_ENABLE_HIGH_DYNAMIC_RANGE : 0u);
+			cd.displaySize = { W, H };
+			cd.maxRenderSize = { x.max_rw, x.max_rh };
+			cd.backBufferFormat = ffxApiGetSurfaceFormatVK(f.sc_format);
+			ffxReturnCode_t rc;
+			{
+				fx_lock lk;
+				rc = [&] { const r2preload::stage_scope r2_stage("rt:ffx_fg_ctx"); return x.create(&x.fg_ctx, &cd.header, nullptr); }(); // R2PORT: issue #10/#23
+			}
+			if (rc != FFX_API_RETURN_OK || !x.fg_ctx)
+			{
+				x.fg_ctx = nullptr;
+				f.reason.clear();
+				set_reason("the FSR 3 frame-generation context failed (code " + std::to_string(static_cast<int>(rc)) + ")");
+				f.bad_status_frames = 600;
+				return;
+			}
+			std::memcpy(x.key, key, sizeof(key));
+		}
+
+		if (vk::is_renderpass_open(cmd)) vk::end_renderpass(cmd);
+		if (on && !f.debug_view)
+		{
+			// the swapchain composites the UI layer onto both the real and the generated frame: present the HUD-less scene
+			f.hudless->change_layout(cmd, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL);
+			vk::change_image_layout(cmd, target, layout, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, k_color_range);
+			VkImageBlit blit{};
+			blit.srcSubresource = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1 };
+			blit.dstSubresource = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1 };
+			blit.srcOffsets[1] = { static_cast<s32>(W), static_cast<s32>(H), 1 };
+			blit.dstOffsets[1] = { static_cast<s32>(W), static_cast<s32>(H), 1 };
+			vkCmdBlitImage(cmd, f.hudless->value, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, target, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, 1, &blit, VK_FILTER_NEAREST);
+			vk::change_image_layout(cmd, target, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, layout, k_color_range);
+			f.hudless->change_layout(cmd, VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL);
+		}
+		f.depth->change_layout(cmd, VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL);
+		f.mv->change_layout(cmd, VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL);
+
+		const auto now = std::chrono::steady_clock::now();
+		float dt = 1000.f / 30.f;
+		if (x.last_prep.time_since_epoch().count())
+			dt = std::clamp(std::chrono::duration<float, std::milli>(now - x.last_prep).count(), 1.f, 200.f);
+		x.last_prep = now;
+
+		ffxDispatchDescFrameGenerationPrepareCameraInfo cam{};
+		cam.header.type = FFX_API_DISPATCH_DESC_TYPE_FRAMEGENERATION_PREPARE_CAMERAINFO;
+		cam.cameraUp[1] = 1.f;
+		cam.cameraRight[0] = 1.f;
+		cam.cameraForward[2] = 1.f;
+		ffxDispatchDescFrameGenerationPrepare p{};
+		p.header.type = FFX_API_DISPATCH_DESC_TYPE_FRAMEGENERATION_PREPARE;
+		p.header.pNext = &cam.header;
+		p.frameID = x.frame_id + 1;
+		p.flags = 0;
+		p.commandList = static_cast<VkCommandBuffer>(cmd);
+		p.renderSize = { f.rw, f.rh };
+		p.jitterOffset = { f.jx, f.jy };
+		p.motionVectorScale = { f.mvsx * static_cast<float>(f.rw), f.mvsy * static_cast<float>(f.rh) };
+		p.frameTimeDelta = dt;
+		vk::r2aa_camera(p.cameraNear, p.cameraFar, p.cameraFovAngleVertical);
+		p.viewSpaceToMetersFactor = 1.f;
+		p.depth = fx_res(f.depth.get(), FFX_API_RESOURCE_STATE_COMPUTE_READ);
+		p.motionVectors = fx_res(f.mv.get(), FFX_API_RESOURCE_STATE_COMPUTE_READ);
+		const ffxReturnCode_t rc = x.dispatch(&x.fg_ctx, &p.header);
+		cmd.r2_invalidate_state_cache();
+		if (rc != FFX_API_RETURN_OK)
+		{
+			f.reason.clear();
+			set_reason("FSR 3 rejected this frame's inputs (code " + std::to_string(static_cast<int>(rc)) + ")");
+			f.bad_status_frames = 120;
+			return;
+		}
+		x.gen = true;
+		x.on = on;
+		x.frame_reset = pfg_fx_reset(x.prev_gen, f.sc_new, f.reset, on) != 0;
+	}
+
+	VkResult VKAPI_CALL fx_queue_present(VkQueue queue, const VkPresentInfoKHR* info)
+	{
+		auto& f = g_fg;
+		auto& x = g_fx;
+		bool mine = false;
+		for (u32 i = 0; i < info->swapchainCount; ++i)
+			if (x.sc != VK_NULL_HANDLE && info->pSwapchains[i] == x.sc) mine = true;
+		if (!mine)
+		{
+			const VkResult r = x.real_present(queue, info);
+			g_r2fg_active = 0;
+			f.prev_on = false;
+			f.scene = f.ready = f.have_b0 = f.have_ui = f.reset = f.sc_new = false;
+			return r;
+		}
+
+		const bool gen = x.gen && f.ready && x.fg_ctx;
+		const double step_s = gen ? pfg_fx_step_s(fgcfg().cap, fgcfg().pace, f.refresh_hz, f.sc_fifo) : 0.0;
+		if (step_s > 0.0)
+		{
+			// rendered frames x2 must stay under the refresh rate (VRR range); the game's own cap applies on top.
+			// PORT_FG_PACE=auto leaves a FIFO (vsync) swapchain to the presenter, so a 60 cap at 120 Hz gives 120.
+			const auto step = std::chrono::duration_cast<std::chrono::steady_clock::duration>(std::chrono::duration<double>(step_s));
+			auto now = std::chrono::steady_clock::now();
+			if (x.next_present > now)
+			{
+				if (x.next_present - now > std::chrono::milliseconds(2)) std::this_thread::sleep_for(x.next_present - now - std::chrono::milliseconds(1));
+				while (std::chrono::steady_clock::now() < x.next_present) std::this_thread::yield();
+				now = x.next_present;
+			}
+			x.next_present = std::chrono::steady_clock::time_point(std::chrono::steady_clock::duration(
+				pfg_pace_next(now.time_since_epoch().count(), x.next_present.time_since_epoch().count(), step.count())));
+		}
+
+		if (x.fg_ctx)
+		{
+			fx_lock lk;
+			ffxConfigureDescFrameGeneration c{};
+			c.header.type = FFX_API_CONFIGURE_DESC_TYPE_FRAMEGENERATION;
+			c.swapChain = reinterpret_cast<void*>(x.sc);
+			c.presentCallback = nullptr;
+			c.frameGenerationCallback = &fx_fg_callback;
+			c.frameGenerationEnabled = gen;
+			c.allowAsyncWorkloads = false;
+			c.flags = fgcfg().debug_level >= 2 ? (FFX_FRAMEGENERATION_FLAG_DRAW_DEBUG_TEAR_LINES | FFX_FRAMEGENERATION_FLAG_DRAW_DEBUG_RESET_INDICATORS) : 0u;
+			c.onlyPresentGenerated = false;
+			if (gen && f.rwid > 0 && f.rhei > 0) c.generationRect = { f.rx, f.ry, f.rwid, f.rhei };
+			else c.generationRect = { 0, 0, static_cast<int32_t>(f.sc_extent.width), static_cast<int32_t>(f.sc_extent.height) };
+			c.frameID = ++x.frame_id;
+			ffxReturnCode_t rc = x.configure(&x.fg_ctx, &c.header);
+
+			ffxConfigureDescFrameGenerationSwapChainRegisterUiResourceVK u{};
+			u.header.type = FFX_API_CONFIGURE_DESC_TYPE_FGSWAPCHAIN_REGISTERUIRESOURCE_VK;
+			if (gen && x.on && !f.debug_view && f.have_ui && f.ui)
+			{
+				u.uiResource = fx_res(f.ui.get(), FFX_API_RESOURCE_STATE_PIXEL_COMPUTE_READ);
+				u.flags = FFX_FRAMEGENERATION_UI_COMPOSITION_FLAG_USE_PREMUL_ALPHA | FFX_FRAMEGENERATION_UI_COMPOSITION_FLAG_ENABLE_INTERNAL_UI_DOUBLE_BUFFERING;
+			}
+			if (rc == FFX_API_RETURN_OK) rc = x.configure(&x.sc_ctx, &u.header);
+			if (rc != FFX_API_RETURN_OK && !f.bad_status_frames)
+			{
+				f.reason.clear();
+				set_reason("FSR 3 frame generation configuration failed (code " + std::to_string(static_cast<int>(rc)) + ")");
+				f.bad_status_frames = 120;
+			}
+		}
+		x.pending_reset = x.frame_reset || !gen;
+
+		const VkResult res = x.fns.pOutQueuePresentKHR(queue, info);
+		if (res < 0)
+		{
+			fx_lock lk;
+			fx_wait_presents();
+		}
+
+		if (gen && x.on)
+		{
+			if (f.split) f.hud_frames++;
+			f.frames_on++;
+			if (fgcfg().debug && (f.frames_on % 600) == 1)
+				fglog("frame generation (FSR 3): %u frames on, HUD split on %u", f.frames_on, f.hud_frames);
+		}
+		g_r2fg_active = gen && x.on ? 2 : 0;
+		x.prev_gen = gen;
+		x.gen = x.on = x.frame_reset = false;
+		f.prev_on = gen && x.on;
+		f.scene = f.ready = f.have_b0 = f.have_ui = f.reset = f.sc_new = false;
+		return res;
+	}
+#endif
+}
+
+namespace vk
+{
+	void r2fg_present(int phase, vk::command_buffer& cmd, VkImage target, VkImageLayout layout, vk::viewable_image* src,
+		u32 buffer_w, u32 buffer_h, s32 x1, s32 y1, s32 x2, s32 y2)
+	{
+		r2fg_present_body(phase, cmd, target, layout, src, buffer_w, buffer_h, x1, y1, x2, y2);
+#ifdef R2PORT_HAVE_FFX
+		if (phase == 1 && fx_usable()) fx_present_tail(cmd, target, layout);
+#endif
+	}
+
+	// Photo-mode HUD hide (R3_PHOTO_HIDE_HUD=1): every game flip notes whether this frame's HUD-less snapshot (the display
+	// buffer right before its first HUD draw, r2fg_on_draw) is good; while photo mode is on (game paused, the last image
+	// presented again) the snapshot is presented instead. No good snapshot (no HUD, unsure frame): the HUD stays.
+	vk::viewable_image* r2fg_photo_source(vk::viewable_image* src, bool game_flip)
+	{
+		auto& f = g_fg;
+		const int mode = g_port_photo_hud;
+		if (!mode || !src) return src;
+		if (game_flip)
+		{
+			f.photo_ok = f.photo_snap && f.hud && f.hud_rt == src && !f.unsure && f.hud_draws &&
+				f.hud->info.format == src->info.format && f.hud->width() == src->width() && f.hud->height() == src->height();
+			f.photo_src = src;
+			f.photo_snap = false;
+		}
+		const bool use = mode == 2 && f.photo_ok && f.photo_src == src && f.hud;
+		if (mode != f.photo_was)
+		{
+			if (mode == 2) fglog("photo mode: %s", use ? "HUD hidden (last frame before its HUD)" : "no HUD-free image of the last frame, the HUD stays");
+			f.photo_was = mode;
+		}
+		return use ? static_cast<vk::viewable_image*>(f.hud.get()) : src;
+	}
+
+	bool r2fg_set_hdr_metadata(VkDevice device, VkSwapchainKHR swapchain, const VkHdrMetadataEXT* md)
+	{
+#ifdef R2PORT_HAVE_FFX
+		if (swapchain != VK_NULL_HANDLE && swapchain == g_fx.sc && g_fx.fns.pOutSetHdrMetadataEXT)
+		{
+			g_fx.fns.pOutSetHdrMetadataEXT(device, 1, &swapchain, md);
+			return true;
+		}
+#endif
+		return false;
+	}
+
+	void r2fg_swapchain_procs(VkDevice device, PFN_vkCreateSwapchainKHR& create, PFN_vkDestroySwapchainKHR& destroy,
+		PFN_vkGetSwapchainImagesKHR& images, PFN_vkAcquireNextImageKHR& acquire, PFN_vkQueuePresentKHR& present)
+	{
+#ifdef R2PORT_HAVE_FFX
+		if (fx_usable() && device == g_fx.device)
+		{
+			g_fx.real_create = create;
+			g_fx.real_destroy = destroy;
+			g_fx.real_images = images;
+			g_fx.real_acquire = acquire;
+			g_fx.real_present = present;
+			if (!create || !destroy || !images || !acquire || !present) return;
+			create = &fx_create_swapchain;
+			destroy = &fx_destroy_swapchain;
+			images = &fx_sc_images;
+			acquire = &fx_acquire;
+			present = &fx_queue_present;
+			return;
+		}
+#endif
+		if (!sl_device() || device != g_sl.device) return;
+		g_sl.p_create_sc = reinterpret_cast<PFN_vkCreateSwapchainKHR>(g_sl.gdpa(device, "vkCreateSwapchainKHR"));
+		g_sl.p_destroy_sc = reinterpret_cast<PFN_vkDestroySwapchainKHR>(g_sl.gdpa(device, "vkDestroySwapchainKHR"));
+		g_sl.p_sc_images = reinterpret_cast<PFN_vkGetSwapchainImagesKHR>(g_sl.gdpa(device, "vkGetSwapchainImagesKHR"));
+		g_sl.p_acquire = reinterpret_cast<PFN_vkAcquireNextImageKHR>(g_sl.gdpa(device, "vkAcquireNextImageKHR"));
+		g_sl.p_present = reinterpret_cast<PFN_vkQueuePresentKHR>(g_sl.gdpa(device, "vkQueuePresentKHR"));
+		if (!g_sl.p_create_sc || !g_sl.p_destroy_sc || !g_sl.p_sc_images || !g_sl.p_acquire || !g_sl.p_present)
+		{
+			fglog("frame generation off: Streamline swapchain proxies missing");
+			g_sl.fg_supported = false;
+			return;
+		}
+		create = &fg_create_swapchain;
+		destroy = &fg_destroy_swapchain;
+		images = g_sl.p_sc_images;
+		acquire = g_sl.p_acquire;
+		present = &fg_queue_present;
+	}
+
+	void r2fg_device_destroyed(VkDevice device)
+	{
+#ifdef R2PORT_HAVE_FFX
+		if (device != VK_NULL_HANDLE && device == g_fx.device)
+		{
+			{
+				fx_lock lk;
+				fx_teardown();
+				vkDeviceWaitIdle(device);
+			}
+			fg_release_images();
+			g_r2fg_active = 0;
+			g_fx.real_scs.clear();
+			g_fx_retired.clear();
+			g_fx.device = VK_NULL_HANDLE;
+			return;
+		}
+#endif
+		if (device == VK_NULL_HANDLE || device != g_sl.device) return;
+		if (g_sl.p_wait_idle) g_sl.p_wait_idle(device);
+		fg_release_images();
+		g_r2fg_active = 0;
+		g_sl.device = VK_NULL_HANDLE;
+		g_sl.fg_supported = false;
+		g_sl.reflex = false;
+		g_fg.opt_valid = false;
+		g_fg.reflex_limit = ~0u;
+		if (g_sl.inited) g_sl.fn_shutdown();
+		g_sl.inited = false;
+	}
+
+	// Streamline Reflex (DLSS-G), or FSR 3 frame generation (its swapchain does not support VK_NV_low_latency2)
+	bool r2fg_owns_reflex()
+	{
+#ifdef R2PORT_HAVE_FFX
+		if (g_fx.selected && !g_fx.failed) return true;
+#endif
+		return g_sl.inited;
+	}
+}
+
+// Once per game frame from the game's frame limiter: Reflex sleep plus the simulation markers
+extern "C" int r2fg_game_frame(void)
+{
+	if (!sl_device() || !g_sl.reflex) return 0;
+	auto& f = g_fg;
+	u32 id;
+	{
+		std::lock_guard lk(f.mu);
+		sl::FrameToken* tok = nullptr;
+		if (f.sim_open && g_sl.fn_token(tok, &f.sim_id) == sl::Result::eOk && tok) sl_marker(sl::PCLMarker::eSimulationEnd, tok);
+		f.sim_open = false;
+		f.sim_id = std::max(f.sim_id + 1, f.present_id + 1);
+		id = f.sim_id;
+	}
+	sl::FrameToken* tok = nullptr;
+	if (g_sl.fn_token(tok, &id) == sl::Result::eOk && tok)
+	{
+		const double t0 = r2fgdiag::on() ? r2fgdiag::now_ms() : 0.0;
+		g_sl.fn_r_sleep(*tok);
+		if (r2fgdiag::on()) r2fgdiag::note_sleep(r2fgdiag::now_ms() - t0);
+	}
+	{
+		std::lock_guard lk(f.mu);
+		tok = nullptr;
+		if (g_sl.fn_token(tok, &id) == sl::Result::eOk && tok) sl_marker(sl::PCLMarker::eSimulationStart, tok);
+		f.sim_open = true;
+	}
+	g_pc_reflex_active = 1;
+	return 1;
+}
+
+#else // no Streamline: plain Vulkan, frame generation unavailable
+
+namespace vk
+{
+	VkResult r2fg_create_instance(const VkInstanceCreateInfo& info, VkInstance* instance, bool fast)
+	{
+		static bool logged = false;
+		if (!fast && !logged && fgcfg().want)
+		{
+			logged = true;
+			std::fprintf(stderr, "[fg-vk] frame generation off: this build has no Streamline SDK\n");
+		}
+		return vkCreateInstance(&info, nullptr, instance);
+	}
+	void r2fg_destroy_surface(VkInstance instance, VkSurfaceKHR surface) { vkDestroySurfaceKHR(instance, surface, nullptr); }
+#ifdef _WIN32
+	VkResult r2fg_create_win32_surface(VkInstance instance, const VkWin32SurfaceCreateInfoKHR* info, VkSurfaceKHR* surface)
+	{
+		return vkCreateWin32SurfaceKHR(instance, info, nullptr, surface);
+	}
+#endif
+	VkResult r2fg_create_device(VkPhysicalDevice pdev, const VkDeviceCreateInfo* info, VkDevice* device)
+	{
+		return vkCreateDevice(pdev, info, nullptr, device);
+	}
+	void r2fg_device_destroyed(VkDevice) {}
+	void r2fg_swapchain_procs(VkDevice, PFN_vkCreateSwapchainKHR&, PFN_vkDestroySwapchainKHR&, PFN_vkGetSwapchainImagesKHR&,
+		PFN_vkAcquireNextImageKHR&, PFN_vkQueuePresentKHR&) {}
+	bool r2fg_owns_reflex() { return false; }
+	void r2fg_tag_scene(vk::command_buffer&, vk::viewable_image*, vk::viewable_image*, u32, u32, float, float, float, float, bool, bool,
+		const double*, float, float) {}
+	void r2fg_present(int, vk::command_buffer&, VkImage, VkImageLayout, vk::viewable_image*, u32, u32, s32, s32, s32, s32) {}
+	vk::viewable_image* r2fg_photo_source(vk::viewable_image* src, bool) { return src; }
+	bool r2fg_set_hdr_metadata(VkDevice, VkSwapchainKHR, const VkHdrMetadataEXT*) { return false; }
+}
+
+void VKGSRender::r2fg_on_draw() {}
+
+extern "C" int r2fg_game_frame(void) { return 0; }
+
+#endif
+
+#ifdef _WIN32
+// R2PORT: PORT_MMCSS_RENDER=1 (default off, an A/B switch): rsx::thread (RSXThread.cpp on_task) registers with the
+// MMCSS "Games" task so the scheduler favours it; it is the port's busiest thread. Kept for the thread's lifetime.
+extern "C" void r2_mmcss_render_thread(void)
+{
+	const char* e = std::getenv("PORT_MMCSS_RENDER");
+	if (!e || std::atoi(e) <= 0) return;
+	const HMODULE av = LoadLibraryW(L"avrt.dll");
+	using set_fn = HANDLE(WINAPI*)(LPCWSTR, LPDWORD);
+	const auto set = av ? reinterpret_cast<set_fn>(reinterpret_cast<void*>(GetProcAddress(av, "AvSetMmThreadCharacteristicsW"))) : nullptr;
+	DWORD idx = 0;
+	const HANDLE h = set ? set(L"Games", &idx) : nullptr;
+	std::fprintf(stderr, "[rsx] MMCSS \"Games\" on rsx::thread: %s (PORT_MMCSS_RENDER)\n", h ? "on" : "failed");
+}
+#endif
diff --git a/rpcs3/Emu/RSX/VK/VKR2FrameGen.h b/rpcs3/Emu/RSX/VK/VKR2FrameGen.h
new file mode 100644
index 0000000..1c8fd36
--- /dev/null
+++ b/rpcs3/Emu/RSX/VK/VKR2FrameGen.h
@@ -0,0 +1,72 @@
+// R2PORT: Resistance 2/3 port addition (not upstream RPCS3).
+// Frame generation: NVIDIA DLSS Frame Generation (2x, 3x/4x Multi Frame Generation) through Streamline
+// (sl.interposer.dll and its plugins), or AMD FSR 3 frame interpolation (2x, amd_fidelityfx_vk.dll) for GPUs
+// without DLSS-G; both loaded at run time from the exe folder. Off unless R2_DLSS_FG (or R3_/R1_) is 2, 3, 4 or
+// fsr3; R2_FG_BACKEND=auto|dlss|fsr3 picks the backend (auto: DLSS-G, else FSR 3).
+// Everything here is inert, and every hook is a plain pass-through, when it is off or unavailable.
+// Design notes, switches and the in-game checklist: scratch/framegen_vk.md.
+#pragma once
+
+#include "VulkanAPI.h"
+
+namespace vk
+{
+	class command_buffer;
+	class viewable_image;
+
+	// instance.cpp: replaces vkCreateInstance. For the main (non-'fast') instance, when frame generation is
+	// requested and the GPU and DLLs qualify, Streamline is initialised first and its proxy creates the instance.
+	VkResult r2fg_create_instance(const VkInstanceCreateInfo& info, VkInstance* instance, bool fast);
+	// instance.cpp: replaces vkDestroySurfaceKHR
+	void r2fg_destroy_surface(VkInstance instance, VkSurfaceKHR surface);
+#ifdef _WIN32
+	// swapchain_win32.hpp: replaces vkCreateWin32SurfaceKHR
+	VkResult r2fg_create_win32_surface(VkInstance instance, const VkWin32SurfaceCreateInfoKHR* info, VkSurfaceKHR* surface);
+#endif
+	// device.cpp: replaces vkCreateDevice (FSR 3: adds a present and an image-acquire queue, timeline semaphores)
+	VkResult r2fg_create_device(VkPhysicalDevice pdev, const VkDeviceCreateInfo* info, VkDevice* device);
+	// device.cpp, right before vkDestroyDevice: waits for Streamline / FSR 3 and shuts it down
+	void r2fg_device_destroyed(VkDevice device);
+	// swapchain.cpp, after the swapchain entry points are fetched: routes them through Streamline or the FSR 3
+	// frame-generation swapchain
+	void r2fg_swapchain_procs(VkDevice device, PFN_vkCreateSwapchainKHR& create, PFN_vkDestroySwapchainKHR& destroy,
+		PFN_vkGetSwapchainImagesKHR& images, PFN_vkAcquireNextImageKHR& acquire, PFN_vkQueuePresentKHR& present);
+	// VKR2PcExtras.cpp: true when frame generation owns Reflex (the VK_NV_low_latency2 path then stays off)
+	bool r2fg_owns_reflex();
+	// VKR2PcExtras.cpp: HDR metadata for an FSR 3 swapchain goes through its replacement entry point (true = done)
+	bool r2fg_set_hdr_metadata(VkDevice device, VkSwapchainKHR swapchain, const VkHdrMetadataEXT* metadata);
+
+	// VKR2Upscaler.cpp, after a DLSS/DLAA evaluation: the frame's render-resolution depth (R32F) and motion
+	// vectors (RG16F, (prev - cur) uv * 0.5 in the upscaler's convention, scaled by mv_w/mv_h to pixels), both in
+	// SHADER_READ_ONLY layout, used region rw x rh; jitter in pixels; T = current -> previous clip transform
+	// (column vectors, the upscaler's y-down NDC, depth d * zA + zB).
+	void r2fg_tag_scene(vk::command_buffer& cmd, vk::viewable_image* depth, vk::viewable_image* mv, u32 rw, u32 rh,
+		float jx, float jy, float mv_w, float mv_h, bool inverted, bool reset, const double* T, float zA, float zB);
+	// VKR2Upscaler.cpp: a camera cut the upscaler keeps its history through (PFG_CUT_UNTRUSTED / PFG_CUT_HELD):
+	// true when frame generation should reset on it anyway (R2_DLSS_FG_CUT_RESET, default 1 = untrusted ones)
+	bool r2fg_cut_reset(int kind);
+	// VKR2Upscaler.cpp, for R2_FG_DIAG / R3_FG_DIAG (VKR2FgDiag.h): the values of a held camera cut, and once per
+	// frame-generation-tagged frame the upscaler's reset (reset_why bits), held cut kind and whether FG reset on it
+	void r2fg_diag_cut(double motion, double parallax, u32 members, u32 matched);
+	void r2fg_diag_upscaler(bool upscaler_reset, u32 why, int cut_kind, bool cut_reset);
+
+	// VKPresent.cpp present_frame. phase 0: after the game image is on the swapchain image, before RPCS3/port
+	// overlays; phase 1: after the overlays, before the transition to the present layout. 'src' is the flipped
+	// display buffer (buffer_w x buffer_h used), drawn into the rectangle (x1, y1) - (x2, y2).
+	void r2fg_present(int phase, vk::command_buffer& cmd, VkImage target, VkImageLayout layout, vk::viewable_image* src,
+		u32 buffer_w, u32 buffer_h, s32 x1, s32 y1, s32 x2, s32 y2);
+
+	// VKPresent.cpp present_frame, after the display buffer is found: photo-mode HUD hide (R2_PHOTO_HIDE_HUD /
+	// R3_PHOTO_HIDE_HUD). Returns the image to present instead of 'src' (the last game frame before its HUD) while
+	// photo mode is on, else 'src'. game_flip: a flip by the game (info.emu_flip), not a re-present.
+	vk::viewable_image* r2fg_photo_source(vk::viewable_image* src, bool game_flip);
+}
+
+extern "C"
+{
+	// VKR2PcExtras.cpp r2pc_reflex_sleep (the game's frame start): Reflex sleep and latency markers through
+	// Streamline. Returns 1 when Streamline handled it.
+	int r2fg_game_frame(void);
+	// Live state for the PC menu / OSD: 0 off, else the frame multiplier in use (2/3/4)
+	extern volatile int g_r2fg_active;
+}
diff --git a/rpcs3/Emu/RSX/VK/VKR2FrameGenLogic.h b/rpcs3/Emu/RSX/VK/VKR2FrameGenLogic.h
new file mode 100644
index 0000000..fc62095
--- /dev/null
+++ b/rpcs3/Emu/RSX/VK/VKR2FrameGenLogic.h
@@ -0,0 +1,186 @@
+/* R2PORT: Resistance 1/2/3 port addition (not upstream RPCS3).
+ * Frame generation decisions without any graphics API: the PORT_FG / PORT_FG_HUDLESS / PORT_FG_PACE selectors,
+ * the FSR 3 present pacer, the Reflex frame cap, the FSR 3 enable hold and the per-frame on/off gate.
+ * C99 and C++; byte-identical copies:
+ *   R2/R3  ps3recomp/third_party/rpcs3/rpcs3/Emu/RSX/VK/VKR2FrameGenLogic.h (used by VKR2FrameGen.cpp)
+ *   R1     ps3recomp/libs/video/port_fg_logic.h (used by rsx_dlssg.inc)
+ * Unit test: project/tests/fg_logic_test.cpp. Design: scratch/framegen_fsr3.md. */
+#ifndef PORT_FG_LOGIC_H
+#define PORT_FG_LOGIC_H
+
+#include <stdlib.h>
+#include <ctype.h>
+
+/* case-insensitive equality; NULL never matches */
+static inline int pfg_word(const char* a, const char* b)
+{
+    if (!a || !b) return 0;
+    for (; *a && *b; ++a, ++b)
+        if (tolower((unsigned char)*a) != tolower((unsigned char)*b)) return 0;
+    return *a == *b;
+}
+
+/* ---------------------------------------------------------------- PORT_FG=dlssg|fsr3|off */
+enum { PFG_SEL_LEGACY = 0, PFG_SEL_DLSSG, PFG_SEL_FSR3, PFG_SEL_OFF, PFG_SEL_BAD };
+
+/* unset, empty or "auto": the per-game switches decide (old behaviour) */
+static inline int pfg_parse_sel(const char* v)
+{
+    if (!v || !*v || pfg_word(v, "auto")) return PFG_SEL_LEGACY;
+    if (pfg_word(v, "dlssg") || pfg_word(v, "dlss-g") || pfg_word(v, "dlss")) return PFG_SEL_DLSSG;
+    if (pfg_word(v, "fsr3") || pfg_word(v, "fsr")) return PFG_SEL_FSR3;
+    if (pfg_word(v, "off") || pfg_word(v, "0") || pfg_word(v, "none")) return PFG_SEL_OFF;
+    return PFG_SEL_BAD;
+}
+
+/* backend: 0 auto (DLSS-G, else FSR 3), 1 DLSS-G only, 2 FSR 3 only; want: 0 off or the multiplier 2..4 */
+enum { PFG_BE_AUTO = 0, PFG_BE_DLSS = 1, PFG_BE_FSR3 = 2 };
+
+/* R2/R3 per-game switches (R?_DLSS_FG, R?_FG_BACKEND), exactly as VKR2FrameGen.cpp parsed them before PORT_FG.
+ * bad_mult: the ignored numeric value (0 = none); bad_backend: R?_FG_BACKEND was not understood. */
+static inline void pfg_parse_vk_legacy(const char* dlss_fg, const char* fg_backend, int* want, int* backend, int* bad_mult, int* bad_backend)
+{
+    const int fsr_word = pfg_word(dlss_fg, "fsr3") || pfg_word(dlss_fg, "fsr");
+    const int v = fsr_word ? 2 : (dlss_fg && *dlss_fg) ? atoi(dlss_fg) : 0;
+    *want = (v >= 2 && v <= 4) ? v : 0;
+    *bad_mult = (v && !*want) ? v : 0;
+    const char* b = (fg_backend && *fg_backend) ? fg_backend : 0;
+    *backend = fsr_word ? PFG_BE_FSR3 : pfg_word(b, "dlss") ? PFG_BE_DLSS : (pfg_word(b, "fsr3") || pfg_word(b, "fsr")) ? PFG_BE_FSR3 : PFG_BE_AUTO;
+    *bad_backend = b && !*backend && !pfg_word(b, "auto");
+}
+
+/* PORT_FG wins over the per-game switches. dlssg keeps a 3x / 4x request (else 2x); fsr3 is 2x. */
+static inline void pfg_apply_sel(int sel, int* want, int* backend)
+{
+    switch (sel)
+    {
+    case PFG_SEL_DLSSG: *backend = PFG_BE_DLSS; if (*want < 2 || *want > 4) *want = 2; break;
+    case PFG_SEL_FSR3: *backend = PFG_BE_FSR3; *want = 2; break;
+    case PFG_SEL_OFF: *want = 0; break;
+    default: break;
+    }
+}
+
+/* PORT_FG_HUDLESS: 1 = hand the generator the HUD-less scene + the UI layer, 0 = whole frame; unset = legacy */
+static inline int pfg_hudless(const char* port_hudless, int legacy)
+{
+    if (!port_hudless || !*port_hudless) return legacy;
+    return !(pfg_word(port_hudless, "0") || pfg_word(port_hudless, "off"));
+}
+
+/* ---------------------------------------------------------------- pacing */
+/* PORT_FG_PACE (FSR 3 present pacer): vrr (default, old) = rendered fps <= 0.95 x refresh / 2 always;
+ * auto = no software pacer on a FIFO (vsync) swapchain, vrr otherwise; off = no pacer (the game cap only) */
+enum { PFG_PACE_VRR = 0, PFG_PACE_AUTO, PFG_PACE_OFF };
+
+static inline int pfg_parse_pace(const char* v)
+{
+    if (pfg_word(v, "auto") || pfg_word(v, "vsync")) return PFG_PACE_AUTO;
+    if (pfg_word(v, "off") || pfg_word(v, "0")) return PFG_PACE_OFF;
+    return PFG_PACE_VRR;
+}
+
+/* seconds between two rendered presents for the FSR 3 2x pacer; 0 = no pacer */
+static inline double pfg_fx_step_s(int cap, int pace, double refresh_hz, int fifo)
+{
+    if (!cap || pace == PFG_PACE_OFF || refresh_hz <= 1.0) return 0.0;
+    if (pace == PFG_PACE_AUTO && fifo) return 0.0;
+    return 2.0 / (refresh_hz * 0.95);
+}
+
+/* next deadline (any time unit): one step after the previous deadline, or after now when it fell behind */
+static inline long long pfg_pace_next(long long now, long long next, long long step)
+{
+    return (now - next > step) ? now + step : next + step;
+}
+
+/* DLSS-G Reflex frame limit in us (applies to presented frames); 0 = none */
+static inline unsigned pfg_reflex_limit_us(int cap, double refresh_hz, int on, int immediate)
+{
+    return (cap && refresh_hz > 1.0 && (on || immediate)) ? (unsigned)(1e6 / (refresh_hz * 0.95)) : 0u;
+}
+
+/* ---------------------------------------------------------------- FSR 3 enable hold */
+#define PFG_FX_HOLD 30u
+/* Generation stays enabled (as reset frames) for PFG_FX_HOLD frames after it stops being wanted, so short gaps do
+ * not toggle it (each toggle waits for the presenter). Returns whether generation is enabled this frame. */
+static inline int pfg_fx_hold_step(unsigned* hold, int on, int prev_gen, int inputs_ok)
+{
+    *hold = on ? PFG_FX_HOLD : (*hold ? *hold - 1u : 0u);
+    return on || (*hold && prev_gen && inputs_ok);
+}
+
+/* R2_DLSS_FG_CUT_RESET: camera cuts the upscaler keeps its history through (a parallax-only cut held by
+   RSX_AA_CUT_PARALLAX_GAP) still reset frame generation, which would otherwise blend the two shots. kind:
+   PFG_CUT_UNTRUSTED (held, motion not trusted: last trusted / none), PFG_CUT_HELD (held, voted motion).
+   mode: 0 off, 1 untrusted ones (default), 2 all held ones. */
+enum { PFG_CUT_NONE = 0, PFG_CUT_UNTRUSTED = 1, PFG_CUT_HELD = 2 };
+static inline int pfg_cut_reset(int mode, int kind)
+{
+    return kind > PFG_CUT_NONE && mode >= kind;
+}
+
+/* the generated frame must not blend with history: first frame, new swapchain, camera cut or a held (off) frame */
+static inline int pfg_fx_reset(int prev_gen, int sc_new, int reset, int on)
+{
+    return !prev_gen || sc_new || reset || !on;
+}
+
+/* ---------------------------------------------------------------- per-frame gate (both backends) */
+enum
+{
+    PFG_GATE_ON = 0, PFG_GATE_WARMUP, PFG_GATE_NO_SCENE, PFG_GATE_PAUSED, PFG_GATE_SPLITSCREEN, PFG_GATE_SCRGB,
+    PFG_GATE_SRGB, PFG_GATE_FX_SWAPCHAIN, PFG_GATE_MENU, PFG_GATE_BAD_STATUS
+};
+#define PFG_WARMUP_FRAMES 3u
+#define PFG_MENU_IDLE_MS 1500ull
+
+typedef struct
+{
+    int scene;          /* the upscaler handed over depth + motion vectors this frame */
+    int paused;         /* PC pause / Alt-Tab pause */
+    int local_players;
+    int scrgb;
+    int srgb;
+    int fx_sc_bad;      /* FSR 3 selected but its swapchain is not in use */
+    int menu_off;       /* R?_DLSS_FG_MENU_OFF */
+    int pause_ui;       /* the game's pause menu is up */
+    unsigned long long activity_ms, now_ms; /* newest look / play / camera / input time (0 = never) */
+    unsigned bad_status;  /* frames left after a backend error */
+    unsigned streak;      /* consecutive frames with a scene, this one included */
+} pfg_gate_in;
+
+static inline unsigned pfg_streak(unsigned streak, int scene) { return scene ? streak + 1u : 0u; }
+
+/* R?_DLSS_FG_GAP (default 2): a scene-less gap of at most max_gap frames right after at least PFG_GAP_MIN_STREAK scene
+   frames (the upscaler skipping one frame mid-play) resumes without the warm-up; the resume still resets the history.
+   *gap: scene-less frames since such a streak (0 = none). The bridged streak restarts at PFG_WARMUP_FRAMES, so a
+   second gap soon after warms up as before. max_gap 0 = always warm up (old pfg_streak). */
+#define PFG_GAP_MIN_STREAK 8u
+static inline unsigned pfg_streak_gap(unsigned streak, int scene, unsigned* gap, unsigned max_gap)
+{
+    if (!scene)
+    {
+        *gap = streak >= PFG_GAP_MIN_STREAK ? 1u : (*gap && *gap < max_gap) ? *gap + 1u : 0u;
+        return 0u;
+    }
+    const int bridge = *gap && *gap <= max_gap;
+    *gap = 0u;
+    return bridge ? PFG_WARMUP_FRAMES : streak + 1u;
+}
+
+static inline int pfg_gate(const pfg_gate_in* g)
+{
+    if (!g->scene) return PFG_GATE_NO_SCENE;
+    if (g->paused) return PFG_GATE_PAUSED;
+    if (g->local_players > 1) return PFG_GATE_SPLITSCREEN;
+    if (g->scrgb) return PFG_GATE_SCRGB;
+    if (g->srgb) return PFG_GATE_SRGB;
+    if (g->fx_sc_bad) return PFG_GATE_FX_SWAPCHAIN;
+    if (g->menu_off && (g->pause_ui || (g->activity_ms && g->now_ms - g->activity_ms > PFG_MENU_IDLE_MS))) return PFG_GATE_MENU;
+    if (g->bad_status) return PFG_GATE_BAD_STATUS;
+    if (g->streak < PFG_WARMUP_FRAMES) return PFG_GATE_WARMUP;
+    return PFG_GATE_ON;
+}
+
+#endif
