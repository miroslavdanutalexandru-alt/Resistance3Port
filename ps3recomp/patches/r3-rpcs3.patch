+	static bool micro_env(const char* name)
+	{
+		const char* v = std::getenv(name);
+		return !(v && (v[0] == '0' || v[0] == 'n' || v[0] == 'N' || v[0] == 'f' || v[0] == 'F' || ((v[0] == 'o' || v[0] == 'O') && (v[1] == 'f' || v[1] == 'F'))));
+	}
+	bool micro_a() { static const bool on = micro_env("RSX_MICRO_A"); return on; }
+	bool micro_b() { static const bool on = micro_env("RSX_MICRO_B"); return on; }
+
+	// [micro] line every ~5 s of flips (independent of RSX_RECORD_THREAD; off by default, RSX_MICRO_STATS=1 turns it on)
+	static void micro_on_flip()
+	{
+		static const bool stats = std::getenv("RSX_MICRO_STATS") != nullptr && std::atoi(std::getenv("RSX_MICRO_STATS")) != 0;
+		if (!stats) return;
+		static u64 t0 = 0, frames = 0, last[mc_count] = {};
+		const u64 t = static_cast<u64>(std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::steady_clock::now().time_since_epoch()).count());
+		if (!t0) { t0 = t; return; }
+		frames++;
+		if (t - t0 < 5'000'000'000ull) return;
+		u64 d[mc_count];
+		for (int i = 0; i < mc_count; i++) { d[i] = g_micro[i] - last[i]; last[i] = g_micro[i]; }
+		const double f = static_cast<double>(frames);
+		std::fprintf(stderr, "[micro] A=%d B=%d | dynstate calls/f=%.0f skipped/f=%.0f (%.0f%%) cache resets/f=%.1f\n",
+			micro_a() ? 1 : 0, micro_b() ? 1 : 0, d[mc_dyn_calls] / f, d[mc_dyn_skipped] / f,
+			d[mc_dyn_calls] ? 100.0 * d[mc_dyn_skipped] / d[mc_dyn_calls] : 0.0, d[mc_dyn_resets] / f);
+		t0 = t;
+		frames = 0;
+	}
