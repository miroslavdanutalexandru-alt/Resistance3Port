+				"	if (opts3.x > 1.5 && opts3.x < 2.5)\n"
+				"	{\n"
+				"		vec4 v = texelFetch(IdIn, p, 0);\n"
+				"		float lv = opts2.y > 0.5 ? v.w : v.z;\n"
+				"		if (v.z + v.w > 0.5 && abs(lv - lin(d)) <= opts3.z * max(lin(d), 1e-6) &&\n"
