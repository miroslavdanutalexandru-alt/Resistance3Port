+namespace vk
+{
+	// PORT_DLSS_BIAS_MASK: the bias-current-colour mask (written by r2aa_prep_pass) = max(mask, effect coverage)
+	struct r2aa_fxmask_pass : compute_task
+	{
+		const vk::image_view* in_fx = nullptr;
+		const vk::image_view* io_mask = nullptr;
+		std::unique_ptr<vk::sampler> m_sampler;
+
+		r2aa_fxmask_pass()
+		{
+			m_src =
+				"#version 450\n"
+				"layout(local_size_x = 8, local_size_y = 8) in;\n"
+				"layout(set=0, binding=0) uniform sampler2D FxIn;\n"
+				"layout(set=0, binding=1, r8) uniform restrict image2D MaskIO;\n"
+				// opts.xy: scene size (the mask can be larger: RSX_AA_DYNRES repeats the edge pixels, as the prep pass)
+				// opts.z: dilation radius (PORT_DLSS_BIAS_MASK_DILATE: 1 = 3x3 max)
+				"layout(push_constant) uniform PC { vec4 opts; };\n"
+				"void main()\n"
+				"{\n"
+				"	ivec2 o = ivec2(gl_GlobalInvocationID.xy);\n"
+				"	if (any(greaterThanEqual(o, imageSize(MaskIO)))) return;\n"
+				"	ivec2 lim = ivec2(opts.xy) - 1;\n"
+				"	ivec2 p = min(o, lim);\n"
+				"	float f = texelFetch(FxIn, p, 0).r;\n"
+				"	int r = int(opts.z);\n"
+				"	for (int y = -r; y <= r; ++y) for (int x = -r; x <= r; ++x)\n"
+				"		f = max(f, texelFetch(FxIn, clamp(p + ivec2(x, y), ivec2(0), lim), 0).r);\n"
+				"	if (f > 0.0) imageStore(MaskIO, o, vec4(max(imageLoad(MaskIO, o).r, f)));\n"
+				"}\n";
+			ssbo_count = 0;
+			use_push_constants = true;
+			push_constants_size = 16;
+			create();
+		}
+
+		std::vector<glsl::program_input> get_inputs() override
+		{
+			auto result = compute_task::get_inputs();
+			result.push_back(glsl::program_input::make(::glsl::program_domain::glsl_compute_program, "FxIn", vk::glsl::input_type_texture, 0, 0));
+			result.push_back(glsl::program_input::make(::glsl::program_domain::glsl_compute_program, "MaskIO", vk::glsl::input_type_storage_texture, 0, 1));
+			return result;
+		}
+
+		void bind_resources(const vk::command_buffer&) override
+		{
+			if (!m_sampler)
+			{
+				m_sampler = std::make_unique<vk::sampler>(*vk::get_current_renderer(),
+					VK_SAMPLER_ADDRESS_MODE_CLAMP_TO_EDGE, VK_SAMPLER_ADDRESS_MODE_CLAMP_TO_EDGE, VK_SAMPLER_ADDRESS_MODE_CLAMP_TO_EDGE,
+					VK_FALSE, 0.f, 1.f, 0.f, 0.f, VK_FILTER_NEAREST, VK_FILTER_NEAREST, VK_SAMPLER_MIPMAP_MODE_NEAREST, VK_BORDER_COLOR_FLOAT_OPAQUE_BLACK);
+			}
+			m_program->bind_uniform({ *in_fx, *m_sampler }, 0, 0);
+			m_program->bind_uniform({ *io_mask }, 0, 1);
+		}
+
+		void run(const vk::command_buffer& cmd, const float* constants, u32 w, u32 h)
+		{
+			if (!m_program) load_program(cmd);
+			vkCmdPushConstants(cmd, m_program->layout(), VK_SHADER_STAGE_COMPUTE_BIT, 0, push_constants_size, constants);
+			compute_task::run(cmd, (w + 7) / 8, (h + 7) / 8, 1);
+		}
+	};
+
+	// RSX_AA_MV_CONFIDENCE: a 64 x 36 grid of this frame's depth reprojected with the candidate camera transform T and
+	// with no motion; counts (per ring slot: stamp, valid samples, deviating with T, deviating with no motion) against the
+	// previous frame's depth 3x3 range, read back by the CPU a few frames later (r2aa_run)
+	struct r2aa_conf_pass : compute_task
+	{
+		const vk::image_view* in_depth = nullptr;
+		const vk::image_view* in_prev = nullptr;
+		const vk::buffer* buf = nullptr;
+		std::unique_ptr<vk::sampler> m_sampler;
+
+		r2aa_conf_pass()
+		{
+			m_src =
+				"#version 450\n"
+				"layout(local_size_x = 8, local_size_y = 8) in;\n"
+				"layout(set=0, binding=0) uniform sampler2D DepthIn;\n"
+				"layout(set=0, binding=1) uniform sampler2D PrevDepthIn;\n"
+				"layout(std430, set=0, binding=2) buffer Conf { uint cv[]; };\n"
+				// view: jitter ndc xy, viewport wh; opts: zA, zB, rw, rh; opts2: inverted, -, -, deviation limit; opts3: slot (uint bits). The stamp (word 0) is written after the dispatch.
+				"layout(push_constant) uniform PC { mat4 T; vec4 view; vec4 opts; vec4 opts2; vec4 opts3; };\n"
+				"float lin(float raw) { return opts2.x > 0.5 ? raw : 1.0 - raw; }\n"
+				"int deviates(vec4 q, ivec2 lim)\n"
+				"{\n"
+				"	if (!(q.w > 1e-7)) return -1;\n"
+				"	ivec2 ip = ivec2(floor((q.xy / q.w + 1.0) * 0.5 * view.zw));\n"
+				"	if (any(lessThan(ip, ivec2(1))) || any(greaterThan(ip, lim - 1))) return -1;\n"
+				"	float lo = 1e30, hi = -1e30;\n"
+				"	for (int y = -1; y <= 1; ++y)\n"
+				"		for (int x = -1; x <= 1; ++x)\n"
+				"		{\n"
+				"			float l = lin(texelFetch(PrevDepthIn, ip + ivec2(x, y), 0).r);\n"
+				"			lo = min(lo, l); hi = max(hi, l);\n"
+				"		}\n"
+				"	float lc = lin(((q.z / q.w) - opts.y) / opts.x);\n"
+				"	float e = max(lo * 0.97 - lc, lc - hi * 1.03) / max(max(lc, hi), 1e-6);\n"
+				"	return e > opts2.w ? 1 : 0;\n"
+				"}\n"
+				"void main()\n"
+				"{\n"
+				"	uvec2 g = gl_GlobalInvocationID.xy;\n"
+				"	uint s = floatBitsToUint(opts3.x) * 4u;\n"
+				"	if (g.x >= 64u || g.y >= 36u) return;\n"
+				"	vec2 wh = min(view.zw, opts.zw);\n"
+				"	ivec2 lim = ivec2(wh) - 1;\n"
+				"	ivec2 p = min(ivec2((vec2(g) + 0.5) / vec2(64.0, 36.0) * wh), lim);\n"
+				"	float d = texelFetch(DepthIn, p, 0).r;\n"
+				"	float ld = lin(d);\n"
+				"	if (ld <= 1e-5 || ld >= 1.0 - 1e-6) return;\n" // sky / cleared depth: no information
+				"	vec2 ndc = (vec2(p) + 0.5) / view.zw * 2.0 - 1.0 - view.xy;\n"
+				"	vec4 v = vec4(ndc, d * opts.x + opts.y, 1.0);\n"
+				"	int a = deviates(T * v, lim);\n"
+				"	int b = deviates(v, lim);\n"
+				"	if (a < 0 || b < 0) return;\n"
+				"	atomicAdd(cv[s + 1u], 1u);\n"
+				"	if (a == 1) atomicAdd(cv[s + 2u], 1u);\n"
+				"	if (b == 1) atomicAdd(cv[s + 3u], 1u);\n"
+				"}\n";
+			ssbo_count = 0;
+			use_push_constants = true;
+			push_constants_size = 128;
+			create();
+		}
+
+		std::vector<glsl::program_input> get_inputs() override
+		{
+			auto result = compute_task::get_inputs();
+			result.push_back(glsl::program_input::make(::glsl::program_domain::glsl_compute_program, "DepthIn", vk::glsl::input_type_texture, 0, 0));
+			result.push_back(glsl::program_input::make(::glsl::program_domain::glsl_compute_program, "PrevDepthIn", vk::glsl::input_type_texture, 0, 1));
+			result.push_back(glsl::program_input::make(::glsl::program_domain::glsl_compute_program, "Conf", vk::glsl::input_type_storage_buffer, 0, 2));
+			return result;
+		}
+
+		void bind_resources(const vk::command_buffer&) override
+		{
+			if (!m_sampler)
+			{
+				m_sampler = std::make_unique<vk::sampler>(*vk::get_current_renderer(),
+					VK_SAMPLER_ADDRESS_MODE_CLAMP_TO_EDGE, VK_SAMPLER_ADDRESS_MODE_CLAMP_TO_EDGE, VK_SAMPLER_ADDRESS_MODE_CLAMP_TO_EDGE,
+					VK_FALSE, 0.f, 1.f, 0.f, 0.f, VK_FILTER_NEAREST, VK_FILTER_NEAREST, VK_SAMPLER_MIPMAP_MODE_NEAREST, VK_BORDER_COLOR_FLOAT_OPAQUE_BLACK);
+			}
+			m_program->bind_uniform({ *in_depth, *m_sampler }, 0, 0);
+			m_program->bind_uniform({ *in_prev, *m_sampler }, 0, 1);
