+	std::string r2pc_patch_calibration_fs(const std::string& src)
+	{
+		static const std::string funcs = std::string(R"(
+// R2PORT PC extras: colour-blind filter and SDR -> HDR (PQ / scRGB). Parameters ride in
+// right_anaglyph_matrix when stereo is off: [0] = (hdr mode, cvd mode, saturation), [1] = (paper nits, peak nits, NaN guard).
+// Daltonization (as ReShade's Daltonize.fx) done on linear light: the sRGB-encoded colour is decoded first and the
+// corrected one encoded again, before any HDR encoding.
+vec3 r2pc_cvd(vec3 cs, int m)
+{
+	cs = clamp(cs, 0.0, 1.0);
+	vec3 c = mix(cs / 12.92, pow((cs + 0.055) / 1.055, vec3(2.4)), step(vec3(0.04045), cs));
+	const mat3 rgb2lms = mat3(17.8824, 3.45565, 0.0299566, 43.5161, 27.1554, 0.184309, 4.11935, 3.86714, 1.46709);
+	const mat3 lms2rgb = mat3(0.0809444479, -0.0102485335, -0.000365296938, -0.130504409, 0.0540193266, -0.00412161469,
+		0.116721066, -0.113614708, 0.693511405);
+	vec3 lms = rgb2lms * c;
+	vec3 s = lms;
+	if (m == 1) s.x = 2.02344 * lms.y - 2.52581 * lms.z;
+	else if (m == 2) s.y = 0.494207 * lms.x + 1.24827 * lms.z;
+	else s.z = -0.395913 * lms.x + 0.801109 * lms.y;
+	vec3 err = c - lms2rgb * s;
+	vec3 l = clamp(c + vec3(0.0, 0.7 * err.r + err.g, 0.7 * err.r + err.b), 0.0, 1.0);
+	return mix(l * 12.92, 1.055 * pow(l, vec3(1.0 / 2.4)) - 0.055, step(vec3(0.0031308), l));
+}
+)") + r2hdr::glsl() + R"(
+vec4 r2pc_post(vec4 o)
+{
+	if (stereo_display_mode != STEREO_MODE_DISABLED) return o;
+	const int hdr = int(right_anaglyph_matrix[0].x + 0.5);
+	const int cvd = int(right_anaglyph_matrix[0].y + 0.5);
+	vec3 c = o.rgb;
+	if (hdr > 0 && right_anaglyph_matrix[1].z > 0.5) c = mix(c, vec3(0.0), isnan(c)); // R3 #13: *_HDR_SANITIZE
+	if (cvd > 0) c = r2pc_cvd(c, cvd);
+	if (hdr > 0) c = r2pc_hdr(c, gl_FragCoord.xy, hdr, right_anaglyph_matrix[1].x, right_anaglyph_matrix[1].y, right_anaglyph_matrix[0].z);
+	return vec4(c, o.a);
+}
+
+void main()
+)";
+		std::string out = src;
+		const auto m = out.find("void main()");
+		const auto a = out.find("ocol.a = 1.f;");
+		if (m == std::string::npos || a == std::string::npos || a < m)
+		{
+			log("colour filter / HDR: %sthe present shader changed; PC post code not added");
+			return src;
+		}
+		out.replace(a, std::strlen("ocol.a = 1.f;"), "ocol.a = 1.f;\n\tocol = r2pc_post(ocol);");
+		out.replace(m, std::strlen("void main()"), funcs);
+		return out;
+	}
+
+	void r2pc_calibration_params(float* col0, float* col1, bool stereo)
+	{
+		if (stereo) return;
+		const bool hdr = g_pc_hdr_active != 0;   // the HDR settings (and DXGI) are only read once HDR is on
+		col0[0] = static_cast<float>(g_pc_hdr_active);
+		col0[1] = static_cast<float>(g_pc_cvd_mode);
+		col0[2] = hdr ? r2hdr::sat() : 0.f;
+		col1[0] = hdr ? r2hdr::paper() : 203.f;
+		col1[1] = hdr ? r2hdr::peak() : 203.f;
+		col1[2] = hdr && r2hdr::sanitize() ? 1.f : 0.f; // R3 #13: NaN guard before the HDR encode
+	}
+}
diff --git a/rpcs3/Emu/RSX/VK/VKR2PcExtras.h b/rpcs3/Emu/RSX/VK/VKR2PcExtras.h
new file mode 100644
index 0000000..f545eb3
--- /dev/null
+++ b/rpcs3/Emu/RSX/VK/VKR2PcExtras.h
@@ -0,0 +1,29 @@
+// R2PORT PC extras: HDR output, colour-blind filter and NVIDIA Reflex for the Vulkan present path.
+// All of it is off unless asked for (R2_HDR / R2_COLORBLIND / R2_REFLEX, or the R3_ names).
+#pragma once
+#include "VulkanAPI.h"
+#include <string>
+#include <vector>
+
+extern "C"
+{
+	extern volatile int g_pc_cvd_mode;      // 0 off, 1 protanopia, 2 deuteranopia, 3 tritanopia (live)
+	extern volatile int g_pc_hdr_active;    // 0 SDR, 1 HDR10 (PQ), 2 scRGB
+	extern volatile int g_pc_reflex_active; // VK_NV_low_latency2 sleep mode is on
+	extern volatile int g_pc_antilag_active; // AMD Anti-Lag 2 (VK_AMD_anti_lag) is on
+	int r2pc_post_active(void);             // the final pass must run the PC post code
+	void r2pc_reflex_sleep(void);           // the game's frame start (Reflex sleep); no-op when off
+	void r2pc_latency_render(int ev);       // RSX thread: 0 draw, 1 before present, 2 after present (Reflex markers / Anti-Lag 2)
+}
+
+namespace vk
+{
+	void r2pc_extend_instance(std::vector<const char*>& extensions);
+	void r2pc_pick_surface_format(const std::vector<VkSurfaceFormatKHR>& formats, VkFormat& format, VkColorSpaceKHR& color_space);
+	void r2pc_extend_device(VkPhysicalDevice pdev, std::vector<const char*>& extensions,
+		VkPhysicalDeviceVulkan12Features& vulkan12, VkDeviceCreateInfo& info);
+	void r2pc_swapchain_pre_create(VkSwapchainCreateInfoKHR& info);
+	void r2pc_swapchain_created(VkDevice dev, VkSwapchainKHR swapchain);
+	std::string r2pc_patch_calibration_fs(const std::string& src);
+	void r2pc_calibration_params(float* col0, float* col1, bool stereo);
+}
diff --git a/rpcs3/Emu/RSX/VK/VKR2Pipe.cpp b/rpcs3/Emu/RSX/VK/VKR2Pipe.cpp
new file mode 100644
index 0000000..2ac2877
--- /dev/null
+++ b/rpcs3/Emu/RSX/VK/VKR2Pipe.cpp
@@ -0,0 +1,158 @@
+#include "stdafx.h"
+#include "VKR2Pipe.h"
+#include "Emu/RSX/port_r2pipe.h"
+#include "Emu/RSX/port_r2memo.h"
+#include "../../../../../../include/ps3emu/port_hitch.h" // R2PORT: [hitch] logger
+
+#include <atomic>
+#include <chrono>
+#include <cstdio>
+#include <mutex>
+
+namespace vk::r2pipe
+{
+	namespace
+	{
+		std::atomic<u64> g_counters[c_count]{};
+		std::atomic<int> g_queue{ 0 };
+		std::atomic<u32> g_bg_done{ 0 };
+		std::atomic<u32> g_bg_total{ 0 };
+
+		std::mutex g_lock;
+		::r2pipe::stall_window g_window;
+		::r2pipe::report_timer g_timer;
+		u64 g_last_counters[c_count]{};
+
+		thread_local int t_scope_depth = 0;
+		thread_local bool t_render_thread = false;
+		thread_local bool t_work = false;
+
+		u64 take_delta(counter c)
+		{
+			const u64 v = g_counters[c].load(std::memory_order_relaxed);
+			const u64 d = v - g_last_counters[c];
+			g_last_counters[c] = v;
+			return d;
+		}
+	}
+
+	bool log_enabled()
+	{
+		static const bool on = r2memo::env_switch("R2_PIPE_LOG", true);
+		return on;
+	}
+
+	u64 now_ns()
+	{
+		return static_cast<u64>(std::chrono::duration_cast<std::chrono::nanoseconds>(
+			std::chrono::steady_clock::now().time_since_epoch()).count());
+	}
+
+	void add(counter c, u32 n)
+	{
+		g_counters[c].fetch_add(n, std::memory_order_relaxed);
+	}
+
+	void queue_delta(int delta)
+	{
+		g_queue.fetch_add(delta, std::memory_order_relaxed);
+	}
+
+	void set_bg_preload(u32 done, u32 total)
+	{
+		g_bg_done.store(done, std::memory_order_relaxed);
+		g_bg_total.store(total, std::memory_order_relaxed);
+	}
+
+	void note_stall_ns(u64 ns)
+	{
+		if (t_render_thread) port_hitch_add_ns(PH_PIPE, ns); // R2PORT: [hitch]
+		if (!log_enabled() || !t_render_thread) return;
+		std::lock_guard lock(g_lock);
+		g_window.add_stall(static_cast<double>(ns) / 1e6);
+	}
+
+	render_scope::render_scope()
+	{
+		t_render_thread = true;
+		if (t_scope_depth++ == 0) t_work = false;
+	}
+
+	render_scope::~render_scope()
+	{
+		t_scope_depth--;
+	}
+
+	bool in_render_scope() { return t_scope_depth > 0; }
+	bool is_render_thread() { return t_render_thread; }
+	void note_work() { if (t_scope_depth > 0) t_work = true; }
+
+	void note_shader_compile()
+	{
+		if (t_scope_depth > 0)
+		{
+			add(c_shader_compile);
+			t_work = true;
+		}
+	}
+
+	bool take_work()
+	{
+		const bool w = t_work;
+		t_work = false;
+		return w;
+	}
+
+	inline_timer::inline_timer()
+	{
+		if (t_render_thread && t_scope_depth == 0 && log_enabled()) t0 = now_ns();
+	}
+
+	inline_timer::~inline_timer()
+	{
+		if (!t0) return;
+		add(c_inline_other);
+		note_stall_ns(now_ns() - t0);
+	}
+
+	void on_flip()
+	{
+		if (!log_enabled()) return;
+		const u64 now = now_ns();
+
+		::r2pipe::stall_window w;
+		{
+			std::lock_guard lock(g_lock);
+			g_window.end_frame();
+			if (!g_timer.due(now)) return;
+			w = g_window;
+			g_window.reset();
+		}
+
+		u64 d[c_count];
+		for (int i = 0; i < c_count; ++i) d[i] = take_delta(static_cast<counter>(i));
+
+		const u32 bg_total = g_bg_total.load(std::memory_order_relaxed);
+		char bg[48] = "";
+		if (bg_total) std::snprintf(bg, sizeof(bg), " bg-preload %u/%u", g_bg_done.load(std::memory_order_relaxed), bg_total);
+
+		// R2PORT: queued to a writer thread -- a printf + fflush here (render thread, inside present) cost a ~21 ms frame every 5 s
+		port_log_async(0, "[pipe] %llu frames: stall %.1f ms (%.2f ms/frame, worst frame %.1f ms, worst wait %.1f ms, %llu frames >=2 ms) "
+			"| waits>2ms 2-4:%llu 4-8:%llu 8-16:%llu 16-33:%llu >33:%llu "
+			"| new %llu skipped-draws %llu shaders %llu sync %llu async %llu other %llu "
+			"| gpl fast-link %llu+%llu libs %llu optimised %llu fallback %llu | driver %.1f ms lock-wait %.1f ms | queue %d%s\n",
+			static_cast<unsigned long long>(w.frames), w.total_ms, w.per_frame_ms(), w.worst_frame_ms, w.worst_stall_ms,
+			static_cast<unsigned long long>(w.frames_with_stall),
+			static_cast<unsigned long long>(w.hist[0]), static_cast<unsigned long long>(w.hist[1]),
+			static_cast<unsigned long long>(w.hist[2]), static_cast<unsigned long long>(w.hist[3]),
+			static_cast<unsigned long long>(w.hist[4]),
+			static_cast<unsigned long long>(d[c_new_pipeline]), static_cast<unsigned long long>(d[c_skipped_draw]),
+			static_cast<unsigned long long>(d[c_shader_compile]), static_cast<unsigned long long>(d[c_sync_link]),
+			static_cast<unsigned long long>(d[c_async_link]), static_cast<unsigned long long>(d[c_inline_other]),
+			static_cast<unsigned long long>(d[c_fast_link_inline]), static_cast<unsigned long long>(d[c_fast_link_worker]),
+			static_cast<unsigned long long>(d[c_gpl_library]), static_cast<unsigned long long>(d[c_opt_swap]),
+			static_cast<unsigned long long>(d[c_gpl_fallback]),
+			static_cast<double>(d[c_driver_us]) / 1000.0, static_cast<double>(d[c_lock_wait_us]) / 1000.0,
+			g_queue.load(std::memory_order_relaxed), bg);
+	}
+}
diff --git a/rpcs3/Emu/RSX/VK/VKR2Pipe.h b/rpcs3/Emu/RSX/VK/VKR2Pipe.h
new file mode 100644
index 0000000..92d7162
--- /dev/null
+++ b/rpcs3/Emu/RSX/VK/VKR2Pipe.h
@@ -0,0 +1,61 @@
+#pragma once
+
+// R2PORT pipeline-stutter instrumentation (R2_PIPE_LOG, default on): time the render thread spends waiting on
+// pipeline / shader creation, printed as a [pipe] line every 5 s. Pure logic lives in Emu/RSX/port_r2pipe.h.
+
+#include "util/types.hpp"
+
+namespace vk::r2pipe
+{
+	enum counter : int
+	{
+		c_new_pipeline,      // pipelines requested by the render thread (play-time cache misses)
+		c_skipped_draw,      // draws skipped because their pipeline was still compiling (async mode)
+		c_shader_compile,    // vertex/fragment programs decompiled + compiled to SPIR-V on the render thread
+		c_sync_link,         // monolithic pipelines built on the render thread (recompiler mode, GPL off/unusable)
+		c_async_link,        // monolithic pipelines queued to the compiler threads
+		c_fast_link_inline,  // GPL: all four libraries cached, linked on the render thread (no skipped draw)
+		c_fast_link_worker,  // GPL: missing libraries built + linked on a compiler thread
+		c_gpl_library,       // GPL: library parts created
+		c_gpl_fallback,      // GPL: library path failed, monolithic used instead
+		c_opt_swap,          // GPL: optimised monolithic pipeline swapped in
+		c_inline_other,      // other inline pipeline creations on the render thread (overlays, compute passes)
+		c_lock_wait_us,      // render thread: microseconds waiting for its turn at the driver (PORT_PIPE_SERIAL)
+		c_driver_us,         // render thread: microseconds inside vkCreate*Pipelines (play-time creations)
+		c_count
+	};
+
+	bool log_enabled();
+	u64 now_ns();
+
+	void add(counter c, u32 n = 1);
+	void queue_delta(int delta);             // pending compiler jobs
+	void set_bg_preload(u32 done, u32 total); // background start-up preload progress
+	void note_stall_ns(u64 ns);              // render-thread wait (any thread is ignored unless it is the render thread)
+
+	// Render-thread scope around the program cache lookup. Work done inside it (shader compiles, pipeline links)
+	// is timed as one stall by the caller.
+	struct render_scope
+	{
+		render_scope();
+		~render_scope();
+		render_scope(const render_scope&) = delete;
+		render_scope& operator=(const render_scope&) = delete;
+	};
+
+	bool in_render_scope();          // inside a render_scope on this thread
+	bool is_render_thread();         // this thread has entered a render_scope before
+	void note_work();                // something was compiled inside the current render scope
+	void note_shader_compile();      // VP/FP decompile+compile; counted when inside a render scope
+	bool take_work();                // returns and clears the work flag of this thread
+
+	// Times inline pipeline creation on the render thread outside a render_scope (overlay / compute pipelines)
+	struct inline_timer
+	{
+		u64 t0 = 0;
+		inline_timer();
+		~inline_timer();
+	};
+
+	void on_flip(); // once per emulated flip: closes the frame and prints [pipe] every 5 s
+}
diff --git a/rpcs3/Emu/RSX/VK/VKR2Preload.cpp b/rpcs3/Emu/RSX/VK/VKR2Preload.cpp
new file mode 100644
index 0000000..8f21341
--- /dev/null
+++ b/rpcs3/Emu/RSX/VK/VKR2Preload.cpp
@@ -0,0 +1,597 @@
+// R2PORT (GitHub issue #10): breadcrumb, quarantine and SEH guard of the shader preload (see port_r2preload.h).
+
+#include "Emu/RSX/port_r2preload.h"
+#include "Emu/RSX/port_r2pipe.h"
+#include "VKR2Pipe.h"
+
+#include <algorithm>
+#include <atomic>
+#include <chrono>
+#include <condition_variable>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <mutex>
+#include <string>
+#include <unordered_set>
+#include <vector>
+
+#ifdef _WIN32
+#ifndef WIN32_LEAN_AND_MEAN
+#define WIN32_LEAN_AND_MEAN
+#endif
+#ifndef NOMINMAX
+#define NOMINMAX
+#endif
+#include <windows.h>
+#endif
+
+namespace r2preload
+{
+	namespace
+	{
+		std::once_flag g_init;
+		std::mutex g_lock;
+		std::unordered_set<std::string> g_quarantined; // guarded by g_lock
+		std::string g_quarantine_path;
+		bool g_use_quarantine = true;
+		bool g_use_breadcrumb = true;
+		bool g_use_seh = true;
+		bool g_serial = false;
+		std::atomic<bool> g_faulted{ false };
+
+		// PORT_PIPE_SERIAL: the driver lock. Background creations yield to the others (port_r2pipe.h serial_policy).
+		::r2pipe::serial_policy g_policy;
+		std::mutex g_gate_lock;
+		std::condition_variable g_gate_cv;
+		int g_gate_active = 0;     // guarded by g_gate_lock
+		int g_gate_fg_waiting = 0; // guarded by g_gate_lock
+		uint64_t g_gate_last_fg = 0; // guarded by g_gate_lock: the render thread's last play-time creation ended (ns)
+		thread_local int t_background = 0; // background_scope depth
+
+		char* g_slots = nullptr; // inflight_slots * inflight_slot_bytes, mapped onto logs\preload_inflight.txt
+		std::atomic<unsigned> g_next_slot{ 0 };
+		std::mutex g_slot_lock;
+		std::vector<int> g_free_slots; // guarded by g_slot_lock: slots of threads that have exited
+
+		thread_local int t_slot = -1;
+
+		// Issue #23: a thread's slot is cleared and reused when the thread exits (the boot load and link steps and the
+		// background preload each start their own threads; on many cores they would run out of the 64 slots)
+		struct slot_owner
+		{
+			~slot_owner()
+			{
+				if (t_slot < 0 || !g_slots) return;
+				::r2pipe::inflight_format(g_slots + static_cast<size_t>(t_slot) * ::r2pipe::inflight_slot_bytes, 0, nullptr);
+				std::lock_guard lock(g_slot_lock);
+				g_free_slots.push_back(t_slot);
+				t_slot = -1;
+			}
+		};
+		thread_local slot_owner t_slot_owner;
+		thread_local bool t_guard = false;
+		thread_local const std::string* t_name = nullptr;
+		thread_local const char* t_stage = nullptr; // stage_scope / driver_call label ("rt:<what>")
+		thread_local bool t_serial_held = false;    // a stage_scope of this thread holds g_driver_lock
+
+		std::once_flag g_env_once;
+		std::once_flag g_crumb_once;
+		std::string g_last_inflight; // the last run's breadcrumb file, read before it is recreated
+
+		void log_line(const char* fmt, const std::string& a, const std::string& b = {})
+		{
+			std::printf(fmt, a.c_str(), b.c_str());
+			std::fflush(stdout);
+		}
+
+#ifdef _WIN32
+		std::string logs_dir()
+		{
+			char exe[MAX_PATH]{};
+			const DWORD n = GetModuleFileNameA(nullptr, exe, MAX_PATH);
+			std::string d(exe, n);
+			const size_t s = d.find_last_of('\\');
+			if (s != std::string::npos) d.resize(s);
+			return d + "\\..\\logs"; // <port>\build\X.exe -> <port>\logs (as port_crash.h)
+		}
+
+		std::string read_file(const std::string& path, size_t limit)
+		{
+			std::string text;
+			HANDLE f = CreateFileA(path.c_str(), GENERIC_READ, FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE, nullptr,
+				OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL, nullptr);
+			if (f == INVALID_HANDLE_VALUE) return text;
+			LARGE_INTEGER sz{};
+			if (GetFileSizeEx(f, &sz) && sz.QuadPart > 0)
+			{
+				text.resize(static_cast<size_t>(std::min<long long>(sz.QuadPart, static_cast<long long>(limit))));
+				DWORD got = 0;
+				if (!ReadFile(f, text.data(), static_cast<DWORD>(text.size()), &got, nullptr)) got = 0;
+				text.resize(got);
+			}
+			CloseHandle(f);
+			return text;
+		}
+
+		// Newest logs\crash\*_crash.txt
+		std::string newest_crash_report(const std::string& logs)
+		{
+			WIN32_FIND_DATAA fd{};
+			HANDLE h = FindFirstFileA((logs + "\\crash\\*_crash.txt").c_str(), &fd);
+			if (h == INVALID_HANDLE_VALUE) return {};
+			std::string best;
+			FILETIME best_t{};
+			do
+			{
+				if (fd.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY) continue;
+				if (best.empty() || CompareFileTime(&fd.ftLastWriteTime, &best_t) > 0)
+				{
+					best = fd.cFileName;
+					best_t = fd.ftLastWriteTime;
+				}
+			} while (FindNextFileA(h, &fd));
+			FindClose(h);
+			return best.empty() ? best : logs + "\\crash\\" + best;
+		}
+
+		void map_breadcrumb(const std::string& path)
+		{
+			const DWORD bytes = static_cast<DWORD>(::r2pipe::inflight_slots * ::r2pipe::inflight_slot_bytes);
+			HANDLE f = CreateFileA(path.c_str(), GENERIC_READ | GENERIC_WRITE, FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE,
+				nullptr, CREATE_ALWAYS, FILE_ATTRIBUTE_NORMAL, nullptr);
+			if (f == INVALID_HANDLE_VALUE) return;
+			HANDLE m = CreateFileMappingA(f, nullptr, PAGE_READWRITE, 0, bytes, nullptr);
+			if (m)
+			{
+				if (void* v = MapViewOfFile(m, FILE_MAP_WRITE, 0, 0, bytes))
+				{
+					char* slots = static_cast<char*>(v);
+					for (size_t i = 0; i < ::r2pipe::inflight_slots; ++i)
+						::r2pipe::inflight_format(slots + i * ::r2pipe::inflight_slot_bytes, 0, nullptr);
+					g_slots = slots; // the mapping lives until the process exits
+				}
+				CloseHandle(m);
+			}
+			CloseHandle(f);
+		}
+#endif
+
+		bool add_quarantine(const std::string& name, const char* why)
+		{
+			{
+				std::lock_guard lock(g_lock);
+				if (!g_quarantined.insert(name).second) return false;
+				if (!g_quarantine_path.empty())
+				{
+					if (FILE* f = std::fopen(g_quarantine_path.c_str(), "ab"))
+					{
+						std::fprintf(f, "%s # %s\n", name.c_str(), why);
+						std::fclose(f);
+					}
+				}
+			}
+			log_line("[r2rsx] shader preload: quarantined %s (%s); it is skipped by later preloads (delete "
+				"shaders_cache\\preload_quarantine.txt to retry, PORT_PRELOAD_QUARANTINE=0 ignores the list)\n", name, why);
+			return true;
+		}
+
+		void set_slot(const char* key)
+		{
+			if (!g_slots) return;
+			if (t_slot < 0)
+			{
+				if (!key) return; // nothing to clear
+				{
+					std::lock_guard lock(g_slot_lock);
+					if (!g_free_slots.empty())
+					{
+						t_slot = g_free_slots.back();
+						g_free_slots.pop_back();
+					}
+				}
+				if (t_slot < 0)
+				{
+					const unsigned s = g_next_slot++;
+					if (s >= ::r2pipe::inflight_slots) return;
+					t_slot = static_cast<int>(s);
+				}
+				(void)&t_slot_owner; // constructs it: the slot is released when this thread exits
+			}
+#ifdef _WIN32
+			const unsigned long tid = GetCurrentThreadId();
+#else
+			const unsigned long tid = 0;
+#endif
+			::r2pipe::inflight_format(g_slots + static_cast<size_t>(t_slot) * ::r2pipe::inflight_slot_bytes, tid, key);
+		}
+
+		void read_env()
+		{
+			std::call_once(g_env_once, []
+			{
+				g_use_quarantine = ::r2pipe::env_int("PORT_PRELOAD_QUARANTINE", 1) != 0;
+				g_use_breadcrumb = ::r2pipe::env_int("PORT_PRELOAD_BREADCRUMB", 1) != 0;
+				g_use_seh = ::r2pipe::env_int("PORT_PRELOAD_SEH", 1) != 0;
+			});
+		}
+
+		// Keeps the last run's breadcrumb (init() matches it against the crash report), then maps a fresh one
+		void ensure_breadcrumb()
+		{
+			read_env();
+#ifdef _WIN32
+			std::call_once(g_crumb_once, []
+			{
+				if (!g_use_breadcrumb) return;
+				const std::string logs = logs_dir();
+				CreateDirectoryA(logs.c_str(), nullptr);
+				const std::string path = logs + "\\preload_inflight.txt";
+				g_last_inflight = read_file(path, 64 * 1024);
+				map_breadcrumb(path);
+			});
+#endif
+		}
+
+		// The breadcrumb shows the preload entry (link_scope) when there is one, else the innermost stage label
+		void stage_set(const char* stage)
+		{
+			t_stage = stage;
+			if (g_use_breadcrumb && !t_name) set_slot(stage);
+		}
+	}
+
+	void init(const std::string& cache_root)
+	{
+		ensure_breadcrumb();
+		std::call_once(g_init, [&]
+		{
+			if (g_use_quarantine && !cache_root.empty())
+			{
+				g_quarantine_path = cache_root + "preload_quarantine.txt";
+				if (FILE* f = std::fopen(g_quarantine_path.c_str(), "rb"))
+				{
+					char line[512];
+					while (std::fgets(line, sizeof(line), f))
+					{
+						const size_t n = std::strcspn(line, " #\r\n\t");
+						if (n) g_quarantined.emplace(line, n);
+					}
+					std::fclose(f);
+				}
+			}
+
+#ifdef _WIN32
+			// The last run died while a preload thread linked the pipeline its crash report names
+			if (g_use_breadcrumb && g_use_quarantine)
+			{
+				const auto inflight = ::r2pipe::inflight_parse(g_last_inflight);
+				if (!inflight.empty())
+				{
+					const std::string report = newest_crash_report(logs_dir());
+					const std::string key = report.empty() ? std::string() : ::r2pipe::crash_preload_key(read_file(report, 4u << 20));
+					const bool match = !key.empty() && !::r2pipe::inflight_is_stage(key) && std::any_of(inflight.begin(), inflight.end(),
+						[&](const ::r2pipe::inflight_entry& e) { return e.key == key; });
+					if (match) add_quarantine(key, "the last run crashed while a preload thread linked it");
+				}
+			}
+			g_last_inflight.clear();
+			g_last_inflight.shrink_to_fit();
+#endif
+			const unsigned n = quarantine_count();
+			if (n) log_line("[r2rsx] shader preload: %s quarantined pipeline(s) skipped%s\n", std::to_string(n));
+		});
+	}
+
+	bool is_quarantined(const std::string& name)
+	{
+		if (!g_use_quarantine) return false;
+		std::lock_guard lock(g_lock);
+		return !g_quarantined.empty() && g_quarantined.count(name) != 0;
+	}
+
+	unsigned quarantine_count()
+	{
+		std::lock_guard lock(g_lock);
+		return static_cast<unsigned>(g_quarantined.size());
+	}
+
+	link_scope::link_scope(const std::string& name, bool guard)
+	{
+		t_name = &name;
+		t_guard = guard && g_use_seh;
+		if (g_use_breadcrumb) set_slot(name.c_str());
+	}
+
+	link_scope::~link_scope()
+	{
+		t_guard = false;
+		t_name = nullptr;
+		if (g_use_breadcrumb) set_slot(t_stage);
+	}
+
+	guard_scope::guard_scope() : prev(t_guard)
+	{
+		t_guard = g_use_seh;
+	}
+
+	guard_scope::~guard_scope()
+	{
+		t_guard = prev;
+	}
+
+	void configure(uint32_t vendor_id)
+	{
+		ensure_breadcrumb();
+		g_serial = ::r2pipe::pipe_serialize(vendor_id);
+		g_policy = ::r2pipe::serial_policy_from_env();
+		if (g_serial)
+		{
+			std::printf("[r2rsx] pipelines: created one at a time (%s; PORT_PIPE_SERIAL=0 disables)\n",
+				vendor_id == 0x1002 ? "AMD GPU" : "PORT_PIPE_SERIAL=1");
+			if (g_policy.prio)
+				std::printf("[r2rsx] pipelines: play-time pipelines go first, background (optimised / preload) ones wait %llu ms after "
+					"the last play-time one (PORT_PIPE_SERIAL_PRIO=0: one shared queue; PORT_PIPE_BG_QUIET_MS, PORT_PIPE_BG_MAX_DEFER_MS %llu)\n",
+					static_cast<unsigned long long>(g_policy.quiet_ns / 1000000), static_cast<unsigned long long>(g_policy.max_defer_ns / 1000000));
+			else
+				std::printf("[r2rsx] pipelines: one shared queue for play-time and background pipelines (PORT_PIPE_SERIAL_PRIO=0)\n");
+			if (g_policy.max_active > 1)
+				std::printf("[r2rsx] pipelines: up to %d at once (PORT_PIPE_SERIAL_MAX; test setting, AMD drivers crashed on concurrent creates)\n",
+					g_policy.max_active);
+			std::fflush(stdout);
+		}
+	}
+
+	bool serialized()
+	{
+		return g_serial;
+	}
+
+	bool guard_active()
+	{
+		return t_guard;
+	}
+
+	bool faulted()
+	{
+		return g_faulted.load(std::memory_order_relaxed);
+	}
+
+	bool relink_after_preload_fault()
+	{
+		return ::r2pipe::preload_fault_relink(t_name != nullptr);
+	}
+
+#ifdef _WIN32
+	namespace
+	{
+		struct fault_info
+		{
+			DWORD code;
+			void* address;
+			ULONG_PTR fault_address;
+		};
+
+		int seh_filter(EXCEPTION_POINTERS* ep, fault_info* fi)
+		{
+			const DWORD code = ep->ExceptionRecord->ExceptionCode;
+			switch (code)
+			{
+			case EXCEPTION_ACCESS_VIOLATION:
+			case EXCEPTION_IN_PAGE_ERROR:
+			case EXCEPTION_ILLEGAL_INSTRUCTION:
+			case EXCEPTION_PRIV_INSTRUCTION:
+			case EXCEPTION_INT_DIVIDE_BY_ZERO:
+			case EXCEPTION_DATATYPE_MISALIGNMENT:
+			case EXCEPTION_ARRAY_BOUNDS_EXCEEDED:
+				fi->code = code;
+				fi->address = ep->ExceptionRecord->ExceptionAddress;
+				fi->fault_address = ep->ExceptionRecord->NumberParameters >= 2 ? ep->ExceptionRecord->ExceptionInformation[1] : 0;
+				return EXCEPTION_EXECUTE_HANDLER;
+			default:
+				return EXCEPTION_CONTINUE_SEARCH; // C++ exceptions, stack overflow, breakpoints: unchanged
+			}
+		}
+
+		// No object with a destructor in here: the guarded region is the driver call alone
+		bool seh_call(long (*fn)(void*), void* ctx, long* result, fault_info* fi)
+		{
+			__try
+			{
+				*result = fn(ctx);
+				return true;
+			}
+			__except (seh_filter(GetExceptionInformation(), fi))
+			{
+				return false;
+			}
+		}
+	}
+#endif
+
+	bool guarded_call(long (*fn)(void*), void* ctx, long* result)
+	{
+#ifdef _WIN32
+		fault_info fi{};
+		if (seh_call(fn, ctx, result, &fi)) return true;
+
+		g_faulted = true;
+		char where[MAX_PATH + 64] = "?";
+		HMODULE mod = nullptr;
+		if (GetModuleHandleExA(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS | GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT,
+			static_cast<LPCSTR>(fi.address), &mod) && mod)
+		{
+			char path[MAX_PATH]{};
+			GetModuleFileNameA(mod, path, MAX_PATH);
+			const char* base = std::strrchr(path, '\\');
+			std::snprintf(where, sizeof(where), "%s+0x%llX", base ? base + 1 : path,
+				static_cast<unsigned long long>(reinterpret_cast<uintptr_t>(fi.address) - reinterpret_cast<uintptr_t>(mod)));
+		}
+		else
+		{
+			std::snprintf(where, sizeof(where), "0x%p", fi.address);
+		}
+		char what[MAX_PATH + 160];
+		std::snprintf(what, sizeof(what), "exception 0x%08lX at %s (address 0x%llX) on %s thread %lu",
+			static_cast<unsigned long>(fi.code), where, static_cast<unsigned long long>(fi.fault_address),
+			t_name ? "preload" : "pipeline compiler", static_cast<unsigned long>(GetCurrentThreadId()));
+		const std::string name = t_name ? *t_name : std::string(t_stage ? t_stage : "a pipeline for the current draw");
+		log_line("[r2rsx] shader preload: the driver faulted while linking %s: %s; pipeline skipped, preload stopped "
+			"(PORT_PRELOAD_SEH=0 disables this guard)\n", name, what);
+		if (t_name && !t_name->empty()) add_quarantine(name, "the driver faulted while a preload thread linked it");
+		return false;
+#else
+		*result = fn(ctx);
+		return true;
+#endif
+	}
+
+#ifdef _WIN32
+	namespace
+	{
+		// PORT_PRELOAD_FAULT_TEST=N (test only, default 0): the next N graphics pipeline links on preload threads raise an
+		// access violation in place of the driver call, through the same guard as a real driver fault (issue #16 A-B)
+		bool fault_test(const char* stage)
+		{
+			static std::atomic<long> s_left{::r2pipe::env_int("PORT_PRELOAD_FAULT_TEST", 0)};
+			if (!t_name || !stage || (std::strncmp(stage, "rt:gfx", 6) != 0 && std::strcmp(stage, "rt:gpl_link") != 0)) return false;
+			return s_left.load(std::memory_order_relaxed) > 0 && s_left.fetch_sub(1, std::memory_order_relaxed) > 0;
+		}
+
+		long fault_test_raise(void*)
+		{
+			RaiseException(EXCEPTION_ACCESS_VIOLATION, 0, 0, nullptr);
+			return 0;
+		}
+	}
+#endif
+
+	namespace
+	{
+		uint64_t gate_now_ns()
+		{
+			return static_cast<uint64_t>(std::chrono::duration_cast<std::chrono::nanoseconds>(
+				std::chrono::steady_clock::now().time_since_epoch()).count());
+		}
+
+		bool is_background()
+		{
+			return t_background > 0 || t_name != nullptr; // optimised pipelines, preload / Fossilize replay links
+		}
+
+		// Returns whether this is a play-time creation of the render thread (its wait and call time go to [pipe])
+		bool gate_acquire()
+		{
+			const bool render = vk::r2pipe::in_render_scope();
+			const bool bg = !render && is_background();
+			const uint64_t t0 = gate_now_ns();
+			std::unique_lock lock(g_gate_lock);
+			if (bg)
+			{
+				// Optimised pipelines check the quiet period before they start (background_hold_us, so their compiler
+				// thread keeps serving draw-blocking jobs) and here wait at most 100 ms of it: enough to keep them out of
+				// the gaps between the render thread's library / link calls of a burst. Preload / replay threads wait
+				// for all of it here.
+				::r2pipe::serial_policy pol = g_policy;
+				if (!t_name) pol.quiet_ns = std::min<uint64_t>(pol.quiet_ns, 100000000ull);
+				for (;;)
+				{
+					const uint64_t until = ::r2pipe::serial_bg_wait_until(pol, g_gate_active, g_gate_fg_waiting, gate_now_ns(), g_gate_last_fg, t0);
+					if (!until) break;
+					if (until == ~0ull) g_gate_cv.wait(lock);
+					else g_gate_cv.wait_for(lock, std::chrono::nanoseconds(until - std::min(until, gate_now_ns())));
+				}
+			}
+			else
+			{
+				++g_gate_fg_waiting;
+				g_gate_cv.wait(lock, [] { return ::r2pipe::serial_fg_may_start(g_policy, g_gate_active); });
+				--g_gate_fg_waiting;
+			}
+			++g_gate_active;
+			lock.unlock();
+			if (render) vk::r2pipe::add(vk::r2pipe::c_lock_wait_us, static_cast<u32>((gate_now_ns() - t0) / 1000));
+			return render;
+		}
+
+		void gate_release(bool render)
+		{
+			{
+				std::lock_guard lock(g_gate_lock);
+				--g_gate_active;
+				if (render) g_gate_last_fg = gate_now_ns();
+			}
+			g_gate_cv.notify_all();
+		}
+	}
+
+	background_scope::background_scope()
+	{
+		++t_background;
+	}
+
+	background_scope::~background_scope()
+	{
+		--t_background;
+	}
+
+	uint64_t background_hold_us(uint64_t waiting_since_us)
+	{
+		if (!g_serial) return 0;
+		const uint64_t now = gate_now_ns();
+		uint64_t last_fg;
+		{
+			std::lock_guard lock(g_gate_lock);
+			last_fg = g_gate_last_fg;
+		}
+		// Only the quiet period: "active" / "fg waiting" are handled by the gate itself
+		const uint64_t since = waiting_since_us ? waiting_since_us * 1000 : now;
+		const uint64_t until = ::r2pipe::serial_bg_wait_until(g_policy, 0, 0, now, last_fg, since);
+		return until && until != ~0ull ? (until - std::min(until, now)) / 1000 + 1 : 0;
+	}
+
+	uint64_t now_us()
+	{
+		return gate_now_ns() / 1000;
+	}
+
+	bool driver_call(long (*fn)(void*), void* ctx, long* result, bool guard, const char* stage)
+	{
+		const bool gated = g_serial && !t_serial_held;
+		const bool render = gated ? gate_acquire() : vk::r2pipe::in_render_scope();
+		struct release_t { bool gated, render; ~release_t() { if (gated) gate_release(render); } } release{ gated, render };
+		const uint64_t t0 = render ? gate_now_ns() : 0;
+		const char* const prev = t_stage;
+		if (stage) stage_set(stage);
+		bool ok = true;
+#ifdef _WIN32
+		if (guard && g_use_seh && fault_test(stage)) fn = fault_test_raise;
+#endif
+		if (guard && g_use_seh) ok = guarded_call(fn, ctx, result);
+		else *result = fn(ctx);
+		if (stage) stage_set(prev);
+		if (render) vk::r2pipe::add(vk::r2pipe::c_driver_us, static_cast<u32>((gate_now_ns() - t0) / 1000));
+		return ok;
+	}
+
+	stage_scope::stage_scope(const char* stage) : prev_stage(t_stage), locked(false)
+	{
+		read_env();
+		if (g_serial && !t_serial_held && ::r2pipe::env_int("PORT_PIPE_SERIAL_SDK", 1) != 0)
+		{
+			gate_acquire();
+			t_serial_held = locked = true;
+		}
+		stage_set(stage);
+	}
+
+	stage_scope::~stage_scope()
+	{
+		stage_set(prev_stage);
+		if (locked)
+		{
+			t_serial_held = false;
+			gate_release(false);
+		}
+	}
+}
diff --git a/rpcs3/Emu/RSX/VK/VKR2Smoke.cpp b/rpcs3/Emu/RSX/VK/VKR2Smoke.cpp
new file mode 100644
index 0000000..3cb23c0
--- /dev/null
+++ b/rpcs3/Emu/RSX/VK/VKR2Smoke.cpp
@@ -0,0 +1,534 @@
+// R3PORT: Resistance 3 port addition (not upstream RPCS3).
+//
+// RSX_FLARE_SMOKE_OCCLUDE: best-estimate mitigation for "machine lights / lens flares visible through smoke"
+// (scratch\smoke_flare_notes.md). Not verified against game captures; default off.
+//
+// Evidence (pass dumps, logs\cmp\r3play): the flares (pipes 238/239) are additive (SRC_ALPHA, ONE), depth test off,
+// no zeta, drawn into the particle/transparent colour target between the game's back-to-front sorted particle
+// passes. Smoke drawn later (in front) is plain alpha blending (SRC_ALPHA, ONE_MINUS_SRC_ALPHA, depth test on,
+// no depth write): it attenuates the saturated flare by only (1 - a) per layer, so bright flares shine through.
+// The colour target's alpha is the game's bloom mask, so it can't carry a coverage term.
+//
+// Mechanism: while enabled, flare draws are rendered into a side image F (same format and size as their colour
+// target, cleared to zero) instead of the target. Every later draw into that target whose blend is linear in the
+// destination (result = src_term + dst * dst_factor, dst_factor not reading dst) is redrawn into F with the source
+// term removed (the game's shaders, vertex data and depth test; source factors ZERO), so F receives exactly the
+// attenuation the target receives. Plain alpha-blended smoke is redrawn k times (RSX_FLARE_SMOKE_STRENGTH):
+// F *= (1 - a)^k instead of (1 - a). Before anything that can't be expressed that way (another blend, depth or
+// stencil writes, MRT, a read of the target, a clear, a target switch, the flip) F is added onto the target.
+// Since every step is linear, STRENGTH=1 reproduces the unmodified image (up to 8-bit rounding/saturation): a
+// built-in self-check for the A/B.
+//
+//  RSX_FLARE_SMOKE_OCCLUDE=0|1|2   0/unset off. 1 = depth-test-off additive draws (flares). 2 = also depth-tested
+//                                  additive draws without depth writes (glow cards, sparks, muzzle flashes)
+//  RSX_FLARE_SMOKE_STRENGTH=<k>    1..4 (default 2): attenuation passes per later plain alpha-blended draw
+//
+// Limits: only smoke drawn after a flare (in front of it in the game's sort) attenuates it more; smoke drawn
+// before it (behind it by emitter origin, but possibly with particles in front) is untouched -- no depth is
+// known for depth-test-off flares. Costs one extra render pass per redirected flare and k per later smoke draw
+// while flares are pending; nothing when disabled (one branch per draw).
+
+#include "stdafx.h"
+#include "VKGSRender.h"
+#include "VKHelpers.h"
+#include "VKRenderPass.h"
+#include "VKFramebuffer.h"
+#include "VKResourceManager.h"
+#include "VKRenderTargets.h"
+#include "VKOverlays.h"
+#include "vkutils/image.h"
+#include "Emu/RSX/rsx_methods.h"
+#include "Emu/RSX/NV47/HW/context_accessors.define.h"
+
+#include <cstdarg>
+#include <cstdio>
+#include <cstdlib>
+#include <memory>
+#include <unordered_map>
+
+namespace
+{
+	void fxlog(const char* fmt, ...)
+	{
+		char buf[512];
+		va_list ap;
+		va_start(ap, fmt);
+		std::vsnprintf(buf, sizeof buf, fmt, ap);
+		va_end(ap);
+		std::fprintf(stderr, "[r3fx] %s\n", buf);
+	}
+
+	struct fx_config
+	{
+		int mode = 0;
+		int strength = 2;
+	};
+
+	const fx_config& fxcfg()
+	{
+		static const fx_config c = []
+		{
+			fx_config r;
+			if (const char* e = std::getenv("RSX_FLARE_SMOKE_OCCLUDE"); e && *e)
+			{
+				const int v = std::atoi(e);
+				r.mode = (v >= 0 && v <= 2) ? v : 0;
+			}
+			if (const char* e = std::getenv("RSX_FLARE_SMOKE_STRENGTH"); e && *e)
+			{
+				const int v = std::atoi(e);
+				if (v >= 1 && v <= 4) r.strength = v;
+			}
+			if (r.mode)
+				fxlog("RSX_FLARE_SMOKE_OCCLUDE=%d, RSX_FLARE_SMOKE_STRENGTH=%d (flare attenuation by later smoke: (1-a)^%d)",
+					r.mode, r.strength, r.strength);
+			return r;
+		}();
+		return c;
+	}
+
+	enum class fx_class
+	{
+		none,      // nothing to do (no flares pending, or not on the pending target and not a flare)
+		flare,     // redirect into F
+		keep,      // leaves F as is (additive / no colour writes)
+		attenuate, // redraw into F with the source term removed
+		flush      // composite F first, then draw normally
+	};
+
+	struct fx_state
+	{
+		std::unique_ptr<vk::viewable_image> img; // F
+		bool pending = false;
+		vk::image* rt = nullptr;                  // the target F belongs to
+		u32 rt_addr = 0;
+		rsx::surface_color_format rt_fmt{};
+		u16 fw = 0, fh = 0;                       // framebuffer region F covers
+
+		fx_class cur = fx_class::none;           // this draw (r3fx_pre_draw)
+		vk::glsl::program* cur_variant = nullptr;
+		u32 cur_passes = 0;
+
+		std::unordered_map<vk::glsl::program*, vk::glsl::program*> variants; // game pipeline -> F-attenuation variant
+
+		u64 flips = 0;
+		u64 n_flare = 0, n_att = 0, n_flush = 0, n_skip = 0, n_pending_variant = 0;
+	};
+
+	fx_state g_fx;
+
+	bool dst_free(VkBlendFactor f)
+	{
+		switch (f)
+		{
+		case VK_BLEND_FACTOR_ZERO:
+		case VK_BLEND_FACTOR_ONE:
+		case VK_BLEND_FACTOR_SRC_COLOR:
+		case VK_BLEND_FACTOR_ONE_MINUS_SRC_COLOR:
+		case VK_BLEND_FACTOR_SRC_ALPHA:
+		case VK_BLEND_FACTOR_ONE_MINUS_SRC_ALPHA:
+		case VK_BLEND_FACTOR_CONSTANT_COLOR:
+		case VK_BLEND_FACTOR_ONE_MINUS_CONSTANT_COLOR:
+		case VK_BLEND_FACTOR_CONSTANT_ALPHA:
+		case VK_BLEND_FACTOR_ONE_MINUS_CONSTANT_ALPHA:
+			return true;
+		default:
+			return false;
+		}
+	}
+
+	void fx_barrier(VkCommandBuffer c)
+	{
+		VkMemoryBarrier mb{ VK_STRUCTURE_TYPE_MEMORY_BARRIER };
+		mb.srcAccessMask = VK_ACCESS_DEPTH_STENCIL_ATTACHMENT_WRITE_BIT | VK_ACCESS_COLOR_ATTACHMENT_WRITE_BIT;
+		mb.dstAccessMask = VK_ACCESS_DEPTH_STENCIL_ATTACHMENT_READ_BIT | VK_ACCESS_DEPTH_STENCIL_ATTACHMENT_WRITE_BIT |
+			VK_ACCESS_COLOR_ATTACHMENT_READ_BIT | VK_ACCESS_COLOR_ATTACHMENT_WRITE_BIT;
+		const VkPipelineStageFlags stages = VK_PIPELINE_STAGE_EARLY_FRAGMENT_TESTS_BIT | VK_PIPELINE_STAGE_LATE_FRAGMENT_TESTS_BIT |
+			VK_PIPELINE_STAGE_COLOR_ATTACHMENT_OUTPUT_BIT;
+		vkCmdPipelineBarrier(c, stages, stages, 0, 1, &mb, 0, nullptr, 0, nullptr);
+	}
+
+	vk::image_view* fx_view(vk::viewable_image* img)
+	{
+		return img->get_view(rsx::default_remap_vector.with_encoding(vk::VK_REMAP_IDENTITY), VK_IMAGE_ASPECT_COLOR_BIT);
+	}
+}
+
+namespace vk
+{
+	// F added onto the target (ONE, ONE on all four channels): flares are additive, so target + F is what drawing
+	// them in place would have produced, after F received the same attenuation as the target.
+	struct r3fx_composite_pass : public overlay_pass
+	{
+		r3fx_composite_pass()
+		{
+			vs_src =
+				"#version 450\n"
+				"#extension GL_ARB_separate_shader_objects : enable\n"
+				"void main()\n"
+				"{\n"
+				"	vec2 positions[] = {vec2(-1., -1.), vec2(1., -1.), vec2(-1., 1.), vec2(1., 1.)};\n"
+				"	gl_Position = vec4(positions[gl_VertexIndex % 4], 0., 1.);\n"
+				"}\n";
+
+			fs_src =
+				"#version 450\n"
+				"#extension GL_ARB_separate_shader_objects : enable\n"
+				"layout(set=0, binding=0) uniform sampler2D fs0;\n"
+				"layout(location=0) out vec4 out_color;\n"
+				"void main()\n"
+				"{\n"
+				"	out_color = texelFetch(fs0, ivec2(gl_FragCoord.xy), 0);\n"
+				"}\n";
+
+			m_num_usable_samplers = 1;
+			m_num_uniform_buffers = 0;
+			m_sampler_filter = VK_FILTER_NEAREST;
+
+			renderpass_config.set_attachment_count(1);
+			renderpass_config.set_depth_mask(false);
+			renderpass_config.set_color_mask(0, true, true, true, true);
+			renderpass_config.enable_blend(0,
+				VK_BLEND_FACTOR_ONE, VK_BLEND_FACTOR_ONE,
+				VK_BLEND_FACTOR_ONE, VK_BLEND_FACTOR_ONE,
+				VK_BLEND_OP_ADD, VK_BLEND_OP_ADD);
+			renderpass_config.set_multisample_state(1, 0xFFFF, false, false, false);
+		}
+	};
+}
+
+// Before the occlusion query block of emit_geometry (the renderpass may be open or not): classify the draw and
+// composite F first when this draw can't be applied to it. Composing here (not at the draw) lets the query block
+// that follows restart a query this may have closed, so the draw itself is still counted.
+void VKGSRender::r3fx_pre_draw()
+{
+	auto& s = g_fx;
+	s.cur = fx_class::none;
+	const int mode = fxcfg().mode;
+	if (!mode) return;
+
+	auto* cmd = m_current_command_buffer;
+	const auto& ps = m_pipeline_properties.state;
+	const auto& a = ps.att_state[0];
+	vk::image* rt = (m_draw_buffers.size() == 1 && !m_fbo_images.empty()) ? m_fbo_images[0] : nullptr;
+	vk::image* ds = res()->surface_cache.m_bound_depth_stencil.second;
+
+	const bool usable = rt && m_draw_fbo && m_program && !m_shader_interpreter.is_interpreter(m_program) &&
+		rt->samples() == 1 && (!ds || ds->samples() == 1) && ps.cs.attachmentCount == 1 && !ps.cs.logicOpEnable &&
+		!(m_ctx->program.fragment_program.ctrl & RSX_SHADER_CONTROL_PROGRAMMABLE_BLENDING) &&
+		!m_ctx->cond_render.hw_cond_active && !(cmd->flags & vk::command_buffer::cb_has_conditional_render) &&
+		m_draw_fbo->width() <= 0xffff && m_draw_fbo->height() <= 0xffff;
+
+	const bool linear = !a.blendEnable || (a.colorBlendOp == VK_BLEND_OP_ADD && a.alphaBlendOp == VK_BLEND_OP_ADD &&
+		dst_free(a.srcColorBlendFactor) && dst_free(a.srcAlphaBlendFactor) && dst_free(a.dstColorBlendFactor) && dst_free(a.dstAlphaBlendFactor));
+	const bool no_ds_writes = !ps.ds.depthWriteEnable && !ps.ds.stencilTestEnable;
+	const bool additive = a.blendEnable && linear && a.dstColorBlendFactor == VK_BLEND_FACTOR_ONE && a.dstAlphaBlendFactor == VK_BLEND_FACTOR_ONE;
+	const bool flare_sig = usable && additive && no_ds_writes &&
+		(a.srcColorBlendFactor == VK_BLEND_FACTOR_SRC_ALPHA || a.srcColorBlendFactor == VK_BLEND_FACTOR_ONE) &&
+		(mode >= 2 || !ps.ds.depthTestEnable);
+
+	if (!s.pending)
+	{
+		if (flare_sig) s.cur = fx_class::flare;
+		return;
+	}
+
+	if (rt != s.rt)
+	{
+		// Bound set changed without on_framebuffer_bound catching it (or MRT / no colour): composite now
+		r3fx_flush("target");
+		if (flare_sig) s.cur = fx_class::flare;
+		return;
+	}
+
+	if (flare_sig && m_draw_fbo->width() == s.fw && m_draw_fbo->height() == s.fh)
+	{
+		s.cur = fx_class::flare;
+		return;
+	}
+
+	if (usable && linear && no_ds_writes && (additive || !a.colorWriteMask))
+	{
+		s.cur = fx_class::keep;
+		return;
+	}
+
+	if (usable && linear && no_ds_writes && m_draw_fbo->width() == s.fw && m_draw_fbo->height() == s.fh)
+	{
+		vk::glsl::program* variant = nullptr;
+		if (const auto it = s.variants.find(m_program); it != s.variants.end())
+		{
+			variant = it->second;
+		}
+		else
+		{
+			vk::pipeline_props p = m_pipeline_properties;
+			auto& va = p.state.att_state[0];
+			if (!va.blendEnable)
+			{
+				va.dstColorBlendFactor = VK_BLEND_FACTOR_ZERO;
+				va.dstAlphaBlendFactor = VK_BLEND_FACTOR_ZERO;
+			}
+			va.blendEnable = VK_TRUE;
+			va.srcColorBlendFactor = VK_BLEND_FACTOR_ZERO;
+			va.srcAlphaBlendFactor = VK_BLEND_FACTOR_ZERO;
+			va.colorBlendOp = VK_BLEND_OP_ADD;
+			va.alphaBlendOp = VK_BLEND_OP_ADD;
+
+			vk::enter_uninterruptible();
+			const auto result = m_prog_buffer->get_graphics_pipeline(&m_ctx->program.cache_hint,
+				m_ctx->program.vertex_program, m_ctx->program.fragment_program, p, true, false);
+			vk::leave_uninterruptible();
+			variant = std::get<0>(result);
+			if (variant) s.variants.emplace(m_program, variant);
+		}
+
+		if (variant)
+		{
+			s.cur = fx_class::attenuate;
+			s.cur_variant = variant;
+			const bool smoke = a.blendEnable && a.srcColorBlendFactor == VK_BLEND_FACTOR_SRC_ALPHA &&
+				a.dstColorBlendFactor == VK_BLEND_FACTOR_ONE_MINUS_SRC_ALPHA;
+			s.cur_passes = smoke ? static_cast<u32>(fxcfg().strength) : 1u;
+			return;
+		}
+		s.n_pending_variant++;
+	}
+
+	r3fx_flush("draw");
+}
+
+// Opens a new occlusion query segment for the active report (same steps as emit_geometry's query block)
+bool VKGSRender::r3fx_begin_query()
+{
+	auto* cmd = m_current_command_buffer;
+	if (!m_active_query_info) return false;
+	const u32 id = m_occlusion_query_manager->allocate_query(*cmd);
+	if (id == umax) return false;
+	m_occlusion_query_manager->begin_query(*cmd, id);
+	auto& data = m_occlusion_map[m_active_query_info->slot_index];
+	data.indices.push_back(id);
+	data.set_sync_command_buffer(cmd);
+	cmd->flags |= (vk::command_buffer::cb_has_occlusion_task | vk::command_buffer::cb_has_open_query);
+	return true;
+}
+
+// Instead of the draw commands: a flare goes into F. false = draw normally.
+bool VKGSRender::r3fx_draw(void (*issue)(void*), void* issue_ctx)
+{
+	auto& s = g_fx;
+	if (s.cur != fx_class::flare) return false;
+	s.cur = fx_class::none;
+
+	auto* cmd = m_current_command_buffer;
+	vk::image* rt = m_fbo_images[0];
+	if (!vk::is_renderpass_open(*cmd) || (cmd->flags & vk::command_buffer::cb_has_conditional_render))
+	{
+		s.n_skip++;
+		if (s.pending) r3fx_flush("state");
+		return false;
+	}
+
+	const VkFormat fmt = rt->format();
+	if (!s.img || s.img->format() != fmt || s.img->width() < rt->width() || s.img->height() < rt->height())
+	{
+		if (s.pending) r3fx_flush("resize");
+		const u32 w = std::max(rt->width(), (s.img && s.img->format() == fmt) ? s.img->width() : 0u);
+		const u32 h = std::max(rt->height(), (s.img && s.img->format() == fmt) ? s.img->height() : 0u);
+		if (s.img)
+		{
+			vk::remove_framebuffers_with_image(s.img.get());
+			vk::get_resource_manager()->dispose(s.img);
+		}
+		const auto pdev = vk::get_current_renderer();
+		s.img = std::make_unique<vk::viewable_image>(*pdev, pdev->get_memory_mapping().device_local, VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT,
+			VK_IMAGE_TYPE_2D, fmt, w, h, 1, 1, 1, VK_SAMPLE_COUNT_1_BIT, VK_IMAGE_LAYOUT_UNDEFINED, VK_IMAGE_TILING_OPTIMAL,
+			VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT | VK_IMAGE_USAGE_SAMPLED_BIT | VK_IMAGE_USAGE_TRANSFER_DST_BIT,
+			vk::VK_IMAGE_CREATE_ALLOW_NULL_RPCS3, VMM_ALLOCATION_POOL_SWAPCHAIN, RSX_FORMAT_CLASS_COLOR);
+		if (!s.img || !s.img->value)
+		{
+			s.img.reset();
+			fxlog("flare image %ux%u (format %d) could not be created; flares drawn normally", w, h, static_cast<int>(fmt));
+			s.n_skip++;
+			return false;
+		}
+		fxlog("flare image %ux%u (format %d)", w, h, static_cast<int>(fmt));
+	}
+
+	if (vk::is_renderpass_open(*cmd)) vk::end_renderpass(*cmd);
+	const bool had_query = !!(cmd->flags & vk::command_buffer::cb_has_open_query) ||
+		(m_occlusion_query_active && (cmd->flags & vk::command_buffer::cb_load_occluson_task));
+	if (had_query) emergency_query_cleanup(cmd);
+	fx_barrier(*cmd);
+
+	if (!s.pending)
+	{
+		s.img->change_layout(*cmd, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL);
+		const VkClearColorValue zero{};
+		const VkImageSubresourceRange range{ VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0, 1 };
+		vkCmdClearColorImage(*cmd, s.img->value, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, &zero, 1, &range);
+		s.pending = true;
+		s.rt = rt;
+		s.rt_addr = m_ctx->fb.layout.color_addresses[m_draw_buffers[0]];
+		s.rt_fmt = m_ctx->fb.layout.color_format;
+		s.fw = static_cast<u16>(m_draw_fbo->width());
+		s.fh = static_cast<u16>(m_draw_fbo->height());
+	}
+	s.img->change_layout(*cmd, VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL);
+
+	std::vector<vk::image*> images = m_fbo_images;
+	images[0] = s.img.get();
+	const VkRenderPass rp = vk::get_renderpass(*m_device, vk::get_renderpass_key(images));
+	auto* fbo = vk::get_framebuffer(*m_device, s.fw, s.fh, VK_FALSE, rp, images);
+	fbo->add_ref();
+	vk::begin_renderpass(*cmd, rp, fbo->value, { positionu{ 0u, 0u }, sizeu{ s.fw, s.fh } });
+	// The game's pipeline stays bound: F has the target's format, so the passes are compatible
+	if (had_query) r3fx_begin_query(); // the flare's ZPASS count (the game's visibility test) still includes it
+	issue(issue_ctx);
+	if (cmd->flags & vk::command_buffer::cb_has_open_query) emergency_query_cleanup(cmd);
+	vk::end_renderpass(*cmd);
+	fbo->release();
+	fx_barrier(*cmd);
+	if (had_query) cmd->flags |= vk::command_buffer::cb_load_occluson_task;
+
+	begin_render_pass();
+	s.n_flare++;
+	return true;
+}
+
+// After the draw commands: apply the draw's destination factors to F (k times for plain alpha blending)
+void VKGSRender::r3fx_post_draw(void (*issue)(void*), void* issue_ctx)
+{
+	auto& s = g_fx;
+	if (s.cur != fx_class::attenuate) return;
+	s.cur = fx_class::none;
+
+	auto* cmd = m_current_command_buffer;
+	if (!s.pending || !s.img || !vk::is_renderpass_open(*cmd) || (cmd->flags & vk::command_buffer::cb_has_conditional_render))
+	{
+		s.n_skip++;
+		return;
+	}
+
+	vk::end_renderpass(*cmd);
+	if (cmd->flags & vk::command_buffer::cb_has_open_query)
+	{
+		emergency_query_cleanup(cmd);
+		cmd->flags |= vk::command_buffer::cb_load_occluson_task;
+	}
+	fx_barrier(*cmd);
+	s.img->change_layout(*cmd, VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL);
+
+	std::vector<vk::image*> images = m_fbo_images;
+	images[0] = s.img.get();
+	const VkRenderPass rp = vk::get_renderpass(*m_device, vk::get_renderpass_key(images));
+	auto* fbo = vk::get_framebuffer(*m_device, s.fw, s.fh, VK_FALSE, rp, images);
+	fbo->add_ref();
+	vk::begin_renderpass(*cmd, rp, fbo->value, { positionu{ 0u, 0u }, sizeu{ s.fw, s.fh } });
+	vkCmdBindPipeline(*cmd, VK_PIPELINE_BIND_POINT_GRAPHICS, s.cur_variant->value());
+	for (u32 i = 0; i < s.cur_passes; ++i)
+	{
+		issue(issue_ctx); // blending within one subpass follows primitive order: no barrier between the passes
+	}
+	vk::end_renderpass(*cmd);
+	fbo->release();
+	fx_barrier(*cmd);
+
+	cmd->r2_invalidate_state_cache();
+	begin_render_pass();
+	vkCmdBindPipeline(*cmd, VK_PIPELINE_BIND_POINT_GRAPHICS, m_program->value());
+	s.n_att++;
+}
+
+// F onto its target (outside any render pass; the next draw reopens its own)
+void VKGSRender::r3fx_flush(const char* /*why*/)
+{
+	auto& s = g_fx;
+	if (!s.pending) return;
+	s.pending = false;
+	s.cur = fx_class::none;
+	if (!s.img || !s.rt) return;
+
+	auto* cmd = m_current_command_buffer;
+	if (vk::is_renderpass_open(*cmd))
+	{
+		vk::end_renderpass(*cmd);
+	}
+	if (cmd->flags & vk::command_buffer::cb_has_open_query)
+	{
+		emergency_query_cleanup(cmd);
+		cmd->flags |= vk::command_buffer::cb_load_occluson_task;
+	}
+	fx_barrier(*cmd);
+
+	s.img->change_layout(*cmd, VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL);
+	s.rt->push_layout(*cmd, VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL);
+	const VkRenderPass rp = vk::get_renderpass(*m_device, vk::get_renderpass_key({ s.rt }));
+	auto* pass = vk::get_overlay_pass<vk::r3fx_composite_pass>();
+	pass->run(*cmd, { 0, 0, s.fw, s.fh }, s.rt, std::vector<vk::image_view*>{ fx_view(s.img.get()) }, rp);
+	vk::end_renderpass(*cmd);
+	s.rt->pop_layout(*cmd);
+	fx_barrier(*cmd);
+
+	cmd->r2_invalidate_state_cache();
+	cmd->flags |= vk::command_buffer::cb_reload_dynamic_state;
+	s.n_flush++;
+}
+
+// on_framebuffer_bound, before the surface cache switches: keep F only while its target stays the single colour target
+void VKGSRender::r3fx_before_bind(const rsx::framebuffer_layout& layout)
+{
+	auto& s = g_fx;
+	if (!s.pending) return;
+	const auto idx = rsx::utility::get_rtt_indexes(layout.target);
+	const bool same = idx.size() == 1 && layout.color_addresses[idx[0]] == s.rt_addr && layout.color_format == s.rt_fmt &&
+		layout.aa_mode == rsx::surface_antialiasing::center_1_sample;
+	if (!same) r3fx_flush("bind");
+}
+
+// resolve_sampler_state: the draw samples the pending target
+void VKGSRender::r3fx_check_texture_reads()
+{
+	auto& s = g_fx;
+	if (!s.pending) return;
+	const auto regs = REGS(m_ctx);
+	auto& sc = res()->surface_cache;
+	for (u32 mask = m_ctx->program.fp_metadata.referenced_textures_mask, i = 0; mask; mask >>= 1, ++i)
+	{
+		if (!(mask & 1) || !regs->fragment_textures[i].enabled()) continue;
+		const auto& tex = regs->fragment_textures[i];
+		const u32 addr = rsx::get_address(m_ctx, tex.offset(), tex.location());
+		if (addr == s.rt_addr || static_cast<vk::image*>(sc.get_surface_at(addr)) == s.rt)
+		{
+			r3fx_flush("read");
+			return;
+		}
+	}
+}
+
+void VKGSRender::r3fx_on_flip()
+{
+	if (!fxcfg().mode) return;
+	auto& s = g_fx;
+	r3fx_flush("flip");
+	if (++s.flips % 600 == 0)
+	{
+		fxlog("last 600 frames: %llu flares redirected, %llu attenuation redraws, %llu composites, %llu skipped, %llu variant-not-ready",
+			s.n_flare, s.n_att, s.n_flush, s.n_skip, s.n_pending_variant);
+		s.n_flare = s.n_att = s.n_flush = s.n_skip = s.n_pending_variant = 0;
+	}
+}
+
+void VKGSRender::r3fx_release()
+{
+	auto& s = g_fx;
+	if (s.img)
+	{
+		vk::remove_framebuffers_with_image(s.img.get());
+		s.img.reset();
+	}
+	s.pending = false;
+	s.rt = nullptr;
+	s.cur = fx_class::none;
+	s.variants.clear();
+}
