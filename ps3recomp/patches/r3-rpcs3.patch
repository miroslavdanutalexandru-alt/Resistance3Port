diff --git a/rpcs3/Emu/RSX/VK/VKR2A2C.h b/rpcs3/Emu/RSX/VK/VKR2A2C.h
new file mode 100644
index 0000000..dd8284d
--- /dev/null
+++ b/rpcs3/Emu/RSX/VK/VKR2A2C.h
@@ -0,0 +1,174 @@
+#pragma once
+// R2PORT: alpha-to-coverage under DLSS / FSR (RSX_AA_A2C=hashed, RSX_AA_A2C_MIPSCALE).
+//
+// The game's MSAA is forced off with the upscaler, so RPCS3 emulates A2C in the fragment shader (single sample):
+//   noise  (upstream)  alpha > rand(gl_FragCoord)   screen-fixed noise, boils under jitter
+//   stable (default)   alpha >= 0.5                 hard cutoff: no boiling, but aliased foliage/fence/hair edges
+//   hashed (opt-in)    alpha >= hashed threshold    Wyman & McGuire 2017 "Hashed Alpha Testing" (isotropic form)
+//
+// Hashed: the threshold is a hash of the OBJECT-SPACE vertex position (vertex attribute 0, passed through varying
+// location 18), quantised to cells about one render pixel wide (scale from the screen derivatives of that
+// position, blended between the two nearest power-of-two scales with the CDF correction of the paper so the
+// threshold stays uniform on [0,1)). The pattern sticks to the surface: it does not swim when the camera moves
+// (a screen-space Bayer pattern would), and it has no frame-index term (DLSS would treat that as noise and the
+// boiling would get worse). The upscaler's sub-pixel jitter makes successive frames sample neighbouring cells,
+// so DLSS accumulates the coverage into a soft edge. alpha >= 1 always passes, alpha <= 0 always fails.
+// Trade-off: on thin far vegetation the cells can still shimmer slightly under DLSS where "stable" is a clean
+// (aliased) cutoff; a draw whose attribute 0 is not a position (or has no derivative) falls back to 0.5.
+//
+// RSX_AA_A2C_MIPSCALE=k (default 0 = off; Golus' "coverage-preserving" trick): for A2C draws every 2D texture
+// sample's alpha is multiplied by 1 + max(0, lod) * k (clamped to 1), so distant (minified) foliage keeps its
+// coverage instead of thinning out. Suggested k = 0.25. It scales every 2D sample of those shaders (not only the
+// alpha mask), hence opt-in.
+//
+// RSX_AA_ATEST_HASHED=band (default 0 = off; 1/on = 0.5): the same hashed threshold for the PLAIN alpha test (GREATER /
+// GEQUAL) of jittered scene draws, as a band around the game's alpha_ref: ref' = ref + (t - 0.5) * band. Only depth-
+// writing draws (the pre-pass) dither (rop bit 30); depth-EQUAL draws (the material pass, rop bit 29) test at the
+// band's floor, so the EQUAL depth test alone decides their coverage and the two passes can't disagree (no G-buffer
+// show-through). Cut-out edges (grass, posters) become a surface-fixed dither the jitter lets DLSS resolve.
+
+#include <cmath>
+#include <cstdint>
+#include <cstdlib>
+#include <cstring>
+#include <string>
+
+namespace vk::r2a2c
+{
+	enum class a2c_mode : int { noise = 0, stable = 1, hashed = 2 };
+
+	inline bool ieq(const char* a, const char* b)
+	{
+		for (; *a && *b; ++a, ++b)
+		{
+			const char x = (*a >= 'A' && *a <= 'Z') ? char(*a + 32) : *a;
+			const char y = (*b >= 'A' && *b <= 'Z') ? char(*b + 32) : *b;
+			if (x != y) return false;
+		}
+		return *a == *b;
+	}
+
+	// RSX_AA_A2C value -> mode. Unset/empty = stable (the default); unknown strings = noise (as pdq_a2c_parse).
+	inline a2c_mode parse_mode(const char* s)
+	{
+		if (!s || !*s) return a2c_mode::stable;
+		if (ieq(s, "hashed") || ieq(s, "hash") || ieq(s, "2")) return a2c_mode::hashed;
+		if (ieq(s, "stable") || ieq(s, "1") || ieq(s, "on")) return a2c_mode::stable;
+		return a2c_mode::noise;
+	}
+
+	// RSX_AA_A2C_MIPSCALE value -> k (0 = off; clamped to [0, 4]).
+	inline float parse_mipscale(const char* s)
+	{
+		if (!s || !*s) return 0.f;
+		const float k = std::strtof(s, nullptr);
+		if (!(k > 0.f)) return 0.f;
+		return k > 4.f ? 4.f : k;
+	}
+
+	// Read once. The vertex side writes the varying whenever hashed is selected; the fragment side reads it only
+	// for A2C programs with the upscaler on (a superset, so the interface always matches).
+	inline bool hashed_env()
+	{
+		static const bool v = parse_mode(std::getenv("RSX_AA_A2C")) == a2c_mode::hashed;
+		return v;
+	}
+
+	// RSX_AA_ATEST_HASHED value -> band (0 = off; on/1 = 0.5; clamped to [0, 1]).
+	inline float parse_atest_band(const char* s)
+	{
+		if (!s || !*s) return 0.f;
+		if (ieq(s, "on") || ieq(s, "1")) return 0.5f;
+		const float b = std::strtof(s, nullptr);
+		if (!(b > 0.f)) return 0.f;
+		return b > 1.f ? 1.f : b;
+	}
+
+	inline float atest_band_env()
+	{
+		static const float v = parse_atest_band(std::getenv("RSX_AA_ATEST_HASHED"));
+		return v;
+	}
+
+	// The vertex side writes r2_hashpos when either hashed mode needs it.
+	inline bool hashpos_env() { return hashed_env() || atest_band_env() > 0.f; }
+
+	inline constexpr unsigned atest_hash_bit = 30;  // rop_control: depth-writing scene draw, hashed reference
+	inline constexpr unsigned atest_floor_bit = 29; // rop_control: depth-EQUAL scene draw, reference at the band floor
+
+	inline float mipscale_env()
+	{
+		static const float v = parse_mipscale(std::getenv("RSX_AA_A2C_MIPSCALE"));
+		return v;
+	}
+
+	inline constexpr int hashpos_location = 18; // varyings: 0-17 used (VKCommonDecompiler.cpp; 16 = interpreter)
+	// VS line that feeds r2_hashpos. Attribute 0 is read only when the vertex program itself declares it as an input
+	// (the decompiler's PF_PARAM_IN list, which comes from the ucode and so is covered by the VP cache key); otherwise
+	// the vertex layout slot can hold a stale binding. vec3(0) has zero derivatives, so the FS falls back to 0.5.
+	inline std::string hashpos_assign(bool vp_reads_input0)
+	{
+		return vp_reads_input0 ? "	r2_hashpos = read_location(0).xyz;\n\n" : "	r2_hashpos = vec3(0.);\n\n";
+	}
+
+	// ---- CPU mirror of the GLSL below (unit test: libs/video/tests/test_r2_a2c_hashed.cpp) ----
+	inline void pcg3d(uint32_t v[3])
+	{
+		for (int i = 0; i < 3; ++i) v[i] = v[i] * 1664525u + 1013904223u;
+		v[0] += v[1] * v[2]; v[1] += v[2] * v[0]; v[2] += v[0] * v[1];
+		for (int i = 0; i < 3; ++i) v[i] ^= v[i] >> 16u;
+		v[0] += v[1] * v[2]; v[1] += v[2] * v[0]; v[2] += v[0] * v[1];
+	}
+
+	inline float hash_cell(const float p[3], float scale)
+	{
+		uint32_t u[3];
+		for (int i = 0; i < 3; ++i)
+		{
+			const float c = std::floor(scale * p[i]);
+			std::memcpy(&u[i], &c, 4);
+		}
+		pcg3d(u);
+		return float(u[0] >> 8) * (1.f / 16777216.f);
+	}
+
+	// p = object-space position, max_deriv = max(|dP/dx|, |dP/dy|) in object units per pixel.
+	inline float hashed_threshold(const float p[3], float max_deriv)
+	{
+		if (!(max_deriv > 1e-20f) || !std::isfinite(max_deriv)) return 0.5f;
+		const float pix_scale = 1.f / max_deriv;
+		const float l = std::log2(pix_scale);
+		const float s_lo = std::exp2(std::floor(l)), s_hi = std::exp2(std::ceil(l));
+		const float h_lo = hash_cell(p, s_lo), h_hi = hash_cell(p, s_hi);
+		const float lerp = l - std::floor(l);
+		const float x = (1.f - lerp) * h_lo + lerp * h_hi;
+		const float a = std::fmin(lerp, 1.f - lerp);
+		float t;
+		if (a < 1e-6f) t = x;
+		else if (x < a) t = x * x / (2.f * a * (1.f - a));
+		else if (x < 1.f - a) t = (x - 0.5f * a) / (1.f - a);
+		else t = 1.f - (1.f - x) * (1.f - x) / (2.f * a * (1.f - a));
+		return t < 1e-6f ? 1e-6f : (t > 1.f ? 1.f : t);
+	}
+
+	inline bool hashed_passes(float alpha, float threshold) { return alpha >= threshold; }
+
+	// Mirror of the RSXROPEpilogue.glsl reference (RSX_AA_ATEST_HASHED). mode: 1 = hash bit, 2 = floor bit, 0 = plain.
+	// Bounded so alpha 1 always passes and alpha 0 always fails a GREATER / GEQUAL test.
+	inline float atest_hashed_ref(float ref, float t, int mode, float band)
+	{
+		float r = ref;
+		if (mode == 1) r = ref + (t - 0.5f) * band;
+		else if (mode == 2) r = ref - 0.5f * band;
+		const float lo = ref < 1.f / 255.f ? ref : 1.f / 255.f;
+		const float hi = ref > 254.f / 255.f ? ref : 254.f / 255.f;
+		return r < lo ? lo : (r > hi ? hi : r);
+	}
+
+	inline float mipscale_alpha(float alpha, float lod, float k)
+	{
+		if (!(k > 0.f) || alpha > 1.f) return alpha;
+		const float s = alpha * (1.f + (lod > 0.f ? lod : 0.f) * k);
+		return s > 1.f ? 1.f : s;
+	}
+}
diff --git a/rpcs3/Emu/RSX/VK/VKR2DeformLogic.h b/rpcs3/Emu/RSX/VK/VKR2DeformLogic.h
new file mode 100644
index 0000000..17d403a
--- /dev/null
+++ b/rpcs3/Emu/RSX/VK/VKR2DeformLogic.h
@@ -0,0 +1,119 @@
+// R2PORT: Resistance 2/3 port addition (not upstream RPCS3).
+// RSX_DLSS_OBJMV_DEFORM capture policy, without any graphics API (VKR2Upscaler.cpp om2 record path).
+// A draw whose vertex data the CPU / SPU rewrote since its paired previous-frame draw gets real per-vertex motion
+// only when that previous draw kept a GPU copy of its vertex stream. Also r2vp_most_common (RSX_AA_CAMERA_EXACT's
+// shared view-projection pick) and r2om_pair_nearest (instance re-pairing). Byte-identical in R2 and R3.
+// Unit test: project/tests/fg_logic_test.cpp.
+#pragma once
+
+#include <algorithm>
+#include <cstdint>
+#include <utility>
+#include <vector>
+
+// RSX_DLSS_OBJMV_DEFORM_CARRY: frames since the draw's vertex data last changed (255: never seen changing).
+// Unpaired draws have no history: 255.
+inline uint8_t r2om_dage_next(bool matched, bool dyn, uint8_t prev_dage)
+{
+	if (!matched) return 255;
+	if (dyn) return 0;
+	return prev_dage >= 254 ? prev_dage : static_cast<uint8_t>(prev_dage + 1);
+}
+
+struct r2om_dwant
+{
+	bool want;  // copy this draw's vertex stream this frame
+	bool carry; // unchanged, but changed within the carry window
+	bool fresh; // unpaired this frame (RSX_DLSS_OBJMV_DEFORM_NEW)
+};
+
+// dn: copies taken so far this frame, dn_new: of those for unpaired draws. Unpaired draws (no previous-frame pair:
+// their pairing came and went, R2 1120 'no previous copy' fallbacks) get a copy too, but only when their vertex program
+// has been seen deforming (prog_deforms: a paired draw of it had rewritten vertex data; not static / streamed chunks),
+// at most new_cap per frame and never from the last min(new_cap, max / 2) of the frame's draw budget.
+inline r2om_dwant r2om_deform_want(bool matched, bool dyn, uint8_t dage, uint32_t carry_n, uint32_t dn, uint32_t dn_new,
+	uint32_t max, uint32_t new_cap, bool prog_deforms)
+{
+	r2om_dwant w{};
+	w.carry = carry_n && matched && !dyn && dage >= 1 && dage <= carry_n;
+	const uint32_t reserve = new_cap < max / 2 ? new_cap : max / 2;
+	w.fresh = !matched && prog_deforms && new_cap && dn_new < new_cap && dn + reserve < max;
+	w.want = (matched && dyn) || w.carry || w.fresh;
+	return w;
+}
+
+// Bytes: an unpaired draw's copy may only use the first half of the frame's deform buffer (dhalf), and at most
+// R2OM_FRESH_MAX_BYTES itself, so the paired changing draws later in the frame always keep half of it.
+static constexpr uint64_t R2OM_FRESH_MAX_BYTES = 1u << 20;
+inline bool r2om_fresh_fits(uint64_t dused, uint64_t d_size, uint64_t dhalf)
+{
+	return d_size && d_size <= R2OM_FRESH_MAX_BYTES && dused + ((d_size + 255) & ~uint64_t{255}) <= dhalf / 2;
+}
+
+// Why a changing paired draw found no previous copy (objmv2 detail)
+enum { R2OM_NP_UNPAIRED = 0, R2OM_NP_FIRST, R2OM_NP_AGED };
+inline int r2om_noprev_reason(bool prev_matched, uint8_t prev_dage)
+{
+	return !prev_matched ? R2OM_NP_UNPAIRED : prev_dage == 255 ? R2OM_NP_FIRST : R2OM_NP_AGED;
+}
+
+// RSX_DLSS_OBJMV_DEFORM_ID: a changing draw whose address pair has no vertex copy, but whose identity without buffer
+// addresses (RSX_AA_MATCH_LOOSE lkbase: vertex program, element count, textures, vertex formats / strides, primitive)
+// belongs to another previous-frame draw: that draw, when the identity is exact - exactly one previous-frame draw had
+// it (ordinal 0 present, ordinal 1 absent), this is its first draw this frame, and the address pair is another
+// identity (else the pair is that draw). find(k): the previous-frame entry index of ordinal k or null.
+// The caller also requires the same vertex program, vertex range / layout key and copy size.
+template <typename Find>
+inline int64_t r2om_id_prev(bool on, uint64_t lkbase, bool cur_first, uint64_t paired_lkbase, Find&& find)
+{
+	if (!on || !lkbase || !cur_first || paired_lkbase == lkbase) return -1;
+	const uint32_t* q0 = find(0u);
+	if (!q0 || find(1u)) return -1;
+	return static_cast<int64_t>(*q0);
+}
+
+// RSX_AA_EXACT_ALL: the most common hash among (hash, draw index) pairs, indices unique (sorted in place).
+// Same winner as a first-seen table scanned with '>': most draws, ties to the smallest first index. O(n log n).
+struct r2vp_pick { uint64_t h; uint32_t n; uint32_t i; };
+inline bool r2vp_most_common(std::vector<std::pair<uint64_t, uint32_t>>& hs, r2vp_pick& out)
+{
+	std::sort(hs.begin(), hs.end());
+	bool have = false;
+	for (size_t a = 0; a < hs.size();)
+	{
+		size_t b = a + 1;
+		while (b < hs.size() && hs[b].first == hs[a].first) ++b;
+		const uint32_t n = static_cast<uint32_t>(b - a), i = hs[a].second; // hs[a]: this hash's first draw
+		if (!have || n > out.n || (n == out.n && i < out.i)) out = { hs[a].first, n, i };
+		have = true;
+		a = b;
+	}
+	return have;
+}
+
+// RSX_DLSS_OBJMV_PAIR_NEAREST: a matched draw paired by its occurrence ordinal whose constants changed may be another
+// instance of the same draw (instances culled or re-sorted, portal churn at doorways: R2 1120 foliage paired with the
+// next instance's bone palette, motion of hundreds of pixels). Tries ordinals ord -+ 1 .. ord -+ window (nearest first,
+// the lower one first) against the ordinal pair's distance d0; dist(k, bound) is the distance of the previous-frame
+// occurrence k (< 0: none / not comparable), any value >= bound once it reaches bound. Returns the ordinal of the
+// closest candidate under ratio * d0 (an exact one, distance 0, ends the search) and its distance, or -1: keep the pair.
+template <typename Dist>
+inline int64_t r2om_pair_nearest(uint32_t ord, uint32_t window, double d0, double ratio, Dist&& dist, double* out_d = nullptr)
+{
+	int64_t best = -1;
+	double bd = d0 * ratio;
+	for (uint32_t s = 1; s <= window && bd > 0; ++s)
+		for (int side = 0; side < 2 && bd > 0; ++side)
+		{
+			if (side == 0 && s > ord) continue;
+			const uint32_t k = side == 0 ? ord - s : ord + s;
+			const double d = dist(k, bd);
+			if (d >= 0 && d < bd)
+			{
+				bd = d;
+				best = k;
+			}
+		}
+	if (out_d && best >= 0) *out_d = bd;
+	return best;
+}
diff --git a/rpcs3/Emu/RSX/VK/VKR2DepthBias.h b/rpcs3/Emu/RSX/VK/VKR2DepthBias.h
new file mode 100644
index 0000000..eaec754
--- /dev/null
+++ b/rpcs3/Emu/RSX/VK/VKR2DepthBias.h
@@ -0,0 +1,54 @@
+#pragma once
+// R2PORT: RSX_ZBIAS_D32 -- polygon-offset constant units on hosts without D24S8.
+//
+// RSX's fixed 24-bit depth applies the constant bias in units of 1/(2^24-1) of window z. With no
+// VK_FORMAT_D24_UNORM_S8_UINT (AMD), RPCS3 stores that surface as D32_SFLOAT_S8, where Vulkan scales the
+// constant factor by 2^(exponent(max z) - 23): exact only for depth in [0.5, 1), 2x too small in
+// [0.25, 0.5), and so on (shadow maps and other linear-depth passes get almost no bias -> acne, decal
+// z-fighting). Upstream accepts that ("works out by chance", VKDraw.cpp). After the GoW Ascension recomp
+// (MIT, rsx_live_draw.c): the constant term goes into the viewport z translate (vertex env offset_z, the
+// same window-z units) and only the slope term stays in vkCmdSetDepthBias.
+//
+//   RSX_ZBIAS_D32 unset / auto : on only when the D24S8 fallback is active
+//   RSX_ZBIAS_D32=0            : off (upstream)
+//   RSX_ZBIAS_D32=1            : on for every fixed-point Z24 surface (also on D24 hosts; testing)
+//
+// Kept free of RPCS3 headers so it can be unit tested (ps3recomp/tools/test_zbias_d32.py).
+#include <cstdlib>
+
+namespace r2zb
+{
+	// -1 auto, 0 off, 1 forced on
+	inline int parse_mode(const char* e)
+	{
+		if (!e || !*e) return -1;
+		if (e[0] == 'a' || e[0] == 'A') return -1;
+		return std::atoi(e) != 0 ? 1 : 0;
+	}
+
+	inline int mode()
+	{
+		static const int m = parse_mode(std::getenv("RSX_ZBIAS_D32"));
+		return m;
+	}
+
+	// Vulkan depth bias only ever applied to polygons: real points / lines / line loops / line strips
+	// (CELL_GCM_PRIMITIVE_* 1..4) must not get the vertex-env offset either.
+	inline bool polygon_primitive(int cell_gcm_primitive)
+	{
+		return cell_gcm_primitive >= 5;
+	}
+
+	// Whether the constant bias of this draw moves into the vertex env.
+	inline bool active(int mode, bool host_has_d24, bool fill_enabled, bool guest_fixed_z24)
+	{
+		if (!fill_enabled || !guest_fixed_z24 || mode == 0) return false;
+		return mode == 1 || !host_has_d24;
+	}
+
+	// RSX constant bias -> window-z offset (fixed 24-bit units).
+	inline float window_offset(float bias)
+	{
+		return bias / 16777215.f;
+	}
+}
diff --git a/rpcs3/Emu/RSX/VK/VKR2DlssQuality.h b/rpcs3/Emu/RSX/VK/VKR2DlssQuality.h
new file mode 100644
index 0000000..55d726f
--- /dev/null
+++ b/rpcs3/Emu/RSX/VK/VKR2DlssQuality.h
@@ -0,0 +1,912 @@
+/* port_dlss_quality.h -- pure (no GPU / no OS) helpers for three opt-in DLSS quality items, shared by the
+ * Resistance ports (same file in R1 ps3recomp\libs\video, R2/R3 RPCS3 Emu\RSX\VK\VKR2DlssQuality.h) and unit-tested
+ * by scratch\dlss_quality\test_dlss_quality.cpp. C99 and C++ compatible, header only.
+ *
+ *   1. pdq_is_effect: does a draw belong in the "bias current colour" mask (particles, smoke, muzzle flashes,
+ *      additive / alpha-blended effects -- the draws the game writes no motion for)?
+ *   2. pdq_reset_reasons: extra history-reset triggers (hitch, resolution change, cut, transition).
+ *   3. pdq_preset_check: will this nvngx_dlss.dll honour the requested render preset?
+ *
+ * Switches (read once by the callers through pdq_env_int / pdq_env_float):
+ *   PORT_DLSS_BIAS_MASK       0 = off (R1 default)  1 = mark effect draws in the bias-current-colour mask (R2 default; R3 default 0)
+ *   PORT_DLSS_RESET_CUTS      0 = off (default)  1 = also reset on resolution changes / transitions (see callers)
+ *   PORT_DLSS_RESET_HITCH_MS  0 = off (R1 default; R2/R3 default 250)  N = reset the history on the frame after a gap
+ *                             longer than N ms
+ *   RSX_AA_A2C / RSX_SSAO_NOISE (R2/R3 only, section 6): noise in the upscaler input; R3 default stable / temporal,
+ *                             R2 default noise / fixed (the callers pick the default; the parsers return the old value)
+ *   RSX_DLSS_DEPTH_BIAS       (R2/R3 only, VKR2Gfx.cpp) default scale; 0/off = upstream  scale|color|<k> = polygon-offset slope factor
+ *                             x the target's resolution scale (decals/carpets z-fighting at grazing angles); _LOG=N logs
+ *   RSX_AA_ATEST_MIPSCALE / RSX_DLSS_MASK_FAR (R2/R3 only, section 6): distant cut-out foliage under the upscaler;
+ *                             default 0.15 / 60 (the callers pass the default); 0/off = old
+ *   RSX_SHADOW_SLOPE_K        (R2/R3 only, VKR2Gfx.cpp) default 1 = off; k (<= 8) = shadow-map slope bias x k
+ *   RSX_VP_PRECISE_DOT        (R2/R3 only, VKR2Gfx.cpp) default 1; 0 = plain fp32 dot() in vertex-program DP4/DPH (pdq_dot2)
+ *   RSX_FX_UNJITTER           (R2/R3 only, VKR2Upscaler.cpp) default 1 = additive effects unjittered; 2 = all effects; 0 = off
+ *   RSX_AA_FRAME_S_VOTE       (R2/R3 only, VKR2Upscaler.cpp) default 0 = the last scene draw's screen transform; 1 = the
+ *                             one most scene draws used (pdq_s_*; experimental: it picked a weapon depth range in R3 T1)
+ */
+#ifndef PORT_DLSS_QUALITY_H
+#define PORT_DLSS_QUALITY_H
+
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+#include <math.h>
+
+/* ---- 1. effect-draw classifier ---------------------------------------------------------------------- */
+
+/* API-neutral blend factors / ops (callers map D3D12 / RSX enums onto these) */
+enum pdq_blend_factor {
+    PDQ_BF_OTHER = 0, PDQ_BF_ZERO, PDQ_BF_ONE, PDQ_BF_SRC_COLOR, PDQ_BF_INV_SRC_COLOR, PDQ_BF_SRC_ALPHA,
+    PDQ_BF_INV_SRC_ALPHA, PDQ_BF_DST_ALPHA, PDQ_BF_INV_DST_ALPHA, PDQ_BF_DST_COLOR, PDQ_BF_INV_DST_COLOR
+};
+enum pdq_blend_op { PDQ_OP_OTHER = 0, PDQ_OP_ADD, PDQ_OP_SUB, PDQ_OP_REVSUB, PDQ_OP_MIN, PDQ_OP_MAX };
+
+typedef struct pdq_draw {
+    int blend;          /* blending enabled on colour target 0 */
+    int src, dst, op;   /* pdq_blend_factor / pdq_blend_op of the RGB channels */
+    int color_write;    /* any colour channel of target 0 written */
+    int depth_write;    /* the draw writes depth */
+} pdq_draw;
+
+/* Flags for pdq_is_effect */
+#define PDQ_FX_MODULATE     1  /* also mark modulating blends (R1 RSX_FSR_RX_MUL=1) */
+#define PDQ_FX_DEPTH_WRITE  2  /* also mark blended draws that write depth (R1: they get no motion either) */
+
+/* The R1 FSR reactive-mask rule (rsx_fsr.inc fsr_mv_replay): blended, except
+ *   - ONE,ZERO (= replace: opaque, e.g. R1's outdoor terrain),
+ *   - modulating blends (op ADD, src ZERO/DST_ALPHA/DST_COLOR, dst ZERO/ONE/SRC_COLOR/SRC_ALPHA): they only scale
+ *     what is already there (shadow receive passes, decals) and move with the surface below,
+ *   - colour writes off (occlusion boxes, depth-only passes),
+ *   - (R2/R3) blended draws that write depth: the depth-based camera motion covers them.
+ * Returns 1 for an effect draw. */
+static inline int pdq_is_effect(const pdq_draw* d, unsigned flags)
+{
+    if (!d || !d->blend || !d->color_write) return 0;
+    if (d->src == PDQ_BF_ONE && d->dst == PDQ_BF_ZERO) return 0;
+    if (!(flags & PDQ_FX_MODULATE) && d->op == PDQ_OP_ADD &&
+        (d->src == PDQ_BF_ZERO || d->src == PDQ_BF_DST_ALPHA || d->src == PDQ_BF_DST_COLOR) &&
+        (d->dst == PDQ_BF_ZERO || d->dst == PDQ_BF_ONE || d->dst == PDQ_BF_SRC_COLOR || d->dst == PDQ_BF_SRC_ALPHA))
+        return 0;
+    if (d->depth_write && !(flags & PDQ_FX_DEPTH_WRITE)) return 0;
+    return 1;
+}
+
+/* Additive light (ONE or SRC_ALPHA onto ONE): sparks, dust motes, glows (PORT_DLSS_BIAS_MASK_ADD_VALUE) */
+static inline int pdq_is_additive(const pdq_draw* d)
+{
+    return d && d->blend && d->op == PDQ_OP_ADD && d->dst == PDQ_BF_ONE && (d->src == PDQ_BF_ONE || d->src == PDQ_BF_SRC_ALPHA);
+}
+
+/* RSX_FX_UNJITTER: an effect draw (pdq_is_effect, no depth write) drawn without the scene jitter. Mode 1: additive
+ * light only (dust motes, sparks: ~1 render px quads whose pixel-centre coverage flips with the jitter phase while the
+ * bias mask shows the current frame raw); 2: every effect draw; 0: off. EQUAL depth tests stay with the caller. */
+static inline int pdq_fx_unjitter(const pdq_draw* d, int mode)
+{
+    if (mode <= 0 || !d || d->depth_write || !pdq_is_effect(d, 0)) return 0;
+    return mode >= 2 || pdq_is_additive(d);
+}
+
+/* RSX_AA_JITTER_TIE: a jitter component on the quarter-pixel grid (0, +-0.25, +-0.5; Halton phases 1-3 in x) puts
+ * samples of the 2x copies of the jittered depth / light buffer exactly between texels, where the per-triangle
+ * interpolation noise decides the texel (an edge web on one frame per cycle). Moved by eps (0 = off) off the grid. */
+static inline float pdq_jitter_untie(float j, float eps)
+{
+    if (!(eps > 0.0f)) return j;
+    const float q = j * 4.0f;
+    if (fabsf(q - floorf(q + 0.5f)) >= 4e-4f) return j;
+    return j >= 0.5f - eps ? j - eps : j + eps;
+}
+
+/* D3D12_BLEND / D3D12_BLEND_OP values (R1's blend_key fields) -> neutral */
+static inline int pdq_bf_from_d3d12(unsigned v)
+{
+    switch (v) {
+    case 1: return PDQ_BF_ZERO;      case 2: return PDQ_BF_ONE;
+    case 3: return PDQ_BF_SRC_COLOR; case 4: return PDQ_BF_INV_SRC_COLOR;
+    case 5: return PDQ_BF_SRC_ALPHA; case 6: return PDQ_BF_INV_SRC_ALPHA;
+    case 7: return PDQ_BF_DST_ALPHA; case 8: return PDQ_BF_INV_DST_ALPHA;
+    case 9: return PDQ_BF_DST_COLOR; case 10: return PDQ_BF_INV_DST_COLOR;
+    default: return PDQ_BF_OTHER;
+    }
+}
+static inline int pdq_op_from_d3d12(unsigned v)
+{
+    switch (v) {
+    case 1: return PDQ_OP_ADD; case 2: return PDQ_OP_SUB; case 3: return PDQ_OP_REVSUB;
+    case 4: return PDQ_OP_MIN; case 5: return PDQ_OP_MAX; default: return PDQ_OP_OTHER;
+    }
+}
+/* CELL_GCM blend factors / equations (RSX registers; R2/R3 rsx::blend_factor / rsx::blend_equation) -> neutral */
+static inline int pdq_bf_from_gcm(unsigned v)
+{
+    switch (v) {
+    case 0x0000: return PDQ_BF_ZERO;          case 0x0001: return PDQ_BF_ONE;
+    case 0x0300: return PDQ_BF_SRC_COLOR;     case 0x0301: return PDQ_BF_INV_SRC_COLOR;
+    case 0x0302: return PDQ_BF_SRC_ALPHA;     case 0x0303: return PDQ_BF_INV_SRC_ALPHA;
+    case 0x0304: return PDQ_BF_DST_ALPHA;     case 0x0305: return PDQ_BF_INV_DST_ALPHA;
+    case 0x0306: return PDQ_BF_DST_COLOR;     case 0x0307: return PDQ_BF_INV_DST_COLOR;
+    default: return PDQ_BF_OTHER;
+    }
+}
+static inline int pdq_op_from_gcm(unsigned v)
+{
+    switch (v) {
+    case 0x8006: case 0xF006: case 0xF007: return PDQ_OP_ADD;   /* FUNC_ADD, ADD_SIGNED, REVERSE_ADD_SIGNED */
+    case 0x800A: return PDQ_OP_SUB;
+    case 0x800B: case 0xF005: return PDQ_OP_REVSUB;
+    case 0x8007: return PDQ_OP_MIN; case 0x8008: return PDQ_OP_MAX;
+    default: return PDQ_OP_OTHER;
+    }
+}
+
+/* ---- 2. history-reset triggers ---------------------------------------------------------------------- */
+
+#define PDQ_RESET_HITCH       1u  /* the previous frame took longer than PORT_DLSS_RESET_HITCH_MS */
+#define PDQ_RESET_RESOLUTION  2u  /* render or output size differs from the last evaluation */
+#define PDQ_RESET_CUT         4u  /* camera cut reported by the caller's camera logic */
+#define PDQ_RESET_TRANSITION  8u  /* load screen / menu -> gameplay (the upscaler skipped frames) */
+
+typedef struct pdq_reset_cfg {
+    int cuts;           /* PORT_DLSS_RESET_CUTS */
+    float hitch_ms;     /* PORT_DLSS_RESET_HITCH_MS, <= 0 = off */
+} pdq_reset_cfg;
+
+typedef struct pdq_reset_in {
+    float raw_dt_ms;              /* unclamped time since the last evaluation; <= 0 = unknown (first frame) */
+    uint32_t rw, rh, ow, oh;      /* this evaluation's render / output size */
+    uint32_t prw, prh, pow_, poh; /* the last evaluation's (0 = none yet) */
+    int cut;                      /* caller's camera-cut detector fired */
+    uint32_t skipped_frames;      /* frames since the last evaluation minus one */
+} pdq_reset_in;
+
+static inline int pdq_hitch(float hitch_ms, float raw_dt_ms)
+{
+    return hitch_ms > 0.0f && raw_dt_ms > hitch_ms;
+}
+
+/* The ports' own pauses (focus loss, quit prompt, extras menu, photo mode, controller lost) bump a pause
+ * generation on every pause and resume. An evaluation whose gap spans one is not a hitch: this returns the
+ * gap to use as raw_dt_ms (0 when the generation changed since the last evaluation) and records it. */
+static inline float pdq_pause_gap(float raw_dt_ms, uint32_t* last_gen, uint32_t gen)
+{
+    const int paused = *last_gen != gen;
+    *last_gen = gen;
+    return paused ? 0.0f : raw_dt_ms;
+}
+
+/* Bit set of PDQ_RESET_* that fire. With cfg {0, 0} it is always 0 (old behaviour). */
+static inline unsigned pdq_reset_reasons(const pdq_reset_cfg* c, const pdq_reset_in* in)
+{
+    unsigned r = 0;
+    if (!c || !in) return 0;
+    if (pdq_hitch(c->hitch_ms, in->raw_dt_ms)) r |= PDQ_RESET_HITCH;
+    if (c->cuts) {
+        if ((in->prw || in->prh || in->pow_ || in->poh) &&
+            (in->rw != in->prw || in->rh != in->prh || in->ow != in->pow_ || in->oh != in->poh))
+            r |= PDQ_RESET_RESOLUTION;
+        if (in->cut) r |= PDQ_RESET_CUT;
+        if (in->skipped_frames) r |= PDQ_RESET_TRANSITION;
+    }
+    return r;
+}
+
+/* ---- 3. render preset vs DLL version ---------------------------------------------------------------- */
+
+#define PDQ_PRESET_OK          0  /* honoured (or the default, 0) */
+#define PDQ_PRESET_UNSUPPORTED 1  /* this DLL predates the preset: NGX falls back to its default */
+#define PDQ_PRESET_DEPRECATED  2  /* deprecated in this DLL generation (DLSS 4, 310.x): may be ignored / remapped */
+#define PDQ_PRESET_REMOVED     3  /* removed in this DLL generation: reverts to the default */
+
+/* dll_major/minor: nvngx_dlss.dll file version (3.7.20.0 -> 3, 7; DLSS 4: 310.2.1.0 -> 310, 2).
+ * preset: NVSDK_NGX_DLSS_Hint_Render_Preset (A=1 ... F=6, J=10, K=11, L=12, M=13). */
+static inline int pdq_preset_check(unsigned dll_major, unsigned dll_minor, unsigned preset)
+{
+    if (!preset || !dll_major) return PDQ_PRESET_OK;    /* default / version unknown: nothing to say */
+    const int dlss4 = dll_major >= 310;
+    const int v3 = dll_major == 3 || dlss4;
+    if (preset >= 1 && preset <= 6) {
+        if (!v3 || (dll_major == 3 && dll_minor < 1)) return PDQ_PRESET_UNSUPPORTED;   /* presets came with 3.1 */
+        if (preset == 5 && dll_major == 3 && dll_minor < 7) return PDQ_PRESET_UNSUPPORTED; /* E came with 3.7 */
+        if (dlss4) return preset <= 4 ? PDQ_PRESET_REMOVED : PDQ_PRESET_DEPRECATED;
+        return PDQ_PRESET_OK;
+    }
+    if (preset >= 10 && preset <= 13) return dlss4 ? PDQ_PRESET_OK : PDQ_PRESET_UNSUPPORTED; /* transformer: 310+ */
+    return dlss4 ? PDQ_PRESET_REMOVED : PDQ_PRESET_UNSUPPORTED;   /* G/H/I/N/O: reserved */
+}
+
+static inline char pdq_preset_letter(unsigned preset)
+{
+    return preset >= 1 && preset <= 15 ? (char)('A' + preset - 1) : '-';
+}
+
+/* ---- 4. automatic preset from the GPU architecture (PORT_DLSS_AUTO_ARCH) ---------------------------- */
+
+#define PDQ_ARCH_UNKNOWN    0   /* not NVIDIA, pre-Turing, or an unlisted device ID: callers keep their old auto */
+#define PDQ_ARCH_TURING     1   /* RTX 20, GTX 16, Quadro RTX, TITAN RTX */
+#define PDQ_ARCH_AMPERE     2   /* RTX 30, RTX A-series (and GA100 / Hopper datacenter parts) */
+#define PDQ_ARCH_ADA        3   /* RTX 40, RTX Ada */
+#define PDQ_ARCH_BLACKWELL  4   /* RTX 50 */
+#define PDQ_ARCH_NEWER      5   /* device IDs past Blackwell's block: assumed FP8-capable like Ada+ */
+
+/* PCI vendor / device ID (VkPhysicalDeviceProperties vendorID / deviceID, DXGI_ADAPTER_DESC1 VendorId /
+ * DeviceId) -> architecture. NVIDIA allocates device IDs in contiguous blocks per generation:
+ * TU10x 0x1E00-0x1FFF, TU116/117 0x2180-0x21FF, GA100 0x20B0-0x20FF, GA10x (+GH100) 0x2200-0x25FF,
+ * AD10x 0x2600-0x28FF, GB10x/GB20x 0x2900-0x2FFF. */
+static inline int pdq_nv_arch(unsigned vendor, unsigned dev)
+{
+    if (vendor != 0x10DEu) return PDQ_ARCH_UNKNOWN;
+    if ((dev >= 0x1E00u && dev <= 0x1FFFu) || (dev >= 0x2180u && dev <= 0x21FFu)) return PDQ_ARCH_TURING;
+    if ((dev >= 0x20B0u && dev <= 0x20FFu) || (dev >= 0x2200u && dev <= 0x25FFu)) return PDQ_ARCH_AMPERE;
+    if (dev >= 0x2600u && dev <= 0x28FFu) return PDQ_ARCH_ADA;
+    if (dev >= 0x2900u && dev <= 0x2FFFu) return PDQ_ARCH_BLACKWELL;
+    if (dev >= 0x3000u && dev <= 0x3FFFu) return PDQ_ARCH_NEWER;
+    return PDQ_ARCH_UNKNOWN;
+}
+static inline const char* pdq_arch_name(int arch)
+{
+    switch (arch) {
+    case PDQ_ARCH_TURING: return "Turing (RTX 20)";
+    case PDQ_ARCH_AMPERE: return "Ampere (RTX 30)";
+    case PDQ_ARCH_ADA: return "Ada (RTX 40)";
+    case PDQ_ARCH_BLACKWELL: return "Blackwell (RTX 50)";
+    case PDQ_ARCH_NEWER: return "post-Blackwell";
+    default: return "unknown";
+    }
+}
+/* Auto preset: E (5, CNN) on Turing / Ampere (the transformer costs several times more there); 0 = NVIDIA's
+ * default on Ada and newer, which under DLSS 310 is itself mode-dependent (K for DLAA / Quality / Balanced,
+ * M for Performance, L for Ultra Performance). -1 = unknown: keep the old auto. */
+static inline int pdq_auto_preset(int arch)
+{
+    if (arch == PDQ_ARCH_TURING || arch == PDQ_ARCH_AMPERE) return 5;
+    if (arch == PDQ_ARCH_ADA || arch == PDQ_ARCH_BLACKWELL || arch == PDQ_ARCH_NEWER) return 0;
+    return -1;
+}
+/* PORT_DLSS_AUTO_ARCH (PORT_DLSS_AUTO_K is the old name, read when the new one is unset). def = the port's
+ * default: R1 1, R2/R3 0 (their old auto is a name heuristic; device-ID classification differs on a few
+ * datacenter / laptop parts, so it is opt-in there). 0 = the port's old auto. */
+static inline int pdq_auto_arch_enabled(int def)
+{
+    const char* e = getenv("PORT_DLSS_AUTO_ARCH");
+    if (!e || !*e) e = getenv("PORT_DLSS_AUTO_K");
+    return (e && *e) ? atoi(e) != 0 : def;
+}
+
+/* ---- 5. texture LOD bias for upscaled rendering (PORT_UPSCALE_LOD_BIAS) ---------------------------- */
+
+#define PDQ_LOD_UNSET   (-1)  /* not set: the port's own default bias logic runs unchanged */
+#define PDQ_LOD_FIXED   0     /* "off" / "0" / a number: that bias */
+#define PDQ_LOD_OUTPUT  1     /* "auto": log2(render / output) */
+#define PDQ_LOD_NV      3     /* "nv" / "auto-1": log2(render / output) - 1 (NVIDIA DLSS guide) */
+typedef struct pdq_lod_cfg { int mode; float value; } pdq_lod_cfg;
+
+static inline int pdq_streq_i(const char* a, const char* b)
+{
+    for (; *a && *b; a++, b++) {
+        char x = *a, y = *b;
+        if (x >= 'A' && x <= 'Z') x = (char)(x - 'A' + 'a');
+        if (y >= 'A' && y <= 'Z') y = (char)(y - 'A' + 'a');
+        if (x != y) return 0;
+    }
+    return *a == *b;
+}
+static inline pdq_lod_cfg pdq_lod_parse(const char* s)
+{
+    pdq_lod_cfg c; c.mode = PDQ_LOD_UNSET; c.value = 0.0f;
+    if (!s) return c;
+    while (*s == ' ') s++;
+    if (!*s) return c;
+    if (pdq_streq_i(s, "off")) { c.mode = PDQ_LOD_FIXED; return c; }
+    if (pdq_streq_i(s, "auto") || pdq_streq_i(s, "output")) { c.mode = PDQ_LOD_OUTPUT; return c; }
+    if (pdq_streq_i(s, "nv") || pdq_streq_i(s, "auto-1") || pdq_streq_i(s, "output-1")) { c.mode = PDQ_LOD_NV; return c; }
+    {
+        char* end = NULL;
+        const double v = strtod(s, &end);
+        if (end != s && (!*end || *end == ' ') && v == v) { c.mode = PDQ_LOD_FIXED; c.value = (float)v; }
+    }
+    return c;   /* garbage: unset (the port's default) */
+}
+/* ratio = render width / output width (1 when no upscaler runs). The automatic modes give 0 at native
+ * (DLAA / AA-only): there is no lower-resolution sampling to compensate. Result clamped to [lo, hi]. */
+static inline float pdq_lod_bias(const pdq_lod_cfg* c, float ratio, float lo, float hi)
+{
+    float b = 0.0f;
+    if (c->mode == PDQ_LOD_FIXED) b = c->value;
+    else if ((c->mode == PDQ_LOD_OUTPUT || c->mode == PDQ_LOD_NV) && ratio > 0.0f && ratio < 0.99f)
+        b = log2f(ratio) - (c->mode == PDQ_LOD_NV ? 1.0f : 0.0f);
+    if (b < lo) b = lo;
+    if (b > hi) b = hi;
+    return b;
+}
+
+/* ---- 6. noise in the upscaler input (R2/R3: RPCS3 alpha-to-coverage emulation, port SSAO) ----------- */
+
+/* RSX_AA_A2C: how RPCS3's alpha-to-coverage emulation (single-sample targets, i.e. under the upscaler) decides.
+ * NOISE (default): discard unless alpha > hash(gl_FragCoord) -- white noise fixed to the screen pixel; the jittered
+ * geometry slides under it, so A2C edges boil under DLSS/FSR. STABLE: alpha >= 0.5, a plain alpha test that the
+ * upscaler anti-aliases like any other edge. */
+#define PDQ_A2C_NOISE   0
+#define PDQ_A2C_STABLE  1
+static inline int pdq_a2c_parse(const char* s)
+{
+    if (!s) return PDQ_A2C_NOISE;
+    while (*s == ' ') s++;
+    if (pdq_streq_i(s, "stable") || pdq_streq_i(s, "threshold") || pdq_streq_i(s, "1")) return PDQ_A2C_STABLE;
+    return PDQ_A2C_NOISE;
+}
+
+/* RSX_SSAO_NOISE: the port SSAO picks one of 16 sample rotations per pixel from a 4x4 Bayer grid; its 4x4 blur
+ * averages all 16 on planes, but at depth edges a residue of the pattern remains, fixed to the screen pixel.
+ * FIXED (default): grid offset 0 every frame (the old pattern). TEMPORAL: the grid shifts by pdq_ssao_offset(run)
+ * each run, so every pixel cycles through all 16 rotations in 16 frames and the upscaler averages the residue. */
+#define PDQ_SSAO_FIXED     0
+#define PDQ_SSAO_TEMPORAL  1
+static inline int pdq_ssao_noise_parse(const char* s)
+{
+    if (!s) return PDQ_SSAO_FIXED;
+    while (*s == ' ') s++;
+    if (pdq_streq_i(s, "temporal") || pdq_streq_i(s, "1")) return PDQ_SSAO_TEMPORAL;
+    return PDQ_SSAO_FIXED;
+}
+/* Grid offset (x = o & 3, y = o >> 2) for run n: a Bayer-ordered walk, so any 4 consecutive runs land in
+ * different 2x2 quadrants of the grid. */
+static inline unsigned pdq_ssao_offset(unsigned n)
+{
+    static const unsigned char t[16] = { 0, 10, 2, 8, 5, 15, 7, 13, 1, 11, 3, 9, 4, 14, 6, 12 };
+    return t[n & 15u];
+}
+/* The rotation index (0..15) the AO shader uses at pixel (x, y) with grid offset o (CPU mirror of the GLSL). */
+static inline unsigned pdq_ssao_rotation(int x, int y, unsigned o)
+{
+    static const unsigned char bayer[16] = { 0, 8, 2, 10, 12, 4, 14, 6, 3, 11, 1, 9, 15, 7, 13, 5 };
+    return bayer[(((unsigned)y + (o >> 2)) & 3u) * 4u + (((unsigned)x + (o & 3u)) & 3u)];
+}
+
+/* RSX_AA_ATEST_MIPSCALE=k (R2/R3 only; default 0.15 under the upscaler in both since 11-15, R3 was off before):
+ * coverage-preserving alpha test for alpha-tested programs (and, RSX_AA_ATEST_MIPSCALE_A2C, for programs using the
+ * RSX_AA_A2C=stable alpha >= 0.5 test: g = 1 there). Box-filtered alpha mips average thin leaves below the GEQUAL/GREATER cutoff,
+ * so minified cut-out foliage thins out and its few surviving texels flicker under the jitter (distant vegetation
+ * boil). The test compares min(1, a * (1 + lod * k * g)), lod = the highest mip level read from the one 2D texture
+ * unit whose texels reach col0.a (decompiler data-flow; programs whose alpha is not sourced from exactly one 2D unit
+ * are left alone; textureQueryLod, pdq_atest_bias_lod for biased samples; RSXFragmentTextureOps.glsl /
+ * RSXROPEpilogue.glsl), applied only on jittered main-scene draws (depth pre-pass and material pass alike; shadow
+ * maps and other offscreen passes keep the plain test), g = clamp((ref - 0.3) / 0.2, 0, 1): with low
+ * cutoffs box-filtered masks already gain coverage in the mips, so only cutoffs above 0.3 are corrected (a simulation
+ * of leaf masks over refs 0.3-0.7 / mips 1-5 cut collapsed coverage 28 -> 8 cases at k 0.15 and lowered the mean
+ * coverage error; plain k 0.25 over-thickened). Mip 0 / magnified texels (lod <= 0), other test functions, alpha 0
+ * and alpha >= 1 are unchanged; the written colour never changes.
+ * Parse: unset/empty -> def; "off"/"0"/negative/garbage -> 0; clamped to [0, 1]. */
+static inline float pdq_atest_mipscale_parse(const char* s, float def)
+{
+    char* end = 0;
+    double v;
+    if (!s) return def;
+    while (*s == ' ') s++;
+    if (!*s) return def;
+    v = strtod(s, &end);
+    if (end == s || !(v > 0.0)) return 0.f;
+    return v > 1.0 ? 1.f : (float)v;
+}
+/* func = RSX alpha function & 7 (0 never, 1 less, 2 equal, 3 lequal, 4 greater, 5 nequal, 6 gequal, 7 always) */
+static inline float pdq_atest_ref_gate(float ref)
+{
+    const float g = (ref - 0.3f) / 0.2f;
+    return g > 1.f ? 1.f : (g > 0.f ? g : 0.f);
+}
+static inline float pdq_atest_mip_alpha(float a, float lod, float k, unsigned func, float ref)
+{
+    float s;
+    if ((func != 4u && func != 6u) || !(a < 1.f)) return a;
+    s = (a > 0.f ? a : 0.f) * (1.f + (lod > 0.f ? lod : 0.f) * k * pdq_atest_ref_gate(ref));
+    return s < 1.f ? s : 1.f;
+}
+/* Accessed level of a biased (TXB) sample. The shader queries textureQueryLod at the coordinate scaled by 2^bias
+ * (derivatives, hence lambda, grow by exactly the bias), so the hardware applies the sampler's clamps; this mirrors that
+ * result: lambda + bias clamped to the sampler's [min_lod, max_lod] (non-mipmap samplers: 0 / 0, so only level 0 is
+ * read whatever the bias) and then to the image's [0, levels - 1]. */
+static inline float pdq_atest_bias_lod(float lambda, float bias, float min_lod, float max_lod, int levels)
+{
+    const float hi = levels > 1 ? (float)(levels - 1) : 0.f;
+    float l = lambda + bias;
+    l = l < min_lod ? min_lod : (l > max_lod ? max_lod : l);
+    return l < 0.f ? 0.f : (l > hi ? hi : l);
+}
+
+/* RSX_DLSS_MASK_FAR=<distance> (R2/R3; default 60 view-distance units, "off"/"0" = old): the moving-object mask (prep
+ * pass: the previous depth around the camera-reprojected position deviates -> DLSS bias-current-colour) fades out with
+ * distance. Far away it fires mostly on cut-out foliage, whose sub-pixel leaves and the holes between them come and go
+ * with the jitter and the alpha mips (no motion at all): the mask then made DLSS take the current, aliased frame there,
+ * the same boil the rejected "reactive mask for alpha-tested draws" gave. Moving characters have their own velocity
+ * (RSX_DLSS_OBJMV) and the distant camera parallax is small. The fade works on the prep pass's depth linearisation
+ * lin = (1/z - 1/f) / (1/n - 1/f) (1 at near, 0 at far, standard and inverted depth alike; ~n/z): weight
+ * smoothstep(L, 2L, lin) with L = lin(distance), i.e. full mask nearer than ~distance/2, none beyond distance.
+ * Needs the camera planes (RSX_AA_CAMERA_EXACT); until they are known, and when distance >= far, the mask is unchanged.
+ * Parse: unset/empty -> def; "off"/"0"/negative/garbage -> 0; clamped to [1, 1e6]. */
+static inline float pdq_mask_far_parse(const char* s, float def)
+{
+    char* end = 0;
+    double v;
+    if (!s) return def;
+    while (*s == ' ') s++;
+    if (!*s) return def;
+    v = strtod(s, &end);
+    if (end == s || !(v > 0.0)) return 0.f;
+    return v < 1.0 ? 1.f : (v > 1e6 ? 1e6f : (float)v);
+}
+/* L for the shader: lin of view distance z with near n / far f; 0 (= no fade) when unknown or not inside (n, f) */
+static inline float pdq_mask_far_lin(float z, float n, float f)
+{
+    double l;
+    if (!(z > 0.f) || !(n > 0.f) || !(f > n) || !(z > n) || !(z < f)) return 0.f;
+    l = (1.0 / z - 1.0 / f) / (1.0 / n - 1.0 / f);
+    return l > 0.0 ? (float)l : 0.f;
+}
+/* mask weight at lin value l (CPU mirror of the GLSL smoothstep(L, 2L, l)); L <= 0: 1 */
+static inline float pdq_mask_far_weight(float l, float L)
+{
+    float t;
+    if (!(L > 0.f)) return 1.f;
+    t = (l - L) / L;
+    t = t < 0.f ? 0.f : (t > 1.f ? 1.f : t);
+    return t * t * (3.f - 2.f * t);
+}
+/* ---- RSX_AA_MV_CONFIDENCE verdict ------------------------------------------------------------------- */
+
+/* Depth-grid check of a camera transform (r2aa_conf_pass): valid samples, samples deviating from the previous depth
+   with the transform (bad) and with no motion (bad_id). Returns 1 = reject the transform (more than bad_frac of the
+   samples off and clearly worse than no motion), 0 = keep, -1 = too few samples for a verdict. */
+static inline int pdq_mv_conf_verdict(unsigned valid, unsigned bad, unsigned bad_id, float bad_frac)
+{
+    if (valid < 64u) return -1;
+    return ((float)bad > (float)valid * bad_frac && bad > bad_id + bad_id / 2u + valid / 16u) ? 1 : 0;
+}
+
+/* ---- soft-reset rate limit (RSX_AA_CUT_PARALLAX_GAP, RSX_AA_MV_CONFIDENCE_GAP) -------------------------- */
+
+/* A trigger at `frame` may reset the history only when the last reset of the same kind was at least `gap` frames
+   earlier (gap 0: always). Only a trigger that resets restarts the window: a run of false triggers a few frames apart
+   (R2 intro: a parallax "cut" every 1-8 frames) resets at most once per `gap` frames, and a continuous run cannot hold
+   the window open forever. */
+typedef struct pdq_gap
+{
+    uint32_t last;
+    int any;
+} pdq_gap;
+
+static inline int pdq_gap_ready(const pdq_gap* g, uint32_t frame, uint32_t gap)
+{
+    return !gap || !g->any || frame - g->last >= gap;
+}
+
+static inline void pdq_gap_mark(pdq_gap* g, uint32_t frame)
+{
+    g->last = frame;
+    g->any = 1;
+}
+
+/* ready + mark when the trigger resets */
+static inline int pdq_gap_reset(pdq_gap* g, uint32_t frame, uint32_t gap)
+{
+    const int ok = pdq_gap_ready(g, frame, gap);
+    if (ok) pdq_gap_mark(g, frame);
+    return ok;
+}
+
+/* ---- held-back parallax cuts (RSX_AA_CUT_PARALLAX_GAP) ------------------------------------------------------- */
+
+/* Depth-grid result of a held-back parallax cut: a real cut leaves most samples off with the voted motion AND with no
+   motion. Voted motion off but no motion fine = a wrong transform (the RSX_AA_MV_CONFIDENCE reject path), not a cut. */
+#define PDQ_CUT_CONFIRM_FRAC 0.70f
+
+static inline int pdq_mv_conf_cut(unsigned valid, unsigned bad, unsigned bad_id, float frac)
+{
+    return valid >= 64u && (float)bad > (float)valid * frac && (float)bad_id > (float)valid * frac;
+}
+
+/* The voted motion of a held-back parallax cut is trusted only with a clear majority and a parallax not far beyond the
+   distant motion (R2 intro: 7-9 of 17-50 draws, distant 0.01-0.06 vs parallax 0.22-0.37 of the screen = wrong T). */
+static inline int pdq_par_trusted(unsigned members, unsigned matched, double motion, double par)
+{
+    return members * 2u >= matched && par <= 4.0 * (motion > 0.01 ? motion : 0.01);
+}
+
+/* The last trusted camera motion may stand in for a missing / untrusted vote only while it is at most `hold` frames old
+   (RSX_AA_VOTE_HOLD; < 0 = unlimited): alternating held / failed frames must not reproject with an ever older motion. */
+static inline int pdq_last_t_usable(int hold, uint32_t now, uint32_t last_frame)
+{
+    return hold < 0 || now - last_frame <= (uint32_t)hold;
+}
+
+/* Confirmed real cuts: rate-limited by `gap` frames, but deferred rather than dropped -- a cut seen while the gap is
+   closed resets when it opens (at most `gap` frames late). `cut` = a held frame's depth check found a real cut this
+   frame. Returns 1 = reset now. The caller clears `pend` when the history was reset for another reason. */
+typedef struct pdq_cut_confirm
+{
+    pdq_gap gap;
+    uint32_t pend; /* frame + 1 of the first deferred cut, 0 = none */
+} pdq_cut_confirm;
+
+static inline int pdq_cut_confirm_step(pdq_cut_confirm* c, uint32_t now, uint32_t gap, int cut)
+{
+    if (cut && !c->pend) c->pend = now + 1u;
+    if (!c->pend || !pdq_gap_ready(&c->gap, now, gap)) return 0;
+    c->pend = 0;
+    pdq_gap_mark(&c->gap, now);
+    return 1;
+}
+
+/* Held frames per conf readback slot (frame & 7): frame + 1, 0 = none. */
+typedef struct pdq_held
+{
+    uint32_t at[8];
+} pdq_held;
+
+/* Returns 1 when the slot still held an unchecked frame (dropped). */
+static inline int pdq_held_push(pdq_held* h, uint32_t frame)
+{
+    const int dropped = h->at[frame & 7u] != 0;
+    h->at[frame & 7u] = frame + 1u;
+    return dropped;
+}
+
+/* A history reset (any reason, incl. a confirmed cut): frames held before it must not confirm a cut on the clean
+   history afterwards. */
+static inline void pdq_held_clear(pdq_held* h)
+{
+    for (int s = 0; s < 8; ++s) h->at[s] = 0;
+}
+
+/* First held slot >= start whose readback may be read at `now` (age lag..7; the slot is reused at age 8). Older entries
+   are dropped and counted in *expired. The caller clears a slot once read; one not ready yet is retried next frame. */
+static inline int pdq_held_next(pdq_held* h, uint32_t now, uint32_t lag, int start, uint32_t* frame, unsigned* expired)
+{
+    for (int s = start; s < 8; ++s)
+    {
+        if (!h->at[s]) continue;
+        const uint32_t f = h->at[s] - 1u, age = now - f;
+        if (age > 7u) { h->at[s] = 0; ++*expired; continue; }
+        if (age < lag) continue;
+        *frame = f;
+        return s;
+    }
+    return -1;
+}
+
+/* ---- depth latch / scene vote (RSX_AA_DS_LATCH) ----------------------------------------------------- */
+
+/* RSX_AA_LATCH_KEEP: an aged depth latch (>= 2 logical frames) may change scale only where no depth of the current
+   real frame is in it: not after a write in this logical frame, nor after one in the previous logical frame when this
+   one began at a partial (flip-less) boundary. Else an EQUAL pass tests a resampled depth (purple/green walls). */
+static inline int pdq_latch_expires(uint32_t frame, uint32_t latch_frame, uint32_t wframe, int written, int part_start, int keep)
+{
+    if (frame - latch_frame < 2u) return 0;
+    if (keep && written && (wframe == frame || (part_start && wframe + 1u == frame))) return 0;
+    return 1;
+}
+
+/* RSX_AA_CLASSIFY_PARTIAL: a vote window that found no scene keeps the valid one when it was a partial frame (no flip)
+   or the depth latch is skipping the upscaler (the window missed the pre-pass), at most `cap` windows in a row */
+static inline int pdq_partial_hold(int found, int was_valid, int split, int enabled, unsigned win_flips, unsigned lat_skip_run,
+    unsigned held_in_row, unsigned cap)
+{
+    if (found || !was_valid || !split || !enabled || held_in_row >= cap) return 0;
+    return win_flips == 0u || lat_skip_run > 0u;
+}
+
+/* RSX_AA_JITTER_HOLD: a logical frame that began at a flip-less boundary keeps the previous logical frame's jitter
+   (no Halton step), so one game frame's pre-pass, material pass and upscaler run share one jitter. */
+static inline int pdq_jitter_hold(int enabled, int part_start, int jitter_on, int prev_on, unsigned held_in_row, unsigned cap)
+{
+    return enabled && part_start && jitter_on && prev_on && held_in_row < cap;
+}
+
+/* ---- decal depth bias (RSX_DECAL_ZBIAS) ------------------------------------------------------------- */
+
+/* RSX_DECAL_ZBIAS_NOWRITE (default 0 = off; opt-in): a depth-tested quad (3..6 elements) that writes no depth, tests
+   LEQUAL (never EQUAL / LESS), writes colour without stencil, is alpha-tested / KIL (blended-only cards: glow, sparks, fog,
+   glass, water are excluded) and draws into the scene-size target gets the decal bias without a matching pre-pass draw.
+   Nothing later depth-tests against a draw that wrote no depth, so its bias cannot fail an EQUAL pass (no green /
+   purple). Off by default: the hook sees neither the quad's projected size nor whether it lies on existing depth, so a
+   large or distant alpha-tested no-write quad would also be pulled forward (96 D24 steps = tens of cm far away). */
+static inline int pdq_decal_nowrite_bias(int enabled, int lequal, int zwrite, int scene, int color_write, int stencil,
+    int tested, unsigned elements)
+{
+    return enabled && lequal && !zwrite && scene && color_write && !stencil && tested && elements >= 3u && elements <= 6u;
+}
+
+/* RSX_DECAL_ZBIAS pre-pass table: two draws are one entry when their address key, vertex streams, bias and whether
+   constants were stored agree (plus their transform constants, compared by the caller). The content key of
+   RSX_DECAL_ZBIAS_PAIR is deliberately not part of it: content entries live in a table of their own, so the decal
+   table holds the same entries (and fills up at the same draw) whatever RSX_DECAL_ZBIAS_PAIR is. */
+typedef struct pdq_decal_id
+{
+    unsigned long long key, streams;
+    int biased, has_consts;
+} pdq_decal_id;
+
+static inline int pdq_decal_same_draw(const pdq_decal_id* a, const pdq_decal_id* b)
+{
+    return a->key == b->key && a->streams == b->streams && !a->biased == !b->biased && !a->has_consts == !b->has_consts;
+}
+
+/* reference model of the table (linear, constants agreeing): index of the entry the draw merges into or was added
+   as, -1 when the table is full */
+static inline int pdq_decal_table_note(pdq_decal_id* tab, unsigned* n, unsigned cap, const pdq_decal_id* d)
+{
+    unsigned i;
+    for (i = 0; i < *n; ++i)
+        if (pdq_decal_same_draw(&tab[i], d)) return (int)i;
+    if (*n >= cap) return -1;
+    tab[*n] = *d;
+    return (int)(*n)++;
+}
+
+/* RSX_DECAL_ZBIAS_PAIR (default 0; 1 = bias, 2 = learn and log only): a depth-writing pre-pass quad (3..6 elements,
+   LESS / LEQUAL, opaque or alpha-tested) and the depth EQUAL quad redraw that repeats it in the material pass are paired
+   by content instead of buffer address (R3's SPU ring moves the vertex buffers between the passes): the same position
+   bytes in index order (pdq_fnv64 below) and the same values in every transform constant both vertex programs read
+   (at least min_shared registers compared, none differing). A key is learned per content hash over whole frames: a
+   frame where every pre-pass draw of the key had exactly one paired redraw and no redraw of the key disagreed counts
+   one; anything else starts again. After 'need' such frames both draws of the pair get the same constant depth bias,
+   so the EQUAL test still passes. A biased pre-pass draw whose redraw did not come (the pre-pass normals showed for one
+   frame) blocks the key for 'block' frames. */
+typedef struct pdq_pair_state
+{
+    unsigned confirm;     /* consecutive frames with every pre-pass draw paired exactly once */
+    unsigned block_until; /* frame number before which the key is never biased */
+} pdq_pair_state;
+
+static inline unsigned long long pdq_fnv64(unsigned long long h, const void* data, unsigned n)
+{
+    const unsigned char* p = (const unsigned char*)data;
+    unsigned i;
+    for (i = 0; i < n; ++i) h = (h ^ p[i]) * 1099511628211ull;
+    return h;
+}
+
+static inline int pdq_pair_consts_ok(unsigned shared, unsigned differing, unsigned min_shared)
+{
+    return differing == 0u && shared >= min_shared;
+}
+
+static inline int pdq_pair_bias(int mode, const pdq_pair_state* s, unsigned frame, unsigned need)
+{
+    return mode == 1 && s && need && s->confirm >= need && frame >= s->block_until;
+}
+
+/* End of a frame for one key: entries = its pre-pass draws, exact = those with exactly one paired redraw, mismatched =
+   its redraws whose constants disagreed with every pre-pass draw, biased_lost = biased pre-pass draws left unpaired. */
+static inline void pdq_pair_frame_end(pdq_pair_state* s, unsigned frame, unsigned entries, unsigned exact,
+    unsigned mismatched, unsigned biased_lost, unsigned block)
+{
+    if (biased_lost)
+    {
+        s->confirm = 0u;
+        s->block_until = frame + block;
+        return;
+    }
+    if (!entries && !mismatched) return;
+    if (entries && exact == entries && !mismatched)
+    {
+        if (s->confirm < 0xffffu) s->confirm++;
+    }
+    else s->confirm = 0u;
+}
+
+/* ---- deferred light quads (RSX_AA_LIGHT_JITTER) ------------------------------------------------------ */
+
+/* RSX_AA_LIGHT_JITTER (default 1 since r10, 0 = off): a stencil-tested light quad (3..6 elements, colour, no depth write) whose
+   bound depth-stencil holds the jittered stencil marks gets the same shift (the caller also requires that no texture
+   coordinate of its vertex program already follows the jitter: RSX_AA_UV_JITTER outputs). */
+static inline int pdq_light_jitter_draw(int enabled, int color_write, int zwrite, int stencil, unsigned elements)
+{
+    return enabled && color_write && !zwrite && stencil && elements >= 3u && elements <= 6u;
+}
+
+/* Normalised coordinate bias that undoes the quad's shift (quad_px of quad_dim pixels) for a screen texture sampled
+   through an interpolated coordinate, so it is read where it was before. The texture's own content shift (tex_px of
+   tex_dim texels) must be the same fraction of the screen within tol_px texels; otherwise 0 (refuse the draw). */
+static inline int pdq_light_jitter_bias(float quad_px, unsigned quad_dim, float tex_px, unsigned tex_dim, float tol_px,
+    float* bias)
+{
+    float qf, tf;
+    if (!quad_dim || !tex_dim) return 0;
+    qf = quad_px / (float)quad_dim;
+    tf = tex_px / (float)tex_dim;
+    if (fabsf(qf - tf) * (float)tex_dim > tol_px) return 0;
+    *bias = qf;
+    return 1;
+}
+
+/* RSX_AA_LIGHT_SMAP (default 1, 0 = off): a texture of the light quad sampled with a depth format (the shadow compare
+   formats DEPTH24_D8 .. DEPTH16_FLOAT, 0x90..0x93 without the LN/UN bits) whose guest size is not screen-shaped (the
+   aspect of the clip, or twice as wide: R3's 2x-wide depth view) is a shadow map, never a screen texture: it must follow
+   the shifted position like any world-space lookup and never get the screen bias, even if its address is in the
+   jittered-target set. */
+static inline int pdq_light_shadow_tex(unsigned fmt, unsigned tw, unsigned th, unsigned cw, unsigned ch)
+{
+    double r;
+    if (fmt < 0x90u || fmt > 0x93u) return 0;
+    if (!tw || !th || !cw || !ch) return 1;
+    r = ((double)tw * (double)ch) / ((double)th * (double)cw);
+    return !((r > 0.98 && r < 1.02) || (r > 1.96 && r < 2.04));
+}
+
+/* ---- shadow map scale (RSX_SHADOW_SCALE_CAP) --------------------------------------------------------- */
+
+/* Whether a depth target gets the capped scale (cap_pct, >= 25) instead of the global one: every depth-only Z16 map up
+   to 2048 (any size or aspect: the maps RSX_SHADOW_NATIVE covers) and, as before, any depth-only square power-of-two
+   target of 256..2048. Maps packed back to back and sampled as one taller texture must all share one scale. */
+static inline int pdq_shadow_cap_applies(int cap_pct, unsigned global_pct, int depth_only, int z16, unsigned w, unsigned h)
+{
+    if (cap_pct < 25 || global_pct <= (unsigned)cap_pct || !depth_only || !w || !h || w > 2048u || h > 2048u) return 0;
+    if (z16) return 1;
+    return w == h && w >= 256u && (w & (w - 1u)) == 0u;
+}
+
+/* RSX_SHADOW_SLOPE_K (default 1 = off, opt-in 1..8): extra multiplier on the polygon-offset slope factor of the shadow
+   maps (every Z16 depth-only target up to 2048, plus RSX_SHADOW_SCALE's square maps), on top of any resolution ratio
+   (RSX_SHADOW_NATIVE, RSX_SHADOW_SCALE_CAP, RSX_SHADOW_SCALE; at the global scale when none of them applies). More caster slope bias for thin / grazing casters (grass blades, blind slats) whose self-shadow acne shows as
+   hatched stripes. Anything not > 1 (or NaN) is 1; above 8 is 8. */
+static inline float pdq_shadow_slope_k(float v)
+{
+    if (!(v > 1.f)) return 1.f;
+    return v > 8.f ? 8.f : v;
+}
+
+/* ---- compensated vertex-program dot product (RSX_VP_PRECISE_DOT) ------------------------------------ */
+
+/* Dot2 (Ogita, Rump, Oishi 2005): a.b as if computed in twice the working precision, then rounded once. The vertex
+   shaders' DP4 of a world position with a view-projection row adds terms of ~18 that cancel to ~6 (clip z); a plain
+   fp32 dot leaves a few D24 steps of camera-dependent noise per vertex, so the line where a poster meets its wall moved
+   by pixels between frames. R2/R3 emit the same sequence in GLSL (_r2_dp4, VKR2Gfx.cpp); this mirror is for the unit
+   tests. fmaf must be a fused multiply-add; the sums must not be reassociated (GLSL: precise). Inf/NaN: plain dot. */
+static inline void pdq_two_sum(float a, float b, float* s, float* e)
+{
+    volatile float q = a + b;
+    volatile float z = q - a;
+    *s = q;
+    *e = (a - (q - z)) + (b - z);
+}
+static inline float pdq_dot2(const float* a, const float* b, int n)
+{
+    float p, s, h, r, q, e;
+    int i;
+    if (n <= 0) return 0.f;
+    p = a[0] * b[0];
+    s = fmaf(a[0], b[0], -p);
+    for (i = 1; i < n; ++i)
+    {
+        h = a[i] * b[i];
+        r = fmaf(a[i], b[i], -h);
+        pdq_two_sum(p, h, &q, &e);
+        p = q;
+        s = s + (e + r);
+    }
+    r = p + s;
+    if (!(fabsf(r) <= 3.402823466e+38f))
+    {
+        r = 0.f;
+        for (i = 0; i < n; ++i) r += a[i] * b[i];
+    }
+    return r;
+}
+
+/* ---- frame screen transform by vote (RSX_AA_FRAME_S_VOTE) -------------------------------------------- */
+
+/* The camera reprojection is T = S_prev * R * S_cur^-1, with S the vertex env's screen transform (8 floats: sx, ox, sy,
+   oy, sz, oz, near, far), by default the LAST scene draw's. Suspected (R14) of giving DLSS a >= 1 px whole-screen motion
+   in the still R3 diner; refuted by its own log (the diner never mixed transforms; the jolts' game VP changed), and the
+   vote picked a depth range of 0.2 (weapon draws) over the world's 1 in R3 T1 (camera-cut resets), so it is off. The tally
+   counts every scene draw's S (bitwise), depth-writing draws apart, and pdq_s_pick returns the one most depth-writing
+   draws used (then most draws; then the first seen). A draw is counted with the env bound when it is classified
+   (pdq_s_add) and moved to its own S if its env is refilled afterwards (pdq_s_amend); pdq_s_draw_begin at every draw
+   ends the previous one. Up to PDQ_S_SLOTS distinct S; further ones are only counted in 'extra'. */
+#define PDQ_S_SLOTS 4
+typedef struct pdq_s_tally
+{
+    float v[PDQ_S_SLOTS][8];
+    unsigned n[PDQ_S_SLOTS], dw[PDQ_S_SLOTS];
+    unsigned cnt, extra;
+    int pend, pend_dw, pend_set; /* the draw being set up: its slot (-1: in extra), depth write, counted at all */
+} pdq_s_tally;
+
+static inline void pdq_s_reset(pdq_s_tally* t)
+{
+    t->cnt = 0;
+    t->extra = 0;
+    t->pend = -1;
+    t->pend_dw = 0;
+    t->pend_set = 0;
+}
+
+static inline void pdq_s_draw_begin(pdq_s_tally* t)
+{
+    t->pend_set = 0;
+}
+
+static inline int pdq_s_find(const pdq_s_tally* t, const float* s)
+{
+    unsigned k;
+    for (k = 0; k < t->cnt; ++k)
+        if (memcmp(t->v[k], s, sizeof(t->v[k])) == 0) return (int)k;
+    return -1;
+}
+
+/* counts one draw with transform s; returns its slot (-1: table full, counted in extra). Also the pending draw. */
+static inline int pdq_s_add(pdq_s_tally* t, const float* s, int dwrite)
+{
+    int k = pdq_s_find(t, s);
+    if (k < 0)
+    {
+        if (t->cnt >= PDQ_S_SLOTS)
+        {
+            t->extra++;
+            t->pend = -1;
+            t->pend_dw = dwrite != 0;
+            t->pend_set = 1;
+            return -1;
+        }
+        k = (int)t->cnt++;
+        memcpy(t->v[k], s, sizeof(t->v[k]));
+        t->n[k] = t->dw[k] = 0;
+    }
+    t->n[k]++;
+    if (dwrite) t->dw[k]++;
+    t->pend = k;
+    t->pend_dw = dwrite != 0;
+    t->pend_set = 1;
+    return k;
+}
+
+/* the current draw's env was (re)filled with transform s: its vote moves there (a draw not counted yet is counted
+   now). Ends the current draw. */
+static inline void pdq_s_amend(pdq_s_tally* t, const float* s, int dwrite)
+{
+    if (t->pend_set)
+    {
+        const int p = t->pend;
+        dwrite = t->pend_dw;
+        if (p >= 0 && memcmp(t->v[p], s, sizeof(t->v[p])) == 0)
+        {
+            t->pend_set = 0;
+            return;
+        }
+        if (p >= 0)
+        {
+            t->n[p]--;
+            if (dwrite) t->dw[p]--;
+        }
+        else if (t->extra) t->extra--;
+    }
+    pdq_s_add(t, s, dwrite);
+    t->pend_set = 0;
+}
+
+/* slot of the frame's transform: most depth-writing draws, then most draws, then first seen; -1: none counted */
+static inline int pdq_s_pick(const pdq_s_tally* t)
+{
+    int b = -1;
+    unsigned k;
+    for (k = 0; k < t->cnt; ++k)
+    {
+        if (!t->n[k]) continue;
+        if (b < 0 || t->dw[k] > t->dw[b] || (t->dw[k] == t->dw[b] && t->n[k] > t->n[b])) b = (int)k;
+    }
+    return b;
+}
+
+/* ---- env helpers ------------------------------------------------------------------------------------ */
+
+static inline int pdq_env_int(const char* name, int def)
+{
+    const char* e = getenv(name);
+    return (e && *e) ? atoi(e) : def;
+}
+static inline float pdq_env_float(const char* name, float def)
+{
+    const char* e = getenv(name);
+    return (e && *e) ? (float)atof(e) : def;
+}
+
+#endif /* PORT_DLSS_QUALITY_H */
