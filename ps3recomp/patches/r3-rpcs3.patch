+namespace vk
+{
+	// Alpha-tested foliage/fences: a negative LOD bias sharpens the alpha mask, so its cut-out edge aliases at the
+	// internal resolution and DLSS cannot resolve it (shimmer). Those draws keep at least atest_floor.
+	float r2aa_lod_bias()
+	{
+		const auto& st = g_r2;
+		return (st.atest_now && r2cfg().atest) ? std::fmax(st.bias_now, r2cfg().atest_floor) : st.bias_now;
+	}
+
+	bool r2aa_alpha_tested(bool atest)
+	{
+		auto& st = g_r2;
+		const bool changed = atest != st.atest_now;
+		st.atest_now = atest;
+		if (!changed || !r2cfg().atest || st.bias_now >= r2cfg().atest_floor) return false;
+		static bool logged = false;
+		if (!logged)
+		{
+			logged = true;
+			r2log("mip bias %.2f for alpha-tested/KIL draws (scene %.2f; RSX_AA_MIPBIAS_ATEST=on|off|<bias>)", r2cfg().atest_floor, st.bias_now);
+		}
+		return true;
+	}
+
+	bool r2aa_active()
+	{
+		return r2cfg().mode && !g_r2.disabled;
+	}
+
+	void r2aa_camera(float& n, float& f, float& fov)
+	{
+		const float cn = g_r2.cam_n, cf = g_r2.cam_f, cv = g_r2.cam_fov;
+		if (cn > 0.f && cf > cn && cv > 0.f) { n = cn; f = cf; fov = cv; }
+		else { n = 0.1f; f = 1000.f; fov = 1.0f; }
+	}
+
+	// RSX_PRESENT_DOWNSCALE (default 1; 0 = RPCS3's single bilinear blit): res=3 into a 900p window shrinks the
+	// 3840x2112 image 2.4:1. One bilinear blit reads 2x2 of every ~2.4x2.4 source pixels: thin lines (wire fences,
+	// branches, cables) fall between the taps or not as they move by a fraction of a pixel and crawl ("boiling").
+	// Exact 2:1 linear blits (a 2x2 box each) first, until less than 2:1 remains for the final bilinear blit.
+	vk::viewable_image* r2_present_downscale(const vk::command_buffer& cmd, vk::viewable_image* src, u32& w, u32& h, u32 dw, u32 dh)
+	{
+		static const bool on = [] { const char* e = std::getenv("RSX_PRESENT_DOWNSCALE"); return !e || std::atoi(e) != 0; }();
+		static std::vector<std::unique_ptr<vk::viewable_image>> chain;
+		static u32 logged = 0;
+		if (!on || !src || !dw || !dh || w / 2 < dw || h / 2 < dh) return src;
+		auto* pdev = vk::get_current_renderer();
+		const VkFormat fmt = src->format();
+		const VkFormatFeatureFlags need = VK_FORMAT_FEATURE_BLIT_SRC_BIT | VK_FORMAT_FEATURE_BLIT_DST_BIT | VK_FORMAT_FEATURE_SAMPLED_IMAGE_FILTER_LINEAR_BIT;
+		if ((pdev->get_format_properties(fmt).optimalTilingFeatures & need) != need || src->aspect() != VK_IMAGE_ASPECT_COLOR_BIT) return src;
+		const u32 w0 = w, h0 = h;
+		vk::viewable_image* cur = src;
+		u32 n = 0;
+		while (w / 2 >= dw && h / 2 >= dh && n < 4)
+		{
+			const u32 nw = w / 2, nh = h / 2;
+			if (chain.size() <= n) chain.emplace_back();
+			auto& img = chain[n];
+			if (img && (img->width() != nw || img->height() != nh || img->format() != fmt))
+				vk::get_resource_manager()->dispose(img);
+			if (!img)
+			{
+				img = std::make_unique<vk::viewable_image>(*pdev, pdev->get_memory_mapping().device_local, VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT,
+					VK_IMAGE_TYPE_2D, fmt, nw, nh, 1, 1, 1, VK_SAMPLE_COUNT_1_BIT, VK_IMAGE_LAYOUT_UNDEFINED, VK_IMAGE_TILING_OPTIMAL,
+					VK_IMAGE_USAGE_TRANSFER_SRC_BIT | VK_IMAGE_USAGE_TRANSFER_DST_BIT | VK_IMAGE_USAGE_SAMPLED_BIT,
+					vk::VK_IMAGE_CREATE_ALLOW_NULL_RPCS3, VMM_ALLOCATION_POOL_SWAPCHAIN, RSX_FORMAT_CLASS_COLOR);
+				if (!img->value)
+				{
+					img.reset();
+					break;
+				}
+			}
+			VkImageBlit b{};
+			b.srcSubresource = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1 };
+			b.dstSubresource = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1 };
+			b.srcOffsets[1] = { s32(nw * 2), s32(nh * 2), 1 };
+			b.dstOffsets[1] = { s32(nw), s32(nh), 1 };
+			cur->push_layout(cmd, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL);
+			img->change_layout(cmd, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL);
+			vkCmdBlitImage(cmd, cur->value, cur->current_layout, img->value, img->current_layout, 1, &b, VK_FILTER_LINEAR);
+			cur->pop_layout(cmd);
+			cur = img.get();
+			w = nw;
+			h = nh;
+			n++;
+		}
+		if (n && logged < 4)
+		{
+			logged++;
+			r2log("present downscale: %ux%u -> %ux%u (%u x 2:1 box) -> %ux%u bilinear (RSX_PRESENT_DOWNSCALE=0: one bilinear blit)",
+				w0, h0, w, h, n, dw, dh);
+		}
+		return cur;
+	}
+}
+
+void VKGSRender::r2aa_set_section(bool on)
+{
+	auto& st = g_r2;
+	if (on == st.section) return;
+	auto& cfg = RSX(m_ctx)->resolution_scaling_config;
+	if (on)
+	{
+		const float pct = std::round(static_cast<float>(cfg.scale_percent) * r2cfg().upscale);
+		cfg.scale_percent = static_cast<u16>(std::max(10.f, pct));
+		st.red_cfg = cfg;
+		st.section = true;
+	}
+	else
+	{
+		cfg = st.full_cfg;
+		st.section = false;
+	}
+	// Viewport/scissor/WPOS and point size depend on the active scale
+	m_ctx->draw_state.dirty.set(rsx::draw_state_t::group::viewport);
+	m_ctx->draw_state.dirty.set(rsx::draw_state_t::group::scissor);
+	m_ctx->draw_state.dirty.set(rsx::draw_state_t::group::vertex_env);
+	m_ctx->draw_state.dirty.set(rsx::draw_state_t::group::fragment_env);
+}
+
+void VKGSRender::r2aa_writeback()
+{
+	auto& st = g_r2;
+	if (!st.wb_armed) return;
+	st.wb_armed = false;
+	run_timer timer(false);
+
+	auto& sc = res()->surface_cache;
+	auto& cmd = *m_current_command_buffer;
+	auto miss = [&](const std::string& why)
+	{
+		// Show the plain (scaled) frame
+		st.stat_wb_miss++;
+		st.jitter_cooldown = 10;
+		skip_once("upscaled scene could not be written back (" + why + ")");
+	};
+	if (!st.final_img) return miss("no result");
+
+	// Replace the reduced-scale scene surface with a full-resolution one holding the upscaled result. This runs before
+	// the next targets are bound, so whatever follows (post passes sampling the scene, or quarter-size buffers that
+	// alias its memory and inherit from it) sees the upscaled scene.
+	auto* old = sc.get_surface_at(st.scene_rt);
+	if (!old || old->is_depth_surface() || old->samples() > 1 || old->info.format != st.res_fmt)
+		return miss("scene surface gone");
+	if (r2cfg().strict && old != st.wb_src)
+		return miss("the scene address was rebound before the writeback");
+	if (vk::is_renderpass_open(cmd)) vk::end_renderpass(cmd);
+	auto* rt = old;
+	if (old->info.extent.width < st.out_w || old->info.extent.height < st.out_h)
+	{
+		rt = sc.r2_rescale_color_surface(cmd, old, st.full_cfg);
+		if (!rt) return miss("full-resolution surface could not be created");
+	}
+	// The surface now at the scene address may be another layout of the same memory: write the overlap.
+	const u32 cw = std::min(st.out_w, rt->info.extent.width);
+	const u32 ch = std::min(st.out_h, rt->info.extent.height);
+	if (cw * 4 < st.out_w * 3 || ch * 4 < st.out_h * 3)
+		return miss("full-resolution surface too small: " + std::to_string(rt->info.extent.width) + "x" + std::to_string(rt->info.extent.height) +
+			" for " + std::to_string(st.out_w) + "x" + std::to_string(st.out_h));
+	if ((cw < st.out_w || ch < st.out_h) && r2cfg().strict)
+		return miss("the surface at the scene address has another layout");
+	if ((cw < st.out_w || ch < st.out_h) && !st.stat_wb_clipped++)
+		r2log("upscaled scene %ux%u written to a %ux%u surface (overlap)", st.out_w, st.out_h, rt->info.extent.width, rt->info.extent.height);
+	if (!st.stat_wb_direct++) r2log("upscaled scene written to a %ux%u surface", rt->info.extent.width, rt->info.extent.height);
+	if (r2cfg().trace && (st.frame % static_cast<u32>(r2cfg().trace)) == 0 && st.frame)
+		r2log("T f%u WB old %ux%u (native %ux%u, %u%%) -> rt %ux%u (native %ux%u, %u%%) out %ux%u", st.frame,
+			old->info.extent.width, old->info.extent.height, old->get_surface_width(), old->get_surface_height(), old->resolution_scaling_config.scale_percent,
+			rt->info.extent.width, rt->info.extent.height, rt->get_surface_width(), rt->get_surface_height(), rt->resolution_scaling_config.scale_percent,
+			st.out_w, st.out_h);
+
+	rt->memory_barrier(cmd, rsx::surface_access::transfer_write); // pulls in the inherited (scaled) contents first
+	rt->push_layout(cmd, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL);
+	VkImageCopy region{};
+	region.srcSubresource = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1 };
+	region.dstSubresource = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1 };
+	region.extent = { cw, ch, 1 };
+	vkCmdCopyImage(cmd, st.final_img->value, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, rt->value, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, 1, &region);
+	rt->pop_layout(cmd);
+	rt->on_write_copy(rsx::get_shared_tag());
+
+	cmd.r2_invalidate_state_cache();
+	m_current_command_buffer->flags |= vk::command_buffer::cb_reload_dynamic_state;
+	st.ran_ok = true;
+}
+
+void VKGSRender::r2aa_check_read(u32 address)
+{
+	auto& st = g_r2;
+	if (r2cfg().trace && (st.frame % static_cast<u32>(r2cfg().trace)) == 0 && st.frame) r2log("T f%u blit-read %08x", st.frame, address);
+	if (r2cfg().mode && !st.disabled && r2cfg().classify) st.sampled_rt[address]++;
+	if (!r2cfg().mode || st.disabled || !st.scene_draws || st.aa_done || !st.rt_ptr || !scene_passes_done()) return; // reads between the scene passes are the light passes
+	if (st.resolve_wait) return; // the resolve pass reads the scene; upscale its output once it is done
+	if (address >= st.rt_range.start && address <= st.rt_range.end)
+	{
+		r2aa_run();
+	}
+}
+
+namespace
+{
+	// Next logical frame: pick its scene from this frame's draws, set its jitter
+	void frame_boundary()
+	{
+		auto& st = g_r2;
+		st.boundary_pending = false;
+		st.flips_since = 0;
+		st.mat_done = false;
+		st.run_scene = false;
+		st.run_draws = st.run_dw = 0;
+		// Pick next frame's scene: the depth buffer with most depth-tested draws, then its busiest colour target
+		// RSX_AA_CLASSIFY: only pairs that look like the main view count (ReShade generic depth: skip small and
+		// shadow-map-like targets): colour wider than 512, at least half the largest candidate area, depth written.
+		const bool classify = r2cfg().classify;
+		u64 max_area = 0;
+		if (classify)
+			for (const auto& [key, t] : st.tally)
+				if ((key >> 32) && t.w > 512) max_area = std::max<u64>(max_area, static_cast<u64>(t.w) * t.h);
+		const auto eligible = [&](const pair_tally& t)
+		{
+			return !classify || (t.w > 512 && static_cast<u64>(t.w) * t.h * 2 >= max_area);
+		};
+		u64 best_ds = 0;
+		{
+			std::unordered_map<u32, u32> per_ds, ds_writes;
+			if (classify)
+				for (const auto& [key, t] : st.tally) ds_writes[static_cast<u32>(key)] += t.dwrites;
+			u32 best = 0;
+			for (const auto& [key, t] : st.tally)
+			{
+				if (!(key >> 32)) continue; // depth-only (shadow maps) can't be the scene
+				if (!eligible(t)) continue;
+				const u32 ds = static_cast<u32>(key);
+				if (classify && !ds_writes[ds]) continue;
+				const u32 n = (per_ds[ds] += t.count);
+				if (n > best) { best = n; best_ds = ds; }
+			}
+		}
+
+		u32 max_count = 0;
+		for (const auto& [key, t] : st.tally)
+			if (static_cast<u32>(key) == best_ds && (key >> 32) && eligible(t)) max_count = std::max(max_count, t.count);
+
+		bool found = false, found_sampled = false;
+		u32 new_rt = 0, latest_first = 0;
+		for (const auto& [key, t] : st.tally)
+		{
+			if (static_cast<u32>(key) != best_ds || !(key >> 32) || !eligible(t)) continue;
+			if (t.count < std::max(30u, max_count / 4)) continue;
+			// Prefer a colour target that a later pass samples (the lit scene feeds post-processing)
+			const bool sampled = classify && st.sampled_rt.count(static_cast<u32>(key >> 32));
+			if (!found || (sampled && !found_sampled) || (sampled == found_sampled && t.first_draw > latest_first))
+			{
+				found = true;
+				found_sampled = sampled;
+				latest_first = t.first_draw;
+				new_rt = static_cast<u32>(key >> 32);
+			}
+		}
+		if (r2cfg().passlog && (st.frame % static_cast<u32>(r2cfg().passlog)) == 0)
+		{
+			for (const auto& [key, t] : st.tally)
+				r2log("V f%u pair rt=%08x ds=%08x %ux%u draws=%u dwrite=%u passes=%u first=%u sampled=%u eligible=%d",
+					st.frame, static_cast<u32>(key >> 32), static_cast<u32>(key), t.w, t.h, t.count, t.dwrites, t.segments, t.first_draw,
+					st.sampled_rt.count(static_cast<u32>(key >> 32)) ? st.sampled_rt[static_cast<u32>(key >> 32)] : 0u, eligible(t) ? 1 : 0);
+			r2log("V f%u pick rt=%08x ds=%08x (%s)", st.frame, new_rt, static_cast<u32>(best_ds), found ? "found" : "none");
+			if (r2cfg().objmv)
+			{
+				// O: per-object motion summary; OD: the draws that were classified (blanket / skinned / SPU-written meshes)
+				u32 n[8] = {}, dw = 0, logged = 0;
+				for (const auto& e : st.cur_F.e)
+				{
+					if (!(e.om & (om_matched | om_new))) continue;
+					dw++;
+					for (u32 b = 0; b < 8; ++b) if (e.om & (1u << b)) n[b]++;
+				}
+				r2log("O f%u objmv dwrite-draws=%u matched=%u unmatched=%u skinned=%u skinned-anim=%u dynvb=%u rigid-moving=%u replayed=%u objmv=%u masked=%u pending-pipe=%u skipped=%u",
+					st.frame, dw, n[0], n[1], n[6], n[2], n[3], n[4], st.om_replays, st.om_objmv, st.om_masked, st.om_pending, st.om_skipped);
+				for (u32 i = 0; i < st.cur_F.e.size() && logged < 64; ++i)
+				{
+					const auto& e = st.cur_F.e[i];
+					if (!(e.om & om_want)) continue;
+					logged++;
+					r2log("OD f%u e%u id=%u vp=%05x va0=%08x vb=%08x key=%016llx%s%s%s%s%s%s", st.frame, i, e.id, e.vp_addr, e.va0, e.vb_hash,
+						static_cast<unsigned long long>(e.key), (e.om & om_new) ? " new" : "", (e.om & om_indexed) ? " indexed" : "",
+						(e.om & om_skin) ? " skin-anim" : "", (e.om & om_dyn) ? " dynvb" : "", (e.om & om_rigid) ? " rigid-moving" : "",
+						(e.om & om_replayed) ? " replayed" : "");
+				}
+			}
+		}
+
+		const bool was_valid = st.scene_valid;
+		const u32 old_rt = st.scene_rt, old_ds = st.scene_ds;
+		if (found && was_valid && (new_rt != old_rt || static_cast<u32>(best_ds) != old_ds))
+		{
+			// Hysteresis: frames where two pairs are close (menus over the game, cutscene transitions) must not flip
+			// the scene every frame (each switch resets the upscaler history). Switch once the other pair wins 3 frames
+			// in a row, or at once when the current scene pair was not drawn at all.
+			const auto it = st.tally.find((static_cast<u64>(old_rt) << 32) | old_ds);
+			const bool old_present = it != st.tally.end() && it->second.count >= 30;
+			if (old_present && ++st.switch_votes < 3)
+			{
+				new_rt = old_rt;
+				best_ds = old_ds;
+			}
+			else
+			{
+				st.switch_votes = 0;
+			}
+		}
+		else
+		{
+			st.switch_votes = 0;
+		}
+		st.scene_valid = found;
+		if (found)
+		{
+			st.scene_rt = new_rt;
+			st.scene_ds = static_cast<u32>(best_ds);
+		}
+		st.scene_changed = !was_valid || !found || old_rt != st.scene_rt || old_ds != st.scene_ds;
+		if (found)
+		{
+			const auto it = st.tally.find((static_cast<u64>(st.scene_rt) << 32) | st.scene_ds);
+			st.seg_target = it != st.tally.end() ? std::max(1u, it->second.segments) : 1u;
+		}
+		if (st.scene_changed && found)
+		{
+			r2log("scene: colour 0x%08x, depth 0x%08x (%u draws, %u passes)", st.scene_rt, st.scene_ds, max_count, st.seg_target);
+			st.need_reset = true;
+			st.reset_why |= 1;
+			st.lock_w = st.lock_h = 0;
+		}
+
+		if (r2cfg().debug && (st.frame % 300) == 0)
+		{
+			r2log("frame %u: %u scene draws, %u matrix evals (%u failed), vote %u/%u", st.frame, st.scene_draws, st.evals, st.eval_fail, st.vote_hits, st.vote_total);
+		}
+
+		// Next frame
+		st.prev_F.e.swap(st.cur_F.e);
+		st.prev_F.consts.swap(st.cur_F.consts);
+		st.prev_F.c2.swap(st.cur_F.c2);
+		st.cur_F.clear();
+		om2_frame_end();
+		st.om_prev.clear();
+		if (r2cfg().objmv)
+			for (u32 i = 0; i < st.prev_F.e.size(); ++i)
+				if (u32* v = st.om_prev.find(st.prev_F.e[i].key, true)) *v = i;
+		st.prev_loose.clear();
+		if (r2cfg().match_loose)
+			for (u32 i = 0; i < st.prev_F.e.size(); ++i)
+				if (st.prev_F.e[i].lkey)
+					if (u32* v = st.prev_loose.find(st.prev_F.e[i].lkey, true)) *v = i;
+		st.loose_occ.clear();
+		if (st.evals >= r2cfg().evals_max) st.stat_evals_cap++;
+		st.om_nclus = 0;
+		st.om_cur = -1;
+		st.id_next = 0;
+		st.om_replays = st.om_skipped = st.om_pending = st.om_objmv = st.om_masked = 0;
+		st.occurrences.clear();
+		st.tally.clear();
+		st.sampled_rt.clear();
+		st.link_prev.swap(st.link_cur);
+		st.link_cur.clear();
+		st.pl_idx = 0;
+		st.last_tally = nullptr;
+		st.last_tally_pair = ~0ull;
+		st.last_pair = ~0ull;
+		st.seg_count = 0;
+		st.prev_S = st.frame_S;
+		st.prev_valid = st.frame_S.valid && st.ran_ok;
+		// Jitter only while the upscaler is known to run on this scene: it ran last frame and the scene is unchanged.
+		// Otherwise (menus, loading screens, the first frame of a new scene, a failed pass) draw without jitter.
+		if (st.jitter_cooldown) st.jitter_cooldown--;
+		const bool jitter_on = st.ran_ok && st.scene_valid && !st.scene_changed && !st.jitter_cooldown && r2cfg().jitter;
+		st.ran_ok = false;
+		st.scene_draws_last = st.scene_draws;
+		st.scene_draws = 0;
+		st.draw_index = 0;
+		st.evals = st.eval_fail = 0;
+		st.aa_done = false;
+		st.rt_ptr = nullptr;
+		st.ds_ptr = nullptr;
+		st.frame_S.valid = false;
+		st.frame++;
+		g_r2_trace_now = r2cfg().trace && (st.frame % static_cast<u32>(r2cfg().trace)) < 2 && st.frame > 1;
+		const u32 phase = (st.frame % static_cast<u32>(r2cfg().phases)) + 1;
+		st.jx = jitter_on ? halton(phase, 2) - 0.5f : 0.f;
+		st.jy = jitter_on ? halton(phase, 3) - 0.5f : 0.f;
+		if (jitter_on) st.stat_jitter++;
+	}
+}
+
+void VKGSRender::r2aa_on_flip()
+{
+	auto& st = g_r2;
+	if (r2cfg().mode || r2cfg().debug)
+	{
+		static auto t0 = std::chrono::steady_clock::now();
+		static u32 flips = 0;
+		++flips;
+		const auto now = std::chrono::steady_clock::now();
+		const float sec = std::chrono::duration<float>(now - t0).count();
+		if (sec >= 5.f)
+		{
+			r2log("fps %.1f (%s) runs %u resets %u (switch %u create %u size %u noprev %u cut %u nomatch %u, zoom/pan kept %u) jittered %u empty-flips %u writeback-misses %u cpu %.0f us/run objmv %u/%u masked %u vote-fail %u", flips / sec, st.scene_valid ? "scene" : "no scene",
+				st.stat_runs, st.stat_resets, st.stat_why[0], st.stat_why[1], st.stat_why[2], st.stat_why[3], st.stat_why[4], st.stat_why[5], st.stat_zoom_kept,
+				st.stat_jitter, st.stat_flips_noscene, st.stat_wb_miss,
+				st.stat_run_n ? static_cast<double>(st.stat_run_ns) / 1000.0 / st.stat_run_n : 0.0,
+				// R3: with RSX_DLSS_OBJMV=1 (v2) the v1 counters are always 0: show v2 replayed / recorded
+				r2cfg().objmv == 1 ? g_om2.t_replay : st.om_tot_objmv, r2cfg().objmv == 1 ? g_om2.t_rec : st.om_tot_replays, st.om_tot_masked, st.stat_vote_fail);
+			st.stat_vote_fail = 0;
+			if (st.stat_vote_n)
+			{
+				// RSX_AA_MATCH_LOOSE / RSX_AA_VOTE_HOLD proof line: matched should be well above members' failure level
+				r2log("camera vote: %u frames, avg %.0f matched draws (%.0f by loose key), %.0f agreeing; failed votes: held %u, largest-group %u, no motion %u; draw-cap frames %u (RSX_AA_EVALS %u)",
+					st.stat_vote_n, static_cast<double>(st.stat_vote_matched) / st.stat_vote_n, static_cast<double>(st.stat_vote_loose) / st.stat_vote_n,
+					static_cast<double>(st.stat_vote_members) / st.stat_vote_n, st.stat_vote_held, st.stat_vote_plural, st.stat_vote_ident,
+					st.stat_evals_cap, r2cfg().evals_max);
+				if (r2cfg().camera_exact)
+					r2log("camera exact: %u frames, available %u (avg %.0f draws share the VP), used %u (%u where the vote failed), vote agrees %u / disagrees %u, unconfirmed %u, avg %.0f matched draws agree with it, %s",
+						st.stat_vote_n, st.stat_ex_avail, st.stat_ex_avail ? static_cast<double>(st.stat_ex_draws) / st.stat_ex_avail : 0.0,
+						st.stat_ex_used, st.stat_ex_rescued, st.stat_ex_agree, st.stat_ex_disagree, st.stat_ex_unsup,
+						st.stat_ex_avail ? static_cast<double>(st.stat_ex_members) / st.stat_ex_avail : 0.0, st.ex_proven ? "proven" : "not yet proven");
+			}
+			st.stat_ex_avail = st.stat_ex_used = st.stat_ex_agree = st.stat_ex_disagree = st.stat_ex_unsup = st.stat_ex_rescued = 0;
+			st.stat_ex_draws = st.stat_ex_members = 0;
+			st.stat_vote_matched = st.stat_vote_members = st.stat_vote_loose = 0;
+			st.stat_vote_n = st.stat_vote_held = st.stat_vote_plural = st.stat_vote_ident = st.stat_evals_cap = 0;
+			for (u32& w : st.stat_why) w = 0;
+			if (static bool uvj_logged = false; r2cfg().uv_jitter && !uvj_logged && st.stat_runs)
+			{
+				uvj_logged = true;
+				r2log("[aa] screen-uv jitter: %u programs, %u outputs", vk::g_uvj_programs.load(), vk::g_uvj_outputs.load());
+			}
+			if (r2cfg().objmv == 1)
+			{
+				auto& o = g_om2;
+				r2log("objmv2 (%s): %u frames, %u with velocity; recorded %u replayed %u onepass %u pending-pipe %u skipped %u no-history %u gpu-history %u (copies only at submit %u) mid-frame segments %u repaired %u; deform %u (captured %u, fallback %u); objmv cpu %.0f us/frame",
+					om1_on() ? "onepass" : "replay", o.t_frames, o.t_passes,
+					o.t_rec, o.t_replay, o.t_op, o.t_pending, o.t_skip, o.t_nohist, o.t_hist, o.t_hsubmit, o.t_seg, st.om_repaired,
+					o.t_dfm, o.t_dcap, o.t_dmiss,
+					o.t_frames ? static_cast<double>(o.t_cpu_ns) / 1000.0 / o.t_frames : 0.0);
+				o.t_rec = o.t_replay = o.t_pending = o.t_skip = o.t_nohist = o.t_frames = o.t_passes = o.t_hist = o.t_hsubmit = o.t_seg = o.t_op = 0;
+				o.t_dfm = o.t_dcap = o.t_dmiss = 0;
+				r2log("objmv2 detail: onepass draws read by DLSS %u, lost %u; loose-key pairs %u (rejected as implausible %u); history slots refused to unmatched draws %u (slots %u); non-affine moving draws %u; deform not started: no hash %u, unchanged %u, no previous %u, stream %u, budget %u",
+					o.t_op_used, o.t_op_lost, st.om_loose, st.om_loose_bad, o.t_new_refused, o.cap, st.om_nonaffine, o.dg_nohash, o.dg_same, o.dg_noprev, o.dg_stream, o.dg_budget);
+				o.t_op_used = o.t_op_lost = o.t_new_refused = 0;
+				o.dg_nohash = o.dg_same = o.dg_noprev = o.dg_stream = o.dg_budget = 0;
+				st.om_loose = st.om_loose_bad = st.om_nonaffine = 0;
+				o.t_cpu_ns = 0;
+			}
+			st.om_repaired = 0;
+			st.stat_zoom_kept = 0;
+			st.om_tot_objmv = st.om_tot_replays = st.om_tot_masked = 0;
+			st.stat_runs = st.stat_resets = st.stat_jitter = st.stat_flips_noscene = st.stat_wb_miss = 0;
+			st.stat_run_ns = 0;
+			st.stat_run_n = 0;
+			flips = 0;
+			t0 = now;
+		}
+	}
+	if (!r2cfg().mode) return;
+	if (!st.precreated && !st.disabled && ++st.precreate_flips >= 3) r2aa_precreate();
+	// A backend that failed mid-frame (st.disabled) may have left the reduced-scale scene window open:
+	// still restore the full scale below, then stay inert.
+	if (st.disabled && !st.window && !st.section) return;
+	if (!st.draw_index) st.stat_flips_noscene++;
+
+	if (!st.disabled && r2cfg().split && st.scene_valid && st.flips_since < 3)
+	{
+		// The next frame's pre-pass straddles the flip: the logical frame ends after the upscaler (frame_boundary)
+		st.flips_since++;
+		if (st.section)
+		{
+			r2aa_set_section(false); // re-enabled at the next bind inside the window
+			if (m_draw_fbo)
+			{
+				if (vk::is_renderpass_open(*m_current_command_buffer)) vk::end_renderpass(*m_current_command_buffer);
+				m_draw_fbo->release();
+				m_draw_fbo = nullptr;
+			}
+			m_ctx->graphics_state.set(rsx::rtt_config_dirty);
+		}
+		return;
+	}
+
+	if (!st.disabled && st.scene_draws && !st.aa_done)
+	{
+		r2aa_run();
+	}
+	if (st.window || st.section)
+	{
+		st.window = false;
+		if (st.section)
+		{
+			// The bound framebuffer was built at the reduced scale: force a full rebind at the restored scale
+			r2aa_set_section(false);
+			if (m_draw_fbo)
+			{
+				if (vk::is_renderpass_open(*m_current_command_buffer)) vk::end_renderpass(*m_current_command_buffer);
+				m_draw_fbo->release();
+				m_draw_fbo = nullptr;
+			}
+			m_ctx->graphics_state.set(rsx::rtt_config_dirty);
+		}
+	}
+	if (st.wb_pending || st.wb_armed) { st.stat_wb_miss++; st.jitter_cooldown = 10; }
+	st.wb_pending = st.wb_armed = false;
+	st.resolve_wait = false;
+	if (st.disabled)
+	{
+		st.jx = st.jy = st.baked_x = st.baked_y = 0.f;
+		return;
+	}
+
+	frame_boundary();
+}
+namespace
+{
+	void release_backend()
+	{
+#ifdef R2PORT_HAVE_FFX
+		if (g_ffx.ctx)
+		{
+			g_ffx.destroy(&g_ffx.ctx, nullptr);
+			g_ffx.ctx = nullptr;
+		}
+#endif
+		if (g_r2.backend == 2 && g_dlss.release) g_dlss.release();
+		if (g_r2.backend == 3) vk::r2xess::release();
+		g_r2.backend = 0;
+	}
