+				"						{\n"
+				"							if (x == 0 && y == 0) continue;\n"
+				"							float ln = lin(texelFetch(DepthIn, clamp(p + ivec2(x, y), ivec2(0), ivec2(opts.zw) - 1), 0).r);\n"
+				"							if (abs(ln - l0) <= 0.1 * max(l0, 1e-6)) same++;\n"
+				"						}\n"
+				"					if (same < int(opts2.x + 0.5) - 1) m = 0.0;\n"
+				"				}\n"
