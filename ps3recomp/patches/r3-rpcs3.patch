+	// Graceful degradation, logged once per step: DLSS -> FSR 3.1 -> FSR 1 (spatial, at presentation) / bilinear.
+	// Never fatal: the game keeps running with whatever is left.
+	void r2aa_fallback(int from, const char* why)
+	{
+		static bool logged[3] = {};
+		if (from < 0 || from > 2 || logged[from]) return;
+		logged[from] = true;
+		if (from == 2)
+		{
+			r2log("fallback: DLSS -> FSR 3.1 (%s)", why);
+			return;
+		}
+		// No temporal AA at all: FSR 1 output scaling (with RCAS sharpening) unless the user picked a filter
+		const bool to_fsr1 = g_cfg.video.output_scaling.get() == output_scaling_mode::bilinear;
+		if (to_fsr1) g_cfg.video.output_scaling.set(output_scaling_mode::fsr);
+		r2log("fallback: %s -> %s (%s); anti-aliasing off", from == 1 ? "FSR 3.1" : "temporal AA",
+			to_fsr1 ? "FSR 1 output scaling" : "the selected output scaling", why);
+	}
