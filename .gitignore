# Nothing from the game is ever committed: these are all produced on the
# player's PC from their own copy by Setup.bat.
/gamefiles/
/game/
/gamedata/
/recompiled/
/recompiled_game/
/project/spu/*/
/project/spu/jobmods_register.c
/tools/key_vault.cpp
/tools/ffmpeg_bin/
/tools/dlss/
/shadercache/

# build output / runtime files
/build/
/build_game/
/build_regen/
/logs/
/rsxcap/
/Launcher.exe
/HDUIPack.exe
/settings.bat
/settings.ini
*.obj
*.pdb
*.ilk
__pycache__/

build_regen_spu/
logs_ppu.txt
logs_build.txt
/cache/
logs_build_*.txt
*.bak_*
/tools/shader_audit/out/
/tools/shader_audit/*.exe
/tools/shader_audit/*.txt

# RPCS3 source: downloaded and patched by tools\fetch_rpcs3.ps1 (ps3recomp\patches\r3-rpcs3.patch)
/ps3recomp/third_party/rpcs3/
/build_rpcs3/
# PS3 firmware modules and local dev work: never committed
/lle/
/scratch/
/gamefiles*/
/logs_build*.txt

# installer output and test builds
/dist/
/build_dist/

# Generated and local-only: every build_* tree (test, profile and per-feature builds), the XeSS SDK that
# Setup downloads, scratch work and run-time folders
/build_*/
/build_*.log
/tools/xess/
/screenshots/
/mods/
/portable.txt
/tools/installer/setup_exe/obj/

# downloaded by build.bat (tools\get_shaderscan.ps1) from the shaderscan repo's pinned release
/tools/shaderscan.exe
/tools/shaderscan.exe.download
# local copies of earlier builds
/backup_build_*/

# Setup.exe is attached to the GitHub release, not committed
/Setup.exe
# Inno Setup's uninstaller, left in the folder by the installer
/unins[0-9][0-9][0-9].dat
/unins[0-9][0-9][0-9].exe
# build tools Setup put into this folder (portable mode) and the list of what it installed
/tools_cache/
/scratch/RSXFIFOCommands*.pdf

# local save backups (launcher) and the NVIDIA Streamline SDK that Setup downloads after licence acceptance
/save_backups/
/tools/streamline/

# online credentials (online.ini.example is the template)
/online.ini
# HD UI pack (tools\hd_ui_pack.py): texture dumps and the upscaler/models downloaded on the user's PC
/texdump/
/tools/upscaler/
# PGO: pgo\<rN>.profdata is committed (build.bat uses it); training output and build stamps stay local
/pgo/raw/
/pgo/run_*/
/pgo/*.profraw
/pgo/*.sha256
# local QA / crash-report work, save backups and replay captures: never committed
/crash_report_work/
/saves_backup/
/tools/qa/runs/
/tools/replay/
# PGO raw profiles (any folder) and old training runs
*.profraw
/pgo/raw*/
# developer-only helper scripts (the shipped ones are run.bat and Setup.bat)
/safe_mode.bat
/renderdoc.bat
/try_r3.bat
/safe_half_*.bat
/build_pgo.bat
# leftovers of old local checkouts (nothing in 3rdparty\ is part of the port)
/3rdparty/
# mouse-look calibration the game writes at run time (player data, kept by tools\update.ps1)
/mouselook_r3.cfg
